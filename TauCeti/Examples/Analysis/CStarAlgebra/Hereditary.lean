module

public import TauCeti.Analysis.CStarAlgebra.Hereditary.Basic
public import TauCeti.Examples.Analysis.CStarAlgebra.MatrixOrder

/-!
# Two-dimensional matrix examples of hereditary C⋆-subalgebras

Working in `CStarMatrix (Fin 2) (Fin 2) ℂ` alongside the rank-one averaging projection
`q = [[1/2, 1/2], [1/2, 1/2]]` from `TauCeti.Examples.Analysis.CStarAlgebra.MatrixOrder`, we verify
concrete examples and non-examples of hereditary C⋆-subalgebras, full elements, and strictly
positive elements:

* The diagonal subalgebra `ℂ e₁₁ ⊕ ℂ e₂₂` is a closed `⋆`-subalgebra that is not hereditary,
  because `0 ≤ q ≤ 1` with `1` diagonal and `q` not diagonal.
* The corner generated by the coordinate projection `e₁₁ = diag(1, 0)` equals `ℂ • e₁₁` and is a
  closed hereditary C⋆-subalgebra.
* The hereditary C⋆-subalgebra `closure (q * M₂(ℂ) * q)` generated by `q` equals `ℂ • q`.
* The projection `e₁₁` is full (every closed two-sided ideal containing `e₁₁` equals `⊤`) yet not
  strictly positive (its generated hereditary subalgebra is one-dimensional).
-/

public section

noncomputable section

open scoped ComplexOrder
open TauCeti.MatrixOrderExample

namespace TauCeti.HereditaryExample

/-- The closed `⋆`-subalgebra of diagonal matrices `ℂ e₁₁ ⊕ ℂ e₂₂` in `M₂(ℂ)`. -/
def diagonalSubalgebra : NonUnitalStarSubalgebra ℂ (CStarMatrix (Fin 2) (Fin 2) ℂ) where
  carrier := {x | x 0 1 = 0 ∧ x 1 0 = 0}
  zero_mem' := by simp
  add_mem' := fun {x y} hx hy => by simp [hx.1, hx.2, hy.1, hy.2]
  mul_mem' := fun {x y} hx hy => by
    simp [CStarMatrix.mul_apply, Fin.sum_univ_two, hx.1, hx.2, hy.1, hy.2]
  smul_mem' := fun c {x} hx => by simp [hx.1, hx.2]
  star_mem' := fun {x} hx => by simp [CStarMatrix.star_apply, hx.1, hx.2]

@[simp]
theorem mem_diagonalSubalgebra {x : CStarMatrix (Fin 2) (Fin 2) ℂ} :
    x ∈ diagonalSubalgebra ↔ x 0 1 = 0 ∧ x 1 0 = 0 := by
  rfl

/-- The diagonal subalgebra of `M₂(ℂ)` is closed. -/
theorem isClosed_diagonalSubalgebra :
    IsClosed (diagonalSubalgebra : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) := by
  have hcont : ∀ i j : Fin 2, Continuous fun x : CStarMatrix (Fin 2) (Fin 2) ℂ => x i j := by
    intro i j
    exact (continuous_apply j).comp (continuous_apply i)
  have hset : (diagonalSubalgebra : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) =
      {x | x 0 1 = 0} ∩ {x | x 1 0 = 0} := by
    ext x; rfl
  rw [hset]
  exact (isClosed_eq (hcont 0 1) continuous_const).inter (isClosed_eq (hcont 1 0) continuous_const)

/-- The diagonal subalgebra `ℂ e₁₁ ⊕ ℂ e₂₂` of `M₂(ℂ)` is not hereditary: the rank-one averaging
projection `q` satisfies `0 ≤ q ≤ 1 ∈ diagonalSubalgebra` while `q ∉ diagonalSubalgebra`. -/
theorem not_isHereditary_diagonalSubalgebra : ¬ diagonalSubalgebra.IsHereditary := by
  intro hher
  have h1_eq : (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) = diagonal 1 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  have hq_le : averagingProjection ≤ (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) := by
    rw [h1_eq, averagingProjection_le_diagonal_iff]
    norm_num
  have h1_mem : (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) ∈ diagonalSubalgebra := by
    rw [mem_diagonalSubalgebra, h1_eq]
    simp
  have hq_mem : averagingProjection ∈ diagonalSubalgebra :=
    hher.mem_of_nonneg_of_le isStarProjection_averagingProjection.nonneg hq_le h1_mem
  have hq01 : averagingProjection 0 1 = 0 := (mem_diagonalSubalgebra.mp hq_mem).1
  rw [averagingProjection_apply] at hq01
  norm_num at hq01

/-- The first coordinate projection `e₁₁ = diag(1, 0)` is a star projection in `M₂(ℂ)`. -/
theorem isStarProjection_e11 : IsStarProjection (diagonal 1 0) := by
  constructor
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.mul_apply]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.star_apply]

/-- The hereditary C⋆-subalgebra `e₁₁ M₂(ℂ) e₁₁` equals `ℂ • e₁₁`. -/
theorem mem_hereditarySubalgebra_e11_iff {x : CStarMatrix (Fin 2) (Fin 2) ℂ} :
    x ∈ TauCeti.CStarAlgebra.hereditarySubalgebra isStarProjection_e11.isSelfAdjoint ↔
      ∃ c : ℂ, x = c • diagonal 1 0 := by
  rw [TauCeti.CStarAlgebra.mem_hereditarySubalgebra_iff_of_isStarProjection isStarProjection_e11]
  constructor
  · intro hx
    refine ⟨x 0 0, ?_⟩
    rw [← hx]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.mul_apply]
  · rintro ⟨c, rfl⟩
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.mul_apply]

/-- The hereditary C⋆-subalgebra `closure (q M₂(ℂ) q)` generated by the averaging projection `q`
equals `ℂ • q`. -/
theorem mem_hereditarySubalgebra_averagingProjection_iff {x : CStarMatrix (Fin 2) (Fin 2) ℂ} :
    x ∈ TauCeti.CStarAlgebra.hereditarySubalgebra
        isStarProjection_averagingProjection.isSelfAdjoint ↔
      ∃ c : ℂ, x = c • averagingProjection := by
  rw [TauCeti.CStarAlgebra.mem_hereditarySubalgebra_iff_of_isStarProjection
    isStarProjection_averagingProjection]
  constructor
  · intro hx
    refine ⟨(x 0 0 + x 0 1 + x 1 0 + x 1 1) / 2, ?_⟩
    rw [← hx]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.mul_apply, Fin.sum_univ_two] <;> ring
  · rintro ⟨c, rfl⟩
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [CStarMatrix.mul_apply] <;> ring

/-- The coordinate projection `e₁₁ = diag(1, 0)` is full in `M₂(ℂ)`. -/
theorem isFull_e11 : TauCeti.CStarAlgebra.IsFull (diagonal 1 0) := by
  rw [TauCeti.CStarAlgebra.isFull_iff_forall_ideal_eq_top]
  intro I _ hmem
  let e₂₁ : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix !![0, 0; 1, 0]
  let e₁₂ : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix !![0, 1; 0, 0]
  have hsum : diagonal 1 0 + e₂₁ * diagonal 1 0 * e₁₂ = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [e₂₁, e₁₂, CStarMatrix.mul_apply, Fin.sum_univ_two]
  have h1 : (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) ∈ I :=
    hsum ▸ I.add_mem hmem (I.mul_mem_right _ e₁₂ (I.mul_mem_left e₂₁ _ hmem))
  rw [eq_top_iff]
  intro x _
  simpa using I.mul_mem_left x 1 h1

/-- The coordinate projection `e₁₁ = diag(1, 0)` is full yet not strictly positive in `M₂(ℂ)`. -/
theorem not_isStrictlyPositive_e11 : ¬ TauCeti.CStarAlgebra.IsStrictlyPositive (diagonal 1 0) := by
  intro hsp
  have htop :=
    (TauCeti.CStarAlgebra.isStrictlyPositive_iff_hereditarySubalgebra_eq_top
      isStarProjection_e11.nonneg).mp hsp
  have h1_mem : (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) ∈
      TauCeti.CStarAlgebra.hereditarySubalgebra isStarProjection_e11.isSelfAdjoint := by
    rw [htop]
    trivial
  obtain ⟨c, hc⟩ := mem_hereditarySubalgebra_e11_iff.mp h1_mem
  have h11 := congrArg (fun m : CStarMatrix (Fin 2) (Fin 2) ℂ => m 1 1) hc
  simp at h11

end TauCeti.HereditaryExample
