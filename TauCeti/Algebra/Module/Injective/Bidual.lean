module

public import Mathlib.Algebra.Exact.Basic
public import Mathlib.Algebra.Module.Injective
public import Mathlib.RingTheory.Artinian.Defs
public import Mathlib.RingTheory.Finiteness.Cardinality
import Mathlib.RingTheory.Artinian.Module

/-!
# Evaluation into a double Hom

For an injective module `E`, surjectivity of the evaluation map into the double `E`-dual
passes to quotients and to kernels of exact sequences whose target is cogenerated by `E`. If
every endomorphism of `E` is scalar, evaluation is surjective for finite free modules and for
finite powers of `E`; hence evaluation is surjective for every finitely generated module and,
when `E` is an Artinian cogenerator, for every Artinian module via a finite copresentation
`0 → M → Eⁿ → Eᵐ`. In addition, embedding an Artinian module into a finite power of `E`
makes `Hom_R(M, E)` finitely generated over any commuting scalar semiring `S` over which
`End_R(E)` is finitely generated. The principal application is Matlis duality over a local ring.

## References

* The Stacks Project, Proposition 47.7.8, Matlis duality, Tag 08Z9.
* W. Bruns, J. Herzog, *Cohen–Macaulay rings*, Section 3.2.
-/

public section

noncomputable section

universe u v w z

namespace LinearMap

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]
  {M : Type w} [AddCommGroup M] [Module R M]
  {N : Type z} [AddCommGroup N] [Module R N]

/-- Surjectivity of evaluation into the double dual with injective coefficients passes to
quotients. -/
theorem surjective_applyₗ_of_surjective [Small.{v} R] [Module.Injective R E]
    (f : M →ₗ[R] N) (hf : Function.Surjective f)
    (hM : Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E) := by
  intro φ
  obtain ⟨ψ, hψ⟩ := Module.Injective.extension_property R E _ _ (f.lcomp R E)
    (lcomp_injective_of_surjective f hf) φ
  obtain ⟨m, hm⟩ := hM ψ
  refine ⟨f m, LinearMap.ext fun g ↦ ?_⟩
  have h := LinearMap.congr_fun hψ g
  simpa [← hm] using h

/-- Surjectivity of evaluation into the double dual with injective coefficients passes to the
left term of an exact sequence `0 → M → N → P` whenever evaluation is surjective on `N` and
injective on `P`. -/
theorem surjective_applyₗ_of_exact [Small.{v} R] [Module.Injective R E]
    {P : Type*} [AddCommGroup P] [Module R P]
    (f : M →ₗ[R] N) (g : N →ₗ[R] P) (hf : Function.Injective f) (hfg : Function.Exact f g)
    (hN : Function.Surjective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E))
    (hP : Function.Injective (applyₗ : P →ₗ[R] (P →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) := by
  intro φ
  obtain ⟨n, hn⟩ := hN (φ.comp (f.lcomp R E))
  have hgn : g n = 0 := by
    refine (injective_iff_map_eq_zero _).mp hP _ (LinearMap.ext fun w ↦ ?_)
    have hw := LinearMap.congr_fun hn (w.comp g)
    simpa [lcomp_apply', LinearMap.comp_assoc, hfg.linearMap_comp_eq_zero] using hw
  obtain ⟨m, rfl⟩ := (hfg n).mp hgn
  refine ⟨m, LinearMap.ext fun u ↦ ?_⟩
  obtain ⟨v, rfl⟩ := Module.Injective.extension_property R E M N f hf u
  simpa [lcomp_apply'] using LinearMap.congr_fun hn v

end LinearMap

namespace TauCeti

open LinearMap

section Semiring

variable {R : Type u} [CommSemiring R] {E : Type v} [AddCommMonoid E] [Module R E]

/-- If every endomorphism of `E` is scalar, evaluation into the double `E`-dual of a finite
free module is surjective. -/
theorem surjective_applyₗ_pi_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (ι : Type*) [Finite ι] :
    Function.Surjective (applyₗ : (ι → R) →ₗ[R] ((ι → R) →ₗ[R] E) →ₗ[R] E) := by
  classical
  let := Fintype.ofFinite ι
  intro φ
  let e := LinearEquiv.piRing R E ι R
  let ψ := φ.comp e.symm.toLinearMap
  choose r hr using fun i ↦ hE (ψ.comp (LinearMap.single R (fun _ : ι ↦ E) i))
  refine ⟨r, LinearMap.ext fun f ↦ ?_⟩
  have hψ : ψ (e f) = ∑ i, r i • e f i := by
    conv_lhs => rw [← Finset.univ_sum_single (e f), map_sum]
    exact Finset.sum_congr rfl fun i _ ↦ LinearMap.congr_fun (hr i) (e f i)
  have hf : f r = ∑ i, r i • e f i := by
    simpa only [e, LinearEquiv.piRing_symm_apply] using
      congrArg (fun g : (ι → R) →ₗ[R] E ↦ g r) (e.symm_apply_apply f).symm
  simpa only [LinearMap.applyₗ_apply_apply] using
    hf.trans (by simpa [ψ] using hψ.symm)

/-- If every endomorphism of `E` is scalar, evaluation into the double `E`-dual of a finite
power of `E` is surjective, sending a functional `φ` to `i ↦ φ (proj i)`. -/
theorem surjective_applyₗ_pi_self_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (ι : Type*) [Finite ι] :
    Function.Surjective (applyₗ : (ι → E) →ₗ[R] ((ι → E) →ₗ[R] E) →ₗ[R] E) := by
  classical
  let := Fintype.ofFinite ι
  intro φ
  refine ⟨fun i ↦ φ (LinearMap.proj i), LinearMap.ext fun g ↦ ?_⟩
  choose r hr using fun i ↦ hE (g.comp (LinearMap.single R (fun _ : ι ↦ E) i))
  have hg : g = ∑ i, r i • LinearMap.proj i := LinearMap.ext fun x ↦ by
    conv_lhs => rw [← Finset.univ_sum_single x, map_sum]
    simp only [LinearMap.coe_sum, Finset.sum_apply, LinearMap.smul_apply, LinearMap.proj_apply]
    exact Finset.sum_congr rfl fun i _ ↦ LinearMap.congr_fun (hr i) (x i)
  rw [hg, map_sum]
  simp

/-- If every endomorphism of `E` is scalar, evaluation into `End_R(E) →ₗ[R] E` is surjective. -/
theorem surjective_applyₗ_self_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id) :
    Function.Surjective (applyₗ : E →ₗ[R] Module.End R E →ₗ[R] E) := by
  intro φ
  refine ⟨φ LinearMap.id, LinearMap.ext fun g ↦ ?_⟩
  obtain ⟨r, rfl⟩ := hE g
  simp

end Semiring

section Ring

variable {R : Type u} [Ring R] {E : Type v} [AddCommGroup E] [Module R E]

/-- **Artinian modules are finitely cogenerated.** If maps into `E` separate nonzero elements of
an Artinian `R`-module `M`, then `M` embeds into a finite power `Fin n → E`. -/
theorem exists_injective_pi_of_forall_apply_ne_zero
    {M : Type w} [AddCommGroup M] [Module R M] [IsArtinian R M]
    (hsep : ∀ m : M, m ≠ 0 → ∃ ψ : M →ₗ[R] E, ψ m ≠ 0) :
    ∃ (n : ℕ) (f : M →ₗ[R] (Fin n → E)), Function.Injective f := by
  let S : Set (Submodule R M) :=
    {K | ∃ (n : ℕ) (f : M →ₗ[R] (Fin n → E)), K = LinearMap.ker f}
  obtain ⟨K, ⟨n, f, rfl⟩, hmin⟩ :=
    (wellFounded_lt (α := Submodule R M)).has_min S ⟨⊤, 0, 0, LinearMap.ker_zero.symm⟩
  refine ⟨n, f, LinearMap.ker_eq_bot.mp ?_⟩
  by_contra hne
  obtain ⟨m, hmK, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  obtain ⟨ψ, hψ⟩ := hsep m hm0
  let f' : M →ₗ[R] (Fin (n + 1) → E) :=
    LinearMap.pi (Fin.cons ψ fun i ↦ (LinearMap.proj i).comp f)
  have hle : LinearMap.ker f' ≤ LinearMap.ker f := fun x hx ↦ by
    rw [LinearMap.mem_ker] at hx ⊢
    ext i
    simpa [f'] using congrFun hx i.succ
  have hm_not : m ∉ LinearMap.ker f' := fun hm' ↦ hψ (by simpa [f'] using congrFun hm' 0)
  exact hmin (LinearMap.ker f') ⟨n + 1, f', rfl⟩
    (lt_of_le_not_ge hle fun hge ↦ hm_not (hge hmK))

/-- **Finiteness of the dual of an Artinian module.** If `E` is an injective `R`-module whose
endomorphisms are finitely generated over a commuting scalar semiring `S`, then `Hom_R(M, E)` is
finitely generated over `S` for every Artinian `R`-module `M` whose nonzero elements are
separated by maps into `E`. -/
theorem finite_linearMap_of_isArtinian {S : Type*} [Semiring S] [Module S E] [SMulCommClass R S E]
    [Small.{v} R] [Module.Injective R E] [Module.Finite S (E →ₗ[R] E)]
    {M : Type w} [AddCommGroup M] [Module R M] [IsArtinian R M]
    (hsep : ∀ m : M, m ≠ 0 → ∃ ψ : M →ₗ[R] E, ψ m ≠ 0) :
    Module.Finite S (M →ₗ[R] E) := by
  obtain ⟨n, f, hf⟩ := exists_injective_pi_of_forall_apply_ne_zero hsep
  have hsurj : Function.Surjective (f.lcomp S E) := fun u ↦
    Module.Injective.extension_property R E M (Fin n → E) f hf u
  have : Module.Finite S ((Fin n → E) →ₗ[R] E) :=
    Module.Finite.equiv (LinearMap.lsum R (fun _ : Fin n ↦ E) S)
  exact Module.Finite.of_surjective (f.lcomp S E) hsurj

end Ring

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]

/-- If `E` is injective and every endomorphism of `E` is scalar, every finitely generated
module maps surjectively onto its double `E`-dual by evaluation. -/
theorem surjective_applyₗ_of_finite_of_end_eq_smul [Small.{v} R] [Module.Injective R E]
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (M : Type w) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  exact f.surjective_applyₗ_of_surjective hf (surjective_applyₗ_pi_of_end_eq_smul hE (Fin n))

/-- If evaluation into the double `E`-dual is injective on `M`, then maps to `E` separate
nonzero elements of `M`. -/
private theorem exists_apply_ne_zero_of_injective_applyₗ
    {M : Type w} [AddCommGroup M] [Module R M]
    (hM : Function.Injective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E))
    {m : M} (hm : m ≠ 0) :
    ∃ ψ : M →ₗ[R] E, ψ m ≠ 0 := by
  by_contra! h
  exact hm ((injective_iff_map_eq_zero _).mp hM m (LinearMap.ext h))

/-- **Finite copresentation of Artinian modules.** Over a commutative ring, if `E` is Artinian
and evaluation into the double `E`-dual is injective on `M` and on quotients of finite powers of
`E`, then `M` fits into an exact sequence `0 → M → Eⁿ → Eᵐ`. -/
theorem exists_exact_pi_of_isArtinian [IsArtinian R E]
    (hcog : ∀ {N : Type v} [AddCommGroup N] [Module R N],
      Function.Injective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E))
    {M : Type w} [AddCommGroup M] [Module R M] [IsArtinian R M]
    (hM : Function.Injective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E)) :
    ∃ (n m : ℕ) (f : M →ₗ[R] (Fin n → E)) (g : (Fin n → E) →ₗ[R] (Fin m → E)),
      Function.Injective f ∧ Function.Exact f g := by
  obtain ⟨n, f, hf⟩ := exists_injective_pi_of_forall_apply_ne_zero fun x hx ↦
    exists_apply_ne_zero_of_injective_applyₗ hM hx
  obtain ⟨m, g₀, hg₀⟩ := exists_injective_pi_of_forall_apply_ne_zero
    (M := (Fin n → E) ⧸ LinearMap.range f) fun x hx ↦
      exists_apply_ne_zero_of_injective_applyₗ hcog hx
  refine ⟨n, m, f, g₀.comp (LinearMap.range f).mkQ, hf, fun x ↦ ?_⟩
  rw [LinearMap.comp_apply, map_eq_zero_iff g₀ hg₀, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, LinearMap.mem_range]
  rfl

/-- **Surjectivity of evaluation for Artinian modules.** If `E` is an Artinian injective
cogenerator whose endomorphisms are scalar, then every Artinian module maps surjectively onto its
double `E`-dual by evaluation. -/
theorem surjective_applyₗ_of_isArtinian_of_end_eq_smul
    [Small.{v} R] [Module.Injective R E] [IsArtinian R E]
    (hcog : ∀ {N : Type v} [AddCommGroup N] [Module R N],
      Function.Injective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E))
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    {M : Type w} [AddCommGroup M] [Module R M] [IsArtinian R M]
    (hM : Function.Injective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) := by
  obtain ⟨n, m, f, g, hf, hfg⟩ := exists_exact_pi_of_isArtinian (@hcog) hM
  exact f.surjective_applyₗ_of_exact g hf hfg
    (surjective_applyₗ_pi_self_of_end_eq_smul hE (Fin n)) hcog

end TauCeti
