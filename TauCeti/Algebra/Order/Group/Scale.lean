/-!
# Scales on partially ordered abelian groups and dimension groups

A *scale* on a preordered additive monoid `G` is a subset `S ⊆ G⁺` containing `0` that is upward
directed, hereditary in `G⁺` (`0 ≤ x ≤ y` with `y ∈ S` implies `x ∈ S`), and generates `G⁺` by
finite sums (`g ≥ 0` implies `g ∈ AddSubmonoid.closure S`). On the ordered `K₀`-group of an AF
C⋆-algebra `A`, the projection classes `{[p] : p ∈ Proj(A)}` form a scale `Σ(A)`, and the triple
`(K₀(A), K₀(A)⁺, Σ(A))` is Elliott's complete isomorphism invariant.

## Main definitions

* `TauCeti.IsScale S`: `S` is a scale on `G` (Rørdam, Definition 1.4.1).

## Main results

* `TauCeti.isScale_iff_exists_le_closure`, `TauCeti.isScale_iff_exists_list_sum_le`: under Riesz
  interpolation, finite-sum generation of `G⁺` is equivalent to finite-sum domination of `G⁺`.
* `TauCeti.isScale_Ici_zero`: the full positive cone `Set.Ici 0` is always a scale.
* `TauCeti.isScale_singleton_zero_iff`: `{0}` is a scale if and only if `G⁺ = {0}`.
* `TauCeti.IsOrderUnit.isScale_Icc`, `TauCeti.isScale_Icc_iff_isOrderUnit`: under Riesz
  interpolation, `[0, u]` is a scale for every order unit `u` (and conversely in directed groups).
* `TauCeti.IsScale.prod`: products of scales are scales on `G × H`.
* `TauCeti.OrderIdeal.isScale_preimage`, `TauCeti.OrderIdeal.isScale_image_quotientMk`: under
  Riesz interpolation, a scale restricts to any order ideal `I` and descends to the quotient
  `G ⧸ I.toAddSubgroup`.

## References

* M. Rørdam, *Classification of nuclear C⋆-algebras*, Encyclopaedia of Mathematical Sciences
  126, Springer, 2002, §§1.3–1.5 (Definition 1.4.1).
* B. Blackadar, *K-Theory for Operator Algebras*, 2nd ed., MSRI Publications 5, Cambridge
  University Press, 1998, §7.3–7.4.
-/

public section

namespace TauCeti

/-- A **scale** on a preordered additive monoid `G` (Rørdam, Definition 1.4.1): a subset `S` of
non-negative elements containing `0` that is upward directed, hereditary in the positive cone, and
generates the positive cone by finite sums. -/
structure IsScale {G : Type*} [AddCommMonoid G] [Preorder G] (S : Set G) : Prop where
  /-- Zero belongs to the scale. -/
  zero_mem : (0 : G) ∈ S
  /-- Every element of the scale is non-negative. -/
  nonneg : ∀ ⦃x : G⦄, x ∈ S → 0 ≤ x
  /-- The scale is upward directed. -/
  directedOn : DirectedOn (· ≤ ·) S
  /-- The scale is hereditary in the positive cone `G⁺`. -/
  mem_of_nonneg_of_le : ∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ S → x ∈ S
  /-- Every non-negative element of `G` is a finite sum of elements of `S`. -/
  mem_closure_of_nonneg : ∀ ⦃g : G⦄, 0 ≤ g → g ∈ AddSubmonoid.closure S

namespace IsScale

section Monoid

variable {G H : Type*} [AddCommMonoid G] [Preorder G] [AddCommMonoid H] [Preorder H] {S : Set G}

/-- A scale is contained in the positive cone `Set.Ici 0`. -/
theorem subset_Ici_zero (hS : IsScale S) : S ⊆ Set.Ici 0 :=
  fun _ hx ↦ hS.nonneg hx

/-- Every scale is nonempty, witnessed by `0`. -/
theorem nonempty (hS : IsScale S) : S.Nonempty :=
  ⟨0, hS.zero_mem⟩

/-- Every scale is order-convex in `G`. -/
theorem ordConnected (hS : IsScale S) : S.OrdConnected :=
  ⟨fun {_} hx {_} hy _ hz ↦ hS.mem_of_nonneg_of_le ((hS.nonneg hx).trans hz.1) hz.2 hy⟩

/-- The additive submonoid generated by a scale is the positive cone `AddSubmonoid.nonneg G`. -/
theorem closure_eq_nonneg [IsOrderedAddMonoid G] (hS : IsScale S) :
    AddSubmonoid.closure S = AddSubmonoid.nonneg G :=
  le_antisymm (AddSubmonoid.closure_le.2 hS.subset_Ici_zero)
    fun _ hg ↦ hS.mem_closure_of_nonneg hg

/-- Every non-negative element is the sum of a list of elements from the scale. -/
theorem exists_list_sum_eq (hS : IsScale S) {g : G} (hg : 0 ≤ g) :
    ∃ l : List G, (∀ x ∈ l, x ∈ S) ∧ l.sum = g :=
  AddSubmonoid.exists_list_of_mem_closure (hS.mem_closure_of_nonneg hg)

/-- Transport a scale across an ordered additive isomorphism. -/
theorem image_orderAddMonoidIso (e : G ≃+o H) (hS : IsScale S) : IsScale (e '' S) where
  zero_mem := ⟨0, hS.zero_mem, map_zero e⟩
  nonneg := by
    rintro _ ⟨x, hx, rfl⟩
    exact map_nonneg e (hS.nonneg hx)
  directedOn := by
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    obtain ⟨z, hz, hxz, hyz⟩ := hS.directedOn x hx y hy
    exact ⟨e z, ⟨z, hz, rfl⟩, OrderHomClass.mono e hxz, OrderHomClass.mono e hyz⟩
  mem_of_nonneg_of_le := by
    rintro y _ hy0 hle ⟨x, hx, rfl⟩
    have hle' : e.symm y ≤ x := by
      simpa using OrderHomClass.mono e.symm hle
    have hx' : e.symm y ∈ S :=
      hS.mem_of_nonneg_of_le (map_nonneg e.symm hy0) hle' hx
    exact ⟨e.symm y, hx', e.apply_symm_apply y⟩
  mem_closure_of_nonneg := by
    intro h hh0
    rw [← AddMonoidHom.map_mclosure e]
    exact ⟨e.symm h, hS.mem_closure_of_nonneg (map_nonneg e.symm hh0), e.apply_symm_apply h⟩

/-- An ordered additive isomorphism preserves and reflects scales. -/
@[simp]
theorem _root_.TauCeti.isScale_image_orderAddMonoidIso_iff (e : G ≃+o H) {S : Set G} :
    IsScale (e '' S) ↔ IsScale S := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.image_orderAddMonoidIso e⟩
  have hEq : e.symm '' (e '' S) = S := by
    ext x
    simp
  exact hEq ▸ h.image_orderAddMonoidIso e.symm

/-- The product of two scales is a scale on the product ordered monoid. -/
theorem prod {T : Set H} (hS : IsScale S) (hT : IsScale T) : IsScale (S ×ˢ T) where
  zero_mem := ⟨hS.zero_mem, hT.zero_mem⟩
  nonneg _ hx := ⟨hS.nonneg hx.1, hT.nonneg hx.2⟩
  directedOn := fun ⟨x₁, y₁⟩ h₁ ⟨x₂, y₂⟩ h₂ ↦ by
    obtain ⟨x, hx, hx₁, hx₂⟩ := hS.directedOn x₁ h₁.1 x₂ h₂.1
    obtain ⟨y, hy, hy₁, hy₂⟩ := hT.directedOn y₁ h₁.2 y₂ h₂.2
    exact ⟨(x, y), ⟨hx, hy⟩, ⟨hx₁, hy₁⟩, ⟨hx₂, hy₂⟩⟩
  mem_of_nonneg_of_le := fun _ _ hx0 hxy hy ↦
    ⟨hS.mem_of_nonneg_of_le hx0.1 hxy.1 hy.1, hT.mem_of_nonneg_of_le hx0.2 hxy.2 hy.2⟩
  mem_closure_of_nonneg := fun ⟨g, h⟩ ⟨hg0, hh0⟩ ↦ by
    have hgM : (g, (0 : H)) ∈ AddSubmonoid.closure (S ×ˢ T) := by
      have hinl : (AddMonoidHom.inl G H) '' S ⊆ S ×ˢ T := by
        rintro _ ⟨s, hs, rfl⟩
        exact ⟨hs, hT.zero_mem⟩
      exact AddSubmonoid.closure_mono hinl
        (by rw [← AddMonoidHom.map_mclosure]; exact ⟨g, hS.mem_closure_of_nonneg hg0, rfl⟩)
    have hhM : ((0 : G), h) ∈ AddSubmonoid.closure (S ×ˢ T) := by
      have hinr : (AddMonoidHom.inr G H) '' T ⊆ S ×ˢ T := by
        rintro _ ⟨t, ht, rfl⟩
        exact ⟨hS.zero_mem, ht⟩
      exact AddSubmonoid.closure_mono hinr
        (by rw [← AddMonoidHom.map_mclosure]; exact ⟨h, hT.mem_closure_of_nonneg hh0, rfl⟩)
    simpa using add_mem hgM hhM

end Monoid

/-! ### Domination characterization under Riesz interpolation -/

section Domination

variable {G : Type*} [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]

/-- Construct a scale in a group with Riesz interpolation by verifying domination of `G⁺` by
finite sums from `S` instead of exact representation (Rørdam, §1.4). -/
theorem of_exists_le_closure (hG : HasRieszInterpolation G) {S : Set G}
    (h0 : (0 : G) ∈ S)
    (hnn : ∀ ⦃x : G⦄, x ∈ S → 0 ≤ x)
    (hdir : DirectedOn (· ≤ ·) S)
    (hhered : ∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ S → x ∈ S)
    (hdom : ∀ ⦃g : G⦄, 0 ≤ g → ∃ u ∈ AddSubmonoid.closure S, g ≤ u) : IsScale S where
  zero_mem := h0
  nonneg := hnn
  directedOn := hdir
  mem_of_nonneg_of_le := hhered
  mem_closure_of_nonneg := by
    have hdown : ∀ {u : G}, u ∈ AddSubmonoid.closure S →
        ∀ {g : G}, 0 ≤ g → g ≤ u → g ∈ AddSubmonoid.closure S := by
      intro u hu
      refine AddSubmonoid.closure_induction_left
        (motive := fun u _ ↦ ∀ {g : G}, 0 ≤ g → g ≤ u → g ∈ AddSubmonoid.closure S)
        (fun {g} hg0 hgu ↦ AddSubmonoid.subset_closure (hhered hg0 hgu h0))
        (fun s hs y hy ih {g} hg0 hgsy ↦ ?_) hu
      have hy0 : 0 ≤ y :=
        AddSubmonoid.mem_nonneg.1 (AddSubmonoid.closure_le.2 (fun _ h ↦ hnn h) hy)
      obtain ⟨g₁, g₂, hg₁0, hg₁s, hg₂0, hg₂y, rfl⟩ :=
        hG.exists_decomposition (hnn hs) hy0 hg0 hgsy
      exact add_mem (AddSubmonoid.subset_closure (hhered hg₁0 hg₁s hs)) (ih hg₂0 hg₂y)
    intro g hg0
    obtain ⟨u, hu, hgu⟩ := hdom hg0
    exact hdown hu hg0 hgu

end Domination

end IsScale

section DominationIff

variable {G : Type*} [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]

/-- Under Riesz interpolation, `S` is a scale if and only if `0 ∈ S`, `S ⊆ G⁺`, `S` is upward
directed and hereditary in `G⁺`, and every `g ≥ 0` is bounded above by an element of
`AddSubmonoid.closure S`. -/
theorem isScale_iff_exists_le_closure (hG : HasRieszInterpolation G) {S : Set G} :
    IsScale S ↔
      (0 : G) ∈ S ∧ (∀ ⦃x : G⦄, x ∈ S → 0 ≤ x) ∧ DirectedOn (· ≤ ·) S ∧
        (∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ S → x ∈ S) ∧
        ∀ ⦃g : G⦄, 0 ≤ g → ∃ u ∈ AddSubmonoid.closure S, g ≤ u :=
  ⟨fun hS ↦ ⟨hS.zero_mem, hS.nonneg, hS.directedOn, hS.mem_of_nonneg_of_le,
      fun _ hg ↦ ⟨_, hS.mem_closure_of_nonneg hg, le_rfl⟩⟩,
    fun ⟨h0, hnn, hdir, hhered, hdom⟩ ↦ IsScale.of_exists_le_closure hG h0 hnn hdir hhered hdom⟩

/-- Under Riesz interpolation, `S` is a scale if and only if `0 ∈ S`, `S ⊆ G⁺`, `S` is upward
directed and hereditary in `G⁺`, and every `g ≥ 0` is bounded above by the sum of a finite list
of elements of `S`. -/
theorem isScale_iff_exists_list_sum_le (hG : HasRieszInterpolation G) {S : Set G} :
    IsScale S ↔
      (0 : G) ∈ S ∧ (∀ ⦃x : G⦄, x ∈ S → 0 ≤ x) ∧ DirectedOn (· ≤ ·) S ∧
        (∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ S → x ∈ S) ∧
        ∀ ⦃g : G⦄, 0 ≤ g → ∃ l : List G, (∀ x ∈ l, x ∈ S) ∧ g ≤ l.sum := by
  rw [isScale_iff_exists_le_closure hG]
  refine and_congr_right fun _ ↦ and_congr_right fun _ ↦ and_congr_right fun _ ↦
    and_congr_right fun _ ↦ ⟨fun h g hg ↦ ?_, fun h g hg ↦ ?_⟩
  · obtain ⟨u, hu, hgu⟩ := h hg
    obtain ⟨l, hl, rfl⟩ := AddSubmonoid.exists_list_of_mem_closure hu
    exact ⟨l, hl, hgu⟩
  · obtain ⟨l, hl, hgl⟩ := h hg
    exact ⟨l.sum, list_sum_mem fun x hx ↦ AddSubmonoid.subset_closure (hl x hx), hgl⟩

end DominationIff

/-! ### Canonical scales: full positive cone, zero scale, and unital intervals -/

section CanonicalScales

/-- The full positive cone `Set.Ici 0` is a scale on every ordered additive commutative monoid
(corresponding to the stabilized scale `Σ(A ⊗ K) = K₀(A)⁺`). -/
theorem isScale_Ici_zero (G : Type*) [AddCommMonoid G] [Preorder G] [IsOrderedAddMonoid G] :
    IsScale (Set.Ici (0 : G)) where
  zero_mem := le_rfl
  nonneg _ hx := hx
  directedOn x hx y hy :=
    ⟨x + y, add_nonneg hx hy, le_add_of_nonneg_right hy, le_add_of_nonneg_left hx⟩
  mem_of_nonneg_of_le _ _ hx0 _ _ := hx0
  mem_closure_of_nonneg _ hg := AddSubmonoid.subset_closure hg

/-- The singleton `{0}` is a scale on `G` if and only if `0` is the only non-negative element
of `G`. -/
@[simp]
theorem isScale_singleton_zero_iff {G : Type*} [AddCommMonoid G] [PartialOrder G] :
    IsScale ({(0 : G)} : Set G) ↔ ∀ ⦃g : G⦄, 0 ≤ g → g = 0 := by
  refine ⟨fun hS g hg ↦ ?_, fun h ↦ ?_⟩
  · have hmem := hS.mem_closure_of_nonneg hg
    rwa [AddSubmonoid.closure_singleton_zero, AddSubmonoid.mem_bot] at hmem
  · refine
      { zero_mem := rfl
        nonneg := by rintro _ rfl; exact le_rfl
        directedOn := fun _ hx _ hy ↦ ⟨0, rfl, hx.le, hy.le⟩
        mem_of_nonneg_of_le := fun _ _ hx0 _ _ ↦ h hx0
        mem_closure_of_nonneg := fun g hg ↦ by simp [h hg] }

/-- On a subsingleton partially ordered additive commutative monoid, `{0}` is a scale. -/
theorem isScale_singleton_zero (G : Type*) [AddCommMonoid G] [PartialOrder G] [Subsingleton G] :
    IsScale ({(0 : G)} : Set G) :=
  isScale_singleton_zero_iff.2 fun g _ ↦ Subsingleton.elim g 0

/-- Under Riesz interpolation, an order unit `u` defines the unital scale `Set.Icc 0 u`
(corresponding to `Σ(A) = [0, [1_A]]` for unital AF C⋆-algebras). -/
theorem IsOrderUnit.isScale_Icc {G : Type*} [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]
    (hG : HasRieszInterpolation G) {u : G} (hu : IsOrderUnit u) :
    IsScale (Set.Icc (0 : G) u) := by
  refine IsScale.of_exists_le_closure hG ⟨le_rfl, hu.nonneg⟩ (fun _ hx ↦ hx.1)
    (fun _ hx _ hy ↦ ⟨u, ⟨hu.nonneg, le_rfl⟩, hx.2, hy.2⟩)
    (fun _ _ hx0 hxy hy ↦ ⟨hx0, hxy.trans hy.2⟩) fun g _ ↦ ?_
  obtain ⟨n, hgn⟩ := hu.exists_le_nsmul g
  have hu_mem : u ∈ AddSubmonoid.closure (Set.Icc (0 : G) u) :=
    AddSubmonoid.subset_closure (Set.mem_Icc.2 ⟨hu.nonneg, le_rfl⟩)
  exact ⟨n • u, nsmul_mem hu_mem n, hgn⟩

/-- In a directed ordered additive commutative monoid, if `Set.Icc 0 u` is a scale then `u` is an
order unit. -/
theorem IsScale.isOrderUnit_of_Icc {G : Type*} [AddCommMonoid G] [Preorder G]
    [IsOrderedAddMonoid G] [IsDirectedOrder G] {u : G} (hS : IsScale (Set.Icc (0 : G) u)) :
    IsOrderUnit u := by
  refine IsOrderUnit.iff_nonneg_and_forall_exists_le_nsmul.2 ⟨hS.zero_mem.2, fun x ↦ ?_⟩
  obtain ⟨g, hxg, hg0⟩ := exists_ge_ge x 0
  have hdom : ∃ n : ℕ, g ≤ n • u :=
    AddSubmonoid.closure_induction
      (fun s hs ↦ ⟨1, by simpa [one_nsmul] using hs.2⟩)
      ⟨0, by simp⟩
      (fun _ _ _ _ ⟨m, hm⟩ ⟨n, hn⟩ ↦ ⟨m + n, by rw [add_nsmul]; exact add_le_add hm hn⟩)
      (hS.mem_closure_of_nonneg hg0)
  obtain ⟨n, hgn⟩ := hdom
  exact ⟨n, hxg.trans hgn⟩

/-- In a directed group with Riesz interpolation, `Set.Icc 0 u` is a scale if and only if `u` is an
order unit. -/
theorem isScale_Icc_iff_isOrderUnit {G : Type*} [AddCommGroup G] [Preorder G]
    [IsOrderedAddMonoid G] [IsDirectedOrder G] (hG : HasRieszInterpolation G) {u : G} :
    IsScale (Set.Icc (0 : G) u) ↔ IsOrderUnit u :=
  ⟨IsScale.isOrderUnit_of_Icc, IsOrderUnit.isScale_Icc hG⟩

/-- In any Archimedean linearly ordered abelian group (such as `ℤ`, `ℚ`, or `ℝ`), `[0, u]` is a
scale for every strictly positive element `u` (for example `[0, n] = {0, …, n}` in `ℤ`). -/
theorem isScale_Icc_of_pos {G : Type*} [AddCommGroup G] [LinearOrder G] [IsOrderedAddMonoid G]
    [Archimedean G] {u : G} (hu : 0 < u) : IsScale (Set.Icc (0 : G) u) :=
  (IsOrderUnit.of_archimedean hu).isScale_Icc
    (IsDimensionGroup.of_linearOrder (G := G)).hasRieszInterpolation

end CanonicalScales

/-! ### Restriction to order ideals and descent to quotients -/

namespace OrderIdeal

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G] (I : OrderIdeal G)

/-- Under Riesz interpolation, intersecting a scale `S` of `G` with an order ideal `I` yields a
scale on `I` (`Σ(I) = Σ(A) ∩ K₀(I)`). -/
theorem isScale_preimage (hG : HasRieszInterpolation G) {S : Set G} (hS : IsScale S) :
    IsScale ((Subtype.val : I → G) ⁻¹' S) where
  zero_mem := hS.zero_mem
  nonneg _ hx := Subtype.coe_le_coe.1 (hS.nonneg hx)
  directedOn x hx y hy := by
    obtain ⟨s, hsS, hxs, hys⟩ := hS.directedOn x.1 hx y.1 hy
    obtain ⟨w, hwI, hxw, hyw⟩ := I.directedOn x.1 x.2 y.1 y.2
    obtain ⟨z, hxz, hyz, hzs, hzw⟩ := hG.exists_ge_ge_le_le hxs hxw hys hyw
    have hz0 : 0 ≤ z := (hS.nonneg hx).trans hxz
    have hzI : z ∈ I := I.mem_of_nonneg_of_le hz0 hzw hwI
    exact ⟨⟨z, hzI⟩, hS.mem_of_nonneg_of_le hz0 hzs hsS, hxz, hyz⟩
  mem_of_nonneg_of_le _ _ hx0 hxy hy :=
    hS.mem_of_nonneg_of_le (Subtype.coe_le_coe.2 hx0) (Subtype.coe_le_coe.2 hxy) hy
  mem_closure_of_nonneg := by
    have hmem : ∀ {w : G}, w ∈ AddSubmonoid.closure S → ∀ (hwI : w ∈ I),
        (⟨w, hwI⟩ : I) ∈ AddSubmonoid.closure ((Subtype.val : I → G) ⁻¹' S) := by
      intro w hw
      refine AddSubmonoid.closure_induction_left
        (motive := fun w _ ↦ ∀ (hwI : w ∈ I),
          (⟨w, hwI⟩ : I) ∈ AddSubmonoid.closure ((Subtype.val : I → G) ⁻¹' S))
        (fun _ ↦ zero_mem _) (fun s hs y hy ih hsyI ↦ ?_) hw
      have hs0 : 0 ≤ s := hS.nonneg hs
      have hy0 : 0 ≤ y := AddSubmonoid.mem_nonneg.1 (hS.closure_eq_nonneg ▸ hy)
      have hsI : s ∈ I := I.mem_of_nonneg_of_le hs0 (le_add_of_nonneg_right hy0) hsyI
      have hyI : y ∈ I := I.mem_of_nonneg_of_le hy0 (le_add_of_nonneg_left hs0) hsyI
      have hs_mem : (⟨s, hsI⟩ : I) ∈ (Subtype.val : I → G) ⁻¹' S := hs
      exact add_mem (AddSubmonoid.subset_closure hs_mem) (ih hyI)
    exact fun g hg0 ↦ hmem (hS.mem_closure_of_nonneg (Subtype.coe_le_coe.2 hg0)) g.2

/-- Under Riesz interpolation, the image of a scale `S` of `G` in the quotient
`G ⧸ I.toAddSubgroup` is a scale (`Σ(A/I) = q(Σ(A))`). -/
theorem isScale_image_quotientMk (hG : HasRieszInterpolation G) {S : Set G} (hS : IsScale S) :
    IsScale (I.quotientMk '' S) where
  zero_mem := ⟨0, hS.zero_mem, map_zero I.quotientMk⟩
  nonneg := by
    rintro _ ⟨s, hs, rfl⟩
    exact map_nonneg I.quotientMk (hS.nonneg hs)
  directedOn := by
    rintro _ ⟨s₁, hs₁, rfl⟩ _ ⟨s₂, hs₂, rfl⟩
    obtain ⟨s, hs, hs₁s, hs₂s⟩ := hS.directedOn s₁ hs₁ s₂ hs₂
    exact ⟨I.quotientMk s, ⟨s, hs, rfl⟩, OrderHomClass.mono I.quotientMk hs₁s,
      OrderHomClass.mono I.quotientMk hs₂s⟩
  mem_of_nonneg_of_le := by
    rintro q _ hq0 hqs ⟨s, hs, rfl⟩
    obtain ⟨x, hx0, hxs, rfl⟩ :=
      I.exists_nonneg_le_and_quotientMk_eq hG (hS.nonneg hs) hq0 hqs
    exact ⟨x, hS.mem_of_nonneg_of_le hx0 hxs hs, rfl⟩
  mem_closure_of_nonneg := by
    intro q hq0
    obtain ⟨g, hg0, rfl⟩ := (I.quotient_nonneg_iff).1 hq0
    rw [← AddMonoidHom.map_mclosure I.quotientMk]
    exact ⟨g, hS.mem_closure_of_nonneg hg0, I.quotientMk_apply g⟩

end OrderIdeal

end TauCeti
