/-!
# Order ideals and order units of partially ordered abelian groups

An *order ideal* of a partially ordered abelian group `G` is an additive subgroup `I` that is
upward directed and order-convex (`a ≤ x ≤ b` with `a, b ∈ I` implies `x ∈ I`). Equivalently,
`I` is generated by its non-negative elements and is hereditary in the positive cone `G⁺`
(`0 ≤ x ≤ y` with `y ∈ I` implies `x ∈ I`). An *order unit* of `G` is an element `u ≥ 0` whose
natural multiples eventually dominate every element of `G`; infinitesimals are permitted.

For dimension groups (such as the ordered `K₀`-groups of AF C⋆-algebras), order ideals classify
closed two-sided ideals, order units correspond to units of unital realizations, and simplicity
of the order-ideal lattice is equivalent to every strictly positive element being an order unit.

## Main definitions

* `TauCeti.OrderIdeal G`: upward directed, order-convex additive subgroups of `G`.
* `TauCeti.OrderIdeal.ofPosGenHereditary`: constructs an order ideal from an additive subgroup
  that is positively generated and hereditary in `G⁺`.
* `TauCeti.OrderIdeal.spanNonneg S hS`: the order ideal generated by a set `S` of non-negative
  elements of `G`.
* `TauCeti.OrderIdeal.principal u hu`: the order ideal generated by a single element `u ≥ 0`.
* `TauCeti.IsOrderUnit u`: `0 ≤ u` and every `x : G` satisfies `x ≤ n • u` for some `n : ℕ`.

## Main results

* `TauCeti.OrderIdeal.isDimensionGroup`: an order ideal of a dimension group is a dimension group.
* `TauCeti.OrderIdeal.instLattice`, `TauCeti.OrderIdeal.instCompleteLattice`: order ideals form a
  lattice (and a complete lattice when `G` is directed).
* `TauCeti.HasRieszInterpolation.distribLatticeOrderIdeal`: under Riesz interpolation,
  `OrderIdeal G` is a distributive lattice with `(I ⊓ J : Set G) = I ∩ J` and
  `(I ⊔ J).toAddSubgroup = I.toAddSubgroup ⊔ J.toAddSubgroup`.
* `TauCeti.OrderIdeal.principal_eq_top_iff_isOrderUnit`: in a directed group, `principal u hu = ⊤`
  if and only if `u` is an order unit.
* `TauCeti.OrderIdeal.forall_eq_bot_or_eq_top_iff_isOrderUnit`: in a directed group, `⊥` and `⊤`
  are the only order ideals if and only if every `u > 0` is an order unit.

## References

* K. R. Goodearl, *Partially ordered abelian groups with interpolation*, Mathematical Surveys
  and Monographs 20, AMS, 1986, Chapter 1 and Proposition 2.2.
* M. Rørdam, *Classification of nuclear C⋆-algebras*, Encyclopaedia of Mathematical Sciences
  126, Springer, 2002, §§1.4–1.5.
-/

public section

namespace TauCeti

/-- An **order ideal** of a partially ordered abelian group `G` is an additive subgroup that is
upward directed and order-convex. -/
structure OrderIdeal (G : Type*) [AddCommGroup G] [PartialOrder G] extends AddSubgroup G where
  /-- An order ideal is upward directed. -/
  directedOn' : DirectedOn (· ≤ ·) carrier
  /-- An order ideal is order-convex. -/
  ordConnected' : carrier.OrdConnected

/-- An **order unit** of a preordered additive monoid `G` is a non-negative element `u` whose
natural multiples dominate every element of `G`. Infinitesimals are allowed: `n • x ≤ u` for all
`n : ℕ` need not force `x ≤ 0`. -/
def IsOrderUnit {G : Type*} [AddCommMonoid G] [Preorder G] (u : G) : Prop :=
  0 ≤ u ∧ ∀ x : G, ∃ n : ℕ, x ≤ n • u

namespace OrderIdeal

section Basic

variable {G : Type*} [AddCommGroup G] [PartialOrder G]

instance : SetLike (OrderIdeal G) G where
  coe I := I.carrier
  coe_injective := by
    intro ⟨I₁, _, _⟩ ⟨I₂, _, _⟩ h
    congr 1
    exact AddSubgroup.ext (Set.ext_iff.mp h)

instance : AddSubgroupClass (OrderIdeal G) G where
  add_mem {I} := I.toAddSubgroup.add_mem'
  zero_mem {I} := I.toAddSubgroup.zero_mem'
  neg_mem {I} := I.toAddSubgroup.neg_mem'

initialize_simps_projections OrderIdeal (carrier → coe, as_prefix coe)

/-- Membership in `I.toAddSubgroup` is membership in `I`. -/
@[simp]
theorem mem_toAddSubgroup {I : OrderIdeal G} {x : G} : x ∈ I.toAddSubgroup ↔ x ∈ I :=
  Iff.rfl

/-- The carrier of `I.toAddSubgroup` is `(I : Set G)`. -/
@[simp]
theorem coe_toAddSubgroup (I : OrderIdeal G) : (I.toAddSubgroup : Set G) = I :=
  rfl

/-- Two order ideals with the same elements are equal. -/
@[ext]
theorem ext {I J : OrderIdeal G} (h : ∀ x, x ∈ I ↔ x ∈ J) : I = J :=
  SetLike.ext h

/-- Two order ideals with the same underlying additive subgroup are equal. -/
theorem toAddSubgroup_injective : Function.Injective (toAddSubgroup (G := G)) :=
  fun _ _ h ↦ ext fun x ↦ by rw [← mem_toAddSubgroup, ← mem_toAddSubgroup, h]

/-- `toAddSubgroup` is injective as an equivalence of equalities. -/
@[simp]
theorem toAddSubgroup_inj {I J : OrderIdeal G} : I.toAddSubgroup = J.toAddSubgroup ↔ I = J :=
  toAddSubgroup_injective.eq_iff

/-- An order ideal is upward directed. -/
theorem directedOn (I : OrderIdeal G) : DirectedOn (· ≤ ·) (I : Set G) :=
  I.directedOn'

/-- An order ideal is order-connected. -/
theorem ordConnected (I : OrderIdeal G) : (I : Set G).OrdConnected :=
  I.ordConnected'

/-- Order-convexity of an order ideal: `a ≤ x ≤ b` with `a, b ∈ I` implies `x ∈ I`. -/
theorem convex (I : OrderIdeal G) {a b x : G} (ha : a ∈ I) (hb : b ∈ I)
    (hax : a ≤ x) (hxb : x ≤ b) : x ∈ I :=
  I.ordConnected'.out ha hb ⟨hax, hxb⟩

/-- An order ideal is hereditary in the positive cone: `0 ≤ x ≤ y` with `y ∈ I` implies
`x ∈ I`. -/
theorem mem_of_nonneg_of_le (I : OrderIdeal G) {x y : G} (hx : 0 ≤ x) (hxy : x ≤ y)
    (hy : y ∈ I) : x ∈ I :=
  I.convex (zero_mem I) hy hx hxy

/-- Every element of an order ideal is bounded above by a non-negative element of the ideal. -/
theorem exists_nonneg_le (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ y ∈ I, 0 ≤ y ∧ x ≤ y := by
  obtain ⟨y, hy, hxy, h0y⟩ := I.directedOn x hx 0 (zero_mem I)
  exact ⟨y, hy, h0y, hxy⟩

/-- As a subtype with the induced order, an order ideal is upward directed. -/
instance (I : OrderIdeal G) : IsDirectedOrder I :=
  I.directedOn.isDirectedOrder

/-- The canonical monotone additive homomorphism `I →+o G` of an order ideal. -/
def subtype (I : OrderIdeal G) : I →+o G where
  toAddMonoidHom := I.toAddSubgroup.subtype
  monotone' _ _ h := h

/-- Applying `OrderIdeal.subtype` coerces to `G`. -/
@[simp]
theorem subtype_apply (I : OrderIdeal G) (x : I) : I.subtype x = (x : G) :=
  (rfl)

/-- An order ideal inherits Riesz interpolation from the ambient group. -/
theorem hasRieszInterpolation (I : OrderIdeal G) (hG : HasRieszInterpolation G) :
    HasRieszInterpolation I := by
  rw [hasRieszInterpolation_iff]
  intro a₁ a₂ b₁ b₂ h₁₁ h₁₂ h₂₁ h₂₂
  obtain ⟨c, ha₁c, ha₂c, hcb₁, hcb₂⟩ := hG.exists_ge_ge_le_le h₁₁ h₁₂ h₂₁ h₂₂
  exact ⟨⟨c, I.convex a₁.2 b₁.2 ha₁c hcb₁⟩, ha₁c, ha₂c, hcb₁, hcb₂⟩

/-- An order ideal inherits unperforation from the ambient group. -/
theorem isUnperforated (I : OrderIdeal G) (hG : IsUnperforated G) : IsUnperforated I := by
  rw [isUnperforated_iff]
  intro n hn g hg
  have hg' : (0 : G) ≤ n • (g : G) := by
    simpa only [map_nsmul, subtype_apply] using map_nonneg I.subtype hg
  exact Subtype.coe_le_coe.1 (hG.nonneg_of_nsmul_nonneg hn hg')

/-- Order ideals are ordered by inclusion. -/
instance : PartialOrder (OrderIdeal G) :=
  PartialOrder.ofSetLike (OrderIdeal G)

/-- Inclusion of order ideals is inclusion of underlying additive subgroups. -/
@[simp]
theorem toAddSubgroup_le {I J : OrderIdeal G} : I.toAddSubgroup ≤ J.toAddSubgroup ↔ I ≤ J :=
  Iff.rfl

/-- Strict inclusion of order ideals is strict inclusion of underlying additive subgroups. -/
@[simp]
theorem toAddSubgroup_lt {I J : OrderIdeal G} : I.toAddSubgroup < J.toAddSubgroup ↔ I < J :=
  Iff.rfl

/-- The trivial subgroup `{0}` is an order ideal. -/
instance : Bot (OrderIdeal G) where
  bot :=
    { toAddSubgroup := ⊥
      directedOn' := by
        intro x hx y hy
        rw [AddSubgroup.mem_carrier, AddSubgroup.mem_bot] at hx hy
        exact ⟨0, by simp, by simp [hx], by simp [hy]⟩
      ordConnected' := by
        have h : (⊥ : AddSubgroup G).carrier = ({0} : Set G) := by
          ext x
          simp
        rw [h]
        exact Set.ordConnected_singleton }

/-- Only `0` belongs to the bottom order ideal `⊥`. -/
@[simp]
theorem mem_bot {x : G} : x ∈ (⊥ : OrderIdeal G) ↔ x = 0 :=
  AddSubgroup.mem_bot

/-- The underlying additive subgroup of `⊥` is `⊥`. -/
@[simp]
theorem bot_toAddSubgroup : (⊥ : OrderIdeal G).toAddSubgroup = ⊥ :=
  rfl

instance : OrderBot (OrderIdeal G) where
  bot_le I x hx := by
    rw [mem_bot.mp hx]
    exact zero_mem I

/-- When `G` is upward directed, the whole group is an order ideal. -/
instance [IsDirectedOrder G] : Top (OrderIdeal G) where
  top :=
    { toAddSubgroup := ⊤
      directedOn' := fun x _ y _ ↦
        let ⟨z, hxz, hyz⟩ := exists_ge_ge x y
        ⟨z, trivial, hxz, hyz⟩
      ordConnected' := Set.ordConnected_univ }

/-- Every element belongs to `⊤`. -/
@[simp]
theorem mem_top [IsDirectedOrder G] {x : G} : x ∈ (⊤ : OrderIdeal G) :=
  trivial

/-- The underlying additive subgroup of `⊤` is `⊤`. -/
@[simp]
theorem top_toAddSubgroup [IsDirectedOrder G] : (⊤ : OrderIdeal G).toAddSubgroup = ⊤ :=
  rfl

instance [IsDirectedOrder G] : OrderTop (OrderIdeal G) where
  le_top _ _ _ := trivial

/-- In a directed partially ordered abelian group, `⊥ = ⊤` in `OrderIdeal G` if and only if `G` is
a subsingleton. -/
@[simp]
theorem bot_eq_top_iff_subsingleton [IsDirectedOrder G] :
    (⊥ : OrderIdeal G) = ⊤ ↔ Subsingleton G := by
  refine ⟨fun h ↦ ⟨fun x y ↦ ?_⟩, fun hG ↦ ?_⟩
  · have hx : x ∈ (⊥ : OrderIdeal G) := h ▸ mem_top
    have hy : y ∈ (⊥ : OrderIdeal G) := h ▸ mem_top
    rw [mem_bot.1 hx, mem_bot.1 hy]
  · ext x
    simp [hG.elim x 0, zero_mem]

/-- In a directed partially ordered abelian group, `OrderIdeal G` is nontrivial if and only if `G`
is nontrivial. -/
theorem nontrivial_iff [IsDirectedOrder G] : Nontrivial (OrderIdeal G) ↔ Nontrivial G := by
  refine ⟨fun ⟨I, J, hIJ⟩ ↦ ?_,
    fun _ ↦ ⟨⊥, ⊤, mt bot_eq_top_iff_subsingleton.1 (not_subsingleton G)⟩⟩
  by_contra hG
  rw [not_nontrivial_iff_subsingleton] at hG
  exact hIJ (ext fun x ↦ by simp [hG.elim x 0, zero_mem])

end Basic

section OrderedGroup

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

/-- An order ideal of a dimension group is a dimension group. -/
theorem isDimensionGroup (I : OrderIdeal G) (hG : IsDimensionGroup G) : IsDimensionGroup I where
  isDirectedOrder := inferInstance
  isUnperforated := I.isUnperforated hG.isUnperforated
  hasRieszInterpolation := I.hasRieszInterpolation hG.hasRieszInterpolation

/-- Every element of an order ideal lies in the symmetric interval `[-u, u]` for some non-negative
element `u` of the ideal. -/
theorem exists_neg_le_and_le (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ u ∈ I, 0 ≤ u ∧ -u ≤ x ∧ x ≤ u := by
  obtain ⟨a, ha, ha0, hxa⟩ := I.exists_nonneg_le hx
  obtain ⟨b, hb, hb0, hnxb⟩ := I.exists_nonneg_le (neg_mem hx)
  refine ⟨a + b, add_mem ha hb, add_nonneg ha0 hb0, ?_, hxa.trans (le_add_of_nonneg_right hb0)⟩
  rw [neg_add]
  exact (add_le_of_nonpos_left (neg_nonpos.2 ha0)).trans (neg_le.1 hnxb)

/-- Every element of an order ideal is a difference of two non-negative elements of the ideal. -/
theorem exists_nonneg_sub (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ a ∈ I, ∃ b ∈ I, 0 ≤ a ∧ 0 ≤ b ∧ a - b = x := by
  obtain ⟨a, ha, ha0, hxa⟩ := I.exists_nonneg_le hx
  exact ⟨a, ha, a - x, sub_mem ha hx, ha0, sub_nonneg.2 hxa, sub_sub_cancel a x⟩

/-- Construct an order ideal from an additive subgroup that is positively generated and hereditary
in the positive cone `G⁺`. -/
def ofPosGenHereditary (H : AddSubgroup G)
    (hgen : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y)
    (hhered : ∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ H → x ∈ H) : OrderIdeal G where
  toAddSubgroup := H
  directedOn' x hx y hy := by
    obtain ⟨a, ha, ha0, hxa⟩ := hgen x hx
    obtain ⟨b, hb, hb0, hyb⟩ := hgen y hy
    exact ⟨a + b, H.add_mem ha hb, hxa.trans (le_add_of_nonneg_right hb0),
      hyb.trans (le_add_of_nonneg_left ha0)⟩
  ordConnected' := by
    refine ⟨fun {a} ha {b} hb x hx ↦ ?_⟩
    have hxa : x - a ∈ H :=
      hhered (sub_nonneg.2 hx.1) (sub_le_sub_right hx.2 a) (H.sub_mem hb ha)
    simpa using H.add_mem hxa ha

/-- Membership in `ofPosGenHereditary H hgen hhered` is membership in `H`. -/
@[simp]
theorem mem_ofPosGenHereditary {H : AddSubgroup G}
    {hgen : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y}
    {hhered : ∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ H → x ∈ H} {x : G} :
    x ∈ ofPosGenHereditary H hgen hhered ↔ x ∈ H :=
  (Iff.rfl)

/-- `ofPosGenHereditary` recovers `H` as its underlying additive subgroup. -/
@[simp]
theorem ofPosGenHereditary_toAddSubgroup (H : AddSubgroup G)
    (hgen : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y)
    (hhered : ∀ ⦃x y : G⦄, 0 ≤ x → x ≤ y → y ∈ H → x ∈ H) :
    (ofPosGenHereditary H hgen hhered).toAddSubgroup = H :=
  (rfl)

/-- Inclusion of order ideals is determined on non-negative elements. -/
theorem le_iff_nonneg {I J : OrderIdeal G} :
    I ≤ J ↔ ∀ ⦃x : G⦄, 0 ≤ x → x ∈ I → x ∈ J := by
  refine ⟨fun h x _ hx ↦ h hx, fun h x hx ↦ ?_⟩
  obtain ⟨u, hu, hu0, hnux, hxu⟩ := I.exists_neg_le_and_le hx
  have huJ : u ∈ J := h hu0 hu
  exact J.convex (neg_mem huJ) huJ hnux hxu

/-- Two order ideals with the same non-negative elements are equal. -/
theorem ext_nonneg {I J : OrderIdeal G} (h : ∀ ⦃x : G⦄, 0 ≤ x → (x ∈ I ↔ x ∈ J)) : I = J :=
  le_antisymm (le_iff_nonneg.2 fun _ hx0 hx ↦ (h hx0).1 hx)
    (le_iff_nonneg.2 fun _ hx0 hx ↦ (h hx0).2 hx)

/-- An order ideal equals `⊥` if and only if its only non-negative element is `0`. -/
theorem eq_bot_iff_forall_nonneg {I : OrderIdeal G} :
    I = ⊥ ↔ ∀ ⦃u : G⦄, 0 ≤ u → u ∈ I → u = 0 := by
  rw [← le_bot_iff, le_iff_nonneg]
  simp

/-- An order ideal is nontrivial (`≠ ⊥`) if and only if it contains a strictly positive element. -/
theorem ne_bot_iff_exists_pos {I : OrderIdeal G} :
    I ≠ ⊥ ↔ ∃ u ∈ I, 0 < u := by
  rw [ne_eq, eq_bot_iff_forall_nonneg]
  push Not
  refine ⟨fun ⟨u, hu0, huI, hu⟩ ↦ ⟨u, huI, hu0.lt_of_ne' hu⟩,
    fun ⟨u, huI, hu⟩ ↦ ⟨u, hu.le, huI, hu.ne'⟩⟩

/-! ### Order ideals generated by non-negative elements and lattice structure -/

/-- The order ideal generated by a set `S` of non-negative elements: its elements are those
bounded in `[-u, u]` by some `u` in the additive submonoid generated by `S`. -/
def spanNonneg (S : Set G) (hS : ∀ s ∈ S, 0 ≤ s) : OrderIdeal G where
  toAddSubgroup :=
    { carrier := {x : G | ∃ u ∈ AddSubmonoid.closure S, -u ≤ x ∧ x ≤ u}
      zero_mem' := ⟨0, zero_mem _, by simp, by simp⟩
      add_mem' := fun ⟨u, hu, hu₁, hu₂⟩ ⟨v, hv, hv₁, hv₂⟩ ↦
        ⟨u + v, add_mem hu hv, by rw [neg_add]; exact add_le_add hu₁ hv₁, add_le_add hu₂ hv₂⟩
      neg_mem' := fun ⟨u, hu, hu₁, hu₂⟩ ↦ ⟨u, hu, neg_le_neg hu₂, neg_le.1 hu₁⟩ }
  directedOn' := fun x ⟨u, hu, _, hxu⟩ y ⟨v, hv, _, hyv⟩ ↦ by
    have hS' : S ⊆ AddSubmonoid.nonneg G := fun s hs ↦ hS s hs
    have hu0 : 0 ≤ u := AddSubmonoid.mem_nonneg.1 (AddSubmonoid.closure_le.2 hS' hu)
    have hv0 : 0 ≤ v := AddSubmonoid.mem_nonneg.1 (AddSubmonoid.closure_le.2 hS' hv)
    have huv0 : 0 ≤ u + v := add_nonneg hu0 hv0
    exact ⟨u + v, Set.mem_ofPred.2 ⟨u + v, add_mem hu hv, (neg_nonpos.2 huv0).trans huv0, le_rfl⟩,
      hxu.trans (le_add_of_nonneg_right hv0), hyv.trans (le_add_of_nonneg_left hu0)⟩
  ordConnected' := ⟨fun {_} ⟨u, hu, hu₁, _⟩ {_} ⟨v, hv, _, hv₂⟩ x hx ↦ by
    have hS' : S ⊆ AddSubmonoid.nonneg G := fun s hs ↦ hS s hs
    have hu0 : 0 ≤ u := AddSubmonoid.mem_nonneg.1 (AddSubmonoid.closure_le.2 hS' hu)
    have hv0 : 0 ≤ v := AddSubmonoid.mem_nonneg.1 (AddSubmonoid.closure_le.2 hS' hv)
    refine Set.mem_ofPred.2 ⟨u + v, add_mem hu hv, ?_,
      (hx.2.trans hv₂).trans (le_add_of_nonneg_left hu0)⟩
    rw [neg_add]
    exact (add_le_of_nonpos_right (neg_nonpos.2 hv0)).trans (hu₁.trans hx.1)⟩

/-- Membership in `spanNonneg S hS` is boundedness in `[-u, u]` by a finite sum from `S`. -/
@[simp]
theorem mem_spanNonneg_iff {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {x : G} :
    x ∈ spanNonneg S hS ↔ ∃ u ∈ AddSubmonoid.closure S, -u ≤ x ∧ x ≤ u :=
  (Iff.rfl)

/-- `S` is contained in `spanNonneg S hS`. -/
theorem subset_spanNonneg (S : Set G) (hS : ∀ s ∈ S, 0 ≤ s) :
    S ⊆ spanNonneg S hS := fun s hs ↦
  mem_spanNonneg_iff.2
    ⟨s, AddSubmonoid.subset_closure hs, (neg_nonpos.2 (hS s hs)).trans (hS s hs), le_rfl⟩

/-- Galois property of `spanNonneg`: `spanNonneg S hS ≤ I` if and only if `S ⊆ I`. -/
@[simp]
theorem spanNonneg_le {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {I : OrderIdeal G} :
    spanNonneg S hS ≤ I ↔ S ⊆ I := by
  refine ⟨fun h ↦ (subset_spanNonneg S hS).trans h, fun h x hx ↦ ?_⟩
  obtain ⟨u, hu, hux, hxu⟩ := mem_spanNonneg_iff.1 hx
  have huI : u ∈ I :=
    AddSubmonoid.closure_induction (fun _ hs ↦ h hs) (zero_mem I) (fun _ _ _ _ ↦ add_mem) hu
  exact I.convex (neg_mem huI) huI hux hxu

/-- The supremum of a family of order ideals, generated by the union of their positive cones. -/
instance : SupSet (OrderIdeal G) where
  sSup s := spanNonneg {u : G | 0 ≤ u ∧ ∃ I ∈ s, u ∈ I} fun _ hu ↦ hu.1

/-- The binary supremum of two order ideals, generated by the non-negative elements of both. -/
instance : Max (OrderIdeal G) where
  max I J := spanNonneg {u : G | 0 ≤ u ∧ (u ∈ I ∨ u ∈ J)} fun _ hu ↦ hu.1

/-- The binary infimum of two order ideals: the largest order ideal contained in `I ∩ J`,
generated by `I⁺ ∩ J⁺`. Under Riesz interpolation its underlying set is `I ∩ J` (`coe_inf`). -/
instance : Min (OrderIdeal G) where
  min I J := spanNonneg {u : G | 0 ≤ u ∧ u ∈ I ∧ u ∈ J} fun _ hu ↦ hu.1

/-- The infimum of a family of order ideals, generated by the intersection of their positive
cones. -/
instance : InfSet (OrderIdeal G) where
  sInf s := spanNonneg {u : G | 0 ≤ u ∧ ∀ I ∈ s, u ∈ I} fun _ hu ↦ hu.1

/-- Order ideals of any partially ordered abelian group form a lattice. -/
instance instLattice : Lattice (OrderIdeal G) where
  __ := (inferInstance : PartialOrder (OrderIdeal G))
  sup := Max.max
  le_sup_left _ _ := le_iff_nonneg.2 fun _ hu0 huI ↦ subset_spanNonneg _ _ ⟨hu0, Or.inl huI⟩
  le_sup_right _ _ := le_iff_nonneg.2 fun _ hu0 huJ ↦ subset_spanNonneg _ _ ⟨hu0, Or.inr huJ⟩
  sup_le _ _ _ hIK hJK := spanNonneg_le.2 fun _ ⟨_, hIJ⟩ ↦ hIJ.elim (hIK ·) (hJK ·)
  inf := Min.min
  inf_le_left _ _ := spanNonneg_le.2 fun _ h ↦ h.2.1
  inf_le_right _ _ := spanNonneg_le.2 fun _ h ↦ h.2.2
  le_inf _ _ _ hKI hKJ := le_iff_nonneg.2 fun _ hu0 huK ↦
    subset_spanNonneg _ _ ⟨hu0, hKI huK, hKJ huK⟩

/-- A non-negative element belongs to `I ⊓ J` if and only if it belongs to both `I` and `J`. -/
theorem mem_inf_of_nonneg {I J : OrderIdeal G} {u : G} (hu : 0 ≤ u) :
    u ∈ I ⊓ J ↔ u ∈ I ∧ u ∈ J :=
  ⟨fun h ↦ ⟨(inf_le_left : I ⊓ J ≤ I) h, (inf_le_right : I ⊓ J ≤ J) h⟩,
    fun ⟨huI, huJ⟩ ↦ subset_spanNonneg _ _ ⟨hu, huI, huJ⟩⟩

/-- In a directed partially ordered abelian group, order ideals form a complete lattice. -/
instance instCompleteLattice [IsDirectedOrder G] : CompleteLattice (OrderIdeal G) where
  __ := instLattice
  __ := (inferInstance : OrderTop (OrderIdeal G))
  __ := (inferInstance : OrderBot (OrderIdeal G))
  sSup := sSup
  isLUB_sSup _ :=
    ⟨fun I hI ↦ le_iff_nonneg.2 fun _ hu0 huI ↦ subset_spanNonneg _ _ ⟨hu0, I, hI, huI⟩,
      fun _ hJ ↦ spanNonneg_le.2 fun _ ⟨_, _, hI, huI⟩ ↦ hJ hI huI⟩
  sInf := sInf
  isGLB_sInf _ :=
    ⟨fun I hI ↦ spanNonneg_le.2 fun _ hu ↦ hu.2 I hI,
      fun _ hK ↦ le_iff_nonneg.2 fun _ hu0 huK ↦
        subset_spanNonneg _ _ ⟨hu0, fun _ hI ↦ hK hI huK⟩⟩

/-- Every element of `I ⊔ J` is bounded in `[-(a + b), a + b]` for non-negative `a ∈ I` and
`b ∈ J`. -/
theorem mem_sup_iff {I J : OrderIdeal G} {x : G} :
    x ∈ I ⊔ J ↔ ∃ a ∈ I, ∃ b ∈ J, 0 ≤ a ∧ 0 ≤ b ∧ -(a + b) ≤ x ∧ x ≤ a + b := by
  refine ⟨fun hx ↦ ?_, fun ⟨a, ha, b, hb, _, _, h₁, h₂⟩ ↦ ?_⟩
  · obtain ⟨u, hu, hnux, hxu⟩ := mem_spanNonneg_iff.1 hx
    have huM : ∃ a ∈ I, ∃ b ∈ J, 0 ≤ a ∧ 0 ≤ b ∧ a + b = u :=
      AddSubmonoid.closure_induction
        (fun w ⟨hw0, hw⟩ ↦ hw.elim
          (fun hwI ↦ ⟨w, hwI, 0, zero_mem J, hw0, le_rfl, add_zero w⟩)
          (fun hwJ ↦ ⟨0, zero_mem I, w, hwJ, le_rfl, hw0, zero_add w⟩))
        ⟨0, zero_mem I, 0, zero_mem J, le_rfl, le_rfl, add_zero 0⟩
        (fun _ _ _ _ ⟨a₁, ha₁, b₁, hb₁, ha₁0, hb₁0, e₁⟩ ⟨a₂, ha₂, b₂, hb₂, ha₂0, hb₂0, e₂⟩ ↦
          ⟨a₁ + a₂, add_mem ha₁ ha₂, b₁ + b₂, add_mem hb₁ hb₂, add_nonneg ha₁0 ha₂0,
            add_nonneg hb₁0 hb₂0, by rw [← e₁, ← e₂]; abel⟩)
        hu
    obtain ⟨a, ha, b, hb, ha0, hb0, rfl⟩ := huM
    exact ⟨a, ha, b, hb, ha0, hb0, hnux, hxu⟩
  · have haM : a ∈ I ⊔ J := (le_sup_left : I ≤ I ⊔ J) ha
    have hbM : b ∈ I ⊔ J := (le_sup_right : J ≤ I ⊔ J) hb
    have hab : a + b ∈ I ⊔ J := add_mem haM hbM
    exact (I ⊔ J).convex (neg_mem hab) hab h₁ h₂

/-- Under Riesz interpolation, `I ⊓ J` has underlying set `I ∩ J` (Goodearl, Proposition 2.2). -/
theorem mem_inf_iff (hG : HasRieszInterpolation G) {I J : OrderIdeal G} {x : G} :
    x ∈ I ⊓ J ↔ x ∈ I ∧ x ∈ J := by
  refine ⟨fun hx ↦ ⟨(inf_le_left : I ⊓ J ≤ I) hx, (inf_le_right : I ⊓ J ≤ J) hx⟩,
    fun ⟨hxI, hxJ⟩ ↦ ?_⟩
  obtain ⟨a₁, ha₁I, ha₁0, hxa₁⟩ := I.exists_nonneg_le hxI
  obtain ⟨b₁, hb₁J, hb₁0, hxb₁⟩ := J.exists_nonneg_le hxJ
  obtain ⟨c₁, hc₁0, hxc₁, hc₁a₁, hc₁b₁⟩ := hG.exists_ge_ge_le_le ha₁0 hb₁0 hxa₁ hxb₁
  obtain ⟨a₂, ha₂I, ha₂0, hnxa₂⟩ := I.exists_nonneg_le (neg_mem hxI)
  obtain ⟨b₂, hb₂J, hb₂0, hnxb₂⟩ := J.exists_nonneg_le (neg_mem hxJ)
  obtain ⟨c₂, hc₂0, hnxc₂, hc₂a₂, hc₂b₂⟩ := hG.exists_ge_ge_le_le ha₂0 hb₂0 hnxa₂ hnxb₂
  have hc₁ : c₁ ∈ I ⊓ J := (mem_inf_of_nonneg hc₁0).2
    ⟨I.mem_of_nonneg_of_le hc₁0 hc₁a₁ ha₁I, J.mem_of_nonneg_of_le hc₁0 hc₁b₁ hb₁J⟩
  have hc₂ : c₂ ∈ I ⊓ J := (mem_inf_of_nonneg hc₂0).2
    ⟨I.mem_of_nonneg_of_le hc₂0 hc₂a₂ ha₂I, J.mem_of_nonneg_of_le hc₂0 hc₂b₂ hb₂J⟩
  exact (I ⊓ J).convex (neg_mem hc₂) hc₁ (neg_le.1 hnxc₂) hxc₁

/-- Under Riesz interpolation, the carrier of `I ⊓ J` is `(I : Set G) ∩ J`. -/
theorem coe_inf (hG : HasRieszInterpolation G) (I J : OrderIdeal G) :
    ((I ⊓ J : OrderIdeal G) : Set G) = (I : Set G) ∩ J :=
  Set.ext fun _ ↦ mem_inf_iff hG

/-- Under Riesz interpolation, a non-negative element belongs to `I ⊔ J` if and only if it splits
as `a + b` with non-negative `a ∈ I` and `b ∈ J` (Goodearl, Proposition 2.2). -/
theorem mem_sup_of_nonneg (hG : HasRieszInterpolation G) {I J : OrderIdeal G} {u : G}
    (hu : 0 ≤ u) :
    u ∈ I ⊔ J ↔ ∃ a ∈ I, ∃ b ∈ J, 0 ≤ a ∧ 0 ≤ b ∧ a + b = u := by
  refine ⟨fun h ↦ ?_, fun ⟨a, ha, b, hb, _, _, e⟩ ↦
    e ▸ add_mem ((le_sup_left : I ≤ I ⊔ J) ha) ((le_sup_right : J ≤ I ⊔ J) hb)⟩
  obtain ⟨a', ha', b', hb', ha'0, hb'0, -, huab⟩ := mem_sup_iff.1 h
  obtain ⟨a, b, ha0, haa', hb0, hbb', hsum⟩ := hG.exists_decomposition ha'0 hb'0 hu huab
  exact ⟨a, I.mem_of_nonneg_of_le ha0 haa' ha', b, J.mem_of_nonneg_of_le hb0 hbb' hb', ha0, hb0,
    hsum⟩

/-- Under Riesz interpolation, `(I ⊔ J).toAddSubgroup = I.toAddSubgroup ⊔ J.toAddSubgroup`
(Goodearl, Proposition 2.2). -/
theorem sup_toAddSubgroup (hG : HasRieszInterpolation G) (I J : OrderIdeal G) :
    (I ⊔ J).toAddSubgroup = I.toAddSubgroup ⊔ J.toAddSubgroup := by
  refine le_antisymm (fun x hx ↦ ?_) (sup_le (toAddSubgroup_le.2 le_sup_left)
    (toAddSubgroup_le.2 le_sup_right))
  obtain ⟨u, hu, bx, hb, hu0, hb0, rfl⟩ := (I ⊔ J).exists_nonneg_sub hx
  obtain ⟨a₁, ha₁, b₁, hb₁, -, -, rfl⟩ := (mem_sup_of_nonneg hG hu0).1 hu
  obtain ⟨a₂, ha₂, b₂, hb₂, -, -, rfl⟩ := (mem_sup_of_nonneg hG hb0).1 hb
  have eq : a₁ + b₁ - (a₂ + b₂) = (a₁ - a₂) + (b₁ - b₂) := by abel
  rw [eq]
  exact AddSubgroup.add_mem_sup (sub_mem ha₁ ha₂) (sub_mem hb₁ hb₂)

end OrderedGroup

end OrderIdeal

/-- Under Riesz interpolation, the lattice of order ideals of `G` is distributive
(Goodearl, Proposition 2.2). -/
@[instance_reducible]
def HasRieszInterpolation.distribLatticeOrderIdeal {G : Type*} [AddCommGroup G] [PartialOrder G]
    [IsOrderedAddMonoid G] (hG : HasRieszInterpolation G) : DistribLattice (OrderIdeal G) where
  __ := OrderIdeal.instLattice
  le_sup_inf I J K := OrderIdeal.le_iff_nonneg.2 fun u hu0 hu ↦ by
    obtain ⟨huIJ, huIK⟩ := (OrderIdeal.mem_inf_of_nonneg hu0).1 hu
    obtain ⟨a₁, ha₁I, b, hbJ, ha₁0, hb0, e₁⟩ := (OrderIdeal.mem_sup_of_nonneg hG hu0).1 huIJ
    obtain ⟨a₂, ha₂I, c, hcK, ha₂0, hc0, e₂⟩ := (OrderIdeal.mem_sup_of_nonneg hG hu0).1 huIK
    obtain ⟨z₁₁, z₁₂, z₂₁, z₂₂, hz₁₁, hz₁₂, hz₂₁, hz₂₂, r₁, r₂, c₁, c₂⟩ :=
      hG.exists_refinement ha₁0 hb0 ha₂0 hc0 (e₁.trans e₂.symm)
    have ha₁I' : z₁₁ + z₁₂ ∈ I := r₁.symm ▸ ha₁I
    have hz₂₁I : z₂₁ ∈ I :=
      I.mem_of_nonneg_of_le hz₂₁ (c₁ ▸ le_add_of_nonneg_left hz₁₁) ha₂I
    have hz₂₂JK : z₂₂ ∈ J ⊓ K := (OrderIdeal.mem_inf_of_nonneg hz₂₂).2
      ⟨J.mem_of_nonneg_of_le hz₂₂ (r₂ ▸ le_add_of_nonneg_left hz₂₁) hbJ,
        K.mem_of_nonneg_of_le hz₂₂ (c₂ ▸ le_add_of_nonneg_left hz₁₂) hcK⟩
    have eq : u = (z₁₁ + z₁₂ + z₂₁) + z₂₂ := by rw [← e₁, ← r₁, ← r₂]; abel
    rw [eq]
    exact add_mem ((le_sup_left : I ≤ I ⊔ (J ⊓ K)) (add_mem ha₁I' hz₂₁I))
      ((le_sup_right : J ⊓ K ≤ I ⊔ (J ⊓ K)) hz₂₂JK)

/-! ### Order units, principal order ideals and simplicity -/

namespace IsOrderUnit

section AddCommMonoid

variable {G H : Type*} [AddCommMonoid G] [Preorder G] [AddCommMonoid H] [Preorder H]

/-- Unfolding lemma for `IsOrderUnit`. -/
theorem iff_nonneg_and_forall_exists_le_nsmul {u : G} :
    IsOrderUnit u ↔ 0 ≤ u ∧ ∀ x : G, ∃ n : ℕ, x ≤ n • u :=
  (Iff.rfl)

/-- An order unit is non-negative. -/
theorem nonneg {u : G} (hu : IsOrderUnit u) : 0 ≤ u :=
  hu.1

/-- Every element is bounded above by a natural multiple of an order unit. -/
theorem exists_le_nsmul {u : G} (hu : IsOrderUnit u) (x : G) : ∃ n : ℕ, x ≤ n • u :=
  hu.2 x

/-- An ordered additive commutative monoid admitting an order unit is upward directed. -/
theorem isDirectedOrder [IsOrderedAddMonoid G] {u : G} (hu : IsOrderUnit u) :
    IsDirectedOrder G where
  directed x y := by
    obtain ⟨m, hm⟩ := hu.exists_le_nsmul x
    obtain ⟨n, hn⟩ := hu.exists_le_nsmul y
    exact ⟨max m n • u, hm.trans (nsmul_le_nsmul_left hu.nonneg (le_max_left m n)),
      hn.trans (nsmul_le_nsmul_left hu.nonneg (le_max_right m n))⟩

/-- A nonzero natural multiple of an order unit is an order unit. -/
theorem nsmul [IsOrderedAddMonoid G] {u : G} (hu : IsOrderUnit u) {k : ℕ} (hk : k ≠ 0) :
    IsOrderUnit (k • u) := by
  refine ⟨nsmul_nonneg hu.nonneg k, fun x ↦ ?_⟩
  obtain ⟨n, hn⟩ := hu.exists_le_nsmul x
  refine ⟨n, hn.trans ?_⟩
  rw [← mul_nsmul']
  exact nsmul_le_nsmul_left hu.nonneg (Nat.le_mul_of_pos_right n (Nat.pos_of_ne_zero hk))

/-- Adding a non-negative element to an order unit produces an order unit. -/
theorem add_of_nonneg [IsOrderedAddMonoid G] {u v : G} (hu : IsOrderUnit u) (hv : 0 ≤ v) :
    IsOrderUnit (u + v) := by
  refine ⟨add_nonneg hu.nonneg hv, fun x ↦ ?_⟩
  obtain ⟨n, hn⟩ := hu.exists_le_nsmul x
  exact ⟨n, hn.trans (nsmul_le_nsmul_right (le_add_of_nonneg_right hv) n)⟩

/-- A surjective monotone additive homomorphism sends an order unit to an order unit. -/
theorem map_of_surjective {F : Type*} [FunLike F G H] [AddMonoidHomClass F G H]
    [OrderHomClass F G H] (f : F) (hf : Function.Surjective f) {u : G} (hu : IsOrderUnit u) :
    IsOrderUnit (f u) := by
  refine ⟨map_nonneg f hu.nonneg, fun y ↦ ?_⟩
  obtain ⟨x, rfl⟩ := hf y
  obtain ⟨n, hn⟩ := hu.exists_le_nsmul x
  exact ⟨n, map_nsmul f n u ▸ OrderHomClass.mono f hn⟩

/-- An ordered additive isomorphism preserves and reflects order units. -/
@[simp]
theorem map_orderAddMonoidIso_iff (e : G ≃+o H) {u : G} :
    IsOrderUnit (e u) ↔ IsOrderUnit u :=
  ⟨fun h ↦ e.symm_apply_apply u ▸ h.map_of_surjective e.symm e.symm.surjective,
    fun h ↦ h.map_of_surjective e e.surjective⟩

/-- A pair `(u, v)` in a product is an order unit if and only if `u` and `v` are order units. -/
@[simp]
theorem prod_iff [IsOrderedAddMonoid G] [IsOrderedAddMonoid H] {u : G} {v : H} :
    IsOrderUnit (u, v) ↔ IsOrderUnit u ∧ IsOrderUnit v := by
  refine ⟨fun h ↦ ⟨⟨h.nonneg.1, fun x ↦ ?_⟩, ⟨h.nonneg.2, fun y ↦ ?_⟩⟩, fun ⟨hu, hv⟩ ↦ ?_⟩
  · obtain ⟨n, hn⟩ := h.exists_le_nsmul (x, 0)
    exact ⟨n, hn.1⟩
  · obtain ⟨n, hn⟩ := h.exists_le_nsmul (0, y)
    exact ⟨n, hn.2⟩
  · refine ⟨⟨hu.nonneg, hv.nonneg⟩, fun ⟨x, y⟩ ↦ ?_⟩
    obtain ⟨m, hm⟩ := hu.exists_le_nsmul x
    obtain ⟨n, hn⟩ := hv.exists_le_nsmul y
    exact ⟨max m n, hm.trans (nsmul_le_nsmul_left hu.nonneg (le_max_left m n)),
      hn.trans (nsmul_le_nsmul_left hv.nonneg (le_max_right m n))⟩

end AddCommMonoid

section Archimedean

/-- In an Archimedean partially ordered additive monoid, every strictly positive element is an
order unit. -/
theorem of_archimedean {G : Type*} [AddCommMonoid G] [PartialOrder G] [Archimedean G]
    {u : G} (hu : 0 < u) : IsOrderUnit u :=
  ⟨hu.le, fun x ↦ Archimedean.arch x hu⟩

end Archimedean

section AddCommGroup

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

/-- Every element lies in `[-(n • u), n • u]` for some `n : ℕ` when `u` is an order unit. -/
theorem exists_neg_nsmul_le_and_le_nsmul {u : G} (hu : IsOrderUnit u) (x : G) :
    ∃ n : ℕ, -(n • u) ≤ x ∧ x ≤ n • u := by
  obtain ⟨m, hm⟩ := hu.exists_le_nsmul x
  obtain ⟨n, hn⟩ := hu.exists_le_nsmul (-x)
  refine ⟨max m n, ?_, hm.trans (nsmul_le_nsmul_left hu.nonneg (le_max_left m n))⟩
  exact neg_le.1 (hn.trans (nsmul_le_nsmul_left hu.nonneg (le_max_right m n)))

/-- In a nontrivial directed partially ordered abelian group, an order unit is strictly positive. -/
theorem pos [Nontrivial G] [IsDirectedOrder G] {u : G} (hu : IsOrderUnit u) : 0 < u := by
  refine hu.nonneg.lt_of_ne' fun h0 ↦ ?_
  subst h0
  obtain ⟨x, hx⟩ := exists_ne (0 : G)
  obtain ⟨y, hxy, h0y⟩ := exists_ge_ge x 0
  rcases eq_or_ne y 0 with rfl | hy0
  · obtain ⟨n, hn⟩ := hu.exists_le_nsmul (-x)
    rw [nsmul_zero, neg_nonpos] at hn
    exact hx (le_antisymm hxy hn)
  · obtain ⟨n, hn⟩ := hu.exists_le_nsmul y
    rw [nsmul_zero] at hn
    exact hy0 (le_antisymm hn h0y)

end AddCommGroup

end IsOrderUnit

namespace OrderIdeal

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

/-- The principal order ideal generated by a non-negative element `u`. -/
def principal (u : G) (hu : 0 ≤ u) : OrderIdeal G :=
  spanNonneg {u} (by simp [hu])

/-- Membership in `principal u hu`: boundedness in `[-(n • u), n • u]` for some `n : ℕ`. -/
@[simp]
theorem mem_principal_iff {u : G} {hu : 0 ≤ u} {x : G} :
    x ∈ principal u hu ↔ ∃ n : ℕ, -(n • u) ≤ x ∧ x ≤ n • u := by
  simp only [principal, mem_spanNonneg_iff, AddSubmonoid.mem_closure_singleton]
  exact ⟨fun ⟨_, ⟨n, rfl⟩, h₁, h₂⟩ ↦ ⟨n, h₁, h₂⟩, fun ⟨n, h₁, h₂⟩ ↦ ⟨n • u, ⟨n, rfl⟩, h₁, h₂⟩⟩

/-- The generator `u` belongs to `principal u hu`. -/
theorem self_mem_principal (u : G) (hu : 0 ≤ u) : u ∈ principal u hu :=
  subset_spanNonneg {u} (by simp [hu]) rfl

/-- Universal property of `principal`: `principal u hu ≤ I` if and only if `u ∈ I`. -/
@[simp]
theorem principal_le_iff {u : G} {hu : 0 ≤ u} {I : OrderIdeal G} :
    principal u hu ≤ I ↔ u ∈ I := by
  simp [principal]

/-- `principal u hu = ⊥` if and only if `u = 0`. -/
@[simp]
theorem principal_eq_bot_iff {u : G} {hu : 0 ≤ u} : principal u hu = ⊥ ↔ u = 0 := by
  rw [← le_bot_iff, principal_le_iff, mem_bot]

/-- In a directed partially ordered abelian group, `principal u hu = ⊤` if and only if `u` is an
order unit. -/
theorem principal_eq_top_iff_isOrderUnit [IsDirectedOrder G] {u : G} (hu : 0 ≤ u) :
    principal u hu = ⊤ ↔ IsOrderUnit u := by
  rw [← top_le_iff]
  refine ⟨fun h ↦ ⟨hu, fun x ↦ ?_⟩, fun h x _ ↦ mem_principal_iff.2
    (h.exists_neg_nsmul_le_and_le_nsmul x)⟩
  obtain ⟨n, -, hxn⟩ := mem_principal_iff.1 (h mem_top)
  exact ⟨n, hxn⟩

/-- **Simplicity of directed ordered abelian groups**: the only order ideals of `G` are `⊥` and `⊤`
if and only if every strictly positive element of `G` is an order unit (Rørdam, §1.5; Goodearl,
Proposition 14.1). -/
theorem forall_eq_bot_or_eq_top_iff_isOrderUnit [IsDirectedOrder G] :
    (∀ I : OrderIdeal G, I = ⊥ ∨ I = ⊤) ↔ ∀ ⦃u : G⦄, 0 < u → IsOrderUnit u := by
  refine ⟨fun h u hu ↦ ?_, fun h I ↦ ?_⟩
  · rcases h (principal u hu.le) with hbot | htop
    · exact absurd (principal_eq_bot_iff.1 hbot) hu.ne'
    · exact (principal_eq_top_iff_isOrderUnit hu.le).1 htop
  · by_cases hI : I = ⊥
    · exact Or.inl hI
    · obtain ⟨u, huI, hu0⟩ := ne_bot_iff_exists_pos.1 hI
      have htop : principal u hu0.le = ⊤ := (principal_eq_top_iff_isOrderUnit hu0.le).2 (h hu0)
      exact Or.inr (top_unique (htop ▸ principal_le_iff.2 huI))

/-- A nontrivial directed partially ordered abelian group has a simple lattice of order ideals if
and only if every strictly positive element is an order unit. -/
theorem isSimpleOrder_iff_isOrderUnit [IsDirectedOrder G] [Nontrivial G] :
    IsSimpleOrder (OrderIdeal G) ↔ ∀ ⦃u : G⦄, 0 < u → IsOrderUnit u := by
  have : Nontrivial (OrderIdeal G) := nontrivial_iff.2 inferInstance
  exact ⟨fun h ↦ forall_eq_bot_or_eq_top_iff_isOrderUnit.1 h.eq_bot_or_eq_top,
    fun h ↦ ⟨forall_eq_bot_or_eq_top_iff_isOrderUnit.2 h⟩⟩

end OrderIdeal

end TauCeti
