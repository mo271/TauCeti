module

public import TauCeti.Algebra.TypeAHeckeAlgebra.GroupAlgebra
public import TauCeti.Algebra.TypeAHeckeAlgebra.Parabolic.PermutationModule
public import TauCeti.RepresentationTheory.Symmetric.CosetRepresentative

/-!
# Young parabolic subalgebras, q-symmetrizers, and Hecke permutation modules

For a partition `μ` of `n` (or a Young diagram `μ` of size `|μ|`), this file specializes the
parabolic subalgebra, parabolic eigen-sum, and parabolic permutation-module theory of
`TypeAHeckeAlgebra R q n` to Young subgroups and tableaux over an arbitrary commutative ring `R`
and unit parameter `q : Rˣ`:

* **Young parabolic subalgebras and q-symmetrizers.** `TauCeti.TypeAHeckeAlgebra.youngParabolic`
  is the parabolic subalgebra `parabolic q (youngGenSet μ)`, with PBW basis indexed by
  `TauCeti.youngSubgroup μ` (`TauCeti.TypeAHeckeAlgebra.youngParabolicBasis`). The row
  q-symmetrizer `TauCeti.TypeAHeckeAlgebra.youngSymmetrizer` and the column-superstandard
  q-antisymmetrizer `TauCeti.TypeAHeckeAlgebra.colSuperstandardAntisymmetrizer` satisfy
  quasi-idempotence with quantum-factorial scalars given by the row and column lengths of `μ`, and
  specialize at `q = 1` under `groupAlgebraEquiv` to `YoungTableau.rowSymmetrizer` and
  `YoungTableau.columnAntisymmetrizer`.
* **Hecke Young permutation modules and Dipper–James–Mathas generator action.**
  `TauCeti.TypeAHeckeAlgebra.youngPermutationModule` is the principal left ideal generated by
  `youngSymmetrizer q (shapePartition μ)`. Reindexing `permutationModuleBasis` along
  `RowStandardYoungTableau.equivMinimalCosetRep` yields its basis indexed by
  `RowStandardYoungTableau μ` (`TauCeti.TypeAHeckeAlgebra.youngPermutationBasis`), on which each
  generator `T q i` acts by `q` when `strand i` and `strandSucc i` share a row, by `S.swap` when
  `strand i` precedes `strandSucc i` in row order, and by `(q - q⁻¹) • b_S + b_{S.swap}` when
  `strandSucc i` precedes `strand i` in row order.
* **`q = 1` comparison with `TauCeti.permutationModule`.** At `q = 1`,
  `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleOneEquiv` identifies
  `youngPermutationModule (1 : Rˣ) μ` with `(TauCeti.permutationModule (shapePartition μ)).V`
  compatibly with the Hecke and symmetric-group actions along `groupAlgebraEquiv`.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52, Section 3.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Sections 3.1–3.2.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open Finset YoungTableau TauCeti.BraidGroup

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ}

/-! ### Young parabolic subalgebras and q-symmetrizers -/

/-- The **Young parabolic subalgebra** of `TypeAHeckeAlgebra R q n` attached to `μ : n.Partition`,
generated by the simple generators preserving the consecutive blocks of `μ`. -/
noncomputable def youngParabolic (q : Rˣ) (μ : n.Partition) :
    Subalgebra R (TypeAHeckeAlgebra R q n) :=
  parabolic q (youngGenSet μ)

theorem youngParabolic_def (q : Rˣ) (μ : n.Partition) :
    youngParabolic (R := R) q μ = parabolic q (youngGenSet μ) :=
  (rfl)

/-- The PBW basis `T_w` (`w ∈ youngSubgroup μ`) of the Young parabolic subalgebra. -/
noncomputable def youngParabolicBasis (q : Rˣ) (μ : n.Partition) :
    Module.Basis (youngSubgroup μ) R (youngParabolic (R := R) q μ) :=
  (parabolicBasis q (permCoxeterSystem n) (youngGenSet μ)).reindex
    (Equiv.subtypeEquivRight fun _ ↦ by rw [parabolic_youngGenSet])

@[simp]
theorem coe_youngParabolicBasis_apply (q : Rˣ) (μ : n.Partition) (w : youngSubgroup μ) :
    (youngParabolicBasis (R := R) q μ w : TypeAHeckeAlgebra R q n) =
      Tw q (permCoxeterSystem n) w := by
  -- Unfold `youngParabolicBasis` inside the subtype coercion so `Basis.reindex_apply` applies.
  change (((parabolicBasis q (permCoxeterSystem n) (youngGenSet μ)).reindex
      (Equiv.subtypeEquivRight fun _ ↦ by rw [parabolic_youngGenSet])) w :
      TypeAHeckeAlgebra R q n) = _
  rw [Module.Basis.reindex_apply]
  exact coe_parabolicBasis_apply (permCoxeterSystem n) (youngGenSet μ) _

/-- The **Young row q-symmetrizer** `x_μ = ∑_{w ∈ S_μ} q^{ℓ(w)} T_w` in
`TypeAHeckeAlgebra R q n`. -/
noncomputable def youngSymmetrizer (q : Rˣ) (μ : n.Partition) : TypeAHeckeAlgebra R q n :=
  parabolicEigenSum (permCoxeterSystem n) (youngGenSet μ) (q : R)

theorem youngSymmetrizer_def (q : Rˣ) (μ : n.Partition) :
    youngSymmetrizer (R := R) q μ =
      parabolicEigenSum (permCoxeterSystem n) (youngGenSet μ) (q : R) :=
  (rfl)

/-- The Young row `q`-symmetrizer lies in `youngParabolic q μ`. -/
theorem youngSymmetrizer_mem_youngParabolic (q : Rˣ) (μ : n.Partition) :
    youngSymmetrizer (R := R) q μ ∈ youngParabolic q μ :=
  parabolicEigenSum_mem_parabolic (permCoxeterSystem n) (youngGenSet μ) (q : R)

open scoped Classical in
@[simp]
theorem basisTw_repr_youngSymmetrizer (q : Rˣ) (μ : n.Partition) (w : Equiv.Perm (Fin n)) :
    (basisTw q (permCoxeterSystem n)).repr (youngSymmetrizer (R := R) q μ) w =
      if w ∈ youngSubgroup μ then (q : R) ^ (permCoxeterSystem n).length w else 0 := by
  rw [youngSymmetrizer_def, basisTw_repr_parabolicEigenSum]
  simp only [parabolic_youngGenSet]

/-- Left multiplication by `T q i` (`i ∈ youngGenSet μ`) scales `youngSymmetrizer q μ` by `q`. -/
theorem T_mul_youngSymmetrizer (q : Rˣ) (μ : n.Partition) {i : Fin (n - 1)}
    (hi : i ∈ youngGenSet μ) :
    T q i * youngSymmetrizer (R := R) q μ = (q : R) • youngSymmetrizer q μ :=
  T_mul_parabolicEigenSum (permCoxeterSystem n) (youngGenSet μ) (by simp [sub_mul]) hi

/-- Right multiplication by `T q i` (`i ∈ youngGenSet μ`) scales `youngSymmetrizer q μ` by `q`. -/
theorem youngSymmetrizer_mul_T (q : Rˣ) (μ : n.Partition) {i : Fin (n - 1)}
    (hi : i ∈ youngGenSet μ) :
    youngSymmetrizer (R := R) q μ * T q i = (q : R) • youngSymmetrizer q μ :=
  parabolicEigenSum_mul_T (permCoxeterSystem n) (youngGenSet μ) (by simp [sub_mul]) hi

/-- **Quasi-idempotence of the Young q-symmetrizer.** Its scalar is the product of the
`q²`-factorials of the parts of `μ`. -/
theorem youngSymmetrizer_mul_self (q : Rˣ) (μ : n.Partition) :
    youngSymmetrizer (R := R) q μ * youngSymmetrizer q μ =
      (μ.parts.map fun p ↦ ∏ d ∈ Icc 1 p, ∑ j ∈ range d, (q : R) ^ (2 * j)).prod •
        youngSymmetrizer q μ := by
  let _ : Fintype ((permCoxeterSystem n).parabolic (youngGenSet μ)) := Fintype.ofFinite _
  rw [youngSymmetrizer_def, parabolicEigenSum_q_mul_self]
  congr 1
  simp_rw [pow_mul (q : R) 2]
  exact sum_pow_permCoxeterSystem_length_parabolic_youngGenSet μ ((q : R) ^ 2)

/-! ### The column-superstandard q-antisymmetrizer -/

/-- The **column-superstandard q-antisymmetrizer**
`y_{t^μ} = ∑_{w ∈ C(t^μ)} (-q⁻¹)^{ℓ(w)} T_w` in `TypeAHeckeAlgebra R q μ.card`. -/
noncomputable def colSuperstandardAntisymmetrizer (q : Rˣ) (μ : YoungDiagram) :
    TypeAHeckeAlgebra R q μ.card :=
  parabolicEigenSum (permCoxeterSystem μ.card) (colSuperstandardGenSet μ) (-(↑q⁻¹ : R))

theorem colSuperstandardAntisymmetrizer_def (q : Rˣ) (μ : YoungDiagram) :
    colSuperstandardAntisymmetrizer (R := R) q μ =
      parabolicEigenSum (permCoxeterSystem μ.card) (colSuperstandardGenSet μ)
        (-(↑q⁻¹ : R)) :=
  (rfl)

open scoped Classical in
@[simp]
theorem basisTw_repr_colSuperstandardAntisymmetrizer (q : Rˣ) (μ : YoungDiagram)
    (w : Equiv.Perm (Fin μ.card)) :
    (basisTw q (permCoxeterSystem μ.card)).repr
        (colSuperstandardAntisymmetrizer (R := R) q μ) w =
      if w ∈ colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau then
        (-(↑q⁻¹ : R)) ^ (permCoxeterSystem μ.card).length w
      else 0 := by
  rw [colSuperstandardAntisymmetrizer_def, basisTw_repr_parabolicEigenSum]
  simp only [parabolic_colSuperstandardGenSet]

/-- Left multiplication by `T q i` (`i ∈ colSuperstandardGenSet μ`) scales
`colSuperstandardAntisymmetrizer q μ` by `-q⁻¹`. -/
theorem T_mul_colSuperstandardAntisymmetrizer (q : Rˣ) (μ : YoungDiagram) {i : Fin (μ.card - 1)}
    (hi : i ∈ colSuperstandardGenSet μ) :
    T q i * colSuperstandardAntisymmetrizer (R := R) q μ =
      -(↑q⁻¹ : R) • colSuperstandardAntisymmetrizer q μ := by
  have ha : (-(↑q⁻¹ : R)) * (-(↑q⁻¹ : R)) =
      ((q : R) - ↑q⁻¹) * (-(↑q⁻¹ : R)) + 1 := by
    simp [sub_mul]
  rw [colSuperstandardAntisymmetrizer_def]
  simpa only [neg_smul] using
    T_mul_parabolicEigenSum (permCoxeterSystem μ.card) (colSuperstandardGenSet μ) ha hi

/-- Right multiplication by `T q i` (`i ∈ colSuperstandardGenSet μ`) scales
`colSuperstandardAntisymmetrizer q μ` by `-q⁻¹`. -/
theorem colSuperstandardAntisymmetrizer_mul_T (q : Rˣ) (μ : YoungDiagram) {i : Fin (μ.card - 1)}
    (hi : i ∈ colSuperstandardGenSet μ) :
    colSuperstandardAntisymmetrizer (R := R) q μ * T q i =
      -(↑q⁻¹ : R) • colSuperstandardAntisymmetrizer q μ := by
  have ha : (-(↑q⁻¹ : R)) * (-(↑q⁻¹ : R)) =
      ((q : R) - ↑q⁻¹) * (-(↑q⁻¹ : R)) + 1 := by
    simp [sub_mul]
  rw [colSuperstandardAntisymmetrizer_def]
  simpa only [neg_smul] using
    parabolicEigenSum_mul_T (permCoxeterSystem μ.card) (colSuperstandardGenSet μ) ha hi

/-- **Quasi-idempotence of the column-superstandard q-antisymmetrizer.** Its scalar is the product
of the `q⁻²`-factorials of the column lengths of `μ`. -/
theorem colSuperstandardAntisymmetrizer_mul_self (q : Rˣ) (μ : YoungDiagram) :
    colSuperstandardAntisymmetrizer (R := R) q μ * colSuperstandardAntisymmetrizer q μ =
      (μ.transpose.rowLens.map fun c ↦
          ∏ d ∈ Icc 1 c, ∑ j ∈ range d, (↑q⁻¹ : R) ^ (2 * j)).prod •
        colSuperstandardAntisymmetrizer q μ := by
  let _ : Fintype ((permCoxeterSystem μ.card).parabolic (colSuperstandardGenSet μ)) :=
    Fintype.ofFinite _
  rw [colSuperstandardAntisymmetrizer_def, parabolicEigenSum_neg_inv_mul_self]
  congr 1
  simp_rw [pow_mul (↑q⁻¹ : R) 2]
  exact sum_pow_permCoxeterSystem_length_parabolic_colSuperstandardGenSet μ ((↑q⁻¹ : R) ^ 2)

/-- At `q = 1`, `youngSymmetrizer` maps under `groupAlgebraEquiv` to the row symmetrizer of
`rowSuperstandard μ`. -/
theorem groupAlgebraEquiv_youngSymmetrizer_one (μ : YoungDiagram) :
    groupAlgebraEquiv (permCoxeterSystem μ.card) inv_one.symm
        (youngSymmetrizer (R := R) (1 : Rˣ) (shapePartition μ)) =
      rowSymmetrizer (R := R) (StandardYoungTableau.rowSuperstandard μ).toTableau := by
  have hrow : rowSubgroup (StandardYoungTableau.rowSuperstandard μ).toTableau =
      youngSubgroup (shapePartition μ) := by
    have h := youngSubgroup_map_conj_eq_rowSubgroup
      (StandardYoungTableau.rowSuperstandard μ).toTableau
    rw [rowYoungConjugator_rowSuperstandard] at h
    ext σ
    simp [← h]
  ext w
  have hc := Finsupp.ext_iff.mp
    ((permCoxeterSystem μ.card).basisTw_repr_eq_coeff_groupAlgebraEquiv inv_one.symm
      (youngSymmetrizer (R := R) (1 : Rˣ) (shapePartition μ))) w
  rw [← hc, basisTw_repr_youngSymmetrizer, rowSymmetrizer_coeff]
  simp [hrow]

/-- At `q = 1`, `colSuperstandardAntisymmetrizer` maps under `groupAlgebraEquiv` to the column
antisymmetrizer of `colSuperstandard μ`. -/
theorem groupAlgebraEquiv_colSuperstandardAntisymmetrizer_one (μ : YoungDiagram) :
    groupAlgebraEquiv (permCoxeterSystem μ.card) inv_one.symm
        (colSuperstandardAntisymmetrizer (R := R) (1 : Rˣ) μ) =
      columnAntisymmetrizer (R := R) (StandardYoungTableau.colSuperstandard μ).toTableau := by
  ext w
  have hc := Finsupp.ext_iff.mp
    ((permCoxeterSystem μ.card).basisTw_repr_eq_coeff_groupAlgebraEquiv inv_one.symm
      (colSuperstandardAntisymmetrizer (R := R) (1 : Rˣ) μ)) w
  rw [← hc, basisTw_repr_colSuperstandardAntisymmetrizer, columnAntisymmetrizer_coeff]
  split_ifs
  · rw [sign_eq_neg_one_pow_card_inversion, Finset.inversions_univ,
      ← permCoxeterSystem_length_eq_card_inversion]
    simp
  · rfl

/-! ### Hecke Young permutation modules and Dipper–James–Mathas generator action -/

/-- The **Hecke Young permutation module** `M^μ` over `R` at parameter `q`: the principal left
ideal of `TypeAHeckeAlgebra R q μ.card` generated by `youngSymmetrizer q (shapePartition μ)`. -/
noncomputable def youngPermutationModule (q : Rˣ) (μ : YoungDiagram) :
    Ideal (TypeAHeckeAlgebra R q μ.card) :=
  permutationModule (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ))

theorem youngPermutationModule_def (q : Rˣ) (μ : YoungDiagram) :
    youngPermutationModule (R := R) q μ =
      permutationModule (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ)) :=
  (rfl)

/-- Elements of `youngPermutationModule q μ` are left multiples of
`youngSymmetrizer q (shapePartition μ)`. -/
theorem mem_youngPermutationModule_iff (q : Rˣ) (μ : YoungDiagram)
    (x : TypeAHeckeAlgebra R q μ.card) :
    x ∈ youngPermutationModule q μ ↔
      ∃ y, y * youngSymmetrizer q (shapePartition μ) = x :=
  mem_permutationModule_iff (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ)) x

/-- The **row-standard tableau basis** of the Hecke Young permutation module `M^μ`, sending a
row-standard tableau `S` to `T_{d(S)} x_μ`. -/
noncomputable def youngPermutationBasis (q : Rˣ) (μ : YoungDiagram) :
    Module.Basis (RowStandardYoungTableau μ) R (youngPermutationModule (R := R) q μ) :=
  (permutationModuleBasis (q := q) (permCoxeterSystem μ.card)
    (youngGenSet (shapePartition μ))).reindex
      (RowStandardYoungTableau.equivMinimalCosetRep μ).symm

private theorem youngPermutationBasis_coe_eq (q : Rˣ) (μ : YoungDiagram)
    (S : RowStandardYoungTableau μ) :
    (youngPermutationBasis (R := R) q μ S : TypeAHeckeAlgebra R q μ.card) =
      (permutationModuleBasis (q := q) (permCoxeterSystem μ.card)
        (youngGenSet (shapePartition μ))
        (RowStandardYoungTableau.equivMinimalCosetRep μ S) : TypeAHeckeAlgebra R q μ.card) := by
  -- Unfold `youngPermutationBasis` inside the subtype coercion so `Basis.reindex_apply` applies.
  change (((permutationModuleBasis (q := q) (permCoxeterSystem μ.card)
      (youngGenSet (shapePartition μ))).reindex
      (RowStandardYoungTableau.equivMinimalCosetRep μ).symm) S :
      TypeAHeckeAlgebra R q μ.card) = _
  rw [Module.Basis.reindex_apply, Equiv.symm_symm]

@[simp]
theorem coe_youngPermutationBasis (q : Rˣ) (μ : YoungDiagram) (S : RowStandardYoungTableau μ) :
    (youngPermutationBasis (R := R) q μ S : TypeAHeckeAlgebra R q μ.card) =
      Tw q (permCoxeterSystem μ.card) (rowYoungConjugator S.toTableau) *
        youngSymmetrizer q (shapePartition μ) := by
  rw [youngPermutationBasis_coe_eq, coe_permutationModuleBasis, S.coe_equivMinimalCosetRep,
    youngSymmetrizer_def]

/-- **Dipper–James–Mathas generator action (same-row case).** When `strand i` and `strandSucc i`
lie in the same row of `S`, `T q i` scales the basis vector of `S` by `q`. -/
theorem T_smul_youngPermutationBasis_of_rowIndex_eq (q : Rˣ) {μ : YoungDiagram}
    (S : RowStandardYoungTableau μ) {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strand i) = rowIndex S.toTableau (strandSucc i)) :
    T q i • youngPermutationBasis (R := R) q μ S = (q : R) • youngPermutationBasis q μ S := by
  have hmin : ¬ (permCoxeterSystem μ.card).IsMinimalCosetRep (youngGenSet (shapePartition μ))
      ((permCoxeterSystem μ.card).simple i *
        (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card))) := by
    rw [S.coe_equivMinimalCosetRep]
    exact S.not_isMinimalCosetRep_simple_mul_of_rowIndex_eq h
  apply Subtype.ext
  have key := congrArg Subtype.val (T_smul_permutationModuleBasis_of_not_minimal (R := R) (q := q)
    (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ))
    (RowStandardYoungTableau.equivMinimalCosetRep μ S) i hmin)
  simpa only [SetLike.val_smul, SetLike.val_smul_of_tower, youngPermutationBasis_coe_eq] using key

/-- **Dipper–James–Mathas generator action (ascent case).** When `strand i` lies in a strictly
earlier row of `S` than `strandSucc i`, `T q i` carries the basis vector of `S` to that of
`S.swap i h.ne`. -/
theorem T_smul_youngPermutationBasis_of_rowIndex_lt (q : Rˣ) {μ : YoungDiagram}
    (S : RowStandardYoungTableau μ) {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strand i) < rowIndex S.toTableau (strandSucc i)) :
    T q i • youngPermutationBasis (R := R) q μ S =
      youngPermutationBasis q μ (S.swap i h.ne) := by
  have hnd : ¬ (permCoxeterSystem μ.card).IsLeftDescent
      (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)) i := by
    rw [S.coe_equivMinimalCosetRep, S.isLeftDescent_rowYoungConjugator_iff]
    exact not_lt_of_gt h
  have hconj : (permCoxeterSystem μ.card).simple i *
      (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)) =
      rowYoungConjugator (S.swap i h.ne).toTableau := by
    rw [S.coe_equivMinimalCosetRep, S.swap_toTableau, rowYoungConjugator_relabel,
      permCoxeterSystem_simple]
  have hmin : (permCoxeterSystem μ.card).IsMinimalCosetRep (youngGenSet (shapePartition μ))
      ((permCoxeterSystem μ.card).simple i *
        (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card))) := by
    rw [hconj]
    exact (S.swap i h.ne).isMinimalCosetRep_rowYoungConjugator
  apply Subtype.ext
  have key := congrArg Subtype.val (T_smul_permutationModuleBasis_of_ascent (R := R) (q := q)
    (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ))
    (RowStandardYoungTableau.equivMinimalCosetRep μ S) i hnd hmin)
  have hsub :
      (⟨(permCoxeterSystem μ.card).simple i *
          (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)), hmin⟩ :
        {w // (permCoxeterSystem μ.card).IsMinimalCosetRep (youngGenSet (shapePartition μ)) w}) =
        RowStandardYoungTableau.equivMinimalCosetRep μ (S.swap i h.ne) :=
    Subtype.ext (hconj.trans (S.swap i h.ne).coe_equivMinimalCosetRep.symm)
  rw [hsub] at key
  simpa only [SetLike.val_smul, youngPermutationBasis_coe_eq] using key

/-- **Dipper–James–Mathas generator action (descent case).** When `strandSucc i` lies in a
strictly earlier row of `S` than `strand i`, `T q i` sends the basis vector of `S` to
`(q - q⁻¹)` times itself plus the basis vector of `S.swap i h.ne'`. -/
theorem T_smul_youngPermutationBasis_of_rowIndex_gt (q : Rˣ) {μ : YoungDiagram}
    (S : RowStandardYoungTableau μ) {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strandSucc i) < rowIndex S.toTableau (strand i)) :
    T q i • youngPermutationBasis (R := R) q μ S =
      ((q : R) - ↑q⁻¹) • youngPermutationBasis q μ S +
        youngPermutationBasis q μ (S.swap i h.ne') := by
  have hd : (permCoxeterSystem μ.card).IsLeftDescent
      (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)) i := by
    rw [S.coe_equivMinimalCosetRep, S.isLeftDescent_rowYoungConjugator_iff]
    exact h
  have hconj : (permCoxeterSystem μ.card).simple i *
      (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)) =
      rowYoungConjugator (S.swap i h.ne').toTableau := by
    rw [S.coe_equivMinimalCosetRep, S.swap_toTableau, rowYoungConjugator_relabel,
      permCoxeterSystem_simple]
  apply Subtype.ext
  have key := congrArg Subtype.val (T_smul_permutationModuleBasis_of_descent (R := R) (q := q)
    (permCoxeterSystem μ.card) (youngGenSet (shapePartition μ))
    (RowStandardYoungTableau.equivMinimalCosetRep μ S) i hd)
  have hsub :
      (⟨(permCoxeterSystem μ.card).simple i *
          (RowStandardYoungTableau.equivMinimalCosetRep μ S : Equiv.Perm (Fin μ.card)),
          by rw [hconj]; exact (S.swap i h.ne').isMinimalCosetRep_rowYoungConjugator⟩ :
        {w // (permCoxeterSystem μ.card).IsMinimalCosetRep (youngGenSet (shapePartition μ)) w}) =
        RowStandardYoungTableau.equivMinimalCosetRep μ (S.swap i h.ne') :=
    Subtype.ext (hconj.trans (S.swap i h.ne').coe_equivMinimalCosetRep.symm)
  rw [hsub] at key
  simpa only [SetLike.val_smul, SetLike.val_smul_of_tower, Submodule.coe_add,
    youngPermutationBasis_coe_eq] using key

/-- **Rank of the Hecke Young permutation module.** Over any nontrivial commutative ring, `M^μ` is
free of rank `|μ|! / ∏ i, μᵢ!`. -/
@[simp]
theorem finrank_youngPermutationModule [Nontrivial R] (q : Rˣ) (μ : YoungDiagram) :
    Module.finrank R (youngPermutationModule (R := R) q μ) =
      μ.card.factorial / (μ.rowLens.map Nat.factorial).prod := by
  rw [Module.finrank_eq_card_basis (youngPermutationBasis q μ), RowStandardYoungTableau.card]

/-! ### Specialization at `q = 1` to the symmetric-group Young permutation module -/

/-- **Specialization of the Hecke Young permutation module at `q = 1`.** It identifies
`youngPermutationModule (1 : Rˣ) μ` with `(TauCeti.permutationModule (shapePartition μ)).V` by
sending the basis vector of each row-standard tableau `S` to its tabloid `{S}`. -/
noncomputable def youngPermutationModuleOneEquiv (μ : YoungDiagram) :
    youngPermutationModule (R := R) (1 : Rˣ) μ ≃ₗ[R]
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
  (youngPermutationBasis (R := R) (1 : Rˣ) μ).equiv
    (_root_.TauCeti.permutationModuleBasis (R := R) (shapePartition μ))
    (RowStandardYoungTableau.equivTabloid μ)

@[simp]
theorem youngPermutationModuleOneEquiv_basis (μ : YoungDiagram) (S : RowStandardYoungTableau μ) :
    youngPermutationModuleOneEquiv (R := R) μ (youngPermutationBasis (1 : Rˣ) μ S) =
      MonoidAlgebra.single (tabloid S.toTableau) 1 := by
  simp [youngPermutationModuleOneEquiv]

/-- At `q = 1`, `youngPermutationModuleOneEquiv` intertwines `T 1 i` with the action of
`transposition i`. -/
theorem youngPermutationModuleOneEquiv_T_smul (μ : YoungDiagram) (i : Fin (μ.card - 1))
    (m : youngPermutationModule (R := R) (1 : Rˣ) μ) :
    youngPermutationModuleOneEquiv (R := R) μ (T (1 : Rˣ) i • m) =
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).ρ (transposition i)
        (youngPermutationModuleOneEquiv μ m) := by
  let E := youngPermutationModuleOneEquiv (R := R) μ
  let ρ := (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).ρ
  let lsmulT : youngPermutationModule (R := R) (1 : Rˣ) μ →ₗ[R]
      youngPermutationModule (R := R) (1 : Rˣ) μ :=
    { toFun x := T (1 : Rˣ) i • x
      map_add' x y := smul_add _ x y
      map_smul' r x := Subtype.ext (mul_smul_comm r (T (1 : Rˣ) i) x.1) }
  have key : E.toLinearMap ∘ₗ lsmulT = ρ (transposition i) ∘ₗ E.toLinearMap := by
    refine (youngPermutationBasis (R := R) (1 : Rˣ) μ).ext fun S ↦ ?_
    dsimp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, E, lsmulT,
      LinearMap.coe_mk, AddHom.coe_mk]
    rw [youngPermutationModuleOneEquiv_basis, Representation.ofMulAction_single]
    rcases lt_trichotomy (rowIndex S.toTableau (strand i))
        (rowIndex S.toTableau (strandSucc i)) with h | h | h
    · rw [T_smul_youngPermutationBasis_of_rowIndex_lt (1 : Rˣ) S h,
        youngPermutationModuleOneEquiv_basis, S.swap_toTableau, tabloid_relabel]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_eq (1 : Rˣ) S h, Units.val_one, one_smul,
        youngPermutationModuleOneEquiv_basis]
      have hfix : transposition i • tabloid S.toTableau = tabloid S.toTableau := by
        rw [smul_tabloid_eq_self_iff, transposition_eq_swap]
        exact swap_mem_rowSubgroup h
      rw [hfix]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_gt (1 : Rˣ) S h]
      simp only [inv_one, Units.val_one, sub_self, zero_smul, zero_add]
      rw [youngPermutationModuleOneEquiv_basis, S.swap_toTableau, tabloid_relabel]
  exact LinearMap.congr_fun key m

/-- At `q = 1`, `youngPermutationModuleOneEquiv` intertwines `Tw 1 (permCoxeterSystem μ.card) w`
with the action of `w : Equiv.Perm (Fin μ.card)`. -/
theorem youngPermutationModuleOneEquiv_Tw_smul (μ : YoungDiagram) (w : Equiv.Perm (Fin μ.card))
    (m : youngPermutationModule (R := R) (1 : Rˣ) μ) :
    youngPermutationModuleOneEquiv (R := R) μ
        (Tw (1 : Rˣ) (permCoxeterSystem μ.card) w • m) =
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).ρ w
        (youngPermutationModuleOneEquiv μ m) := by
  obtain ⟨ω, hω, rfl⟩ := (permCoxeterSystem μ.card).exists_isReduced w
  rw [Tw_wordProd (permCoxeterSystem μ.card) hω]
  clear hω
  induction ω generalizing m with
  | nil => simp
  | cons i ω ih =>
    simp only [List.map_cons, List.prod_cons, mul_smul, CoxeterSystem.wordProd_cons,
      permCoxeterSystem_simple, map_mul, mul_apply_eq_comp]
    rw [youngPermutationModuleOneEquiv_T_smul, ih]

/-- **`TypeAHeckeAlgebra`-equivariance of `youngPermutationModuleOneEquiv` at `q = 1`.** Left
multiplication by `x : TypeAHeckeAlgebra R 1 μ.card` corresponds under `groupAlgebraEquiv` to the
symmetric-group action on `TauCeti.permutationModule (shapePartition μ)`. -/
theorem youngPermutationModuleOneEquiv_smul (μ : YoungDiagram)
    (x : TypeAHeckeAlgebra R (1 : Rˣ) μ.card)
    (m : youngPermutationModule (R := R) (1 : Rˣ) μ) :
    youngPermutationModuleOneEquiv (R := R) μ (x • m) =
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).ρ.asAlgebraHom
        (groupAlgebraEquiv (permCoxeterSystem μ.card) inv_one.symm x)
        (youngPermutationModuleOneEquiv μ m) := by
  let E := youngPermutationModuleOneEquiv (R := R) μ
  let ρ := (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).ρ
  let φ := groupAlgebraEquiv (R := R) (permCoxeterSystem μ.card) inv_one.symm
  let lhsMap : TypeAHeckeAlgebra R (1 : Rˣ) μ.card →ₗ[R]
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
    { toFun a := E (a • m)
      map_add' a b := by rw [add_smul, map_add]
      map_smul' r a := by rw [smul_assoc, map_smul, RingHom.id_apply] }
  let rhsMap : TypeAHeckeAlgebra R (1 : Rˣ) μ.card →ₗ[R]
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
    { toFun a := ρ.asAlgebraHom (φ a) (E m)
      map_add' a b := by rw [map_add, map_add, LinearMap.add_apply]
      map_smul' r a := by
        rw [map_smul, map_smul, LinearMap.smul_apply, RingHom.id_apply] }
  have key : lhsMap = rhsMap := by
    refine (basisTw (1 : Rˣ) (permCoxeterSystem μ.card)).ext fun w ↦ ?_
    dsimp only [lhsMap, rhsMap, LinearMap.coe_mk, AddHom.coe_mk, E, ρ, φ]
    rw [coe_basisTw, groupAlgebraEquiv_Tw, Representation.asAlgebraHom_single_one]
    exact youngPermutationModuleOneEquiv_Tw_smul μ w m
  exact LinearMap.congr_fun key x

end TauCeti.TypeAHeckeAlgebra
