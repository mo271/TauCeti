module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Parabolic.Young
import Mathlib.LinearAlgebra.Dimension.Finite

/-!
# Dipper–James Hecke Specht modules and standard Hecke polytabloids

For a Young diagram `μ`, a commutative ring `R`, and a unit parameter `q : Rˣ`, this file
constructs the **Dipper–James Specht module** of `TypeAHeckeAlgebra R q μ.card` integrally (with no
denominators inverted, so the definition applies uniformly at generic parameters and at roots of
unity) and establishes the dominance unitriangularity and linear independence of its standard
tableau vectors, together with its `q = 1` specialization to `TauCeti.spechtSubrepresentation`:

* **Coordinate formulas for the Hecke Young permutation module.**
  `youngPermutationBasis_repr_T_smul_of_rowIndex_eq`,
  `youngPermutationBasis_repr_T_smul_of_rowIndex_lt`, and
  `youngPermutationBasis_repr_T_smul_of_rowIndex_gt` compute the coordinates of `T q i • m` in
  `youngPermutationBasis q μ`.
* **The Dipper–James Specht generator and Specht module.**
  `TauCeti.TypeAHeckeAlgebra.spechtGen` is
  `z_μ = y_{t^μ} * T_{d(t^μ)} * x_μ`, where `t^μ = colSuperstandard μ`, `x_μ` is the row
  `q`-symmetrizer, and `y_{t^μ}` is the column-superstandard `q`-antisymmetrizer. Inside
  `youngPermutationModule q μ`, `spechtGenVec q μ` expands over `v ∈ colSubgroup t^μ` as
  `∑ v, (-q⁻¹)^{ℓ(v)} • b_{v · t^μ}` (`spechtGenVec_eq_sum`), with leading coefficient `1` at `t^μ`
  and all other terms strictly dominated by `t^μ`. The **Hecke Specht module**
  `TauCeti.TypeAHeckeAlgebra.spechtModule` is the principal left ideal generated by `spechtGen q μ`;
  it is finitely generated over every commutative ring.
* **Standard Hecke polytabloids, dominance unitriangularity, and linear independence.**
  For `U : StandardYoungTableau μ`, `TauCeti.TypeAHeckeAlgebra.heckePolytabloid` is
  `T_{relabelPerm t^μ U} * z_μ`. In `youngPermutationBasis q μ`, `heckePolytabloidVec q U` has
  diagonal coordinate `1` at `U` (`youngPermutationBasis_repr_heckePolytabloidVec_self`) and
  vanishes at every row-standard tableau `S` whose tabloid is not dominated by `{U}`
  (`tabloidDominates_of_youngPermutationBasis_repr_heckePolytabloidVec_ne_zero`). Consequently
  `heckePolytabloid q` is `R`-linearly independent over **every** commutative ring `R` and unit
  `q : Rˣ` (`linearIndependent_heckePolytabloid`), giving
  `standardCount μ ≤ Module.finrank R (spechtModule q μ)` over every nontrivial commutative ring.
* **`q = 1` specialization.**
  At `q = 1`, `TauCeti.TypeAHeckeAlgebra.spechtModuleOneEquiv` identifies `spechtModule 1 μ`
  `R`-linearly and Hecke-equivariantly with `(TauCeti.spechtSubrepresentation μ).toSubmodule` over
  every commutative ring `R`, sending `heckePolytabloid 1 U` to `polytabloid U.toTableau`. Over
  `ℚ`, transporting `TauCeti.standardPolytabloidBasis` yields the standard basis
  `TauCeti.TypeAHeckeAlgebra.heckePolytabloidOneBasis` and
  `Module.finrank ℚ (spechtModule (1 : ℚˣ) μ) = standardCount μ`.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52, Sections 4–5.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Section 3.2.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open Finset YoungTableau TauCeti.BraidGroup

variable {R : Type*} [CommRing R] {q : Rˣ}

/-! ### Coordinates of the generator action on the Hecke Young permutation module -/

section Coordinates

private noncomputable def lsmulT (q : Rˣ) (μ : YoungDiagram) (i : Fin (μ.card - 1)) :
    Module.End R (youngPermutationModule (R := R) q μ) where
  toFun m := T q i • m
  map_add' x y := smul_add _ x y
  map_smul' r x := Subtype.ext (mul_smul_comm r (T q i) x.1)

/-- Coordinate of `T q i • m` at `S` when `strand i` and `strandSucc i` lie in the same row of
`S`. -/
theorem youngPermutationBasis_repr_T_smul_of_rowIndex_eq (q : Rˣ) {μ : YoungDiagram}
    (m : youngPermutationModule (R := R) q μ) (S : RowStandardYoungTableau μ)
    {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strand i) = rowIndex S.toTableau (strandSucc i)) :
    (youngPermutationBasis q μ).repr (T q i • m) S =
      (q : R) * (youngPermutationBasis q μ).repr m S := by
  classical
  let b := youngPermutationBasis (R := R) q μ
  have key : (b.coord S).comp (lsmulT q μ i) = (q : R) • b.coord S := by
    refine b.ext fun S' ↦ ?_
    simp only [LinearMap.comp_apply, LinearMap.smul_apply, lsmulT, LinearMap.coe_mk, AddHom.coe_mk,
      Module.Basis.coord_apply, Module.Basis.repr_self_apply, smul_eq_mul, b]
    rcases lt_trichotomy (rowIndex S'.toTableau (strand i))
        (rowIndex S'.toTableau (strandSucc i)) with h' | h' | h'
    · rw [T_smul_youngPermutationBasis_of_rowIndex_lt q S' h', Module.Basis.repr_self_apply]
      have hne1 : S'.swap i h'.ne ≠ S := RowStandardYoungTableau.swap_ne_of_rowIndex_eq h'.ne h
      have hne2 : S' ≠ S := fun heq ↦ h'.ne (heq ▸ h)
      simp [hne1, hne2]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_eq q S' h', map_smul, Finsupp.smul_apply,
        Module.Basis.repr_self_apply, smul_eq_mul]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_gt q S' h', map_add, map_smul]
      simp only [Finsupp.add_apply, Finsupp.smul_apply, Module.Basis.repr_self_apply, smul_eq_mul]
      have hne1 : S'.swap i h'.ne' ≠ S := RowStandardYoungTableau.swap_ne_of_rowIndex_eq h'.ne' h
      have hne2 : S' ≠ S := fun heq ↦ h'.ne' (heq ▸ h)
      simp [hne1, hne2]
  simpa [b, lsmulT] using LinearMap.congr_fun key m

/-- Coordinate of `T q i • m` at `S` when `strand i` lies in an earlier row of `S` than
`strandSucc i`. -/
theorem youngPermutationBasis_repr_T_smul_of_rowIndex_lt (q : Rˣ) {μ : YoungDiagram}
    (m : youngPermutationModule (R := R) q μ) (S : RowStandardYoungTableau μ)
    {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strand i) < rowIndex S.toTableau (strandSucc i)) :
    (youngPermutationBasis q μ).repr (T q i • m) S =
      (youngPermutationBasis q μ).repr m (S.swap i h.ne) := by
  classical
  let b := youngPermutationBasis (R := R) q μ
  have key : (b.coord S).comp (lsmulT q μ i) = b.coord (S.swap i h.ne) := by
    refine b.ext fun S' ↦ ?_
    simp only [LinearMap.comp_apply, lsmulT, LinearMap.coe_mk, AddHom.coe_mk,
      Module.Basis.coord_apply, Module.Basis.repr_self_apply, b]
    rcases lt_trichotomy (rowIndex S'.toTableau (strand i))
        (rowIndex S'.toTableau (strandSucc i)) with h' | h' | h'
    · rw [T_smul_youngPermutationBasis_of_rowIndex_lt q S' h', Module.Basis.repr_self_apply]
      simp [RowStandardYoungTableau.swap_eq_iff h.ne h'.ne]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_eq q S' h', map_smul, Finsupp.smul_apply,
        Module.Basis.repr_self_apply, smul_eq_mul]
      have hne1 : S' ≠ S := fun heq ↦ h.ne (heq ▸ h')
      have hne2 : S' ≠ S.swap i h.ne :=
        fun heq ↦ RowStandardYoungTableau.swap_ne_of_rowIndex_eq h.ne h' heq.symm
      simp [hne1, hne2]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_gt q S' h', map_add, map_smul]
      simp only [Finsupp.add_apply, Finsupp.smul_apply, Module.Basis.repr_self_apply, smul_eq_mul]
      have hne : S' ≠ S := fun heq ↦ lt_asymm h (heq ▸ h')
      simp [hne, RowStandardYoungTableau.swap_eq_iff h.ne h'.ne']
  simpa [b, lsmulT] using LinearMap.congr_fun key m

/-- Coordinate of `T q i • m` at `S` when `strandSucc i` lies in an earlier row of `S` than
`strand i`. -/
theorem youngPermutationBasis_repr_T_smul_of_rowIndex_gt (q : Rˣ) {μ : YoungDiagram}
    (m : youngPermutationModule (R := R) q μ) (S : RowStandardYoungTableau μ)
    {i : Fin (μ.card - 1)}
    (h : rowIndex S.toTableau (strandSucc i) < rowIndex S.toTableau (strand i)) :
    (youngPermutationBasis q μ).repr (T q i • m) S =
      ((q : R) - ↑q⁻¹) * (youngPermutationBasis q μ).repr m S +
        (youngPermutationBasis q μ).repr m (S.swap i h.ne') := by
  classical
  let b := youngPermutationBasis (R := R) q μ
  have key : (b.coord S).comp (lsmulT q μ i) =
      ((q : R) - ↑q⁻¹) • b.coord S + b.coord (S.swap i h.ne') := by
    refine b.ext fun S' ↦ ?_
    simp only [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.smul_apply, lsmulT,
      LinearMap.coe_mk, AddHom.coe_mk, Module.Basis.coord_apply, Module.Basis.repr_self_apply,
      smul_eq_mul, b]
    rcases lt_trichotomy (rowIndex S'.toTableau (strand i))
        (rowIndex S'.toTableau (strandSucc i)) with h' | h' | h'
    · rw [T_smul_youngPermutationBasis_of_rowIndex_lt q S' h', Module.Basis.repr_self_apply]
      have hne : S' ≠ S := fun heq ↦ lt_asymm h (heq ▸ h')
      simp [hne, RowStandardYoungTableau.swap_eq_iff h.ne' h'.ne]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_eq q S' h', map_smul, Finsupp.smul_apply,
        Module.Basis.repr_self_apply, smul_eq_mul]
      have hne1 : S' ≠ S := fun heq ↦ h.ne' (heq ▸ h')
      have hne2 : S' ≠ S.swap i h.ne' :=
        fun heq ↦ RowStandardYoungTableau.swap_ne_of_rowIndex_eq h.ne' h' heq.symm
      simp [hne1, hne2]
    · rw [T_smul_youngPermutationBasis_of_rowIndex_gt q S' h', map_add, map_smul]
      simp only [Finsupp.add_apply, Finsupp.smul_apply, Module.Basis.repr_self_apply, smul_eq_mul]
      simp [RowStandardYoungTableau.swap_eq_iff h.ne' h'.ne']
  simpa [b, lsmulT] using LinearMap.congr_fun key m

end Coordinates

/-! ### The Dipper–James Specht generator and its expansion in `youngPermutationModule` -/

/-- The **Dipper–James Specht generator**
`z_μ = y_{t^μ} * T_{d(t^μ)} * x_μ` in `TypeAHeckeAlgebra R q μ.card`, where
`t^μ = colSuperstandard μ`. -/
noncomputable def spechtGen (q : Rˣ) (μ : YoungDiagram) : TypeAHeckeAlgebra R q μ.card :=
  colSuperstandardAntisymmetrizer q μ *
    Tw q (permCoxeterSystem μ.card)
      (rowYoungConjugator (StandardYoungTableau.colSuperstandard μ).toTableau) *
    youngSymmetrizer q (shapePartition μ)

theorem spechtGen_def (q : Rˣ) (μ : YoungDiagram) :
    spechtGen (R := R) q μ =
      colSuperstandardAntisymmetrizer q μ *
        Tw q (permCoxeterSystem μ.card)
          (rowYoungConjugator (StandardYoungTableau.colSuperstandard μ).toTableau) *
        youngSymmetrizer q (shapePartition μ) :=
  (rfl)

/-- The Specht generator belongs to the Hecke Young permutation module
`youngPermutationModule q μ`. -/
theorem spechtGen_mem_youngPermutationModule (q : Rˣ) (μ : YoungDiagram) :
    spechtGen (R := R) q μ ∈ youngPermutationModule q μ :=
  (mem_youngPermutationModule_iff q μ _).mpr ⟨_, rfl⟩

/-- The Specht generator viewed as a vector inside `youngPermutationModule q μ`. -/
noncomputable def spechtGenVec (q : Rˣ) (μ : YoungDiagram) :
    youngPermutationModule (R := R) q μ :=
  ⟨spechtGen q μ, spechtGen_mem_youngPermutationModule q μ⟩

@[simp]
theorem coe_spechtGenVec (q : Rˣ) (μ : YoungDiagram) :
    (spechtGenVec (R := R) q μ : TypeAHeckeAlgebra R q μ.card) = spechtGen q μ :=
  (rfl)

/-- `spechtGenVec q μ` is obtained by acting with `colSuperstandardAntisymmetrizer q μ` on the basis
vector of `colSuperstandard μ`. -/
theorem spechtGenVec_eq_smul (q : Rˣ) (μ : YoungDiagram) :
    spechtGenVec (R := R) q μ =
      colSuperstandardAntisymmetrizer q μ •
        youngPermutationBasis q μ
          (StandardYoungTableau.colSuperstandard μ).toRowStandardYoungTableau := by
  apply Subtype.ext
  simp only [coe_spechtGenVec, spechtGen_def, SetLike.val_smul, smul_eq_mul,
    coe_youngPermutationBasis, StandardYoungTableau.toRowStandardYoungTableau_toTableau,
    mul_assoc]

/-- **Expansion of `spechtGenVec` in the row-standard tableau basis.** It is the signed `q⁻¹`-sum,
over `v ∈ colSubgroup (colSuperstandard μ)`, of the basis vectors
`RowStandardYoungTableau.colSuperstandardRelabel v`. -/
theorem spechtGenVec_eq_sum (q : Rˣ) (μ : YoungDiagram)
    [Fintype (colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau)] :
    spechtGenVec (R := R) q μ =
      ∑ v : colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau,
        (-(↑q⁻¹ : R)) ^ (permCoxeterSystem μ.card).length (v : Equiv.Perm (Fin μ.card)) •
          youngPermutationBasis q μ (RowStandardYoungTableau.colSuperstandardRelabel v) := by
  let _ : Fintype ((permCoxeterSystem μ.card).parabolic (colSuperstandardGenSet μ)) :=
    Fintype.ofFinite _
  let e : (permCoxeterSystem μ.card).parabolic (colSuperstandardGenSet μ) ≃
      colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau :=
    Equiv.subtypeEquivRight fun _ ↦ by rw [parabolic_colSuperstandardGenSet]
  apply Subtype.ext
  rw [coe_spechtGenVec, spechtGen_def, colSuperstandardAntisymmetrizer_def,
    parabolicEigenSum_eq_sum, Finset.sum_mul, Finset.sum_mul, Submodule.coe_sum]
  refine Fintype.sum_equiv e _ _ fun v ↦ ?_
  have hv : (v : Equiv.Perm (Fin μ.card)) ∈
      colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau := (e v).2
  have hmul :
      Tw q (permCoxeterSystem μ.card) (v : Equiv.Perm (Fin μ.card)) *
        Tw q (permCoxeterSystem μ.card)
          (rowYoungConjugator (StandardYoungTableau.colSuperstandard μ).toTableau) =
      Tw q (permCoxeterSystem μ.card)
        (rowYoungConjugator (RowStandardYoungTableau.colSuperstandardRelabel (e v)).toTableau) := by
    rw [Tw_mul_Tw (permCoxeterSystem μ.card) (length_mul_rowYoungConjugator_colSuperstandard hv),
      RowStandardYoungTableau.colSuperstandardRelabel_toTableau, rowYoungConjugator_relabel]
    rfl
  simp only [SetLike.val_smul_of_tower, coe_youngPermutationBasis, smul_mul_assoc, hmul]
  rfl

@[simp]
theorem youngPermutationBasis_repr_spechtGenVec_colSuperstandard (q : Rˣ) (μ : YoungDiagram) :
    (youngPermutationBasis q μ).repr (spechtGenVec (R := R) q μ)
        (StandardYoungTableau.colSuperstandard μ).toRowStandardYoungTableau = 1 := by
  classical
  let _ : Fintype (colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau) :=
    Fintype.ofFinite _
  rw [spechtGenVec_eq_sum, map_sum, Finsupp.finsetSum_apply]
  rw [Finset.sum_eq_single (1 : colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau)]
  · simp
  · intro v _ hv
    have hne : RowStandardYoungTableau.colSuperstandardRelabel v ≠
        (StandardYoungTableau.colSuperstandard μ).toRowStandardYoungTableau := by
      rw [← RowStandardYoungTableau.colSuperstandardRelabel_one]
      exact fun h ↦ hv (RowStandardYoungTableau.colSuperstandardRelabel_injective h)
    simp [hne]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- Every row-standard tableau occurring with nonzero coefficient in `spechtGenVec q μ` has tabloid
dominated by `{colSuperstandard μ}`. -/
theorem tabloidDominates_of_youngPermutationBasis_repr_spechtGenVec_ne_zero {q : Rˣ}
    {μ : YoungDiagram} {S : RowStandardYoungTableau μ}
    (h : (youngPermutationBasis q μ).repr (spechtGenVec (R := R) q μ) S ≠ 0) :
    TabloidDominates (StandardYoungTableau.colSuperstandard μ).toTableau S.toTableau := by
  classical
  let _ : Fintype (colSubgroup (StandardYoungTableau.colSuperstandard μ).toTableau) :=
    Fintype.ofFinite _
  rw [spechtGenVec_eq_sum, map_sum, Finsupp.finsetSum_apply] at h
  obtain ⟨v, _, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  simp only [map_smul, Finsupp.smul_apply, Module.Basis.repr_self_apply, smul_eq_mul] at hv
  have hS : RowStandardYoungTableau.colSuperstandardRelabel v = S := by
    by_contra hne
    simp [hne] at hv
  rw [← hS, RowStandardYoungTableau.colSuperstandardRelabel_toTableau]
  exact tabloidDominates_relabel_of_mem_colSubgroup (StandardYoungTableau.colSuperstandard μ) v.2

@[simp]
theorem spechtGen_ne_zero [Nontrivial R] (q : Rˣ) (μ : YoungDiagram) :
    spechtGen (R := R) q μ ≠ 0 := by
  intro h
  have hvec : spechtGenVec (R := R) q μ = 0 := Subtype.ext h
  have hrepr := youngPermutationBasis_repr_spechtGenVec_colSuperstandard (R := R) q μ
  rw [hvec, map_zero, Finsupp.zero_apply] at hrepr
  exact zero_ne_one hrepr

/-! ### The Dipper–James Hecke Specht module and standard Hecke polytabloids -/

/-- The **Dipper–James Hecke Specht module** `S^μ` over `R` at parameter `q`: the principal left
ideal of `TypeAHeckeAlgebra R q μ.card` generated by `spechtGen q μ`. -/
noncomputable def spechtModule (q : Rˣ) (μ : YoungDiagram) :
    Ideal (TypeAHeckeAlgebra R q μ.card) :=
  Ideal.span {spechtGen q μ}

theorem spechtModule_def (q : Rˣ) (μ : YoungDiagram) :
    spechtModule (R := R) q μ = Ideal.span {spechtGen q μ} :=
  (rfl)

/-- Elements of `spechtModule q μ` are left multiples of `spechtGen q μ`. -/
theorem mem_spechtModule_iff (q : Rˣ) (μ : YoungDiagram)
    (x : TypeAHeckeAlgebra R q μ.card) :
    x ∈ spechtModule q μ ↔ ∃ y, y * spechtGen q μ = x := by
  rw [spechtModule_def, Ideal.mem_span_singleton']

/-- `spechtModule q μ` is contained in `youngPermutationModule q μ`. -/
theorem spechtModule_le_youngPermutationModule (q : Rˣ) (μ : YoungDiagram) :
    spechtModule (R := R) q μ ≤ youngPermutationModule q μ :=
  Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (spechtGen_mem_youngPermutationModule q μ))

@[simp]
theorem spechtModule_ne_bot [Nontrivial R] (q : Rˣ) (μ : YoungDiagram) :
    spechtModule (R := R) q μ ≠ ⊥ := by
  intro h
  have hmem : spechtGen (R := R) q μ ∈ (⊥ : Ideal (TypeAHeckeAlgebra R q μ.card)) :=
    h ▸ Ideal.subset_span (Set.mem_singleton _)
  exact spechtGen_ne_zero q μ (Submodule.mem_bot _ |>.mp hmem)

/-- As an `R`-submodule, `spechtModule q μ` is spanned by the elements `T_w * spechtGen q μ` for
`w : Equiv.Perm (Fin μ.card)`. -/
theorem spechtModule_eq_span_Tw_mul_spechtGen (q : Rˣ) (μ : YoungDiagram) :
    (spechtModule (R := R) q μ).restrictScalars R =
      Submodule.span R
        (Set.range fun w : Equiv.Perm (Fin μ.card) ↦
          Tw q (permCoxeterSystem μ.card) w * spechtGen q μ) := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · intro x hx
    obtain ⟨y, rfl⟩ := (mem_spechtModule_iff q μ x).mp hx
    clear hx
    have hy : y ∈ Submodule.span R (Set.range (Tw q (permCoxeterSystem μ.card))) := by
      rw [← coe_basisTw, Module.Basis.span_eq]
      trivial
    induction hy using Submodule.span_induction with
    | mem _ hw =>
      obtain ⟨w, rfl⟩ := hw
      exact Submodule.subset_span ⟨w, rfl⟩
    | zero => simp
    | add _ _ _ _ ha hb => simpa only [add_mul] using add_mem ha hb
    | smul r _ _ ha => simpa only [smul_mul_assoc] using Submodule.smul_mem _ r ha
  · rintro _ ⟨w, rfl⟩
    exact (mem_spechtModule_iff q μ _).mpr ⟨Tw q (permCoxeterSystem μ.card) w, rfl⟩

instance (q : Rˣ) (μ : YoungDiagram) : Module.Finite R (spechtModule (R := R) q μ) := by
  -- Identify the `R`-module structure on the ideal with `restrictScalars R`.
  change Module.Finite R ((spechtModule (R := R) q μ).restrictScalars R)
  refine Module.Finite.of_fg ?_
  rw [spechtModule_eq_span_Tw_mul_spechtGen]
  exact Submodule.fg_span (Set.finite_range _)

/-- The **standard Hecke polytabloid** attached to a standard Young tableau `U`:
`T_{relabelPerm t^μ U} * z_μ` inside `spechtModule q μ`. -/
noncomputable def heckePolytabloid (q : Rˣ) {μ : YoungDiagram}
    (U : StandardYoungTableau μ) : spechtModule (R := R) q μ :=
  ⟨Tw q (permCoxeterSystem μ.card)
      (relabelPerm (StandardYoungTableau.colSuperstandard μ).toTableau U.toTableau) *
    spechtGen q μ,
    (mem_spechtModule_iff q μ _).mpr ⟨_, rfl⟩⟩

@[simp]
theorem coe_heckePolytabloid (q : Rˣ) {μ : YoungDiagram} (U : StandardYoungTableau μ) :
    (heckePolytabloid (R := R) q U : TypeAHeckeAlgebra R q μ.card) =
      Tw q (permCoxeterSystem μ.card)
          (relabelPerm (StandardYoungTableau.colSuperstandard μ).toTableau U.toTableau) *
        spechtGen q μ :=
  (rfl)

/-- The standard Hecke polytabloid viewed inside `youngPermutationModule q μ`. -/
noncomputable def heckePolytabloidVec (q : Rˣ) {μ : YoungDiagram}
    (U : StandardYoungTableau μ) : youngPermutationModule (R := R) q μ :=
  Submodule.inclusion (spechtModule_le_youngPermutationModule (R := R) q μ)
    (heckePolytabloid q U)

@[simp]
theorem coe_heckePolytabloidVec (q : Rˣ) {μ : YoungDiagram} (U : StandardYoungTableau μ) :
    (heckePolytabloidVec (R := R) q U : TypeAHeckeAlgebra R q μ.card) =
      Tw q (permCoxeterSystem μ.card)
          (relabelPerm (StandardYoungTableau.colSuperstandard μ).toTableau U.toTableau) *
        spechtGen q μ :=
  (rfl)

/-- `heckePolytabloidVec q U` is the image of `spechtGenVec q μ` under
`Tw q (permCoxeterSystem μ.card) (relabelPerm t^μ U)`. -/
theorem heckePolytabloidVec_eq_Tw_smul (q : Rˣ) {μ : YoungDiagram}
    (U : StandardYoungTableau μ) :
    heckePolytabloidVec (R := R) q U =
      Tw q (permCoxeterSystem μ.card)
          (relabelPerm (StandardYoungTableau.colSuperstandard μ).toTableau U.toTableau) •
        spechtGenVec q μ :=
  (rfl)

@[simp]
theorem heckePolytabloidVec_colSuperstandard (q : Rˣ) (μ : YoungDiagram) :
    heckePolytabloidVec (R := R) q (StandardYoungTableau.colSuperstandard μ) =
      spechtGenVec q μ := by
  have hid : relabelPerm (StandardYoungTableau.colSuperstandard μ).toTableau
      (StandardYoungTableau.colSuperstandard μ).toTableau = 1 := by
    ext k
    simp
  rw [heckePolytabloidVec_eq_Tw_smul, hid, Tw_one, one_smul]

/-! ### Dominance unitriangularity and linear independence over every commutative ring -/

private theorem heckePolytabloidVec_unitriangular (q : Rˣ) {μ : YoungDiagram}
    (U : StandardYoungTableau μ) :
    (youngPermutationBasis q μ).repr (heckePolytabloidVec (R := R) q U)
        U.toRowStandardYoungTableau = 1 ∧
      ∀ S : RowStandardYoungTableau μ,
        (youngPermutationBasis q μ).repr (heckePolytabloidVec (R := R) q U) S ≠ 0 →
          TabloidDominates U.toTableau S.toTableau := by
  set t_c := StandardYoungTableau.colSuperstandard μ
  set cs := permCoxeterSystem μ.card
  generalize hd : cs.length (relabelPerm t_c.toTableau U.toTableau) = k
  induction k using Nat.strong_induction_on generalizing U with
  | ind k ih =>
    rcases eq_or_ne k 0 with rfl | hk
    · -- Base case `k = 0`: `U = colSuperstandard μ`, where `heckePolytabloidVec` is `spechtGenVec`.
      have hd1 : relabelPerm t_c.toTableau U.toTableau = 1 := cs.length_eq_zero_iff.mp hd
      have hU : U = t_c := by
        have htab : U.toTableau = t_c.toTableau := by
          rw [← relabel_relabelPerm t_c.toTableau U.toTableau, hd1, relabel_one]
        ext c
        rw [← StandardYoungTableau.toTableau_apply, ← StandardYoungTableau.toTableau_apply, htab]
      subst hU
      rw [heckePolytabloidVec_colSuperstandard]
      exact ⟨youngPermutationBasis_repr_spechtGenVec_colSuperstandard q μ,
        fun _ ↦ tabloidDominates_of_youngPermutationBasis_repr_spechtGenVec_ne_zero⟩
    · -- Inductive step: pick a left descent `i` of `relabelPerm t_c U` and set `U' = U.swap i`.
      have hd_ne : relabelPerm t_c.toTableau U.toTableau ≠ 1 := by
        intro h1
        rw [h1, cs.length_one] at hd
        exact hk hd.symm
      obtain ⟨i, hi⟩ := cs.exists_leftDescent_of_ne_one hd_ne
      obtain ⟨hcol, hrow⟩ :=
        U.colIndex_lt_and_rowIndex_lt_of_isLeftDescent_relabelPerm_colSuperstandard hi
      let U' : StandardYoungTableau μ := U.swap i hrow.ne hcol.ne'
      have hU'_rel : relabelPerm t_c.toTableau U'.toTableau =
          cs.simple i * relabelPerm t_c.toTableau U.toTableau := by
        ext x
        simp [U', cs, relabel_apply, Equiv.Perm.mul_apply, permCoxeterSystem_simple]
      have hlen_lt : cs.length (relabelPerm t_c.toTableau U'.toTableau) < k := by
        rw [hU'_rel, ← hd]
        exact hi
      have hnd : ¬ cs.IsLeftDescent (relabelPerm t_c.toTableau U'.toTableau) i := by
        rw [hU'_rel]
        exact cs.isLeftDescent_iff_not_isLeftDescent_mul.mp hi
      have hTw : Tw q cs (relabelPerm t_c.toTableau U.toTableau) =
          T q i * Tw q cs (relabelPerm t_c.toTableau U'.toTableau) := by
        rw [T_mul_Tw_of_not_isLeftDescent cs hnd, hU'_rel, cs.simple_mul_simple_cancel_left]
      have hstep : heckePolytabloidVec (R := R) q U = T q i • heckePolytabloidVec q U' := by
        rw [heckePolytabloidVec_eq_Tw_smul, hTw, mul_smul, ← heckePolytabloidVec_eq_Tw_smul]
      obtain ⟨hdiag', hdom'⟩ := ih _ hlen_lt U' rfl
      have hU_rel_U' : U.toTableau = relabel (transposition i) U'.toTableau := by
        dsimp only [U']
        rw [U.swap_toTableau, relabel_transposition_involutive]
      have hrow' : rowIndex U'.toTableau (strandSucc i) < rowIndex U'.toTableau (strand i) := by
        dsimp only [U']
        rw [U.swap_toTableau, rowIndex_relabel_transposition_strand,
          rowIndex_relabel_transposition_strandSucc]
        exact hrow
      have hrow_rs : rowIndex U.toRowStandardYoungTableau.toTableau (strand i) <
          rowIndex U.toRowStandardYoungTableau.toTableau (strandSucc i) := by
        simpa using hrow
      have hswap_U :
          U.toRowStandardYoungTableau.swap i hrow_rs.ne = U'.toRowStandardYoungTableau := by
        dsimp only [U']
        exact (U.swap_toRowStandardYoungTableau i hrow.ne hcol.ne').symm
      refine ⟨?_, ?_⟩
      · rw [hstep, youngPermutationBasis_repr_T_smul_of_rowIndex_lt q _
          U.toRowStandardYoungTableau hrow_rs, hswap_U]
        exact hdiag'
      · -- Split on the relative row order of `strand i` and `strandSucc i` in `S`.
        intro S hS
        rw [hstep] at hS
        rcases lt_trichotomy (rowIndex S.toTableau (strand i))
            (rowIndex S.toTableau (strandSucc i)) with hr | hr | hr
        · rw [youngPermutationBasis_repr_T_smul_of_rowIndex_lt q _ S hr] at hS
          have hdomS := (hdom' (S.swap i hr.ne) hS).relabel_transposition hrow'
          simpa [← hU_rel_U', relabel_transposition_involutive] using hdomS
        · rw [youngPermutationBasis_repr_T_smul_of_rowIndex_eq q _ S hr] at hS
          have hmS : (youngPermutationBasis q μ).repr (heckePolytabloidVec q U') S ≠ 0 :=
            right_ne_zero_of_mul hS
          have hdomS := (hdom' S hmS).relabel_transposition hrow'
          rw [← hU_rel_U'] at hdomS
          have htab : tabloid (relabel (transposition i) S.toTableau) = tabloid S.toTableau := by
            rw [tabloid_relabel, smul_tabloid_eq_self_iff, transposition_eq_swap]
            exact swap_mem_rowSubgroup hr
          exact (tabloidDominates_congr rfl htab).mp hdomS
        · rw [youngPermutationBasis_repr_T_smul_of_rowIndex_gt q _ S hr] at hS
          by_cases hmS : (youngPermutationBasis q μ).repr (heckePolytabloidVec q U') S = 0
          · rw [hmS, mul_zero, zero_add] at hS
            have hdomS := (hdom' (S.swap i hr.ne') hS).relabel_transposition hrow'
            simpa [← hU_rel_U', relabel_transposition_involutive] using hdomS
          · have hUU' : TabloidDominates U.toTableau U'.toTableau := by
              rw [hU_rel_U']
              exact tabloidDominates_relabel_transposition_self hrow'
            exact hUU'.trans (hdom' S hmS)

/-- **Diagonal coefficient of `heckePolytabloidVec`.** For every standard Young tableau `U`, the
coordinate of `heckePolytabloidVec q U` at `U.toRowStandardYoungTableau` is `1`. -/
@[simp]
theorem youngPermutationBasis_repr_heckePolytabloidVec_self (q : Rˣ) {μ : YoungDiagram}
    (U : StandardYoungTableau μ) :
    (youngPermutationBasis q μ).repr (heckePolytabloidVec (R := R) q U)
      U.toRowStandardYoungTableau = 1 :=
  (heckePolytabloidVec_unitriangular q U).1

/-- **Dominance triangularity of `heckePolytabloidVec`.** Every row-standard tableau `S` occurring
with nonzero coefficient in `heckePolytabloidVec q U` has tabloid dominated by `{U}`. -/
theorem tabloidDominates_of_youngPermutationBasis_repr_heckePolytabloidVec_ne_zero {q : Rˣ}
    {μ : YoungDiagram} {U : StandardYoungTableau μ} {S : RowStandardYoungTableau μ}
    (h : (youngPermutationBasis q μ).repr (heckePolytabloidVec (R := R) q U) S ≠ 0) :
    TabloidDominates U.toTableau S.toTableau :=
  (heckePolytabloidVec_unitriangular q U).2 S h

/-- **Linear independence of the standard Hecke polytabloids.** Over every commutative ring `R` and
every unit parameter `q : Rˣ` (including roots of unity), the vectors `heckePolytabloid q U` indexed
by `U : StandardYoungTableau μ` are `R`-linearly independent. -/
theorem linearIndependent_heckePolytabloid (q : Rˣ) (μ : YoungDiagram) :
    LinearIndependent R (heckePolytabloid (R := R) q (μ := μ)) := by
  classical
  refine LinearIndependent.of_comp
    ((Submodule.inclusion (spechtModule_le_youngPermutationModule (R := R) q μ)).restrictScalars
      R) ?_
  -- Composing `heckePolytabloid` with `Submodule.inclusion` gives `heckePolytabloidVec`.
  change LinearIndependent R (heckePolytabloidVec (R := R) q (μ := μ))
  rw [linearIndependent_iff']
  intro s g hsum U₁ hU₁
  by_contra hg
  obtain ⟨U₀, hU₀, hmax⟩ := Finset.exists_max_image (s.filter fun U ↦ g U ≠ 0)
    (fun U ↦ rowWeight U.toTableau) ⟨U₁, Finset.mem_filter.mpr ⟨hU₁, hg⟩⟩
  obtain ⟨hU₀s, hg₀⟩ := Finset.mem_filter.mp hU₀
  have hzero : ∀ U ∈ s, U ≠ U₀ →
      (youngPermutationBasis q μ).repr (g U • heckePolytabloidVec (R := R) q U)
        U₀.toRowStandardYoungTableau = 0 := by
    intro U hUs hUne
    rcases eq_or_ne (g U) 0 with h0 | h0
    · simp [h0]
    simp only [map_smul, Finsupp.smul_apply, smul_eq_mul]
    suffices hc : (youngPermutationBasis q μ).repr (heckePolytabloidVec (R := R) q U)
        U₀.toRowStandardYoungTableau = 0 by
      rw [hc, mul_zero]
    by_contra hne
    have hdom : TabloidDominates U.toTableau U₀.toTableau := by
      simpa using tabloidDominates_of_youngPermutationBasis_repr_heckePolytabloidVec_ne_zero hne
    have hw : rowWeight U.toTableau ≤ rowWeight U₀.toTableau :=
      hmax U (Finset.mem_filter.mpr ⟨hUs, h0⟩)
    exact hUne (StandardYoungTableau.rowIndex_injective μ
      (rowIndex_eq_of_tabloidDominates hdom hw).symm)
  have hcoeff :
      (youngPermutationBasis q μ).repr (∑ U ∈ s, g U • heckePolytabloidVec (R := R) q U)
        U₀.toRowStandardYoungTableau = 0 := by
    rw [hsum, map_zero, Finsupp.zero_apply]
  rw [map_sum, Finsupp.finsetSum_apply, Finset.sum_eq_single_of_mem U₀ hU₀s hzero,
    map_smul, Finsupp.smul_apply, youngPermutationBasis_repr_heckePolytabloidVec_self,
    smul_eq_mul, mul_one] at hcoeff
  exact hg₀ hcoeff

/-- Over any nontrivial commutative ring `R`, the `R`-rank of `spechtModule q μ` is bounded below
by the number `f^μ` of standard Young tableaux of shape `μ`. -/
theorem standardCount_le_finrank_spechtModule [Nontrivial R] (q : Rˣ) (μ : YoungDiagram) :
    standardCount μ ≤ Module.finrank R (spechtModule (R := R) q μ) := by
  rw [standardCount_def]
  exact (linearIndependent_heckePolytabloid (R := R) q μ).fintype_card_le_finrank

/-! ### Specialization at `q = 1` to `TauCeti.spechtSubrepresentation` -/

@[simp]
theorem youngPermutationModuleOneEquiv_spechtGenVec (μ : YoungDiagram) :
    youngPermutationModuleOneEquiv (R := R) μ (spechtGenVec (1 : Rˣ) μ) =
      polytabloid (R := R) (StandardYoungTableau.colSuperstandard μ).toTableau := by
  rw [spechtGenVec_eq_smul, youngPermutationModuleOneEquiv_smul,
    groupAlgebraEquiv_colSuperstandardAntisymmetrizer_one, youngPermutationModuleOneEquiv_basis,
    StandardYoungTableau.toRowStandardYoungTableau_toTableau, ← polytabloid_def]

@[simp]
theorem youngPermutationModuleOneEquiv_heckePolytabloidVec {μ : YoungDiagram}
    (U : StandardYoungTableau μ) :
    youngPermutationModuleOneEquiv (R := R) μ (heckePolytabloidVec (1 : Rˣ) U) =
      polytabloid (R := R) U.toTableau := by
  rw [heckePolytabloidVec_eq_Tw_smul, youngPermutationModuleOneEquiv_Tw_smul,
    youngPermutationModuleOneEquiv_spechtGenVec, ← polytabloid_relabel, relabel_relabelPerm]

private noncomputable def spechtModuleOneToPerm (μ : YoungDiagram) :
    spechtModule (R := R) (1 : Rˣ) μ →ₗ[R]
      (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
  (youngPermutationModuleOneEquiv (R := R) μ).toLinearMap ∘ₗ
    { toFun x := ⟨x.1, spechtModule_le_youngPermutationModule (1 : Rˣ) μ x.2⟩
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }

private theorem spechtModuleOneToPerm_injective (μ : YoungDiagram) :
    Function.Injective (spechtModuleOneToPerm (R := R) μ) := by
  intro x y h
  have hinj := (youngPermutationModuleOneEquiv (R := R) μ).injective h
  dsimp only [LinearMap.coe_mk, AddHom.coe_mk] at hinj
  exact Subtype.ext
    (congrArg (Subtype.val : youngPermutationModule (R := R) (1 : Rˣ) μ → _) hinj)

private theorem range_spechtModuleOneToPerm (μ : YoungDiagram) :
    LinearMap.range (spechtModuleOneToPerm (R := R) μ) =
      (_root_.TauCeti.spechtSubrepresentation (R := R) μ).toSubmodule := by
  let t_c := (StandardYoungTableau.colSuperstandard μ).toTableau
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    obtain ⟨y, hy⟩ := (mem_spechtModule_iff (1 : Rˣ) μ x.1).mp x.2
    have hx : (⟨x.1, spechtModule_le_youngPermutationModule (1 : Rˣ) μ x.2⟩ :
        youngPermutationModule (R := R) (1 : Rˣ) μ) = y • spechtGenVec (1 : Rˣ) μ :=
      Subtype.ext hy.symm
    dsimp only [spechtModuleOneToPerm, LinearMap.coe_comp, Function.comp_apply,
      LinearEquiv.coe_coe, LinearMap.coe_mk, AddHom.coe_mk]
    rw [hx, youngPermutationModuleOneEquiv_smul, youngPermutationModuleOneEquiv_spechtGenVec]
    set a := groupAlgebraEquiv (permCoxeterSystem μ.card) inv_one.symm y
    induction a using MonoidAlgebra.induction_linear with
    | zero => simp
    | add u v hu hv =>
      rw [map_add, LinearMap.add_apply]
      exact add_mem hu hv
    | single σ r =>
      have hsingle : MonoidAlgebra.single σ r = r • MonoidAlgebra.single σ (1 : R) := by
        simp [MonoidAlgebra.smul_single]
      rw [hsingle, map_smul, LinearMap.smul_apply, Representation.asAlgebraHom_single_one]
      exact Submodule.smul_mem _ r
        ((_root_.TauCeti.spechtSubrepresentation (R := R) μ).apply_mem_toSubmodule σ
          (polytabloid_mem_spechtSubrepresentation t_c))
  · rw [_root_.TauCeti.spechtSubrepresentation_eq_span_orbit t_c, Submodule.span_le]
    rintro _ ⟨σ, rfl⟩
    have hm : Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ * spechtGen (R := R) (1 : Rˣ) μ ∈
        spechtModule (1 : Rˣ) μ :=
      (mem_spechtModule_iff (1 : Rˣ) μ _).mpr ⟨_, rfl⟩
    refine ⟨⟨Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ * spechtGen (1 : Rˣ) μ, hm⟩, ?_⟩
    dsimp only [spechtModuleOneToPerm, LinearMap.coe_comp, Function.comp_apply,
      LinearEquiv.coe_coe, LinearMap.coe_mk, AddHom.coe_mk]
    have hsmul :
        (⟨Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ * spechtGen (1 : Rˣ) μ,
          spechtModule_le_youngPermutationModule (1 : Rˣ) μ hm⟩ :
          youngPermutationModule (R := R) (1 : Rˣ) μ) =
        Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • spechtGenVec (1 : Rˣ) μ :=
      rfl
    rw [hsmul, youngPermutationModuleOneEquiv_Tw_smul, youngPermutationModuleOneEquiv_spechtGenVec]

/-- **Specialization of the Hecke Specht module at `q = 1`.** Over every commutative ring `R`,
`youngPermutationModuleOneEquiv` restricts to an `R`-linear equivalence between
`spechtModule (1 : Rˣ) μ` and `(TauCeti.spechtSubrepresentation μ).toSubmodule`. -/
noncomputable def spechtModuleOneEquiv (μ : YoungDiagram) :
    spechtModule (R := R) (1 : Rˣ) μ ≃ₗ[R]
      (_root_.TauCeti.spechtSubrepresentation (R := R) μ).toSubmodule :=
  (LinearEquiv.ofInjective (spechtModuleOneToPerm (R := R) μ)
    (spechtModuleOneToPerm_injective μ)).trans
      (LinearEquiv.ofEq _ _ (range_spechtModuleOneToPerm μ))

@[simp]
theorem coe_spechtModuleOneEquiv (μ : YoungDiagram)
    (x : spechtModule (R := R) (1 : Rˣ) μ) :
    (spechtModuleOneEquiv (R := R) μ x :
        (_root_.TauCeti.permutationModule (R := R) (shapePartition μ)).V) =
      youngPermutationModuleOneEquiv μ
        ⟨x.1, spechtModule_le_youngPermutationModule (1 : Rˣ) μ x.2⟩ :=
  (rfl)

@[simp]
theorem spechtModuleOneEquiv_heckePolytabloid {μ : YoungDiagram} (U : StandardYoungTableau μ) :
    spechtModuleOneEquiv (R := R) μ (heckePolytabloid (1 : Rˣ) U) =
      ⟨polytabloid (R := R) U.toTableau, polytabloid_mem_spechtSubrepresentation U.toTableau⟩ := by
  apply Subtype.ext
  rw [coe_spechtModuleOneEquiv]
  exact youngPermutationModuleOneEquiv_heckePolytabloidVec U

/-- **`TypeAHeckeAlgebra`-equivariance of `spechtModuleOneEquiv` at `q = 1`.** Left multiplication
by `Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ` corresponds to the symmetric-group action of `σ` on
`TauCeti.spechtSubrepresentation μ`. -/
theorem spechtModuleOneEquiv_Tw_smul (μ : YoungDiagram) (σ : Equiv.Perm (Fin μ.card))
    (m : spechtModule (R := R) (1 : Rˣ) μ) :
    spechtModuleOneEquiv (R := R) μ (Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • m) =
      (_root_.TauCeti.spechtSubrepresentation (R := R) μ).toRepresentation σ
        (spechtModuleOneEquiv μ m) := by
  apply Subtype.ext
  rw [coe_spechtModuleOneEquiv]
  have hsmul :
      (⟨(Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • m).1,
        spechtModule_le_youngPermutationModule (1 : Rˣ) μ
          (Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • m).2⟩ :
        youngPermutationModule (R := R) (1 : Rˣ) μ) =
      Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ •
        ⟨m.1, spechtModule_le_youngPermutationModule (1 : Rˣ) μ m.2⟩ :=
    rfl
  rw [hsmul, youngPermutationModuleOneEquiv_Tw_smul]
  rfl

/-- **Standard basis of the Hecke Specht module over `ℚ` at `q = 1`.** Transporting
`TauCeti.standardPolytabloidBasis` across `spechtModuleOneEquiv` exhibits
`heckePolytabloid (1 : ℚˣ)` as a `ℚ`-basis of `spechtModule (1 : ℚˣ) μ`. -/
noncomputable def heckePolytabloidOneBasis (μ : YoungDiagram) :
    Module.Basis (StandardYoungTableau μ) ℚ (spechtModule (R := ℚ) (1 : ℚˣ) μ) :=
  (_root_.TauCeti.standardPolytabloidBasis μ).map (spechtModuleOneEquiv (R := ℚ) μ).symm

@[simp]
theorem heckePolytabloidOneBasis_apply {μ : YoungDiagram} (U : StandardYoungTableau μ) :
    heckePolytabloidOneBasis μ U = heckePolytabloid (R := ℚ) (1 : ℚˣ) U := by
  rw [heckePolytabloidOneBasis, Module.Basis.map_apply, LinearEquiv.symm_apply_eq,
    spechtModuleOneEquiv_heckePolytabloid]
  apply Subtype.ext
  exact _root_.TauCeti.coe_standardPolytabloidBasis μ U

/-- At `q = 1` over `ℚ`, the dimension of `spechtModule (1 : ℚˣ) μ` equals `standardCount μ`. -/
@[simp]
theorem finrank_spechtModule_rat_one (μ : YoungDiagram) :
    Module.finrank ℚ (spechtModule (R := ℚ) (1 : ℚˣ) μ) = standardCount μ := by
  rw [standardCount_def]
  exact Module.finrank_eq_card_basis (heckePolytabloidOneBasis μ)

end TauCeti.TypeAHeckeAlgebra
