/-!
# The Serre ideal and Kac's word representation on the auxiliary algebra

Let `A` be a square matrix of integers and `R` a realization of `A` over a field `K`
(`TauCeti.CartanRealization`). Write `𝔤 = TauCeti.KacMoody.PresentedLieAlgebra R`, and let
`TauCeti.KacMoody.positiveFreeLift` and `TauCeti.KacMoody.negativeFreeLift` be the canonical Lie
homomorphisms `FreeLieAlgebra K I →ₗ⁅K⁆ 𝔤` sending `i` to the raising and lowering generators `eᵢ`
and `fᵢ`. Both vanish on `TauCeti.KacMoody.serreIdeal K A`, the Lie ideal of `FreeLieAlgebra K I`
generated by the Serre relators `(ad xᵢ) ^ (-A i j).toNat ⁅xᵢ, xⱼ⁆`.

When `A` is a generalized Cartan matrix (`Matrix.IsGeneralizedCartan`), no further relations hold
among the three parts of `𝔤` over any field `K` (without characteristic, finiteness, or
symmetrizability assumptions):

1. Following Kac (Theorem 1.2), the auxiliary Lie algebra `AuxLieAlgebra R` — the quotient before
   imposing Serre's relations — acts on the word algebra `MonoidAlgebra K (FreeMonoid I)` for each
   functional `λ ∈ H*`, with `Fⱼ` acting by left multiplication, `Hₓ` acting diagonally on words,
   and `Eᵢ` acting inductively so that `⁅Eᵢ, Fⱼ⁆ = δᵢⱼ H_{hᵢ}`. Evaluating on the empty word and
   varying `λ` shows that `AuxLieAlgebra R = FreeLieAlgebra K I ⊕ H ⊕ FreeLieAlgebra K I`.
2. Using `A i i = 2`, `A i j ≤ 0` (`i ≠ j`), and `A i j = 0 ↔ A j i = 0`, each lowering generator
   `Fₖ` annihilates the positive Serre relators `(ad Eᵢ) ^ (-A i j).toNat ⁅Eᵢ, Eⱼ⁆` in
   `AuxLieAlgebra R`. By the Leibniz rule, `serreIdeal K A` maps to a Lie ideal of `AuxLieAlgebra R`
   inside the positive summand, and by the Chevalley involution its negative counterpart maps to a
   Lie ideal inside the negative summand.

Passing to the quotient yields the master triangular vanishing criterion
`TauCeti.KacMoody.negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff`: an ordered
sum `negativeFreeLift R uF + cartanElement R x + positiveFreeLift R uE` vanishes in
`PresentedLieAlgebra R` if and only if `uF ∈ serreIdeal K A`, `x = 0`, and `uE ∈ serreIdeal K A`.

## Main definitions

* `TauCeti.KacMoody.positiveFreeLift`, `TauCeti.KacMoody.negativeFreeLift`: the canonical Lie
  homomorphisms `FreeLieAlgebra K I →ₗ⁅K⁆ PresentedLieAlgebra R` sending `i` to `eᵢ` and `fᵢ`.
* `TauCeti.KacMoody.serreIdeal`: the Lie ideal of `FreeLieAlgebra R I` generated by the Serre
  relators `(ad xᵢ) ^ (-A i j).toNat ⁅xᵢ, xⱼ⁆`.

## Main results

* `TauCeti.KacMoody.negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff`: for a
  generalized Cartan matrix `A`, `negativeFreeLift R uF + cartanElement R x + positiveFreeLift R uE`
  equals `0` if and only if `uF ∈ serreIdeal K A`, `x = 0`, and `uE ∈ serreIdeal K A`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §1.2–1.3, Theorem 1.2, and §3.3.
-/

public section

open LieAlgebra

namespace TauCeti.KacMoody

section FreeLiftsAndSerreIdeal

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The canonical Lie homomorphism `FreeLieAlgebra K I →ₗ⁅K⁆ PresentedLieAlgebra R` sending `i` to
the raising generator `eᵢ`. -/
noncomputable def positiveFreeLift : FreeLieAlgebra K I →ₗ⁅K⁆ PresentedLieAlgebra R :=
  FreeLieAlgebra.lift K (positiveGenerator R)

/-- The canonical Lie homomorphism `FreeLieAlgebra K I →ₗ⁅K⁆ PresentedLieAlgebra R` sending `i` to
the lowering generator `fᵢ`. -/
noncomputable def negativeFreeLift : FreeLieAlgebra K I →ₗ⁅K⁆ PresentedLieAlgebra R :=
  FreeLieAlgebra.lift K (negativeGenerator R)

@[simp]
theorem positiveFreeLift_of (i : I) :
    positiveFreeLift R (FreeLieAlgebra.of K i) = positiveGenerator R i :=
  FreeLieAlgebra.lift_of_apply _ i

@[simp]
theorem negativeFreeLift_of (i : I) :
    negativeFreeLift R (FreeLieAlgebra.of K i) = negativeGenerator R i :=
  FreeLieAlgebra.lift_of_apply _ i

end FreeLiftsAndSerreIdeal

section SerreIdeal

/-- The Lie ideal of `FreeLieAlgebra R I` generated by the Serre relators
`(ad xᵢ) ^ (-A i j).toNat ⁅xᵢ, xⱼ⁆`. When `A` is a generalized Cartan matrix over a field, the
quotient by this ideal presents both `n⁺` and `n⁻`. -/
noncomputable def serreIdeal (R : Type*) [CommRing R] {I : Type*} (A : Matrix I I ℤ) :
    LieIdeal R (FreeLieAlgebra R I) :=
  LieSubmodule.lieSpan R (FreeLieAlgebra R I)
    { u | ∃ i j : I,
        u = (ad R _ (FreeLieAlgebra.of R i) ^ (-A i j).toNat)
          ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆ }

/-- Explicit `lieSpan` description of `TauCeti.KacMoody.serreIdeal`. -/
theorem serreIdeal_def (R : Type*) [CommRing R] {I : Type*} (A : Matrix I I ℤ) :
    serreIdeal R A = LieSubmodule.lieSpan R (FreeLieAlgebra R I)
      { u | ∃ i j : I,
          u = (ad R _ (FreeLieAlgebra.of R i) ^ (-A i j).toNat)
            ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆ } := (rfl)

/-- Every Serre relator belongs to `TauCeti.KacMoody.serreIdeal`. -/
theorem ad_pow_lie_of_mem_serreIdeal (R : Type*) [CommRing R] {I : Type*} (A : Matrix I I ℤ)
    (i j : I) :
    (ad R _ (FreeLieAlgebra.of R i) ^ (-A i j).toNat)
      ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆ ∈ serreIdeal R A :=
  LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩

/-- A Lie homomorphism out of `FreeLieAlgebra R I` vanishes on `TauCeti.KacMoody.serreIdeal` if and
only if its values on the generators satisfy Serre's relations. -/
theorem serreIdeal_le_ker_lift_iff {R I L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {A : Matrix I I ℤ} {f : I → L} :
    serreIdeal R A ≤ (FreeLieAlgebra.lift R f).ker ↔
      ∀ i j : I, (ad R L (f i) ^ (-A i j).toNat) ⁅f i, f j⁆ = 0 := by
  rw [serreIdeal_def, LieSubmodule.lieSpan_le]
  refine ⟨fun h i j => ?_, ?_⟩
  · have hij : (FreeLieAlgebra.lift R f)
        ((ad R _ (FreeLieAlgebra.of R i) ^ (-A i j).toNat)
          ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆) = 0 :=
      h ⟨i, j, rfl⟩
    simpa [LieHom.map_ad_pow] using hij
  · rintro h _ ⟨i, j, rfl⟩
    rw [SetLike.mem_coe, LieHom.mem_ker, LieHom.map_ad_pow, LieHom.map_lie,
      FreeLieAlgebra.lift_of_apply, FreeLieAlgebra.lift_of_apply]
    exact h i j

/-- Negating all free generators preserves `TauCeti.KacMoody.serreIdeal`. -/
theorem map_neg_of_mem_serreIdeal {R I : Type*} [CommRing R] {A : Matrix I I ℤ}
    {u : FreeLieAlgebra R I} (hu : u ∈ serreIdeal R A) :
    FreeLieAlgebra.lift R (fun i : I => -FreeLieAlgebra.of R i) u ∈ serreIdeal R A := by
  induction hu using LieSubmodule.lieSpan_induction with
  | mem v hv =>
    obtain ⟨i, j, rfl⟩ := hv
    rw [LieHom.map_ad_pow, LieHom.map_lie]
    have hneg : ad R (FreeLieAlgebra R I) (-FreeLieAlgebra.of R i) =
        (-1 : R) • ad R (FreeLieAlgebra R I) (FreeLieAlgebra.of R i) := by
      rw [map_neg, neg_smul, one_smul]
    simp only [FreeLieAlgebra.lift_of_apply, neg_lie, lie_neg, neg_neg, hneg, smul_pow,
      LinearMap.smul_apply]
    exact (serreIdeal R A).smul_mem _ (ad_pow_lie_of_mem_serreIdeal R A i j)
  | zero => simp
  | add _ _ _ _ h₁ h₂ => rw [map_add]; exact add_mem h₁ h₂
  | smul c _ _ h₁ => rw [map_smul]; exact (serreIdeal R A).smul_mem c h₁
  | lie w v _ ih =>
    rw [LieHom.map_lie]
    exact (serreIdeal R A).lie_mem ih

/-- `TauCeti.KacMoody.positiveFreeLift` vanishes on `TauCeti.KacMoody.serreIdeal`. -/
theorem serreIdeal_le_ker_positiveFreeLift {I K H : Type*} [Field K] [AddCommGroup H] [Module K H]
    {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H) :
    serreIdeal K A ≤ (positiveFreeLift R).ker :=
  serreIdeal_le_ker_lift_iff.mpr (ad_pow_lie_positiveGenerator_positiveGenerator R)

/-- `TauCeti.KacMoody.negativeFreeLift` vanishes on `TauCeti.KacMoody.serreIdeal`. -/
theorem serreIdeal_le_ker_negativeFreeLift {I K H : Type*} [Field K] [AddCommGroup H] [Module K H]
    {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H) :
    serreIdeal K A ≤ (negativeFreeLift R).ker :=
  serreIdeal_le_ker_lift_iff.mpr (ad_pow_lie_negativeGenerator_negativeGenerator R)

end SerreIdeal

/-! ## Kac's auxiliary Lie algebra and its word representation -/

section AuxiliaryProof

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

open _root_.FreeLieAlgebra Generator in
/-- The seven relator families of Kac's auxiliary Lie algebra `AuxLieAlgebra R`: everything in
`TauCeti.KacMoody.IsRelator` except Serre's relations. -/
private inductive IsAuxRelator : FreeLieAlgebra K (Generator I H) → Prop
  | cartan_add (x y : H) :
      IsAuxRelator (of K (cartan (x + y)) - of K (cartan x) - of K (cartan y))
  | cartan_smul (c : K) (x : H) :
      IsAuxRelator (of K (cartan (c • x)) - c • of K (cartan x))
  | lie_cartan_cartan (x y : H) :
      IsAuxRelator ⁅of K (cartan x : Generator I H), of K (cartan y)⁆
  | lie_cartan_positive (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (positive j)⁆ -
        R.root j x • of K (positive j))
  | lie_cartan_negative (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (negative j)⁆ +
        R.root j x • of K (negative j))
  | lie_positive_negative_self (i : I) :
      IsAuxRelator (⁅of K (positive i : Generator I H), of K (negative i)⁆ -
        of K (cartan (R.coroot i)))
  | lie_positive_negative_of_ne (i j : I) (hij : i ≠ j) :
      IsAuxRelator ⁅of K (positive i : Generator I H), of K (negative j)⁆

private noncomputable def auxIdeal : LieIdeal K (FreeLieAlgebra K (Generator I H)) :=
  LieSubmodule.lieSpan K _ { x | IsAuxRelator R x }

private abbrev AuxLieAlgebra : Type _ :=
  FreeLieAlgebra K (Generator I H) ⧸ auxIdeal R

private noncomputable def auxMk : FreeLieAlgebra K (Generator I H) →ₗ⁅K⁆ AuxLieAlgebra R :=
  LieIdeal.mkQ (auxIdeal R)

private theorem auxMk_eq_zero_of_isAuxRelator {x : FreeLieAlgebra K (Generator I H)}
    (hx : IsAuxRelator R x) : auxMk R x = 0 :=
  (LieIdeal.mkQ_apply _ x).trans
    (LieSubmodule.Quotient.mk_eq_zero'.mpr (LieSubmodule.subset_lieSpan hx))

private noncomputable def auxCartan : H →ₗ[K] AuxLieAlgebra R where
  toFun x := auxMk R (FreeLieAlgebra.of K (Generator.cartan x))
  map_add' x y := by
    have h := auxMk_eq_zero_of_isAuxRelator R (.cartan_add x y)
    rwa [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  map_smul' c x := by
    have h := auxMk_eq_zero_of_isAuxRelator R (.cartan_smul c x)
    rwa [map_sub, map_smul, sub_eq_zero] at h

private theorem auxCartan_apply (x : H) :
    auxCartan R x = auxMk R (FreeLieAlgebra.of K (Generator.cartan x)) := rfl

private noncomputable def auxE (i : I) : AuxLieAlgebra R :=
  auxMk R (FreeLieAlgebra.of K (Generator.positive i))

private noncomputable def auxF (i : I) : AuxLieAlgebra R :=
  auxMk R (FreeLieAlgebra.of K (Generator.negative i))

private noncomputable def auxMapE : FreeLieAlgebra K I →ₗ⁅K⁆ AuxLieAlgebra R :=
  FreeLieAlgebra.lift K (auxE R)

private noncomputable def auxMapF : FreeLieAlgebra K I →ₗ⁅K⁆ AuxLieAlgebra R :=
  FreeLieAlgebra.lift K (auxF R)

private theorem lie_auxCartan_auxCartan (x y : H) : ⁅auxCartan R x, auxCartan R y⁆ = 0 := by
  simpa [auxCartan_apply] using auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_cartan x y)

private theorem lie_auxCartan_auxE (x : H) (j : I) :
    ⁅auxCartan R x, auxE R j⁆ = R.root j x • auxE R j := by
  simpa [auxCartan_apply, auxE, sub_eq_zero] using
    auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_positive x j)

private theorem lie_auxCartan_auxF (x : H) (j : I) :
    ⁅auxCartan R x, auxF R j⁆ = -(R.root j x • auxF R j) := by
  simpa [auxCartan_apply, auxF, add_eq_zero_iff_eq_neg] using
    auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_negative x j)

private theorem lie_auxE_auxF_self (i : I) :
    ⁅auxE R i, auxF R i⁆ = auxCartan R (R.coroot i) := by
  simpa [auxCartan_apply, auxE, auxF, sub_eq_zero] using
    auxMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_self i)

private theorem lie_auxE_auxF_of_ne {i j : I} (hij : i ≠ j) :
    ⁅auxE R i, auxF R j⁆ = 0 := by
  simpa [auxE, auxF] using auxMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_of_ne i j hij)

/-- Data satisfying the five non-Serre relations of Kac's auxiliary algebra. -/
private structure SatisfiesAuxRelations {L : Type*} [LieRing L] [LieAlgebra K L]
    (φ : H →ₗ[K] L) (E F : I → L) : Prop where
  lie_cartan_cartan : ∀ x y, ⁅φ x, φ y⁆ = 0
  lie_cartan_positive : ∀ x j, ⁅φ x, E j⁆ = R.root j x • E j
  lie_cartan_negative : ∀ x j, ⁅φ x, F j⁆ = -(R.root j x • F j)
  lie_positive_negative_self : ∀ i, ⁅E i, F i⁆ = φ (R.coroot i)
  lie_positive_negative_of_ne : ∀ i j, i ≠ j → ⁅E i, F j⁆ = 0

private def auxGenMap {L : Type*} (φ : H → L) (E F : I → L) : Generator I H → L
  | .cartan x => φ x
  | .positive i => E i
  | .negative i => F i

private noncomputable def auxLift {L : Type*} [LieRing L] [LieAlgebra K L]
    {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesAuxRelations R φ E F) :
    AuxLieAlgebra R →ₗ⁅K⁆ L :=
  (auxIdeal R).liftQ (FreeLieAlgebra.lift K (auxGenMap φ E F)) <| by
    refine LieSubmodule.lieSpan_le.mpr fun x hx => ?_
    rw [SetLike.mem_coe, LieHom.mem_ker]
    induction hx with
    | cartan_add x y =>
      simp [auxGenMap, sub_sub]
    | cartan_smul c x =>
      simp [auxGenMap]
    | lie_cartan_cartan x y =>
      simp [auxGenMap, h.lie_cartan_cartan x y]
    | lie_cartan_positive x j =>
      simp [auxGenMap, h.lie_cartan_positive x j]
    | lie_cartan_negative x j =>
      simp [auxGenMap, h.lie_cartan_negative x j]
    | lie_positive_negative_self i =>
      simp [auxGenMap, h.lie_positive_negative_self i]
    | lie_positive_negative_of_ne i j hij =>
      simp [auxGenMap, h.lie_positive_negative_of_ne i j hij]

private theorem auxLift_auxCartan {L : Type*} [LieRing L] [LieAlgebra K L]
    {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesAuxRelations R φ E F) (x : H) :
    auxLift R h (auxCartan R x) = φ x :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ (Generator.cartan x))

private theorem auxLift_auxE {L : Type*} [LieRing L] [LieAlgebra K L]
    {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesAuxRelations R φ E F) (i : I) :
    auxLift R h (auxE R i) = E i :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ (Generator.positive i))

private theorem auxLift_auxF {L : Type*} [LieRing L] [LieAlgebra K L]
    {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesAuxRelations R φ E F) (i : I) :
    auxLift R h (auxF R i) = F i :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ (Generator.negative i))

private theorem aux_hom_ext {L : Type*} [LieRing L] [LieAlgebra K L]
    {g₁ g₂ : AuxLieAlgebra R →ₗ⁅K⁆ L}
    (hH : ∀ x, g₁ (auxCartan R x) = g₂ (auxCartan R x))
    (hE : ∀ i, g₁ (auxE R i) = g₂ (auxE R i))
    (hF : ∀ i, g₁ (auxF R i) = g₂ (auxF R i)) : g₁ = g₂ := by
  refine (auxIdeal R).lieHom_qext fun x => ?_
  have hcomp : g₁.comp (auxMk R) = g₂.comp (auxMk R) := by
    refine FreeLieAlgebra.hom_ext fun g => ?_
    cases g with
    | cartan x => exact hH x
    | positive i => exact hE i
    | negative i => exact hF i
  exact DFunLike.congr_fun hcomp x

/-- Chevalley involution of `AuxLieAlgebra R`. -/
private noncomputable def auxChevalley : AuxLieAlgebra R →ₗ⁅K⁆ AuxLieAlgebra R :=
  auxLift R (φ := -auxCartan R) (E := -auxF R) (F := -auxE R)
    { lie_cartan_cartan := fun x y => by simp [lie_auxCartan_auxCartan]
      lie_cartan_positive := fun x j => by simp [lie_auxCartan_auxF]
      lie_cartan_negative := fun x j => by simp [lie_auxCartan_auxE]
      lie_positive_negative_self := fun i => by
        simp [← lie_skew (auxF R i) (auxE R i), lie_auxE_auxF_self]
      lie_positive_negative_of_ne := fun i j hij => by
        simp [← lie_skew (auxF R i) (auxE R j), lie_auxE_auxF_of_ne R hij.symm] }

private theorem auxChevalley_involutive : Function.Involutive (auxChevalley R) := by
  intro z
  have hcomp : (auxChevalley R).comp (auxChevalley R) = LieHom.id := by
    refine aux_hom_ext R (fun x => ?_) (fun i => ?_) (fun i => ?_) <;>
      simp [auxChevalley, auxLift_auxCartan, auxLift_auxE, auxLift_auxF]
  exact DFunLike.congr_fun hcomp z

/-! ### Kac's representation of `AuxLieAlgebra R` on `MonoidAlgebra K (FreeMonoid I)` -/

section WordRepresentation

attribute [local instance 100] LieRing.ofAssociativeRing

private noncomputable def wordWeight (lam : Module.Dual K H) (w : FreeMonoid I) :
    Module.Dual K H :=
  lam - (w.toList.map R.root).sum

@[simp]
private theorem wordWeight_one (lam : Module.Dual K H) :
    wordWeight R lam 1 = lam := by
  simp [wordWeight]

private theorem wordWeight_of_mul (lam : Module.Dual K H) (j : I) (u : FreeMonoid I) :
    wordWeight R lam (FreeMonoid.of j * u) = wordWeight R lam u - R.root j := by
  simp only [wordWeight, FreeMonoid.toList_of_mul, List.map_cons, List.sum_cons]
  abel

private noncomputable def repH (lam : Module.Dual K H) :
    H →ₗ[K] Module.End K (MonoidAlgebra K (FreeMonoid I)) where
  toFun x := (MonoidAlgebra.basis (FreeMonoid I) K).constr K fun w =>
    wordWeight R lam w x • MonoidAlgebra.single w (1 : K)
  map_add' x y := by
    refine MonoidAlgebra.lhom_ext' fun w => LinearMap.ext_ring ?_
    simp [← MonoidAlgebra.basis_apply, add_smul]
  map_smul' c x := by
    refine MonoidAlgebra.lhom_ext' fun w => LinearMap.ext_ring ?_
    simp [← MonoidAlgebra.basis_apply, mul_smul]

private theorem repH_single (lam : Module.Dual K H) (x : H) (w : FreeMonoid I) :
    repH R lam x (MonoidAlgebra.single w 1) =
      wordWeight R lam w x • MonoidAlgebra.single w 1 := by
  simp [repH, ← MonoidAlgebra.basis_apply]

private noncomputable def repF (K : Type*) [Field K] {I : Type*} (j : I) :
    Module.End K (MonoidAlgebra K (FreeMonoid I)) :=
  Algebra.lmul K (MonoidAlgebra K (FreeMonoid I))
    (MonoidAlgebra.of K (FreeMonoid I) (FreeMonoid.of j))

private theorem repF_single (j : I) (u : FreeMonoid I) :
    repF K j (MonoidAlgebra.single u (1 : K)) = MonoidAlgebra.single (FreeMonoid.of j * u) 1 := by
  simp [repF, MonoidAlgebra.of_apply]

open Classical in
private noncomputable def repEWord (lam : Module.Dual K H) (i : I) (w : FreeMonoid I) :
    MonoidAlgebra K (FreeMonoid I) :=
  FreeMonoid.mulRecOn w 0 fun j u ih =>
    (if i = j then wordWeight R lam u (R.coroot i) • MonoidAlgebra.single u 1 else 0) + repF K j ih

private noncomputable def repE (lam : Module.Dual K H) (i : I) :
    Module.End K (MonoidAlgebra K (FreeMonoid I)) :=
  (MonoidAlgebra.basis (FreeMonoid I) K).constr K (repEWord R lam i)

private theorem repE_single (lam : Module.Dual K H) (i : I) (w : FreeMonoid I) :
    repE R lam i (MonoidAlgebra.single w 1) = repEWord R lam i w := by
  simp [repE, ← MonoidAlgebra.basis_apply]

private theorem repE_one (lam : Module.Dual K H) (i : I) :
    repE R lam i (1 : MonoidAlgebra K (FreeMonoid I)) = 0 := by
  have h1 : (1 : MonoidAlgebra K (FreeMonoid I)) = MonoidAlgebra.single 1 1 := rfl
  rw [h1, repE_single]
  simp [repEWord]

open Classical in
private theorem repE_repF_apply (lam : Module.Dual K H) (i j : I)
    (p : MonoidAlgebra K (FreeMonoid I)) :
    repE R lam i (repF K j p) =
      (if i = j then repH R lam (R.coroot i) p else 0) + repF K j (repE R lam i p) := by
  have hlhom : (repE R lam i).comp (repF K j) =
      (if i = j then repH R lam (R.coroot i) else 0) + (repF K j).comp (repE R lam i) := by
    refine MonoidAlgebra.lhom_ext' fun u => LinearMap.ext_ring ?_
    simp only [LinearMap.comp_apply, LinearMap.add_apply, MonoidAlgebra.lsingle_apply, repF_single,
      repE_single, repEWord, FreeMonoid.mulRecOn_of_mul]
    congr 1
    split_ifs with hij
    · subst hij
      rw [repH_single]
    · rfl
  have hp := LinearMap.congr_fun hlhom p
  simp only [LinearMap.comp_apply, LinearMap.add_apply] at hp
  rw [hp]
  congr 1
  split_ifs <;> rfl

private theorem lie_repH_repH (lam : Module.Dual K H) (x y : H) :
    ⁅repH R lam x, repH R lam y⁆ = 0 := by
  refine MonoidAlgebra.lhom_ext' fun w => LinearMap.ext_ring ?_
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply, LinearMap.zero_apply,
    LieHom.lie_apply, Module.End.lie_apply, repH_single, map_smul, smul_smul]
  rw [mul_comm, sub_self]

private theorem lie_repH_repF (lam : Module.Dual K H) (x : H) (j : I) :
    ⁅repH R lam x, repF K j⁆ = -(R.root j x • repF K j) := by
  refine MonoidAlgebra.lhom_ext' fun u => LinearMap.ext_ring ?_
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply, LinearMap.neg_apply,
    LinearMap.smul_apply, LieHom.lie_apply, Module.End.lie_apply, repF_single, repH_single,
    map_smul, wordWeight_of_mul, LinearMap.sub_apply]
  module

private theorem lie_repE_repF_self (lam : Module.Dual K H) (i : I) :
    ⁅repE R lam i, repF K i⁆ = repH R lam (R.coroot i) := by
  refine LinearMap.ext fun p => ?_
  simp [LieHom.lie_apply, repE_repF_apply]

private theorem lie_repE_repF_of_ne (lam : Module.Dual K H) {i j : I} (hij : i ≠ j) :
    ⁅repE R lam i, repF K j⁆ = 0 := by
  refine LinearMap.ext fun p => ?_
  simp [LieHom.lie_apply, repE_repF_apply, hij]

private theorem lie_repH_repE (lam : Module.Dual K H) (x : H) (i : I) :
    ⁅repH R lam x, repE R lam i⁆ = R.root i x • repE R lam i := by
  -- Show `D = ⁅repH x, repE i⁆ - αᵢ(x) repE i` commutes with every `repF j` and kills `1`.
  let D : Module.End K (MonoidAlgebra K (FreeMonoid I)) :=
    ⁅repH R lam x, repE R lam i⁆ - R.root i x • repE R lam i
  have hDF : ∀ j : I, ⁅D, repF K j⁆ = 0 := fun j => by
    have hjac : ⁅⁅repH R lam x, repE R lam i⁆, repF K j⁆ =
        ⁅repH R lam x, ⁅repE R lam i, repF K j⁆⁆ - ⁅repE R lam i, ⁅repH R lam x, repF K j⁆⁆ := by
      rw [leibniz_lie (repH R lam x) (repE R lam i) (repF K j), add_sub_cancel_right]
    simp only [D, sub_lie, hjac, lie_repH_repF, lie_neg, sub_neg_eq_add]
    rcases eq_or_ne i j with rfl | hij
    · rw [lie_repE_repF_self, lie_repH_repH, zero_add]
      refine LinearMap.ext fun p => ?_
      simp [LieHom.lie_apply]
    · rw [lie_repE_repF_of_ne R lam hij, lie_zero, zero_add]
      refine LinearMap.ext fun p => ?_
      simp [LieHom.lie_apply, repE_repF_apply, hij]
  suffices hD : D = 0 from sub_eq_zero.mp hD
  refine MonoidAlgebra.lhom_ext' fun w => LinearMap.ext_ring ?_
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply, LinearMap.zero_apply]
  refine FreeMonoid.mulRecOn w ?_ fun j u ih => ?_
  · have h1 : MonoidAlgebra.single (1 : FreeMonoid I) (1 : K) = 1 := rfl
    have hH1 : repH R lam x (1 : MonoidAlgebra K (FreeMonoid I)) =
        lam x • (1 : MonoidAlgebra K (FreeMonoid I)) := by
      simpa [h1] using repH_single R lam x 1
    simp [h1, D, LieHom.lie_apply, repE_one, hH1]
  · rw [← repF_single]
    have hcomm := LinearMap.congr_fun (hDF j) (MonoidAlgebra.single u 1)
    rw [LieHom.lie_apply, Module.End.lie_apply, Module.End.lie_apply, LinearMap.zero_apply,
      sub_eq_zero] at hcomm
    rw [hcomm, ih, map_zero]

private theorem satisfiesAuxRelations_rep (lam : Module.Dual K H) :
    SatisfiesAuxRelations R (repH R lam) (repE R lam) (repF K) where
  lie_cartan_cartan := lie_repH_repH R lam
  lie_cartan_positive := lie_repH_repE R lam
  lie_cartan_negative := lie_repH_repF R lam
  lie_positive_negative_self := lie_repE_repF_self R lam
  lie_positive_negative_of_ne _ _ hij := lie_repE_repF_of_ne R lam hij

private noncomputable def auxRep (lam : Module.Dual K H) :
    AuxLieAlgebra R →ₗ⁅K⁆ Module.End K (MonoidAlgebra K (FreeMonoid I)) :=
  auxLift R (satisfiesAuxRelations_rep R lam)

private theorem auxRep_auxMapF_one (lam : Module.Dual K H) (u : FreeLieAlgebra K I) :
    auxRep R lam (auxMapF R u) 1 = TauCeti.FreeLieAlgebra.toMonoidAlgebra K I u := by
  have hcomp : (auxRep R lam).comp (auxMapF R) =
      LieHom.leftRegularRep (TauCeti.FreeLieAlgebra.toMonoidAlgebra K I) := by
    refine FreeLieAlgebra.hom_ext fun j => ?_
    refine LinearMap.ext fun p => ?_
    simp [auxRep, auxMapF, auxLift_auxF, repF, LieHom.leftRegularRep_apply]
  have := DFunLike.congr_fun hcomp u
  simpa [LieHom.leftRegularRep_apply] using LinearMap.congr_fun this 1

private theorem auxRep_auxMapE_one (lam : Module.Dual K H) (u : FreeLieAlgebra K I) :
    auxRep R lam (auxMapE R u) 1 = 0 := by
  let S : LieSubalgebra K (Module.End K (MonoidAlgebra K (FreeMonoid I))) :=
    TauCeti.lieAnnihilator K (Module.End K (MonoidAlgebra K (FreeMonoid I)))
      (1 : MonoidAlgebra K (FreeMonoid I))
  have hle : ((auxRep R lam).comp (auxMapE R)).range ≤ S := by
    rw [LieHom.range_eq_map, ← TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top,
      LieSubalgebra.map_lieSpan]
    refine TauCeti.lieSpan_le_lieAnnihilator _ _ ?_
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    simp [auxRep, auxMapE, auxLift_auxE, repE_one]
  exact (TauCeti.mem_lieAnnihilator _ _).mp (hle ⟨u, rfl⟩)

/-- **Direct-sum independence in Kac's auxiliary algebra `AuxLieAlgebra R`.** For any matrix `A`, if
`auxMapF uF + auxCartan x + auxMapE uE = 0`, then `uF = 0`, `x = 0`, and `uE = 0`. -/
private theorem auxMapF_add_auxCartan_add_auxMapE_eq_zero {uF uE : FreeLieAlgebra K I} {x : H}
    (h : auxMapF R uF + auxCartan R x + auxMapE R uE = 0) :
    uF = 0 ∧ x = 0 ∧ uE = 0 := by
  have heval : ∀ lam : Module.Dual K H,
      TauCeti.FreeLieAlgebra.toMonoidAlgebra K I uF + MonoidAlgebra.single 1 (lam x) = 0 := by
    intro lam
    have h0 := LinearMap.congr_fun (congrArg (auxRep R lam) h) 1
    simp only [map_add, map_zero, LinearMap.add_apply, LinearMap.zero_apply,
      auxRep_auxMapF_one, auxRep_auxMapE_one, add_zero] at h0
    have h1 : (1 : MonoidAlgebra K (FreeMonoid I)) = MonoidAlgebra.single 1 1 := rfl
    have hH : auxRep R lam (auxCartan R x) 1 = MonoidAlgebra.single 1 (lam x) := by
      rw [auxRep, auxLift_auxCartan, h1, repH_single, wordWeight_one, MonoidAlgebra.smul_single,
        smul_eq_mul, mul_one]
    rwa [hH] at h0
  have hx : x = 0 := by
    refine (Module.forall_dual_apply_eq_zero_iff K x).mp fun lam => ?_
    have h1 := congrArg (fun p : MonoidAlgebra K (FreeMonoid I) => p.coeff 1) (heval lam)
    simpa using h1
  subst hx
  have huF : uF = 0 := by
    apply TauCeti.FreeLieAlgebra.toMonoidAlgebra_injective K I
    simpa using heval 0
  subst huF
  refine ⟨rfl, rfl, ?_⟩
  simp only [map_zero, zero_add] at h
  let σ : FreeLieAlgebra K I →ₗ⁅K⁆ FreeLieAlgebra K I :=
    FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i
  have hσ_invol : ∀ w, σ (σ w) = w := fun w => by
    have hcomp : σ.comp σ = LieHom.id := by ext i; simp [σ]
    exact DFunLike.congr_fun hcomp w
  have hchev : (auxChevalley R).comp (auxMapE R) = (auxMapF R).comp σ := by
    refine FreeLieAlgebra.hom_ext fun i => ?_
    simp [auxChevalley, auxMapE, auxMapF, σ, auxLift_auxE]
  have hF0 : auxMapF R (σ uE) = 0 := by
    have := DFunLike.congr_fun hchev uE
    simpa [h] using this.symm
  have hσ0 : σ uE = 0 := by
    apply TauCeti.FreeLieAlgebra.toMonoidAlgebra_injective K I
    have h0 := LinearMap.congr_fun (congrArg (auxRep R 0) hF0) 1
    simpa [auxRep_auxMapF_one] using h0
  rw [← hσ_invol uE, hσ0, map_zero]

end WordRepresentation

/-! ### Serre ideal invariance in `AuxLieAlgebra R` for a generalized Cartan matrix -/

private theorem auxCartan_injective : Function.Injective (auxCartan R) := fun x y hxy => by
  have h0 : auxMapF R 0 + auxCartan R (x - y) + auxMapE R 0 = 0 := by
    simp [sub_eq_zero.mpr hxy]
  exact sub_eq_zero.mp (auxMapF_add_auxCartan_add_auxMapE_eq_zero R h0).2.1

private theorem isSl2Triple_aux (hA : A.IsGeneralizedCartan) (i : I) :
    IsSl2Triple (auxCartan R (R.coroot i)) (auxE R i) (auxF R i) where
  h_ne_zero h0 := R.coroot_linearIndependent.ne_zero i (auxCartan_injective R (by simpa using h0))
  lie_e_f := lie_auxE_auxF_self R i
  lie_h_e_nsmul := by
    rw [lie_auxCartan_auxE, R.root_coroot, Matrix.map_apply, hA.diag i]
    simp [two_smul]
  lie_h_f_nsmul := by
    rw [lie_auxCartan_auxF, R.root_coroot, Matrix.map_apply, hA.diag i]
    simp [two_smul]

/-- In `AuxLieAlgebra R`, for a generalized Cartan matrix `A`, every lowering generator `auxF R k`
annihilates every positive Serre relator `(ad (auxE R i) ^ (-A i j).toNat) ⁅auxE R i, auxE R j⁆`. -/
private theorem lie_auxF_ad_pow_lie_auxE_eq_zero (hA : A.IsGeneralizedCartan) (k i j : I) :
    ⁅auxF R k,
      (ad K _ (auxE R i) ^ (-A i j).toNat) ⁅auxE R i, auxE R j⁆⁆ = 0 := by
  rcases eq_or_ne i j with rfl | hij
  · simp
  rcases eq_or_ne k i with rfl | hki
  · have hyh : ⁅auxCartan R (R.coroot k), auxE R j⁆ = (A k j : K) • auxE R j := by
      simpa using lie_auxCartan_auxE R (R.coroot k) j
    have hyf : ⁅auxF R k, auxE R j⁆ = 0 := by
      rw [← lie_skew, lie_auxE_auxF_of_ne R hij.symm, neg_zero]
    have hsl2 := (isSl2Triple_aux R hA k).lie_f_pow_succ_toEnd_e hyh hyf ((-A k j).toNat)
    have hexp : (((-A k j).toNat : ℕ) : K) = -(A k j : K) := by
      rw [← Int.cast_natCast, hA.natCast_toNat_neg_of_ne hij, Int.cast_neg]
    have hpow : (LieModule.toEnd K _ (AuxLieAlgebra R) (auxE R k) ^ ((-A k j).toNat + 1))
        (auxE R j) = (ad K _ (auxE R k) ^ (-A k j).toNat) ⁅auxE R k, auxE R j⁆ := by
      rw [← LieAlgebra.ad_eq_toEnd, TauCeti.ad_pow_succ_apply]
    rw [← hpow, hsl2, hexp, sub_self, mul_zero, zero_smul]
  · have hcomm : ∀ n : ℕ, ∀ z : AuxLieAlgebra R,
        ⁅auxF R k, (ad K _ (auxE R i) ^ n) z⁆ =
          (ad K _ (auxE R i) ^ n) ⁅auxF R k, z⁆ := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        intro z
        rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie,
          ← lie_skew (auxF R k), lie_auxE_auxF_of_ne R hki.symm, neg_zero, zero_lie, zero_add, ih,
          mul_apply_eq_comp, ad_apply]
    rw [hcomm]
    rcases eq_or_ne k j with rfl | hkj
    · have hinner : ⁅auxF R k, ⁅auxE R i, auxE R k⁆⁆ = (A k i : K) • auxE R i := by
        rw [leibniz_lie, ← lie_skew (auxF R k) (auxE R i), lie_auxE_auxF_of_ne R hij,
          neg_zero, zero_lie, zero_add, ← lie_skew (auxF R k) (auxE R k), lie_auxE_auxF_self,
          lie_neg, ← lie_skew (auxE R i), neg_neg, lie_auxCartan_auxE, R.root_coroot,
          Matrix.map_apply]
      rw [hinner, map_smul]
      rcases eq_or_ne (A i k) 0 with h0 | h0
      · rw [(hA.zero_comm i k).mp h0, Int.cast_zero, zero_smul]
      · obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero
          (hA.toNat_neg_pos_of_ne_of_ne_zero hij h0).ne'
        rw [hm, TauCeti.ad_pow_succ_apply, lie_self, map_zero, smul_zero]
    · rw [leibniz_lie, ← lie_skew (auxF R k) (auxE R i), lie_auxE_auxF_of_ne R hki.symm,
        ← lie_skew (auxF R k) (auxE R j), lie_auxE_auxF_of_ne R hkj.symm]
      simp

private theorem lie_auxCartan_mem_range_auxMapE (x : H) {z : AuxLieAlgebra R}
    (hz : z ∈ (auxMapE R).range) : ⁅auxCartan R x, z⁆ ∈ (auxMapE R).range := by
  have hrange : (auxMapE R).range =
      LieSubalgebra.lieSpan K (AuxLieAlgebra R) (Set.range (auxE R)) := by
    rw [LieHom.range_eq_map, ← TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top,
      LieSubalgebra.map_lieSpan, ← Set.range_comp]
    congr 1; ext i; simp [auxMapE]
  rw [hrange] at hz ⊢
  refine LieSubalgebra.lie_mem_of_mem_lieSpan ?_ hz
  rintro _ ⟨j, rfl⟩
  rw [lie_auxCartan_auxE]
  exact LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan ⟨j, rfl⟩)

private theorem lie_auxF_mem_range_auxMapE_sup_range_auxCartan (k : I) {z : AuxLieAlgebra R}
    (hz : z ∈ (auxMapE R).range) :
    ⁅auxF R k, z⁆ ∈ (auxMapE R).range.toSubmodule ⊔ LinearMap.range (auxCartan R) := by
  have hrange : (auxMapE R).range =
      LieSubalgebra.lieSpan K (AuxLieAlgebra R) (Set.range (auxE R)) := by
    rw [LieHom.range_eq_map, ← TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top,
      LieSubalgebra.map_lieSpan, ← Set.range_comp]
    congr 1; ext i; simp [auxMapE]
  rw [hrange] at hz ⊢
  refine LieSubalgebra.lie_mem_sup_of_mem_lieSpan
    (U := LinearMap.range (auxCartan R))
    (fun u hu v hv => ?_) (fun _ hz' => ?_) hz
  · obtain ⟨y, rfl⟩ := hu
    rw [← hrange] at hv ⊢
    exact lie_auxCartan_mem_range_auxMapE R y hv
  · obtain ⟨j, rfl⟩ := hz'
    rw [← lie_skew]
    rcases eq_or_ne j k with rfl | hjk
    · rw [lie_auxE_auxF_self]
      exact Submodule.mem_sup_right ⟨-R.coroot j, by simp⟩
    · rw [lie_auxE_auxF_of_ne R hjk, neg_zero]
      exact zero_mem _

/-- `ad (auxCartan R x)` preserves the image of `serreIdeal K A` under `auxMapE R`. -/
private theorem lie_auxCartan_mem_map_serreIdeal (x : H) {u : FreeLieAlgebra K I}
    (hu : u ∈ serreIdeal K A) :
    ⁅auxCartan R x, auxMapE R u⁆ ∈
      (serreIdeal K A).toSubmodule.map (auxMapE R).toLinearMap := by
  induction hu using LieSubmodule.lieSpan_induction with
  | mem v hv =>
    obtain ⟨i, j, rfl⟩ := hv
    have had : ∀ n : ℕ,
        ⁅auxCartan R x, (ad K _ (auxE R i) ^ n) ⁅auxE R i, auxE R j⁆⁆ =
          (((n + 1 : ℕ) : K) * R.root i x + R.root j x) •
            (ad K _ (auxE R i) ^ n) ⁅auxE R i, auxE R j⁆ := by
      intro n
      induction n with
      | zero =>
        simp only [pow_zero, one_apply_eq_self, leibniz_lie, lie_auxCartan_auxE, smul_lie,
          lie_smul, zero_add]
        push_cast
        module
      | succ n ih =>
        rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie,
          lie_auxCartan_auxE, ih, smul_lie, lie_smul]
        push_cast
        module
    have hmap : auxMapE R ((ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
        ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆) =
        (ad K _ (auxE R i) ^ (-A i j).toNat) ⁅auxE R i, auxE R j⁆ := by
      simp [auxMapE, LieHom.map_ad_pow]
    rw [hmap, had, ← hmap]
    exact Submodule.smul_mem _ _ ⟨_, ad_pow_lie_of_mem_serreIdeal K A i j, rfl⟩
  | zero => simp
  | add _ _ _ _ h₁ h₂ =>
    rw [map_add, lie_add]
    exact add_mem h₁ h₂
  | smul c _ _ h₁ =>
    rw [map_smul, lie_smul]
    exact Submodule.smul_mem _ c h₁
  | lie w v hv ih =>
    rw [LieHom.map_lie, leibniz_lie]
    obtain ⟨w', hw'⟩ := lie_auxCartan_mem_range_auxMapE R x ⟨w, rfl⟩
    obtain ⟨v', hv'mem, hv'eq⟩ := ih
    have hw'' : auxMapE R w' = ⁅auxCartan R x, auxMapE R w⁆ := hw'
    have hv'' : auxMapE R v' = ⁅auxCartan R x, auxMapE R v⁆ := hv'eq
    rw [← hw'', ← hv'', ← LieHom.map_lie, ← LieHom.map_lie]
    exact add_mem ⟨⁅w', v⁆, (serreIdeal K A).lie_mem hv, rfl⟩
      ⟨⁅w, v'⁆, (serreIdeal K A).lie_mem hv'mem, rfl⟩

/-- For a generalized Cartan matrix `A`, `ad (auxF R k)` preserves the image of `serreIdeal K A`
under `auxMapE R`. -/
private theorem lie_auxF_mem_map_serreIdeal (hA : A.IsGeneralizedCartan) (k : I)
    {u : FreeLieAlgebra K I} (hu : u ∈ serreIdeal K A) :
    ⁅auxF R k, auxMapE R u⁆ ∈
      (serreIdeal K A).toSubmodule.map (auxMapE R).toLinearMap := by
  induction hu using LieSubmodule.lieSpan_induction with
  | mem v hv =>
    obtain ⟨i, j, rfl⟩ := hv
    have hmap : auxMapE R ((ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
        ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆) =
        (ad K _ (auxE R i) ^ (-A i j).toNat) ⁅auxE R i, auxE R j⁆ := by
      simp [auxMapE, LieHom.map_ad_pow]
    rw [hmap, lie_auxF_ad_pow_lie_auxE_eq_zero R hA k i j]
    exact zero_mem _
  | zero => simp
  | add _ _ _ _ h₁ h₂ =>
    rw [map_add, lie_add]
    exact add_mem h₁ h₂
  | smul c _ _ h₁ =>
    rw [map_smul, lie_smul]
    exact Submodule.smul_mem _ c h₁
  | lie w v hv ih =>
    rw [LieHom.map_lie, leibniz_lie]
    obtain ⟨_, ⟨w', rfl⟩, _, ⟨y, rfl⟩, hwy⟩ :=
      Submodule.mem_sup.mp (lie_auxF_mem_range_auxMapE_sup_range_auxCartan R k ⟨w, rfl⟩)
    obtain ⟨v', hv'mem, hv'eq⟩ := ih
    have hwy' : auxMapE R w' + auxCartan R y = ⁅auxF R k, auxMapE R w⁆ := hwy
    have hv'' : auxMapE R v' = ⁅auxF R k, auxMapE R v⁆ := hv'eq
    rw [← hwy', add_lie, ← LieHom.map_lie, ← hv'', ← LieHom.map_lie]
    refine add_mem (add_mem ?_ (lie_auxCartan_mem_map_serreIdeal R y hv)) ?_
    · exact ⟨⁅w', v⁆, (serreIdeal K A).lie_mem hv, rfl⟩
    · exact ⟨⁅w, v'⁆, (serreIdeal K A).lie_mem hv'mem, rfl⟩

/-- For a generalized Cartan matrix `A`, the image of `serreIdeal K A` under `auxMapE R` is a Lie
ideal of `AuxLieAlgebra R`. -/
private noncomputable def auxSerrePosIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxLieAlgebra R) where
  toSubmodule := (serreIdeal K A).toSubmodule.map (auxMapE R).toLinearMap
  lie_mem := by
    intro z w hw
    let P := (serreIdeal K A).toSubmodule.map (auxMapE R).toLinearMap
    let N : LieSubalgebra K (AuxLieAlgebra R) :=
      { toSubmodule :=
          { carrier := { a | ∀ b ∈ P, ⁅a, b⁆ ∈ P }
            add_mem' := fun {a₁ a₂} h₁ h₂ b hb => by rw [add_lie]; exact add_mem (h₁ b hb) (h₂ b hb)
            zero_mem' := fun _ _ => by simp
            smul_mem' := fun c {a} ha b hb => by rw [smul_lie]; exact P.smul_mem c (ha b hb) }
        lie_mem' := fun {a₁ a₂} h₁ h₂ b hb => by
          rw [lie_lie]
          exact sub_mem (h₁ _ (h₂ b hb)) (h₂ _ (h₁ b hb)) }
    have htop : N = ⊤ := by
      refine eq_top_iff.mpr fun q _ => ?_
      obtain ⟨x, rfl⟩ := (auxIdeal R).surjective_mkQ q
      have hle : LieSubalgebra.lieSpan K (FreeLieAlgebra K (Generator I H))
          (Set.range (FreeLieAlgebra.of K)) ≤ N.comap (auxMk R) := by
        refine LieSubalgebra.lieSpan_le.mpr ?_
        rintro _ ⟨g, rfl⟩ b ⟨u, hu, rfl⟩
        cases g with
        | cartan x => exact lie_auxCartan_mem_map_serreIdeal R x hu
        | positive k =>
          exact ⟨⁅FreeLieAlgebra.of K k, u⁆, (serreIdeal K A).lie_mem hu, by simp [auxMapE, auxE]⟩
        | negative k => exact lie_auxF_mem_map_serreIdeal R hA k hu
      exact hle (by rw [TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial)
    have hz : z ∈ N := htop ▸ trivial
    exact hz w hw

/-- By `auxChevalley`, the image of `serreIdeal K A` under `auxMapF R` is also a Lie ideal of
`AuxLieAlgebra R`. -/
private noncomputable def auxSerreNegIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxLieAlgebra R) where
  toSubmodule := (serreIdeal K A).toSubmodule.map (auxMapF R).toLinearMap
  lie_mem := by
    rintro z _ ⟨u, hu, rfl⟩
    let σ : FreeLieAlgebra K I →ₗ⁅K⁆ FreeLieAlgebra K I :=
      FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i
    have hchevF : (auxChevalley R).comp (auxMapF R) = (auxMapE R).comp σ := by
      refine FreeLieAlgebra.hom_ext fun i => ?_
      simp [auxChevalley, auxMapE, auxMapF, σ, auxLift_auxF]
    have hchevE : (auxChevalley R).comp (auxMapE R) = (auxMapF R).comp σ := by
      refine FreeLieAlgebra.hom_ext fun i => ?_
      simp [auxChevalley, auxMapE, auxMapF, σ, auxLift_auxE]
    have hmem : ⁅auxChevalley R z, auxMapE R (σ u)⁆ ∈
        (serreIdeal K A).toSubmodule.map (auxMapE R).toLinearMap :=
      (auxSerrePosIdeal R hA).lie_mem ⟨σ u, map_neg_of_mem_serreIdeal hu, rfl⟩
    obtain ⟨v, hv, hveq⟩ := hmem
    have hveq' : auxMapE R v = ⁅auxChevalley R z, auxMapE R (σ u)⁆ := hveq
    have hchevF_u : auxChevalley R (auxMapF R u) = auxMapE R (σ u) :=
      DFunLike.congr_fun hchevF u
    have h1 : auxChevalley R ⁅z, auxMapF R u⁆ = ⁅auxChevalley R z, auxMapE R (σ u)⁆ := by
      rw [LieHom.map_lie, hchevF_u]
    have h2 : ⁅z, auxMapF R u⁆ = auxMapF R (σ v) := by
      calc ⁅z, auxMapF R u⁆
          = auxChevalley R (auxChevalley R ⁅z, auxMapF R u⁆) := (auxChevalley_involutive R _).symm
        _ = auxChevalley R (auxMapE R v) := by rw [h1, ← hveq']
        _ = auxMapF R (σ v) := DFunLike.congr_fun hchevE v
    exact ⟨σ v, map_neg_of_mem_serreIdeal hv, h2.symm⟩

private noncomputable def auxToPresented : AuxLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra R :=
  auxLift R
    { lie_cartan_cartan := lie_cartanElement_cartanElement R
      lie_cartan_positive := lie_cartanElement_positiveGenerator R
      lie_cartan_negative := lie_cartanElement_negativeGenerator R
      lie_positive_negative_self := lie_positiveGenerator_negativeGenerator_self R
      lie_positive_negative_of_ne := fun _ _ => lie_positiveGenerator_negativeGenerator_of_ne R }

private theorem ker_auxToPresented (hA : A.IsGeneralizedCartan) :
    (auxToPresented R).ker = auxSerreNegIdeal R hA ⊔ auxSerrePosIdeal R hA := by
  let J := auxSerreNegIdeal R hA ⊔ auxSerrePosIdeal R hA
  have hFcomp : (auxToPresented R).comp (auxMapF R) = negativeFreeLift R := by
    refine FreeLieAlgebra.hom_ext fun i => ?_
    simp [auxToPresented, auxMapF, auxLift_auxF]
  have hEcomp : (auxToPresented R).comp (auxMapE R) = positiveFreeLift R := by
    refine FreeLieAlgebra.hom_ext fun i => ?_
    simp [auxToPresented, auxMapE, auxLift_auxE]
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · let q : AuxLieAlgebra R →ₗ⁅K⁆ AuxLieAlgebra R ⧸ J := LieIdeal.mkQ J
    have hsat : SatisfiesRelations R ((q : AuxLieAlgebra R →ₗ[K] _) ∘ₗ auxCartan R)
        (q ∘ auxE R) (q ∘ auxF R) :=
      { lie_cartan_cartan := fun x y => by simp [← LieHom.map_lie, lie_auxCartan_auxCartan]
        lie_cartan_positive := fun x j => by simp [← LieHom.map_lie, lie_auxCartan_auxE]
        lie_cartan_negative := fun x j => by simp [← LieHom.map_lie, lie_auxCartan_auxF]
        lie_positive_negative_self := fun i => by simp [← LieHom.map_lie, lie_auxE_auxF_self]
        lie_positive_negative_of_ne := fun i j hij => by
          simp [← LieHom.map_lie, lie_auxE_auxF_of_ne R hij]
        serre_positive := fun i j => by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]
          refine LieSubmodule.mem_sup_right ⟨_, ad_pow_lie_of_mem_serreIdeal K A i j, ?_⟩
          simp [auxMapE, LieHom.map_ad_pow]
        serre_negative := fun i j => by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]
          refine LieSubmodule.mem_sup_left ⟨_, ad_pow_lie_of_mem_serreIdeal K A i j, ?_⟩
          simp [auxMapF, LieHom.map_ad_pow] }
    have hq : (lift hsat).comp (auxToPresented R) = q := by
      refine aux_hom_ext R (fun x => ?_) (fun i => ?_) (fun i => ?_) <;>
        simp [auxToPresented, auxLift_auxCartan, auxLift_auxE, auxLift_auxF]
    intro z hz
    rw [LieHom.mem_ker] at hz
    have hqz : q z = 0 := by rw [← hq, LieHom.comp_apply, hz, map_zero]
    rwa [← LieHom.mem_ker, LieIdeal.mkQ_ker] at hqz
  · rintro _ ⟨u, hu, rfl⟩
    rw [LieHom.mem_ker, LieHom.coe_toLinearMap, ← LieHom.comp_apply, hFcomp]
    exact serreIdeal_le_ker_negativeFreeLift R hu
  · rintro _ ⟨u, hu, rfl⟩
    rw [LieHom.mem_ker, LieHom.coe_toLinearMap, ← LieHom.comp_apply, hEcomp]
    exact serreIdeal_le_ker_positiveFreeLift R hu

/-- **Master triangular vanishing criterion.** For a generalized Cartan matrix `A`, an ordered sum
`negativeFreeLift R uF + cartanElement R x + positiveFreeLift R uE` vanishes in
`PresentedLieAlgebra R` if and only if `uF ∈ serreIdeal K A`, `x = 0`, and
`uE ∈ serreIdeal K A`. -/
theorem negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff
    (hA : A.IsGeneralizedCartan) {uF uE : FreeLieAlgebra K I} {x : H} :
    negativeFreeLift R uF + cartanElement R x + positiveFreeLift R uE = 0 ↔
      uF ∈ serreIdeal K A ∧ x = 0 ∧ uE ∈ serreIdeal K A := by
  refine ⟨fun h => ?_, fun ⟨huF, hx, huE⟩ => ?_⟩
  · have hFcomp : (auxToPresented R).comp (auxMapF R) = negativeFreeLift R := by
      refine FreeLieAlgebra.hom_ext fun i => ?_
      simp [auxToPresented, auxMapF, auxLift_auxF]
    have hEcomp : (auxToPresented R).comp (auxMapE R) = positiveFreeLift R := by
      refine FreeLieAlgebra.hom_ext fun i => ?_
      simp [auxToPresented, auxMapE, auxLift_auxE]
    have hmem : auxMapF R uF + auxCartan R x + auxMapE R uE ∈ (auxToPresented R).ker := by
      rw [LieHom.mem_ker, map_add, map_add, ← LieHom.comp_apply, ← LieHom.comp_apply, hFcomp,
        hEcomp, auxToPresented, auxLift_auxCartan]
      exact h
    rw [ker_auxToPresented R hA] at hmem
    obtain ⟨_, ⟨vF, hvF, rfl⟩, _, ⟨vE, hvE, rfl⟩, heq⟩ := Submodule.mem_sup.mp hmem
    have hzero : auxMapF R (uF - vF) + auxCartan R x + auxMapE R (uE - vE) = 0 := by
      have hvF' : (auxMapF R).toLinearMap vF = auxMapF R vF := rfl
      have hvE' : (auxMapE R).toLinearMap vE = auxMapE R vE := rfl
      rw [hvF', hvE'] at heq
      simp only [map_sub]
      rw [← sub_eq_zero]
      convert sub_eq_zero.mpr heq.symm using 1
      abel
    obtain ⟨h1, hx, h2⟩ := auxMapF_add_auxCartan_add_auxMapE_eq_zero R hzero
    exact ⟨sub_eq_zero.mp h1 ▸ hvF, hx, sub_eq_zero.mp h2 ▸ hvE⟩
  · have hF0 : negativeFreeLift R uF = 0 := serreIdeal_le_ker_negativeFreeLift R huF
    have hE0 : positiveFreeLift R uE = 0 := serreIdeal_le_ker_positiveFreeLift R huE
    rw [hx, map_zero, hF0, hE0, add_zero, add_zero]

end AuxiliaryProof

end TauCeti.KacMoody
