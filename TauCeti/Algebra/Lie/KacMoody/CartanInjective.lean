module

public import Mathlib.Algebra.Lie.Abelian
public import TauCeti.Algebra.Lie.KacMoody.SerreIdeal
public import TauCeti.Algebra.Lie.Presentation.Serre.Automorphism

import TauCeti.Algebra.Lie.Basic
import TauCeti.Algebra.Lie.Quotient

/-!
# Cartan injectivity and Serre presentations of the triangular halves

Let `A` be a square matrix of integers and `R` a realization of `A` over a field `K`
(`TauCeti.CartanRealization`). Write `𝔤 = TauCeti.KacMoody.PresentedLieAlgebra R`, `n⁺` and `n⁻`
for the Lie subalgebras generated by the raising and lowering generators, and `𝔥` for the image of
`H` under `TauCeti.KacMoody.cartanElement`.

For an arbitrary integer matrix `A`, the Chevalley involution `ω`
(`TauCeti.KacMoody.chevalleyInvolution`) exchanges `n⁺` and `n⁻` while acting as `-1` on `𝔥`, and
every vector in `R.cartanCenter` maps into the center of `𝔤`. No injectivity of `cartanElement`
holds without further hypotheses on `A`: if `A` fails the zero-symmetry axiom
(`A = !![2, -1; 0, 2]`), the Serre relator `⁅e₁, e₀⁆ = 0` collapses `e₁` and `h₁` to zero.

When `A` is a generalized Cartan matrix (`Matrix.IsGeneralizedCartan`), applying the master
triangular vanishing criterion of `TauCeti/Algebra/Lie/KacMoody/SerreIdeal.lean` yields over every
field `K` (without characteristic, finiteness, or symmetrizability hypotheses):

* **Cartan injectivity** (`TauCeti.KacMoody.cartanElement_injective`): `H` embeds faithfully into
  `PresentedLieAlgebra R`, and its central elements are precisely the image of `R.cartanCenter`
  (`TauCeti.KacMoody.cartanElement_mem_center_iff`).
* **Independent Serre presentations of `n⁺` and `n⁻`**
  (`TauCeti.KacMoody.positiveSubalgebraEquiv`, `TauCeti.KacMoody.negativeSubalgebraEquiv`): both
  subalgebras are canonically isomorphic to `FreeLieAlgebra K I ⧸ serreIdeal K A`, independently of
  the ambient realization `H`.

## Main definitions

* `TauCeti.KacMoody.chevalleyInvolution`: the Chevalley involution `ω` of `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.positiveSubalgebra`, `TauCeti.KacMoody.negativeSubalgebra`,
  `TauCeti.KacMoody.cartanSubalgebra`: the triangular Lie subalgebras `n⁺`, `n⁻`, and `𝔥`.
* `TauCeti.KacMoody.cartanEquiv`: the linear equivalence `H ≃ₗ[K] cartanSubalgebra R`.
* `TauCeti.KacMoody.positiveSubalgebraEquiv`, `TauCeti.KacMoody.negativeSubalgebraEquiv`: the Lie
  algebra isomorphisms `(FreeLieAlgebra K I ⧸ serreIdeal K A) ≃ₗ⁅K⁆ positiveSubalgebra R` and
  `negativeSubalgebra R`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §1.2–1.3, Theorem 1.2, and §3.3.
-/

public section

open LieAlgebra

namespace TauCeti.KacMoody

section ArbitraryMatrix

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-! ## The Chevalley involution -/

section ChevalleyInvolution

variable {R} {L : Type*} [LieRing L] [LieAlgebra K L]

/-- Signed exchange of the raising and lowering families preserves the defining relations of the
presented algebra. -/
theorem SatisfiesRelations.neg_swap {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesRelations R φ E F) :
    SatisfiesRelations R (-φ) (-F) (-E) where
  lie_cartan_cartan x y := by simp [h.lie_cartan_cartan]
  lie_cartan_positive x j := by simp [h.lie_cartan_negative]
  lie_cartan_negative x j := by simp [h.lie_cartan_positive]
  lie_positive_negative_self i := by
    simp [← lie_skew (F i) (E i), h.lie_positive_negative_self]
  lie_positive_negative_of_ne i j hij := by
    simp [← lie_skew (F i) (E j), h.lie_positive_negative_of_ne j i hij.symm]
  serre_positive i j := by
    simpa only [Pi.neg_apply, neg_lie, lie_neg, neg_neg] using
      TauCeti.ad_neg_pow_apply_eq_zero (h.serre_negative i j)
  serre_negative i j := by
    simpa only [Pi.neg_apply, neg_lie, lie_neg, neg_neg] using
      TauCeti.ad_neg_pow_apply_eq_zero (h.serre_positive i j)

variable (R)

private noncomputable def chevalleyHom : PresentedLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra R :=
  lift (satisfiesRelations_generators R).neg_swap

private theorem chevalleyHom_comp :
    (chevalleyHom R).comp (chevalleyHom R) = LieHom.id := by
  ext <;> simp [chevalleyHom]

/-- The **Chevalley involution** `ω` of `PresentedLieAlgebra R`, acting as `-1` on Cartan elements
and exchanging `eᵢ` and `fᵢ` with a minus sign (`eᵢ ↦ -fᵢ`, `fᵢ ↦ -eᵢ`). -/
noncomputable def chevalleyInvolution : PresentedLieAlgebra R ≃ₗ⁅K⁆ PresentedLieAlgebra R where
  toLieHom := chevalleyHom R
  invFun := chevalleyHom R
  left_inv z := by simpa using DFunLike.congr_fun (chevalleyHom_comp R) z
  right_inv z := by simpa using DFunLike.congr_fun (chevalleyHom_comp R) z

@[simp]
theorem chevalleyInvolution_cartanElement (x : H) :
    chevalleyInvolution R (cartanElement R x) = -cartanElement R x :=
  lift_cartanElement _ x

@[simp]
theorem chevalleyInvolution_positiveGenerator (i : I) :
    chevalleyInvolution R (positiveGenerator R i) = -negativeGenerator R i :=
  lift_positiveGenerator _ i

@[simp]
theorem chevalleyInvolution_negativeGenerator (i : I) :
    chevalleyInvolution R (negativeGenerator R i) = -positiveGenerator R i :=
  lift_negativeGenerator _ i

/-- The Chevalley involution is involutive. -/
theorem chevalleyInvolution_involutive : Function.Involutive (chevalleyInvolution R) := fun z =>
  (chevalleyInvolution R).left_inv z

@[simp]
theorem chevalleyInvolution_apply_apply (z : PresentedLieAlgebra R) :
    chevalleyInvolution R (chevalleyInvolution R z) = z :=
  chevalleyInvolution_involutive R z

@[simp]
theorem chevalleyInvolution_symm :
    (chevalleyInvolution R).symm = chevalleyInvolution R :=
  LieEquiv.ext fun _ => rfl

/-- `TauCeti.KacMoody.serreHom` intertwines the Chevalley involutions of `Matrix.ToLieAlgebra K A`
and `PresentedLieAlgebra R`. -/
theorem chevalleyInvolution_serreHom [DecidableEq I] (x : Matrix.ToLieAlgebra K A) :
    chevalleyInvolution R (serreHom R x) = serreHom R (serreChevalleyInvolution K A x) := by
  have hcomp : (chevalleyInvolution R : PresentedLieAlgebra R →ₗ⁅K⁆ _).comp (serreHom R) =
      (serreHom R).comp (serreChevalleyInvolution K A : Matrix.ToLieAlgebra K A →ₗ⁅K⁆ _) :=
    serre_hom_ext (fun i => by simp) fun i => by simp
  exact DFunLike.congr_fun hcomp x

end ChevalleyInvolution

/-! ## The triangular subalgebras -/

/-- The positive Lie subalgebra `n⁺` of `PresentedLieAlgebra R`, generated by the raising
generators `eᵢ`. -/
noncomputable def positiveSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (positiveGenerator R))

/-- The negative Lie subalgebra `n⁻` of `PresentedLieAlgebra R`, generated by the lowering
generators `fᵢ`. -/
noncomputable def negativeSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (negativeGenerator R))

/-- The Cartan Lie subalgebra `𝔥` of `PresentedLieAlgebra R`, the image of `H` under
`TauCeti.KacMoody.cartanElement`. -/
noncomputable def cartanSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) where
  toSubmodule := LinearMap.range (cartanElement R)
  lie_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    rw [lie_cartanElement_cartanElement]
    exact Submodule.zero_mem _

/-- Explicit `lieSpan` description of `TauCeti.KacMoody.positiveSubalgebra`. -/
theorem positiveSubalgebra_def :
    positiveSubalgebra R =
      LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (positiveGenerator R)) := (rfl)

/-- Explicit `lieSpan` description of `TauCeti.KacMoody.negativeSubalgebra`. -/
theorem negativeSubalgebra_def :
    negativeSubalgebra R =
      LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (negativeGenerator R)) := (rfl)

@[simp]
theorem toSubmodule_cartanSubalgebra :
    (cartanSubalgebra R).toSubmodule = LinearMap.range (cartanElement R) := (rfl)

@[simp]
theorem mem_cartanSubalgebra_iff {z : PresentedLieAlgebra R} :
    z ∈ cartanSubalgebra R ↔ z ∈ LinearMap.range (cartanElement R) := Iff.rfl

@[simp]
theorem positiveGenerator_mem_positiveSubalgebra (i : I) :
    positiveGenerator R i ∈ positiveSubalgebra R :=
  LieSubalgebra.subset_lieSpan ⟨i, rfl⟩

@[simp]
theorem negativeGenerator_mem_negativeSubalgebra (i : I) :
    negativeGenerator R i ∈ negativeSubalgebra R :=
  LieSubalgebra.subset_lieSpan ⟨i, rfl⟩

/-- Every image of `H` under `cartanElement R` belongs to `cartanSubalgebra R`. -/
theorem cartanElement_mem_cartanSubalgebra (x : H) :
    cartanElement R x ∈ cartanSubalgebra R :=
  ⟨x, rfl⟩

instance : IsLieAbelian (cartanSubalgebra R) :=
  ⟨fun ⟨_, x, rfl⟩ ⟨_, y, rfl⟩ => Subtype.ext (lie_cartanElement_cartanElement R x y)⟩

/-- The Chevalley involution carries `n⁺` onto `n⁻`. -/
@[simp]
theorem map_chevalleyInvolution_positiveSubalgebra :
    (positiveSubalgebra R).map (chevalleyInvolution R : PresentedLieAlgebra R →ₗ⁅K⁆ _) =
      negativeSubalgebra R := by
  rw [positiveSubalgebra_def, negativeSubalgebra_def, LieSubalgebra.map_lieSpan, ← Set.range_comp]
  refine le_antisymm (LieSubalgebra.lieSpan_le.mpr ?_) (LieSubalgebra.lieSpan_le.mpr ?_)
  · rintro _ ⟨i, rfl⟩
    rw [Function.comp_apply, LieEquiv.coe_toLieHom, chevalleyInvolution_positiveGenerator]
    exact neg_mem (negativeGenerator_mem_negativeSubalgebra R i)
  · rintro _ ⟨i, rfl⟩
    have hmem : -negativeGenerator R i ∈
        LieSubalgebra.lieSpan K (PresentedLieAlgebra R)
          (Set.range ((chevalleyInvolution R : PresentedLieAlgebra R →ₗ⁅K⁆ _) ∘
            positiveGenerator R)) :=
      LieSubalgebra.subset_lieSpan ⟨i, chevalleyInvolution_positiveGenerator R i⟩
    simpa only [SetLike.mem_coe, neg_neg] using neg_mem hmem

/-- The Chevalley involution carries `n⁻` onto `n⁺`. -/
@[simp]
theorem map_chevalleyInvolution_negativeSubalgebra :
    (negativeSubalgebra R).map (chevalleyInvolution R : PresentedLieAlgebra R →ₗ⁅K⁆ _) =
      positiveSubalgebra R := by
  ext z
  rw [← map_chevalleyInvolution_positiveSubalgebra R]
  simp only [LieSubalgebra.mem_map, LieEquiv.coe_toLieHom]
  constructor
  · rintro ⟨y, ⟨x, hx, rfl⟩, rfl⟩
    simpa using hx
  · exact fun hz => ⟨chevalleyInvolution R z, ⟨z, hz, rfl⟩, chevalleyInvolution_apply_apply R z⟩

@[simp]
theorem range_positiveFreeLift : (positiveFreeLift R).range = positiveSubalgebra R := by
  rw [positiveSubalgebra_def, LieHom.range_eq_map, ← TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top,
    LieSubalgebra.map_lieSpan, ← Set.range_comp]
  congr 1
  ext i
  simp

@[simp]
theorem range_negativeFreeLift : (negativeFreeLift R).range = negativeSubalgebra R := by
  rw [negativeSubalgebra_def, LieHom.range_eq_map, ← TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top,
    LieSubalgebra.map_lieSpan, ← Set.range_comp]
  congr 1
  ext i
  simp

/-- Every vector in `R.cartanCenter` maps into the center of `PresentedLieAlgebra R`. -/
theorem cartanElement_mem_center_of_mem_cartanCenter {x : H} (hx : x ∈ R.cartanCenter) :
    cartanElement R x ∈ LieAlgebra.center K (PresentedLieAlgebra R) := by
  rw [R.mem_cartanCenter_iff] at hx
  rw [LieModule.mem_maxTrivSubmodule]
  intro z
  have hz : z ∈ LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (cartanElement R) ∪
      Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R)) := by
    rw [lieSpan_generators_eq_top]
    trivial
  induction hz using LieSubalgebra.lieSpan_induction with
  | mem y hy =>
    rcases hy with (⟨u, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
    · exact lie_cartanElement_cartanElement R u x
    · rw [← lie_skew, lie_cartanElement_positiveGenerator, hx i, zero_smul, neg_zero]
    · rw [← lie_skew, lie_cartanElement_negativeGenerator, hx i, zero_smul, neg_zero, neg_zero]
  | zero => simp
  | add _ _ _ _ h₁ h₂ => rw [add_lie, h₁, h₂, add_zero]
  | smul c _ _ h₁ => rw [smul_lie, h₁, smul_zero]
  | lie u v _ _ hu hv =>
    rw [← lie_skew _ (cartanElement R x), leibniz_lie, ← lie_skew (cartanElement R x) u,
      ← lie_skew (cartanElement R x) v, hu, hv]
    simp

end ArbitraryMatrix

/-! ## Cartan injectivity and Serre presentations of `n⁺` and `n⁻` -/

section GeneralizedCartan

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- **Cartan injectivity.** For a generalized Cartan matrix `A`, the canonical linear map
`TauCeti.KacMoody.cartanElement` from the ambient space `H` of the realization into
`PresentedLieAlgebra R` is injective. -/
theorem cartanElement_injective (hA : A.IsGeneralizedCartan) :
    Function.Injective (cartanElement R) := by
  refine (injective_iff_map_eq_zero (cartanElement R)).mpr fun x hx => ?_
  have h0 : negativeFreeLift R 0 + cartanElement R x + positiveFreeLift R 0 = 0 := by
    simpa using hx
  exact (negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff R hA |>.mp h0).2.1

@[simp]
theorem cartanElement_inj (hA : A.IsGeneralizedCartan) {x y : H} :
    cartanElement R x = cartanElement R y ↔ x = y :=
  (cartanElement_injective R hA).eq_iff

@[simp]
theorem cartanElement_eq_zero_iff (hA : A.IsGeneralizedCartan) {x : H} :
    cartanElement R x = 0 ↔ x = 0 :=
  map_eq_zero_iff (cartanElement R) (cartanElement_injective R hA)

/-- The ambient space `H` of the realization is linearly isomorphic to `cartanSubalgebra R`. -/
noncomputable def cartanEquiv (hA : A.IsGeneralizedCartan) :
    H ≃ₗ[K] cartanSubalgebra R :=
  LinearEquiv.ofInjective (cartanElement R) (cartanElement_injective R hA)

@[simp]
theorem coe_cartanEquiv_apply (hA : A.IsGeneralizedCartan) (x : H) :
    (cartanEquiv R hA x : PresentedLieAlgebra R) = cartanElement R x := (rfl)

/-- For a generalized Cartan matrix `A`, the kernel of `positiveFreeLift R` is precisely
`serreIdeal K A`. -/
theorem ker_positiveFreeLift (hA : A.IsGeneralizedCartan) :
    (positiveFreeLift R).ker = serreIdeal K A := by
  ext u
  rw [LieHom.mem_ker]
  have := negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff R hA
    (uF := 0) (x := 0) (uE := u)
  simpa using this

/-- For a generalized Cartan matrix `A`, the kernel of `negativeFreeLift R` is precisely
`serreIdeal K A`. -/
theorem ker_negativeFreeLift (hA : A.IsGeneralizedCartan) :
    (negativeFreeLift R).ker = serreIdeal K A := by
  ext u
  rw [LieHom.mem_ker]
  have := negativeFreeLift_add_cartanElement_add_positiveFreeLift_eq_zero_iff R hA
    (uF := u) (x := 0) (uE := 0)
  simpa using this

/-- **Presentation of `n⁺`.** For a generalized Cartan matrix `A`, `positiveSubalgebra R` is
canonically isomorphic to `FreeLieAlgebra K I ⧸ serreIdeal K A`, independently of the ambient
realization `(H, R)`. -/
noncomputable def positiveSubalgebraEquiv (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra K I ⧸ serreIdeal K A) ≃ₗ⁅K⁆ positiveSubalgebra R :=
  have hker : (positiveFreeLift R).rangeRestrict.ker = serreIdeal K A := by
    rw [← ker_positiveFreeLift R hA]
    ext u
    simp [LieHom.mem_ker, Subtype.ext_iff]
  ((serreIdeal K A).quotEquivOfEq _ hker.symm).trans <|
    ((positiveFreeLift R).rangeRestrict.quotKerEquivOfSurjective
      (positiveFreeLift R).surjective_rangeRestrict).trans <|
      LieEquiv.ofEq _ _ (congrArg SetLike.coe (range_positiveFreeLift R))

@[simp]
theorem coe_positiveSubalgebraEquiv_mk (hA : A.IsGeneralizedCartan) (u : FreeLieAlgebra K I) :
    (positiveSubalgebraEquiv R hA (LieSubmodule.Quotient.mk u) : PresentedLieAlgebra R) =
      positiveFreeLift R u := by
  simp [positiveSubalgebraEquiv]

/-- **Presentation of `n⁻`.** For a generalized Cartan matrix `A`, `negativeSubalgebra R` is
canonically isomorphic to `FreeLieAlgebra K I ⧸ serreIdeal K A`, independently of the ambient
realization `(H, R)`. -/
noncomputable def negativeSubalgebraEquiv (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra K I ⧸ serreIdeal K A) ≃ₗ⁅K⁆ negativeSubalgebra R :=
  have hker : (negativeFreeLift R).rangeRestrict.ker = serreIdeal K A := by
    rw [← ker_negativeFreeLift R hA]
    ext u
    simp [LieHom.mem_ker, Subtype.ext_iff]
  ((serreIdeal K A).quotEquivOfEq _ hker.symm).trans <|
    ((negativeFreeLift R).rangeRestrict.quotKerEquivOfSurjective
      (negativeFreeLift R).surjective_rangeRestrict).trans <|
      LieEquiv.ofEq _ _ (congrArg SetLike.coe (range_negativeFreeLift R))

@[simp]
theorem coe_negativeSubalgebraEquiv_mk (hA : A.IsGeneralizedCartan) (u : FreeLieAlgebra K I) :
    (negativeSubalgebraEquiv R hA (LieSubmodule.Quotient.mk u) : PresentedLieAlgebra R) =
      negativeFreeLift R u := by
  simp [negativeSubalgebraEquiv]

/-- Every raising generator `eᵢ` is nonzero in `PresentedLieAlgebra R` when `A` is a generalized
Cartan matrix. -/
theorem positiveGenerator_ne_zero (hA : A.IsGeneralizedCartan) (i : I) :
    positiveGenerator R i ≠ 0 := by
  classical
  let _ : LieRing K := LieRing.ofAssociativeRing
  let _ : LieAlgebra K K := LieAlgebra.ofAssociativeAlgebra
  let f : I → K := Pi.single i 1
  let π : FreeLieAlgebra K I →ₗ⁅K⁆ K := FreeLieAlgebra.lift K f
  have hker : serreIdeal K A ≤ π.ker :=
    serreIdeal_le_ker_lift_iff.mpr fun a b => by
      have hlie : ⁅f a, f b⁆ = 0 := by rw [Ring.lie_def, mul_comm, sub_self]
      rw [hlie, map_zero]
  intro h0
  have hmem : FreeLieAlgebra.of K i ∈ serreIdeal K A := by
    rw [← ker_positiveFreeLift R hA, LieHom.mem_ker, positiveFreeLift_of]
    exact h0
  have h1 : π (FreeLieAlgebra.of K i) = 0 := hker hmem
  simp [π, f] at h1

/-- Every lowering generator `fᵢ` is nonzero in `PresentedLieAlgebra R` when `A` is a generalized
Cartan matrix. -/
theorem negativeGenerator_ne_zero (hA : A.IsGeneralizedCartan) (i : I) :
    negativeGenerator R i ≠ 0 := by
  intro h0
  apply positiveGenerator_ne_zero R hA i
  have := congrArg (chevalleyInvolution R) h0
  simpa using this

/-- A Cartan element belongs to the center of `PresentedLieAlgebra R` if and only if its preimage
in `H` belongs to `R.cartanCenter`. -/
theorem cartanElement_mem_center_iff (hA : A.IsGeneralizedCartan) {x : H} :
    cartanElement R x ∈ LieAlgebra.center K (PresentedLieAlgebra R) ↔ x ∈ R.cartanCenter := by
  refine ⟨fun hx => (R.mem_cartanCenter_iff x).mpr fun i => ?_,
    cartanElement_mem_center_of_mem_cartanCenter R⟩
  have h0 : ⁅cartanElement R x, positiveGenerator R i⁆ = 0 := by
    rw [← lie_skew,
      (LieModule.mem_maxTrivSubmodule K (PresentedLieAlgebra R) (PresentedLieAlgebra R)
        (cartanElement R x)).mp hx (positiveGenerator R i),
      neg_zero]
  rw [lie_cartanElement_positiveGenerator, smul_eq_zero] at h0
  exact h0.resolve_right (positiveGenerator_ne_zero R hA i)

end GeneralizedCartan

end TauCeti.KacMoody
