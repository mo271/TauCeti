section ConjugateBreaks

variable (K L M : Type*)
  [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Field M] [ValuativeRel M] [TopologicalSpace M] [IsNonarchimedeanLocalField M]
  [Algebra K L] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
  [ValuativeExtension K L]

/-- The multiset of rational conjugate-difference valuations
`(v_M(σ α - α) - v_M(α)) / e(M/L)` as `σ` ranges over all `K`-embeddings `L →ₐ[K] M` distinct from
the canonical inclusion `IsScalarTower.toAlgHom K L M`. When `α` is a uniformizer of `L`, this
equals `v_M(σ α - α) / e(M/L) - 1`. -/
def conjugateBreaks (α : L) : Multiset ℚ := by
  classical
  haveI : Module.Finite K L := finite_of_valuativeExtension K L
  let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
  exact ((Finset.univ.erase incl : Finset (L →ₐ[K] M)).val).map fun σ ↦
    ((addValInt M (σ α - incl α) - addValInt M (incl α) : ℤ) : ℚ) / ramificationIndex L M

/-- Defining formula for `conjugateBreaks`. -/
theorem conjugateBreaks_def (α : L) :
    conjugateBreaks K L M α =
      (haveI : Module.Finite K L := finite_of_valuativeExtension K L
       open Classical in
       let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
       ((Finset.univ.erase incl : Finset (L →ₐ[K] M)).val).map fun σ ↦
         ((addValInt M (σ α - incl α) - addValInt M (incl α) : ℤ) : ℚ) /
           ramificationIndex L M) := by
  rw [conjugateBreaks]

variable {K L M} [ValuativeExtension L M]

/-- On a uniformizer `ξ : 𝒪[L]`, each entry of `conjugateBreaks K L M (ξ : L)` has the form
`v_M(σ ξ - ξ) / e(M/L) - 1`. -/
theorem conjugateBreaks_irreducible {ξ : 𝒪[L]} (hξ : Irreducible ξ) :
    conjugateBreaks K L M (ξ : L) =
      (haveI : Module.Finite K L := finite_of_valuativeExtension K L
       open Classical in
       let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
       ((Finset.univ.erase incl : Finset (L →ₐ[K] M)).val).map fun σ ↦
         (addValInt M (σ (ξ : L) - incl (ξ : L)) : ℚ) / ramificationIndex L M - 1) := by
  classical
  have : Module.Finite K L := finite_of_valuativeExtension K L
  let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
  have he0 : (ramificationIndex L M : ℚ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (ramificationIndex_pos (K := L) (L := M)).ne'
  rw [conjugateBreaks_def]
  refine Multiset.map_congr rfl fun σ _ ↦ ?_
  have hincl : addValInt M (incl (ξ : L)) = ramificationIndex L M := by
    rw [addValInt_algHom, addValInt_irreducible hξ, mul_one]
  rw [hincl, Int.cast_sub, Int.cast_natCast, sub_div, div_self he0]

/-- When `α` generates `L` over `K`, every break in `conjugateBreaks K L M α` is nonnegative. -/
theorem nonneg_of_mem_conjugateBreaks {α : L} (hgen : K⟮α⟯ = ⊤) {q : ℚ}
    (hq : q ∈ conjugateBreaks K L M α) : 0 ≤ q := by
  classical
  have : Module.Finite K L := finite_of_valuativeExtension K L
  let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
  rw [conjugateBreaks_def, Multiset.mem_map] at hq
  obtain ⟨σ, hσ, rfl⟩ := hq
  have hne : σ ≠ incl := (Finset.mem_erase.mp (Finset.mem_def.mpr hσ)).1
  rcases eq_or_ne α 0 with rfl | hα0
  · simp
  have hσα : σ α ≠ incl α := fun h ↦ hne <| by
    let pb : PowerBasis K L := .ofAdjoinSimpleEqTop (.of_finite K α) hgen
    exact pb.algHom_ext (by simpa [pb, PowerBasis.ofAdjoinSimpleEqTop_gen] using h)
  have hsub0 : σ α - incl α ≠ 0 := sub_ne_zero.mpr hσα
  have hincl0 : incl α ≠ 0 := (_root_.map_ne_zero incl).mpr hα0
  have hv_eq : normalizedAddValuation M (σ α) = normalizedAddValuation M (incl α) := by
    rw [normalizedAddValuation_algHom, normalizedAddValuation_algHom]
  have hmin : normalizedAddValuation M (incl α) ≤ normalizedAddValuation M (σ α - incl α) := by
    have h := (normalizedAddValuation M).map_sub (σ α) (incl α)
    rwa [hv_eq, min_self] at h
  rw [normalizedAddValuation_of_ne_zero hincl0, normalizedAddValuation_of_ne_zero hsub0,
    WithTop.coe_le_coe] at hmin
  have hint : addValInt M (incl α) ≤ addValInt M (σ α - incl α) := by exact_mod_cast hmin
  exact div_nonneg (by exact_mod_cast sub_nonneg.mpr hint) (Nat.cast_nonneg _)

omit [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
  [ValuativeExtension K L] [ValuativeExtension L M] in
private theorem addValInt_eq_of_normalizedAddValuation_eq {x y : M}
    (h : normalizedAddValuation M x = normalizedAddValuation M y) :
    addValInt M x = addValInt M y := by
  rcases eq_or_ne x 0 with rfl | hx
  · rw [AddValuation.map_zero, eq_comm, normalizedAddValuation_eq_top_iff] at h
    simp [h]
  · have hy : y ≠ 0 := fun hy0 ↦ by simp [hy0, hx] at h
    rw [normalizedAddValuation_of_ne_zero hx, normalizedAddValuation_of_ne_zero hy,
      WithTop.coe_eq_coe] at h
    exact_mod_cast h

private theorem normalizedAddValuation_sub_algHom_le_of_adjoin_eq_top {ξ : 𝒪[L]}
    (hadj : Algebra.adjoin 𝒪[K] {ξ} = ⊤) (y : 𝒪[L]) (σ τ : L →ₐ[K] M) :
    normalizedAddValuation M (σ (ξ : L) - τ (ξ : L)) ≤
      normalizedAddValuation M (σ (y : L) - τ (y : L)) := by
  let : ValuativeExtension K M := ValuativeExtension.trans K L M
  have hy : y ∈ (aeval (R := 𝒪[K]) ξ).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval, hadj]; trivial
  obtain ⟨P, rfl⟩ := hy
  have hintM (ρ : L →ₐ[K] M) (z : 𝒪[L]) : ρ (z : L) ∈ 𝒪[M] := by
    rw [mem_integer_iff_normalizedAddValuation_nonneg, normalizedAddValuation_algHom]
    have hz : 0 ≤ normalizedAddValuation L (z : L) :=
      mem_integer_iff_normalizedAddValuation_nonneg.mp z.2
    cases hv : normalizedAddValuation L (z : L) with
    | top => simp
    | coe v =>
      rw [hv, ← WithTop.coe_zero, WithTop.coe_le_coe] at hz
      rw [WithTop.map_coe, ← WithTop.coe_zero, WithTop.coe_le_coe]
      exact mul_nonneg (Nat.cast_nonneg _) hz
  set a : 𝒪[M] := ⟨σ (ξ : L), hintM σ ξ⟩
  set b : 𝒪[M] := ⟨τ (ξ : L), hintM τ ξ⟩
  set Q : 𝒪[M][X] := P.map (algebraMap 𝒪[K] 𝒪[M])
  have heval (ρ : L →ₐ[K] M) :
      ((Q.eval ⟨ρ (ξ : L), hintM ρ ξ⟩ : 𝒪[M]) : M) = ρ ((aeval ξ P : 𝒪[L]) : L) := by
    have h1 : ((aeval ξ P : 𝒪[L]) : L) = aeval (ξ : L) (P.map (algebraMap 𝒪[K] K)) := by
      have hcomp : (algebraMap 𝒪[L] L).comp (algebraMap 𝒪[K] 𝒪[L]) =
          (algebraMap K L).comp (algebraMap 𝒪[K] K) := by
        ext x; exact Valuation.HasExtension.val_algebraMap (vR := valuation K) (vA := valuation L) x
      simpa [aeval_def, eval₂_map, hcomp, Algebra.algebraMap_ofSubsemiring_apply] using
        hom_eval₂ P (algebraMap 𝒪[K] 𝒪[L]) (algebraMap 𝒪[L] L) ξ
    have h2 : ((Q.eval ⟨ρ (ξ : L), hintM ρ ξ⟩ : 𝒪[M]) : M) =
        aeval (ρ (ξ : L)) (P.map (algebraMap 𝒪[K] K)) := by
      have hcomp : (algebraMap 𝒪[M] M).comp (algebraMap 𝒪[K] 𝒪[M]) =
          (algebraMap K M).comp (algebraMap 𝒪[K] K) := by
        ext x; exact Valuation.HasExtension.val_algebraMap (vR := valuation K) (vA := valuation M) x
      simpa [Q, eval_map, aeval_def, eval₂_map, hcomp, Algebra.algebraMap_ofSubsemiring_apply] using
        hom_eval₂ P (algebraMap 𝒪[K] 𝒪[M]) (algebraMap 𝒪[M] M) ⟨ρ (ξ : L), hintM ρ ξ⟩
    rw [h1, h2, aeval_algHom_apply]
  obtain ⟨q, hq⟩ := sub_dvd_eval_sub a b Q
  have hqM : σ ((aeval ξ P : 𝒪[L]) : L) - τ ((aeval ξ P : 𝒪[L]) : L) =
      (σ (ξ : L) - τ (ξ : L)) * (q : M) := by
    have h := congrArg (Subring.subtype 𝒪[M]) hq
    simpa [a, b, heval σ, heval τ] using h
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hqM, AddValuation.map_mul]
  exact le_add_of_nonneg_right (mem_integer_iff_normalizedAddValuation_nonneg.mp q.2)

/-- **Uniformizer invariance of `conjugateBreaks`.** In a totally ramified extension `L/K`, any two
uniformizers `ξ, ξ' : 𝒪[L]` produce the exact same multiset `conjugateBreaks K L M`, over every
compatible local-field extension `M/L` (without any Galois or splitting assumption on `M`). -/
theorem IsTotallyRamified.conjugateBreaks_eq_of_irreducible (h : IsTotallyRamified K L)
    {ξ ξ' : 𝒪[L]} (hξ : Irreducible ξ) (hξ' : Irreducible ξ') :
    conjugateBreaks K L M (ξ : L) = conjugateBreaks K L M (ξ' : L) := by
  classical
  have : Module.Finite K L := finite_of_valuativeExtension K L
  rw [conjugateBreaks_irreducible hξ, conjugateBreaks_irreducible hξ']
  refine Multiset.map_congr rfl fun σ _ ↦ ?_
  have hv : normalizedAddValuation M (σ (ξ : L) - IsScalarTower.toAlgHom K L M (ξ : L)) =
      normalizedAddValuation M (σ (ξ' : L) - IsScalarTower.toAlgHom K L M (ξ' : L)) :=
    le_antisymm
      (normalizedAddValuation_sub_algHom_le_of_adjoin_eq_top
        (h.adjoin_eq_top_of_irreducible hξ) ξ' σ _)
      (normalizedAddValuation_sub_algHom_le_of_adjoin_eq_top
        (h.adjoin_eq_top_of_irreducible hξ') ξ σ _)
  rw [addValInt_eq_of_normalizedAddValuation_eq hv]

end ConjugateBreaks

end TauCeti

namespace Polynomial

open TauCeti

section Polygon

variable {K L M : Type*}
  [Field K] [ValuativeRel K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L]

/-- **The ramification polygon** of a polynomial `φ : 𝒪[K][X]` at `α : L`: the Newton polygon of
`φ.ramificationPolynomial α` with respect to `TauCeti.normalizedAddValuation L`. -/
def ramificationPolygon (φ : 𝒪[K][X]) (α : L) : ℕ → WithTop ℝ :=
  (φ.ramificationPolynomial α).newtonPolygon (normalizedAddValuation L)

/-- Defining formula for `ramificationPolygon`. -/
theorem ramificationPolygon_def (φ : 𝒪[K][X]) (α : L) :
    φ.ramificationPolygon α =
      (φ.ramificationPolynomial α).newtonPolygon (normalizedAddValuation L) := by
  rw [ramificationPolygon]

omit [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] in
/-- If `φ` splits over a field extension `M/L/K`, then `φ.ramificationPolynomial α` splits over
`M`. -/
theorem Splits.map_ramificationPolynomial [Field M] [Algebra K M] [Algebra L M]
    [IsScalarTower K L M] {φ : 𝒪[K][X]} (α : L)
    (hsplits : ((φ.map (algebraMap 𝒪[K] K)).map (algebraMap K M)).Splits) :
    ((φ.ramificationPolynomial α).map (algebraMap L M)).Splits := by
  have hmap : (φ.ramificationPolynomial α).map (algebraMap L M) =
      C (algebraMap L M (α⁻¹ ^ φ.natDegree)) *
        (((φ.map (algebraMap 𝒪[K] K)).map (algebraMap K M)).comp
          (C (algebraMap L M α) * X + C (algebraMap L M α))) := by
    rw [ramificationPolynomial_def, Polynomial.map_mul, map_C, Polynomial.map_comp,
      Polynomial.map_map, Polynomial.map_map,
      ← RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq K L M]
    simp
  rw [hmap]
  exact Splits.mul (Splits.C _) (hsplits.comp_of_natDegree_le_one (by compute_degree!))

variable [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension K L]

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- At an Eisenstein root `ξ : 𝒪[L]`, `φ.ramificationPolygon (ξ : L)` is `⊤` at index `0`. -/
theorem ramificationPolygon_zero {φ : 𝒪[K][X]} {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) :
    φ.ramificationPolygon (ξ : L) 0 = ⊤ := by
  have hrootK : aeval (ξ : L) (φ.map (algebraMap 𝒪[K] K)) = 0 := by
    have hcomp : (algebraMap K L).comp (algebraMap 𝒪[K] K) =
        (algebraMap 𝒪[L] L).comp (algebraMap 𝒪[K] 𝒪[L]) := by
      ext x
      exact (Valuation.HasExtension.val_algebraMap (vR := valuation K) (vA := valuation L) x).symm
    have h := congrArg (algebraMap 𝒪[L] L) hroot.eq_zero
    rw [eval_map, hom_eval₂, ← hcomp, ← eval₂_map, map_zero] at h
    simpa [aeval_def, Algebra.algebraMap_ofSubsemiring_apply] using h
  rw [ramificationPolygon_def, newtonPolygon_apply_zero,
    coeff_zero_ramificationPolynomial_of_aeval_eq_zero hrootK, AddValuation.map_zero]

/-- At an Eisenstein generator `ξ : 𝒪[L]`, every height of `φ.ramificationPolygon (ξ : L)` is
nonnegative. -/
theorem ramificationPolygon_nonneg {φ : 𝒪[K][X]} (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) (i : ℕ) :
    0 ≤ φ.ramificationPolygon (ξ : L) i := by
  have hle := le_newtonPolygon (f := φ.ramificationPolynomial (ξ : L))
    (v := normalizedAddValuation L) (isConvexSeq_affine 0 0) fun n ↦ by
      simpa using mem_integer_iff_normalizedAddValuation_nonneg.mp
        (coeff_ramificationPolynomial_mem_integer hφ hroot hgen n)
  simpa [ramificationPolygon_def] using hle i

/-- At an Eisenstein generator `ξ` of a separable extension `L/K`, the left endpoint of
`φ.ramificationPolygon (ξ : L)` is `(1, ramificationHeight K L)`. -/
theorem ramificationPolygon_one [Algebra.IsSeparable K L] {φ : 𝒪[K][X]}
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    φ.ramificationPolygon (ξ : L) 1 = ((ramificationHeight K L : ℝ) : WithTop ℝ) := by
  have ht := natTrailingDegree_ramificationPolynomial hφ hroot hgen
  rw [ramificationPolygon_def, ← ht, newtonPolygon_natTrailingDegree, trailingCoeff, ht,
    normalizedAddValuation_coeff_one_ramificationPolynomial hφ hroot hgen]

/-- For a monic Eisenstein generator `(φ, ξ)`, the right endpoint of
`φ.ramificationPolygon (ξ : L)` is `(φ.natDegree, 0)`. -/
theorem ramificationPolygon_natDegree {φ : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K])
    {ξ : 𝒪[L]} (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    φ.ramificationPolygon (ξ : L) φ.natDegree = 0 := by
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  rw [ramificationPolygon_def, ← natDegree_ramificationPolynomial hmon hξ0,
    newtonPolygon_natDegree, (hmon.ramificationPolynomial hξ0).leadingCoeff, AddValuation.map_one]

/-- For a monic Eisenstein generator `(φ, ξ)` of a separable extension `L/K`, the finite domain of
`φ.ramificationPolygon (ξ : L)` is `[1, φ.natDegree]`. -/
theorem ramificationPolygon_ne_top_iff [Algebra.IsSeparable K L] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {i : ℕ} :
    φ.ramificationPolygon (ξ : L) i ≠ ⊤ ↔ 1 ≤ i ∧ i ≤ φ.natDegree := by
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  rw [ramificationPolygon_def,
    newtonPolygon_ne_top_iff (normalizedAddValuation L)
      (fun _ ↦ normalizedAddValuation_eq_top_iff.mp)
      (hmon.ramificationPolynomial hξ0).ne_zero,
    natTrailingDegree_ramificationPolynomial hφ hroot hgen,
    natDegree_ramificationPolynomial hmon hξ0]

/-- For a monic Eisenstein generator `(φ, ξ)` of a separable extension `L/K`, the ramification
polynomial has `φ.natDegree - 1` finite Newton slopes. -/
theorem card_newtonSlopes_ramificationPolynomial [Algebra.IsSeparable K L] {φ : 𝒪[K][X]}
    (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    ((φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L)).card =
      φ.natDegree - 1 := by
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  rw [card_newtonSlopes _ _ (fun _ ↦ normalizedAddValuation_eq_top_iff.mp),
    natDegree_ramificationPolynomial hmon hξ0,
    natTrailingDegree_ramificationPolynomial hφ hroot hgen]

/-- The minimal polynomial over `K` of a root `ξ : 𝒪[L]` of a monic Eisenstein polynomial
`φ : 𝒪[K][X]` is `φ.map (algebraMap 𝒪[K] K)`. -/
theorem minpoly_eq_map_of_monic_eisenstein {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) :
    minpoly K (ξ : L) = φ.map (algebraMap 𝒪[K] K) := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  have hint : IsIntegral 𝒪[K] ξ := IsIntegral.of_finite 𝒪[K] ξ
  have hmin : minpoly K (ξ : L) = (minpoly 𝒪[K] ξ).map (algebraMap 𝒪[K] K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions K L hint
  rw [hmin, eq_of_monic_of_associated (minpoly.monic hint) hmon
    (hφ.associated_minpoly hφ.isUnit_leadingCoeff hroot)]

private theorem roots_map_ramificationPolynomial_filter_ne_zero [Algebra.IsSeparable K L]
    [Field M] [Algebra K M] [Algebra L M] [IsScalarTower K L M] [DecidableEq M]
    {φ : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    (((φ.ramificationPolynomial (ξ : L)).map (algebraMap L M)).roots.filter (· ≠ 0)) =
      (haveI : Module.Finite K L := finite_of_valuativeExtension K L
       open Classical in
       let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
       ((Finset.univ.erase incl : Finset (L →ₐ[K] M)).val).map fun σ ↦
         (σ (ξ : L) - incl (ξ : L)) / incl (ξ : L)) := by
  classical
  have : Module.Finite K L := finite_of_valuativeExtension K L
  let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  have ha0 : incl (ξ : L) ≠ 0 := (_root_.map_ne_zero incl).mpr hξ0
  have hmin : minpoly K (ξ : L) = φ.map (algebraMap 𝒪[K] K) :=
    minpoly_eq_map_of_monic_eisenstein hmon hφ hroot
  let pb : PowerBasis K L := .ofAdjoinSimpleEqTop (.of_finite K (ξ : L)) hgen
  have hpb : pb.gen = (ξ : L) := PowerBasis.ofAdjoinSimpleEqTop_gen _ hgen
  have hsep : (φ.map (algebraMap 𝒪[K] K)).Separable :=
    hmin ▸ Algebra.IsSeparable.isSeparable K (ξ : L)
  have hnodup₁ : (((φ.ramificationPolynomial (ξ : L)).map
      (algebraMap L M)).roots.filter (· ≠ 0)).Nodup :=
    (nodup_roots (hsep.ramificationPolynomial hξ0).map).filter _
  have hinj : Function.Injective (fun σ : L →ₐ[K] M ↦ (σ (ξ : L) - incl (ξ : L)) / incl (ξ : L)) :=
    fun σ₁ σ₂ h ↦ pb.algHom_ext <| by
      have hsub := (div_left_inj₀ ha0).mp h
      rw [hpb]; exact sub_left_injective hsub
  have hnodup₂ : (((Finset.univ.erase incl : Finset (L →ₐ[K] M)).val).map fun σ ↦
      (σ (ξ : L) - incl (ξ : L)) / incl (ξ : L)).Nodup :=
    (Finset.nodup _).map hinj
  refine (hnodup₁.ext hnodup₂).mpr fun z ↦ ?_
  rw [Multiset.mem_filter,
    mem_roots_map (hmon.ramificationPolynomial hξ0).ne_zero,
    ← aeval_def (R := L), aeval_ramificationPolynomial_eq_zero_iff hξ0, ← hmin]
  simp only [Multiset.mem_map, Finset.mem_val, Finset.mem_erase, Finset.mem_univ, and_true]
  refine ⟨fun ⟨hz, hzne⟩ ↦ ?_, fun ⟨σ, hσ, h⟩ ↦ ?_⟩
  · let σ : L →ₐ[K] M := pb.lift (incl (ξ : L) * z + incl (ξ : L)) (hpb.symm ▸ hz)
    have hσgen : σ (ξ : L) = incl (ξ : L) * z + incl (ξ : L) := by
      simpa [σ, hpb] using pb.lift_gen (incl (ξ : L) * z + incl (ξ : L)) (hpb.symm ▸ hz)
    refine ⟨σ, fun h_eq ↦ hzne ?_, ?_⟩
    · rw [h_eq] at hσgen
      apply mul_left_cancel₀ ha0
      linear_combination -hσgen
    · rw [hσgen, add_sub_cancel_right, mul_div_cancel_left₀ _ ha0]
  · subst h
    have hσξ : σ (ξ : L) ≠ incl (ξ : L) := fun h ↦ hσ (pb.algHom_ext (by simpa [hpb] using h))
    refine ⟨?_, div_ne_zero (sub_ne_zero.mpr hσξ) ha0⟩
    have haeval : aeval (σ (ξ : L)) (minpoly K (ξ : L)) = 0 := by
      rw [aeval_algHom_apply, minpoly.aeval, map_zero]
    change aeval (incl (ξ : L) * ((σ (ξ : L) - incl (ξ : L)) / incl (ξ : L)) + incl (ξ : L))
      (minpoly K (ξ : L)) = 0
    rwa [mul_div_cancel₀ _ ha0, sub_add_cancel]

/-- **Bridge between Newton slopes and `conjugateBreaks`.** Over any compatible local-field
extension `M/L/K` in which `φ` splits, the finite Newton slopes of
`φ.ramificationPolynomial (ξ : L)` equal the negated rational breaks in
`conjugateBreaks K L M (ξ : L)`. -/
theorem newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks [Algebra.IsSeparable K L]
    [Field M] [ValuativeRel M] [TopologicalSpace M] [IsNonarchimedeanLocalField M]
    [Algebra K M] [Algebra L M] [IsScalarTower K L M] [ValuativeExtension L M]
    {φ : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hsplits : ((φ.map (algebraMap 𝒪[K] K)).map (algebraMap K M)).Splits) :
    (φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L) =
      (conjugateBreaks K L M (ξ : L)).map fun q : ℚ ↦ -(q : ℝ) := by
  classical
  have : Module.Finite K L := finite_of_valuativeExtension K L
  let incl : L →ₐ[K] M := IsScalarTower.toAlgHom K L M
  have hc : (0 : ℝ) < ramificationIndex L M :=
    Nat.cast_pos.mpr (ramificationIndex_pos (K := L) (L := M))
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  have ha0 : incl (ξ : L) ≠ 0 := (_root_.map_ne_zero incl).mpr hξ0
  apply Multiset.map_injective (mul_right_injective₀ hc.ne')
  rw [← newtonSlopes_map_eq_map_mul (φ.ramificationPolynomial (ξ : L)) (normalizedAddValuation L)
      (algebraMap L M) hc normalizedAddValuation_algebraMap,
    newtonSlopes_eq_map_roots (fun _ ↦ normalizedAddValuation_eq_top_iff.mp)
      (Splits.map_ramificationPolynomial (ξ : L) hsplits),
    roots_map_ramificationPolynomial_filter_ne_zero hmon hφ hroot hgen,
    conjugateBreaks_def, Multiset.map_map, Multiset.map_map, Multiset.map_map]
  refine Multiset.map_congr rfl fun σ hσ ↦ ?_
  have hσne : σ ≠ incl := (Finset.mem_erase.mp (Finset.mem_def.mpr hσ)).1
  let pb : PowerBasis K L := .ofAdjoinSimpleEqTop (.of_finite K (ξ : L)) hgen
  have hsub0 : σ (ξ : L) - incl (ξ : L) ≠ 0 := sub_ne_zero.mpr fun h ↦ hσne <|
    pb.algHom_ext (by simpa [pb, PowerBasis.ofAdjoinSimpleEqTop_gen] using h)
  have hdiv0 : (σ (ξ : L) - incl (ξ : L)) / incl (ξ : L) ≠ 0 := div_ne_zero hsub0 ha0
  dsimp only [incl] at ha0 hsub0 hdiv0
  simp only [Function.comp_apply, normalizedAddValuation_of_ne_zero hdiv0,
    addValInt_div hsub0 ha0, WithTop.untop₀_coe]
  push_cast
  field_simp [hc.ne']

/-- Specialization of `newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks` to a normal
extension `M/K`. -/
theorem newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks_of_normal
    [Algebra.IsSeparable K L] [Field M] [ValuativeRel M] [TopologicalSpace M]
    [IsNonarchimedeanLocalField M] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
    [ValuativeExtension L M] [Normal K M] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    (φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L) =
      (conjugateBreaks K L M (ξ : L)).map fun q : ℚ ↦ -(q : ℝ) := by
  refine newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks hmon hφ hroot hgen ?_
  rw [← minpoly_eq_map_of_monic_eisenstein hmon hφ hroot,
    ← minpoly.algebraMap_eq (IsScalarTower.toAlgHom K L M).injective (ξ : L)]
  exact Normal.splits' (F := K) (algebraMap L M (ξ : L))

omit [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Algebra K L] [ValuativeExtension K L] in
private theorem newtonPolygon_eq_of_trailing_and_slopes {f g : L[X]} (hf0 : f ≠ 0) (hg0 : g ≠ 0)
    (htr : f.natTrailingDegree = g.natTrailingDegree)
    (hinit : f.newtonPolygon (normalizedAddValuation L) f.natTrailingDegree =
      g.newtonPolygon (normalizedAddValuation L) g.natTrailingDegree)
    (hslopes : f.newtonSlopes (normalizedAddValuation L) =
      g.newtonSlopes (normalizedAddValuation L)) :
    f.newtonPolygon (normalizedAddValuation L) = g.newtonPolygon (normalizedAddValuation L) := by
  set v := normalizedAddValuation L
  have hv : ∀ x : L, v x = ⊤ → x = 0 := fun _ ↦ normalizedAddValuation_eq_top_iff.mp
  have hdom (p : L[X]) (hp : p ≠ 0) (n : ℕ) : p.newtonPolygon v n ≠ ⊤ ↔
      p.natTrailingDegree ≤ n ∧ n ≤ p.natTrailingDegree + (p.natDegree - p.natTrailingDegree) := by
    rw [newtonPolygon_ne_top_iff v hv hp]
    have := natTrailingDegree_le_natDegree p; omega
  let df := FiniteSlopeData.ofIsConvexSeq (f.isConvexSeq_newtonPolygon v) (hdom f hf0)
  let dg := FiniteSlopeData.ofIsConvexSeq (g.isConvexSeq_newtonPolygon v) (hdom g hg0)
  have hdf : df.heights = f.newtonPolygon v := FiniteSlopeData.heights_ofIsConvexSeq _ _
  have hdg : dg.heights = g.newtonPolygon v := FiniteSlopeData.heights_ofIsConvexSeq _ _
  rw [← hdf, ← hdg]
  congr 1
  refine FiniteSlopeData.eq_of_slopeMultiset_eq ?_ ?_ ?_
  · simp [df, dg, htr]
  · have h1 : ((df.initialHeight : ℝ) : WithTop ℝ) = f.newtonPolygon v f.natTrailingDegree := by
      rw [← hdf, ← FiniteSlopeData.ofIsConvexSeq_start
        (f.isConvexSeq_newtonPolygon v) (hdom f hf0), df.heights_start]
    have h2 : ((dg.initialHeight : ℝ) : WithTop ℝ) = g.newtonPolygon v g.natTrailingDegree := by
      rw [← hdg, ← FiniteSlopeData.ofIsConvexSeq_start
        (g.isConvexSeq_newtonPolygon v) (hdom g hg0), dg.heights_start]
    exact WithTop.coe_injective (h1.trans (hinit.trans h2.symm))
  · rw [← newtonSlopes_eq_slopeMultiset hdf, ← newtonSlopes_eq_slopeMultiset hdg, hslopes]

/-- **Independence of the ramification polygon.** In a separable extension `L/K`, any two monic
Eisenstein polynomials `φ, φ' : 𝒪[K][X]` with roots `ξ, ξ' : 𝒪[L]` generating `L/K` have the exact
same ramification polygon. -/
theorem ramificationPolygon_eq_of_eisenstein_adjoin_eq_top [Algebra.IsSeparable K L]
    {φ φ' : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hmon' : φ'.Monic) (hφ' : φ'.IsEisensteinAt 𝓂[K]) {ξ' : 𝒪[L]}
    (hroot' : (φ'.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ') (hgen' : K⟮(ξ' : L)⟯ = ⊤) :
    φ.ramificationPolygon (ξ : L) = φ'.ramificationPolygon (ξ' : L) := by
  let pK : K[X] := φ.map (algebraMap 𝒪[K] K)
  let pK' : K[X] := φ'.map (algebraMap 𝒪[K] K)
  let fL : L[X] := (pK * pK').map (algebraMap K L)
  let M := fL.SplittingField
  let : ValuativeRel M := algebraicExtensionValuativeRel L M
  let : TopologicalSpace M := algebraicExtensionNormedFieldTopology L M
  have : IsNonarchimedeanLocalField M := finiteExtension_isNonarchimedeanLocalField L M
  have : ValuativeExtension L M := algebraicExtension_valuativeExtension L M
  have heq : fL.map (algebraMap L M) = pK.map (algebraMap K M) * pK'.map (algebraMap K M) := by
    change ((pK * pK').map (algebraMap K L)).map (algebraMap L M) = _
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq K L M]
    exact Polynomial.map_mul (algebraMap K M)
  have hsp := Eq.mp (congrArg Polynomial.Splits heq) (SplittingField.splits fL)
  obtain ⟨hsp₁, hsp₂⟩ := (splits_mul (map_monic_ne_zero (hmon.map _))
    (map_monic_ne_zero (hmon'.map _))).mp hsp
  have hξirr := irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hξ'irr := irreducible_of_eisenstein_adjoin_eq_top φ' hφ' ξ' hroot' hgen'
  have htr := isTotallyRamified_of_eisenstein_adjoin_eq_top hφ hroot hgen
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦ hξirr.ne_zero (Subtype.ext h)
  have hξ'0 : (ξ' : L) ≠ 0 := fun h ↦ hξ'irr.ne_zero (Subtype.ext h)
  have ht₁ := natTrailingDegree_ramificationPolynomial hφ hroot hgen
  have ht₂ := natTrailingDegree_ramificationPolynomial hφ' hroot' hgen'
  refine newtonPolygon_eq_of_trailing_and_slopes (hmon.ramificationPolynomial hξ0).ne_zero
    (hmon'.ramificationPolynomial hξ'0).ne_zero (ht₁.trans ht₂.symm) ?_ ?_
  · rw [ht₁, ht₂, ← ramificationPolygon_def, ← ramificationPolygon_def,
      ramificationPolygon_one hφ hroot hgen, ramificationPolygon_one hφ' hroot' hgen']
  · rw [newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks (M := M) hmon hφ hroot hgen hsp₁,
      newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks (M := M)
        hmon' hφ' hroot' hgen' hsp₂,
      htr.conjugateBreaks_eq_of_irreducible hξirr hξ'irr]

/-- Any two uniformizers `ξ, ξ' : 𝒪[L]` of a totally ramified separable extension `L/K` give the
same ramification polygon via their minimal polynomials over `𝒪[K]`. -/
theorem _root_.TauCeti.IsTotallyRamified.ramificationPolygon_minpoly_eq_of_irreducible
    [Algebra.IsSeparable K L] (h : IsTotallyRamified K L) {ξ ξ' : 𝒪[L]}
    (hξ : Irreducible ξ) (hξ' : Irreducible ξ') :
    (minpoly 𝒪[K] ξ).ramificationPolygon (ξ : L) =
      (minpoly 𝒪[K] ξ').ramificationPolygon (ξ' : L) := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  have hroot (ϖ : 𝒪[L]) : ((minpoly 𝒪[K] ϖ).map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ϖ := by
    rw [IsRoot, eval_map, ← aeval_def, minpoly.aeval]
  have hK (ϖ : 𝒪[L]) (hϖ : Irreducible ϖ) : K⟮(ϖ : L)⟯ = ⊤ := by
    simpa [Algebra.algebraMap_ofSubsemiring_apply] using
      IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (K := K) (L := L)
        (h.adjoin_eq_top_of_irreducible hϖ)
  exact ramificationPolygon_eq_of_eisenstein_adjoin_eq_top
    (minpoly.monic (.of_finite 𝒪[K] ξ)) (h.isEisensteinAt_minpoly hξ) (hroot ξ) (hK ξ hξ)
    (minpoly.monic (.of_finite 𝒪[K] ξ')) (h.isEisensteinAt_minpoly hξ') (hroot ξ') (hK ξ' hξ')

end Polygon

section Vertices

variable {K L M : Type*}
  [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L]

/-- At `p ^ w` (`p = ringChar 𝓀[K]`, `w = wildRamificationExponent K L`), the ramification polygon
of a monic Eisenstein generator `(φ, ξ)` reaches height `0`. -/
theorem ramificationPolygon_pow_wildRamificationExponent {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    φ.ramificationPolygon (ξ : L) (ringChar 𝓀[K] ^ wildRamificationExponent K L) = 0 :=
  le_antisymm
    ((newtonPolygon_le (φ.ramificationPolynomial (ξ : L)) (normalizedAddValuation L) _).trans_eq
      (normalizedAddValuation_coeff_pow_wildRamificationExponent_ramificationPolynomial
        hmon hφ hroot hgen))
    (ramificationPolygon_nonneg hφ hroot hgen _)

/-- **The tame flat segment.** On `[p ^ w, deg φ]`, the ramification polygon of a monic Eisenstein
generator `(φ, ξ)` vanishes identically. -/
theorem ramificationPolygon_eq_zero_of_mem_Icc {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {i : ℕ}
    (hlo : ringChar 𝓀[K] ^ wildRamificationExponent K L ≤ i) (hhi : i ≤ φ.natDegree) :
    φ.ramificationPolygon (ξ : L) i = 0 := by
  set N := φ.ramificationPolygon (ξ : L)
  set pw := ringChar 𝓀[K] ^ wildRamificationExponent K L
  have hconv : IsConvexSeq N := (φ.ramificationPolynomial (ξ : L)).isConvexSeq_newtonPolygon _
  have hpw : N pw = 0 := ramificationPolygon_pow_wildRamificationExponent hmon hφ hroot hgen
  have hn : N φ.natDegree = 0 := ramificationPolygon_natDegree hmon hφ hroot hgen
  refine le_antisymm ?_ (ramificationPolygon_nonneg hφ hroot hgen i)
  rcases eq_or_lt_of_le (hlo.trans hhi) with h_eq | hlt
  · obtain rfl : i = pw := by omega
    exact hpw.le
  have hi_ne : N i ≠ ⊤ := hconv.ne_top_of_le_of_le (by simp [hpw]) (by simp [hn]) hlo hhi
  rw [← WithTop.coe_untop₀_of_ne_top hi_ne, ← WithTop.coe_zero, WithTop.coe_le_coe]
  have hchord := hconv.chord_inequality (by simp [hpw]) (by simp [hn]) hlo hhi
  simp only [hpw, hn, WithTop.untop₀_zero, mul_zero, add_zero] at hchord
  have hd : (0 : ℝ) < (φ.natDegree : ℝ) - pw := sub_pos.mpr (by exact_mod_cast hlt)
  nlinarith

/-- Before `p ^ w`, every height `φ.ramificationPolygon (ξ : L) i` (`1 ≤ i < p ^ w`) is strictly
positive. -/
theorem ramificationPolygon_pos_of_lt_pow_wildRamificationExponent {φ : 𝒪[K][X]}
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {i : ℕ}
    (hi1 : 1 ≤ i) (hiw : i < ringChar 𝓀[K] ^ wildRamificationExponent K L) :
    0 < φ.ramificationPolygon (ξ : L) i := by
  set pw := ringChar 𝓀[K] ^ wildRamificationExponent K L
  have hpw_pos : (0 : ℝ) < pw := Nat.cast_pos.mpr (by omega)
  let H : ℕ → WithTop ℝ := fun k ↦ ((1 + (-(1 / (pw : ℝ))) * k : ℝ) : WithTop ℝ)
  have hle : H ≤ φ.ramificationPolygon (ξ : L) := by
    refine le_newtonPolygon (isConvexSeq_affine _ _) fun k ↦ ?_
    rcases eq_or_ne k 0 with rfl | hk0
    · rw [← newtonPolygon_apply_zero (φ.ramificationPolynomial (ξ : L)) (normalizedAddValuation L),
        ← ramificationPolygon_def, ramificationPolygon_zero hroot]
      exact le_top
    rcases lt_or_ge k pw with hlt | hge
    · refine (WithTop.coe_le_coe.mpr ?_).trans
        (one_le_normalizedAddValuation_coeff_ramificationPolynomial hφ hroot hgen
          (Nat.one_le_iff_ne_zero.mpr hk0) hlt)
      have hk_pos : (0 : ℝ) < k := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hk0)
      have hdiv : (0 : ℝ) < k / pw := div_pos hk_pos hpw_pos
      linarith [show (-(1 / (pw : ℝ))) * k = -(k / (pw : ℝ)) by ring]
    · refine (WithTop.coe_le_coe.mpr ?_).trans
        (mem_integer_iff_normalizedAddValuation_nonneg.mp
          (coeff_ramificationPolynomial_mem_integer hφ hroot hgen k))
      have hk_ge : (pw : ℝ) ≤ k := by exact_mod_cast hge
      have hdiv : 1 ≤ (k : ℝ) / pw := (one_le_div hpw_pos).mpr hk_ge
      linarith [show (-(1 / (pw : ℝ))) * k = -(k / (pw : ℝ)) by ring]
  refine lt_of_lt_of_le ?_ (hle i)
  rw [← WithTop.coe_zero, WithTop.coe_lt_coe]
  have hi_lt : (i : ℝ) < pw := by exact_mod_cast hiw
  have hdiv : (i : ℝ) / pw < 1 := (div_lt_one hpw_pos).mpr hi_lt
  linarith [show (-(1 / (pw : ℝ))) * i = -(i / (pw : ℝ)) by ring]

/-- `[p ^ w, deg φ]` is the finite face of slope `0` of `φ.ramificationPolygon (ξ : L)`. -/
theorem isFiniteFace_ramificationPolygon_zero {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    IsFiniteFace (φ.ramificationPolygon (ξ : L)) 0
      (ringChar 𝓀[K] ^ wildRamificationExponent K L) φ.natDegree := by
  set pw := ringChar 𝓀[K] ^ wildRamificationExponent K L
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : pw ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  refine isFiniteFace_iff.mpr
    ⟨hle_n, 0, isSupportingLine_iff_forall.mpr fun k ↦ by
      simpa using ramificationPolygon_nonneg hφ hroot hgen k, ?_⟩
  ext k
  simp only [mem_supportingFace, zero_mul, add_zero, WithTop.coe_zero, Set.mem_Icc]
  refine ⟨fun hk ↦ ?_,
    fun ⟨h₁, h₂⟩ ↦ ramificationPolygon_eq_zero_of_mem_Icc hmon hφ hroot hgen h₁ h₂⟩
  rcases eq_or_ne k 0 with rfl | hk0
  · rw [ramificationPolygon_zero hroot] at hk; exact absurd hk WithTop.top_ne_zero
  refine ⟨not_lt.mp fun hlt ↦ ?_, not_lt.mp fun hgt ↦ ?_⟩
  · exact (ramificationPolygon_pos_of_lt_pow_wildRamificationExponent hφ hroot hgen
      (Nat.one_le_iff_ne_zero.mpr hk0) hlt).ne' hk
  · have hξ0 : (ξ : L) ≠ 0 := fun h ↦
      (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
    have htop := newtonPolygon_eq_top_of_natDegree_lt (φ.ramificationPolynomial (ξ : L))
      (normalizedAddValuation L) ((natDegree_ramificationPolynomial hmon hξ0).trans_lt hgt)
    rw [ramificationPolygon_def, htop] at hk
    exact WithTop.top_ne_zero hk

/-- Slope `0` occurs with multiplicity `deg φ - p ^ w` in the Newton slopes of
`φ.ramificationPolynomial (ξ : L)`. -/
theorem count_zero_newtonSlopes_ramificationPolynomial {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    ((φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L)).count 0 =
      φ.natDegree - ringChar 𝓀[K] ^ wildRamificationExponent K L :=
  count_newtonSlopes_of_isFiniteFace (isFiniteFace_ramificationPolygon_zero hmon hφ hroot hgen)

/-- **Count of zero conjugate breaks.** Over any normal local-field extension `M/K` containing a
totally ramified separable extension `L/K`, exactly `[L : K] - p ^ w` conjugate breaks of a
uniformizer `ξ : 𝒪[L]` equal `0`. -/
theorem _root_.TauCeti.IsTotallyRamified.card_filter_conjugateBreaks_eq_zero
    [Algebra.IsSeparable K L] [Field M] [ValuativeRel M] [TopologicalSpace M]
    [IsNonarchimedeanLocalField M] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
    [ValuativeExtension L M] [Normal K M] (h : IsTotallyRamified K L) {ξ : 𝒪[L]}
    (hξ : Irreducible ξ) :
    ((conjugateBreaks K L M (ξ : L)).filter (· = 0)).card =
      Module.finrank K L - ringChar 𝓀[K] ^ wildRamificationExponent K L := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  set φ := minpoly 𝒪[K] ξ
  have hmon : φ.Monic := minpoly.monic (.of_finite 𝒪[K] ξ)
  have hφ : φ.IsEisensteinAt 𝓂[K] := h.isEisensteinAt_minpoly hξ
  have hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ := by
    rw [IsRoot, eval_map, ← aeval_def, minpoly.aeval]
  have hgen : K⟮(ξ : L)⟯ = ⊤ := by
    simpa [Algebra.algebraMap_ofSubsemiring_apply] using
      IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (K := K) (L := L)
        (h.adjoin_eq_top_of_irreducible hξ)
  have hdeg : φ.natDegree = Module.finrank K L := by
    rw [← (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).mp h,
      ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen]
  have hcnt := count_zero_newtonSlopes_ramificationPolynomial hmon hφ hroot hgen
  rw [newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks_of_normal (M := M)
    hmon hφ hroot hgen, hdeg, Multiset.count_eq_card_filter_eq, Multiset.filter_map,
    Multiset.card_map] at hcnt
  rw [← hcnt]
  exact congrArg Multiset.card
    (Multiset.filter_congr fun q _ ↦ by simp [eq_comm (a := (0 : ℝ))])

private theorem unitSlope_ramificationPolygon_neg [Algebra.IsSeparable K L] {φ : 𝒪[K][X]}
    (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {i : ℕ}
    (hi1 : 1 ≤ i) (hiw : i < ringChar 𝓀[K] ^ wildRamificationExponent K L) :
    unitSlope (φ.ramificationPolygon (ξ : L)) i < 0 := by
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : ringChar 𝓀[K] ^ wildRamificationExponent K L ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  have hedge : i ∈ finiteEdges (φ.ramificationPolygon (ξ : L)) :=
    mem_finiteEdges.mpr
      ⟨(ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr ⟨hi1, hiw.le.trans hle_n⟩,
        (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr ⟨by omega, hiw.trans_le hle_n⟩⟩
  exact (isFiniteFace_ramificationPolygon_zero hmon hφ hroot hgen).unitSlope_lt
    ((φ.ramificationPolynomial (ξ : L)).isConvexSeq_newtonPolygon _) hedge hiw

/-- **Vertices occur only at powers of `p`.** For every `r < wildRamificationExponent K L`, the unit
slope of `φ.ramificationPolygon (ξ : L)` is constant across `[p ^ r, p ^ (r + 1))`. -/
theorem unitSlope_ramificationPolygon_eq_of_mem_Ico [Algebra.IsSeparable K L] {φ : 𝒪[K][X]}
    (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {r i : ℕ}
    (hr : r < wildRamificationExponent K L) (hri : ringChar 𝓀[K] ^ r ≤ i)
    (hir : i < ringChar 𝓀[K] ^ (r + 1)) :
    unitSlope (φ.ramificationPolygon (ξ : L)) i =
      unitSlope (φ.ramificationPolygon (ξ : L)) (ringChar 𝓀[K] ^ r) := by
  set p := ringChar 𝓀[K]
  set N := φ.ramificationPolygon (ξ : L)
  have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
  have hp1 : 1 ≤ p ^ r := one_le_pow₀ hp.one_le
  have hpw : p ^ (r + 1) ≤ p ^ wildRamificationExponent K L :=
    Nat.pow_le_pow_right hp.pos hr
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : p ^ wildRamificationExponent K L ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  induction i, hri using Nat.le_induction with
  | base => rfl
  | succ k hkr ih =>
    have hstep : unitSlope N k = unitSlope N (k + 1) := by
      have hk1_ne : N (k + 1) ≠ ⊤ := (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr
        ⟨by omega, hir.le.trans (hpw.trans hle_n)⟩
      have hpr_ne : N (p ^ r) ≠ ⊤ := (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr
        ⟨hp1, (hkr.trans (Nat.le_succ k)).trans (hir.le.trans (hpw.trans hle_n))⟩
      have hlt_pr : N (k + 1) < N (p ^ r) := by
        conv_rhs => rw [← WithTop.coe_untop₀_of_ne_top hpr_ne]
        rw [eq_coe_add_sum_unitSlope hk1_ne (Nat.le_succ_of_le hkr), WithTop.coe_lt_coe]
        have hneg : ∑ m ∈ Finset.Ico (p ^ r) (k + 1), unitSlope N m < 0 :=
          Finset.sum_neg (fun m hm ↦ unitSlope_ramificationPolygon_neg hmon hφ hroot hgen
            (hp1.trans (Finset.mem_Ico.mp hm).1)
            ((Finset.mem_Ico.mp hm).2.trans (hir.trans_le hpw)))
            (Finset.nonempty_Ico.mpr (Nat.lt_succ_of_le hkr))
        linarith
      have hlt_coeff : N (k + 1) <
          normalizedAddValuation L ((φ.ramificationPolynomial (ξ : L)).coeff (k + 1)) :=
        hlt_pr.trans_le ((newtonPolygon_le (φ.ramificationPolynomial (ξ : L))
          (normalizedAddValuation L) (p ^ r)).trans
          (normalizedAddValuation_coeff_pow_le_ramificationPolynomial hφ hroot hgen
            (Nat.le_succ_of_le hkr) hir))
      have hconv := (φ.ramificationPolynomial (ξ : L)).isLowerConvexEnvelope_newtonPolygon
        (normalizedAddValuation L)
      simpa only [N, ramificationPolygon_def] using
        hconv.unitSlope_eq_of_lt (by simpa only [N, ramificationPolygon_def] using hlt_coeff)
    exact hstep.symm.trans (ih (Nat.lt_of_succ_lt hir))

end Vertices

section Rams

variable {K L M : Type*}
  [Field K] [ValuativeRel K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L]

/-- The rational height of `φ.ramificationPolygon α` at index `m` (`0` when the height is `⊤`). -/
def ramificationPolygonRat (φ : 𝒪[K][X]) (α : L) (m : ℕ) : ℚ := by
  classical
  exact if h : ∃ q : ℚ, φ.ramificationPolygon α m = ((q : ℝ) : WithTop ℝ) then h.choose else 0

/-- Defining formula for `ramificationPolygonRat`. -/
theorem ramificationPolygonRat_def (φ : 𝒪[K][X]) (α : L) (m : ℕ) :
    φ.ramificationPolygonRat α m =
      (open Classical in
       if h : ∃ q : ℚ, φ.ramificationPolygon α m = ((q : ℝ) : WithTop ℝ) then h.choose else 0) := by
  rw [ramificationPolygonRat]

/-- At any finite index `m`, `φ.ramificationPolygonRat α m` casts back to
`φ.ramificationPolygon α m`. -/
theorem coe_ramificationPolygonRat {φ : 𝒪[K][X]} {α : L} {m : ℕ}
    (hm : φ.ramificationPolygon α m ≠ ⊤) :
    (((φ.ramificationPolygonRat α m : ℚ) : ℝ) : WithTop ℝ) = φ.ramificationPolygon α m := by
  classical
  have hex : ∃ q : ℚ, φ.ramificationPolygon α m = ((q : ℝ) : WithTop ℝ) := by
    refine ((φ.ramificationPolynomial α).isLowerConvexEnvelope_newtonPolygon
      (normalizedAddValuation L)).exists_rat_height_of_finiteDomain
      (fun n hn ↦ ?_) ?_ hm
    · obtain ⟨z, hz⟩ := exists_int_normalizedAddValuation
        (normalizedAddValuation_eq_top_iff.not.mp hn)
      exact ⟨z, by simpa using hz⟩
    · refine (Set.finite_Iic (φ.ramificationPolynomial α).natDegree).subset fun n hn ↦
        Set.mem_Iic.mpr (le_of_not_gt fun hgt ↦ hn (newtonPolygon_eq_top_of_natDegree_lt _ _ hgt))
  have hdite : (if h : ∃ q : ℚ, φ.ramificationPolygon α m = ((q : ℝ) : WithTop ℝ)
      then h.choose else 0) = hex.choose :=
    dite_eq_left_of_eq_true (eq_true hex)
  rw [ramificationPolygonRat_def, hdite]
  exact hex.choose_spec.symm

variable [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- **The list of rams** of `φ` at `α : L`: the `w = wildRamificationExponent K L` rational slopes
`(N(p ^ (w - k)) - N(p ^ (w - k + 1))) / (p ^ (w - k + 1) - p ^ (w - k))` (`k = 1, …, w`), read
from `p ^ w` down to `1` so that `0 < r₁ ≤ ⋯ ≤ r_w`. -/
def rams (φ : 𝒪[K][X]) (α : L) : List ℚ :=
  let p := ringChar 𝓀[K]
  let w := wildRamificationExponent K L
  List.ofFn fun k : Fin w ↦
    let r := w - 1 - k.1
    (φ.ramificationPolygonRat α (p ^ r) - φ.ramificationPolygonRat α (p ^ (r + 1))) /
      ((p ^ (r + 1) - p ^ r : ℕ) : ℚ)

/-- Defining formula for `rams`. -/
theorem rams_def (φ : 𝒪[K][X]) (α : L) :
    φ.rams α =
      List.ofFn fun k : Fin (wildRamificationExponent K L) ↦
        let p := ringChar 𝓀[K]
        let r := wildRamificationExponent K L - 1 - k.1
        (φ.ramificationPolygonRat α (p ^ r) - φ.ramificationPolygonRat α (p ^ (r + 1))) /
          ((p ^ (r + 1) - p ^ r : ℕ) : ℚ) := by
  rw [rams]

/-- The list `φ.rams α` has length `wildRamificationExponent K L`. -/
@[simp]
theorem length_rams (φ : 𝒪[K][X]) (α : L) :
    (φ.rams α).length = wildRamificationExponent K L := by
  rw [rams_def, List.length_ofFn]

/-- `φ.rams α` is empty if and only if `L/K` is tamely ramified
(`wildRamificationExponent K L = 0`). -/
@[simp]
theorem rams_eq_nil_iff (φ : 𝒪[K][X]) (α : L) :
    φ.rams α = [] ↔ wildRamificationExponent K L = 0 := by
  rw [← List.length_eq_zero_iff, length_rams]

/-- **The number of wild segments** of `φ.ramificationPolygon α`: the number of distinct entries in
`φ.rams α`. -/
def wildSegments (φ : 𝒪[K][X]) (α : L) : ℕ :=
  (φ.rams α).dedup.length

/-- Defining formula for `wildSegments`. -/
theorem wildSegments_def (φ : 𝒪[K][X]) (α : L) :
    φ.wildSegments α = (φ.rams α).dedup.length := by
  rw [wildSegments]

/-- An extension has at most `wildRamificationExponent K L` wild segments. -/
theorem wildSegments_le_wildRamificationExponent (φ : 𝒪[K][X]) (α : L) :
    φ.wildSegments α ≤ wildRamificationExponent K L :=
  (List.Sublist.length_le (List.dedup_sublist _)).trans_eq (length_rams φ α)

/-- `φ.wildSegments α = 0` if and only if `wildRamificationExponent K L = 0`. -/
@[simp]
theorem wildSegments_eq_zero_iff (φ : 𝒪[K][X]) (α : L) :
    φ.wildSegments α = 0 ↔ wildRamificationExponent K L = 0 := by
  rw [wildSegments_def, List.length_eq_zero_iff, List.dedup_eq_nil, rams_eq_nil_iff]

variable [ValuativeExtension K L]

/-- **Independence of `ramificationPolygonRat`.** Any two monic Eisenstein generators `(φ, ξ)` and
`(φ', ξ')` of a separable extension `L/K` have the exact same rational polygon heights. -/
theorem ramificationPolygonRat_eq_of_eisenstein_adjoin_eq_top [Algebra.IsSeparable K L]
    {φ φ' : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hmon' : φ'.Monic) (hφ' : φ'.IsEisensteinAt 𝓂[K]) {ξ' : 𝒪[L]}
    (hroot' : (φ'.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ') (hgen' : K⟮(ξ' : L)⟯ = ⊤) :
    φ.ramificationPolygonRat (ξ : L) = φ'.ramificationPolygonRat (ξ' : L) := by
  have hpoly := ramificationPolygon_eq_of_eisenstein_adjoin_eq_top
    hmon hφ hroot hgen hmon' hφ' hroot' hgen'
  funext m
  rw [ramificationPolygonRat_def, ramificationPolygonRat_def]
  exact congrArg (fun N : ℕ → WithTop ℝ ↦ open Classical in
    if h : ∃ q : ℚ, N m = ((q : ℝ) : WithTop ℝ) then h.choose else 0) hpoly

/-- **Independence of `rams`.** Any two monic Eisenstein generators `(φ, ξ)` and `(φ', ξ')` of a
separable extension `L/K` have the exact same list of rams. -/
theorem rams_eq_of_eisenstein_adjoin_eq_top [Algebra.IsSeparable K L]
    {φ φ' : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hmon' : φ'.Monic) (hφ' : φ'.IsEisensteinAt 𝓂[K]) {ξ' : 𝒪[L]}
    (hroot' : (φ'.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ') (hgen' : K⟮(ξ' : L)⟯ = ⊤) :
    φ.rams (ξ : L) = φ'.rams (ξ' : L) := by
  have hrat := ramificationPolygonRat_eq_of_eisenstein_adjoin_eq_top
    hmon hφ hroot hgen hmon' hφ' hroot' hgen'
  rw [rams_def, rams_def]
  exact congrArg (fun R : ℕ → ℚ ↦ List.ofFn fun k : Fin (wildRamificationExponent K L) ↦
    let p := ringChar 𝓀[K]
    let r := wildRamificationExponent K L - 1 - k.1
    (R (p ^ r) - R (p ^ (r + 1))) / ((p ^ (r + 1) - p ^ r : ℕ) : ℚ)) hrat

/-- **Independence of `wildSegments`.** Any two monic Eisenstein generators `(φ, ξ)` and `(φ', ξ')`
of a separable extension `L/K` have the same number of wild segments. -/
theorem wildSegments_eq_of_eisenstein_adjoin_eq_top [Algebra.IsSeparable K L]
    {φ φ' : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hmon' : φ'.Monic) (hφ' : φ'.IsEisensteinAt 𝓂[K]) {ξ' : 𝒪[L]}
    (hroot' : (φ'.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ') (hgen' : K⟮(ξ' : L)⟯ = ⊤) :
    φ.wildSegments (ξ : L) = φ'.wildSegments (ξ' : L) := by
  rw [wildSegments_def, wildSegments_def,
    rams_eq_of_eisenstein_adjoin_eq_top hmon hφ hroot hgen hmon' hφ' hroot' hgen']

/-- Each entry `(φ.rams (ξ : L))[k]` (`k < w`), cast to `ℝ`, is the negated unit slope of
`φ.ramificationPolygon (ξ : L)` on `[p ^ (w - 1 - k), p ^ (w - k))`. -/
theorem coe_getElem_rams [Algebra.IsSeparable K L] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {k : ℕ}
    (hk : k < (φ.rams (ξ : L)).length) :
    (((φ.rams (ξ : L))[k] : ℚ) : ℝ) =
      -unitSlope (φ.ramificationPolygon (ξ : L))
        (ringChar 𝓀[K] ^ (wildRamificationExponent K L - 1 - k)) := by
  set p := ringChar 𝓀[K]
  set w := wildRamificationExponent K L
  set r := w - 1 - k
  have hkw : k < w := by simpa using hk
  have hrw : r < w := by omega
  have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
  have hlt_pow : p ^ r < p ^ (r + 1) := Nat.pow_lt_pow_right hp.one_lt (Nat.lt_succ_self r)
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : p ^ w ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  have hne₁ : φ.ramificationPolygon (ξ : L) (p ^ r) ≠ ⊤ :=
    (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr
      ⟨one_le_pow₀ hp.one_le, hlt_pow.le.trans ((Nat.pow_le_pow_right hp.pos hrw).trans hle_n)⟩
  have hne₂ : φ.ramificationPolygon (ξ : L) (p ^ (r + 1)) ≠ ⊤ :=
    (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr
      ⟨one_le_pow₀ hp.one_le, (Nat.pow_le_pow_right hp.pos hrw).trans hle_n⟩
  have hsum : (φ.ramificationPolygon (ξ : L) (p ^ (r + 1))).untop₀ =
      (φ.ramificationPolygon (ξ : L) (p ^ r)).untop₀ +
        ((p ^ (r + 1) - p ^ r : ℕ) : ℝ) *
          unitSlope (φ.ramificationPolygon (ξ : L)) (p ^ r) := by
    have h := eq_coe_add_sum_unitSlope hne₂ hlt_pow.le
    rw [Finset.sum_congr rfl (fun i hi ↦ unitSlope_ramificationPolygon_eq_of_mem_Ico
      hmon hφ hroot hgen hrw (Finset.mem_Ico.mp hi).1 (Finset.mem_Ico.mp hi).2),
      Finset.sum_const, Nat.card_Ico, nsmul_eq_mul] at h
    exact (WithTop.untop₀_coe _).symm.trans (congrArg WithTop.untop₀ h.symm) |>.symm
  have hr₁ : (φ.ramificationPolygonRat (ξ : L) (p ^ r) : ℝ) =
      (φ.ramificationPolygon (ξ : L) (p ^ r)).untop₀ := by
    simpa using congrArg WithTop.untop₀ (coe_ramificationPolygonRat hne₁)
  have hr₂ : (φ.ramificationPolygonRat (ξ : L) (p ^ (r + 1)) : ℝ) =
      (φ.ramificationPolygon (ξ : L) (p ^ (r + 1))).untop₀ := by
    simpa using congrArg WithTop.untop₀ (coe_ramificationPolygonRat hne₂)
  have hd0 : ((p ^ (r + 1) - p ^ r : ℕ) : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.sub_pos_of_lt hlt_pow).ne'
  simp only [rams_def, List.getElem_ofFn, Rat.cast_div, Rat.cast_sub, Rat.cast_natCast]
  -- Unfold the `let` bindings `p` and `r` from `rams_def` to match the local `set` abbreviations.
  change ((φ.ramificationPolygonRat (ξ : L) (p ^ r) : ℝ) -
      φ.ramificationPolygonRat (ξ : L) (p ^ (r + 1))) /
      ((p ^ (r + 1) - p ^ r : ℕ) : ℝ) = _
  rw [hr₁, hr₂, hsum]
  field_simp [hd0]
  ring

/-- Every ram in `φ.rams (ξ : L)` is strictly positive (`0 < r_k`). -/
theorem pos_of_mem_rams [Algebra.IsSeparable K L] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) {q : ℚ}
    (hq : q ∈ φ.rams (ξ : L)) : 0 < q := by
  obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hq
  have hkw : k < wildRamificationExponent K L := by simpa using hk
  have hp : (ringChar 𝓀[K]).Prime := CharP.prime_ringChar 𝓀[K]
  have hlt : ringChar 𝓀[K] ^ (wildRamificationExponent K L - 1 - k) <
      ringChar 𝓀[K] ^ wildRamificationExponent K L :=
    Nat.pow_lt_pow_right hp.one_lt (by omega)
  have hreal : (0 : ℝ) < ((φ.rams (ξ : L))[k] : ℝ) := by
    rw [coe_getElem_rams hmon hφ hroot hgen hk, neg_pos]
    exact unitSlope_ramificationPolygon_neg hmon hφ hroot hgen (one_le_pow₀ hp.one_le) hlt
  exact_mod_cast hreal

/-- The list `φ.rams (ξ : L)` is nondecreasing (`r₁ ≤ r₂ ≤ ⋯ ≤ r_w`). -/
theorem sortedLE_rams [Algebra.IsSeparable K L] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    (φ.rams (ξ : L)).SortedLE := by
  refine List.sortedLE_of_getElem_le_getElem_of_le fun i j hi hj hij ↦ ?_
  have hjw : j < wildRamificationExponent K L := by simpa using hj
  set p := ringChar 𝓀[K]
  set w := wildRamificationExponent K L
  have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : p ^ w ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  have hedge (m : ℕ) (hm : m < w) : p ^ m ∈ finiteEdges (φ.ramificationPolygon (ξ : L)) := by
    have hlt_n : p ^ m < φ.natDegree :=
      (Nat.pow_lt_pow_right hp.one_lt hm).trans_le hle_n
    exact mem_finiteEdges.mpr
      ⟨(ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr ⟨one_le_pow₀ hp.one_le, hlt_n.le⟩,
        (ramificationPolygon_ne_top_iff hmon hφ hroot hgen).mpr ⟨by omega, hlt_n⟩⟩
  have hmono := ((φ.ramificationPolynomial (ξ : L)).isConvexSeq_newtonPolygon _).monotoneOn
    (hedge (w - 1 - j) (by omega)) (hedge (w - 1 - i) (by omega))
    (Nat.pow_le_pow_right hp.pos (by omega))
  have hreal : (((φ.rams (ξ : L))[i] : ℚ) : ℝ) ≤ ((φ.rams (ξ : L))[j] : ℝ) := by
    rw [coe_getElem_rams hmon hφ hroot hgen hi,
      coe_getElem_rams hmon hφ hroot hgen hj, neg_le_neg_iff]
    exact hmono
  exact_mod_cast hreal

private theorem map_unitSlope_Ico_pow [Algebra.IsSeparable K L] {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    ∀ m ≤ wildRamificationExponent K L,
      (Finset.Ico 1 (ringChar 𝓀[K] ^ m)).val.map (unitSlope (φ.ramificationPolygon (ξ : L))) =
        ∑ r ∈ Finset.range m,
          Multiset.replicate (ringChar 𝓀[K] ^ (r + 1) - ringChar 𝓀[K] ^ r)
            (unitSlope (φ.ramificationPolygon (ξ : L)) (ringChar 𝓀[K] ^ r))
  | 0, _ => by simp
  | m + 1, hm => by
    set p := ringChar 𝓀[K]
    have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
    have hdisj : Disjoint (Finset.Ico 1 (p ^ m)) (Finset.Ico (p ^ m) (p ^ (m + 1))) :=
      Finset.Ico_disjoint_Ico_consecutive 1 (p ^ m) (p ^ (m + 1))
    have hsplit : (Finset.Ico 1 (p ^ (m + 1))).val =
        (Finset.Ico 1 (p ^ m)).val + (Finset.Ico (p ^ m) (p ^ (m + 1))).val := by
      have hu : Finset.Ico 1 (p ^ (m + 1)) =
          (Finset.Ico 1 (p ^ m)).disjUnion (Finset.Ico (p ^ m) (p ^ (m + 1))) hdisj := by
        rw [Finset.disjUnion_eq_union, Finset.Ico_union_Ico_eq_Ico (one_le_pow₀ hp.one_le)
          (Nat.pow_le_pow_right hp.pos (Nat.le_succ m))]
      exact congrArg Finset.val hu
    rw [hsplit, Multiset.map_add,
      map_unitSlope_Ico_pow hmon hφ hroot hgen m (Nat.le_of_succ_le hm), Finset.sum_range_succ]
    congr 1
    have hconst : ∀ i ∈ (Finset.Ico (p ^ m) (p ^ (m + 1))).val,
        unitSlope (φ.ramificationPolygon (ξ : L)) i =
          unitSlope (φ.ramificationPolygon (ξ : L)) (p ^ m) := fun i hi ↦
      unitSlope_ramificationPolygon_eq_of_mem_Ico hmon hφ hroot hgen hm
        (Finset.mem_Ico.mp (Finset.mem_def.mpr hi)).1
        (Finset.mem_Ico.mp (Finset.mem_def.mpr hi)).2
    rw [Multiset.map_congr rfl hconst, Multiset.map_const', Finset.card_val, Nat.card_Ico]

/-- **The slope dictionary.** The finite Newton slope multiset of `φ.ramificationPolynomial (ξ : L)`
consists of `-r_k` with multiplicity `p ^ (w - k + 1) - p ^ (w - k)` for `k = 1, …, w` together
with `0` of multiplicity `deg φ - p ^ w`. -/
theorem newtonSlopes_ramificationPolynomial_eq_sum_rams [Algebra.IsSeparable K L] {φ : 𝒪[K][X]}
    (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) :
    (φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L) =
      (∑ k : Fin (wildRamificationExponent K L),
        Multiset.replicate
          (ringChar 𝓀[K] ^ (wildRamificationExponent K L - k.1) -
            ringChar 𝓀[K] ^ (wildRamificationExponent K L - 1 - k.1))
          (-(((φ.rams (ξ : L))[k.1]'(by simp [k.2]) : ℚ) : ℝ))) +
        Multiset.replicate
          (φ.natDegree - ringChar 𝓀[K] ^ wildRamificationExponent K L) 0 := by
  set p := ringChar 𝓀[K]
  set w := wildRamificationExponent K L
  have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
  have he : ramificationIndex K L = φ.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen
  have hle_n : p ^ w ≤ φ.natDegree := by
    rw [← he, ← tameRamificationIndex_mul_pow_wildRamificationExponent K L]
    exact Nat.le_mul_of_pos_left _ (tameRamificationIndex_pos K L)
  have hfin : ((φ.ramificationPolynomial (ξ : L)).finite_finiteEdges_newtonPolygon
      (normalizedAddValuation L)).toFinset = Finset.Ico 1 φ.natDegree := by
    ext i
    simp only [Set.Finite.mem_toFinset, mem_finiteEdges, ← ramificationPolygon_def,
      ramificationPolygon_ne_top_iff hmon hφ hroot hgen, Finset.mem_Ico]
    omega
  have hdisj : Disjoint (Finset.Ico 1 (p ^ w)) (Finset.Ico (p ^ w) φ.natDegree) :=
    Finset.Ico_disjoint_Ico_consecutive 1 (p ^ w) φ.natDegree
  have hsplit : (Finset.Ico 1 φ.natDegree).val =
      (Finset.Ico 1 (p ^ w)).val + (Finset.Ico (p ^ w) φ.natDegree).val := by
    have hu : Finset.Ico 1 φ.natDegree =
        (Finset.Ico 1 (p ^ w)).disjUnion (Finset.Ico (p ^ w) φ.natDegree) hdisj := by
      rw [Finset.disjUnion_eq_union, Finset.Ico_union_Ico_eq_Ico (one_le_pow₀ hp.one_le) hle_n]
    exact congrArg Finset.val hu
  rw [newtonSlopes_def, hfin, ← ramificationPolygon_def, hsplit, Multiset.map_add,
    map_unitSlope_Ico_pow hmon hφ hroot hgen w le_rfl]
  congr 1
  · rw [← Fin.sum_univ_eq_sum_range, ← Equiv.sum_comp Fin.revPerm]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    have hk : k.1 < (φ.rams (ξ : L)).length := by simp [w, k.2]
    have hsub₁ : w - (k.1 + 1) = w - 1 - k.1 := by omega
    have hsub₂ : w - 1 - k.1 + 1 = w - k.1 := by omega
    simp only [Fin.revPerm_apply, Fin.val_rev, hsub₁, hsub₂,
      coe_getElem_rams hmon hφ hroot hgen hk, neg_neg]
    rfl
  · have hzero : ∀ i ∈ (Finset.Ico (p ^ w) φ.natDegree).val,
        unitSlope (φ.ramificationPolygon (ξ : L)) i = 0 := fun i hi ↦ by
      obtain ⟨h₁, h₂⟩ := Finset.mem_Ico.mp (Finset.mem_def.mpr hi)
      rw [unitSlope_def, ramificationPolygon_eq_zero_of_mem_Icc hmon hφ hroot hgen h₁ h₂.le,
        ramificationPolygon_eq_zero_of_mem_Icc hmon hφ hroot hgen (Nat.le_succ_of_le h₁) h₂,
        sub_self]
    rw [Multiset.map_congr rfl hzero, Multiset.map_const', Finset.card_val, Nat.card_Ico]

omit [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L] in
private theorem sum_range_pow_sub_pow (p c : ℕ) (hp : 1 ≤ p) :
    ∑ r ∈ Finset.range c, (p ^ (r + 1) - p ^ r) = p ^ c - 1 := by
  induction c with
  | zero => simp
  | succ c ih =>
    rw [Finset.sum_range_succ, ih]
    have h1 : 1 ≤ p ^ c := one_le_pow₀ hp
    have h2 : p ^ c ≤ p ^ (c + 1) := Nat.pow_le_pow_right hp (Nat.le_succ c)
    omega

omit [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L] in
private theorem le_getElem_rev_iff_lt_countP {l : List ℚ} (hsorted : l.SortedLE) (t : ℚ)
    (r : Fin l.length) :
    t ≤ l[l.length - 1 - r.1]'(by omega) ↔ r.1 < l.countP (fun x ↦ decide (t ≤ x)) := by
  have hcount : l.countP (fun x ↦ decide (t ≤ x)) =
      (Finset.univ.filter fun k : Fin l.length ↦ t ≤ l[k.1]).card := by
    conv_lhs => rw [← List.ofFn_getElem (xs := l)]
    rw [List.countP_ofFn]
    simp
  constructor
  · intro htr
    have hsub : Finset.Ici (Fin.rev r) ⊆ Finset.univ.filter
        (fun k : Fin l.length ↦ t ≤ l[k.1]) := fun k hk ↦ by
      rw [Finset.mem_filter]
      have hk_le : l.length - 1 - r.1 ≤ k.1 := by
        have hk' := Finset.mem_Ici.mp hk
        simp only [Fin.le_def, Fin.val_rev] at hk'
        omega
      exact ⟨Finset.mem_univ _, htr.trans (hsorted.getElem_le_getElem_of_le hk_le)⟩
    have hcard_le := Finset.card_le_card hsub
    rw [Fin.card_Ici, Fin.val_rev, ← hcount] at hcard_le
    omega
  · intro hrc
    by_contra! hlt
    have hsub : Finset.univ.filter (fun k : Fin l.length ↦ t ≤ l[k.1]) ⊆
        Finset.Ioi (Fin.rev r) := fun k hk ↦ by
      rw [Finset.mem_Ioi, Fin.lt_def, Fin.val_rev]
      by_contra! hle
      have hk_le : k.1 ≤ l.length - 1 - r.1 := by omega
      exact not_le_of_gt hlt ((Finset.mem_filter.mp hk).2.trans
        (hsorted.getElem_le_getElem_of_le (hj := by omega) hk_le))
    have hcard_le := Finset.card_le_card hsub
    rw [Fin.card_Ioi, Fin.val_rev, ← hcount] at hcard_le
    omega

private theorem countP_replicate {α : Type*} (p : α → Prop) [DecidablePred p] (n : ℕ) (a : α) :
    (Multiset.replicate n a).countP p = if p a then n else 0 := by
  induction n with
  | zero => simp
  | succ n ih => by_cases h : p a <;> simp [Multiset.replicate_succ, h, ih]

/-- **Conjugate-break tail count.** For any rational threshold `t > 0` and any splitting extension
`M/L/K`, the number of conjugate breaks `q ∈ conjugateBreaks K L M (ξ : L)` with `t ≤ q` equals
`p ^ ((φ.rams (ξ : L)).countP (t ≤ ·)) - 1`. -/
theorem card_filter_conjugateBreaks_ge_of_pos [Algebra.IsSeparable K L]
    [Field M] [ValuativeRel M] [TopologicalSpace M] [IsNonarchimedeanLocalField M]
    [Algebra K M] [Algebra L M] [IsScalarTower K L M] [ValuativeExtension L M]
    {φ : 𝒪[K][X]} (hmon : φ.Monic) (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (hsplits : ((φ.map (algebraMap 𝒪[K] K)).map (algebraMap K M)).Splits)
    {t : ℚ} (ht : 0 < t) :
    ((conjugateBreaks K L M (ξ : L)).filter (t ≤ ·)).card =
      ringChar 𝓀[K] ^ ((φ.rams (ξ : L)).countP (fun r ↦ decide (t ≤ r))) - 1 := by
  classical
  let p := ringChar 𝓀[K]
  let w := wildRamificationExponent K L
  set c := (φ.rams (ξ : L)).countP (fun r ↦ decide (t ≤ r))
  have hp : p.Prime := CharP.prime_ringChar 𝓀[K]
  have hlen : (φ.rams (ξ : L)).length = w := length_rams φ (ξ : L)
  have hc_le : c ≤ w := List.countP_le_length.trans_eq hlen
  set φcount : Multiset ℝ →+ ℕ :=
    ⟨⟨Multiset.countP (· ≤ -(t : ℝ)), Multiset.countP_zero _⟩, Multiset.countP_add _⟩
  have hcard : ((conjugateBreaks K L M (ξ : L)).filter (t ≤ ·)).card =
      φcount ((φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L)) := by
    simp only [φcount, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [newtonSlopes_ramificationPolynomial_eq_map_conjugateBreaks (M := M)
      hmon hφ hroot hgen hsplits, Multiset.countP_map]
    exact congrArg Multiset.card (Multiset.filter_congr fun q _ ↦ by simp [neg_le_neg_iff])
  have hzero : φcount (Multiset.replicate (φ.natDegree - p ^ w) 0) = 0 := by
    have ht' : ¬ (0 : ℝ) ≤ -(t : ℝ) := not_le.mpr (neg_neg_of_pos (by exact_mod_cast ht))
    simp [φcount, countP_replicate, ht']
  have hterm (k : Fin w) :
      φcount (Multiset.replicate (p ^ (w - k.1) - p ^ (w - 1 - k.1))
        (-(((φ.rams (ξ : L))[k.1]'(by rw [hlen]; exact k.2) : ℚ) : ℝ))) =
        if t ≤ (φ.rams (ξ : L))[k.1]'(by rw [hlen]; exact k.2) then
          p ^ (w - k.1) - p ^ (w - 1 - k.1)
        else 0 := by
    simp [φcount, countP_replicate, neg_le_neg_iff]
  rw [hcard, newtonSlopes_ramificationPolynomial_eq_sum_rams hmon hφ hroot hgen,
    map_add, hzero, add_zero, map_sum, Finset.sum_congr rfl fun k _ ↦ hterm k,
    ← Equiv.sum_comp Fin.revPerm]
  have hcongr : (∑ r : Fin w,
      if t ≤ (φ.rams (ξ : L))[(Fin.revPerm r).1]'(by rw [hlen]; exact (Fin.revPerm r).2) then
        p ^ (w - (Fin.revPerm r).1) - p ^ (w - 1 - (Fin.revPerm r).1)
      else 0) = ∑ r : Fin w, if r.1 < c then p ^ (r.1 + 1) - p ^ r.1 else 0 := by
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    have hiff := le_getElem_rev_iff_lt_countP (sortedLE_rams hmon hφ hroot hgen) t
      ⟨r.1, by rw [hlen]; exact r.2⟩
    have h1 : w - (w - (r.1 + 1)) = r.1 + 1 := by omega
    have h2 : w - 1 - (w - (r.1 + 1)) = r.1 := by omega
    have h3 : w - 1 - r.1 = w - (r.1 + 1) := by omega
    simp only [Fin.revPerm_apply, Fin.val_rev, hlen, h1, h2, h3] at hiff ⊢
    exact if_congr hiff rfl rfl
  rw [hcongr, Fin.sum_univ_eq_sum_range (fun j ↦ if j < c then p ^ (j + 1) - p ^ j else 0) w,
    ← Finset.sum_filter,
    show (Finset.range w).filter (· < c) = Finset.range c by ext j; simp; omega,
    sum_range_pow_sub_pow p c hp.one_le]

/-- **Denominator divisibility.** For every rational number `q : ℚ`, the reduced denominator `q.den`
divides the multiplicity of `-(q : ℝ)` in the Newton slopes of
`φ.ramificationPolynomial (ξ : L)`. -/
theorem den_dvd_count_newtonSlopes_ramificationPolynomial {φ : 𝒪[K][X]} (hmon : φ.Monic)
    (hφ : φ.IsEisensteinAt 𝓂[K]) {ξ : 𝒪[L]}
    (hroot : (φ.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤) (q : ℚ) :
    q.den ∣
      ((φ.ramificationPolynomial (ξ : L)).newtonSlopes (normalizedAddValuation L)).count
        (-(q : ℝ)) := by
  have hξ0 : (ξ : L) ≠ 0 := fun h ↦
    (irreducible_of_eisenstein_adjoin_eq_top φ hφ ξ hroot hgen).ne_zero (Subtype.ext h)
  set ρ := φ.ramificationPolynomial (ξ : L)
  set v := normalizedAddValuation L
  obtain ⟨l, u, hface⟩ := exists_isFiniteFace_newtonPolygon
    ((hmon.ramificationPolynomial hξ0).newtonPolygon_ne_top v) (-(q : ℝ))
  rw [count_newtonSlopes_of_isFiniteFace hface]
  rcases eq_or_lt_of_le hface.left_le_right with rfl | hlu
  · simp
  obtain ⟨q', hq', hdvd⟩ := (ρ.isLowerConvexEnvelope_newtonPolygon v)
    |>.exists_rat_eq_and_den_dvd_of_isFiniteFace
      (fun n hn ↦ exists_int_normalizedAddValuation (normalizedAddValuation_eq_top_iff.not.mp hn))
      hface hlu
  have hqq : q' = -q := Rat.cast_injective (by simpa using hq')
  rwa [hqq, Rat.neg_den] at hdvd

