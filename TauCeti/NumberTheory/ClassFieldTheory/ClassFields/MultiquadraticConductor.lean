/-!
# The abelian conductor of quadratic and multiquadratic extensions of `ℚ`

This file computes the class-field-theoretic conductor `abelianConductor ℚ E` of quadratic and
multiquadratic extensions of `ℚ`, together with its finite norm and infinite part, and evaluates
it on the explicit quadratic subfields of low-level cyclotomic fields.

The bridge has two halves:

* **The finite part.** By the Kronecker–Weber characterization of the conductor
  (`nonempty_algHom_cyclotomicField_iff`), the absolute norm `f` of the finite part
  `(abelianConductor ℚ E).finitePart` is the least positive integer `n` such that `E` embeds in
  `CyclotomicField n ℚ`. On the cyclotomic side,
  `TauCeti.Multiquadratic.adjoin_range_le_adjoin_simple_iff_lcm_dvd` shows that a multiquadratic
  field `ℚ(√d₁, …, √dₖ)` generated by square roots of squarefree integers `dᵢ` lies in `ℚ(ζ_n)`
  if and only if the least common multiple of `|fundamentalDiscriminant dᵢ|` divides `n`.
  Comparing the two divisibility characterizations in `AlgebraicClosure ℚ` identifies `f` with
  that least common multiple (`absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top`), and
  rescaling generators gives the parallel formula `lcmᵢ |Dᵢ|` for fundamental discriminants `Dᵢ`.
* **The infinite part.** By `abelianConductor_rat_eq_ratFiniteModulus_iff` and
  `abelianConductor_rat_eq_ratModulus_iff`, the real place of `ℚ` is absent from the conductor
  exactly when `E` is totally real, and `isTotallyReal_iff_forall_nonneg_of_adjoin_range_eq_top`
  characterizes total reality of a multiquadratic extension by nonnegativity of all radicands.

In all statements, `IsAbelianGalois ℚ E` is deduced internally from the multiquadratic presentation
(`TauCeti.Multiquadratic.isGalois_of_adjoin_eq_top` and
`TauCeti.Multiquadratic.isMulCommutative_of_adjoin_eq_top`), and empty index types are allowed.

## Main results

* `TauCeti.ClassFieldTheory.absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top`,
  `TauCeti.ClassFieldTheory.abelianConductor_of_adjoin_range_eq_top_of_nonneg`, and
  `TauCeti.ClassFieldTheory.abelianConductor_of_adjoin_range_eq_top_of_exists_neg`: the finite norm
  and full modulus of the conductor of a multiquadratic field generated by square roots of
  squarefree integers (with intermediate-field companions `*_adjoin_range*`).
* The `*_isFundamentalDiscr*` variants: the parallel formulas `lcmᵢ |Dᵢ|` for families of
  fundamental discriminants `Dᵢ`.
* `TauCeti.ClassFieldTheory.absNorm_abelianConductor_finitePart_of_sq_eq_of_squarefree`,
  `TauCeti.ClassFieldTheory.abelianConductor_of_sq_eq_of_squarefree_of_nonneg`,
  `TauCeti.ClassFieldTheory.abelianConductor_of_sq_eq_of_squarefree_of_neg`, and the
  `*_isFundamentalDiscr*` and `*_adjoin_simple*` variants: the conductor of a quadratic field is
  `(|D|)` for `D > 0` and `(|D|)·∞` for `D < 0`.
* `TauCeti.ClassFieldTheory.abelianConductor_adjoin_sqrt_neg_one`,
  `TauCeti.ClassFieldTheory.abelianConductor_adjoin_sqrt_two`,
  `TauCeti.ClassFieldTheory.abelianConductor_adjoin_sqrt_neg_two`,
  `TauCeti.ClassFieldTheory.abelianConductor_adjoin_sqrt_neg_five`, and
  `TauCeti.ClassFieldTheory.abelianConductor_fifthCyclotomicQuadraticSubfield`: explicit conductors
  of `ℚ(i)`, `ℚ(√2)`, `ℚ(√-2)`, `ℚ(√-5)`, and the quadratic subfield `ℚ(√5)` of `ℚ(ζ₅)`.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §6.
* L. C. Washington, *Introduction to Cyclotomic Fields*, Chapter 3.
* D. A. Cox, *Primes of the Form x² + ny²*, §3.B.
-/

public noncomputable section

namespace TauCeti.ClassFieldTheory

open IsDedekindDomain _root_.NumberField _root_.NumberField.InfinitePlace _root_.IntermediateField
  TauCeti.GlobalNumberFields TauCeti.Multiquadratic

/-! ### Internal helpers -/

/-- A primitive `n`-th root of unity generates an `n`-th cyclotomic extension of `ℚ` as an
intermediate field. -/
private theorem adjoin_primitiveRoot_eq_top {n : ℕ} [NeZero n] {F : Type*} [Field F] [Algebra ℚ F]
    [IsCyclotomicExtension {n} ℚ F] {ζ : F} (hζ : IsPrimitiveRoot ζ n) : ℚ⟮ζ⟯ = ⊤ := by
  refine eq_top_iff.mpr ?_
  rw [← toSubalgebra_le_toSubalgebra, top_toSubalgebra,
    ← IsCyclotomicExtension.adjoin_primitive_root_eq_top hζ]
  exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr (mem_adjoin_simple_self ℚ ζ))

/-- The canonical generator of `K⟮x⟯` generates `K⟮x⟯` over `K`. -/
private theorem adjoin_simple_self_eq_top {K L : Type*} [Field K] [Field L] [Algebra K L] (x : L) :
    K⟮(⟨x, mem_adjoin_simple_self K x⟩ : K⟮x⟯)⟯ = ⊤ := by
  refine map_injective (K⟮x⟯).val ?_
  simp [adjoin_map, ← AlgHom.fieldRange_eq_map, fieldRange_val]

/-- A field generated over `ℚ` by square roots of rationals is an abelian Galois extension of
`ℚ`. -/
private theorem isAbelianGalois_of_adjoin_range_eq_top {E : Type} [Field E] [CharZero E]
    {ι : Type*} {q : ι → ℚ} {r : ι → E} (hr : ∀ i, r i ^ 2 = (q i : E))
    (htop : adjoin ℚ (Set.range r) = ⊤) : IsAbelianGalois ℚ E := by
  have hr' : ∀ i, r i ^ 2 = algebraMap ℚ E (q i) := fun i ↦ by simpa using hr i
  exact
    { toIsGalois := TauCeti.Multiquadratic.isGalois_of_adjoin_eq_top hr' htop
      is_comm := (TauCeti.Multiquadratic.isMulCommutative_of_adjoin_eq_top hr' htop).is_comm }

/-- The least common multiple of `|fundamentalDiscriminant (d i)|` for squarefree `d i` is
nonzero. -/
theorem lcm_natAbs_fundamentalDiscriminant_ne_zero {ι : Type*} [Fintype ι] {d : ι → ℤ}
    (hd : ∀ i, Squarefree (d i)) :
    (Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs) ≠ 0 := by
  rw [Finset.lcm_ne_zero_iff]
  intro i _
  exact Int.natAbs_ne_zero.mpr (isFundamentalDiscr_fundamentalDiscriminant (hd i)).ne_zero

/-- The least common multiple of `|D i|` for fundamental discriminants `D i` is nonzero. -/
theorem lcm_natAbs_isFundamentalDiscr_ne_zero {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) :
    (Finset.univ.lcm fun i ↦ (D i).natAbs) ≠ 0 := by
  rw [Finset.lcm_ne_zero_iff]
  intro i _
  exact Int.natAbs_ne_zero.mpr (hD i).ne_zero

/-- Every fundamental discriminant `D` is `fundamentalDiscriminant d` for a squarefree integer `d`
obtained from `D` by multiplying by the square of a positive rational `u` (`1` or `1 / 2`). -/
private theorem exists_squarefree_of_isFundamentalDiscr {D : ℤ} (hD : Int.IsFundamentalDiscr D) :
    ∃ (u : ℚ) (d : ℤ), 0 < u ∧ Squarefree d ∧
      fundamentalDiscriminant d = D ∧ (D : ℚ) * u ^ 2 = d := by
  rcases Int.isFundamentalDiscr_iff_squarefree.mp hD with ⟨h1, hsf⟩ | ⟨_, hsf, h23⟩
  · exact ⟨1, D, one_pos, hsf, fundamentalDiscriminant_of_mod_four_eq_one h1, by ring⟩
  · refine ⟨2⁻¹, D / 4, by norm_num, hsf, ?_, ?_⟩
    · rw [fundamentalDiscriminant_of_mod_four_ne_one (by omega)]
      omega
    · have hD4 : D = 4 * (D / 4) := by omega
      conv_lhs => rw [hD4]
      push_cast
      ring

/-! ### Multiquadratic extensions from squarefree integers -/

/-- **The finite conductor norm of a multiquadratic field.** If `E` is generated over `ℚ` by square
roots `r i` of squarefree integers `d i`, the absolute norm of the finite part of
`abelianConductor ℚ E` is the least common multiple of `|fundamentalDiscriminant (d i)|`. -/
theorem absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top {E : Type} [Field E]
    [NumberField E] {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i))
    {r : ι → E} (hr : ∀ i, r i ^ 2 = (d i : E)) (htop : adjoin ℚ (Set.range r) = ⊤) :
    Ideal.absNorm (abelianConductor ℚ E).finitePart =
      Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs := by
  have : IsAbelianGalois ℚ E :=
    isAbelianGalois_of_adjoin_range_eq_top (q := fun i ↦ (d i : ℚ))
      (fun i ↦ by simpa using hr i) htop
  set f := Ideal.absNorm (abelianConductor ℚ E).finitePart
  set N := Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs
  have hf0 : f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr (abelianConductor ℚ E).finitePart_ne_bot
  have hN0 : N ≠ 0 := lcm_natAbs_fundamentalDiscriminant_ne_zero hd
  have : NeZero f := ⟨hf0⟩
  have : NeZero N := ⟨hN0⟩
  apply Nat.dvd_antisymm
  · -- Embed both `E` and `CyclotomicField N ℚ` into `AlgebraicClosure ℚ` to build `E →ₐ[ℚ] ℚ(ζ_N)`.
    have : IsCyclotomicExtension {N} ℚ (CyclotomicField N ℚ) :=
      CyclotomicField.isCyclotomicExtension N ℚ
    let φ : E →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
    let ψ : CyclotomicField N ℚ →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
    set ζN := IsCyclotomicExtension.zeta N ℚ (CyclotomicField N ℚ)
    have hζN : IsPrimitiveRoot (ψ ζN) N :=
      (IsCyclotomicExtension.zeta_spec N ℚ (CyclotomicField N ℚ)).map_of_injective ψ.injective
    have hle₁ : adjoin ℚ (Set.range (φ ∘ r)) ≤ ℚ⟮ψ ζN⟯ :=
      (adjoin_range_le_adjoin_simple_iff_lcm_dvd (Nat.pos_of_ne_zero hN0) hζN hd
        fun i ↦ by simp [Function.comp_apply, ← map_pow, hr i]).mpr dvd_rfl
    have hrange : φ.fieldRange = adjoin ℚ (Set.range (φ ∘ r)) := by
      rw [AlgHom.fieldRange_eq_map, ← htop, adjoin_map, Set.range_comp]
    have hle : φ.fieldRange ≤ ψ.fieldRange :=
      (hrange ▸ hle₁).trans (adjoin_simple_le_iff.mpr ⟨ζN, rfl⟩)
    exact (nonempty_algHom_cyclotomicField_iff E N).mp
      ⟨(AlgEquiv.ofInjectiveField ψ).symm.toAlgHom.comp
        (φ.codRestrict ψ.fieldRange.toSubalgebra fun x ↦ hle (φ.mem_fieldRange_self x))⟩
  · -- Conversely, `E` embeds in `CyclotomicField f ℚ = ℚ(ζ_f)`, so each `|Dᵢ|` divides `f`.
    have : IsCyclotomicExtension {f} ℚ (CyclotomicField f ℚ) :=
      CyclotomicField.isCyclotomicExtension f ℚ
    obtain ⟨θ⟩ := (nonempty_algHom_cyclotomicField_iff E f).mpr dvd_rfl
    have hζf := IsCyclotomicExtension.zeta_spec f ℚ (CyclotomicField f ℚ)
    refine Finset.lcm_dvd fun i _ ↦ ?_
    refine (mem_adjoin_simple_iff_natAbs_fundamentalDiscriminant_dvd (Nat.pos_of_ne_zero hf0) hζf
      (hd i) (x := θ (r i)) (by simp [← map_pow, hr i])).mp ?_
    rw [adjoin_primitiveRoot_eq_top hζf]
    exact mem_top

/-- **The conductor of a totally real multiquadratic field.** If every squarefree radicand `d i` is
nonnegative, the conductor of `E = ℚ(r i : i)` is the finite modulus
`(lcmᵢ |fundamentalDiscriminant (d i)|)`. -/
theorem abelianConductor_of_adjoin_range_eq_top_of_nonneg {E : Type} [Field E] [NumberField E]
    {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i)) {r : ι → E}
    (hr : ∀ i, r i ^ 2 = (d i : E)) (htop : adjoin ℚ (Set.range r) = ⊤) (hpos : ∀ i, 0 ≤ d i) :
    abelianConductor ℚ E =
      ratFiniteModulus (Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs)
        (lcm_natAbs_fundamentalDiscriminant_ne_zero hd) := by
  have hr' : ∀ i, r i ^ 2 = algebraMap ℚ E (d i : ℚ) := fun i ↦ by simpa using hr i
  have : IsAbelianGalois ℚ E :=
    isAbelianGalois_of_adjoin_range_eq_top (q := fun i ↦ (d i : ℚ))
      (fun i ↦ by simpa using hr i) htop
  rw [abelianConductor_rat_eq_ratFiniteModulus_iff]
  exact ⟨absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top hd hr htop,
    (isTotallyReal_iff_forall_nonneg_of_adjoin_range_eq_top hr' htop).mpr
      fun i ↦ by exact_mod_cast hpos i⟩

/-- **The conductor of an imaginary multiquadratic field.** If at least one squarefree radicand
`d i` is negative, the conductor of `E = ℚ(r i : i)` is
`(lcmᵢ |fundamentalDiscriminant (d i)|)·∞`. -/
theorem abelianConductor_of_adjoin_range_eq_top_of_exists_neg {E : Type} [Field E] [NumberField E]
    {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i)) {r : ι → E}
    (hr : ∀ i, r i ^ 2 = (d i : E)) (htop : adjoin ℚ (Set.range r) = ⊤) (hneg : ∃ i, d i < 0) :
    abelianConductor ℚ E =
      ratModulus (Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs)
        (lcm_natAbs_fundamentalDiscriminant_ne_zero hd) := by
  have hr' : ∀ i, r i ^ 2 = algebraMap ℚ E (d i : ℚ) := fun i ↦ by simpa using hr i
  have : IsAbelianGalois ℚ E :=
    isAbelianGalois_of_adjoin_range_eq_top (q := fun i ↦ (d i : ℚ))
      (fun i ↦ by simpa using hr i) htop
  rw [abelianConductor_rat_eq_ratModulus_iff,
    isTotallyReal_iff_forall_nonneg_of_adjoin_range_eq_top hr' htop]
  obtain ⟨i, hi⟩ := hneg
  exact ⟨absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top hd hr htop,
    fun h ↦ not_lt_of_ge (h i) (by exact_mod_cast hi)⟩

/-- **The finite conductor norm of a multiquadratic intermediate field.** -/
theorem absNorm_abelianConductor_finitePart_adjoin_range {L : Type} [Field L] [NumberField L]
    {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i)) {r : ι → L}
    (hr : ∀ i, r i ^ 2 = (d i : L)) :
    Ideal.absNorm (abelianConductor ℚ (adjoin ℚ (Set.range r))).finitePart =
      Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs :=
  absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top hd
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top

/-- **The conductor of a totally real multiquadratic intermediate field.** -/
theorem abelianConductor_adjoin_range_of_nonneg {L : Type} [Field L] [NumberField L]
    {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i)) {r : ι → L}
    (hr : ∀ i, r i ^ 2 = (d i : L)) (hpos : ∀ i, 0 ≤ d i) :
    abelianConductor ℚ (adjoin ℚ (Set.range r)) =
      ratFiniteModulus (Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs)
        (lcm_natAbs_fundamentalDiscriminant_ne_zero hd) :=
  abelianConductor_of_adjoin_range_eq_top_of_nonneg hd
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top hpos

/-- **The conductor of an imaginary multiquadratic intermediate field.** -/
theorem abelianConductor_adjoin_range_of_exists_neg {L : Type} [Field L] [NumberField L]
    {ι : Type*} [Fintype ι] {d : ι → ℤ} (hd : ∀ i, Squarefree (d i)) {r : ι → L}
    (hr : ∀ i, r i ^ 2 = (d i : L)) (hneg : ∃ i, d i < 0) :
    abelianConductor ℚ (adjoin ℚ (Set.range r)) =
      ratModulus (Finset.univ.lcm fun i ↦ (fundamentalDiscriminant (d i)).natAbs)
        (lcm_natAbs_fundamentalDiscriminant_ne_zero hd) :=
  abelianConductor_of_adjoin_range_eq_top_of_exists_neg hd
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top hneg

/-! ### Multiquadratic extensions from fundamental discriminants -/

/-- **The finite conductor norm of a multiquadratic field generated by square roots of fundamental
discriminants** `D i` is `lcmᵢ |D i|`. -/
theorem absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top_of_isFundamentalDiscr
    {E : Type} [Field E] [NumberField E] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → E} (hr : ∀ i, r i ^ 2 = (D i : E))
    (htop : adjoin ℚ (Set.range r) = ⊤) :
    Ideal.absNorm (abelianConductor ℚ E).finitePart = Finset.univ.lcm fun i ↦ (D i).natAbs := by
  choose u d hu hsf hfd hDu using fun i ↦ exists_squarefree_of_isFundamentalDiscr (hD i)
  have htop' : adjoin ℚ (Set.range fun i ↦ algebraMap ℚ E (u i) * r i) = ⊤ := by
    rwa [TauCeti.IntermediateField.adjoin_range_algebraMap_mul fun i ↦ (hu i).ne']
  have hr' (i : ι) : (algebraMap ℚ E (u i) * r i) ^ 2 = (d i : E) := by
    have key := congrArg (algebraMap ℚ E) (hDu i)
    simp only [map_mul, map_pow, map_intCast] at key
    rw [mul_pow, hr i, mul_comm, key]
  simpa only [hfd] using absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top hsf hr' htop'

/-- **The conductor of a totally real multiquadratic field of fundamental discriminants** `D i ≥ 0`
is `(lcmᵢ |D i|)`. -/
theorem abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_nonneg
    {E : Type} [Field E] [NumberField E] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → E} (hr : ∀ i, r i ^ 2 = (D i : E))
    (htop : adjoin ℚ (Set.range r) = ⊤) (hpos : ∀ i, 0 ≤ D i) :
    abelianConductor ℚ E =
      ratFiniteModulus (Finset.univ.lcm fun i ↦ (D i).natAbs)
        (lcm_natAbs_isFundamentalDiscr_ne_zero hD) := by
  have hr' : ∀ i, r i ^ 2 = algebraMap ℚ E (D i : ℚ) := fun i ↦ by simpa using hr i
  have : IsAbelianGalois ℚ E :=
    isAbelianGalois_of_adjoin_range_eq_top (q := fun i ↦ (D i : ℚ))
      (fun i ↦ by simpa using hr i) htop
  rw [abelianConductor_rat_eq_ratFiniteModulus_iff]
  exact ⟨absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top_of_isFundamentalDiscr
    hD hr htop,
    (isTotallyReal_iff_forall_nonneg_of_adjoin_range_eq_top hr' htop).mpr
      fun i ↦ by exact_mod_cast hpos i⟩

/-- **The conductor of an imaginary multiquadratic field of fundamental discriminants** (with some
`D i < 0`) is `(lcmᵢ |D i|)·∞`. -/
theorem abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_exists_neg
    {E : Type} [Field E] [NumberField E] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → E} (hr : ∀ i, r i ^ 2 = (D i : E))
    (htop : adjoin ℚ (Set.range r) = ⊤) (hneg : ∃ i, D i < 0) :
    abelianConductor ℚ E =
      ratModulus (Finset.univ.lcm fun i ↦ (D i).natAbs)
        (lcm_natAbs_isFundamentalDiscr_ne_zero hD) := by
  have hr' : ∀ i, r i ^ 2 = algebraMap ℚ E (D i : ℚ) := fun i ↦ by simpa using hr i
  have : IsAbelianGalois ℚ E :=
    isAbelianGalois_of_adjoin_range_eq_top (q := fun i ↦ (D i : ℚ))
      (fun i ↦ by simpa using hr i) htop
  rw [abelianConductor_rat_eq_ratModulus_iff,
    isTotallyReal_iff_forall_nonneg_of_adjoin_range_eq_top hr' htop]
  obtain ⟨i, hi⟩ := hneg
  exact ⟨absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top_of_isFundamentalDiscr
    hD hr htop, fun h ↦ not_lt_of_ge (h i) (by exact_mod_cast hi)⟩

/-- **The finite conductor norm of a multiquadratic intermediate field of fundamental
discriminants.** -/
theorem absNorm_abelianConductor_finitePart_adjoin_range_of_isFundamentalDiscr
    {L : Type} [Field L] [NumberField L] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → L} (hr : ∀ i, r i ^ 2 = (D i : L)) :
    Ideal.absNorm (abelianConductor ℚ (adjoin ℚ (Set.range r))).finitePart =
      Finset.univ.lcm fun i ↦ (D i).natAbs :=
  absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top_of_isFundamentalDiscr hD
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top

/-- **The conductor of a totally real multiquadratic intermediate field of fundamental
discriminants.** -/
theorem abelianConductor_adjoin_range_of_isFundamentalDiscr_of_nonneg
    {L : Type} [Field L] [NumberField L] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → L} (hr : ∀ i, r i ^ 2 = (D i : L))
    (hpos : ∀ i, 0 ≤ D i) :
    abelianConductor ℚ (adjoin ℚ (Set.range r)) =
      ratFiniteModulus (Finset.univ.lcm fun i ↦ (D i).natAbs)
        (lcm_natAbs_isFundamentalDiscr_ne_zero hD) :=
  abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_nonneg hD
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top hpos

/-- **The conductor of an imaginary multiquadratic intermediate field of fundamental
discriminants.** -/
theorem abelianConductor_adjoin_range_of_isFundamentalDiscr_of_exists_neg
    {L : Type} [Field L] [NumberField L] {ι : Type*} [Fintype ι] {D : ι → ℤ}
    (hD : ∀ i, Int.IsFundamentalDiscr (D i)) {r : ι → L} (hr : ∀ i, r i ^ 2 = (D i : L))
    (hneg : ∃ i, D i < 0) :
    abelianConductor ℚ (adjoin ℚ (Set.range r)) =
      ratModulus (Finset.univ.lcm fun i ↦ (D i).natAbs)
        (lcm_natAbs_isFundamentalDiscr_ne_zero hD) :=
  abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_exists_neg hD
    (r := TauCeti.Multiquadratic.gen (K := ℚ) r)
    (fun i ↦ Subtype.ext (by simp [hr i])) TauCeti.Multiquadratic.adjoin_gen_eq_top hneg

/-! ### Quadratic extensions -/

/-- **The finite conductor norm of `ℚ(√d)` for squarefree `d`** is
`|fundamentalDiscriminant d|`. -/
theorem absNorm_abelianConductor_finitePart_of_sq_eq_of_squarefree {E : Type} [Field E]
    [NumberField E] {d : ℤ} (hd : Squarefree d) {x : E} (hx : x ^ 2 = (d : E))
    (htop : ℚ⟮x⟯ = ⊤) :
    Ideal.absNorm (abelianConductor ℚ E).finitePart = (fundamentalDiscriminant d).natAbs := by
  simpa using absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top
    (ι := Unit) (d := fun _ ↦ d) (fun _ ↦ hd) (r := fun _ ↦ x) (fun _ ↦ hx) (by simpa using htop)

/-- **The conductor of a real quadratic field `ℚ(√d)`** (`d ≥ 0` squarefree) is
`(|fundamentalDiscriminant d|)`. -/
theorem abelianConductor_of_sq_eq_of_squarefree_of_nonneg {E : Type} [Field E] [NumberField E]
    {d : ℤ} (hd : Squarefree d) {x : E} (hx : x ^ 2 = (d : E)) (htop : ℚ⟮x⟯ = ⊤) (hd0 : 0 ≤ d) :
    abelianConductor ℚ E =
      ratFiniteModulus (fundamentalDiscriminant d).natAbs
        (Int.natAbs_ne_zero.mpr (isFundamentalDiscr_fundamentalDiscriminant hd).ne_zero) := by
  simpa using abelianConductor_of_adjoin_range_eq_top_of_nonneg
    (ι := Unit) (d := fun _ ↦ d) (fun _ ↦ hd) (r := fun _ ↦ x) (fun _ ↦ hx)
    (by simpa using htop) (fun _ ↦ hd0)

/-- **The conductor of an imaginary quadratic field `ℚ(√d)`** (`d < 0` squarefree) is
`(|fundamentalDiscriminant d|)·∞`. -/
theorem abelianConductor_of_sq_eq_of_squarefree_of_neg {E : Type} [Field E] [NumberField E]
    {d : ℤ} (hd : Squarefree d) {x : E} (hx : x ^ 2 = (d : E)) (htop : ℚ⟮x⟯ = ⊤) (hd0 : d < 0) :
    abelianConductor ℚ E =
      ratModulus (fundamentalDiscriminant d).natAbs
        (Int.natAbs_ne_zero.mpr (isFundamentalDiscr_fundamentalDiscriminant hd).ne_zero) := by
  simpa using abelianConductor_of_adjoin_range_eq_top_of_exists_neg
    (ι := Unit) (d := fun _ ↦ d) (fun _ ↦ hd) (r := fun _ ↦ x) (fun _ ↦ hx)
    (by simpa using htop) ⟨(), hd0⟩

/-- **The finite conductor norm of `ℚ⟮x⟯` for `x² = d` squarefree** is
`|fundamentalDiscriminant d|`. -/
theorem absNorm_abelianConductor_finitePart_adjoin_simple_of_squarefree {L : Type} [Field L]
    [NumberField L] {d : ℤ} (hd : Squarefree d) {x : L} (hx : x ^ 2 = (d : L)) :
    Ideal.absNorm (abelianConductor ℚ ℚ⟮x⟯).finitePart = (fundamentalDiscriminant d).natAbs :=
  absNorm_abelianConductor_finitePart_of_sq_eq_of_squarefree hd
    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
    (adjoin_simple_self_eq_top x)

/-- **The conductor of a real quadratic subfield `ℚ⟮x⟯`** (`x² = d`, `d ≥ 0` squarefree) is
`(|fundamentalDiscriminant d|)`. -/
theorem abelianConductor_adjoin_simple_of_squarefree_of_nonneg {L : Type} [Field L] [NumberField L]
    {d : ℤ} (hd : Squarefree d) {x : L} (hx : x ^ 2 = (d : L)) (hd0 : 0 ≤ d) :
    abelianConductor ℚ ℚ⟮x⟯ =
      ratFiniteModulus (fundamentalDiscriminant d).natAbs
        (Int.natAbs_ne_zero.mpr (isFundamentalDiscr_fundamentalDiscriminant hd).ne_zero) :=
  abelianConductor_of_sq_eq_of_squarefree_of_nonneg hd
    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
    (adjoin_simple_self_eq_top x) hd0

/-- **The conductor of an imaginary quadratic subfield `ℚ⟮x⟯`** (`x² = d`, `d < 0` squarefree) is
`(|fundamentalDiscriminant d|)·∞`. -/
theorem abelianConductor_adjoin_simple_of_squarefree_of_neg {L : Type} [Field L] [NumberField L]
    {d : ℤ} (hd : Squarefree d) {x : L} (hx : x ^ 2 = (d : L)) (hd0 : d < 0) :
    abelianConductor ℚ ℚ⟮x⟯ =
      ratModulus (fundamentalDiscriminant d).natAbs
        (Int.natAbs_ne_zero.mpr (isFundamentalDiscr_fundamentalDiscriminant hd).ne_zero) :=
  abelianConductor_of_sq_eq_of_squarefree_of_neg hd
    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
    (adjoin_simple_self_eq_top x) hd0

/-- **The finite conductor norm of `ℚ(√D)` for a fundamental discriminant `D`** is `|D|`. -/
theorem absNorm_abelianConductor_finitePart_of_sq_eq_of_isFundamentalDiscr {E : Type} [Field E]
    [NumberField E] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : E} (hx : x ^ 2 = (D : E))
    (htop : ℚ⟮x⟯ = ⊤) :
    Ideal.absNorm (abelianConductor ℚ E).finitePart = D.natAbs := by
  simpa using absNorm_abelianConductor_finitePart_of_adjoin_range_eq_top_of_isFundamentalDiscr
    (ι := Unit) (D := fun _ ↦ D) (fun _ ↦ hD) (r := fun _ ↦ x) (fun _ ↦ hx) (by simpa using htop)

/-- **The conductor of a real quadratic field `ℚ(√D)`** (`D > 0` a fundamental discriminant) is
`(|D|)`. -/
theorem abelianConductor_of_sq_eq_of_isFundamentalDiscr_of_pos {E : Type} [Field E]
    [NumberField E] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : E} (hx : x ^ 2 = (D : E))
    (htop : ℚ⟮x⟯ = ⊤) (hD0 : 0 < D) :
    abelianConductor ℚ E =
      ratFiniteModulus D.natAbs (Int.natAbs_ne_zero.mpr hD.ne_zero) := by
  simpa using abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_nonneg
    (ι := Unit) (D := fun _ ↦ D) (fun _ ↦ hD) (r := fun _ ↦ x) (fun _ ↦ hx)
    (by simpa using htop) (fun _ ↦ hD0.le)

/-- **The conductor of an imaginary quadratic field `ℚ(√D)`** (`D < 0` a fundamental discriminant)
is `(|D|)·∞`. -/
theorem abelianConductor_of_sq_eq_of_isFundamentalDiscr_of_neg {E : Type} [Field E]
    [NumberField E] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : E} (hx : x ^ 2 = (D : E))
    (htop : ℚ⟮x⟯ = ⊤) (hD0 : D < 0) :
    abelianConductor ℚ E =
      ratModulus D.natAbs (Int.natAbs_ne_zero.mpr hD.ne_zero) := by
  simpa using abelianConductor_of_adjoin_range_eq_top_of_isFundamentalDiscr_of_exists_neg
    (ι := Unit) (D := fun _ ↦ D) (fun _ ↦ hD) (r := fun _ ↦ x) (fun _ ↦ hx)
    (by simpa using htop) ⟨(), hD0⟩

/-- **The finite conductor norm of `ℚ⟮x⟯` for `x² = D` a fundamental discriminant** is `|D|`. -/
theorem absNorm_abelianConductor_finitePart_adjoin_simple_of_isFundamentalDiscr {L : Type}
    [Field L] [NumberField L] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : L}
    (hx : x ^ 2 = (D : L)) :
    Ideal.absNorm (abelianConductor ℚ ℚ⟮x⟯).finitePart = D.natAbs :=
  absNorm_abelianConductor_finitePart_of_sq_eq_of_isFundamentalDiscr hD
    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
    (adjoin_simple_self_eq_top x)

/-- **The conductor of a real quadratic subfield `ℚ⟮x⟯`** (`x² = D > 0` a fundamental discriminant)
is `(|D|)`. -/
theorem abelianConductor_adjoin_simple_of_isFundamentalDiscr_of_pos {L : Type} [Field L]
    [NumberField L] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : L} (hx : x ^ 2 = (D : L))
    (hD0 : 0 < D) :
    abelianConductor ℚ ℚ⟮x⟯ =
