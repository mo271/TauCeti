/-! ### Explicit quadratic subfields -/

/-- **The conductor of `ℚ(i)`** (`x² = -1` inside a number field) is `(4)·∞`. -/
theorem abelianConductor_adjoin_sqrt_neg_one {L : Type} [Field L] [NumberField L] {x : L}
    (hx : x ^ 2 = -1) :
    abelianConductor ℚ ℚ⟮x⟯ = ratModulus 4 (by norm_num) := by
  simpa [fundamentalDiscriminant_of_mod_four_ne_one (by decide : (-1 : ℤ) % 4 ≠ 1)] using
    abelianConductor_adjoin_simple_of_squarefree_of_neg (d := -1) squarefree_one.neg
      (by simpa using hx) (by norm_num)

/-- **The conductor of `ℚ(√2)`** (`x² = 2` inside a number field, e.g. `ℚ(ζ₈)`) is `(8)`. -/
theorem abelianConductor_adjoin_sqrt_two {L : Type} [Field L] [NumberField L] {x : L}
    (hx : x ^ 2 = 2) :
    abelianConductor ℚ ℚ⟮x⟯ = ratFiniteModulus 8 (by norm_num) := by
  simpa [fundamentalDiscriminant_of_mod_four_ne_one (by decide : (2 : ℤ) % 4 ≠ 1)] using
    abelianConductor_adjoin_simple_of_squarefree_of_nonneg (d := 2) Int.prime_two.squarefree
      (by simpa using hx) (by norm_num)

/-- **The conductor of `ℚ(√-2)`** (`x² = -2` inside a number field, e.g. `ℚ(ζ₈)`) is `(8)·∞`. -/
theorem abelianConductor_adjoin_sqrt_neg_two {L : Type} [Field L] [NumberField L] {x : L}
    (hx : x ^ 2 = -2) :
    abelianConductor ℚ ℚ⟮x⟯ = ratModulus 8 (by norm_num) := by
  simpa [fundamentalDiscriminant_of_mod_four_ne_one (by decide : (-2 : ℤ) % 4 ≠ 1)] using
    abelianConductor_adjoin_simple_of_squarefree_of_neg (d := -2) Int.prime_two.squarefree.neg
      (by simpa using hx) (by norm_num)

/-- **The conductor of `ℚ(√-5)`** (`x² = -5` inside a number field) is `(20)·∞`. -/
theorem abelianConductor_adjoin_sqrt_neg_five {L : Type} [Field L] [NumberField L] {x : L}
    (hx : x ^ 2 = -5) :
    abelianConductor ℚ ℚ⟮x⟯ = ratModulus 20 (by norm_num) := by
  have h5 : Squarefree (-5 : ℤ) := (Int.prime_iff_natAbs_prime.mpr (by decide)).squarefree
  simpa [fundamentalDiscriminant_of_mod_four_ne_one (by decide : (-5 : ℤ) % 4 ≠ 1)] using
    abelianConductor_adjoin_simple_of_squarefree_of_neg (d := -5) h5
      (by simpa using hx) (by norm_num)

/-- **The conductor of the quadratic subfield `ℚ(√5)` of `ℚ(ζ₅)`** is the finite modulus `(5)`. -/
theorem abelianConductor_fifthCyclotomicQuadraticSubfield (F : Type) [Field F] [NumberField F]
    [IsCyclotomicExtension {5} ℚ F] :
    abelianConductor ℚ (TauCeti.NumberField.fifthCyclotomicQuadraticSubfield (K := F)) =
      ratFiniteModulus 5 (by norm_num) := by
  have hζ := IsCyclotomicExtension.zeta_spec 5 ℚ F
  rw [abelianConductor_congr
    (equivOfEq (TauCeti.NumberField.fifthCyclotomicQuadraticSubfield_eq_adjoin hζ))]
  have h5 : Squarefree (5 : ℤ) := (Int.prime_iff_natAbs_prime.mpr (by decide)).squarefree
  simpa [fundamentalDiscriminant_of_mod_four_eq_one (by decide : (5 : ℤ) % 4 = 1)] using
    abelianConductor_adjoin_simple_of_squarefree_of_nonneg (d := 5) h5
      (by exact_mod_cast hζ.one_add_two_mul_add_inv_sq_of_five) (by norm_num)

