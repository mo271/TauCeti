    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
    (adjoin_simple_self_eq_top x) hD0

/-- **The conductor of an imaginary quadratic subfield `ℚ⟮x⟯`** (`x² = D < 0` a fundamental
discriminant) is `(|D|)·∞`. -/
theorem abelianConductor_adjoin_simple_of_isFundamentalDiscr_of_neg {L : Type} [Field L]
    [NumberField L] {D : ℤ} (hD : Int.IsFundamentalDiscr D) {x : L} (hx : x ^ 2 = (D : L))
    (hD0 : D < 0) :
    abelianConductor ℚ ℚ⟮x⟯ =
      ratModulus D.natAbs (Int.natAbs_ne_zero.mpr hD.ne_zero) :=
  abelianConductor_of_sq_eq_of_isFundamentalDiscr_of_neg hD
    (x := ⟨x, mem_adjoin_simple_self ℚ x⟩) (Subtype.ext (by simp [hx]))
