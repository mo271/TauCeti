module

public import Mathlib.NumberTheory.NumberField.Discriminant.Different
public import TauCeti.RingTheory.DedekindDomain.Discriminant.Separable
import TauCeti.NumberTheory.NumberField.Ideal.IntegersRat

/-!
# Relative discriminants of number fields

This file specializes the relative discriminant ideal to rings of integers. It identifies the
relative discriminant over `ℤ` and over `𝓞 ℚ` with the principal ideals generated by the signed
absolute discriminant, records its absolute norm and prime multiplicities over `𝓞 ℚ`, and states
transitivity with the field degree as exponent.

## Main results

* `TauCeti.NumberField.relDiscr_int_ringOfIntegers` and
  `TauCeti.NumberField.relDiscr_ringOfIntegers_rat`: the relative discriminants over `ℤ` and over
  `𝓞 ℚ` are generated by `NumberField.discr`.
* `TauCeti.NumberField.absNorm_relDiscr_ringOfIntegers_rat` and
  `TauCeti.NumberField.multiplicity_relDiscr_ringOfIntegers_rat`: the absolute norm and prime
  multiplicities of `relDiscr (𝓞 ℚ) (𝓞 K)` in terms of `|(NumberField.discr K)|`.
* `TauCeti.NumberField.relDiscr_tower`: the relative discriminant formula in a tower of number
  fields.
-/

public section

open scoped NumberField nonZeroDivisors

namespace TauCeti.NumberField

variable (K : Type*) [Field K] [NumberField K]

/-- The relative discriminant of the ring of integers of a number field over `ℤ` is the ideal
generated by its signed absolute discriminant. -/
@[simp]
theorem relDiscr_int_ringOfIntegers :
    relDiscr ℤ (𝓞 K) = Ideal.span {NumberField.discr K} := by
  rw [relDiscr_def, Ideal.relNorm_int, NumberField.absNorm_differentIdeal K (𝓞 K),
    Int.span_natAbs]

/-- The absolute norm of the relative discriminant of `𝓞 K` over `𝓞 ℚ` is the unsigned absolute
discriminant of `K`. -/
@[simp]
theorem absNorm_relDiscr_ringOfIntegers_rat :
    Ideal.absNorm (relDiscr (𝓞 ℚ) (𝓞 K)) = (NumberField.discr K).natAbs := by
  rw [relDiscr_def, Ideal.absNorm_relNorm, differentIdeal_ringOfIntegers_rat_eq_int,
    NumberField.absNorm_differentIdeal K (𝓞 K)]

/-- The relative discriminant of `𝓞 K` over `𝓞 ℚ` is the ideal generated by `NumberField.discr K`.
Not marked `@[simp]` so that `absNorm_relDiscr_ringOfIntegers_rat` remains in simp normal form. -/
theorem relDiscr_ringOfIntegers_rat :
    relDiscr (𝓞 ℚ) (𝓞 K) = Ideal.span {(NumberField.discr K : 𝓞 ℚ)} := by
  rw [← Rat.RingOfIntegers.ideal_span_absNorm_eq_self (relDiscr (𝓞 ℚ) (𝓞 K)),
    absNorm_relDiscr_ringOfIntegers_rat]
  refine Ideal.span_singleton_eq_span_singleton.mpr ?_
  simpa using (Int.associated_natAbs (NumberField.discr K)).symm.map (Int.castRingHom (𝓞 ℚ))

/-- The multiplicity of a rational prime ideal `v` in `relDiscr (𝓞 ℚ) (𝓞 K)` is the multiplicity
of its prime norm in `|NumberField.discr K|`. -/
theorem multiplicity_relDiscr_ringOfIntegers_rat
    (v : IsDedekindDomain.HeightOneSpectrum (𝓞 ℚ)) :
    multiplicity v.asIdeal (relDiscr (𝓞 ℚ) (𝓞 K)) =
      multiplicity (Ideal.absNorm v.asIdeal) (NumberField.discr K).natAbs := by
  rw [Rat.HeightOneSpectrum.multiplicity_asIdeal, absNorm_relDiscr_ringOfIntegers_rat]

/-- The relative discriminant satisfies the transitivity formula in a tower of number fields. -/
theorem relDiscr_tower {L M : Type*} [Field L] [NumberField L] [Field M] [NumberField M]
    [Algebra K L] [Algebra L M] [Algebra K M] [IsScalarTower K L M] :
    relDiscr (𝓞 K) (𝓞 M) =
      relDiscr (𝓞 K) (𝓞 L) ^ Module.finrank L M *
        Ideal.relNorm (𝓞 K) (relDiscr (𝓞 L) (𝓞 M)) := by
  rw [TauCeti.relDiscr_tower (A := 𝓞 K) (B := 𝓞 L) (C := 𝓞 M),
    ← IsFractionRing.finrank_eq (𝓞 L) L (𝓞 M) M]

end TauCeti.NumberField

end
