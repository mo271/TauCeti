module

public import Mathlib.FieldTheory.Galois.IsGaloisGroup
public import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
public import Mathlib.RingTheory.Ideal.Pointwise
public import Mathlib.Analysis.Complex.Norm
import Mathlib.RingTheory.Ideal.Norm.RelNorm
import TauCeti.NumberTheory.DedekindDomain.RelNorm

/-!
# Ideal norms from Galois conjugates

In a Galois extension over `ℤ` or `ℚ`, the absolute norm of an ideal can be read off from its
Galois conjugates in two ways:

* `RingHom.prod_norm_automorphisms_eq_absNorm`: in a Galois number field `K / ℚ`, the product of
  the complex absolute values of the conjugates of an algebraic integer `α` is the absolute norm of
  `Ideal.span {α}`.
* `Ideal.prod_smul_eq_span_absNorm`: for any Dedekind domain `B` that is finite and free over `ℤ`
  and any finite Galois group `G` of `B / ℤ` (in particular `G = Gal(K/ℚ)` acting on `B = 𝓞 K`),
  the product `∏ σ : G, σ • I` is the principal ideal `Ideal.span {(Ideal.absNorm I : B)}`.
-/

public section

open NumberField
open scoped Pointwise

namespace RingHom

/-- In a Galois number field, the product of the absolute values of the conjugates of an
algebraic integer is the absolute norm of its principal ideal, at any complex embedding. -/
theorem prod_norm_automorphisms_eq_absNorm {K : Type*} [Field K] [NumberField K]
    [IsGalois ℚ K] (φ : K →+* ℂ) (α : 𝓞 K) :
    (∏ σ : Gal(K/ℚ), ‖φ (σ (α : K))‖) = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
  classical
  calc
    _ = ‖φ (algebraMap ℚ K (Algebra.norm ℚ (α : K)))‖ := by
      rw [Algebra.norm_eq_prod_automorphisms, map_prod, Complex.norm_prod]
    _ = ‖(Algebra.norm ℤ α : ℂ)‖ := by
      rw [← Algebra.coe_norm_int]
      simp
    _ = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
      rw [Ideal.absNorm_span_singleton, Complex.norm_intCast, Nat.cast_natAbs, Int.cast_abs]

end RingHom

namespace Ideal

/-- **The product of the Galois conjugates of an ideal is generated by its absolute norm.**
For a Dedekind domain `B` that is finite and free over `ℤ` with a finite Galois group `G` over `ℤ`
(such as `G = Gal(K/ℚ)` acting on `B = 𝓞 K` for a Galois number field `K`), `∏ σ : G, σ • I` equals
`Ideal.span {(Ideal.absNorm I : B)}`. -/
theorem prod_smul_eq_span_absNorm {B : Type*} [CommRing B] [IsDedekindDomain B]
    [Module.Free ℤ B] [Module.Finite ℤ B] (G : Type*) [Group G] [Fintype G]
    [MulSemiringAction G B] [IsGaloisGroup G ℤ B] (I : Ideal B) :
    (∏ σ : G, σ • I) = Ideal.span {(Ideal.absNorm I : B)} := by
  rw [prod_smul_eq_map_relNorm (A := ℤ) G I, relNorm_int, map_span, Set.image_singleton,
    map_natCast]

end Ideal
