module

public import TauCeti.Algebra.Category.FGModuleCat.Mat
public import TauCeti.CategoryTheory.GrothendieckGroup.FiniteDimensionalVectorSpace

/-!
# Grothendieck groups of the matrix category

Over any semiring `R`, every object `M : Mat R` decomposes via
`CategoryTheory.Mat.isoFinBiproductUnit` as the biproduct of `Nat.card M` copies of
`CategoryTheory.Mat.unit R`. Consequently, in the split Grothendieck group
`TauCeti.SplitK0 (Mat R)`, `[M] = Nat.card M • [unit R]`, `SplitK0 (Mat R)` is cyclic generated by
`[unit R]`, and scalar extension `SplitK0.map (Mat.mapRingHom φ)` along any semiring homomorphism
`φ : R →+* S` is surjective.

When `R` satisfies `InvariantBasisNumber R`, cardinality is constant on isomorphism classes in
`Mat R` (`CategoryTheory.Mat.natCard_eq_of_iso`) and additive on binary biproducts
(`CategoryTheory.Mat.natCard_biprod`), yielding an additive equivalence
`TauCeti.SplitK0.matCardEquiv R : SplitK0 (Mat R) ≃+ ℤ`. In particular, scalar extension along any
homomorphism `φ : R →+* S` between semirings with invariant basis number induces a bijection on
`SplitK0`.

Over a division ring `K`, comparing with `FGModuleCat.{u} K` along
`CategoryTheory.Mat.fgModuleCatEquivalence K` shows that the canonical comparison
`TauCeti.AbelianK0.fromSplit (Mat K) : SplitK0 (Mat K) →+ AbelianK0 (Mat K)` is an isomorphism
(`TauCeti.AbelianK0.fromSplitMatEquiv K`), identifying `AbelianK0 (Mat K)` with `ℤ` as well
(`TauCeti.AbelianK0.matCardEquiv K`).

## Main definitions

* `TauCeti.SplitK0.matCard`, `TauCeti.SplitK0.matCardEquiv`: the cardinality isomorphism
  `SplitK0 (Mat R) ≃+ ℤ` under `[InvariantBasisNumber R]`.
* `TauCeti.AbelianK0.fromSplitMatEquiv`: `SplitK0 (Mat K) ≃+ AbelianK0 (Mat K)` over a division
  ring `K`.
* `TauCeti.AbelianK0.matCard`, `TauCeti.AbelianK0.matCardEquiv`: the cardinality isomorphism
  `AbelianK0 (Mat K) ≃+ ℤ` over a division ring `K`.
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace TauCeti

universe u

namespace SplitK0

section Semiring

variable (R : Type u) [Semiring R]

/-- Every object class in `SplitK0 (Mat R)` over any semiring `R` is its cardinality times the
class of `Mat.unit R`. -/
theorem of_mat_eq_natCard_nsmul (M : Mat R) :
    (of M : SplitK0 (Mat R)) = Nat.card M • of (Mat.unit R) := by
  rw [of_congr (Mat.isoFinBiproductUnit M), of_biproduct, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin]

/-- Any split-additive invariant on `Mat R` is determined by its value on `Mat.unit R`. -/
theorem AdditiveInvariant.obj_mat_eq_natCard_nsmul {G : Type*} [AddCommGroup G]
    (a : AdditiveInvariant (Mat R) G) (M : Mat R) :
    a.obj M = Nat.card M • a.obj (Mat.unit R) := by
  rw [← lift_of a M, of_mat_eq_natCard_nsmul, map_nsmul, lift_of]

/-- `SplitK0 (Mat R)` is generated as an additive group by `of (Mat.unit R)` over any semiring `R`.
-/
theorem exists_eq_zsmul_of_unit (x : SplitK0 (Mat R)) :
    ∃ n : ℤ, x = n • of (Mat.unit R) := by
  obtain ⟨M, N, rfl⟩ := exists_eq_sub x
  refine ⟨(Nat.card M : ℤ) - (Nat.card N : ℤ), ?_⟩
  rw [sub_zsmul, natCast_zsmul, natCast_zsmul, ← of_mat_eq_natCard_nsmul,
    ← of_mat_eq_natCard_nsmul]
  abel

variable {R} {S : Type u} [Semiring S]

theorem map_mapRingHom_of_unit (φ : R →+* S) :
    map (Mat.mapRingHom φ) (of (Mat.unit R)) = of (Mat.unit S) :=
  map_of (Mat.mapRingHom φ) (Mat.unit R)

/-- Scalar extension along any semiring homomorphism `φ : R →+* S` induces a surjection on
`SplitK0 (Mat ·)`. -/
theorem map_mapRingHom_surjective (φ : R →+* S) :
    Function.Surjective (map (Mat.mapRingHom φ)) :=
  surjective_of_forall_of_mem_range fun M ↦
    ⟨Nat.card M • of (Mat.unit R), by
      rw [map_nsmul, map_mapRingHom_of_unit, ← of_mat_eq_natCard_nsmul]⟩

end Semiring

section InvariantBasisNumber

variable (R : Type u) [Semiring R] [InvariantBasisNumber R]

private def matCardInvariant : AdditiveInvariant (Mat R) ℤ where
  obj M := Nat.card M
  map_iso {_ _} e := congrArg Int.ofNat (Mat.natCard_eq_of_iso e)
  map_biprod M N := by rw [Mat.natCard_biprod, Nat.cast_add]

/-- Cardinality of the index type as an additive homomorphism `SplitK0 (Mat R) →+ ℤ` over a
semiring `R` with invariant basis number. -/
def matCard : SplitK0 (Mat R) →+ ℤ :=
  lift (matCardInvariant R)

@[simp]
theorem matCard_of (M : Mat R) : matCard R (of M) = Nat.card M :=
  lift_of (matCardInvariant R) M

theorem matCard_of_unit : matCard R (of (Mat.unit R)) = 1 := by
  simp

private theorem eq_matCard_zsmul (x : SplitK0 (Mat R)) :
    x = matCard R x • of (Mat.unit R) := by
  obtain ⟨n, rfl⟩ := exists_eq_zsmul_of_unit R x
  simp

/-- Over a semiring `R` with invariant basis number, cardinality identifies `SplitK0 (Mat R)` with
`ℤ`. -/
def matCardEquiv : SplitK0 (Mat R) ≃+ ℤ :=
  AddEquiv.ofBijective (matCard R)
    ⟨fun x y h ↦ by rw [eq_matCard_zsmul R x, eq_matCard_zsmul R y, h],
     fun n ↦ ⟨n • of (Mat.unit R), by simp⟩⟩

@[simp]
theorem matCardEquiv_apply (x : SplitK0 (Mat R)) :
    matCardEquiv R x = matCard R x :=
  AddEquiv.ofBijective_apply _ _ _

theorem matCardEquiv_of (M : Mat R) :
    matCardEquiv R (of M) = Nat.card M := by
  rw [matCardEquiv_apply, matCard_of]

@[simp]
theorem matCardEquiv_symm_apply (n : ℤ) :
    (matCardEquiv R).symm n = n • of (Mat.unit R) := by
  apply (matCardEquiv R).injective
  simp

variable {R} {S : Type u} [Semiring S] [InvariantBasisNumber S]

/-- Scalar extension `Mat.mapRingHom φ` commutes with `matCard`. -/
@[simp]
theorem matCard_comp_map_mapRingHom (φ : R →+* S) :
    (matCard S).comp (map (Mat.mapRingHom φ)) = matCard R :=
  hom_ext fun M ↦ by
    simp only [AddMonoidHom.comp_apply, map_of, matCard_of]
    rfl

/-- Scalar extension along a homomorphism `φ : R →+* S` between semirings with invariant basis
number induces a bijection `SplitK0 (Mat R) → SplitK0 (Mat S)`. -/
theorem map_mapRingHom_bijective (φ : R →+* S) :
    Function.Bijective (map (Mat.mapRingHom φ)) := by
  refine ⟨fun x y h ↦ (matCardEquiv R).injective ?_, map_mapRingHom_surjective φ⟩
  simpa only [matCardEquiv_apply, ← AddMonoidHom.comp_apply, matCard_comp_map_mapRingHom] using
    congrArg (matCard S) h

end InvariantBasisNumber

section DivisionRing

variable (K : Type u) [DivisionRing K]

/-- On `SplitK0 (Mat K)`, `Mat.toFGModuleCat K` intertwines `matCard` with `finrank`. -/
@[simp]
theorem finrank_comp_map_toFGModuleCat :
    (finrank K).comp (map (Mat.toFGModuleCat K)) = matCard K :=
  hom_ext fun M ↦ by
    rw [AddMonoidHom.comp_apply, map_of, finrank_of, Mat.finrank_toFGModuleCat_obj, matCard_of]

end DivisionRing

end SplitK0

namespace AbelianK0

variable (K : Type u) [DivisionRing K]

/-- Cardinality of the index type on `AbelianK0 (Mat K)`, defined by transporting `finrank` along
`Mat.fgModuleCatEquivalence K`. -/
def matCard : AbelianK0 (Mat K) →+ ℤ :=
  (finrank K).comp (mapEquiv (Mat.fgModuleCatEquivalence K)).toAddMonoidHom

@[simp]
theorem matCard_of (M : Mat K) : matCard K (of M) = Nat.card M := by
  rw [matCard, AddMonoidHom.comp_apply, AddEquiv.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass,
    mapEquiv_of, Mat.fgModuleCatEquivalence_functor, finrank_of, Mat.finrank_toFGModuleCat_obj]

@[simp]
theorem matCard_comp_fromSplit :
    (matCard K).comp (fromSplit (Mat K)) = SplitK0.matCard K :=
  SplitK0.hom_ext fun M ↦ by simp

/-- Over a division ring `K`, the canonical comparison `fromSplit (Mat K) : SplitK0 (Mat K) →+
AbelianK0 (Mat K)` is bijective. -/
theorem fromSplit_mat_bijective : Function.Bijective (fromSplit (Mat K)) := by
  refine ⟨fun x y h ↦ (SplitK0.matCardEquiv K).injective ?_, fromSplit_surjective (Mat K)⟩
  simpa only [SplitK0.matCardEquiv_apply, ← AddMonoidHom.comp_apply, matCard_comp_fromSplit] using
    congrArg (matCard K) h

/-- Over a division ring `K`, `fromSplit (Mat K)` upgrades to an additive isomorphism
`SplitK0 (Mat K) ≃+ AbelianK0 (Mat K)`. -/
def fromSplitMatEquiv : SplitK0 (Mat K) ≃+ AbelianK0 (Mat K) :=
  AddEquiv.ofBijective (fromSplit (Mat K)) (fromSplit_mat_bijective K)

@[simp]
theorem fromSplitMatEquiv_apply (x : SplitK0 (Mat K)) :
    fromSplitMatEquiv K x = fromSplit (Mat K) x :=
  AddEquiv.ofBijective_apply _ _ _

theorem fromSplitMatEquiv_of (M : Mat K) :
    fromSplitMatEquiv K (SplitK0.of M) = of M := by
  rw [fromSplitMatEquiv_apply, fromSplit_of]

@[simp]
theorem fromSplitMatEquiv_symm_of (M : Mat K) :
    (fromSplitMatEquiv K).symm (of M) = SplitK0.of M := by
  apply (fromSplitMatEquiv K).injective
  simp

/-- Over a division ring `K`, cardinality identifies `AbelianK0 (Mat K)` with `ℤ`. -/
def matCardEquiv : AbelianK0 (Mat K) ≃+ ℤ :=
  (fromSplitMatEquiv K).symm.trans (SplitK0.matCardEquiv K)

@[simp]
theorem matCardEquiv_apply (x : AbelianK0 (Mat K)) :
    matCardEquiv K x = matCard K x :=
  DFunLike.congr_fun
    (hom_ext (f := (matCardEquiv K).toAddMonoidHom) (g := matCard K) fun M ↦ by simp [matCardEquiv])
    x

theorem matCardEquiv_of (M : Mat K) :
    matCardEquiv K (of M) = Nat.card M := by
  rw [matCardEquiv_apply, matCard_of]

@[simp]
theorem matCardEquiv_symm_apply (n : ℤ) :
    (matCardEquiv K).symm n = n • of (Mat.unit K) := by
  apply (matCardEquiv K).injective
  simp

end AbelianK0

end TauCeti
