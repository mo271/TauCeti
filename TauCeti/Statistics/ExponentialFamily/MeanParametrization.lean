/-!
# Mean parametrization of natural exponential families

For a natural exponential family generated by a measure `ν` on a finite-dimensional real inner
product space `E` with natural parameter space `N`, this file studies the mean map
`η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η` on `interior N`:

* `TauCeti.analyticAt_integral_exponentialFamilyMeasure` and
  `TauCeti.analyticOnNhd_integral_exponentialFamilyMeasure`: the mean map is real analytic on
  `interior N`.
* `TauCeti.inner_fderiv_integral_exponentialFamilyMeasure_eq_covariance`: the derivative of the mean
  map at `η ∈ interior N` is the covariance operator.
* `TauCeti.exists_continuousLinearEquiv_fderiv_integral_exponentialFamilyMeasure`: in a minimal
  family, the derivative of the mean map at every `η ∈ interior N` is a continuous linear
  equivalence.
* `TauCeti.injOn_integral_exponentialFamilyMeasure`: in a minimal family, the mean map is injective
  on `interior N`.
* `TauCeti.exists_analytic_inverse_exponential_family_mean`: for a nonzero minimal family with
  nonempty open natural parameter space `N`, the mean map is an analytic bijection of `N` onto
  `interior (convexHull ℝ ν.support)` with analytic inverse.

This follows Lawrence D. Brown, *Fundamentals of Statistical Exponential Families* (IMS Lecture
Notes–Monograph Series, Vol. 9, 1986, Chapter 2, Corollary 2.5, and Chapter 3, Theorem 3.6).
-/

public section

open MeasureTheory Real Set Filter ProbabilityTheory
open scoped Topology

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E]

/-- On `interior (naturalParameterSpace ν id)`, the mean map equals the Riesz dual of the
Fréchet derivative of `logPartition ν id`. -/
private lemma integral_exponentialFamilyMeasure_eq_toDual_symm_fderiv (ν : Measure E) {η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) :
    (∫ x, x ∂exponentialFamilyMeasure ν id η) =
      (InnerProductSpace.toDual ℝ E).symm (fderiv ℝ (logPartition ν id) η) := by
  have hfderiv : fderiv ℝ (logPartition ν id) η =
      InnerProductSpace.toDual ℝ E (∫ x, x ∂exponentialFamilyMeasure ν id η) := by
    rw [(hasFDerivAt_logPartition ν hη).fderiv]
    ext v
    simp [InnerProductSpace.toDual_apply_apply]
  rw [hfderiv, LinearIsometryEquiv.symm_apply_apply]

/-- The mean map `η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η` is real analytic at every point of
`interior (naturalParameterSpace ν id)`. -/
theorem analyticAt_integral_exponentialFamilyMeasure (ν : Measure E) {η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) :
    AnalyticAt ℝ (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ) η := by
  have hfderiv_anal : AnalyticAt ℝ (fderiv ℝ (logPartition ν id)) η :=
    (analyticOnNhd_logPartition ν).fderiv_of_isOpen isOpen_interior η hη
  have hcomp : AnalyticAt ℝ
      (fun ζ ↦ (InnerProductSpace.toDual ℝ E).symm (fderiv ℝ (logPartition ν id) ζ)) η :=
    ((InnerProductSpace.toDual ℝ E).symm.toContinuousLinearMap.analyticAt _).comp hfderiv_anal
  refine hcomp.congr ?_
  filter_upwards [isOpen_interior.mem_nhds hη] with ζ hζ
  exact (integral_exponentialFamilyMeasure_eq_toDual_symm_fderiv ν hζ).symm

/-- The mean map `η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η` is real analytic on
`interior (naturalParameterSpace ν id)`. -/
theorem analyticOnNhd_integral_exponentialFamilyMeasure (ν : Measure E) :
    AnalyticOnNhd ℝ (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ)
      (interior (naturalParameterSpace ν id)) :=
  fun _ hη ↦ analyticAt_integral_exponentialFamilyMeasure ν hη

/-- At every `η ∈ interior (naturalParameterSpace ν id)`, the derivative of the mean map is the
covariance operator: `⟪fderiv M η u, v⟫ = cov[⟪u, ·⟫, ⟪v, ·⟫; P_η]`. -/
theorem inner_fderiv_integral_exponentialFamilyMeasure_eq_covariance (ν : Measure E) {η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) (u v : E) :
    inner ℝ (fderiv ℝ (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ) η u) v =
      cov[fun x ↦ inner ℝ u x, fun x ↦ inner ℝ v x; exponentialFamilyMeasure ν id η] := by
  let D : StrongDual ℝ E →L[ℝ] E := (InnerProductSpace.toDual ℝ E).symm.toContinuousLinearMap
  have hfeq : (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ) =ᶠ[𝓝 η]
      fun ζ ↦ D (fderiv ℝ (logPartition ν id) ζ) := by
    filter_upwards [isOpen_interior.mem_nhds hη] with ζ hζ
    exact integral_exponentialFamilyMeasure_eq_toDual_symm_fderiv ν hζ
  have hdiff : DifferentiableAt ℝ (fderiv ℝ (logPartition ν id)) η :=
    ((analyticOnNhd_logPartition ν).fderiv_of_isOpen isOpen_interior η hη).differentiableAt
  have hhas : HasFDerivAt (fun ζ ↦ D (fderiv ℝ (logPartition ν id) ζ))
      (D.comp (fderiv ℝ (fderiv ℝ (logPartition ν id)) η)) η :=
    D.hasFDerivAt.comp η hdiff.hasFDerivAt
  have hD : ∀ f : StrongDual ℝ E, D f = (InnerProductSpace.toDual ℝ E).symm f := fun _ ↦ rfl
  rw [hfeq.fderiv_eq, hhas.fderiv, ContinuousLinearMap.comp_apply, hD,
    InnerProductSpace.toDual_symm_apply, fderiv_fderiv_logPartition_apply ν hη u v]

/-- In a minimal natural exponential family, the derivative of the mean map at every
`η ∈ interior (naturalParameterSpace ν id)` is a continuous linear equivalence. -/
theorem exists_continuousLinearEquiv_fderiv_integral_exponentialFamilyMeasure {ν : Measure E}
    (hminimal : IsMinimalExponentialFamily ν id) {η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) :
    ∃ e : E ≃L[ℝ] E,
      (e : E →L[ℝ] E) = fderiv ℝ (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ) η := by
  set L : E →L[ℝ] E := fderiv ℝ (fun ζ ↦ ∫ x, x ∂exponentialFamilyMeasure ν id ζ) η
  have hinj : Function.Injective L := by
    rw [injective_iff_map_eq_zero]
    intro u hu
    by_contra hu0
    have hpos : 0 < fderiv ℝ (fderiv ℝ (logPartition ν id)) η u u :=
      fderiv_fderiv_logPartition_self_pos hminimal hη hu0
    rw [fderiv_fderiv_logPartition_apply ν hη u u,
      ← inner_fderiv_integral_exponentialFamilyMeasure_eq_covariance ν hη u u] at hpos
    simp [L, hu] at hpos
  have hbij : Function.Bijective L.toLinearMap :=
    ⟨hinj, LinearMap.injective_iff_surjective.mp hinj⟩
  refine ⟨(LinearEquiv.ofBijective L.toLinearMap hbij).toContinuousLinearEquivOfContinuous
    L.continuous, ?_⟩
  ext u
  rfl

/-- In a minimal natural exponential family, the mean map is injective on
`interior (naturalParameterSpace ν id)`. -/
theorem injOn_integral_exponentialFamilyMeasure {ν : Measure E}
    (hminimal : IsMinimalExponentialFamily ν id) :
    Set.InjOn (fun η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η)
      (interior (naturalParameterSpace ν id)) := by
  intro η₁ hη₁ η₂ hη₂ heq
  have hmax₁ := (isMaxOn_logLikelihood_iff_integral_eq hη₁).mpr rfl
  have hmax₂ := (isMaxOn_logLikelihood_iff_integral_eq hη₂).mpr heq.symm
  exact isMaxOn_logLikelihood_unique hminimal (interior_subset hη₁) (interior_subset hη₂)
    hmax₁ hmax₂

omit [MeasurableSpace E] in
/-- An inverse on an open set `U` to an injective real-analytic map `M` on an open set `N` with
invertible derivative at `g m` is real analytic at `m`. -/
private lemma analyticAt_rightInverse_of_analyticAt {M g : E → E} {N U : Set E} (hN : IsOpen N)
    (hU : IsOpen U) (hMinj : Set.InjOn M N) (hg : ∀ y ∈ U, g y ∈ N ∧ M (g y) = y) {m : E}
    (hm : m ∈ U) (hM_at : AnalyticAt ℝ M (g m))
    {e : E ≃L[ℝ] E} (he : (e : E →L[ℝ] E) = fderiv ℝ M (g m)) :
    AnalyticAt ℝ g m := by
  obtain ⟨hη, hMm⟩ := hg m hm
  set η : E := g m
  have hM_strict : HasStrictFDerivAt M (e : E →L[ℝ] E) η := by
    simpa only [he] using hM_at.hasStrictFDerivAt
  let φ : OpenPartialHomeomorph E E := hM_strict.toOpenPartialHomeomorph M
  have hη_src : η ∈ φ.source := hM_strict.mem_toOpenPartialHomeomorph_source
  have hm_tgt : m ∈ φ.target := hMm ▸ hM_strict.image_mem_toOpenPartialHomeomorph_target
  have hφ_symm_anal : AnalyticAt ℝ φ.symm m := by
    have h1 : AnalyticAt ℝ φ.symm (φ η) := φ.analyticAt_symm' hη_src hM_at he.symm
    simpa only [φ, HasStrictFDerivAt.toOpenPartialHomeomorph_coe, hMm] using h1
  have hφ_symm_m : φ.symm m = η := by
    have h1 : φ.symm (φ η) = η := φ.left_inv hη_src
    simpa only [φ, HasStrictFDerivAt.toOpenPartialHomeomorph_coe, hMm] using h1
  have hmem_N : ∀ᶠ y in 𝓝 m, φ.symm y ∈ N :=
    (φ.continuousAt_symm hm_tgt).preimage_mem_nhds (hφ_symm_m.symm ▸ hN.mem_nhds hη)
  refine hφ_symm_anal.congr ?_
  filter_upwards [hU.mem_nhds hm, φ.open_target.mem_nhds hm_tgt, hmem_N] with y hyU hytgt hyN
  have hMy : M (φ.symm y) = y := φ.right_inv hytgt
  exact hMinj hyN (hg y hyU).1 (hMy.trans (hg y hyU).2.symm)

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] in
/-- Pushing a measure `ν` forward along a measurable map `f : (E, m₁) → (E, m₂)` that agrees
`ν`-a.e. with `id` preserves the topological support when `m₂` makes open sets measurable. -/
private lemma support_map_eq_of_ae_eq_id {m₁ : MeasurableSpace E} [m₂ : MeasurableSpace E]
    [OpensMeasurableSpace E] {ν : @Measure E m₁} {f : E → E}
    (hf_meas : Measurable[m₁, m₂] f) (hf_ae : (id : E → E) =ᵐ[ν] f) :
    (@Measure.map E E m₁ m₂ f ν).support = @Measure.support E _ m₁ ν := by
  have hU_eq : ∀ U : Set E, IsOpen U → (@Measure.map E E m₁ m₂ f ν) U = ν U := fun U hU ↦ by
    rw [@Measure.map_apply E E m₁ m₂ ν f hf_meas U hU.measurableSet]
    exact measure_congr (hf_ae.mono fun y hy ↦ by simp [Set.mem_preimage, ← hy])
  ext x
  simp only [Measure.mem_support_iff_forall]
  constructor <;> intro h s hs <;> obtain ⟨U, hUs, hUopen, hxU⟩ := mem_nhds_iff.mp hs
  · exact (hU_eq U hUopen ▸ h U (hUopen.mem_nhds hxU)).trans_le (measure_mono hUs)
  · exact ((hU_eq U hUopen).symm ▸ h U (hUopen.mem_nhds hxU)).trans_le (measure_mono hUs)

omit [MeasurableSpace E] in
/-- Transferring a measure `ν` on `(E, m₁)` along a strongly measurable `f` equal `ν`-a.e. to `id`
into a Borel measurable space `(E, m₂)` supplies an MLE maximizer at every point of
`interior (convexHull ℝ ν.support)`. -/
private lemma exists_isMaxOn_logLikelihood_of_ae_eq_id {m₁ : MeasurableSpace E}
    [m₂ : MeasurableSpace E] [BorelSpace E] {ν : @Measure E m₁} (hne : ν ≠ 0)
    (hminimal : @IsMinimalExponentialFamily E E m₁ _ _ ν id)
    (hNne : (@naturalParameterSpace E E m₁ _ _ ν id).Nonempty)
    {f : E → E} (hf_smeas : StronglyMeasurable[m₁] f) (hf_ae : (id : E → E) =ᵐ[ν] f)
    {m : E} (hm : m ∈ interior (convexHull ℝ (@Measure.support E _ m₁ ν))) :
    ∃ η ∈ @naturalParameterSpace E E m₁ _ _ ν id,
      IsMaxOn (fun ζ ↦ inner ℝ ζ m - @logPartition E E m₁ _ _ ν id ζ)
        (@naturalParameterSpace E E m₁ _ _ ν id) η := by
  have hf_meas : Measurable[m₁, m₂] f := hf_smeas.measurable
  let ν' : Measure E := @Measure.map E E m₁ m₂ f ν
  have hN_eq : naturalParameterSpace ν' id = @naturalParameterSpace E E m₁ _ _ ν id := by
    rw [@naturalParameterSpace_map_id E E m₁ _ _ m₂ _ ν f hf_meas.aemeasurable]
    ext ζ
    rw [@mem_naturalParameterSpace_iff E E m₁ _ _ ν f,
      @mem_naturalParameterSpace_iff E E m₁ _ _ ν id]
    exact integrable_congr (hf_ae.symm.mono fun x hx ↦ by simp [hx])
  have hA_eq : logPartition ν' id = @logPartition E E m₁ _ _ ν id := by
    rw [@logPartition_map_id E E m₁ _ _ m₂ _ ν f hf_meas.aemeasurable]
    ext ζ
    rw [@logPartition_def E E m₁ _ _ ν f, @logPartition_def E E m₁ _ _ ν id]
    exact congrArg Real.log (integral_congr_ae (hf_ae.symm.mono fun x hx ↦ by simp [hx]))
  have hmin' : IsMinimalExponentialFamily ν' id := by
    rw [@isMinimalExponentialFamily_map_id_iff E E m₁ _ _ m₂ _ ν f hf_meas.aemeasurable,
      @isMinimalExponentialFamily_iff E E m₁ _ _ ν f]
    intro u hu c hae
    exact (@isMinimalExponentialFamily_iff E E m₁ _ _ ν id).mp hminimal u hu c
      (hae.mp (hf_ae.mono fun x hx h ↦ by simpa [id, ← hx] using h))
  have hne' : ν' ≠ 0 := by
    intro h0
    have huniv : ν Set.univ = 0 := by
      have := congrArg (fun μ : Measure E ↦ μ Set.univ) h0
      simpa [ν', @Measure.map_apply E E m₁ m₂ ν f hf_meas Set.univ MeasurableSet.univ] using this
    exact hne (Measure.measure_univ_eq_zero.mp huniv)
  have hsupp : ν'.support = @Measure.support E _ m₁ ν :=
    support_map_eq_of_ae_eq_id hf_meas hf_ae
  have hres := (exists_isMaxOn_logLikelihood_iff_mem_interior_convexHull_support ν' hne' hmin'
    (hN_eq.symm ▸ hNne) m).mpr (hsupp.symm ▸ hm)
  simpa only [hN_eq, hA_eq] using hres

/-- When `naturalParameterSpace ν id` is open and nonempty, `id : E → E` is a.e.-strongly
measurable, so transferring `ν` to `borel E` supplies a maximizer of the log-likelihood for every
`m ∈ interior (convexHull ℝ ν.support)` without assuming `[OpensMeasurableSpace E]`. -/
private lemma exists_isMaxOn_logLikelihood_of_isOpen {ν : Measure E} (hne : ν ≠ 0)
    (hminimal : IsMinimalExponentialFamily ν id) (hN : IsOpen (naturalParameterSpace ν id))
    (hNne : (naturalParameterSpace ν id).Nonempty) {m : E}
    (hm : m ∈ interior (convexHull ℝ ν.support)) :
    ∃ η ∈ naturalParameterSpace ν id,
      IsMaxOn (fun ζ ↦ inner ℝ ζ m - logPartition ν id ζ) (naturalParameterSpace ν id) η := by
  obtain ⟨η₀, hη₀⟩ := hNne
  have hac : ν ≪ exponentialFamilyMeasure ν id η₀ := by
    rw [exponentialFamilyMeasure_def]
    exact absolutelyContinuous_tilted (mem_naturalParameterSpace_iff.mp hη₀)
  have hid : AEStronglyMeasurable (id : E → E) ν := by
    have hη₀_int : η₀ ∈ interior (naturalParameterSpace ν id) := hN.interior_eq.symm ▸ hη₀
    exact (integrable_id_exponentialFamilyMeasure hη₀_int).aestronglyMeasurable.mono_ac hac
  exact @exists_isMaxOn_logLikelihood_of_ae_eq_id E _ _ _ _ (borel E)
    (@BorelSpace.mk E _ (borel E) rfl) ν hne hminimal ⟨η₀, hη₀⟩ (hid.mk id)
    hid.stronglyMeasurable_mk hid.ae_eq_mk m hm

/-- **Mean parametrization of a regular minimal natural exponential family.** When `ν ≠ 0`
generates a minimal family with nonempty open natural parameter space `N`, the mean map
`η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η` is a real-analytic bijection of `N` onto
`interior (convexHull ℝ ν.support)` with real-analytic inverse. -/
theorem exists_analytic_inverse_exponential_family_mean (ν : Measure E) (hne : ν ≠ 0)
    (hminimal : IsMinimalExponentialFamily ν id) (hN : IsOpen (naturalParameterSpace ν id))
    (hNne : (naturalParameterSpace ν id).Nonempty) :
    ∃ g : E → E,
      AnalyticOnNhd ℝ (fun η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η)
          (naturalParameterSpace ν id) ∧
        AnalyticOnNhd ℝ g (interior (convexHull ℝ ν.support)) ∧
        (∀ η ∈ naturalParameterSpace ν id,
          (∫ x, x ∂exponentialFamilyMeasure ν id η) ∈ interior (convexHull ℝ ν.support) ∧
            g (∫ x, x ∂exponentialFamilyMeasure ν id η) = η) ∧
        ∀ m ∈ interior (convexHull ℝ ν.support),
          g m ∈ naturalParameterSpace ν id ∧ (∫ x, x ∂exponentialFamilyMeasure ν id (g m)) = m := by
  let M : E → E := fun η ↦ ∫ x, x ∂exponentialFamilyMeasure ν id η
  let U : Set E := interior (convexHull ℝ ν.support)
  have hManal : AnalyticOnNhd ℝ M (naturalParameterSpace ν id) :=
    hN.interior_eq ▸ analyticOnNhd_integral_exponentialFamilyMeasure ν
  have hMinj : Set.InjOn M (naturalParameterSpace ν id) :=
    hN.interior_eq ▸ injOn_integral_exponentialFamilyMeasure hminimal
  have hMapsTo : ∀ η ∈ naturalParameterSpace ν id, M η ∈ U := fun η hη ↦
    integral_mem_interior_convexHull_support hne hminimal (hN.interior_eq.symm ▸ hη)
  have hsurj : ∀ m ∈ U, ∃ η ∈ naturalParameterSpace ν id, M η = m := fun m hm ↦ by
    obtain ⟨η, hη, hmax⟩ := exists_isMaxOn_logLikelihood_of_isOpen hne hminimal hN hNne hm
    exact ⟨η, hη, (isMaxOn_logLikelihood_iff_integral_eq (hN.interior_eq.symm ▸ hη)).mp hmax⟩
  classical
  let g : E → E := fun m ↦ if h : m ∈ U then (hsurj m h).choose else 0
  have hg_spec : ∀ m ∈ U, g m ∈ naturalParameterSpace ν id ∧ M (g m) = m := fun m hm ↦ by
    simp only [g, hm, ↓reduceDIte]
    exact (hsurj m hm).choose_spec
  have hg_left : ∀ η ∈ naturalParameterSpace ν id, M η ∈ U ∧ g (M η) = η := fun η hη ↦ by
    have hm : M η ∈ U := hMapsTo η hη
    exact ⟨hm, hMinj (hg_spec (M η) hm).1 hη (hg_spec (M η) hm).2⟩
  refine ⟨g, hManal, fun m hm ↦ ?_, hg_left, hg_spec⟩
  have hη : g m ∈ naturalParameterSpace ν id := (hg_spec m hm).1
  obtain ⟨e, he⟩ := exists_continuousLinearEquiv_fderiv_integral_exponentialFamilyMeasure
    hminimal (hN.interior_eq.symm ▸ hη)
  exact analyticAt_rightInverse_of_analyticAt hN isOpen_interior hMinj hg_spec hm
    (hManal (g m) hη) he

end TauCeti
