/-!
# Natural exponential families

This file introduces natural exponential families in a real inner product space, following
Lawrence D. Brown, *Fundamentals of Statistical Exponential Families* (IMS Lecture Notes–Monograph
Series, Vol. 9, 1986, Chapter 1), and establishes their basic structural properties: reduction to
the pushforward law `ν.map T`, bridges to Mathlib's scalar moment-generating-function API,
convexity and strict convexity of the natural parameter space and log partition function, and the
support characterization of minimality in finite dimensions.

## Main definitions

* `TauCeti.naturalParameterSpace`: `{η | Integrable (fun x ↦ Real.exp (inner ℝ η (T x))) ν}`.
* `TauCeti.logPartition`: `η ↦ Real.log (∫ x, Real.exp (inner ℝ η (T x)) ∂ν)`.
* `TauCeti.exponentialFamilyMeasure`: `η ↦ ν.tilted (fun x ↦ inner ℝ η (T x))`, built directly on
  Mathlib's exponential tilt `MeasureTheory.Measure.tilted` so that `isProbabilityMeasure_tilted`,
  `tilted_tilted`, `tilted_absolutelyContinuous`, and `absolutelyContinuous_tilted` apply directly.
* `TauCeti.IsMinimalExponentialFamily`: no nonzero linear functional `⟪u, T ·⟫` is `ν`-a.e.
  constant.

## Main results

* `TauCeti.naturalParameterSpace_real`, `TauCeti.logPartition_real`: for `E = ℝ`, these coincide
  with Mathlib's `ProbabilityTheory.integrableExpSet` and `ProbabilityTheory.cgf`.
* `TauCeti.naturalParameterSpace_map_id`, `TauCeti.logPartition_map_id`,
  `TauCeti.map_exponentialFamilyMeasure`, `TauCeti.isMinimalExponentialFamily_map_id_iff`: pushing
  `ν` forward along an a.e.-measurable statistic `T` reduces the family to the identity statistic.
* `TauCeti.convex_naturalParameterSpace`, `TauCeti.convexOn_logPartition`,
  `TauCeti.strictConvexOn_logPartition`: convexity of the natural parameter space and (strict)
  convexity of the log partition function.
* `TauCeti.isMinimalExponentialFamily_id_iff_affineSpan_support_eq_top` and
  `TauCeti.isMinimalExponentialFamily_id_iff_nonempty_interior_convexHull_support`: for a nonzero
  measure on a finite-dimensional real inner product space, minimality of the identity family is
  equivalent to full affine span of the support, and to nonempty interior of its convex hull.
-/

public section

open MeasureTheory ProbabilityTheory Real Set

namespace TauCeti

section Defs

variable {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The natural parameter space of the natural exponential family generated by a measure `ν` and a
statistic `T : X → E`: the set of parameters `η` for which `x ↦ exp ⟪η, T x⟫` is `ν`-integrable. -/
def naturalParameterSpace (ν : Measure X) (T : X → E) : Set E :=
  {η | Integrable (fun x ↦ Real.exp (inner ℝ η (T x))) ν}

/-- The log partition function (cumulant-generating function) of the natural exponential family
generated by `ν` and `T`: `η ↦ log (∫ x, exp ⟪η, T x⟫ ∂ν)`. -/
noncomputable def logPartition (ν : Measure X) (T : X → E) (η : E) : ℝ :=
  Real.log (∫ x, Real.exp (inner ℝ η (T x)) ∂ν)

/-- The member of the natural exponential family generated by `ν` and `T` at natural parameter `η`,
defined as Mathlib's exponential tilt `ν.tilted (fun x ↦ ⟪η, T x⟫)`. -/
noncomputable def exponentialFamilyMeasure (ν : Measure X) (T : X → E) (η : E) : Measure X :=
  ν.tilted fun x ↦ inner ℝ η (T x)

/-- Minimality of a natural exponential family: no nonzero linear functional of the statistic `T`
is `ν`-almost everywhere constant. -/
def IsMinimalExponentialFamily (ν : Measure X) (T : X → E) : Prop :=
  ∀ u : E, u ≠ 0 → ∀ c : ℝ, ¬ ∀ᵐ x ∂ν, inner ℝ u (T x) = c

variable {ν : Measure X} {T : X → E} {η : E}

@[simp]
theorem mem_naturalParameterSpace_iff :
    η ∈ naturalParameterSpace ν T ↔ Integrable (fun x ↦ Real.exp (inner ℝ η (T x))) ν := by
  rfl

theorem logPartition_def (ν : Measure X) (T : X → E) (η : E) :
    logPartition ν T η = Real.log (∫ x, Real.exp (inner ℝ η (T x)) ∂ν) := by
  rfl

theorem exponentialFamilyMeasure_def (ν : Measure X) (T : X → E) (η : E) :
    exponentialFamilyMeasure ν T η = ν.tilted fun x ↦ inner ℝ η (T x) := by
  rfl

theorem isMinimalExponentialFamily_iff :
    IsMinimalExponentialFamily ν T ↔ ∀ u : E, u ≠ 0 → ∀ c : ℝ, ¬ ∀ᵐ x ∂ν, inner ℝ u (T x) = c := by
  rfl

instance isZeroOrProbabilityMeasure_exponentialFamilyMeasure (ν : Measure X) (T : X → E) (η : E) :
    IsZeroOrProbabilityMeasure (exponentialFamilyMeasure ν T η) :=
  inferInstanceAs (IsZeroOrProbabilityMeasure (ν.tilted _))

@[simp]
theorem naturalParameterSpace_zero (T : X → E) :
    naturalParameterSpace (0 : Measure X) T = Set.univ := by
  ext η
  simp [naturalParameterSpace]

@[simp]
theorem logPartition_zero_measure (T : X → E) (η : E) :
    logPartition (0 : Measure X) T η = 0 := by
  simp [logPartition]

@[simp]
theorem exponentialFamilyMeasure_zero_measure (T : X → E) (η : E) :
    exponentialFamilyMeasure (0 : Measure X) T η = 0 := by
  simp [exponentialFamilyMeasure]

/-- For a nonzero measure `ν` and a natural parameter `η`, `exp (logPartition ν T η)` recovers the
partition function `∫ x, exp ⟪η, T x⟫ ∂ν`. -/
theorem exp_logPartition (hν : ν ≠ 0) (hη : η ∈ naturalParameterSpace ν T) :
    Real.exp (logPartition ν T η) = ∫ x, Real.exp (inner ℝ η (T x)) ∂ν := by
  have : NeZero ν := ⟨hν⟩
  exact Real.exp_log (integral_exp_pos hη)

end Defs

/-! ### Scalar bridges -/

section RealBridge

variable {X : Type*} [MeasurableSpace X]

/-- In dimension one (`E = ℝ`), `naturalParameterSpace ν T` is Mathlib's `integrableExpSet T ν`. -/
theorem naturalParameterSpace_real (ν : Measure X) (T : X → ℝ) :
    naturalParameterSpace ν T = integrableExpSet T ν := by
  ext η
  simp [naturalParameterSpace, integrableExpSet, mul_comm]

/-- In dimension one (`E = ℝ`), `logPartition ν T` is Mathlib's cumulant-generating function
`cgf T ν`. -/
theorem logPartition_real (ν : Measure X) (T : X → ℝ) :
    logPartition ν T = cgf T ν := by
  ext η
  simp [logPartition, cgf, mgf, mul_comm]

end RealBridge

/-! ### Pushforward reduction to the identity statistic -/

section Pushforward

variable {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [OpensMeasurableSpace E]

/-- Pushing `ν` forward along an a.e.-measurable statistic `T` preserves the natural parameter
space. -/
theorem naturalParameterSpace_map_id (ν : Measure X) {T : X → E} (hT : AEMeasurable T ν) :
    naturalParameterSpace (ν.map T) id = naturalParameterSpace ν T := by
  ext η
  have hcont : Continuous fun y : E ↦ Real.exp (inner ℝ η y) := by fun_prop
  simp only [mem_naturalParameterSpace_iff, id_eq]
  exact integrable_map_measure hcont.aestronglyMeasurable hT

/-- Pushing `ν` forward along an a.e.-measurable statistic `T` preserves the log partition
function. -/
theorem logPartition_map_id (ν : Measure X) {T : X → E} (hT : AEMeasurable T ν) :
    logPartition (ν.map T) id = logPartition ν T := by
  ext η
  have hcont : Continuous fun y : E ↦ Real.exp (inner ℝ η y) := by fun_prop
  simp only [logPartition, id_eq]
  rw [integral_map hT hcont.aestronglyMeasurable]

/-- The pushforward of an exponential-family measure along an a.e.-measurable statistic `T` is the
corresponding exponential-family measure of `ν.map T` for the identity statistic. -/
theorem map_exponentialFamilyMeasure (ν : Measure X) {T : X → E} (hT : AEMeasurable T ν) (η : E) :
    (exponentialFamilyMeasure ν T η).map T = exponentialFamilyMeasure (ν.map T) id η := by
  have hinner : Measurable fun y : E ↦ inner ℝ η y :=
    (continuous_const.inner continuous_id).measurable
  have hT_eq : T =ᵐ[ν] hT.mk T := hT.ae_eq_mk
  have hmap_eq : ν.map T = ν.map (hT.mk T) := Measure.map_congr hT_eq
  have htilt_eq : exponentialFamilyMeasure ν T η = exponentialFamilyMeasure ν (hT.mk T) η :=
    tilted_congr (hT_eq.mono fun x hx ↦ by simp [hx])
  have hT_eq' : T =ᵐ[exponentialFamilyMeasure ν (hT.mk T) η] hT.mk T :=
    (tilted_absolutelyContinuous ν _).ae_le hT_eq
  rw [htilt_eq, Measure.map_congr hT_eq', hmap_eq]
  simpa [exponentialFamilyMeasure, Function.comp_def] using
    Measure.map_tilted ν hT.measurable_mk hinner

/-- Minimality of a family with a.e.-measurable statistic `T` is equivalent to minimality of the
pushforward family `ν.map T` with the identity statistic. -/
theorem isMinimalExponentialFamily_map_id_iff (ν : Measure X) {T : X → E} (hT : AEMeasurable T ν) :
    IsMinimalExponentialFamily (ν.map T) id ↔ IsMinimalExponentialFamily ν T := by
  refine forall_congr' fun u ↦ imp_congr_right fun _ ↦ forall_congr' fun c ↦ not_congr ?_
  have hmeas : MeasurableSet {y : E | inner ℝ u y = c} :=
    (isClosed_eq (continuous_const.inner continuous_id) continuous_const).measurableSet
  exact ae_map_iff hT hmeas

end Pushforward

/-! ### Convexity of the natural parameter space and log partition function -/

section Convexity

variable {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E] [InnerProductSpace ℝ E]

omit [MeasurableSpace X] in
/-- Pointwise geometric–arithmetic factorization of `exp ⟪a • η₁ + b • η₂, T x⟫`. -/
private lemma exp_inner_convex_eq (T : X → E) (η₁ η₂ : E) (a b : ℝ) (x : X) :
    Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) =
      Real.exp (inner ℝ η₁ (T x)) ^ a * Real.exp (inner ℝ η₂ (T x)) ^ b := by
  rw [inner_add_left, inner_smul_left, inner_smul_left, Real.exp_add, ← Real.exp_mul,
    ← Real.exp_mul]
  simp [mul_comm]

/-- The natural parameter space `naturalParameterSpace ν T` is convex. -/
theorem convex_naturalParameterSpace (ν : Measure X) (T : X → E) :
    Convex ℝ (naturalParameterSpace ν T) := by
  intro η₁ h₁ η₂ h₂ a b ha hb hab
  have hm : AEStronglyMeasurable (fun x ↦ Real.exp (inner ℝ (a • η₁ + b • η₂) (T x))) ν := by
    have hlin : AEMeasurable (fun x ↦ a * inner ℝ η₁ (T x) + b * inner ℝ η₂ (T x)) ν :=
      ((aemeasurable_of_aemeasurable_exp h₁.aemeasurable).const_mul a).add
        ((aemeasurable_of_aemeasurable_exp h₂.aemeasurable).const_mul b)
    have heq : (fun x ↦ Real.exp (inner ℝ (a • η₁ + b • η₂) (T x))) =
        fun x ↦ Real.exp (a * inner ℝ η₁ (T x) + b * inner ℝ η₂ (T x)) := by
      ext x; simp [inner_add_left, inner_smul_left]
    rw [heq]
    exact (Real.measurable_exp.comp_aemeasurable hlin).aestronglyMeasurable
  refine ((h₁.const_mul a).add (h₂.const_mul b)).mono' hm (ae_of_all _ fun x ↦ ?_)
  rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), exp_inner_convex_eq]
  exact Real.geom_mean_le_arith_mean2_weighted ha hb (Real.exp_nonneg _) (Real.exp_nonneg _) hab

/-- Normalized AM–GM inequality for the partition function at a convex combination of parameters. -/
private lemma integral_exp_inner_convex_le {ν : Measure X} {T : X → E} (hν : ν ≠ 0)
    {η₁ η₂ : E} (h₁ : η₁ ∈ naturalParameterSpace ν T) (h₂ : η₂ ∈ naturalParameterSpace ν T)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) ∂ν ≤
      (∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν) ^ a *
        (∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν) ^ b := by
  have : NeZero ν := ⟨hν⟩
  set Z₁ := ∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν
  set Z₂ := ∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν
  have hZ₁ : 0 < Z₁ := integral_exp_pos h₁
  have hZ₂ : 0 < Z₂ := integral_exp_pos h₂
  have hZpow : 0 < Z₁ ^ a * Z₂ ^ b := by positivity
  have h₁₂ : a • η₁ + b • η₂ ∈ naturalParameterSpace ν T :=
    convex_naturalParameterSpace ν T h₁ h₂ ha hb hab
  have hle : ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) / (Z₁ ^ a * Z₂ ^ b) ∂ν ≤ 1 := by
    have hpt : ∀ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) / (Z₁ ^ a * Z₂ ^ b) ≤
        a * (Real.exp (inner ℝ η₁ (T x)) / Z₁) + b * (Real.exp (inner ℝ η₂ (T x)) / Z₂) := by
      intro x
      rw [exp_inner_convex_eq, mul_div_mul_comm,
        ← Real.div_rpow (Real.exp_nonneg _) hZ₁.le, ← Real.div_rpow (Real.exp_nonneg _) hZ₂.le]
      exact Real.geom_mean_le_arith_mean2_weighted ha hb (by positivity) (by positivity) hab
    calc ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) / (Z₁ ^ a * Z₂ ^ b) ∂ν
        ≤ ∫ x, (a * (Real.exp (inner ℝ η₁ (T x)) / Z₁) +
            b * (Real.exp (inner ℝ η₂ (T x)) / Z₂)) ∂ν :=
          integral_mono (h₁₂.div_const _)
            (((h₁.div_const _).const_mul a).add ((h₂.div_const _).const_mul b)) hpt
      _ = a * (Z₁ / Z₁) + b * (Z₂ / Z₂) := by
          rw [integral_add ((h₁.div_const _).const_mul a) ((h₂.div_const _).const_mul b),
            integral_const_mul, integral_const_mul, integral_div, integral_div]
      _ = 1 := by rw [div_self hZ₁.ne', div_self hZ₂.ne', mul_one, mul_one, hab]
  rw [integral_div, div_le_one hZpow] at hle
  exact hle

/-- The log partition function `logPartition ν T` is convex on `naturalParameterSpace ν T`. -/
theorem convexOn_logPartition (ν : Measure X) (T : X → E) :
    ConvexOn ℝ (naturalParameterSpace ν T) (logPartition ν T) := by
  refine ⟨convex_naturalParameterSpace ν T, fun η₁ h₁ η₂ h₂ a b ha hb hab ↦ ?_⟩
  rcases eq_or_ne ν 0 with rfl | hν
  · simp
  have : NeZero ν := ⟨hν⟩
  have h₁₂ := convex_naturalParameterSpace ν T h₁ h₂ ha hb hab
  have hZ₁ : 0 < ∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν := integral_exp_pos h₁
  have hZ₂ : 0 < ∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν := integral_exp_pos h₂
  have hZ₁₂ : 0 < ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) ∂ν := integral_exp_pos h₁₂
  calc logPartition ν T (a • η₁ + b • η₂)
      ≤ Real.log ((∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν) ^ a *
          (∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν) ^ b) :=
        Real.log_le_log hZ₁₂ (integral_exp_inner_convex_le hν h₁ h₂ ha hb hab)
    _ = a • logPartition ν T η₁ + b • logPartition ν T η₂ := by
        rw [Real.log_mul (by positivity) (by positivity), Real.log_rpow hZ₁, Real.log_rpow hZ₂]
        rfl

/-- Strict normalized AM–GM inequality for the partition function of a minimal family. -/
private lemma integral_exp_inner_convex_lt {ν : Measure X} {T : X → E}
    (hmin : IsMinimalExponentialFamily ν T) {η₁ η₂ : E} (h₁ : η₁ ∈ naturalParameterSpace ν T)
    (h₂ : η₂ ∈ naturalParameterSpace ν T) (hne : η₁ ≠ η₂) {a b : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hab : a + b = 1) :
    ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) ∂ν <
      (∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν) ^ a *
        (∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν) ^ b := by
  have hν : ν ≠ 0 := fun h0 ↦ hmin (η₁ - η₂) (sub_ne_zero.mpr hne) 0 (by simp [h0])
  have : NeZero ν := ⟨hν⟩
  set Z₁ := ∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν
  set Z₂ := ∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν
  have hZ₁ : 0 < Z₁ := integral_exp_pos h₁
  have hZ₂ : 0 < Z₂ := integral_exp_pos h₂
  have h₁₂ := convex_naturalParameterSpace ν T h₁ h₂ ha.le hb.le hab
  refine lt_of_le_of_ne (integral_exp_inner_convex_le hν h₁ h₂ ha.le hb.le hab) fun heq ↦ ?_
  let g : X → ℝ := fun x ↦
    a * (Real.exp (inner ℝ η₁ (T x)) / Z₁) + b * (Real.exp (inner ℝ η₂ (T x)) / Z₂) -
      Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) / (Z₁ ^ a * Z₂ ^ b)
  have hg_nonneg : ∀ x, 0 ≤ g x := fun x ↦ sub_nonneg.mpr <| by
    rw [exp_inner_convex_eq, mul_div_mul_comm,
      ← Real.div_rpow (Real.exp_nonneg _) hZ₁.le, ← Real.div_rpow (Real.exp_nonneg _) hZ₂.le]
    exact Real.geom_mean_le_arith_mean2_weighted ha.le hb.le (by positivity) (by positivity) hab
  have hadd : Integrable (fun x ↦ a * (Real.exp (inner ℝ η₁ (T x)) / Z₁) +
      b * (Real.exp (inner ℝ η₂ (T x)) / Z₂)) ν :=
    ((h₁.div_const _).const_mul a).add ((h₂.div_const _).const_mul b)
  have hg_zero : ∫ x, g x ∂ν = 0 := by
    have hZpow : (Z₁ ^ a * Z₂ ^ b) ≠ 0 := by positivity
    dsimp only [g]
    rw [integral_sub hadd (h₁₂.div_const _),
      integral_add ((h₁.div_const _).const_mul a) ((h₂.div_const _).const_mul b),
      integral_const_mul, integral_const_mul, integral_div, integral_div, integral_div,
      div_self hZ₁.ne', div_self hZ₂.ne', mul_one, mul_one, hab, heq, div_self hZpow, sub_self]
  have hae : g =ᵐ[ν] 0 :=
    (integral_eq_zero_iff_of_nonneg hg_nonneg (hadd.sub (h₁₂.div_const _))).mp hg_zero
  refine hmin (η₁ - η₂) (sub_ne_zero.mpr hne) (Real.log Z₁ - Real.log Z₂) ?_
  filter_upwards [hae] with x hx
  have hEq : (Real.exp (inner ℝ η₁ (T x)) / Z₁) ^ a * (Real.exp (inner ℝ η₂ (T x)) / Z₂) ^ b =
      a * (Real.exp (inner ℝ η₁ (T x)) / Z₁) + b * (Real.exp (inner ℝ η₂ (T x)) / Z₂) := by
    simpa only [exp_inner_convex_eq, mul_div_mul_comm, ← Real.div_rpow (Real.exp_nonneg _) hZ₁.le,
      ← Real.div_rpow (Real.exp_nonneg _) hZ₂.le] using (sub_eq_zero.mp hx).symm
  have hdiv : Real.exp (inner ℝ η₁ (T x)) / Z₁ = Real.exp (inner ℝ η₂ (T x)) / Z₂ :=
    (Real.geom_mean_eq_arith_mean2_weighted_iff_of_pos ha hb (by positivity) (by positivity)
      hab).mp hEq
  have hlog := congrArg Real.log hdiv
  rw [Real.log_div (Real.exp_pos _).ne' hZ₁.ne', Real.log_div (Real.exp_pos _).ne' hZ₂.ne',
    Real.log_exp, Real.log_exp] at hlog
  rw [inner_sub_left]
  linarith

/-- For a minimal natural exponential family, the log partition function `logPartition ν T` is
strictly convex on `naturalParameterSpace ν T`. -/
theorem strictConvexOn_logPartition {ν : Measure X} {T : X → E}
    (hmin : IsMinimalExponentialFamily ν T) :
    StrictConvexOn ℝ (naturalParameterSpace ν T) (logPartition ν T) := by
  refine ⟨convex_naturalParameterSpace ν T, fun η₁ h₁ η₂ h₂ hne a b ha hb hab ↦ ?_⟩
  have hν : ν ≠ 0 := fun h0 ↦ hmin (η₁ - η₂) (sub_ne_zero.mpr hne) 0 (by simp [h0])
  have : NeZero ν := ⟨hν⟩
  have hZ₁ : 0 < ∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν := integral_exp_pos h₁
  have hZ₂ : 0 < ∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν := integral_exp_pos h₂
  have hZ₁₂ : 0 < ∫ x, Real.exp (inner ℝ (a • η₁ + b • η₂) (T x)) ∂ν :=
    integral_exp_pos (convex_naturalParameterSpace ν T h₁ h₂ ha.le hb.le hab)
  calc logPartition ν T (a • η₁ + b • η₂)
      < Real.log ((∫ x, Real.exp (inner ℝ η₁ (T x)) ∂ν) ^ a *
          (∫ x, Real.exp (inner ℝ η₂ (T x)) ∂ν) ^ b) :=
        Real.log_lt_log hZ₁₂ (integral_exp_inner_convex_lt hmin h₁ h₂ hne ha hb hab)
    _ = a • logPartition ν T η₁ + b • logPartition ν T η₂ := by
        rw [Real.log_mul (by positivity) (by positivity), Real.log_rpow hZ₁, Real.log_rpow hZ₂]
        rfl

end Convexity

/-! ### Minimality and the affine span of the support -/

section Support

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E]

/-- For a nonzero measure `ν` on a finite-dimensional real inner product space, minimality of the
identity exponential family holds if and only if the affine span of `ν.support` is the whole
space. -/
theorem isMinimalExponentialFamily_id_iff_affineSpan_support_eq_top {ν : Measure E} (hν : ν ≠ 0) :
    IsMinimalExponentialFamily ν id ↔ affineSpan ℝ ν.support = ⊤ := by
  have hsupp : ν.support.Nonempty := Measure.nonempty_support hν
  rw [AffineSubspace.affineSpan_eq_top_iff_vectorSpan_eq_top_of_nonempty ℝ E E hsupp]
  constructor
  · intro hmin
    by_contra htop
    set V := vectorSpan ℝ ν.support
    have horth : Vᗮ ≠ ⊥ := fun hbot ↦ htop <| by
      have hV := Submodule.orthogonal_orthogonal V
      rw [hbot] at hV
      simpa using hV.symm
    obtain ⟨u, huV, hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot horth
    obtain ⟨x₀, hx₀⟩ := hsupp
    refine hmin u hu0 (inner ℝ u x₀) ?_
    filter_upwards [Measure.support_mem_ae (μ := ν)] with x hx
    have hdiff : x - x₀ ∈ V := vsub_mem_vectorSpan ℝ hx hx₀
    have h0 : inner ℝ u (x - x₀) = 0 := by
      rw [real_inner_comm]
      exact huV (x - x₀) hdiff
    rw [inner_sub_right] at h0
    exact sub_eq_zero.mp h0
  · intro htop u hu0 c hae
    have hsub : ν.support ⊆ {x : E | inner ℝ u x = c} := by
      intro x hx
      by_contra hne
      have hopen : IsOpen {y : E | inner ℝ u y ≠ c} :=
        isOpen_ne_fun (continuous_const.inner continuous_id) continuous_const
      have hzero : ν {y : E | inner ℝ u y ≠ c} = 0 := ae_iff.mp hae
      exact (Measure.mem_support_iff_forall x).mp hx _ (hopen.mem_nhds hne) |>.ne' hzero
    have hu_orth : u ∈ (vectorSpan ℝ ν.support)ᗮ := by
      rw [vectorSpan_def, Submodule.mem_orthogonal]
      intro v hv
      refine Submodule.span_induction ?_ (by simp) (fun _ _ _ _ h1 h2 ↦ by
        rw [inner_add_left, h1, h2, add_zero]) (fun a _ _ h1 ↦ by
        rw [inner_smul_left, h1, mul_zero]) hv
      rintro _ ⟨x, hx, y, hy, rfl⟩
      dsimp only
      rw [vsub_eq_sub, inner_sub_left, real_inner_comm u x, real_inner_comm u y,
        hsub hx, hsub hy, sub_self]
    rw [htop, Submodule.top_orthogonal_eq_bot, Submodule.mem_bot] at hu_orth
    exact hu0 hu_orth

/-- For a nonzero measure `ν` on a finite-dimensional real inner product space, minimality of the
identity exponential family holds if and only if `convexHull ℝ ν.support` has nonempty interior. -/
theorem isMinimalExponentialFamily_id_iff_nonempty_interior_convexHull_support {ν : Measure E}
    (hν : ν ≠ 0) :
    IsMinimalExponentialFamily ν id ↔ (interior (convexHull ℝ ν.support)).Nonempty := by
  rw [isMinimalExponentialFamily_id_iff_affineSpan_support_eq_top hν,
    interior_convexHull_nonempty_iff_affineSpan_eq_top]

