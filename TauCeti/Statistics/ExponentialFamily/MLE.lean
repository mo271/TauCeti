/-!
# Maximum likelihood estimation in natural exponential families

For a nonzero minimal natural exponential family generated by a measure `ν` on a
finite-dimensional real inner product space `E` with nonempty natural parameter space `N`, this
file characterizes the existence, uniqueness, and likelihood equation of the maximum likelihood
estimator:

* `TauCeti.exists_isMaxOn_logLikelihood_iff_mem_interior_convexHull_support`: the log-likelihood
  `ζ ↦ ⟪ζ, t⟫ - logPartition ν id ζ` attains its maximum on `N` if and only if the observation `t`
  lies in `interior (convexHull ℝ ν.support)`.
* `TauCeti.isMaxOn_logLikelihood_unique`: in a minimal family, a maximizer of the log-likelihood
  on `N` is unique.
* `TauCeti.isMaxOn_logLikelihood_iff_integral_eq`: an interior natural parameter `η ∈ interior N`
  maximizes the log-likelihood on `N` if and only if it solves the likelihood equation
  `(∫ x, x ∂exponentialFamilyMeasure ν id η) = t`.
* `TauCeti.integral_mem_interior_convexHull_support`: for a nonzero minimal family, the mean
  `∫ x, x ∂exponentialFamilyMeasure ν id η` of every interior natural parameter lies in
  `interior (convexHull ℝ ν.support)`.

This follows Lawrence D. Brown, *Fundamentals of Statistical Exponential Families* (IMS Lecture
Notes–Monograph Series, Vol. 9, 1986, Chapter 3, Theorem 3.6, and Chapter 5, Theorem 5.5).
-/

public section

open MeasureTheory Real Set Filter
open scoped ENNReal Topology

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]

/-! ### The shifted Laplace functional -/

/-- The shifted Laplace functional `ζ ↦ ∫⁻ x, exp ⟪ζ, x - t⟫ dν` is lower semicontinuous on `E`,
by Fatou's lemma. -/
private lemma lowerSemicontinuous_shiftedLaplace [OpensMeasurableSpace E] (ν : Measure E) (t : E) :
    LowerSemicontinuous fun ζ : E ↦
      ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν := by
  intro η y hy
  have hle : (∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ η (x - t))) ∂ν) ≤
      liminf (fun ζ ↦ ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν) (𝓝 η) := by
    calc ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ η (x - t))) ∂ν
        = ∫⁻ x, liminf (fun ζ ↦ ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t)))) (𝓝 η) ∂ν := by
          refine lintegral_congr fun x ↦ ?_
          have hcont : Continuous fun ζ : E ↦ ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) :=
            ENNReal.continuous_ofReal.comp (by fun_prop)
          exact (hcont.tendsto η).liminf_eq.symm
      _ ≤ liminf (fun ζ ↦ ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν) (𝓝 η) :=
          lintegral_liminf_le fun ζ ↦
            (ENNReal.continuous_ofReal.comp (by fun_prop : Continuous fun x : E ↦
              Real.exp (inner ℝ ζ (x - t)))).measurable
  exact Filter.eventually_lt_of_lt_liminf (hy.trans_le hle)

/-- Finiteness of the shifted Laplace functional characterizes membership in
`naturalParameterSpace ν id`. -/
private lemma mem_naturalParameterSpace_iff_shiftedLaplace_lt_top [OpensMeasurableSpace E]
    (ν : Measure E) (t ζ : E) :
    ζ ∈ naturalParameterSpace ν id ↔
      (∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν) < ⊤ := by
  have hmeas : Measurable fun x : E ↦ ENNReal.ofReal (Real.exp (inner ℝ ζ x)) :=
    (ENNReal.continuous_ofReal.comp (by fun_prop)).measurable
  have hmul : (∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν) =
      ENNReal.ofReal (Real.exp (-inner ℝ ζ t)) *
        ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ x)) ∂ν := by
    rw [← lintegral_const_mul _ hmeas]
    refine lintegral_congr fun x ↦ ?_
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, inner_sub_right]
    ring_nf
  have hpos : ENNReal.ofReal (Real.exp (-inner ℝ ζ t)) ≠ 0 :=
    (ENNReal.ofReal_pos.mpr (Real.exp_pos _)).ne'
  have hcont : Continuous fun x : E ↦ Real.exp (inner ℝ ζ x) := by fun_prop
  have hint_iff : ζ ∈ naturalParameterSpace ν id ↔
      (∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ x)) ∂ν) < ⊤ := by
    rw [mem_naturalParameterSpace_iff]
    simp only [id_eq, Integrable, hcont.aestronglyMeasurable, true_and, HasFiniteIntegral]
    have heq : (fun x : E ↦ ‖Real.exp (inner ℝ ζ x)‖ₑ) =
        fun x : E ↦ ENNReal.ofReal (Real.exp (inner ℝ ζ x)) := by
      ext x
      rw [Real.eNorm_eq_ofReal (Real.exp_pos _).le]
    rw [heq]
  rw [hmul, ENNReal.mul_lt_top_iff, hint_iff]
  simp only [ENNReal.ofReal_lt_top, true_and, hpos, false_or]
  exact ⟨Or.inl, fun h ↦ h.elim id fun h0 ↦ h0.symm ▸ ENNReal.zero_lt_top⟩

/-- For `ζ ∈ naturalParameterSpace ν id`, the shifted integrand `x ↦ exp ⟪ζ, x - t⟫` is
`ν`-integrable. -/
private lemma integrable_exp_inner_sub {ν : Measure E} (t : E) {ζ : E}
    (hζ : ζ ∈ naturalParameterSpace ν id) :
    Integrable (fun x : E ↦ Real.exp (inner ℝ ζ (x - t))) ν := by
  have h1 : Integrable (fun x : E ↦ Real.exp (-inner ℝ ζ t) * Real.exp (inner ℝ ζ x)) ν :=
    (mem_naturalParameterSpace_iff.mp hζ).const_mul _
  refine h1.congr (ae_of_all _ fun x ↦ ?_)
  dsimp only
  rw [← Real.exp_add, inner_sub_right]
  ring_nf

/-- On `naturalParameterSpace ν id` for `ν ≠ 0`, `∫ exp ⟪ζ, x - t⟫ dν` equals
`exp (-(⟪ζ, t⟫ - logPartition ν id ζ))`. -/
private lemma integral_exp_inner_sub_eq {ν : Measure E} (hν : ν ≠ 0) (t : E) {ζ : E}
    (hζ : ζ ∈ naturalParameterSpace ν id) :
    (∫ x, Real.exp (inner ℝ ζ (x - t)) ∂ν) =
      Real.exp (-(inner ℝ ζ t - logPartition ν id ζ)) := by
  have heq : (fun x : E ↦ Real.exp (inner ℝ ζ (x - t))) =
      fun x : E ↦ Real.exp (-inner ℝ ζ t) * Real.exp (inner ℝ ζ x) := by
    ext x
    rw [← Real.exp_add, inner_sub_right]
    ring_nf
  have : NeZero ν := ⟨hν⟩
  have hpos : 0 < ∫ x, Real.exp (inner ℝ ζ x) ∂ν :=
    integral_exp_pos (mem_naturalParameterSpace_iff.mp hζ)
  rw [heq, integral_const_mul, ← Real.exp_log hpos, ← Real.exp_add, logPartition_def]
  simp only [id_eq]
  ring_nf

/-- Lebesgue integral form of `integral_exp_inner_sub_eq`. -/
private lemma shiftedLaplace_eq_ofReal_exp_neg {ν : Measure E} (hν : ν ≠ 0) (t : E) {ζ : E}
    (hζ : ζ ∈ naturalParameterSpace ν id) :
    (∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν) =
      ENNReal.ofReal (Real.exp (-(inner ℝ ζ t - logPartition ν id ζ))) := by
  rw [← ofReal_integral_eq_lintegral_ofReal (integrable_exp_inner_sub t hζ)
    (ae_of_all _ fun _ ↦ (Real.exp_pos _).le), integral_exp_inner_sub_eq hν t hζ]

/-! ### Coercivity and existence of a maximizer -/

/-- If `t ∈ interior (convexHull ℝ ν.support)`, then every unit direction `u` has a support
point `x₀ ∈ ν.support` strictly on the positive side `⟪u, x₀ - t⟫ > 0`. -/
private lemma exists_mem_support_inner_sub_pos {ν : Measure E} {t u : E} (hu : ‖u‖ = 1)
    (ht : t ∈ interior (convexHull ℝ ν.support)) :
    ∃ x₀ ∈ ν.support, 0 < inner ℝ u (x₀ - t) := by
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (isOpen_interior.mem_nhds ht)
  by_contra hall
  push Not at hall
  have hconv : Convex ℝ {x : E | inner ℝ u (x - t) ≤ 0} := by
    intro x hx y hy a b ha hb hab
    have hsplit : a • x + b • y - t = a • (x - t) + b • (y - t) := by
      rw [smul_sub, smul_sub, ← add_sub_add_comm, ← add_smul, hab, one_smul]
    rw [Set.mem_ofPred_eq, hsplit, inner_add_right, inner_smul_right, inner_smul_right]
    exact add_nonpos (mul_nonpos_of_nonneg_of_nonpos ha hx)
      (mul_nonpos_of_nonneg_of_nonpos hb hy)
  have hy_mem : t + (ε / 2) • u ∈ Metric.ball t ε := by
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
      abs_of_pos (by positivity), hu, mul_one]
    linarith
  have hle : inner ℝ u ((t + (ε / 2) • u) - t) ≤ 0 :=
    convexHull_min (fun x hx ↦ hall x hx) hconv (interior_subset (hball hy_mem))
  rw [add_sub_cancel_left, inner_smul_right, real_inner_self_eq_norm_sq, hu] at hle
  linarith

/-- For each unit direction `u`, openness of `{ (v, x) | δ < ⟪v, x - t⟫ }` yields open
neighbourhoods `U ∋ u` and `V` of positive `ν`-measure on which `⟪v, x - t⟫ ≥ δ`. -/
private lemma exists_open_nhds_inner_sub_ge {ν : Measure E} {t u : E} (hu : ‖u‖ = 1)
    (ht : t ∈ interior (convexHull ℝ ν.support)) :
    ∃ (U V : Set E) (δ : ℝ), IsOpen U ∧ u ∈ U ∧ IsOpen V ∧ 0 < ν V ∧ 0 < δ ∧
      ∀ v ∈ U, ∀ x ∈ V, δ ≤ inner ℝ v (x - t) := by
  obtain ⟨x₀, hx₀_supp, hx₀_pos⟩ := exists_mem_support_inner_sub_pos hu ht
  set δ : ℝ := inner ℝ u (x₀ - t) / 2
  have hcont : Continuous fun p : E × E ↦ inner ℝ p.1 (p.2 - t) := by fun_prop
  have hnhds : {p : E × E | δ < inner ℝ p.1 (p.2 - t)} ∈ 𝓝 (u, x₀) :=
    (isOpen_lt continuous_const hcont).mem_nhds (by simp only [Set.mem_ofPred_eq, δ]; linarith)
  rw [nhds_prod_eq, Filter.mem_prod_iff] at hnhds
  obtain ⟨U', hU', V', hV', hprod⟩ := hnhds
  obtain ⟨U, hUU', hUopen, huU⟩ := mem_nhds_iff.mp hU'
  obtain ⟨V, hVV', hVopen, hx₀V⟩ := mem_nhds_iff.mp hV'
  exact ⟨U, V, δ, hUopen, huU, hVopen,
    (Measure.mem_support_iff_forall x₀).mp hx₀_supp V (hVopen.mem_nhds hx₀V), by positivity,
    fun v hv x hx ↦ (hprod (Set.mk_mem_prod (hUU' hv) (hVV' hx))).le⟩

/-- When `t ∈ interior (convexHull ℝ ν.support)` in a nontrivial finite-dimensional space `E`,
there exist uniform `δ > 0` and `m > 0` such that every unit direction `u` has a measurable region
of mass at least `m` where `⟪u, x - t⟫ ≥ δ`. -/
private lemma exists_uniform_pos_measure_inner_sub_ge [FiniteDimensional ℝ E]
    [OpensMeasurableSpace E] [Nontrivial E] {ν : Measure E} {t : E}
    (ht : t ∈ interior (convexHull ℝ ν.support)) :
    ∃ (δ m : ℝ), 0 < δ ∧ 0 < m ∧ ∀ u : E, ‖u‖ = 1 →
      ∃ V : Set E, MeasurableSet V ∧ ENNReal.ofReal m ≤ ν V ∧ ∀ x ∈ V, δ ≤ inner ℝ u (x - t) := by
  choose U V δ hUopen huU hVopen hνV hδ hbound using fun u : Metric.sphere (0 : E) 1 ↦
    exists_open_nhds_inner_sub_ge (u := u.1) (by simp) ht
  have hcover : Metric.sphere (0 : E) 1 ⊆ ⋃ u : Metric.sphere (0 : E) 1, U u :=
    fun u hu ↦ Set.mem_iUnion.mpr ⟨⟨u, hu⟩, huU ⟨u, hu⟩⟩
  obtain ⟨s, hs⟩ := (isCompact_sphere (0 : E) 1).elim_finite_subcover U hUopen hcover
  have hsne : s.Nonempty := by
    obtain ⟨v, hv⟩ := exists_ne (0 : E)
    have hmem : (‖v‖⁻¹ • v) ∈ Metric.sphere (0 : E) 1 := by
      simp [norm_smul, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hv)]
    obtain ⟨u, hu, _⟩ := Set.mem_iUnion₂.mp (hs hmem)
    exact ⟨u, hu⟩
  set δ₀ : ℝ := s.inf' hsne δ
  set m₀ : ℝ := s.inf' hsne fun u ↦ (min (ν (V u)) 1).toReal
  have hδ₀ : 0 < δ₀ := (Finset.lt_inf'_iff hsne).mpr fun u _ ↦ hδ u
  have hm₀ : 0 < m₀ := (Finset.lt_inf'_iff hsne).mpr fun u _ ↦
    ENNReal.toReal_pos (lt_min (hνV u) zero_lt_one).ne'
      ((min_le_right _ _).trans_lt ENNReal.one_lt_top).ne
  refine ⟨δ₀, m₀, hδ₀, hm₀, fun u hu1 ↦ ?_⟩
  obtain ⟨u₀, hu₀s, huU₀⟩ := Set.mem_iUnion₂.mp (hs (by simpa using hu1))
  refine ⟨V u₀, (hVopen u₀).measurableSet, ?_, fun x hx ↦
    (Finset.inf'_le δ hu₀s).trans (hbound u₀ u huU₀ x hx)⟩
  calc ENNReal.ofReal m₀
      ≤ ENNReal.ofReal (min (ν (V u₀)) 1).toReal :=
        ENNReal.ofReal_le_ofReal (Finset.inf'_le (fun w ↦ (min (ν (V w)) 1).toReal) hu₀s)
    _ = min (ν (V u₀)) 1 :=
        ENNReal.ofReal_toReal ((min_le_right _ _).trans_lt ENNReal.one_lt_top).ne
    _ ≤ ν (V u₀) := min_le_left _ _

/-- Exponential lower bound on the shifted Laplace functional in a direction with a positive-mass
half-space region. -/
private lemma shiftedLaplace_ge_of_dir_region {ν : Measure E} {t ζ : E} {δ m : ℝ} (hζ : 0 < ‖ζ‖)
    {V : Set E} (hVmeas : MeasurableSet V) (hVm : ENNReal.ofReal m ≤ ν V)
    (hVinner : ∀ x ∈ V, δ ≤ inner ℝ (‖ζ‖⁻¹ • ζ) (x - t)) :
    ENNReal.ofReal (Real.exp (‖ζ‖ * δ) * m) ≤
      ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν := by
  calc ENNReal.ofReal (Real.exp (‖ζ‖ * δ) * m)
      = ENNReal.ofReal (Real.exp (‖ζ‖ * δ)) * ENNReal.ofReal m :=
        ENNReal.ofReal_mul (Real.exp_pos _).le
    _ ≤ ENNReal.ofReal (Real.exp (‖ζ‖ * δ)) * ν V := by gcongr
    _ = ∫⁻ _ in V, ENNReal.ofReal (Real.exp (‖ζ‖ * δ)) ∂ν := (setLIntegral_const V _).symm
    _ ≤ ∫⁻ x in V, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν := by
        refine setLIntegral_mono' hVmeas fun x hx ↦
          ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
        have h1 := hVinner x hx
        rw [inner_smul_left, RCLike.conj_to_real] at h1
        calc ‖ζ‖ * δ ≤ ‖ζ‖ * (‖ζ‖⁻¹ * inner ℝ ζ (x - t)) :=
              mul_le_mul_of_nonneg_left h1 hζ.le
          _ = inner ℝ ζ (x - t) := by rw [← mul_assoc, mul_inv_cancel₀ hζ.ne', one_mul]
    _ ≤ ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν :=
        setLIntegral_le_lintegral V _

omit [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E] in
/-- Elementary radius threshold ensuring `c ≤ exp (r * δ) * m`. -/
private lemma le_ofReal_exp_mul_of_gt {c : ℝ≥0∞} (hc : c < ⊤) {δ m r : ℝ} (hδ : 0 < δ)
    (hm : 0 < m) (hr : Real.log (c.toReal / m + 1) / δ + 1 < r) :
    c ≤ ENNReal.ofReal (Real.exp (r * δ) * m) := by
  rw [← ENNReal.ofReal_toReal hc.ne]
  refine ENNReal.ofReal_le_ofReal ?_
  have hlog : Real.log (c.toReal / m + 1) < r * δ := (div_lt_iff₀ hδ).mp (by linarith)
  have hexp : c.toReal / m + 1 < Real.exp (r * δ) := by
    rw [← Real.exp_log (by positivity : 0 < c.toReal / m + 1)]
    exact Real.exp_lt_exp.mpr hlog
  exact (div_le_iff₀ hm).mp (by linarith)

/-- Existence of a maximizer of the log-likelihood when `t ∈ interior (convexHull ℝ ν.support)`. -/
private lemma exists_isMaxOn_of_mem_interior_convexHull_support [FiniteDimensional ℝ E]
    [OpensMeasurableSpace E] {ν : Measure E} (hν : ν ≠ 0)
    (hNne : (naturalParameterSpace ν id).Nonempty) {t : E}
    (ht : t ∈ interior (convexHull ℝ ν.support)) :
    ∃ η ∈ naturalParameterSpace ν id,
      IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η := by
  obtain ⟨η₀, hη₀⟩ := hNne
  rcases subsingleton_or_nontrivial E with hsub | hnt
  · exact ⟨η₀, hη₀, fun ζ _ ↦ by simp [Subsingleton.elim ζ η₀]⟩
  obtain ⟨δ, m, hδ, hm, hdir⟩ := exists_uniform_pos_measure_inner_sub_ge ht
  let φ : E → ℝ≥0∞ := fun ζ ↦ ∫⁻ x, ENNReal.ofReal (Real.exp (inner ℝ ζ (x - t))) ∂ν
  have hφ₀_lt : φ η₀ < ⊤ := (mem_naturalParameterSpace_iff_shiftedLaplace_lt_top ν t η₀).mp hη₀
  set R : ℝ := max (max ‖η₀‖ 1) ((Real.log ((φ η₀).toReal / m + 1)) / δ + 1)
  have hR_pos : 0 < R := lt_of_lt_of_le zero_lt_one ((le_max_right _ _).trans (le_max_left _ _))
  have hη₀K : η₀ ∈ Metric.closedBall (0 : E) R := by
    rw [Metric.mem_closedBall, dist_zero_right]
    exact (le_max_left _ _).trans (le_max_left _ _)
  obtain ⟨η, _, hη_min⟩ := (lowerSemicontinuous_shiftedLaplace ν t).lowerSemicontinuousOn
    (Metric.closedBall (0 : E) R) |>.exists_isMinOn ⟨η₀, hη₀K⟩ (isCompact_closedBall 0 R)
  have hη_le_η₀ : φ η ≤ φ η₀ := hη_min hη₀K
  have hη_mem : η ∈ naturalParameterSpace ν id :=
    (mem_naturalParameterSpace_iff_shiftedLaplace_lt_top ν t η).mpr (hη_le_η₀.trans_lt hφ₀_lt)
  have hη_global : ∀ ζ : E, φ η ≤ φ ζ := fun ζ ↦ by
    by_cases hζK : ζ ∈ Metric.closedBall (0 : E) R
    · exact hη_min hζK
    · have hnorm_gt : R < ‖ζ‖ := by
        simpa [Metric.mem_closedBall, dist_zero_right, not_le] using hζK
      have hζpos : 0 < ‖ζ‖ := hR_pos.trans hnorm_gt
      obtain ⟨V, hVmeas, hVm, hVinner⟩ := hdir (‖ζ‖⁻¹ • ζ) (by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hζpos), inv_mul_cancel₀ hζpos.ne'])
      have hlower := shiftedLaplace_ge_of_dir_region hζpos hVmeas hVm hVinner
      have hgt := le_ofReal_exp_mul_of_gt hφ₀_lt hδ hm ((le_max_right _ _).trans_lt hnorm_gt)
      exact hη_le_η₀.trans (hgt.trans hlower)
  refine ⟨η, hη_mem, fun ζ hζ ↦ ?_⟩
  have hle := hη_global ζ
  dsimp only [φ] at hle
  rw [shiftedLaplace_eq_ofReal_exp_neg hν t hη_mem, shiftedLaplace_eq_ofReal_exp_neg hν t hζ,
    ENNReal.ofReal_le_ofReal_iff (Real.exp_pos _).le, Real.exp_le_exp] at hle
  exact neg_le_neg_iff.mp hle

/-! ### Necessity of `t ∈ interior (convexHull ℝ ν.support)` -/

/-- If `t ∉ interior (convexHull ℝ ν.support)` and the interior is nonempty, there is a nonzero
direction `u` such that `⟪u, x - t⟫ ≤ 0` for `ν`-a.e. `x`. -/
private lemma exists_dir_ae_inner_sub_nonpos [FiniteDimensional ℝ E] {ν : Measure E} {t : E}
    (hUne : (interior (convexHull ℝ ν.support)).Nonempty)
    (ht : t ∉ interior (convexHull ℝ ν.support)) :
    ∃ u : E, u ≠ 0 ∧ ∀ᵐ x ∂ν, inner ℝ u (x - t) ≤ 0 := by
  obtain ⟨f, hf⟩ := geometric_hahn_banach_open_point (convex_convexHull ℝ ν.support).interior
    isOpen_interior ht
  set u : E := (InnerProductSpace.toDual ℝ E).symm f
  have hfu : ∀ y : E, f y = inner ℝ u y := fun y ↦ by simp [u]
  have hu_lt : ∀ y ∈ interior (convexHull ℝ ν.support), inner ℝ u y < inner ℝ u t :=
    fun y hy ↦ by simpa only [hfu] using hf y hy
  have hu0 : u ≠ 0 := by
    obtain ⟨y, hy⟩ := hUne
    intro h0
    have := hu_lt y hy
    simp [h0] at this
  have hclosure : closure (interior (convexHull ℝ ν.support)) =
      closure (convexHull ℝ ν.support) :=
    (convex_convexHull ℝ ν.support).closure_interior_eq_closure_of_nonempty_interior hUne
  refine ⟨u, hu0, ?_⟩
  filter_upwards [Measure.support_mem_ae (μ := ν)] with x hx
  have hxcl : x ∈ closure (interior (convexHull ℝ ν.support)) :=
    hclosure ▸ subset_closure (subset_convexHull ℝ ν.support hx)
  have hle : inner ℝ u x ≤ inner ℝ u t :=
    closure_minimal (fun y hy ↦ (hu_lt y hy).le)
      (isClosed_le (continuous_const.inner continuous_id) continuous_const) hxcl
  rw [inner_sub_right]
  linarith

/-- Adding a direction `u` with `⟪u, x - t⟫ ≤ 0` `ν`-a.e. preserves membership in
`naturalParameterSpace ν id` when `id` is a.e.-strongly measurable. -/
private lemma add_mem_naturalParameterSpace_of_ae_inner_sub_nonpos {ν : Measure E} {t η u : E}
    (hid : AEStronglyMeasurable (id : E → E) ν) (hη : η ∈ naturalParameterSpace ν id)
    (hae_le : ∀ᵐ x ∂ν, inner ℝ u (x - t) ≤ 0) :
    η + u ∈ naturalParameterSpace ν id := by
  rw [mem_naturalParameterSpace_iff]
  have hcont : Continuous fun x : E ↦ Real.exp (inner ℝ (η + u) x) := by fun_prop
  refine ((mem_naturalParameterSpace_iff.mp hη).const_mul (Real.exp (inner ℝ u t))).mono'
    (hcont.comp_aestronglyMeasurable hid) ?_
  filter_upwards [hae_le] with x hx
  simp only [id_eq, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), ← Real.exp_add]
  refine Real.exp_le_exp.mpr ?_
  rw [inner_add_left]
  rw [inner_sub_right] at hx
  linarith

/-- If the log-likelihood attains its maximum on `naturalParameterSpace ν id` in a nonzero minimal
family with a.e.-strongly measurable identity, then `t ∈ interior (convexHull ℝ ν.support)`. -/
private lemma mem_interior_convexHull_support_of_isMaxOn [FiniteDimensional ℝ E]
    {ν : Measure E} (hν : ν ≠ 0) (hid : AEStronglyMeasurable (id : E → E) ν)
    (hmin : IsMinimalExponentialFamily ν id) {t η : E} (hη : η ∈ naturalParameterSpace ν id)
    (hmax : IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η) :
    t ∈ interior (convexHull ℝ ν.support) := by
  by_contra ht
  obtain ⟨u, hu0, hae_le⟩ := exists_dir_ae_inner_sub_nonpos
    ((isMinimalExponentialFamily_id_iff_nonempty_interior_convexHull_support hν).mp hmin) ht
  have hηu_mem := add_mem_naturalParameterSpace_of_ae_inner_sub_nonpos hid hη hae_le
  let g : E → ℝ := fun x ↦
    Real.exp (inner ℝ η (x - t)) - Real.exp (inner ℝ (η + u) (x - t))
  have hg_nonneg : 0 ≤ᵐ[ν] g := by
    filter_upwards [hae_le] with x hx
    dsimp only [g, Pi.zero_apply]
    rw [sub_nonneg, inner_add_left]
    exact Real.exp_le_exp.mpr (by linarith)
  have hg_int : Integrable g ν :=
    (integrable_exp_inner_sub t hη).sub (integrable_exp_inner_sub t hηu_mem)
  have hg_pos : 0 < ∫ x, g x ∂ν := by
    refine lt_of_le_of_ne (integral_nonneg_of_ae hg_nonneg) fun h0 ↦ ?_
    have hae0 : g =ᵐ[ν] 0 := (integral_eq_zero_iff_of_nonneg_ae hg_nonneg hg_int).mp h0.symm
    refine isMinimalExponentialFamily_iff.mp hmin u hu0 (inner ℝ u t) ?_
    filter_upwards [hae0] with x hx
    have hin : inner ℝ η (x - t) = inner ℝ (η + u) (x - t) :=
      Real.exp_injective (sub_eq_zero.mp hx)
    rw [inner_add_left, inner_sub_right, inner_sub_right] at hin
    dsimp only [id_eq]
    linarith
  have hlt_int : ∫ x, Real.exp (inner ℝ (η + u) (x - t)) ∂ν <
      ∫ x, Real.exp (inner ℝ η (x - t)) ∂ν := by
    rw [integral_sub (integrable_exp_inner_sub t hη) (integrable_exp_inner_sub t hηu_mem)] at hg_pos
    linarith
  rw [integral_exp_inner_sub_eq hν t hηu_mem, integral_exp_inner_sub_eq hν t hη,
    Real.exp_lt_exp] at hlt_int
  have hmax_le : inner ℝ (η + u) t - logPartition ν id (η + u) ≤
      inner ℝ η t - logPartition ν id η := hmax hηu_mem
  linarith

/-! ### Main MLE theorems -/

/-- **Existence of the maximum likelihood estimator in a natural exponential family.** For a
nonzero minimal family with nonempty natural parameter space, the log-likelihood
`ζ ↦ ⟪ζ, t⟫ - logPartition ν id ζ` attains its maximum on `naturalParameterSpace ν id` if and
only if `t ∈ interior (convexHull ℝ ν.support)`. -/
theorem exists_isMaxOn_logLikelihood_iff_mem_interior_convexHull_support [FiniteDimensional ℝ E]
    [OpensMeasurableSpace E] (ν : Measure E) (hne : ν ≠ 0)
    (hminimal : IsMinimalExponentialFamily ν id) (hNne : (naturalParameterSpace ν id).Nonempty)
    (t : E) :
    (∃ η ∈ naturalParameterSpace ν id,
        IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η) ↔
      t ∈ interior (convexHull ℝ ν.support) :=
  ⟨fun ⟨_, hη, hmax⟩ ↦
      mem_interior_convexHull_support_of_isMaxOn hne continuous_id.aestronglyMeasurable
        hminimal hη hmax,
    exists_isMaxOn_of_mem_interior_convexHull_support hne hNne⟩

/-- **Uniqueness of the maximum likelihood estimator.** In a minimal natural exponential family,
the log-likelihood `ζ ↦ ⟪ζ, t⟫ - logPartition ν id ζ` has at most one maximizer on
`naturalParameterSpace ν id`. -/
theorem isMaxOn_logLikelihood_unique {ν : Measure E} (hminimal : IsMinimalExponentialFamily ν id)
    {t η₁ η₂ : E} (h₁ : η₁ ∈ naturalParameterSpace ν id) (h₂ : η₂ ∈ naturalParameterSpace ν id)
    (hmax₁ : IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η₁)
    (hmax₂ : IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η₂) :
    η₁ = η₂ := by
  by_contra hne
  set η : E := (2 : ℝ)⁻¹ • η₁ + (2 : ℝ)⁻¹ • η₂
  have hhalf : (0 : ℝ) < (2 : ℝ)⁻¹ := by norm_num
  have hsum : (2 : ℝ)⁻¹ + (2 : ℝ)⁻¹ = (1 : ℝ) := by norm_num
  have hη : η ∈ naturalParameterSpace ν id :=
    convex_naturalParameterSpace ν id h₁ h₂ hhalf.le hhalf.le hsum
  have hstrict : logPartition ν id η <
      (2 : ℝ)⁻¹ • logPartition ν id η₁ + (2 : ℝ)⁻¹ • logPartition ν id η₂ :=
    (strictConvexOn_logPartition hminimal).2 h₁ h₂ hne hhalf hhalf hsum
  have hin : inner ℝ η t = (2 : ℝ)⁻¹ * inner ℝ η₁ t + (2 : ℝ)⁻¹ * inner ℝ η₂ t := by
    simp [η, inner_add_left, inner_smul_left]
  have hle₁ : inner ℝ η t - logPartition ν id η ≤ inner ℝ η₁ t - logPartition ν id η₁ := hmax₁ hη
  have hle₃ : inner ℝ η₁ t - logPartition ν id η₁ ≤ inner ℝ η₂ t - logPartition ν id η₂ := hmax₂ h₁
  simp only [smul_eq_mul] at hstrict
  linarith

/-- Fréchet derivative of the log-likelihood `ζ ↦ ⟪ζ, t⟫ - logPartition ν id ζ` at an interior
natural parameter. -/
private lemma hasFDerivAt_logLikelihood [FiniteDimensional ℝ E] {ν : Measure E} {t η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) :
    HasFDerivAt (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ)
      (innerSL ℝ (t - ∫ x, x ∂exponentialFamilyMeasure ν id η)) η := by
  have hlin : HasFDerivAt (fun ζ : E ↦ inner ℝ ζ t) (innerSL ℝ t) η := by
    have heq : (fun ζ : E ↦ inner ℝ ζ t) = fun ζ : E ↦ innerSL ℝ t ζ := by
      ext ζ; exact real_inner_comm t ζ
    rw [heq]
    exact (innerSL ℝ t).hasFDerivAt
  simpa only [map_sub] using hlin.fun_sub (hasFDerivAt_logPartition ν hη)

/-- Necessity of the likelihood equation at an interior maximizer. -/
private lemma integral_eq_of_isMaxOn_logLikelihood [FiniteDimensional ℝ E] {ν : Measure E}
    {t η : E} (hη : η ∈ interior (naturalParameterSpace ν id))
    (hmax : IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η) :
    (∫ x, x ∂exponentialFamilyMeasure ν id η) = t := by
  have hloc : IsLocalMax (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) η :=
    Filter.eventually_of_mem (isOpen_interior.mem_nhds hη) fun ζ hζ ↦ hmax (interior_subset hζ)
  have h0 : innerSL ℝ (t - ∫ x, x ∂exponentialFamilyMeasure ν id η) = 0 := by
    rw [← (hasFDerivAt_logLikelihood hη).fderiv]
    exact hloc.fderiv_eq_zero
  have hself : inner ℝ (t - ∫ x, x ∂exponentialFamilyMeasure ν id η)
      (t - ∫ x, x ∂exponentialFamilyMeasure ν id η) = 0 := by
    have h := congrArg (fun f : E →L[ℝ] ℝ ↦ f (t - ∫ x, x ∂exponentialFamilyMeasure ν id η)) h0
    simpa only [innerSL_apply_apply, zero_apply] using h
  exact (sub_eq_zero.mp (inner_self_eq_zero.mp hself)).symm

/-- Sufficiency of the likelihood equation at an interior parameter, by concavity of the
log-likelihood. -/
private lemma isMaxOn_logLikelihood_of_integral_eq [FiniteDimensional ℝ E] {ν : Measure E}
    {t η : E} (hη : η ∈ interior (naturalParameterSpace ν id))
    (hmean : (∫ x, x ∂exponentialFamilyMeasure ν id η) = t) :
    IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η := by
  let L : E → ℝ := fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ
  intro ζ hζ
  have hconc : ConcaveOn ℝ (naturalParameterSpace ν id) L := by
    refine ⟨convex_naturalParameterSpace ν id, fun x hx y hy a b ha hb hab ↦ ?_⟩
    have hconv := (convexOn_logPartition ν id).2 hx hy ha hb hab
    simp only [L, inner_add_left, inner_smul_left, RCLike.conj_to_real, smul_eq_mul] at hconv ⊢
    linarith
  let g : ℝ → ℝ := L ∘ fun s ↦ η + s • (ζ - η)
  have hg_deriv : HasDerivAt g 0 0 := by
    have hcurve : HasDerivAt (fun s : ℝ ↦ η + s • (ζ - η)) (ζ - η) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (ζ - η)).const_add η
    simpa [g, L, hmean, sub_self] using
      (hasFDerivAt_logLikelihood (t := t) hη).comp_hasDerivAt_of_eq 0 hcurve (by simp)
  have hslope : Tendsto (fun s : ℝ ↦ (g s - g 0) / s) (𝓝[>] 0) (𝓝 0) := by
    simpa only [smul_eq_mul, inv_mul_eq_div, zero_add] using
      (hasDerivAt_iff_tendsto_slope_zero.mp hg_deriv).mono_left
        (nhdsWithin_mono 0 fun (s : ℝ) (hs : s ∈ Set.Ioi 0) ↦ (Set.mem_Ioi.mp hs).ne')
  have hge : ∀ᶠ s : ℝ in 𝓝[>] 0, L ζ - L η ≤ (g s - g 0) / s := by
    filter_upwards [Ioo_mem_nhdsGT zero_lt_one] with s hs
    have hcomb : η + s • (ζ - η) = (1 - s) • η + s • ζ := by
      rw [smul_sub, sub_smul, one_smul]; abel
    have hle := hconc.2 (interior_subset hη) hζ (sub_nonneg.mpr hs.2.le) hs.1.le (by ring)
    simp only [g, Function.comp_apply, zero_smul, add_zero, smul_eq_mul] at hle ⊢
    rw [hcomb, le_div_iff₀ hs.1]
    linarith
  exact sub_nonpos.mp (le_of_tendsto_of_tendsto tendsto_const_nhds hslope hge)

/-- **Likelihood equation.** An interior natural parameter
`η ∈ interior (naturalParameterSpace ν id)` maximizes the log-likelihood
`ζ ↦ ⟪ζ, t⟫ - logPartition ν id ζ` on `naturalParameterSpace ν id` if and only if the family mean
at `η` equals `t`. -/
theorem isMaxOn_logLikelihood_iff_integral_eq [FiniteDimensional ℝ E]
    {ν : Measure E} {t η : E} (hη : η ∈ interior (naturalParameterSpace ν id)) :
    IsMaxOn (fun ζ ↦ inner ℝ ζ t - logPartition ν id ζ) (naturalParameterSpace ν id) η ↔
      (∫ x, x ∂exponentialFamilyMeasure ν id η) = t :=
  ⟨integral_eq_of_isMaxOn_logLikelihood hη, isMaxOn_logLikelihood_of_integral_eq hη⟩

/-- For a nonzero minimal natural exponential family, the mean at every interior natural parameter
lies in `interior (convexHull ℝ ν.support)`. -/
theorem integral_mem_interior_convexHull_support [FiniteDimensional ℝ E]
    {ν : Measure E} (hne : ν ≠ 0) (hminimal : IsMinimalExponentialFamily ν id) {η : E}
    (hη : η ∈ interior (naturalParameterSpace ν id)) :
    (∫ x, x ∂exponentialFamilyMeasure ν id η) ∈ interior (convexHull ℝ ν.support) := by
  have hac : ν ≪ exponentialFamilyMeasure ν id η := by
    rw [exponentialFamilyMeasure_def]
    exact absolutelyContinuous_tilted (mem_naturalParameterSpace_iff.mp (interior_subset hη))
  have hid : AEStronglyMeasurable (id : E → E) ν :=
    (integrable_id_exponentialFamilyMeasure hη).aestronglyMeasurable.mono_ac hac
  exact mem_interior_convexHull_support_of_isMaxOn hne hid hminimal (interior_subset hη)
    ((isMaxOn_logLikelihood_iff_integral_eq hη).mpr rfl)

end TauCeti
