/-!
# The Weyl group and Tits system of a Bruhat–Tits root datum

Let `D` be a root datum of crystallographic type `P` in a group `G` in the sense of Bruhat–Tits,
where `P` is neither assumed reduced nor assumed to span its ambient weight and coweight modules.
Following Bruhat–Tits I, 6.1.2 and 6.1.11, this file establishes:

* `RootDatum.U_injective`: distinct root indices determine distinct root subgroups;
* `RootDatum.reflectionCoset_eq_of_root_eq_two_smul`: when `2 a` is a root, `M (2 a) = M a`;
* `RootDatum.weylNormalizerHom`: the surjective homomorphism `ν : N →* P.weylGroup` characterized
  by `n • U i = U (ν n • i)` under conjugation;
* `RootDatum.conj_mem_reflectionCoset`: `n M i n⁻¹ = M (ν n • i)` for `n ∈ N`;
* `RootDatum.weylNormalizerHom_ker` and `RootDatum.weylGroupEquiv`: the kernel of `ν` is `T`
  (regarded inside `N`), giving the canonical isomorphism `N / T ≃* P.weylGroup` pinned by
  `RootDatum.weylGroupEquiv_conj`;
* `RootDatum.borelSubgroup` and `RootDatum.borelSubgroup_inf_weylNormalizer`: `B = T U⁺` satisfies
  `B ∩ N = T`;
* `RootDatum.titsSystem`: when `D.IsGenerating` holds, `(B, N)` together with the classes of the
  reflections in the indecomposable positive roots forms a Tits system in `G` whose Weyl group is
  canonically isomorphic to `P.weylGroup` (`RootDatum.titsWeylGroupEquiv`).

## Main definitions

* `TauCeti.BruhatTits.RootDatum.borelSubgroup`: the subgroup `B = T ⊔ U⁺`.
* `TauCeti.BruhatTits.RootDatum.generatedSubgroup`: the subgroup generated by `T` and all `U i`.
* `TauCeti.BruhatTits.RootDatum.simpleRoots`: the indecomposable positive roots relative to
  `D.positiveVector`.
* `TauCeti.BruhatTits.RootDatum.weylNormalizerHom`: the homomorphism `D.weylNormalizer →*
  P.weylGroup`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv`: the isomorphism
  `D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup`.
* `TauCeti.BruhatTits.RootDatum.titsSystem`: the Tits system `(B, N, S)` attached to a generating
  root datum `D`.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  6.1.2, pp. 108–109, and Proposition 6.1.11, pp. 114–115.
-/

public section

open IsAddIndecomposable RootPairing Set
open scoped Pointwise commutatorElement

namespace TauCeti.BruhatTits.RootDatum

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {G : Type*} [Group G] (D : RootDatum P G)

/-! ### Borel subgroup, generated subgroup, and simple roots -/

/-- The Borel-like subgroup `B = T ⊔ U⁺` attached to the positive vector of a root datum. -/
def borelSubgroup : Subgroup G :=
  D.T ⊔ D.positiveSubgroup

/-- The subgroup of `G` generated by `T` and all root subgroups `U i`. -/
def generatedSubgroup : Subgroup G :=
  D.T ⊔ ⨆ i, D.U i

/-- Evaluation on `D.positiveVector` as a linear form on the weight space `M`. -/
def positiveLinearForm : Module.Dual R M :=
  P.toLinearMap.flip D.positiveVector

/-- The set of indecomposable positive root indices relative to `D.positiveVector`. -/
def simpleRoots : Set ι :=
  baseOf P.root (D.positiveLinearForm : M →+ R)

variable {D}

theorem borelSubgroup_def : D.borelSubgroup = D.T ⊔ D.positiveSubgroup :=
  (rfl)

theorem generatedSubgroup_def : D.generatedSubgroup = D.T ⊔ ⨆ i, D.U i :=
  (rfl)

@[simp]
theorem positiveLinearForm_apply_root (i : ι) :
    D.positiveLinearForm (P.root i) = P.root' i D.positiveVector :=
  (rfl)

theorem positiveLinearForm_root_ne_zero (i : ι) :
    D.positiveLinearForm (P.root i) ≠ 0 :=
  D.positiveVector_regular i

theorem simpleRoots_def :
    D.simpleRoots = baseOf P.root (D.positiveLinearForm : M →+ R) :=
  (rfl)

theorem root'_pos_of_mem_simpleRoots {a : ι} (ha : a ∈ D.simpleRoots) :
    0 < P.root' a D.positiveVector :=
  ha.1

theorem T_le_borelSubgroup : D.T ≤ D.borelSubgroup :=
  le_sup_left

theorem positiveSubgroup_le_borelSubgroup : D.positiveSubgroup ≤ D.borelSubgroup :=
  le_sup_right

theorem U_le_borelSubgroup_of_pos {i : ι} (hi : 0 < P.root' i D.positiveVector) :
    D.U i ≤ D.borelSubgroup :=
  (D.U_le_positiveSubgroup hi).trans D.positiveSubgroup_le_borelSubgroup

theorem T_le_normalizer_positiveSubgroup :
    D.T ≤ Subgroup.normalizer (D.positiveSubgroup : Set G) := by
  have hconj : ∀ {t : G}, t ∈ D.T → D.positiveSubgroup ≤
      D.positiveSubgroup.comap (MulAut.conj t⁻¹) := fun ht ↦
    D.positiveSubgroup_le_iff.mpr fun i hi u hu ↦
      D.U_le_positiveSubgroup hi (by simpa [MulAut.conj_apply] using D.inv_mul_mul_mem_U ht hu)
  intro t ht
  refine Subgroup.mem_normalizer_iff.mpr fun u ↦
    ⟨fun hu ↦ by simpa [MulAut.conj_apply] using hconj (D.T.inv_mem ht) hu,
      fun hu ↦ by simpa [MulAut.conj_apply, mul_assoc] using hconj ht hu⟩

/-- Since `T` normalizes `U⁺`, the carrier of `B = T ⊔ U⁺` is the set product `T * U⁺`. -/
theorem coe_borelSubgroup : (D.borelSubgroup : Set G) = (D.T : Set G) * D.positiveSubgroup :=
  Subgroup.coe_mul_of_left_le_normalizer_right D.T D.positiveSubgroup
    D.T_le_normalizer_positiveSubgroup

theorem isGenerating_iff_generatedSubgroup_eq_top :
    D.IsGenerating ↔ D.generatedSubgroup = ⊤ := by
  rw [D.isGenerating_iff, D.generatedSubgroup_def]

theorem T_le_generatedSubgroup : D.T ≤ D.generatedSubgroup :=
  le_sup_left

theorem U_le_generatedSubgroup (i : ι) : D.U i ≤ D.generatedSubgroup :=
  le_sup_of_le_right (le_iSup D.U i)

/-- Every reflection coset lies in the subgroup generated by `T` and the root subgroups. -/
theorem reflectionCoset_subset_generatedSubgroup (i : ι) :
    D.reflectionCoset i ⊆ D.generatedSubgroup := by
  obtain ⟨u, hu, _, x, hx, m, hm, y, hy, hxy⟩ := D.exists_mem_bruhat i
  have hm_mem : m ∈ D.generatedSubgroup := by
    have : m = x⁻¹ * u * y⁻¹ := by rw [hxy]; group
    rw [this]
    exact mul_mem (mul_mem (D.U_le_generatedSubgroup i (inv_mem hx))
      (D.U_le_generatedSubgroup _ hu)) (D.U_le_generatedSubgroup i (inv_mem hy))
  intro m' hm'
  have ht : m' * m⁻¹ ∈ D.generatedSubgroup :=
    D.T_le_generatedSubgroup (D.mul_inv_mem_T hm hm')
  simpa using mul_mem ht hm_mem

theorem weylNormalizer_le_generatedSubgroup : D.weylNormalizer ≤ D.generatedSubgroup :=
  D.weylNormalizer_le_iff.mpr ⟨D.T_le_generatedSubgroup, D.reflectionCoset_subset_generatedSubgroup⟩

theorem borelSubgroup_le_generatedSubgroup : D.borelSubgroup ≤ D.generatedSubgroup :=
  sup_le D.T_le_generatedSubgroup
    (D.positiveSubgroup_le_iff.mpr fun i _ ↦ D.U_le_generatedSubgroup i)

/-- No nontrivial element of a negative root subgroup lies in `B = T U⁺`. -/
theorem notMem_borelSubgroup_of_mem_U_of_neg {i : ι} (hi : P.root' i D.positiveVector < 0)
    {u : G} (hu : u ∈ D.U i) (hne : u ≠ 1) : u ∉ D.borelSubgroup := by
  intro huB
  have huB' : u ∈ (D.borelSubgroup : Set G) := huB
  rw [D.coe_borelSubgroup] at huB'
  obtain ⟨t, ht, v, hv, rfl⟩ := huB'
  exact hne (D.eq_one_of_mul_mem_negativeSubgroup ht hv (D.U_le_negativeSubgroup hi hu))

/-! ### Conjugation of root subgroups by `N` -/

/-- Every element of `N` permutes the root subgroups according to some element of `P.weylGroup`. -/
theorem exists_weylGroup_conj_smul_U {n : G} (hn : n ∈ D.weylNormalizer) :
    ∃ w : P.weylGroup, ∀ i, ConjAct.toConjAct n • D.U i = D.U (P.weylGroupToPerm w i) := by
  rw [D.weylNormalizer_def] at hn
  refine Subgroup.closure_induction ?_ ⟨1, fun i ↦ by simp⟩ ?_ ?_ hn
  · rintro g (ht | hm)
    · exact ⟨1, fun i ↦ by simpa using D.conj_smul_U_of_mem_T ht⟩
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hm
      refine ⟨weylGroup.ofIdx P a, fun i ↦ ?_⟩
      rw [P.weylGroupToPerm_ofIdx_apply]
      exact D.reflection_conjugates a g ha i
  · rintro x y _ _ ⟨wx, hwx⟩ ⟨wy, hwy⟩
    refine ⟨wx * wy, fun i ↦ ?_⟩
    rw [ConjAct.toConjAct_mul, mul_smul, hwy, hwx, map_mul, Equiv.Perm.mul_apply]
  · rintro x _ ⟨wx, hwx⟩
    refine ⟨wx⁻¹, fun i ↦ ?_⟩
    rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, hwx]
    simp

/-- Every element of `P.weylGroup` is realized on the root subgroups by some element of `N`. -/
theorem exists_mem_weylNormalizer_conj_smul_U (w : P.weylGroup) :
    ∃ n ∈ D.weylNormalizer, ∀ i, ConjAct.toConjAct n • D.U i = D.U (P.weylGroupToPerm w i) := by
  rcases w with ⟨g, hg⟩
  induction hg using weylGroup.induction with
  | mem a =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a
    refine ⟨m, D.reflectionCoset_subset_weylNormalizer a hm, fun i ↦ ?_⟩
    change ConjAct.toConjAct m • D.U i = D.U (P.weylGroupToPerm (weylGroup.ofIdx P a) i)
    rw [P.weylGroupToPerm_ofIdx_apply]
    exact D.reflection_conjugates a m hm i
  | one => exact ⟨1, one_mem _, fun i ↦ by simp⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨nx, hnx, hconjx⟩ := ihx
    obtain ⟨ny, hny, hconjy⟩ := ihy
    refine ⟨nx * ny, mul_mem hnx hny, fun i ↦ ?_⟩
    change ConjAct.toConjAct (nx * ny) • D.U i =
      D.U (P.weylGroupToPerm (⟨x, hx⟩ * ⟨y, hy⟩ : P.weylGroup) i)
    rw [ConjAct.toConjAct_mul, mul_smul, hconjy, hconjx, map_mul, Equiv.Perm.mul_apply]

/-! ### Ordered consequences of (DR6) -/

section Ordered

variable [IsStrictOrderedRing R]

instance instNormalSubgroupOfWeylNormalizer : (D.T.subgroupOf D.weylNormalizer).Normal :=
  D.T_normal_weylNormalizer

/-- The subgroups `B` and `N` generate the same subgroup as `T` and all root subgroups. -/
theorem borelSubgroup_sup_weylNormalizer :
    D.borelSubgroup ⊔ D.weylNormalizer = D.generatedSubgroup := by
  refine le_antisymm
    (sup_le D.borelSubgroup_le_generatedSubgroup D.weylNormalizer_le_generatedSubgroup)
    (sup_le (le_sup_of_le_left D.T_le_borelSubgroup) (iSup_le fun i ↦ ?_))
  rcases (D.positiveVector_regular i).lt_or_gt with hneg | hpos
  · set j := P.reflectionPerm i i
    have hj : 0 < P.root' j D.positiveVector := by simpa [j] using neg_pos.mpr hneg
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
    intro u hu
    have hmu : m⁻¹ * u * m ∈ D.U j := by
      simpa using D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset (D.inv_mem_reflectionCoset hm) hu
    have hmN : m ∈ D.borelSubgroup ⊔ D.weylNormalizer :=
      Subgroup.mem_sup_right (D.reflectionCoset_subset_weylNormalizer i hm)
    have hmuB : m⁻¹ * u * m ∈ D.borelSubgroup ⊔ D.weylNormalizer :=
      Subgroup.mem_sup_left (D.U_le_borelSubgroup_of_pos hj hmu)
    have : u = m * (m⁻¹ * u * m) * m⁻¹ := by group
    rw [this]
    exact mul_mem (mul_mem hmN hmuB) (inv_mem hmN)
  · exact (D.U_le_borelSubgroup_of_pos hpos).trans le_sup_left

theorem closure_borelSubgroup_union_weylNormalizer :
    Subgroup.closure ((D.borelSubgroup : Set G) ∪ D.weylNormalizer) = D.generatedSubgroup := by
  rw [← Subgroup.sup_eq_closure, D.borelSubgroup_sup_weylNormalizer]

/-- Two roots with opposite signs on `D.positiveVector` have distinct root subgroups. -/
theorem U_ne_of_root'_mul_neg {i j : ι}
    (h : P.root' i D.positiveVector * P.root' j D.positiveVector < 0) :
    D.U i ≠ D.U j := by
  intro hU
  rcases mul_neg_iff.mp h with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot j)
    exact D.notMem_borelSubgroup_of_mem_U_of_neg hj hu (Subtype.coe_ne_coe.mpr hne)
      (D.U_le_borelSubgroup_of_pos hi (hU.symm ▸ hu))
  · obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot i)
    exact D.notMem_borelSubgroup_of_mem_U_of_neg hi hu (Subtype.coe_ne_coe.mpr hne)
      (D.U_le_borelSubgroup_of_pos hj (hU ▸ hu))

end Ordered

/-! ### Injectivity of `U`, Weyl homomorphism, and `N / T ≃* W` -/

section Crystallographic

variable [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic]

omit [Finite ι] [P.IsCrystallographic] in
private theorem U_ne_of_root_eq_neg_two_smul {i j : ι} (h : P.root j = (-2 : R) • P.root i) :
    D.U i ≠ D.U j := by
  intro hU
  set k := P.reflectionPerm i i
  have hkj : P.root j = (2 : R) • P.root k := by
    simp [k, h, neg_smul]
  have hle : D.U i ≤ D.U k := hU ▸ D.le_of_root_eq_two_smul k j hkj
  refine D.U_ne_bot i (eq_bot_iff.mpr fun g hg ↦ ?_)
  exact D.eq_one_of_mem_normalizer hg (Subgroup.le_normalizer (hle hg))

/-- Distinct root indices determine distinct root subgroups (Bruhat–Tits I, 6.1.2 (2)). -/
theorem U_injective : Function.Injective D.U := by
  intro i j hU
  by_contra hne
  by_cases hli : LinearIndependent R ![P.root i, P.root j]
  · obtain ⟨w, hw⟩ := P.exists_weylGroup_apply_root_mul_neg D.positiveLinearForm
      D.positiveLinearForm_root_ne_zero hli
    obtain ⟨n, _, hn⟩ := D.exists_mem_weylNormalizer_conj_smul_U w
    have hUw : D.U (P.weylGroupToPerm w i) = D.U (P.weylGroupToPerm w j) := by
      rw [← hn i, ← hn j, hU]
    exact D.U_ne_of_root'_mul_neg hw hUw
  · rcases P.not_linearIndependent_root_iff.mp hli with rfl | h | h | h | h | h
    · exact hne rfl
    · exact D.U_ne_of_root_eq_neg h hU.symm
    · exact D.ne_of_root_eq_two_smul i j h hU.symm
    · exact D.ne_of_root_eq_two_smul j i h hU
    · exact D.U_ne_of_root_eq_neg_two_smul h hU
    · exact D.U_ne_of_root_eq_neg_two_smul h hU.symm

/-- Every element of `N` induces a unique element of `P.weylGroup` on the root subgroups. -/
theorem existsUnique_weylGroup_conj_smul_U (n : D.weylNormalizer) :
    ∃! w : P.weylGroup, ∀ i, ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm w i) := by
  obtain ⟨w, hw⟩ := D.exists_weylGroup_conj_smul_U n.2
  refine ⟨w, hw, fun w' hw' ↦ P.weylGroupToPerm_injective_of_isCrystallographic ?_⟩
  ext i
  exact D.U_injective ((hw' i).symm.trans (hw i))

/-- The canonical group homomorphism `ν : N →* P.weylGroup` sending `n ∈ N` to the unique Weyl
element satisfying `n U i n⁻¹ = U (ν n • i)` for every root `i`. -/
noncomputable def weylNormalizerHom : D.weylNormalizer →* P.weylGroup where
  toFun n := (D.existsUnique_weylGroup_conj_smul_U n).choose
  map_one' := ((D.existsUnique_weylGroup_conj_smul_U 1).unique
    (D.existsUnique_weylGroup_conj_smul_U 1).choose_spec.1 (fun i ↦ by simp))
  map_mul' x y := by
    refine (D.existsUnique_weylGroup_conj_smul_U (x * y)).unique
      (D.existsUnique_weylGroup_conj_smul_U (x * y)).choose_spec.1 (fun i ↦ ?_)
    have hx := (D.existsUnique_weylGroup_conj_smul_U x).choose_spec.1
    have hy := (D.existsUnique_weylGroup_conj_smul_U y).choose_spec.1
    rw [Subgroup.coe_mul, ConjAct.toConjAct_mul, mul_smul, hy, hx, map_mul, Equiv.Perm.mul_apply]

/-- Conjugating `U i` by `n ∈ N` yields `U (ν n • i)`. -/
theorem conj_smul_U_weylNormalizer (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i =
      D.U (P.weylGroupToPerm (D.weylNormalizerHom n) i) :=
  (D.existsUnique_weylGroup_conj_smul_U n).choose_spec.1 i

/-- Characterization of `D.weylNormalizerHom n` by its conjugation action on root subgroups. -/
theorem weylNormalizerHom_eq_iff {n : D.weylNormalizer} {w : P.weylGroup} :
    D.weylNormalizerHom n = w ↔
      ∀ i, ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm w i) :=
  ⟨fun h ↦ h ▸ D.conj_smul_U_weylNormalizer n,
    fun h ↦ (D.existsUnique_weylGroup_conj_smul_U n).unique
      (D.conj_smul_U_weylNormalizer n) h⟩

theorem weylNormalizerHom_surjective : Function.Surjective D.weylNormalizerHom := fun w ↦ by
  obtain ⟨n, hn, hconj⟩ := D.exists_mem_weylNormalizer_conj_smul_U w
  exact ⟨⟨n, hn⟩, D.weylNormalizerHom_eq_iff.mpr hconj⟩

@[simp]
theorem weylNormalizerHom_of_mem_T {n : D.weylNormalizer} (hn : (n : G) ∈ D.T) :
    D.weylNormalizerHom n = 1 :=
  D.weylNormalizerHom_eq_iff.mpr fun i ↦ by simpa using D.conj_smul_U_of_mem_T hn

theorem weylNormalizerHom_of_mem_reflectionCoset {i : ι} {n : D.weylNormalizer}
    (hn : (n : G) ∈ D.reflectionCoset i) :
    D.weylNormalizerHom n = weylGroup.ofIdx P i :=
  D.weylNormalizerHom_eq_iff.mpr fun j ↦ by
    rw [P.weylGroupToPerm_ofIdx_apply]
    exact D.reflection_conjugates i (n : G) hn j

omit [P.IsCrystallographic] in
/-- If `2 a` is also a root, then `M (2 a) = M a` (Bruhat–Tits I, 6.1.2 (4)). -/
theorem reflectionCoset_eq_of_root_eq_two_smul {i j : ι} (h : P.root j = (2 : R) • P.root i) :
    D.reflectionCoset j = D.reflectionCoset i := by
  obtain ⟨u, hu, hne, x, hx, m, hm, y, hy, rfl⟩ := D.exists_mem_bruhat j
  have hrefl : P.reflectionPerm j = P.reflectionPerm i := P.reflectionPerm_eq_of_root_eq_smul h
  have hneg : P.root (P.reflectionPerm j j) = (2 : R) • P.root (P.reflectionPerm i i) := by
    rw [root_reflectionPerm, root_reflectionPerm, P.reflection_apply_self,
      P.reflection_apply_self, h, smul_neg]
  have hle : D.U j ≤ D.U i := D.le_of_root_eq_two_smul i j h
  have hle_neg : D.U (P.reflectionPerm j j) ≤ D.U (P.reflectionPerm i i) :=
    D.le_of_root_eq_two_smul _ _ hneg
  have hmi : m ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have := D.mul_mul_mem_mul (hle (inv_mem hx)) (hle (inv_mem hy))
        (D.bruhat i ⟨hle_neg hu, hne⟩)
      convert this using 1
      group
    · rw [D.reflection_conjugates j m hm i, hrefl]
    · rw [D.reflection_conjugates j m hm (P.reflectionPerm i i), hrefl,
        P.reflectionPerm_self]
  ext g
  rw [D.mem_reflectionCoset_iff_mul_inv_mem_T hm, D.mem_reflectionCoset_iff_mul_inv_mem_T hmi]

/-- Conjugating `M i` by `n ∈ N` gives `M (ν n • i)` (Bruhat–Tits I, 6.1.2 (5)). -/
theorem conj_mem_reflectionCoset (n : D.weylNormalizer) {i : ι} {m : G}
    (hm : m ∈ D.reflectionCoset i) :
    (n : G) * m * (n : G)⁻¹ ∈
      D.reflectionCoset (P.weylGroupToPerm (D.weylNormalizerHom n) i) := by
  set w := D.weylNormalizerHom n
  set k := P.weylGroupToPerm w i
  have hw_neg : P.weylGroupToPerm w (P.reflectionPerm i i) = P.reflectionPerm k k := by
    let _ := P.indexNeg
    simpa [k, ← indexNeg_neg] using P.weylGroupToPerm_neg w i
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  have hconj_mem {j : ι} {g : G} (hg : g ∈ D.U j) :
      (n : G) * g * (n : G)⁻¹ ∈ D.U (P.weylGroupToPerm w j) := by
    rw [← D.conj_smul_U_weylNormalizer n j, ← ConjAct.toConjAct_smul]
    exact Subgroup.smul_mem_pointwise_smul _ _ _ hg
  have hm₁' : (n : G) * m₁ * (n : G)⁻¹ ∈ D.reflectionCoset k := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : (n : G) * (x * m₁ * y) * (n : G)⁻¹ ∈
          (D.U (P.reflectionPerm k k) : Set G) \ {1} := by
        refine ⟨hw_neg ▸ hconj_mem hu, fun h ↦ hne ?_⟩
        have : x * m₁ * y =
            (n : G)⁻¹ * ((n : G) * (x * m₁ * y) * (n : G)⁻¹) * (n : G) := by group
        rw [this, h, mul_one, inv_mul_cancel]
      have := D.mul_mul_mem_mul (hconj_mem (inv_mem hx)) (hconj_mem (inv_mem hy)) (D.bruhat k hu')
      convert this using 1
      group
    · have hinv : ConjAct.toConjAct (n : G)⁻¹ • D.U k = D.U i := by
        rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.conj_smul_U_weylNormalizer]
      rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul, hinv,
        D.reflection_conjugates i m₁ hm₁ i, D.conj_smul_U_weylNormalizer, hw_neg]
    · have hinv : ConjAct.toConjAct (n : G)⁻¹ • D.U (P.reflectionPerm k k) =
          D.U (P.reflectionPerm i i) := by
        rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.conj_smul_U_weylNormalizer, hw_neg]
      rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul, hinv,
        D.conj_smul_U_neg hm₁, D.conj_smul_U_weylNormalizer]
  have hs : (n : G) * (m * m₁⁻¹) * (n : G)⁻¹ ∈ D.T :=
    (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) _).mp
      (D.mul_inv_mem_T hm₁ hm)
  have : (n : G) * m * (n : G)⁻¹ =
      ((n : G) * (m * m₁⁻¹) * (n : G)⁻¹) * ((n : G) * m₁ * (n : G)⁻¹) := by group
  rw [this]
  exact D.mul_mem_reflectionCoset hs hm₁'

/-- `N` is already generated by `T` and the reflection cosets of `D.simpleRoots`
(Bruhat–Tits I, 6.1.2 (10)). -/
theorem weylNormalizer_eq_closure_simpleRoots :
    D.weylNormalizer =
      Subgroup.closure ((D.T : Set G) ∪ ⋃ a ∈ D.simpleRoots, D.reflectionCoset a) := by
  set N₀ := Subgroup.closure ((D.T : Set G) ∪ ⋃ a ∈ D.simpleRoots, D.reflectionCoset a)
  have hle : N₀ ≤ D.weylNormalizer := by
    rw [D.weylNormalizer_def]
    exact Subgroup.closure_mono <|
      Set.union_subset_union_right _ (Set.iUnion₂_subset fun a _ ↦ Set.subset_iUnion _ a)
  refine le_antisymm (D.weylNormalizer_le_iff.mpr
    ⟨fun t ht ↦ Subgroup.subset_closure (.inl ht), fun i ↦ ?_⟩) hle
  obtain ⟨j, hj, hij⟩ := P.exists_isIndivisible i
  have hcoset : D.reflectionCoset i = D.reflectionCoset j := by
    rcases hij with rfl | h2
    · rfl
    · exact D.reflectionCoset_eq_of_root_eq_two_smul h2
  rw [hcoset]
  obtain ⟨w, hw, a, ha, rfl⟩ := P.exists_mem_closure_ofIdx_baseOf_weylGroupToPerm_eq
    D.positiveLinearForm D.positiveLinearForm_root_ne_zero hj
  have hlift : ∃ (n : G) (hn : n ∈ N₀), D.weylNormalizerHom ⟨n, hle hn⟩ = w := by
    refine Subgroup.closure_induction ?_ ⟨1, one_mem _, map_one _⟩ ?_ ?_ hw
    · rintro _ ⟨b, hb, rfl⟩
      obtain ⟨mb, hmb⟩ := D.reflectionCoset_nonempty b
      have hmb₀ : mb ∈ N₀ := Subgroup.subset_closure (.inr (Set.mem_biUnion hb hmb))
      exact ⟨mb, hmb₀, D.weylNormalizerHom_of_mem_reflectionCoset hmb⟩
    · rintro _ _ _ _ ⟨nx, hnx, rfl⟩ ⟨ny, hny, rfl⟩
      exact ⟨nx * ny, mul_mem hnx hny, D.weylNormalizerHom.map_mul ⟨nx, hle hnx⟩ ⟨ny, hle hny⟩⟩
    · rintro _ _ ⟨nx, hnx, rfl⟩
      exact ⟨nx⁻¹, inv_mem hnx, D.weylNormalizerHom.map_inv ⟨nx, hle hnx⟩⟩
  obtain ⟨n, hn₀, hnw⟩ := hlift
  obtain ⟨ma, hma⟩ := D.reflectionCoset_nonempty a
  have hma₀ : ma ∈ N₀ := Subgroup.subset_closure (.inr (Set.mem_biUnion ha hma))
  have hconj : n * ma * n⁻¹ ∈ D.reflectionCoset (P.weylGroupToPerm w a) := by
    have := D.conj_mem_reflectionCoset ⟨n, hle hn₀⟩ hma
    rwa [hnw] at this
  have hconj₀ : n * ma * n⁻¹ ∈ N₀ := mul_mem (mul_mem hn₀ hma₀) (inv_mem hn₀)
  intro m hm
  have ht : m * (n * ma * n⁻¹)⁻¹ ∈ N₀ :=
    Subgroup.subset_closure (.inl (D.mul_inv_mem_T hconj hm))
  have hmul : m * (n * ma * n⁻¹)⁻¹ * (n * ma * n⁻¹) = m := by group
  exact hmul ▸ mul_mem ht hconj₀

/-! ### Coset-word shortening and the kernel of `ν` -/

private def cosetWord (D : RootDatum P G) : List ι → Set G
  | [] => D.T
  | b :: l => D.reflectionCoset b * cosetWord D l

omit [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] in
private theorem cosetWord_subset_weylNormalizer :
    ∀ l : List ι, cosetWord D l ⊆ D.weylNormalizer
  | [] => D.T_le_weylNormalizer
  | b :: l => by
    rintro _ ⟨m, hm, x, hx, rfl⟩
    exact mul_mem (D.reflectionCoset_subset_weylNormalizer b hm)
      (cosetWord_subset_weylNormalizer l hx)

omit [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] in
private theorem T_mul_cosetWord_subset :
    ∀ l : List ι, (D.T : Set G) * cosetWord D l ⊆ cosetWord D l
  | [] => by
    rintro _ ⟨t₁, ht₁, t₂, ht₂, rfl⟩
    exact D.T.mul_mem ht₁ ht₂
  | b :: l => by
    rintro _ ⟨t, ht, _, ⟨m, hm, x, hx, rfl⟩, rfl⟩
    exact ⟨t * m, D.mul_mem_reflectionCoset ht hm, x, hx, mul_assoc t m x⟩

omit [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] in
private theorem cosetWord_mul_subset_append :
    ∀ l₁ l₂ : List ι, cosetWord D l₁ * cosetWord D l₂ ⊆ cosetWord D (l₁ ++ l₂)
  | [], l₂ => T_mul_cosetWord_subset l₂
  | b :: l₁, l₂ => by
    rintro _ ⟨_, ⟨m, hm, x, hx, rfl⟩, y, hy, rfl⟩
    exact ⟨m, hm, x * y, cosetWord_mul_subset_append l₁ l₂ ⟨x, hx, y, hy, rfl⟩,
      (mul_assoc m x y).symm⟩

omit [Finite ι] [P.IsCrystallographic] in
private theorem inv_mem_cosetWord_reverse :
    ∀ (l : List ι) {x : G}, x ∈ cosetWord D l → x⁻¹ ∈ cosetWord D l.reverse
  | [], _, hx => D.T.inv_mem hx
  | b :: l, _, ⟨m, hm, y, hy, rfl⟩ => by
    rw [List.reverse_cons]
    exact D.cosetWord_mul_subset_append l.reverse [b]
      ⟨y⁻¹, inv_mem_cosetWord_reverse l hy,
        m⁻¹, ⟨m⁻¹, D.inv_mem_reflectionCoset hm, 1, D.T.one_mem, mul_one _⟩, by group⟩

omit [Finite ι] [P.IsCrystallographic] in
private theorem cosetWord_concat_subset :
    ∀ (l : List ι) (a : ι), cosetWord D (l ++ [a]) ⊆ cosetWord D l * D.reflectionCoset a
  | [], a => by
    rintro _ ⟨m, hm, t, ht, rfl⟩
    exact ⟨m * t * m⁻¹, D.mul_mul_inv_mem_T hm ht, m, hm, by group⟩
  | b :: l, a => by
    rintro _ ⟨m, hm, y, hy, rfl⟩
    obtain ⟨x, hx, ma, hma, rfl⟩ := cosetWord_concat_subset l a hy
    exact ⟨m * x, ⟨m, hm, x, hx, rfl⟩, ma, hma, mul_assoc m x ma⟩

private theorem exists_mem_cosetWord_simpleRoots {n : G} (hn : n ∈ D.weylNormalizer) :
    ∃ l : List ι, (∀ a ∈ l, a ∈ D.simpleRoots) ∧ n ∈ cosetWord D l := by
  rw [D.weylNormalizer_eq_closure_simpleRoots] at hn
  refine Subgroup.closure_induction ?_ ⟨[], by simp, D.T.one_mem⟩ ?_ ?_ hn
  · rintro g (ht | hm)
    · exact ⟨[], by simp, ht⟩
    · obtain ⟨a, ha, hma⟩ := Set.mem_iUnion₂.mp hm
      exact ⟨[a], by simp [ha], ⟨g, hma, 1, D.T.one_mem, mul_one g⟩⟩
  · rintro x y _ _ ⟨l₁, hl₁, hx⟩ ⟨l₂, hl₂, hy⟩
    exact ⟨l₁ ++ l₂, List.forall_mem_append.mpr ⟨hl₁, hl₂⟩,
      D.cosetWord_mul_subset_append l₁ l₂ ⟨x, hx, y, hy, rfl⟩⟩
  · rintro x _ ⟨l, hl, hx⟩
    exact ⟨l.reverse, fun a ha ↦ hl a (List.mem_reverse.mp ha),
      D.inv_mem_cosetWord_reverse l hx⟩

private theorem weylNormalizerHom_eq_of_mem_cosetWord :
    ∀ (l : List ι) (n : D.weylNormalizer), (n : G) ∈ cosetWord D l →
      D.weylNormalizerHom n = (l.map (weylGroup.ofIdx P)).prod
  | [], n, hn => by
    simpa using D.weylNormalizerHom_of_mem_T hn
  | b :: l, n, ⟨m, hm, x, hx, hnx⟩ => by
    let nm : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer b hm⟩
    let nx : D.weylNormalizer := ⟨x, D.cosetWord_subset_weylNormalizer l hx⟩
    have hmul : n = nm * nx := Subtype.ext hnx.symm
    rw [hmul, map_mul, D.weylNormalizerHom_of_mem_reflectionCoset hm,
      weylNormalizerHom_eq_of_mem_cosetWord l nx hx, List.map_cons, List.prod_cons]

private theorem exists_shorter_cosetWord_of_root'_neg (l₀ : List ι)
    (hl₀ : ∀ b ∈ l₀, b ∈ D.simpleRoots) {k : ι} (hk_ind : P.IsIndivisible k)
    (hk_pos : 0 < P.root' k D.positiveVector)
    (hk_neg : P.root' (P.weylGroupToPerm (l₀.map (weylGroup.ofIdx P)).prod k)
      D.positiveVector < 0)
    {g : G} (hg : g ∈ cosetWord D l₀ * D.reflectionCoset k) :
    ∃ l' : List ι, (∀ b ∈ l', b ∈ D.simpleRoots) ∧ l'.length < l₀.length ∧
      g ∈ cosetWord D l' := by
  induction l₀ generalizing g with
  | nil =>
    simp only [List.map_nil, List.prod_nil, map_one, Equiv.Perm.coe_one, id_eq] at hk_neg
    exact (lt_asymm hk_pos hk_neg).elim
  | cons b l₁ ih =>
    have hb : b ∈ D.simpleRoots := hl₀ b List.mem_cons_self
    have hl₁ : ∀ c ∈ l₁, c ∈ D.simpleRoots := fun c hc ↦ hl₀ c (List.mem_cons_of_mem b hc)
    let u₁ := (l₁.map (weylGroup.ofIdx P)).prod
    simp only [List.map_cons, List.prod_cons, P.weylGroupToPerm_ofIdx_mul_apply] at hk_neg
    obtain ⟨_, ⟨mb, hmb, x, hx, rfl⟩, mk, hmk, rfl⟩ := hg
    rcases (D.positiveVector_regular (P.weylGroupToPerm u₁ k)).lt_or_gt with hu₁_neg | hu₁_pos
    · obtain ⟨l', hl', hlen', hxm⟩ := ih hl₁ hu₁_neg ⟨x, hx, mk, hmk, rfl⟩
      exact ⟨b :: l', List.forall_mem_cons.mpr ⟨hb, hl'⟩, Nat.succ_lt_succ hlen',
        ⟨mb, hmb, x * mk, hxm, (mul_assoc mb x mk).symm⟩⟩
    · have heq_bk : P.weylGroupToPerm u₁ k = b := by
        by_contra hne
        have hli := (P.linearIndependent_iff_of_isIndivisible_of_pos D.positiveLinearForm
          (P.isIndivisible_of_mem_baseOf D.positiveLinearForm hb) hb.1 hu₁_pos).mpr
          ⟨hne, P.isIndivisible_iff.mp ((P.isIndivisible_weylGroupToPerm u₁ k).mpr hk_ind) b⟩
        exact lt_asymm (P.apply_root_reflectionPerm_pos_of_mem_baseOf D.positiveLinearForm
          D.positiveLinearForm_root_ne_zero hb hu₁_pos hli) hk_neg
      let nx : D.weylNormalizer := ⟨x, D.cosetWord_subset_weylNormalizer l₁ hx⟩
      have hnx : D.weylNormalizerHom nx = u₁ := D.weylNormalizerHom_eq_of_mem_cosetWord l₁ nx hx
      have hconj : x * mk * x⁻¹ ∈ D.reflectionCoset b := by
        have := D.conj_mem_reflectionCoset nx hmk
        rwa [hnx, heq_bk] at this
      have ht : mb * (x * mk * x⁻¹) ∈ D.T := by
        simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hconj) hmb
      refine ⟨l₁, hl₁, Nat.lt_succ_self _, D.T_mul_cosetWord_subset l₁ ?_⟩
      exact ⟨mb * (x * mk * x⁻¹), ht, x, hx, by group⟩

/-- The kernel of `D.weylNormalizerHom : N →* P.weylGroup` is `T` (regarded inside `N`)
(Bruhat–Tits I, 6.1.2 (10)). -/
theorem weylNormalizerHom_ker :
    D.weylNormalizerHom.ker = D.T.subgroupOf D.weylNormalizer := by
  classical
  refine le_antisymm (fun n hn ↦ ?_) (fun n hn ↦ D.weylNormalizerHom_of_mem_T hn)
  have hne : {m : ℕ | ∃ l : List ι, (∀ a ∈ l, a ∈ D.simpleRoots) ∧ l.length = m ∧
      (n : G) ∈ cosetWord D l}.Nonempty := by
    obtain ⟨l, hl, hmem⟩ := D.exists_mem_cosetWord_simpleRoots n.2
    exact ⟨l.length, l, hl, rfl, hmem⟩
  obtain ⟨l, hl, hlen, hmem⟩ := Nat.find_spec hne
  rcases List.eq_nil_or_concat l with rfl | ⟨l₀, a, hconcat⟩
  · exact hmem
  · exfalso
    rw [List.concat_eq_append] at hconcat
    subst hconcat
    have hl₀ : ∀ b ∈ l₀, b ∈ D.simpleRoots := (List.forall_mem_append.mp hl).1
    have ha : a ∈ D.simpleRoots :=
      (List.forall_mem_append.mp hl).2 a (List.mem_singleton_self a)
    have hprod : (l₀.map (weylGroup.ofIdx P)).prod = weylGroup.ofIdx P a := by
      have h1 : ((l₀ ++ [a]).map (weylGroup.ofIdx P)).prod = 1 :=
        (D.weylNormalizerHom_eq_of_mem_cosetWord (l₀ ++ [a]) n hmem).symm.trans hn
      simp only [List.map_append, List.map_singleton, List.prod_append, List.prod_singleton] at h1
      simpa [weylGroup.ofIdx_inv_eq] using eq_inv_of_mul_eq_one_left h1
    have hua_neg : P.root' (P.weylGroupToPerm (l₀.map (weylGroup.ofIdx P)).prod a)
        D.positiveVector < 0 := by
      rw [hprod, P.weylGroupToPerm_ofIdx_apply]
      simpa using neg_lt_zero.mpr ha.1
    obtain ⟨l', hl', hlen', hmem'⟩ := D.exists_shorter_cosetWord_of_root'_neg l₀ hl₀
      (P.isIndivisible_of_mem_baseOf D.positiveLinearForm ha) ha.1 hua_neg
      (D.cosetWord_concat_subset l₀ a hmem)
    have hle := Nat.find_min' hne ⟨l', hl', rfl, hmem'⟩
    rw [← hlen, List.length_append, List.length_singleton] at hle
    omega

/-- The canonical isomorphism `N / T ≃* P.weylGroup` attached to a root datum
(Bruhat–Tits I, 6.1.2 (10)). -/
noncomputable def weylGroupEquiv :
    D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup :=
  QuotientGroup.liftEquiv (D.T.subgroupOf D.weylNormalizer) D.weylNormalizerHom_surjective
    D.weylNormalizerHom_ker.symm

@[simp]
theorem weylGroupEquiv_mk (n : D.weylNormalizer) :
    D.weylGroupEquiv (QuotientGroup.mk n) = D.weylNormalizerHom n :=
  (rfl)

/-- `D.weylGroupEquiv` is pinned by the conjugation action of `N` on the root subgroups. -/
theorem weylGroupEquiv_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i =
      D.U (P.weylGroupToPerm (D.weylGroupEquiv (QuotientGroup.mk n)) i) :=
  D.conj_smul_U_weylNormalizer n i

theorem weylGroupEquiv_mk_of_mem_reflectionCoset {i : ι} {n : D.weylNormalizer}
    (hn : (n : G) ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk n) = weylGroup.ofIdx P i :=
  D.weylNormalizerHom_of_mem_reflectionCoset hn

/-- Every element of a reflection coset represents a nontrivial involution in `N / T`. -/
theorem weylGroupEquiv_mk_ne_one_of_mem_reflectionCoset {i : ι} {n : D.weylNormalizer}
    (hn : (n : G) ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk n) ≠ 1 := by
  rw [D.weylGroupEquiv_mk_of_mem_reflectionCoset hn]
  exact weylGroup.ofIdx_ne_one P i

theorem weylNormalizerHom_eq_one_iff {n : D.weylNormalizer} :
    D.weylNormalizerHom n = 1 ↔ (n : G) ∈ D.T := by
  rw [← MonoidHom.mem_ker, D.weylNormalizerHom_ker, Subgroup.mem_subgroupOf]

instance instFiniteWeylGroupQuotient :
    Finite (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) :=
  have := P.finite_weylGroup_of_isCrystallographic
  Finite.of_equiv _ D.weylGroupEquiv.symm.toEquiv

/-! ### `B ∩ N = T` and the Tits system `(B, N)` -/

/-- The intersection `B ∩ N` is `T` (Bruhat–Tits I, Proposition 6.1.11 (ii)). -/
@[simp]
theorem borelSubgroup_inf_weylNormalizer : D.borelSubgroup ⊓ D.weylNormalizer = D.T := by
  refine le_antisymm (fun g ⟨hgB, hgN⟩ ↦ ?_) (le_inf D.T_le_borelSubgroup D.T_le_weylNormalizer)
  have hgB' : g ∈ (D.borelSubgroup : Set G) := hgB
  rw [D.coe_borelSubgroup] at hgB'
  obtain ⟨t, ht, u, hu, rfl⟩ := hgB'
  have huN : u ∈ D.weylNormalizer := by
    simpa using mul_mem (inv_mem (D.T_le_weylNormalizer ht)) hgN
  let nu : D.weylNormalizer := ⟨u, huN⟩
  have hnu_one : D.weylNormalizerHom nu = 1 := by
    by_contra hne
    have hinv_ne : (D.weylNormalizerHom nu)⁻¹ ≠ 1 := inv_ne_one.mpr hne
    have hexists : ¬ ∀ a ∈ D.simpleRoots,
        0 < P.root' (P.weylGroupToPerm (D.weylNormalizerHom nu)⁻¹ a) D.positiveVector :=
      fun hall ↦ hinv_ne (weylGroup.eq_one_of_forall_mem_baseOf_pos P D.positiveLinearForm
        D.positiveLinearForm_root_ne_zero hall)
    push Not at hexists
    obtain ⟨a, ha, ha_le⟩ := hexists
    set j := P.weylGroupToPerm (D.weylNormalizerHom nu)⁻¹ a
    have hj_neg : P.root' j D.positiveVector < 0 :=
      lt_of_le_of_ne ha_le (D.positiveVector_regular j)
    have hwj : P.weylGroupToPerm (D.weylNormalizerHom nu) j = a := by simp [j]
    obtain ⟨⟨x, hx⟩, hx_ne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot j)
    have hux : u * x * u⁻¹ ∈ D.positiveSubgroup := by
      refine D.U_le_positiveSubgroup ha.1 ?_
      rw [← hwj, ← D.conj_smul_U_weylNormalizer nu j, ← ConjAct.toConjAct_smul]
      exact Subgroup.smul_mem_pointwise_smul _ _ _ hx
    have hx_pos : x ∈ D.positiveSubgroup := by
      have : x = u⁻¹ * (u * x * u⁻¹) * u := by group
      rw [this]
      exact mul_mem (mul_mem (inv_mem hu) hux) hu
    exact Subtype.coe_ne_coe.mpr hx_ne <| by
      simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem hx_pos
        (by simpa using D.U_le_negativeSubgroup hj_neg hx)
  have huT : u ∈ D.T := by
    have : nu ∈ D.weylNormalizerHom.ker := hnu_one
    rwa [D.weylNormalizerHom_ker] at this
  exact D.T.mul_mem ht huT

@[simp]
theorem borelSubgroup_subgroupOf_weylNormalizer :
    D.borelSubgroup.subgroupOf D.weylNormalizer = D.T.subgroupOf D.weylNormalizer := by
  ext n
  simp only [Subgroup.mem_subgroupOf]
  exact ⟨fun h ↦ D.borelSubgroup_inf_weylNormalizer ▸ ⟨h, n.2⟩, fun h ↦ D.T_le_borelSubgroup h⟩

instance instNormalBorelSubgroupOfWeylNormalizer :
    (D.borelSubgroup.subgroupOf D.weylNormalizer).Normal :=
  D.borelSubgroup_subgroupOf_weylNormalizer ▸ D.T_normal_weylNormalizer

/-- The canonical isomorphism `(N / (B ∩ N)) ≃* P.weylGroup` attached to `(B, N)`. -/
noncomputable def titsWeylGroupEquiv :
    D.weylNormalizer ⧸ D.borelSubgroup.subgroupOf D.weylNormalizer ≃* P.weylGroup :=
  QuotientGroup.liftEquiv (D.borelSubgroup.subgroupOf D.weylNormalizer)
    D.weylNormalizerHom_surjective
    (D.borelSubgroup_subgroupOf_weylNormalizer.trans D.weylNormalizerHom_ker.symm)

@[simp]
theorem titsWeylGroupEquiv_mk (n : D.weylNormalizer) :
    D.titsWeylGroupEquiv (QuotientGroup.mk n) = D.weylNormalizerHom n :=
  (rfl)

/-! ### Rank-one Bruhat cell multiplication -/

private def positiveComplement (D : RootDatum P G) (a : ι) : Subgroup G :=
  ⨆ (b) (_ : 0 < P.root' b D.positiveVector ∧ LinearIndependent R ![P.root a, P.root b]), D.U b

omit [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] in
private theorem positiveComplement_le_positiveSubgroup (a : ι) :
    positiveComplement D a ≤ D.positiveSubgroup :=
  iSup₂_le fun _ hb ↦ D.U_le_positiveSubgroup hb.1

private theorem positiveSubgroup_eq_sup_positiveComplement {a : ι} (ha : a ∈ D.simpleRoots) :
    D.positiveSubgroup = D.U a ⊔ positiveComplement D a := by
  refine le_antisymm (D.positiveSubgroup_le_iff.mpr fun b hb ↦ ?_)
    (sup_le (D.U_le_positiveSubgroup ha.1) (D.positiveComplement_le_positiveSubgroup a))
  by_cases hli : LinearIndependent R ![P.root a, P.root b]
  · exact (le_iSup₂ (f := fun b (_ : 0 < P.root' b D.positiveVector ∧
      LinearIndependent R ![P.root a, P.root b]) ↦ D.U b) b ⟨hb, hli⟩).trans le_sup_right
  · have hcases : b = a ∨ P.root b = (2 : R) • P.root a := by
      by_contra! hne
      exact hli ((P.linearIndependent_iff_of_isIndivisible_of_pos D.positiveLinearForm
        (P.isIndivisible_of_mem_baseOf D.positiveLinearForm ha) ha.1 hb).mpr hne)
    rcases hcases with rfl | h2
    · exact le_sup_left
    · exact (D.le_of_root_eq_two_smul a b h2).trans le_sup_left

omit [Finite ι] [P.IsCrystallographic] in
private theorem commutator_U_le_positiveComplement {a b : ι} (ha : a ∈ D.simpleRoots)
    (hb_pos : 0 < P.root' b D.positiveVector) (hli : LinearIndependent R ![P.root a, P.root b]) :
    ⁅D.U a, D.U b⁆ ≤ positiveComplement D a := by
  have ha_pos : 0 < P.root' a D.positiveVector := D.root'_pos_of_mem_simpleRoots ha
  have hab : ∀ c : R, 0 < c → P.root b ≠ -(c • P.root a) := by
    intro c hc h
    have : P.root' b D.positiveVector < 0 := by
      rw [← D.positiveLinearForm_apply_root, h, map_neg, map_smul, smul_eq_mul,
        D.positiveLinearForm_apply_root]
      linarith [mul_pos hc ha_pos]
    exact lt_asymm hb_pos this
  refine (D.commutator_le a b hab).trans (iSup₂_le fun k ⟨p, q, hp, hq, hpk⟩ ↦ ?_)
  have hk_pos : 0 < P.root' k D.positiveVector := by
    rw [← D.positiveLinearForm_apply_root, hpk, map_add, map_nsmul, map_nsmul,
      D.positiveLinearForm_apply_root, D.positiveLinearForm_apply_root, nsmul_eq_mul, nsmul_eq_mul]
    exact add_pos (mul_pos (Nat.cast_pos.mpr hp) ha_pos) (mul_pos (Nat.cast_pos.mpr hq) hb_pos)
  have hk_li : LinearIndependent R ![P.root a, P.root k] := by
    refine LinearIndependent.pair_iff.mpr fun c₁ c₂ hc ↦ ?_
    have hrel : (c₁ + c₂ * (p : R)) • P.root a + (c₂ * (q : R)) • P.root b = 0 := by
      rw [hpk, ← Nat.cast_smul_eq_nsmul R, ← Nat.cast_smul_eq_nsmul R] at hc
      rw [← hc]
      module
    obtain ⟨h1, h2⟩ := LinearIndependent.pair_iff.mp hli _ _ hrel
    have hq0 : (q : R) ≠ 0 := Nat.cast_ne_zero.mpr hq.ne'
    have hc₂ : c₂ = 0 := (mul_eq_zero.mp h2).resolve_right hq0
    exact ⟨by simpa [hc₂] using h1, hc₂⟩
  exact le_iSup₂ (f := fun b (_ : 0 < P.root' b D.positiveVector ∧
    LinearIndependent R ![P.root a, P.root b]) ↦ D.U b) k ⟨hk_pos, hk_li⟩

omit [Finite ι] [P.IsCrystallographic] in
private theorem U_le_normalizer_positiveComplement {a : ι} (ha : a ∈ D.simpleRoots) :
    D.U a ≤ Subgroup.normalizer (positiveComplement D a : Set G) := by
  have hconj : ∀ {u : G}, u ∈ D.U a → positiveComplement D a ≤
      (positiveComplement D a).comap (MulAut.conj u) := by
    intro u hu
    refine iSup₂_le fun b ⟨hb_pos, hli⟩ v hv ↦ ?_
    have hcomm : ⁅u, v⁆ ∈ positiveComplement D a :=
      D.commutator_U_le_positiveComplement ha hb_pos hli (Subgroup.commutator_mem_commutator hu hv)
    have hv_mem : v ∈ positiveComplement D a :=
      le_iSup₂ (f := fun b (_ : 0 < P.root' b D.positiveVector ∧
        LinearIndependent R ![P.root a, P.root b]) ↦ D.U b) b ⟨hb_pos, hli⟩ hv
    change u * v * u⁻¹ ∈ positiveComplement D a
    have : u * v * u⁻¹ = ⁅u, v⁆ * v := by simp [commutatorElement_def]
    rw [this]
    exact mul_mem hcomm hv_mem
  intro u hu
  exact Subgroup.mem_normalizer_iff.mpr fun v ↦
    ⟨fun hv ↦ hconj hu hv,
      fun hv ↦ by simpa [MulAut.conj_apply, mul_assoc] using hconj (inv_mem hu) hv⟩

private theorem reflectionCoset_subset_normalizer_positiveComplement {a : ι}
    (ha : a ∈ D.simpleRoots) :
    D.reflectionCoset a ⊆ Subgroup.normalizer (positiveComplement D a : Set G) := by
  have hconj : ∀ {m : G}, m ∈ D.reflectionCoset a → positiveComplement D a ≤
      (positiveComplement D a).comap (MulAut.conj m) := by
    intro m hm
    refine iSup₂_le fun b ⟨hb_pos, hli⟩ v hv ↦ ?_
    have hb'_pos : 0 < P.root' (P.reflectionPerm a b) D.positiveVector :=
      P.apply_root_reflectionPerm_pos_of_mem_baseOf D.positiveLinearForm
        D.positiveLinearForm_root_ne_zero ha hb_pos hli
    have hb'_li : LinearIndependent R ![P.root a, P.root (P.reflectionPerm a b)] :=
      (P.linearIndependent_root_reflectionPerm_iff a b).mpr hli
    have hmv : m * v * m⁻¹ ∈ D.U (P.reflectionPerm a b) := by
      rw [← D.reflection_conjugates a m hm b, ← ConjAct.toConjAct_smul]
      exact Subgroup.smul_mem_pointwise_smul _ _ _ hv
    exact le_iSup₂ (f := fun b (_ : 0 < P.root' b D.positiveVector ∧
      LinearIndependent R ![P.root a, P.root b]) ↦ D.U b) (P.reflectionPerm a b)
      ⟨hb'_pos, hb'_li⟩ hmv
  intro m hm
  exact Subgroup.mem_normalizer_iff.mpr fun v ↦
    ⟨fun hv ↦ hconj hm hv,
      fun hv ↦ by
        simpa [MulAut.conj_apply, mul_assoc] using hconj (D.inv_mem_reflectionCoset hm) hv⟩

private theorem inv_mul_mul_mem_U_weylNormalizer (n : D.weylNormalizer) {j : ι} {g : G}
    (hg : g ∈ D.U j) :
    (n : G)⁻¹ * g * (n : G) ∈ D.U (P.weylGroupToPerm (D.weylNormalizerHom n)⁻¹ j) := by
  have hEq := D.conj_smul_U_weylNormalizer n⁻¹ j
  rw [map_inv, Subgroup.coe_inv] at hEq
  have hmem : ConjAct.toConjAct (n : G)⁻¹ • g ∈ ConjAct.toConjAct (n : G)⁻¹ • D.U j :=
    Subgroup.smul_mem_pointwise_smul _ _ _ hg
  rw [hEq] at hmem
  simpa [ConjAct.smul_def] using hmem

private theorem mul_U_mul_weylNormalizer_mem_doubleCoset_union {a : ι} (ha : a ∈ D.simpleRoots)
    {m u : G} (hm : m ∈ D.reflectionCoset a) (hu : u ∈ D.U a) (n : D.weylNormalizer) :
    m * u * (n : G) ∈
      DoubleCoset.doubleCoset (m * (n : G)) D.borelSubgroup D.borelSubgroup ∪
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup := by
  set k := P.weylGroupToPerm (D.weylNormalizerHom n)⁻¹ a
  rcases (D.positiveVector_regular k).lt_or_gt with hk_neg | hk_pos
  · rcases eq_or_ne u 1 with rfl | hu_ne
    · exact .inl (DoubleCoset.mem_doubleCoset.mpr ⟨1, one_mem _, 1, one_mem _, by simp⟩)
    · have hmu : m * u * m⁻¹ ∈ (D.U (P.reflectionPerm a a) : Set G) \ {1} := by
        refine ⟨D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hm hu, fun h ↦ hu_ne ?_⟩
        have : u = m⁻¹ * (m * u * m⁻¹) * m := by group
        rw [this, h, mul_one, inv_mul_cancel]
      obtain ⟨_, ⟨x, hx, m₁, hm₁, rfl⟩, y, hy, hxy⟩ := D.bruhat a hmu
      have hleft : x * (m₁ * m) ∈ D.borelSubgroup :=
        mul_mem (D.U_le_borelSubgroup_of_pos ha.1 hx)
          (D.T_le_borelSubgroup
            (by simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hm) hm₁))
      have hk'_pos : 0 < P.root' (P.reflectionPerm k k) D.positiveVector := by
        simpa using neg_pos.mpr hk_neg
      have hneg_perm : P.weylGroupToPerm (D.weylNormalizerHom n)⁻¹ (P.reflectionPerm a a) =
          P.reflectionPerm k k := by
        let _ := P.indexNeg
        simpa [k, ← indexNeg_neg] using P.weylGroupToPerm_neg (D.weylNormalizerHom n)⁻¹ a
      have hright : (n : G)⁻¹ * (m⁻¹ * y * m) * (n : G) ∈ D.borelSubgroup := by
        refine D.U_le_borelSubgroup_of_pos hk'_pos
          (hneg_perm ▸ D.inv_mul_mul_mem_U_weylNormalizer n ?_)
        simpa using D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset
          (D.inv_mem_reflectionCoset hm) hy
      refine .inr (DoubleCoset.mem_doubleCoset.mpr ⟨x * (m₁ * m), hleft,
        (n : G)⁻¹ * (m⁻¹ * y * m) * (n : G), hright, ?_⟩)
      calc m * u * (n : G)
          = (m * u * m⁻¹) * m * (n : G) := by group
        _ = (x * m₁ * y) * m * (n : G) := by rw [← hxy]
        _ = (x * (m₁ * m)) * (n : G) * ((n : G)⁻¹ * (m⁻¹ * y * m) * (n : G)) := by group
  · refine .inl (DoubleCoset.mem_doubleCoset.mpr ⟨1, one_mem _, (n : G)⁻¹ * u * (n : G),
      D.U_le_borelSubgroup_of_pos hk_pos (D.inv_mul_mul_mem_U_weylNormalizer n hu), ?_⟩)
    group

/-- **Rank-one Bruhat cell multiplication** for a simple root `a ∈ D.simpleRoots` and
`m ∈ D.reflectionCoset a` (Bruhat–Tits I, Proposition 6.1.11 (i)). -/
theorem doubleCoset_mul_doubleCoset_subset_of_mem_simpleRoots {a : ι} (ha : a ∈ D.simpleRoots)
    {m : G} (hm : m ∈ D.reflectionCoset a) (n : D.weylNormalizer) :
    DoubleCoset.doubleCoset m D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup ⊆
      DoubleCoset.doubleCoset (m * (n : G)) D.borelSubgroup D.borelSubgroup ∪
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup := by
  have hpos_coe : (D.positiveSubgroup : Set G) = (positiveComplement D a : Set G) * D.U a := by
    rw [D.positiveSubgroup_eq_sup_positiveComplement ha,
      Subgroup.coe_mul_of_left_le_normalizer_right _ _ (D.U_le_normalizer_positiveComplement ha),
      Subgroup.set_mul_normalizer_comm _ _ (D.U_le_normalizer_positiveComplement ha)]
  rintro _ ⟨_, h1, _, h2, rfl⟩
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp h1
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp h2
  have hb₂₃ : b₂ * b₃ ∈ (D.borelSubgroup : Set G) := mul_mem hb₂ hb₃
  rw [D.coe_borelSubgroup, hpos_coe] at hb₂₃
  obtain ⟨t, ht, _, ⟨v, hv, u, hu, rfl⟩, hprod⟩ := hb₂₃
  have hmt : m * t * m⁻¹ ∈ D.borelSubgroup := D.T_le_borelSubgroup (D.mul_mul_inv_mem_T hm ht)
  have hmv : m * v * m⁻¹ ∈ D.borelSubgroup :=
    D.positiveSubgroup_le_borelSubgroup (D.positiveComplement_le_positiveSubgroup a
      ((Subgroup.mem_normalizer_iff.mp
        (D.reflectionCoset_subset_normalizer_positiveComplement ha hm) v).mp hv))
  have hb₁' : b₁ * (m * t * m⁻¹) * (m * v * m⁻¹) ∈ D.borelSubgroup :=
    mul_mem (mul_mem hb₁ hmt) hmv
  have hrew : (b₁ * m * b₂) * (b₃ * (n : G) * b₄) =
      (b₁ * (m * t * m⁻¹) * (m * v * m⁻¹)) * (m * u * (n : G)) * b₄ := by
    calc (b₁ * m * b₂) * (b₃ * (n : G) * b₄)
        = b₁ * m * (b₂ * b₃) * (n : G) * b₄ := by group
      _ = b₁ * m * (t * (v * u)) * (n : G) * b₄ := by rw [← hprod]
      _ = (b₁ * (m * t * m⁻¹) * (m * v * m⁻¹)) * (m * u * (n : G)) * b₄ := by group
  change (b₁ * m * b₂) * (b₃ * (n : G) * b₄) ∈ _
  rw [hrew]
  rcases D.mul_U_mul_weylNormalizer_mem_doubleCoset_union ha hm hu n with hmn | hn'
  · obtain ⟨c₁, hc₁, c₂, hc₂, hmun⟩ := DoubleCoset.mem_doubleCoset.mp hmn
    exact .inl (DoubleCoset.mem_doubleCoset.mpr
      ⟨_, mul_mem hb₁' hc₁, _, mul_mem hc₂ hb₄, by rw [hmun]; group⟩)
  · obtain ⟨c₁, hc₁, c₂, hc₂, hmun⟩ := DoubleCoset.mem_doubleCoset.mp hn'
    exact .inr (DoubleCoset.mem_doubleCoset.mpr
      ⟨_, mul_mem hb₁' hc₁, _, mul_mem hc₂ hb₄, by rw [hmun]; group⟩)

private theorem closure_titsWeylGroupEquiv_symm_simpleRoots :
    Subgroup.closure (D.titsWeylGroupEquiv.symm '' (weylGroup.ofIdx P '' D.simpleRoots)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hmem : D.titsWeylGroupEquiv x ∈
      Subgroup.closure (weylGroup.ofIdx P '' D.simpleRoots) := by
    rw [D.simpleRoots_def, P.closure_ofIdx_image_baseOf_eq_top D.positiveLinearForm
      D.positiveLinearForm_root_ne_zero]
    exact Subgroup.mem_top _
  rw [(D.titsWeylGroupEquiv.symm_apply_apply x).symm]
  refine Subgroup.closure_induction ?_ (by simp) ?_ ?_ hmem
  · rintro _ hw
    exact Subgroup.subset_closure (Set.mem_image_of_mem _ hw)
  · intro u v _ _ hu hv
    rw [map_mul]
    exact mul_mem hu hv
  · intro u _ hu
    rw [map_inv]
    exact inv_mem hu

/-- A generating root datum `(T, (U a, M a))` in `G` defines a Tits system `(B, N, S)` in `G` with
`B = D.borelSubgroup`, `N = D.weylNormalizer`, and simple reflections corresponding via
`D.titsWeylGroupEquiv` to `D.simpleRoots` (Bruhat–Tits I, Proposition 6.1.11). -/
noncomputable def titsSystem (hgen : D.IsGenerating) : TauCeti.TitsSystem G where
  subgroupB := D.borelSubgroup
  subgroupN := D.weylNormalizer
  closure_subgroupB_union_subgroupN :=
    D.closure_borelSubgroup_union_weylNormalizer.trans
      (D.isGenerating_iff_generatedSubgroup_eq_top.mp hgen)
  intersection_normal := D.instNormalBorelSubgroupOfWeylNormalizer
  simple := D.titsWeylGroupEquiv.symm '' (weylGroup.ofIdx P '' D.simpleRoots)
  closure_simple := D.closure_titsWeylGroupEquiv_symm_simpleRoots
  exists_simpleRep_mul_self_mem := by
    rintro _ ⟨_, ⟨a, _, rfl⟩, rfl⟩
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a
    let r : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer a hm⟩
    refine ⟨r, D.titsWeylGroupEquiv.injective ?_, ?_⟩
    · simp [D.weylNormalizerHom_of_mem_reflectionCoset (n := r) hm]
    · exact D.T_le_borelSubgroup
        (by simpa [r] using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hm) hm)
  mul_doubleCoset_subset := by
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a
    let r : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer a hm⟩
    refine ⟨r, D.titsWeylGroupEquiv.injective (by
      simp [D.weylNormalizerHom_of_mem_reflectionCoset (n := r) hm]), fun w ↦ ?_⟩
    exact D.doubleCoset_mul_doubleCoset_subset_of_mem_simpleRoots ha hm w
  exists_conj_not_mem := by
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a
    let r : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer a hm⟩
    obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot a)
    have hu_ne : u ≠ 1 := Subtype.coe_ne_coe.mpr hne
    refine ⟨r, D.titsWeylGroupEquiv.injective (by
      simp [D.weylNormalizerHom_of_mem_reflectionCoset (n := r) hm]),
      ⟨u, D.U_le_borelSubgroup_of_pos ha.1 hu⟩, ?_⟩
    have hmu : m * u * m⁻¹ ∈ D.U (P.reflectionPerm a a) :=
      D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hm hu
    have hmu_ne : m * u * m⁻¹ ≠ 1 := by
      intro h
      have : u = m⁻¹ * (m * u * m⁻¹) * m := by group
      rw [this, h, mul_one, inv_mul_cancel] at hu_ne
      exact hu_ne rfl
    have hneg : P.root' (P.reflectionPerm a a) D.positiveVector < 0 := by
      simpa using neg_lt_zero.mpr ha.1
    exact D.notMem_borelSubgroup_of_mem_U_of_neg hneg hmu hmu_ne

@[simp]
theorem titsSystem_subgroupB (hgen : D.IsGenerating) :
    (D.titsSystem hgen).subgroupB = D.borelSubgroup :=
  (rfl)

@[simp]
theorem titsSystem_subgroupN (hgen : D.IsGenerating) :
    (D.titsSystem hgen).subgroupN = D.weylNormalizer :=
  (rfl)

end Crystallographic

/-! ### Rank-zero checks -/

section RankZero

variable [IsEmpty ι]

@[simp]
theorem borelSubgroup_eq_T_of_isEmpty : D.borelSubgroup = D.T := by
  rw [D.borelSubgroup_def]
  exact sup_eq_left.mpr (D.positiveSubgroup_le_iff.mpr isEmptyElim)

@[simp]
theorem generatedSubgroup_eq_T_of_isEmpty : D.generatedSubgroup = D.T := by
  rw [D.generatedSubgroup_def]
  exact sup_eq_left.mpr (iSup_le isEmptyElim)

@[simp]
theorem simpleRoots_eq_empty_of_isEmpty : D.simpleRoots = ∅ :=
  Set.eq_empty_of_isEmpty _

end RankZero

