/-!
# The Weyl group isomorphism and Tits system of a root datum

Let `D` be a root datum of type `P` in a group `G`, where `P` is a finite crystallographic
(possibly non-reduced, possibly non-spanning) root pairing over a linearly ordered field `R`.
Write `T = D.T`, `B = D.borelSubgroup` (`T ⊔ U⁺`), and `N = D.weylNormalizer`.

Building on `TauCeti.GroupTheory.BruhatTits.Borel`, this file constructs the Tits system `(B, N)`
on `G` when `D` is generating (Bruhat–Tits I, 6.1.12) and the canonical Weyl group isomorphism
`RootDatum.weylGroupEquiv : N / T ≃* W(P)` characterized by `n • U a = U (ν(n) a)` for all
`n ∈ N` and all roots `a` (Bruhat–Tits I, 6.1.11(ii)), without requiring `D` to be generating.

The argument proceeds as follows:

1. **Simple generators of `N`:** `N` is generated by `T` together with the reflection cosets of
   the simple roots of `D.indivisibleBase` (`weylNormalizer_eq_closure_simple`).
2. **Double-coset multiplication laws:** using the decompositions `B = T * U_a * U⁺_a` and (DR4),
   we establish `(B n B)(B r B) = B (n r) B` when `ν(n)(a) > 0` (`mul_doubleCoset_eq_of_pos`),
   and `(B n B)(B r B) ⊆ B (n r) B ∪ B n B` in general (`mul_doubleCoset_subset_right`). Taking
   inverses yields the left multiplication axiom (`mul_doubleCoset_subset_left`).
3. **The Tits system `(B, N)`:** `(B, N)` forms a Tits system on the subgroup `B ⊔ N` (which
   always equals `T ⊔ ⨆ i, U i`), and therefore on all of `G` precisely when `D.IsGenerating`
   (`titsSystem`).
4. **Kernel of `weylHom` and `weylGroupEquiv`:** in the Tits system on `B ⊔ N`, any
   `n ∈ ker D.weylHom` satisfies `ν(n)(a) = a > 0` for every simple root `a`, so right
   multiplication by every simple Bruhat cell strictly increases word length in `N / T`. A
   reduced word forces the class of `n` to be trivial, hence `n ∈ B ∩ N = T` (`ker_weylHom`).
   The first isomorphism theorem yields `weylGroupEquiv : N / T ≃* W(P)`.

## Main definitions

* `TauCeti.BruhatTits.RootDatum.titsSystem`: the Tits system `(B, N)` on `G` when `D.IsGenerating`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv`: the canonical isomorphism
  `D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup`.
* `TauCeti.BruhatTits.RootDatum.titsSystemWeylGroupEquiv`: identification of
  `(D.titsSystem hgen).WeylGroup` with `P.weylGroup`.

## Main results

* `TauCeti.BruhatTits.RootDatum.weylNormalizer_eq_closure_simple`: `N` is generated by `T` and the
  simple reflection cosets.
* `TauCeti.BruhatTits.RootDatum.borelSubgroup_sup_weylNormalizer_eq_top_iff`: `B ⊔ N = ⊤` if and
  only if `D.IsGenerating`.
* `TauCeti.BruhatTits.RootDatum.ker_weylHom`: `ker D.weylHom = T` inside `N`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_conj`: `n • U a = U (weylGroupEquiv [n] a)`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_unique`: `weylGroupEquiv` is the unique
  homomorphism satisfying the conjugation equation.
* `TauCeti.BruhatTits.RootDatum.mem_titsSystem_simple_iff_apply`: the simple generators of
  `D.titsSystem hgen` correspond under `titsSystemWeylGroupEquiv` to the simple reflections of
  `D.indivisibleBase`.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  6.1.11, pp. 114–115, and 6.1.12, p. 115.
-/

public section

open scoped Pointwise

namespace TauCeti.BruhatTits.RootDatum

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {G : Type*} [Group G] {D : RootDatum P G}

/-! ### Relationship between `B ⊔ N` and `T ⊔ ⨆ i, U i` -/

/-- Every reflection coset lies in the subgroup generated by `T` and the root subgroups. -/
theorem weylNormalizer_le_generated :
    D.weylNormalizer ≤ D.T ⊔ ⨆ i, D.U i := by
  refine weylNormalizer_le_iff.mpr ⟨le_sup_left, fun i m hm ↦ ?_⟩
  obtain ⟨⟨u, hu⟩, hne⟩ :=
    Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot (P.reflectionPerm i i))
  have hne' : u ≠ 1 := fun h ↦ hne (Subtype.ext h)
  obtain ⟨_, ⟨x, hx, m₁, hm₁, rfl⟩, y, hy, hxy⟩ := D.bruhat i ⟨hu, hne'⟩
  have hUi : D.U i ≤ D.T ⊔ ⨆ j, D.U j := le_sup_of_le_right (le_iSup D.U i)
  have hUneg : D.U (P.reflectionPerm i i) ≤ D.T ⊔ ⨆ j, D.U j :=
    le_sup_of_le_right (le_iSup D.U (P.reflectionPerm i i))
  have hm₁_mem : m₁ ∈ D.T ⊔ ⨆ j, D.U j := by
    have : m₁ = x⁻¹ * u * y⁻¹ := by rw [← hxy]; group
    rw [this]
    exact mul_mem (mul_mem (inv_mem (hUi hx)) (hUneg hu)) (inv_mem (hUi hy))
  have ht : m * m₁⁻¹ ∈ D.T := D.mul_inv_mem_T hm₁ hm
  have : m = (m * m₁⁻¹) * m₁ := by group
  rw [this]
  have hT : D.T ≤ D.T ⊔ ⨆ j, D.U j := le_sup_left
  exact mul_mem (hT ht) hm₁_mem

variable [IsStrictOrderedRing R]

/-- The subgroup `B ⊔ N` always coincides with `T ⊔ ⨆ i, U i`. -/
theorem borelSubgroup_sup_weylNormalizer_eq :
    D.borelSubgroup ⊔ D.weylNormalizer = D.T ⊔ ⨆ i, D.U i := by
  refine le_antisymm ?_ ?_
  · refine sup_le (D.borelSubgroup_le_iff.mpr ⟨le_sup_left, ?_⟩) D.weylNormalizer_le_generated
    exact positiveSubgroup_le_iff.mpr fun i _ ↦ le_sup_of_le_right (le_iSup D.U i)
  · refine sup_le (le_sup_of_le_left D.T_le_borelSubgroup) (iSup_le fun i ↦ ?_)
    rcases (D.positiveVector_regular i).lt_or_gt with hneg | hpos
    · obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
      have hpos_neg : 0 < P.root' (P.reflectionPerm i i) D.positiveVector := by
        have : P.root' (P.reflectionPerm i i) D.positiveVector = -P.root' i D.positiveVector := by
          simp
        linarith
      intro u hu
      have hconj : m⁻¹ * u * m ∈ D.U (P.reflectionPerm i i) := by
        simpa using D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset (D.inv_mem_reflectionCoset hm) hu
      have : u = m * (m⁻¹ * u * m) * m⁻¹ := by group
      rw [this]
      have hB_le : D.borelSubgroup ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_left
      have hN_le : D.weylNormalizer ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_right
      have hm_mem : m ∈ D.borelSubgroup ⊔ D.weylNormalizer :=
        hN_le (D.reflectionCoset_subset_weylNormalizer i hm)
      exact mul_mem (mul_mem hm_mem
        (hB_le (D.positiveSubgroup_le_borelSubgroup
          (D.U_le_positiveSubgroup hpos_neg hconj))))
        (inv_mem hm_mem)
    · exact le_sup_of_le_left
        (D.positiveSubgroup_le_borelSubgroup.trans' (D.U_le_positiveSubgroup hpos))

/-- `B` and `N` generate `G` if and only if `D` is generating. -/
theorem borelSubgroup_sup_weylNormalizer_eq_top_iff :
    D.borelSubgroup ⊔ D.weylNormalizer = ⊤ ↔ D.IsGenerating := by
  rw [D.borelSubgroup_sup_weylNormalizer_eq, isGenerating_iff]

/-- When `D` is generating, `B` and `N` generate `G`. -/
theorem borelSubgroup_sup_weylNormalizer_eq_top (hgen : D.IsGenerating) :
    D.borelSubgroup ⊔ D.weylNormalizer = ⊤ :=
  D.borelSubgroup_sup_weylNormalizer_eq_top_iff.mpr hgen

/-! ### Generation of `N` by simple reflection cosets and double-coset laws -/

section Crystallographic

variable [Finite ι] [P.IsCrystallographic]

/-- `N` is generated by `T` together with the reflection cosets of the simple indivisible roots. -/
theorem weylNormalizer_eq_closure_simple :
    D.weylNormalizer =
      Subgroup.closure ((D.T : Set G) ∪
        ⋃ a ∈ D.indivisibleBase.support, D.reflectionCoset a.1) := by
  refine le_antisymm ?_ ?_
  · rw [weylNormalizer_le_iff]
    refine ⟨fun _ ht ↦ Subgroup.subset_closure (Or.inl ht), fun i ↦ ?_⟩
    have hindiv : ∀ a : {k : ι // P.IsIndivisible k},
        D.reflectionCoset a.1 ⊆
          Subgroup.closure ((D.T : Set G) ∪
            ⋃ s ∈ D.indivisibleBase.support, D.reflectionCoset s.1) := by
      intro a
      refine D.indivisibleBase.induction_reflect a
        (p := fun a ↦ D.reflectionCoset a.1 ⊆
          Subgroup.closure ((D.T : Set G) ∪
            ⋃ s ∈ D.indivisibleBase.support, D.reflectionCoset s.1))
        ?_ ?_ ?_
      · intro j hj
        rw [P.coe_indivisible_reflectionPerm, D.reflectionCoset_reflectionPerm_self]
        exact hj
      · intro j hj m hm
        exact Subgroup.subset_closure (Or.inr (Set.mem_biUnion hj hm))
      · intro j k hj hk m hm
        obtain ⟨m₀, hm₀⟩ := D.reflectionCoset_nonempty k.1
        have hm₀_mem : m₀ ∈ Subgroup.closure ((D.T : Set G) ∪
            ⋃ s ∈ D.indivisibleBase.support, D.reflectionCoset s.1) :=
          Subgroup.subset_closure (Or.inr (Set.mem_biUnion hk hm₀))
        have hconj : m₀⁻¹ * m * m₀ ∈ D.reflectionCoset j.1 := by
          have := D.mul_mul_inv_mem_reflectionCoset_of_mem_reflectionCoset
            (D.inv_mem_reflectionCoset hm₀) hm
          simpa [RootPairing.coe_indivisible_reflectionPerm] using this
        have : m = m₀ * (m₀⁻¹ * m * m₀) * m₀⁻¹ := by group
        rw [this]
        exact mul_mem (mul_mem hm₀_mem (hj hconj)) (inv_mem hm₀_mem)
    rcases P.isIndivisible_or_exists_root_eq_two_smul i with hi | ⟨k, hk, hik⟩
    · exact hindiv ⟨i, hi⟩
    · rw [D.reflectionCoset_eq_of_root_eq_two_smul hik]
      exact hindiv ⟨k, hk⟩
  · rw [Subgroup.closure_le]
    rintro x (ht | hx)
    · exact D.T_le_weylNormalizer ht
    · obtain ⟨a, _, hm⟩ := Set.mem_iUnion₂.mp hx
      exact D.reflectionCoset_subset_weylNormalizer a.1 hm

/-- **Length-increasing right multiplication:** if `n ∈ N` sends a simple indivisible root `a` to
a positive root and `r ∈ M_a`, then `(B n B)(B r B) = B (n r) B`. -/
theorem mul_doubleCoset_eq_of_pos {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {r : G} (hr : r ∈ D.reflectionCoset a.1)
    (n : D.weylNormalizer)
    (hpos : 0 < P.root' (P.weylGroupToPerm (D.weylHom n) a.1) D.positiveVector) :
    DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset r D.borelSubgroup D.borelSubgroup =
      DoubleCoset.doubleCoset ((n : G) * r) D.borelSubgroup D.borelSubgroup := by
  refine le_antisymm ?_
    (DoubleCoset.doubleCoset_mul_subset_mul_doubleCoset (M := G)
      D.borelSubgroup D.borelSubgroup D.borelSubgroup D.borelSubgroup.one_mem (n : G) r)
  rintro _ ⟨_, hx, _, hy, rfl⟩
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
  obtain ⟨t, ht, u, hu, hbu⟩ := D.mem_borelSubgroup_iff.mp (mul_mem hb₂ hb₃)
  obtain ⟨u_a, hu_a, v, hv, rfl⟩ := D.exists_mem_U_mul_mem_posComplement ha hu
  have hnt : (n : G) * t * (n : G)⁻¹ ∈ D.T :=
    (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) t).mp ht
  have hnua : (n : G) * u_a * (n : G)⁻¹ ∈ D.positiveSubgroup :=
    D.U_le_positiveSubgroup hpos (D.mul_mul_inv_mem_U_of_mem_weylNormalizer n hu_a)
  have hrv : r⁻¹ * v * r ∈ D.posComplement a := by
    have hrn := Subgroup.conjAct_pointwise_smul_iff.mp
      (D.conj_smul_posComplement_of_mem_reflectionCoset ha (D.inv_mem_reflectionCoset hr))
    simpa using (Subgroup.mem_normalizer_iff.mp hrn v).mp hv
  refine DoubleCoset.mem_doubleCoset.mpr
    ⟨b₁ * ((n : G) * t * (n : G)⁻¹) * ((n : G) * u_a * (n : G)⁻¹),
      mul_mem (mul_mem hb₁ (D.T_le_borelSubgroup hnt))
        (D.positiveSubgroup_le_borelSubgroup hnua),
      (r⁻¹ * v * r) * b₄,
      mul_mem
        (D.positiveSubgroup_le_borelSubgroup (D.posComplement_le_positiveSubgroup a hrv)) hb₄,
      ?_⟩
  have hmid : b₂ * b₃ = t * (u_a * v) := hbu
  calc b₁ * (n : G) * b₂ * (b₃ * r * b₄)
      = b₁ * (n : G) * (b₂ * b₃) * r * b₄ := by group
    _ = b₁ * (n : G) * (t * (u_a * v)) * r * b₄ := by rw [hmid]
    _ = b₁ * ((n : G) * t * (n : G)⁻¹) * ((n : G) * u_a * (n : G)⁻¹) * ((n : G) * r) *
          ((r⁻¹ * v * r) * b₄) := by group

/-- Helper for the nontrivial negative-root case of `mul_doubleCoset_subset_right`: when
`ν(n)(a) < 0` and `x = n u_a n⁻¹ ≠ 1`, applying (DR4) to `x ∈ U_{ν(n)(a)} \ {1}` rewrites
`b₁ n (t u_a v) r b₄` inside `B n B`. -/
private theorem mem_doubleCoset_of_neg_ne_one {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {r : G} (hr : r ∈ D.reflectionCoset a.1)
    (n : D.weylNormalizer)
    (hneg : P.root' (P.weylGroupToPerm (D.weylHom n) a.1) D.positiveVector < 0)
    {b₁ b₂ b₃ b₄ t u_a v : G} (hb₁ : b₁ ∈ D.borelSubgroup)
    (hb₄ : b₄ ∈ D.borelSubgroup)
    (ht : t ∈ D.T) (hu_a : u_a ∈ D.U a.1) (hrv : r⁻¹ * v * r ∈ D.posComplement a)
    (hbu : b₂ * b₃ = t * (u_a * v)) (hx1 : (n : G) * u_a * (n : G)⁻¹ ≠ 1) :
    b₁ * (n : G) * b₂ * (b₃ * r * b₄) ∈
      DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup := by
  set wa := P.weylGroupToPerm (D.weylHom n) a.1
  set x := (n : G) * u_a * (n : G)⁻¹
  set c := P.reflectionPerm wa wa
  have hnt : (n : G) * t * (n : G)⁻¹ ∈ D.T :=
    (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) t).mp ht
  have hc_pos : 0 < P.root' c D.positiveVector := by
    have : P.root' c D.positiveVector = -P.root' wa D.positiveVector := by simp [c]
    linarith
  have hcc : P.reflectionPerm c c = wa := P.reflectionPerm_reflectionPerm_self wa
  have hx_mem : x ∈ (D.U (P.reflectionPerm c c) : Set G) \ {1} :=
    ⟨by rw [hcc]; exact D.mul_mul_inv_mem_U_of_mem_weylNormalizer n hu_a, hx1⟩
  obtain ⟨_, ⟨y₁, hy₁, mc, hmc, rfl⟩, y₂, hy₂, hxy⟩ := D.bruhat c hx_mem
  have hmc_wa : mc ∈ D.reflectionCoset wa := by
    rwa [D.reflectionCoset_reflectionPerm_self wa] at hmc
  have hmc_conj : mc ∈ ConjAct.toConjAct (n : G) • D.reflectionCoset a.1 := by
    rwa [D.conj_smul_reflectionCoset n a.1]
  obtain ⟨m, hm, hmc_eq⟩ := Set.mem_smul_set.mp hmc_conj
  have hmc_eq' : (n : G) * m * (n : G)⁻¹ = mc := by
    simpa [ConjAct.toConjAct_smul] using hmc_eq
  have hmr : m * r ∈ D.T := by
    simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hr) hm
  have hnmr : (n : G) * (m * r) * (n : G)⁻¹ ∈ D.T :=
    (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) (m * r)).mp hmr
  have hy₂_neg : (n : G)⁻¹ * y₂ * (n : G) ∈ D.U (P.reflectionPerm a.1 a.1) := by
    have hperm : P.weylGroupToPerm (D.weylHom n⁻¹) c = P.reflectionPerm a.1 a.1 := by
      let := P.indexNeg
      -- Express `reflectionPerm x x` via the `Neg` instance `P.indexNeg` for `weylGroupToPerm_neg`.
      change P.weylGroupToPerm (D.weylHom n⁻¹) (-wa) = -a.1
      rw [P.weylGroupToPerm_neg, map_inv]
      simp [wa]
    have h := D.mul_mul_inv_mem_U_of_mem_weylNormalizer n⁻¹ hy₂
    rw [Subgroup.coe_inv, inv_inv, hperm] at h
    exact h
  have hrz : r⁻¹ * ((n : G)⁻¹ * y₂ * (n : G)) * r ∈ D.U a.1 := by
    simpa using D.mul_mul_inv_mem_U_of_mem_reflectionCoset (D.inv_mem_reflectionCoset hr) hy₂_neg
  have ha_pos : 0 < P.root' a.1 D.positiveVector := D.root'_pos_of_mem_indivisibleBase_support ha
  refine DoubleCoset.mem_doubleCoset.mpr
    ⟨b₁ * ((n : G) * t * (n : G)⁻¹) * y₁ * ((n : G) * (m * r) * (n : G)⁻¹),
      mul_mem (mul_mem (mul_mem hb₁ (D.T_le_borelSubgroup hnt))
        (D.positiveSubgroup_le_borelSubgroup (D.U_le_positiveSubgroup hc_pos hy₁)))
        (D.T_le_borelSubgroup hnmr),
      (r⁻¹ * ((n : G)⁻¹ * y₂ * (n : G)) * r) * (r⁻¹ * v * r) * b₄,
      mul_mem (mul_mem
        (D.positiveSubgroup_le_borelSubgroup (D.U_le_positiveSubgroup ha_pos hrz))
        (D.positiveSubgroup_le_borelSubgroup (D.posComplement_le_positiveSubgroup a hrv))) hb₄,
      ?_⟩
  have hxu : (n : G) * u_a = (y₁ * mc * y₂) * (n : G) := by
    have : x = y₁ * mc * y₂ := hxy.symm
    calc (n : G) * u_a = x * (n : G) := by simp [x]
      _ = (y₁ * mc * y₂) * (n : G) := by rw [this]
  calc b₁ * (n : G) * b₂ * (b₃ * r * b₄)
      = b₁ * (n : G) * (b₂ * b₃) * r * b₄ := by group
    _ = b₁ * (n : G) * (t * (u_a * v)) * r * b₄ := by rw [hbu]
    _ = b₁ * ((n : G) * t * (n : G)⁻¹) * ((n : G) * u_a) * v * r * b₄ := by group
    _ = b₁ * ((n : G) * t * (n : G)⁻¹) * ((y₁ * mc * y₂) * (n : G)) *
          v * r * b₄ := by rw [hxu]
    _ = b₁ * ((n : G) * t * (n : G)⁻¹) * y₁ * ((n : G) * m * (n : G)⁻¹) * y₂ *
          (n : G) * v * r * b₄ := by rw [hmc_eq']; group
    _ = b₁ * ((n : G) * t * (n : G)⁻¹) * y₁ * ((n : G) * (m * r) * (n : G)⁻¹) *
          (n : G) * ((r⁻¹ * ((n : G)⁻¹ * y₂ * (n : G)) * r) * (r⁻¹ * v * r) * b₄) := by
      group

/-- **Right rank-one multiplication law:** `(B n B)(B r B) ⊆ B (n r) B ∪ B n B` for `n ∈ N`
and `r ∈ M_a` (`a` simple indivisible). -/
theorem mul_doubleCoset_subset_right {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {r : G} (hr : r ∈ D.reflectionCoset a.1)
    (n : D.weylNormalizer) :
    DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset r D.borelSubgroup D.borelSubgroup ⊆
      DoubleCoset.doubleCoset ((n : G) * r) D.borelSubgroup D.borelSubgroup ∪
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup := by
  set wa := P.weylGroupToPerm (D.weylHom n) a.1
  rcases (D.positiveVector_regular wa).lt_or_gt with hneg | hpos
  · rintro _ ⟨_, hx, _, hy, rfl⟩
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
    obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
    obtain ⟨t, ht, u, hu, hbu⟩ := D.mem_borelSubgroup_iff.mp (mul_mem hb₂ hb₃)
    obtain ⟨u_a, hu_a, v, hv, rfl⟩ := D.exists_mem_U_mul_mem_posComplement ha hu
    have hnt : (n : G) * t * (n : G)⁻¹ ∈ D.T :=
      (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) t).mp ht
    have hrv : r⁻¹ * v * r ∈ D.posComplement a := by
      have hrn := Subgroup.conjAct_pointwise_smul_iff.mp
        (D.conj_smul_posComplement_of_mem_reflectionCoset ha (D.inv_mem_reflectionCoset hr))
      simpa using (Subgroup.mem_normalizer_iff.mp hrn v).mp hv
    by_cases hx1 : (n : G) * u_a * (n : G)⁻¹ = 1
    · left
      have hua1 : u_a = 1 := by
        have h : u_a = (n : G)⁻¹ * ((n : G) * u_a * (n : G)⁻¹) * (n : G) := by group
        rw [h, hx1]
        group
      refine DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * ((n : G) * t * (n : G)⁻¹),
          mul_mem hb₁ (D.T_le_borelSubgroup hnt),
          (r⁻¹ * v * r) * b₄,
          mul_mem (D.positiveSubgroup_le_borelSubgroup
            (D.posComplement_le_positiveSubgroup a hrv)) hb₄, ?_⟩
      have hmid : b₂ * b₃ = t * v := by simpa [hua1] using hbu
      calc b₁ * (n : G) * b₂ * (b₃ * r * b₄)
          = b₁ * (n : G) * (b₂ * b₃) * r * b₄ := by group
        _ = b₁ * (n : G) * (t * v) * r * b₄ := by rw [hmid]
        _ = b₁ * ((n : G) * t * (n : G)⁻¹) * ((n : G) * r) *
              ((r⁻¹ * v * r) * b₄) := by group
    · exact Or.inr (D.mem_doubleCoset_of_neg_ne_one ha hr n hneg hb₁ hb₄ ht hu_a hrv hbu hx1)
  · exact (D.mul_doubleCoset_eq_of_pos ha hr n hpos).subset.trans Set.subset_union_left

/-- **Left rank-one multiplication law:** `(B r B)(B n B) ⊆ B (r n) B ∪ B n B` for `r ∈ M_a`
(`a` simple indivisible) and `n ∈ N`. -/
theorem mul_doubleCoset_subset_left {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {r : G} (hr : r ∈ D.reflectionCoset a.1)
    (n : D.weylNormalizer) :
    DoubleCoset.doubleCoset r D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup ⊆
      DoubleCoset.doubleCoset (r * (n : G)) D.borelSubgroup D.borelSubgroup ∪
        DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup := by
  intro g hg
  obtain ⟨x, hx, y, hy, rfl⟩ := hg
  have hinv : (x * y)⁻¹ ∈
      DoubleCoset.doubleCoset ((n⁻¹ : D.weylNormalizer) : G) D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset r⁻¹ D.borelSubgroup D.borelSubgroup := by
    rw [mul_inv_rev]
    refine Set.mul_mem_mul ?_ ?_
    · exact (DoubleCoset.inv_mem_doubleCoset_inv_iff (Γ₁ := D.borelSubgroup)
        (Γ₂ := D.borelSubgroup)).mpr hy
    · exact (DoubleCoset.inv_mem_doubleCoset_inv_iff (Γ₁ := D.borelSubgroup)
        (Γ₂ := D.borelSubgroup)).mpr hx
  have hsub := D.mul_doubleCoset_subset_right ha (D.inv_mem_reflectionCoset hr) n⁻¹ hinv
  rcases hsub with h | h
  · left
    rw [Subgroup.coe_inv, ← mul_inv_rev r (n : G)] at h
    exact (DoubleCoset.inv_mem_doubleCoset_inv_iff (Γ₁ := D.borelSubgroup)
      (Γ₂ := D.borelSubgroup)).mp h
  · right
    rw [Subgroup.coe_inv] at h
    exact (DoubleCoset.inv_mem_doubleCoset_inv_iff (Γ₁ := D.borelSubgroup)
      (Γ₂ := D.borelSubgroup)).mp h

/-- No simple reflection conjugates `B` into `B`. -/
theorem exists_conj_not_mem_borelSubgroup {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {r : G} (hr : r ∈ D.reflectionCoset a.1) :
    ∃ b : D.borelSubgroup, r * (b : G) * r⁻¹ ∉ D.borelSubgroup := by
  obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot a.1)
  have hne' : u ≠ 1 := fun h ↦ hne (Subtype.ext h)
  have ha_pos : 0 < P.root' a.1 D.positiveVector := D.root'_pos_of_mem_indivisibleBase_support ha
  have huB : u ∈ D.borelSubgroup :=
    D.positiveSubgroup_le_borelSubgroup (D.U_le_positiveSubgroup ha_pos hu)
  refine ⟨⟨u, huB⟩, fun hmem ↦ hne' ?_⟩
  have hneg_lt : P.root' (P.reflectionPerm a.1 a.1) D.positiveVector < 0 := by
    have : P.root' (P.reflectionPerm a.1 a.1) D.positiveVector = -P.root' a.1 D.positiveVector := by
      simp
    linarith
  have hneg : r * u * r⁻¹ ∈ D.negativeSubgroup :=
    D.U_le_negativeSubgroup hneg_lt (D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hr hu)
  have hbot : r * u * r⁻¹ ∈ D.borelSubgroup ⊓ D.negativeSubgroup := ⟨hmem, hneg⟩
  rw [D.borelSubgroup_inf_negativeSubgroup, Subgroup.mem_bot] at hbot
  have hu_eq : u = r⁻¹ * (r * u * r⁻¹) * r := by group
  rw [hu_eq, hbot]
  group

/-! ### The Tits system `(B, N)` -/

private theorem closure_simple_of_hom {Q : Type*} [Group Q]
    (f : D.weylNormalizer →* Q) (hf_surj : Function.Surjective f)
    (hf_T : ∀ {t : G} (ht : t ∈ D.T), f ⟨t, D.T_le_weylNormalizer ht⟩ = 1) :
    Subgroup.closure {s : Q | ∃ a ∈ D.indivisibleBase.support, ∃ m : D.weylNormalizer,
      (m : G) ∈ D.reflectionCoset a.1 ∧ f m = s} = ⊤ := by
  rw [eq_top_iff]
  intro q _
  obtain ⟨⟨g, hgN⟩, rfl⟩ := hf_surj q
  have hgcl : g ∈ Subgroup.closure ((D.T : Set G) ∪
      ⋃ a ∈ D.indivisibleBase.support, D.reflectionCoset a.1) := by
    rwa [← D.weylNormalizer_eq_closure_simple]
  have hmem : ∀ x ∈ Subgroup.closure ((D.T : Set G) ∪
      ⋃ a ∈ D.indivisibleBase.support, D.reflectionCoset a.1),
      ∀ hxN : x ∈ D.weylNormalizer,
        f ⟨x, hxN⟩ ∈ Subgroup.closure {s : Q | ∃ a ∈ D.indivisibleBase.support,
          ∃ m : D.weylNormalizer, (m : G) ∈ D.reflectionCoset a.1 ∧ f m = s} := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      intro hyN
      rcases hy with ht | hy
      · rw [hf_T ht]
        exact one_mem _
      · obtain ⟨a, ha, hm⟩ := Set.mem_iUnion₂.mp hy
        exact Subgroup.subset_closure ⟨a, ha, ⟨y, hyN⟩, hm, rfl⟩
    | one =>
      intro h1
      have h1eq : (⟨1, h1⟩ : D.weylNormalizer) = 1 := rfl
      rw [h1eq, map_one]
      exact one_mem _
    | mul y z hy hz ihy ihz =>
      intro hyzN
      have hyN : y ∈ D.weylNormalizer := by rwa [D.weylNormalizer_eq_closure_simple]
      have hzN : z ∈ D.weylNormalizer := by rwa [D.weylNormalizer_eq_closure_simple]
      have hmul : (⟨y * z, hyzN⟩ : D.weylNormalizer) = ⟨y, hyN⟩ * ⟨z, hzN⟩ := rfl
      rw [hmul, map_mul]
      exact mul_mem (ihy hyN) (ihz hzN)
    | inv y hy ihy =>
      intro hyiN
      have hyN : y ∈ D.weylNormalizer := by rwa [D.weylNormalizer_eq_closure_simple]
      have hinv :
          (⟨y⁻¹, hyiN⟩ : D.weylNormalizer) = (⟨y, hyN⟩ : D.weylNormalizer)⁻¹ := rfl
      rw [hinv, map_inv]
      exact inv_mem (ihy hyN)
  exact hmem g hgcl hgN

/-- Auxiliary Tits system on the subgroup `H = B ⊔ N` (requiring no generation assumption). -/
private noncomputable def titsSystemAux :
    TauCeti.TitsSystem ↥(D.borelSubgroup ⊔ D.weylNormalizer) :=
  let H := D.borelSubgroup ⊔ D.weylNormalizer
  have hB_le : D.borelSubgroup ≤ H := le_sup_left
  have hN_le : D.weylNormalizer ≤ H := le_sup_right
  let B_H : Subgroup H := D.borelSubgroup.subgroupOf H
  let N_H : Subgroup H := D.weylNormalizer.subgroupOf H
  have hnorm : (B_H.subgroupOf N_H).Normal := by
    have heq : B_H.subgroupOf N_H = (D.T.subgroupOf H).subgroupOf N_H := by
      ext ⟨⟨g, hgH⟩, hgN⟩
      simp only [Subgroup.mem_subgroupOf, B_H]
      exact ⟨fun hgB ↦ by
        have : g ∈ D.borelSubgroup ⊓ D.weylNormalizer := ⟨hgB, hgN⟩
        rwa [D.borelSubgroup_inf_weylNormalizer] at this,
        fun hgT ↦ D.T_le_borelSubgroup hgT⟩
    rw [heq]
    constructor
    rintro ⟨⟨t, _⟩, _⟩ ht ⟨⟨n, _⟩, hnN⟩
    exact (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer hnN) t).mp ht
  let embN : D.weylNormalizer →* N_H :=
    { toFun := fun n ↦ ⟨⟨n.1, hN_le n.2⟩, n.2⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }
  { subgroupB := B_H
    subgroupN := N_H
    closure_subgroupB_union_subgroupN := by
      rw [eq_top_iff]
      have hmap : H ≤ Subgroup.map H.subtype
          (Subgroup.closure ((B_H : Set H) ∪ (N_H : Set H))) := by
        refine sup_le (fun b hb ↦ ⟨⟨b, hB_le hb⟩,
          Subgroup.subset_closure (Or.inl hb), rfl⟩)
          (fun n hn ↦ ⟨⟨n, hN_le hn⟩,
            Subgroup.subset_closure (Or.inr hn), rfl⟩)
      rintro ⟨g, hg⟩ -
      obtain ⟨y, hy, hyval⟩ := hmap hg
      have : y = ⟨g, hg⟩ := Subtype.ext hyval
      rwa [← this]
    intersection_normal := hnorm
    simple :=
      letI := hnorm
      {s | ∃ a ∈ D.indivisibleBase.support, ∃ m : N_H,
        (m.1 : G) ∈ D.reflectionCoset a.1 ∧ QuotientGroup.mk m = s}
    closure_simple := by
      let := hnorm
      let f : D.weylNormalizer →* N_H ⧸ B_H.subgroupOf N_H :=
        (QuotientGroup.mk' (B_H.subgroupOf N_H)).comp embN
      have hset : {s : N_H ⧸ B_H.subgroupOf N_H | ∃ a ∈ D.indivisibleBase.support,
          ∃ m : D.weylNormalizer, (m : G) ∈ D.reflectionCoset a.1 ∧ f m = s} =
          {s : N_H ⧸ B_H.subgroupOf N_H | ∃ a ∈ D.indivisibleBase.support, ∃ m : N_H,
            (m.1 : G) ∈ D.reflectionCoset a.1 ∧ QuotientGroup.mk m = s} := by
        ext s
        constructor
        · rintro ⟨a, ha, m, hm, rfl⟩
          exact ⟨a, ha, embN m, hm, rfl⟩
        · rintro ⟨a, ha, ⟨⟨g, hgH⟩, hgN⟩, hm, rfl⟩
          exact ⟨a, ha, ⟨g, hgN⟩, hm, rfl⟩
      rw [← hset]
      refine D.closure_simple_of_hom f ?_ fun ht ↦ (QuotientGroup.eq_one_iff _).mpr
        (D.T_le_borelSubgroup ht)
      intro q
      obtain ⟨⟨⟨g, _⟩, hgN⟩, rfl⟩ := QuotientGroup.mk_surjective q
      exact ⟨⟨g, hgN⟩, rfl⟩
    exists_simpleRep_mul_self_mem := by
      rintro s ⟨a, _, m, hm, rfl⟩
      refine ⟨m, rfl, ?_⟩
      simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, B_H]
      have hsq : (m.1 : G) * (m.1 : G) ∈ D.T := by
        simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hm) hm
      exact D.T_le_borelSubgroup hsq
    mul_doubleCoset_subset := by
      rintro s ⟨a, ha, m, hm, rfl⟩
      refine ⟨m, rfl, fun w ↦ ?_⟩
      rintro z ⟨x, hx, y, hy, rfl⟩
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
      obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
      have hG : ((b₁ * m.1 * b₂ * (b₃ * w.1 * b₄) : H) : G) ∈
          DoubleCoset.doubleCoset (m.1 : G) D.borelSubgroup D.borelSubgroup *
            DoubleCoset.doubleCoset (w.1 : G) D.borelSubgroup D.borelSubgroup :=
        Set.mul_mem_mul
          (DoubleCoset.mem_doubleCoset.mpr ⟨b₁.1, hb₁, b₂.1, hb₂, rfl⟩)
          (DoubleCoset.mem_doubleCoset.mpr ⟨b₃.1, hb₃, b₄.1, hb₄, rfl⟩)
      have hsub := D.mul_doubleCoset_subset_left ha hm ⟨w.1.1, w.2⟩ hG
      rcases hsub with h | h
      · left
        obtain ⟨c₁, hc₁, c₂, hc₂, heq⟩ := DoubleCoset.mem_doubleCoset.mp h
        exact DoubleCoset.mem_doubleCoset.mpr
          ⟨⟨c₁, hB_le hc₁⟩, hc₁, ⟨c₂, hB_le hc₂⟩, hc₂, Subtype.ext heq⟩
      · right
        obtain ⟨c₁, hc₁, c₂, hc₂, heq⟩ := DoubleCoset.mem_doubleCoset.mp h
        exact DoubleCoset.mem_doubleCoset.mpr
          ⟨⟨c₁, hB_le hc₁⟩, hc₁, ⟨c₂, hB_le hc₂⟩, hc₂, Subtype.ext heq⟩
    exists_conj_not_mem := by
      rintro s ⟨a, ha, m, hm, rfl⟩
      obtain ⟨b, hb⟩ := D.exists_conj_not_mem_borelSubgroup ha hm
      exact ⟨m, rfl, ⟨⟨b.1, hB_le b.2⟩, b.2⟩, hb⟩ }

variable (D) in
/-- **Bruhat–Tits I, 6.1.12:** For a generating root datum of finite crystallographic type, the
pair `(B, N)` with simple reflections from `D.indivisibleBase` is a Tits system on `G`. -/
noncomputable def titsSystem (hgen : D.IsGenerating) : TauCeti.TitsSystem G :=
  have hnorm : (D.borelSubgroup.subgroupOf D.weylNormalizer).Normal := by
    rw [D.borelSubgroup_subgroupOf_weylNormalizer]
    exact D.T_normal_weylNormalizer
  { subgroupB := D.borelSubgroup
    subgroupN := D.weylNormalizer
    closure_subgroupB_union_subgroupN := by
      rw [← Subgroup.sup_eq_closure]
      exact D.borelSubgroup_sup_weylNormalizer_eq_top hgen
    intersection_normal := hnorm
    simple :=
      letI := hnorm
      {s | ∃ a ∈ D.indivisibleBase.support, ∃ m : D.weylNormalizer,
        (m : G) ∈ D.reflectionCoset a.1 ∧ QuotientGroup.mk m = s}
    closure_simple := by
      let := hnorm
      exact D.closure_simple_of_hom (QuotientGroup.mk' _) QuotientGroup.mk_surjective
        fun ht ↦ (QuotientGroup.eq_one_iff _).mpr (D.T_le_borelSubgroup ht)
    exists_simpleRep_mul_self_mem := by
      rintro s ⟨a, _, m, hm, rfl⟩
      refine ⟨m, rfl, ?_⟩
      simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul]
      have hsq : (m : G) * (m : G) ∈ D.T := by
        simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hm) hm
      exact D.T_le_borelSubgroup hsq
    mul_doubleCoset_subset := by
      rintro s ⟨a, ha, m, hm, rfl⟩
      exact ⟨m, rfl, fun w ↦ D.mul_doubleCoset_subset_left ha hm w⟩
    exists_conj_not_mem := by
      rintro s ⟨a, ha, m, hm, rfl⟩
      exact ⟨m, rfl, D.exists_conj_not_mem_borelSubgroup ha hm⟩ }

@[simp]
theorem titsSystem_subgroupB (hgen : D.IsGenerating) :
    (D.titsSystem hgen).subgroupB = D.borelSubgroup :=
  (rfl)

@[simp]
theorem titsSystem_subgroupN (hgen : D.IsGenerating) :
    (D.titsSystem hgen).subgroupN = D.weylNormalizer :=
  (rfl)

/-- The simple generators of `D.titsSystem hgen` are the cosets of elements in `M_a` for simple
indivisible roots `a`. -/
theorem mem_titsSystem_simple_iff (hgen : D.IsGenerating) {s : (D.titsSystem hgen).WeylGroup} :
    s ∈ (D.titsSystem hgen).simple ↔
      ∃ a ∈ D.indivisibleBase.support, ∃ m : (D.titsSystem hgen).subgroupN,
        (m : G) ∈ D.reflectionCoset a.1 ∧ QuotientGroup.mk m = s :=
  Iff.rfl

/-! ### Kernel of `weylHom` and the Weyl group isomorphism -/

/-- For `n ∈ ker D.weylHom`, right multiplication of the Bruhat cell of `n` in `titsSystemAux` by
any simple Bruhat cell is exact: `C(n) * C(s) = C(n * s)`. -/
private theorem titsSystemAux_bruhatCell_mul_eq_of_weylHom_eq_one
    {n : D.weylNormalizer} (hn : D.weylHom n = 1)
    {s : D.titsSystemAux.WeylGroup} (hs : s ∈ D.titsSystemAux.simple) :
    have hN_le : D.weylNormalizer ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_right
    let nH : D.titsSystemAux.subgroupN := ⟨⟨n.1, hN_le n.2⟩, n.2⟩
    D.titsSystemAux.bruhatCell (QuotientGroup.mk nH) * D.titsSystemAux.bruhatCell s =
      D.titsSystemAux.bruhatCell (QuotientGroup.mk nH * s) := by
  have hB_le : D.borelSubgroup ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_left
  have hN_le : D.weylNormalizer ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_right
  let TS := D.titsSystemAux
  let nH : TS.subgroupN := ⟨⟨n.1, hN_le n.2⟩, n.2⟩
  obtain ⟨a, ha, m, hm, rfl⟩ := hs
  let mH : TS.subgroupN := m
  -- Identify `m` with `mH : TS.subgroupN` and combine `mk nH * mk mH` via `QuotientGroup.mk_mul`.
  change TS.bruhatCell (QuotientGroup.mk nH) * TS.bruhatCell (QuotientGroup.mk mH) =
    TS.bruhatCell (QuotientGroup.mk (nH * mH))
  rw [TS.bruhatCell_mk, TS.bruhatCell_mk, TS.bruhatCell_mk]
  refine le_antisymm ?_
    (DoubleCoset.doubleCoset_mul_subset_mul_doubleCoset _ _ _
      TS.subgroupB.one_mem (nH : ↥(D.borelSubgroup ⊔ D.weylNormalizer))
      (mH : ↥(D.borelSubgroup ⊔ D.weylNormalizer)))
  rintro z ⟨x, hx, y, hy, rfl⟩
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
  have hpos : 0 < P.root' (P.weylGroupToPerm (D.weylHom n) a.1) D.positiveVector := by
    rw [hn, map_one, Equiv.Perm.one_apply]
    exact D.root'_pos_of_mem_indivisibleBase_support ha
  have hG : ((b₁ * nH.1 * b₂ * (b₃ * mH.1 * b₄) :
        ↥(D.borelSubgroup ⊔ D.weylNormalizer)) : G) ∈
      DoubleCoset.doubleCoset (n : G) D.borelSubgroup D.borelSubgroup *
        DoubleCoset.doubleCoset (mH.1 : G) D.borelSubgroup D.borelSubgroup :=
    Set.mul_mem_mul
      (DoubleCoset.mem_doubleCoset.mpr ⟨b₁.1, hb₁, b₂.1, hb₂, rfl⟩)
      (DoubleCoset.mem_doubleCoset.mpr ⟨b₃.1, hb₃, b₄.1, hb₄, rfl⟩)
  rw [D.mul_doubleCoset_eq_of_pos ha hm n hpos] at hG
  obtain ⟨c₁, hc₁, c₂, hc₂, heq⟩ := DoubleCoset.mem_doubleCoset.mp hG
  exact DoubleCoset.mem_doubleCoset.mpr
    ⟨⟨c₁, hB_le hc₁⟩, hc₁, ⟨c₂, hB_le hc₂⟩, hc₂, Subtype.ext heq⟩

/-- **Bruhat–Tits I, 6.1.11(ii) (kernel):** the kernel of `D.weylHom : N →* W(P)` is `T`. -/
theorem ker_weylHom : D.weylHom.ker = D.T.subgroupOf D.weylNormalizer := by
  refine le_antisymm ?_ (fun n hn ↦ by simpa using D.weylHom_of_mem_T hn)
  intro n hn
  have hN_le : D.weylNormalizer ≤ D.borelSubgroup ⊔ D.weylNormalizer := le_sup_right
  let TS := D.titsSystemAux
  let nH : TS.subgroupN := ⟨⟨n.1, hN_le n.2⟩, n.2⟩
  let wbar : TS.WeylGroup := QuotientGroup.mk nH
  have hlt : ∀ s ∈ TS.simple,
      TS.simpleGenerators.wordLength wbar < TS.simpleGenerators.wordLength (wbar * s) :=
    fun s hs ↦ (TS.bruhatCell_mul_eq_iff_wordLength_lt_right wbar hs).mp
      (D.titsSystemAux_bruhatCell_mul_eq_of_weylHom_eq_one hn hs)
  have hw1 : wbar = 1 := by
    by_contra hne
    obtain ⟨l, hl_mem, hl_len, hl_prod⟩ := TS.exists_prod_eq_of_wordLength wbar
    rcases List.eq_nil_or_concat l with rfl | ⟨l', s, rfl⟩
    · exact hne (by simpa using hl_prod.symm)
    · rw [List.concat_eq_append, List.prod_append, List.prod_singleton] at hl_prod
      have hs : s ∈ TS.simple := hl_mem s (by simp)
      have hl' : ∀ t ∈ l', t ∈ TS.simple := fun t ht ↦ hl_mem t (by simp [ht])
      have hws : wbar * s = l'.prod := by
        rw [← hl_prod, mul_assoc, TS.simple_mul_simple_self hs, mul_one]
      have hle : TS.simpleGenerators.wordLength (wbar * s) ≤ l'.length := by
        rw [hws]
        exact TS.wordLength_prod_le hl'
      have hlen : l'.length + 1 = TS.simpleGenerators.wordLength wbar := by
        simpa [List.concat_eq_append] using hl_len
      have := hlt s hs
      omega
  have hmemB : (n : G) ∈ D.borelSubgroup := (QuotientGroup.eq_one_iff nH).mp hw1
  have hmemT : (n : G) ∈ D.borelSubgroup ⊓ D.weylNormalizer := ⟨hmemB, n.2⟩
  rwa [D.borelSubgroup_inf_weylNormalizer] at hmemT

variable (D) in
/-- **Bruhat–Tits I, 6.1.11(ii):** The canonical group isomorphism `N / T ≃* W(P)` for a root
datum of finite crystallographic type, characterized by conjugation on root subgroups
(`RootDatum.weylGroupEquiv_conj`). -/
noncomputable def weylGroupEquiv :
    D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq D.ker_weylHom.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective D.weylHom D.weylHom_surjective)

@[simp]
theorem weylGroupEquiv_mk (n : D.weylNormalizer) :
    D.weylGroupEquiv (QuotientGroup.mk n) = D.weylHom n :=
  (rfl)

/-- `weylGroupEquiv` intertwines conjugation in `N` with the Weyl-group action on root subgroups:
`n U_i n⁻¹ = U_{ν(n) i}`. -/
theorem weylGroupEquiv_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i =
      D.U (P.weylGroupToPerm (D.weylGroupEquiv (QuotientGroup.mk n)) i) := by
  rw [weylGroupEquiv_mk]
  exact D.weylHom_conj n i

/-- `weylGroupEquiv` intertwines conjugation in `N` with the Weyl-group action on reflection
cosets: `n M_i n⁻¹ = M_{ν(n) i}`. -/
theorem weylGroupEquiv_conj_reflectionCoset (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.reflectionCoset i =
      D.reflectionCoset (P.weylGroupToPerm (D.weylGroupEquiv (QuotientGroup.mk n)) i) := by
  rw [weylGroupEquiv_mk]
  exact D.conj_smul_reflectionCoset n i

/-- An element of `M_i` maps under `weylGroupEquiv` to the reflection `s_i ∈ W(P)`. -/
theorem weylGroupEquiv_mk_of_mem_reflectionCoset {i : ι} {m : G}
    (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) =
      RootPairing.weylGroup.ofIdx P i := by
  rw [weylGroupEquiv_mk]
  exact D.weylHom_of_mem_reflectionCoset hm

/-- An element of `T` maps under `weylGroupEquiv` to `1 ∈ W(P)`. -/
theorem weylGroupEquiv_mk_of_mem_T {t : G} (ht : t ∈ D.T) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨t, D.T_le_weylNormalizer ht⟩) = 1 := by
  rw [weylGroupEquiv_mk]
  exact D.weylHom_of_mem_T ht

/-- An element of a reflection coset has nontrivial image under `weylGroupEquiv`. -/
theorem weylGroupEquiv_mk_ne_one_of_mem_reflectionCoset {i : ι} {m : G}
    (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) ≠
      1 := by
  rw [D.weylGroupEquiv_mk_of_mem_reflectionCoset hm]
  exact RootPairing.weylGroup.ofIdx_ne_one P i

/-- Uniqueness of `weylGroupEquiv`: any homomorphism `N / T →* W(P)` whose action on roots matches
conjugation on root subgroups equals `D.weylGroupEquiv`. -/
theorem weylGroupEquiv_unique
    (f : D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer →* P.weylGroup)
    (hf : ∀ (n : D.weylNormalizer) (i : ι),
      ConjAct.toConjAct (n : G) • D.U i =
        D.U (P.weylGroupToPerm (f (QuotientGroup.mk n)) i)) :
    ∀ q, f q = D.weylGroupEquiv q := by
  intro q
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
  rw [D.weylGroupEquiv_mk]
  exact (D.weylHom_eq_of_forall_conj (hf n)).symm

variable (D) in
/-- Compatibility of the Tits system Weyl group with `P.weylGroup` when `D` is generating. -/
noncomputable def titsSystemWeylGroupEquiv (hgen : D.IsGenerating) :
    (D.titsSystem hgen).WeylGroup ≃* P.weylGroup :=
  letI : (D.borelSubgroup.subgroupOf D.weylNormalizer).Normal := by
    rw [D.borelSubgroup_subgroupOf_weylNormalizer]
    exact D.T_normal_weylNormalizer
  (QuotientGroup.quotientMulEquivOfEq (G := D.weylNormalizer)
    D.borelSubgroup_subgroupOf_weylNormalizer).trans D.weylGroupEquiv

@[simp]
theorem titsSystemWeylGroupEquiv_mk (hgen : D.IsGenerating)
    (n : (D.titsSystem hgen).subgroupN) :
    D.titsSystemWeylGroupEquiv hgen (QuotientGroup.mk n) =
      D.weylHom ⟨n.1, by simpa using n.2⟩ :=
  (rfl)

/-- Under `titsSystemWeylGroupEquiv`, the simple generators of `D.titsSystem hgen` correspond to the
simple reflections of `D.indivisibleBase`. -/
theorem mem_titsSystem_simple_iff_apply (hgen : D.IsGenerating)
    {s : (D.titsSystem hgen).WeylGroup} :
    s ∈ (D.titsSystem hgen).simple ↔
      ∃ a ∈ D.indivisibleBase.support,
        D.titsSystemWeylGroupEquiv hgen s = RootPairing.weylGroup.ofIdx P a.1 := by
  rw [D.mem_titsSystem_simple_iff]
  constructor
  · rintro ⟨a, ha, m, hm, rfl⟩
    refine ⟨a, ha, ?_⟩
    rw [D.titsSystemWeylGroupEquiv_mk]
    exact D.weylHom_of_mem_reflectionCoset hm
  · rintro ⟨a, ha, hs⟩
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a.1
    let mn : (D.titsSystem hgen).subgroupN :=
      ⟨m, by simpa using D.reflectionCoset_subset_weylNormalizer a.1 hm⟩
    refine ⟨a, ha, mn, hm, ?_⟩
    apply (D.titsSystemWeylGroupEquiv hgen).injective
    rw [hs, D.titsSystemWeylGroupEquiv_mk]
    exact D.weylHom_of_mem_reflectionCoset hm

end Crystallographic

end TauCeti.BruhatTits.RootDatum
