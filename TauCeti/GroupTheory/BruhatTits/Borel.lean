/-!
# Borel subgroup, Weyl homomorphism, and peeling lemma for root data

Let `D` be a root datum of type `P` in a group `G`, where `P` is a finite crystallographic
(possibly non-reduced, possibly non-spanning) root pairing over a linearly ordered field `R`.
Write `T = D.T`, `U⁺ = D.positiveSubgroup`, `U⁻ = D.negativeSubgroup`, `B = D.borelSubgroup`
(`T ⊔ U⁺`), and `N = D.weylNormalizer`.

This file establishes the intermediate structure needed for the Tits system `(B, N)` and the
Weyl group isomorphism `N / T ≃* W(P)`:

1. **Positive complements (`posComplement`):** for any indivisible root `a`, the subgroup `U⁺_a`
   generated by the positive root subgroups whose roots are linearly independent of `a`.
2. **Doubled roots (`reflectionCoset_eq_of_root_eq_two_smul`):** if `2 a` is a root, then
   `M_{2 a} = M_a`.
3. **Base of indivisible roots (`indivisibleBase`):** the unique base of `P.indivisible` whose
   positive roots are those positive on `D.positiveVector`.
4. **Weyl homomorphism (`weylHom : N →* W(P)`):** the unique surjective homomorphism such that
   `n • U j = U (weylHom n j)` for all `n ∈ N` and all roots `j`, together with the induced
   conjugation action on reflection cosets (`conj_smul_reflectionCoset`).
5. **Peeling lemma (`mem_posComplement_of_mem_normalizer`):** for each simple indivisible root
   `a`, `U⁺ = U_a ⊔ U⁺_a`, `U⁺_a` is normalized by `U_a`, `U_{-a}`, and `M_a`, so
   `U⁺ = U_a * U⁺_a`, and any `u ∈ U⁺` normalizing `U_{-a}` already lies in `U⁺_a`.
6. **Intersections (`T_inf_positiveSubgroup_eq_bot`, `borelSubgroup_inf_weylNormalizer`):**
   conjugating along a word for the longest element `w₀` of `P.indivisible` sends any `u ∈ U⁺`
   normalizing every root subgroup into `U⁺ ∩ U⁻ = {1}`, yielding `T ∩ U⁺ = {1}` and
   `B ∩ N = T`.

## Main definitions

* `TauCeti.BruhatTits.RootDatum.posComplement`: the subgroup `U⁺_a` generated by positive root
  subgroups linearly independent of `a`.
* `TauCeti.BruhatTits.RootDatum.indivisibleBase`: the base of `P.indivisible` cut out by
  `D.positiveVector`.
* `TauCeti.BruhatTits.RootDatum.weylHom`: the surjective homomorphism `N →* P.weylGroup`.

## Main results

* `TauCeti.BruhatTits.RootDatum.reflectionCoset_eq_of_root_eq_two_smul`: `M_{2 a} = M_a`.
* `TauCeti.BruhatTits.RootDatum.weylHom_conj`: `n • U j = U (weylHom n j)`.
* `TauCeti.BruhatTits.RootDatum.weylHom_surjective`: `D.weylHom` is surjective.
* `TauCeti.BruhatTits.RootDatum.mem_posComplement_of_mem_normalizer`: peeling lemma for `U⁺_a`.
* `TauCeti.BruhatTits.RootDatum.T_inf_positiveSubgroup_eq_bot`: `T ∩ U⁺ = {1}`.
* `TauCeti.BruhatTits.RootDatum.borelSubgroup_inf_weylNormalizer`: `B ∩ N = T`.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  6.1.2, pp. 108–109, and 6.1.11, pp. 114–115.
-/

public section

open scoped Pointwise commutatorElement

namespace TauCeti.BruhatTits.RootDatum

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {G : Type*} [Group G] {D : RootDatum P G}

/-! ### Positive complements -/

variable (D) in
/-- For an indivisible root `a`, the subgroup `U⁺_a` generated by the positive root subgroups
whose roots are linearly independent of `a`. -/
def posComplement (a : {i : ι // P.IsIndivisible i}) : Subgroup G :=
  ⨆ (j : ι) (_ : 0 < P.root' j D.positiveVector ∧ LinearIndependent R ![P.root a.1, P.root j]),
    D.U j

theorem posComplement_def (a : {i : ι // P.IsIndivisible i}) :
    D.posComplement a =
      ⨆ (j : ι)
        (_ : 0 < P.root' j D.positiveVector ∧ LinearIndependent R ![P.root a.1, P.root j]),
        D.U j :=
  (rfl)

theorem posComplement_le_positiveSubgroup (a : {i : ι // P.IsIndivisible i}) :
    D.posComplement a ≤ D.positiveSubgroup :=
  iSup₂_le fun _ hj ↦ D.U_le_positiveSubgroup hj.1

theorem U_le_posComplement {a : {i : ι // P.IsIndivisible i}} {j : ι}
    (hpos : 0 < P.root' j D.positiveVector) (hli : LinearIndependent R ![P.root a.1, P.root j]) :
    D.U j ≤ D.posComplement a :=
  le_iSup₂ (f := fun j (_ : 0 < P.root' j D.positiveVector ∧
    LinearIndependent R ![P.root a.1, P.root j]) ↦ D.U j) j ⟨hpos, hli⟩

theorem posComplement_le_iff {a : {i : ι // P.IsIndivisible i}} {H : Subgroup G} :
    D.posComplement a ≤ H ↔
      ∀ j, 0 < P.root' j D.positiveVector → LinearIndependent R ![P.root a.1, P.root j] →
        D.U j ≤ H := by
  simp [posComplement]

/-! ### Reflection cosets of doubled roots -/

section DoubledRoots

variable [IsStrictOrderedRing R] [Finite ι]

/-- If `2 a` is a root, then `M_{2 a} = M_a`. -/
theorem reflectionCoset_eq_of_root_eq_two_smul {i j : ι}
    (h : P.root j = (2 : R) • P.root i) :
    D.reflectionCoset j = D.reflectionCoset i := by
  have : Module.IsReflexive R N := .of_isPerfPair P.flip.toLinearMap
  have : HasUniqueDiv N := .of_isTorsionFree R N
  refine D.reflectionCoset_eq_of_reflectionPerm_eq
    (P.reflectionPerm_eq_of_root_eq_smul h)
    (D.le_of_root_eq_two_smul i j h)
    (D.le_of_root_eq_two_smul _ _ ?_)
  rw [P.root_reflectionPerm, P.reflection_apply_self, P.root_reflectionPerm,
    P.reflection_apply_self, h, smul_neg]

end DoubledRoots

/-! ### The base of indivisible roots and the Weyl homomorphism -/

private theorem positiveVector_regular_indivisible (i : {i : ι // P.IsIndivisible i}) :
    P.indivisible.root' i D.positiveVector ≠ 0 := by
  rw [P.indivisible_root']
  exact D.positiveVector_regular i.1

private theorem exists_weyl_conj_U (n : D.weylNormalizer) :
    ∃ w : P.weylGroup, ∀ j : ι,
      ConjAct.toConjAct (n : G) • D.U j = D.U (P.weylGroupToPerm w j) := by
  rcases n with ⟨g, hg⟩
  have hgcl : g ∈ Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i) := by
    rwa [← D.weylNormalizer_def]
  -- Replace the subtype coercion `(⟨g, hg⟩ : G)` with `g` so `hg` can be cleared for induction.
  change ∃ w : P.weylGroup,
    ∀ j : ι, ConjAct.toConjAct g • D.U j = D.U (P.weylGroupToPerm w j)
  clear hg
  induction hgcl using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ht | hx
    · refine ⟨1, fun j ↦ ?_⟩
      simpa using D.conj_smul_U_of_mem_T ht
    · obtain ⟨i, hm⟩ := Set.mem_iUnion.mp hx
      refine ⟨RootPairing.weylGroup.ofIdx P i, fun j ↦ ?_⟩
      rw [P.weylGroupToPerm_ofIdx_apply]
      exact D.reflection_conjugates i x hm j
  | one =>
    exact ⟨1, fun j ↦ by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨w₁, hw₁⟩ := hx
    obtain ⟨w₂, hw₂⟩ := hy
    refine ⟨w₁ * w₂, fun j ↦ ?_⟩
    rw [ConjAct.toConjAct_mul, mul_smul, hw₂, hw₁, map_mul, Equiv.Perm.mul_apply]
  | inv x _ hx =>
    obtain ⟨w, hw⟩ := hx
    refine ⟨w⁻¹, fun j ↦ ?_⟩
    rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, hw, ← Equiv.Perm.mul_apply, ← map_mul,
      mul_inv_cancel, map_one, Equiv.Perm.one_apply]

section Crystallographic

variable [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic]

variable (D) in
/-- The unique base of `P.indivisible` whose positive roots are those positive on
`D.positiveVector`. -/
noncomputable def indivisibleBase : P.indivisible.Base :=
  (P.indivisible.existsUnique_base_of_forall_root'_ne_zero (v := D.positiveVector)
    D.positiveVector_regular_indivisible).choose

/-- A root of `P.indivisible` is positive for `D.indivisibleBase` if and only if it is positive on
`D.positiveVector`. -/
theorem indivisibleBase_isPos_iff (i : {i : ι // P.IsIndivisible i}) :
    D.indivisibleBase.IsPos i ↔ 0 < P.root' i.1 D.positiveVector := by
  dsimp only [indivisibleBase]
  have h := (P.indivisible.existsUnique_base_of_forall_root'_ne_zero (v := D.positiveVector)
    D.positiveVector_regular_indivisible).choose_spec.1 i
  rwa [P.indivisible_root'] at h

/-- Every simple root of `D.indivisibleBase` is positive on `D.positiveVector`. -/
theorem root'_pos_of_mem_indivisibleBase_support {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) :
    0 < P.root' a.1 D.positiveVector :=
  (D.indivisibleBase_isPos_iff a).mp (D.indivisibleBase.isPos_of_mem_support ha)

/-- A Weyl-group element mapping every positive root subgroup into `U⁺` is the identity. -/
theorem eq_one_of_forall_pos_U_le_positiveSubgroup {w : P.weylGroup}
    (hw : ∀ i : ι, 0 < P.root' i D.positiveVector →
      D.U (P.weylGroupToPerm w i) ≤ D.positiveSubgroup) : w = 1 := by
  apply P.weylGroupEquivIndivisible.injective
  rw [map_one]
  refine TauCeti.eq_one_of_inversions_eq_empty (P := P.indivisible) (b := D.indivisibleBase) ?_
  rw [Set.eq_empty_iff_forall_notMem]
  intro i hi
  obtain ⟨hpos, hneg⟩ := (TauCeti.mem_inversions P.indivisible D.indivisibleBase _ i).mp hi
  have hi_pos : 0 < P.root' i.1 D.positiveVector := (D.indivisibleBase_isPos_iff i).mp hpos
  rw [D.indivisibleBase_isPos_iff, P.coe_weylGroupToPerm_weylGroupEquivIndivisible] at hneg
  have hwi_neg : P.root' (P.weylGroupToPerm w i.1) D.positiveVector < 0 :=
    lt_of_le_of_ne (le_of_not_gt hneg) (D.positiveVector_regular _)
  have hle : D.U (P.weylGroupToPerm w i.1) ≤ D.positiveSubgroup ⊓ D.negativeSubgroup :=
    le_inf (hw i.1 hi_pos) (D.U_le_negativeSubgroup hwi_neg)
  rw [D.positiveSubgroup_inf_negativeSubgroup, le_bot_iff] at hle
  exact D.U_ne_bot _ hle

/-- A Weyl-group element preserving every root subgroup `D.U j` is the identity. -/
theorem eq_one_of_forall_U_weylGroupToPerm_eq {w : P.weylGroup}
    (hw : ∀ j : ι, D.U (P.weylGroupToPerm w j) = D.U j) : w = 1 :=
  D.eq_one_of_forall_pos_U_le_positiveSubgroup fun i hi ↦ by
    rw [hw i]
    exact D.U_le_positiveSubgroup hi

private theorem eq_of_forall_conj_U_eq {g : G} {w₁ w₂ : P.weylGroup}
    (h₁ : ∀ j : ι, ConjAct.toConjAct g • D.U j = D.U (P.weylGroupToPerm w₁ j))
    (h₂ : ∀ j : ι, ConjAct.toConjAct g • D.U j = D.U (P.weylGroupToPerm w₂ j)) :
    w₁ = w₂ := by
  have h : w₂ * w₁⁻¹ = 1 := by
    refine D.eq_one_of_forall_U_weylGroupToPerm_eq fun k ↦ ?_
    rw [map_mul, Equiv.Perm.mul_apply, ← h₂, h₁, ← Equiv.Perm.mul_apply, ← map_mul,
      mul_inv_cancel, map_one, Equiv.Perm.one_apply]
  exact (mul_inv_eq_one.mp h).symm

variable (D) in
/-- The canonical homomorphism `N →* W(P)` determined by the conjugation action of `N` on the
root subgroups `D.U i`. -/
noncomputable def weylHom : D.weylNormalizer →* P.weylGroup where
  toFun n := (D.exists_weyl_conj_U n).choose
  map_one' := by
    refine D.eq_of_forall_conj_U_eq (D.exists_weyl_conj_U 1).choose_spec fun j ↦ ?_
    simp
  map_mul' n₁ n₂ := by
    refine D.eq_of_forall_conj_U_eq (D.exists_weyl_conj_U (n₁ * n₂)).choose_spec fun j ↦ ?_
    rw [Subgroup.coe_mul, ConjAct.toConjAct_mul, mul_smul,
      (D.exists_weyl_conj_U n₂).choose_spec j, (D.exists_weyl_conj_U n₁).choose_spec _,
      map_mul, Equiv.Perm.mul_apply]

/-- Every element of `N` conjugates `U j` onto `U (weylHom n j)`. -/
theorem weylHom_conj (n : D.weylNormalizer) (j : ι) :
    ConjAct.toConjAct (n : G) • D.U j = D.U (P.weylGroupToPerm (D.weylHom n) j) :=
  (D.exists_weyl_conj_U n).choose_spec j

/-- Uniqueness of `D.weylHom`: any Weyl-group element describing conjugation by `n` equals
`D.weylHom n`. -/
theorem weylHom_eq_of_forall_conj {n : D.weylNormalizer} {w : P.weylGroup}
    (hw : ∀ j : ι, ConjAct.toConjAct (n : G) • D.U j = D.U (P.weylGroupToPerm w j)) :
    D.weylHom n = w :=
  D.eq_of_forall_conj_U_eq (D.weylHom_conj n) hw

@[simp]
theorem weylHom_of_mem_T {t : G} (ht : t ∈ D.T) :
    D.weylHom ⟨t, D.T_le_weylNormalizer ht⟩ = 1 :=
  D.weylHom_eq_of_forall_conj fun _ ↦ by simpa using D.conj_smul_U_of_mem_T ht

theorem weylHom_of_mem_reflectionCoset {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylHom ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩ =
      RootPairing.weylGroup.ofIdx P i :=
  D.weylHom_eq_of_forall_conj fun j ↦ by
    rw [P.weylGroupToPerm_ofIdx_apply]
    exact D.reflection_conjugates i m hm j

/-- The homomorphism `D.weylHom : N →* W(P)` is surjective. -/
theorem weylHom_surjective : Function.Surjective D.weylHom := by
  rintro ⟨w, hw⟩
  induction hw using RootPairing.weylGroup.induction with
  | mem i =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
    exact ⟨⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩,
      D.weylHom_of_mem_reflectionCoset hm⟩
  | one =>
    exact ⟨1, map_one _⟩
  | mul _ _ _ _ hg hh =>
    obtain ⟨n₁, hn₁⟩ := hg
    obtain ⟨n₂, hn₂⟩ := hh
    exact ⟨n₁ * n₂, by rw [map_mul, hn₁, hn₂]; rfl⟩

/-- Every element of `N` conjugates `M i` onto `M (weylHom n i)`. -/
theorem conj_smul_reflectionCoset (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.reflectionCoset i =
      D.reflectionCoset (P.weylGroupToPerm (D.weylHom n) i) := by
  rcases n with ⟨g, hg⟩
  have hgcl : g ∈ Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i) := by
    rwa [← D.weylNormalizer_def]
  revert i
  induction hgcl using Subgroup.closure_induction with
  | mem x hx =>
    intro i
    rcases hx with ht | hx
    · rw [D.weylHom_of_mem_T ht, map_one, Equiv.Perm.one_apply]
      exact D.conj_smul_reflectionCoset_of_mem_T ht
    · obtain ⟨k, hm⟩ := Set.mem_iUnion.mp hx
      rw [D.weylHom_of_mem_reflectionCoset hm, P.weylGroupToPerm_ofIdx_apply]
      exact D.conj_smul_reflectionCoset_of_mem_reflectionCoset hm
  | one =>
    intro i
    simp
  | mul x y hx hy ihx ihy =>
    intro i
    have hxN : x ∈ D.weylNormalizer := by rwa [D.weylNormalizer_def]
    have hyN : y ∈ D.weylNormalizer := by rwa [D.weylNormalizer_def]
    have hmul :
        (⟨x * y, mul_mem hxN hyN⟩ : D.weylNormalizer) = ⟨x, hxN⟩ * ⟨y, hyN⟩ := rfl
    rw [hmul, map_mul, map_mul, Equiv.Perm.mul_apply, Subgroup.coe_mul, ConjAct.toConjAct_mul,
      mul_smul, ihy hyN i, ihx hxN]
  | inv x hx ihx =>
    intro i
    have hxN : x ∈ D.weylNormalizer := by rwa [D.weylNormalizer_def]
    have hinv : (⟨x⁻¹, inv_mem hxN⟩ : D.weylNormalizer) =
        (⟨x, hxN⟩ : D.weylNormalizer)⁻¹ := rfl
    rw [hinv, map_inv, map_inv, Subgroup.coe_inv, ConjAct.toConjAct_inv, inv_smul_eq_iff, ihx hxN]
    simp

theorem mul_mul_inv_mem_U_of_mem_weylNormalizer (n : D.weylNormalizer) {j : ι} {u : G}
    (hu : u ∈ D.U j) :
    (n : G) * u * (n : G)⁻¹ ∈ D.U (P.weylGroupToPerm (D.weylHom n) j) := by
  rw [← D.weylHom_conj n j, ← ConjAct.toConjAct_smul]
  exact Subgroup.smul_mem_pointwise_smul _ _ _ hu

/-! ### Peeling lemma for positive complements -/

/-- For a simple indivisible root `a`, `U⁺` is generated by `U_a` and `U⁺_a`. -/
theorem U_sup_posComplement {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) :
    D.U a.1 ⊔ D.posComplement a = D.positiveSubgroup := by
  have ha_pos : 0 < P.root' a.1 D.positiveVector := D.root'_pos_of_mem_indivisibleBase_support ha
  refine le_antisymm (sup_le (D.U_le_positiveSubgroup ha_pos)
    (D.posComplement_le_positiveSubgroup a)) ?_
  rw [positiveSubgroup_le_iff]
  intro j hj
  by_cases hli : LinearIndependent R ![P.root a.1, P.root j]
  · exact le_sup_of_le_right (D.U_le_posComplement hj hli)
  · rcases P.root_eq_cases_of_not_linearIndependent hli with h | h | h | h | h | h
    · have : j = a.1 := P.root.injective h
      subst this
      exact le_sup_left
    · exfalso
      have : P.root' j D.positiveVector = -P.root' a.1 D.positiveVector := by
        simp [RootPairing.root', h]
      linarith
    · exact le_sup_of_le_left (D.le_of_root_eq_two_smul a.1 j h)
    · exact absurd h (P.isIndivisible_iff.mp a.2 j)
    · exfalso
      have : P.root' j D.positiveVector = (-2 : R) * P.root' a.1 D.positiveVector := by
        simp [RootPairing.root', h]
      linarith
    · exfalso
      have : P.root' a.1 D.positiveVector = (-2 : R) * P.root' j D.positiveVector := by
        simp [RootPairing.root', h]
      linarith

/-- Reflection in a simple indivisible root `a` preserves linear independence from `a` and
positivity on `D.positiveVector`. -/
private theorem reflectionPerm_mem_posComplement_index {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {j : ι}
    (hj_pos : 0 < P.root' j D.positiveVector)
    (hj_li : LinearIndependent R ![P.root a.1, P.root j]) :
    0 < P.root' (P.reflectionPerm a.1 j) D.positiveVector ∧
      LinearIndependent R ![P.root a.1, P.root (P.reflectionPerm a.1 j)] := by
  refine ⟨?_, ?_⟩
  · have hindiv : ∀ k : {i : ι // P.IsIndivisible i},
        0 < P.root' k.1 D.positiveVector → k ≠ a →
        0 < P.root' (P.reflectionPerm a.1 k.1) D.positiveVector := fun k hk hne ↦ by
      have hk_pos : D.indivisibleBase.IsPos k := (D.indivisibleBase_isPos_iff k).mpr hk
      have hr : D.indivisibleBase.IsPos (P.indivisible.reflectionPerm a k) :=
        hk_pos.reflectionPerm ha hne
      simpa only [P.coe_indivisible_reflectionPerm] using (D.indivisibleBase_isPos_iff _).mp hr
    rcases P.isIndivisible_or_exists_root_eq_two_smul j with hj | ⟨k, hk, hjk⟩
    · refine hindiv ⟨j, hj⟩ hj_pos ?_
      intro heq
      have hjeq : j = a.1 := congrArg Subtype.val heq
      rw [hjeq] at hj_li
      have := (LinearIndependent.pair_iff.mp hj_li) 1 (-1) (by simp)
      norm_num at this
    · have hk_pos : 0 < P.root' k D.positiveVector := by
        have : P.root' j D.positiveVector = 2 * P.root' k D.positiveVector := by
          simp [RootPairing.root', hjk]
        linarith
      have hne : (⟨k, hk⟩ : {i : ι // P.IsIndivisible i}) ≠ a := by
        intro heq
        have hkeq : k = a.1 := congrArg Subtype.val heq
        rw [hkeq] at hjk
        have := (LinearIndependent.pair_iff.mp hj_li) (-2) 1 (by simp [hjk])
        norm_num at this
      have hrk := hindiv ⟨k, hk⟩ hk_pos hne
      have hrj : P.root (P.reflectionPerm a.1 j) =
          (2 : R) • P.root (P.reflectionPerm a.1 k) := by
        rw [P.root_reflectionPerm, P.root_reflectionPerm, hjk, map_smul]
      have : P.root' (P.reflectionPerm a.1 j) D.positiveVector =
          2 * P.root' (P.reflectionPerm a.1 k) D.positiveVector := by
        simp [RootPairing.root', hrj]
      linarith
  · rw [LinearIndependent.pair_iff] at hj_li ⊢
    intro c₁ c₂ hsum
    have hmap := congrArg (P.reflection a.1) hsum
    have hinv : P.reflection a.1 (P.root (P.reflectionPerm a.1 j)) = P.root j := by
      rw [← P.root_reflectionPerm, P.reflectionPerm_self]
    rw [map_add, map_smul, map_smul, map_zero, P.reflection_apply_self, smul_neg, ← neg_smul,
      hinv] at hmap
    have := hj_li (-c₁) c₂ hmap
    exact ⟨neg_eq_zero.mp this.1, this.2⟩

/-- Every element of `M_a` normalizes `U⁺_a` for a simple indivisible root `a`. -/
theorem conj_smul_posComplement_of_mem_reflectionCoset {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {m : G} (hm : m ∈ D.reflectionCoset a.1) :
    ConjAct.toConjAct m • D.posComplement a = D.posComplement a := by
  have hconj : ∀ n ∈ D.reflectionCoset a.1, ∀ u ∈ D.posComplement a,
      n * u * n⁻¹ ∈ D.posComplement a := by
    intro n hn
    have hsub : D.posComplement a ≤ (D.posComplement a).comap (MulAut.conj n).toMonoidHom := by
      rw [posComplement_le_iff]
      intro j hj_pos hj_li u hu
      have hr := D.reflectionPerm_mem_posComplement_index ha hj_pos hj_li
      have hmem : n * u * n⁻¹ ∈ D.U (P.reflectionPerm a.1 j) := by
        rw [← D.reflection_conjugates a.1 n hn j, ← ConjAct.toConjAct_smul]
        exact Subgroup.smul_mem_pointwise_smul _ _ _ hu
      exact D.U_le_posComplement hr.1 hr.2 hmem
    exact fun u hu ↦ hsub hu
  refine Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.mem_normalizer_iff.mpr fun u ↦
    ⟨hconj m hm u, fun hu ↦ ?_⟩)
  simpa [mul_assoc] using hconj m⁻¹ (D.inv_mem_reflectionCoset hm) _ hu

/-- For a simple indivisible root `a`, `U_a` normalizes `U⁺_a`. -/
theorem U_le_normalizer_posComplement {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) :
    D.U a.1 ≤ Subgroup.normalizer (D.posComplement a : Set G) := by
  have ha_pos : 0 < P.root' a.1 D.positiveVector := D.root'_pos_of_mem_indivisibleBase_support ha
  have hconj : ∀ u ∈ D.U a.1, ∀ x ∈ D.posComplement a,
      u * x * u⁻¹ ∈ D.posComplement a := by
    intro u hu
    have hsub : D.posComplement a ≤ (D.posComplement a).comap (MulAut.conj u).toMonoidHom := by
      rw [posComplement_le_iff]
      intro j hj_pos hj_li x hx
      have hij : ∀ c : R, 0 < c → P.root j ≠ -(c • P.root a.1) := by
        intro c hc hneg
        have : P.root' j D.positiveVector = -(c * P.root' a.1 D.positiveVector) := by
          simp [RootPairing.root', hneg]
        have : 0 < c * P.root' a.1 D.positiveVector := mul_pos hc ha_pos
        linarith
      have hcomm : ⁅u, x⁆ ∈ D.posComplement a := by
        refine (D.commutator_le a.1 j hij).trans ?_ (Subgroup.commutator_mem_commutator hu hx)
        refine iSup₂_le fun k ⟨p, q, hp, hq, hk⟩ ↦ ?_
        have hk_pos : 0 < P.root' k D.positiveVector := by
          have hval : P.root' k D.positiveVector =
              (p : R) * P.root' a.1 D.positiveVector +
                (q : R) * P.root' j D.positiveVector := by
            simp [RootPairing.root', hk, nsmul_eq_mul]
          have hp' : (0 : R) < p := Nat.cast_pos.mpr hp
          have hq' : (0 : R) < q := Nat.cast_pos.mpr hq
          rw [hval]
          exact add_pos (mul_pos hp' ha_pos) (mul_pos hq' hj_pos)
        have hk_li : LinearIndependent R ![P.root a.1, P.root k] := by
          rw [LinearIndependent.pair_iff] at hj_li ⊢
          intro c₁ c₂ hsum
          have hsum' : (c₁ + c₂ * p) • P.root a.1 + (c₂ * q) • P.root j = 0 := by
            rw [hk, smul_add, ← Nat.cast_smul_eq_nsmul R p,
              ← Nat.cast_smul_eq_nsmul R q, smul_smul, smul_smul] at hsum
            rw [add_smul, add_assoc]
            exact hsum
          obtain ⟨h1, h2⟩ := hj_li (c₁ + c₂ * p) (c₂ * q) hsum'
          have hq0 : (q : R) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hq)
          have hc2 : c₂ = 0 := (mul_eq_zero.mp h2).resolve_right hq0
          exact ⟨by simpa [hc2] using h1, hc2⟩
        exact D.U_le_posComplement hk_pos hk_li
      have heq : u * x * u⁻¹ = ⁅u, x⁆ * x := by
        rw [commutatorElement_def]
        group
      rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, heq]
      exact (D.posComplement a).mul_mem hcomm (D.U_le_posComplement hj_pos hj_li hx)
    exact fun x hx ↦ hsub hx
  intro u hu
  refine Subgroup.mem_normalizer_iff.mpr fun x ↦ ⟨hconj u hu x, fun hx ↦ ?_⟩
  simpa [mul_assoc] using hconj u⁻¹ (inv_mem hu) _ hx

/-- For a simple indivisible root `a`, `U_{-a}` also normalizes `U⁺_a`. -/
theorem U_neg_le_normalizer_posComplement {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) :
    D.U (P.reflectionPerm a.1 a.1) ≤ Subgroup.normalizer (D.posComplement a : Set G) := by
  obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a.1
  intro y hy
  rw [← Subgroup.conjAct_pointwise_smul_iff]
  have hy' : m⁻¹ * y * m ∈ D.U a.1 := by
    have := D.mul_mul_inv_mem_U_of_mem_reflectionCoset (D.inv_mem_reflectionCoset hm) hy
    simpa using this
  have hnorm : ConjAct.toConjAct (m⁻¹ * y * m) • D.posComplement a = D.posComplement a :=
    Subgroup.conjAct_pointwise_smul_eq_self (D.U_le_normalizer_posComplement ha hy')
  have hm_norm := D.conj_smul_posComplement_of_mem_reflectionCoset ha hm
  have hm_inv := D.conj_smul_posComplement_of_mem_reflectionCoset ha (D.inv_mem_reflectionCoset hm)
  calc ConjAct.toConjAct y • D.posComplement a
      = ConjAct.toConjAct m • (ConjAct.toConjAct (m⁻¹ * y * m) •
          (ConjAct.toConjAct m⁻¹ • D.posComplement a)) := by
        rw [← mul_smul, ← mul_smul, ← ConjAct.toConjAct_mul, ← ConjAct.toConjAct_mul]
        congr 2
        group
    _ = D.posComplement a := by rw [hm_inv, hnorm, hm_norm]

/-- Every element of `U⁺` factors as `u_a * v` with `u_a ∈ U_a` and `v ∈ U⁺_a`. -/
theorem exists_mem_U_mul_mem_posComplement {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {u : G} (hu : u ∈ D.positiveSubgroup) :
    ∃ u_a ∈ D.U a.1, ∃ v ∈ D.posComplement a, u = u_a * v := by
  let K : Subgroup G :=
    { carrier := {x : G | ∃ u_a ∈ D.U a.1, ∃ v ∈ D.posComplement a, x = u_a * v}
      one_mem' := ⟨1, one_mem _, 1, one_mem _, by simp⟩
      mul_mem' := by
        rintro _ _ ⟨u₁, hu₁, v₁, hv₁, rfl⟩ ⟨u₂, hu₂, v₂, hv₂, rfl⟩
        have hv₁' : u₂⁻¹ * v₁ * u₂ ∈ D.posComplement a := by
          simpa using (Subgroup.mem_normalizer_iff.mp
            (D.U_le_normalizer_posComplement ha (inv_mem hu₂)) v₁).mp hv₁
        exact ⟨u₁ * u₂, mul_mem hu₁ hu₂,
          (u₂⁻¹ * v₁ * u₂) * v₂, mul_mem hv₁' hv₂, by group⟩
      inv_mem' := by
        rintro _ ⟨u₁, hu₁, v₁, hv₁, rfl⟩
        have hv₁' : u₁ * v₁⁻¹ * u₁⁻¹ ∈ D.posComplement a :=
          (Subgroup.mem_normalizer_iff.mp
            (D.U_le_normalizer_posComplement ha hu₁) v₁⁻¹).mp (inv_mem hv₁)
        exact ⟨u₁⁻¹, inv_mem hu₁, u₁ * v₁⁻¹ * u₁⁻¹, hv₁', by group⟩ }
  have hle : D.positiveSubgroup ≤ K := by
    rw [← D.U_sup_posComplement ha]
    exact sup_le (fun x hx ↦ ⟨x, hx, 1, one_mem _, by simp⟩)
      (fun x hx ↦ ⟨1, one_mem _, x, hx, by simp⟩)
  exact hle hu

/-- **Peeling lemma:** for a simple indivisible root `a`, any element of `U⁺` normalizing `U_{-a}`
already lies in `U⁺_a`. -/
theorem mem_posComplement_of_mem_normalizer {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.indivisibleBase.support) {u : G} (hu : u ∈ D.positiveSubgroup)
    (hnorm : u ∈ Subgroup.normalizer (D.U (P.reflectionPerm a.1 a.1) : Set G)) :
    u ∈ D.posComplement a := by
  obtain ⟨u_a, hu_a, v, hv, rfl⟩ := D.exists_mem_U_mul_mem_posComplement ha hu
  by_cases hua1 : u_a = 1
  · simpa [hua1] using hv
  exfalso
  -- Step 1: assuming `u_a ≠ 1`, decompose `u_a = p * m * q` via (DR4) for `-a`.
  set neg_a := P.reflectionPerm a.1 a.1
  have hneg_neg : P.reflectionPerm neg_a neg_a = a.1 := P.reflectionPerm_reflectionPerm_self a.1
  have ha_pos : 0 < P.root' a.1 D.positiveVector := D.root'_pos_of_mem_indivisibleBase_support ha
  have hneg_lt : P.root' neg_a D.positiveVector < 0 := by
    have : P.root' neg_a D.positiveVector = -P.root' a.1 D.positiveVector := by
      simp [neg_a]
    linarith
  have hua_mem : u_a ∈ (D.U (P.reflectionPerm neg_a neg_a) : Set G) \ {1} :=
    ⟨by rwa [hneg_neg], hua1⟩
  obtain ⟨_, ⟨p, hp, m, hm_neg, rfl⟩, q, hq, hpmq⟩ := D.bruhat neg_a hua_mem
  have hpmq' : p * m * q = u_a := hpmq
  have hm : m ∈ D.reflectionCoset a.1 := by
    rwa [D.reflectionCoset_reflectionPerm_self a.1] at hm_neg
  -- Step 2: since `u_a * v = p * m * q * v` and `p` normalize `U_{-a}`, `q * v` maps `U_{-a}`
  -- to `U_a`.
  have hqv_conj : ConjAct.toConjAct (q * v) • D.U neg_a = D.U a.1 := by
    have hu_eq : ConjAct.toConjAct (u_a * v) • D.U neg_a = D.U neg_a :=
      Subgroup.conjAct_pointwise_smul_eq_self hnorm
    have hp_eq : (ConjAct.toConjAct p)⁻¹ • D.U neg_a = D.U neg_a := by
      rw [← ConjAct.toConjAct_inv]
      exact Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.le_normalizer (inv_mem hp))
    have hm_inv : (ConjAct.toConjAct m)⁻¹ • D.U neg_a = D.U a.1 := by
      rw [← ConjAct.toConjAct_inv]
      exact D.conj_smul_U_neg (D.inv_mem_reflectionCoset hm)
    calc ConjAct.toConjAct (q * v) • D.U neg_a
        = (ConjAct.toConjAct m)⁻¹ • ((ConjAct.toConjAct p)⁻¹ •
            (ConjAct.toConjAct (p * m * q * v) • D.U neg_a)) := by
          rw [← mul_smul, ← mul_smul, ← ConjAct.toConjAct_inv, ← ConjAct.toConjAct_inv,
            ← ConjAct.toConjAct_mul, ← ConjAct.toConjAct_mul]
          congr 2
          group
      _ = (ConjAct.toConjAct m)⁻¹ • ((ConjAct.toConjAct p)⁻¹ • D.U neg_a) := by
          rw [hpmq', hu_eq]
      _ = D.U a.1 := by rw [hp_eq, hm_inv]
  -- Step 3: deduce `U_a ≤ U⁺_a` by writing each `z ∈ U_a` as `x * w` with `x ∈ U_{-a}` and
  -- `w ∈ U⁺_a`, forcing `x ∈ U⁺ ∩ U⁻ = {1}`.
  have hUa_le : D.U a.1 ≤ D.posComplement a := by
    intro z hz
    have hz' : z ∈ ConjAct.toConjAct (q * v) • D.U neg_a := hqv_conj.symm ▸ hz
    have hzv : z = (q * v) * ((q * v)⁻¹ * z * (q * v)) * (q * v)⁻¹ := by group
    set y₀ := (q * v)⁻¹ * z * (q * v)
    have hy₀ : y₀ ∈ D.U neg_a := by
      have h := Subgroup.mem_pointwise_smul_iff_inv_smul_mem.mp hz'
      rw [← ConjAct.toConjAct_inv, ConjAct.toConjAct_smul] at h
      simpa [y₀] using h
    have hw₁ : (y₀⁻¹ * v * y₀) * v⁻¹ ∈ D.posComplement a := by
      refine mul_mem ?_ (inv_mem hv)
      simpa using (Subgroup.mem_normalizer_iff.mp
        (D.U_neg_le_normalizer_posComplement ha (inv_mem hy₀)) v).mp hv
    set x := q * y₀ * q⁻¹
    set w := q * ((y₀⁻¹ * v * y₀) * v⁻¹) * q⁻¹
    have hx_neg : x ∈ D.U neg_a := mul_mem (mul_mem hq hy₀) (inv_mem hq)
    have hw_comp : w ∈ D.posComplement a :=
      (Subgroup.mem_normalizer_iff.mp (D.U_neg_le_normalizer_posComplement ha hq) _).mp hw₁
    have hzxw : z = x * w := by
      rw [hzv]
      simp only [x, w, y₀]
      group
    have hx_pos : x ∈ D.positiveSubgroup := by
      have : x = z * w⁻¹ := by rw [hzxw]; group
      rw [this]
      exact mul_mem (D.U_le_positiveSubgroup ha_pos hz)
        (inv_mem (D.posComplement_le_positiveSubgroup a hw_comp))
    have hx1 : x = 1 := by
      have hmem : x ∈ D.positiveSubgroup ⊓ D.negativeSubgroup :=
        ⟨hx_pos, D.U_le_negativeSubgroup hneg_lt hx_neg⟩
      rwa [D.positiveSubgroup_inf_negativeSubgroup, Subgroup.mem_bot] at hmem
    rwa [hzxw, hx1, one_mul]
  -- Step 4: conjugate by `m ∈ M_a` to get `U_{-a} ≤ U⁺_a ≤ U⁺`, contradicting
  -- `U⁺ ∩ U⁻ = {1}`.
  have hUneg_le : D.U neg_a ≤ D.posComplement a := by
    calc D.U neg_a
        = ConjAct.toConjAct m • D.U a.1 := (D.reflection_conjugates a.1 m hm a.1).symm
      _ ≤ ConjAct.toConjAct m • D.posComplement a := by gcongr
      _ = D.posComplement a := D.conj_smul_posComplement_of_mem_reflectionCoset ha hm
  have hbot : D.U neg_a ≤ D.positiveSubgroup ⊓ D.negativeSubgroup :=
    le_inf (hUneg_le.trans (D.posComplement_le_positiveSubgroup a))
      (D.U_le_negativeSubgroup hneg_lt)
  rw [D.positiveSubgroup_inf_negativeSubgroup, le_bot_iff] at hbot
  exact D.U_ne_bot neg_a hbot

/-! ### Triviality of `T ∩ U⁺` and `B ∩ N = T` -/

/-- Lifting a word `l` of simple reflections to an element `n ∈ N` whose inverse conjugation
preserves membership in `U⁺` for elements normalizing every root subgroup. -/
private theorem exists_weylNormalizer_wordProd_conj_positiveSubgroup
    (l : List D.indivisibleBase.support) :
    ∃ n : D.weylNormalizer,
      P.weylGroupEquivIndivisible (D.weylHom n) =
        TauCeti.wordProd P.indivisible D.indivisibleBase l ∧
      ∀ x ∈ D.positiveSubgroup, (∀ j : ι, x ∈ Subgroup.normalizer (D.U j : Set G)) →
        (n : G)⁻¹ * x * (n : G) ∈ D.positiveSubgroup := by
  induction l with
  | nil =>
    refine ⟨1, by simp, fun x hx _ ↦ by simpa using hx⟩
  | cons a l ih =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty a.1.1
    obtain ⟨n₁, hn₁_w, hn₁_pos⟩ := ih
    let n₀ : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer a.1.1 hm⟩
    refine ⟨n₀ * n₁, ?_, fun x hx hx_norm ↦ ?_⟩
    · rw [map_mul, map_mul, D.weylHom_of_mem_reflectionCoset hm,
        P.weylGroupEquivIndivisible_ofIdx a.1, hn₁_w, TauCeti.wordProd_cons]
    · have hx_comp : x ∈ D.posComplement a.1 :=
        D.mem_posComplement_of_mem_normalizer a.2 hx (hx_norm _)
      have hmx_comp : m⁻¹ * x * m ∈ D.posComplement a.1 := by
        have := Subgroup.conjAct_pointwise_smul_iff.mp
          (D.conj_smul_posComplement_of_mem_reflectionCoset a.2 (D.inv_mem_reflectionCoset hm))
        simpa using (Subgroup.mem_normalizer_iff.mp this x).mp hx_comp
      have hmx_norm : ∀ j : ι, m⁻¹ * x * m ∈ Subgroup.normalizer (D.U j : Set G) := by
        intro j
        rw [← Subgroup.conjAct_pointwise_smul_iff]
        have h1 := D.reflection_conjugates a.1.1 m hm j
        have h2 := Subgroup.conjAct_pointwise_smul_eq_self (hx_norm (P.reflectionPerm a.1.1 j))
        have h3 := D.reflection_conjugates a.1.1 m⁻¹ (D.inv_mem_reflectionCoset hm)
          (P.reflectionPerm a.1.1 j)
        rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul, h1, h2, h3]
        simp
      have heq :
          ((n₀ * n₁ : D.weylNormalizer) : G)⁻¹ * x * ((n₀ * n₁ : D.weylNormalizer) : G) =
            (n₁ : G)⁻¹ * (m⁻¹ * x * m) * (n₁ : G) := by
        rw [Subgroup.coe_mul]
        dsimp only [n₀]
        group
      rw [heq]
      exact hn₁_pos _ (D.posComplement_le_positiveSubgroup a.1 hmx_comp) hmx_norm

/-- Any lift `n ∈ N` of the longest element `w₀` conjugates `U⁺` into `U⁻`. -/
private theorem inv_conj_mem_negativeSubgroup_of_longestElement
    {n : D.weylNormalizer}
    (hw : P.weylGroupEquivIndivisible (D.weylHom n) =
      TauCeti.longestElement P.indivisible D.indivisibleBase)
    {u : G} (hu : u ∈ D.positiveSubgroup) :
    (n : G)⁻¹ * u * (n : G) ∈ D.negativeSubgroup := by
  have hw_inv : P.weylGroupEquivIndivisible (D.weylHom n⁻¹) =
      TauCeti.longestElement P.indivisible D.indivisibleBase := by
    rw [map_inv, map_inv, hw, TauCeti.longestElement_inv]
  have hconj_le :
      D.positiveSubgroup ≤ D.negativeSubgroup.comap (MulAut.conj (n : G)⁻¹).toMonoidHom := by
    rw [positiveSubgroup_le_iff]
    intro j hj x hx
    have hroot_neg : P.root' (P.weylGroupToPerm (D.weylHom n⁻¹) j) D.positiveVector < 0 := by
      have hindiv : ∀ k : {i : ι // P.IsIndivisible i}, 0 < P.root' k.1 D.positiveVector →
          P.root' (P.weylGroupToPerm (D.weylHom n⁻¹) k.1) D.positiveVector < 0 := fun k hk ↦ by
        have hk_pos : k ∈ TauCeti.posRoots P.indivisible D.indivisibleBase :=
          (TauCeti.mem_posRoots P.indivisible D.indivisibleBase k).mpr
            ((D.indivisibleBase_isPos_iff k).mpr hk)
        have hwk := TauCeti.mapsTo_posRoots_negRoots_longestElement P.indivisible
          D.indivisibleBase hk_pos
        rw [TauCeti.mem_negRoots, ← hw_inv, D.indivisibleBase_isPos_iff,
          P.coe_weylGroupToPerm_weylGroupEquivIndivisible] at hwk
        exact lt_of_le_of_ne (le_of_not_gt hwk) (D.positiveVector_regular _)
      rcases P.isIndivisible_or_exists_root_eq_two_smul j with hj_ind | ⟨k, hk, hjk⟩
      · exact hindiv ⟨j, hj_ind⟩ hj
      · have hk_pos : 0 < P.root' k D.positiveVector := by
          have : P.root' j D.positiveVector = 2 * P.root' k D.positiveVector := by
            simp [RootPairing.root', hjk]
          linarith
        have hwk := hindiv ⟨k, hk⟩ hk_pos
        have h2 : P.root (P.weylGroupToPerm (D.weylHom n⁻¹) j) =
            (2 : R) • P.root (P.weylGroupToPerm (D.weylHom n⁻¹) k) := by
          rw [← P.weylGroup_apply_root, ← P.weylGroup_apply_root, hjk, smul_comm]
        have : P.root' (P.weylGroupToPerm (D.weylHom n⁻¹) j) D.positiveVector =
            2 * P.root' (P.weylGroupToPerm (D.weylHom n⁻¹) k) D.positiveVector := by
          simp only [RootPairing.root', h2, map_smul, LinearMap.smul_apply, smul_eq_mul]
        linarith
    simpa using D.U_le_negativeSubgroup hroot_neg
      (D.mul_mul_inv_mem_U_of_mem_weylNormalizer n⁻¹ hx)
  simpa using hconj_le hu

/-- Any element of `U⁺` normalizing every root subgroup `D.U j` is trivial. -/
theorem eq_one_of_mem_positiveSubgroup_forall_normalizer {u : G}
    (hu : u ∈ D.positiveSubgroup)
    (hnorm : ∀ j : ι, u ∈ Subgroup.normalizer (D.U j : Set G)) : u = 1 := by
  let w₀ := TauCeti.longestElement P.indivisible D.indivisibleBase
  obtain ⟨l, hl⟩ := TauCeti.exists_wordProd_eq P.indivisible D.indivisibleBase w₀
  obtain ⟨n, hn_w, hn_pos⟩ := D.exists_weylNormalizer_wordProd_conj_positiveSubgroup l
  have hw_eq : P.weylGroupEquivIndivisible (D.weylHom n) = w₀ := hn_w.trans hl
  have hbot : (n : G)⁻¹ * u * (n : G) ∈ D.positiveSubgroup ⊓ D.negativeSubgroup :=
    ⟨hn_pos u hu hnorm, D.inv_conj_mem_negativeSubgroup_of_longestElement hw_eq hu⟩
  rw [D.positiveSubgroup_inf_negativeSubgroup, Subgroup.mem_bot] at hbot
  have hu_eq : u = (n : G) * ((n : G)⁻¹ * u * (n : G)) * (n : G)⁻¹ := by group
  rw [hu_eq, hbot]
  group

/-- `T ∩ U⁺ = {1}`. -/
@[simp]
theorem T_inf_positiveSubgroup_eq_bot : D.T ⊓ D.positiveSubgroup = ⊥ :=
  eq_bot_iff.mpr fun _ ⟨ht, hu⟩ ↦
    D.eq_one_of_mem_positiveSubgroup_forall_normalizer hu fun j ↦ D.le_normalizer j ht

/-- `B ∩ N = T`. -/
@[simp]
theorem borelSubgroup_inf_weylNormalizer : D.borelSubgroup ⊓ D.weylNormalizer = D.T := by
  refine le_antisymm ?_ (le_inf D.T_le_borelSubgroup D.T_le_weylNormalizer)
  intro g ⟨hgB, hgN⟩
  obtain ⟨t, ht, u, hu, rfl⟩ := D.mem_borelSubgroup_iff.mp hgB
  have huN : u ∈ D.weylNormalizer := by
    have : u = t⁻¹ * (t * u) := by group
    rw [this]
    exact mul_mem (inv_mem (D.T_le_weylNormalizer ht)) hgN
  let nu : D.weylNormalizer := ⟨u, huN⟩
  have hw1 : D.weylHom nu = 1 := by
    refine D.eq_one_of_forall_pos_U_le_positiveSubgroup fun i hi ↦ ?_
    rw [← D.weylHom_conj nu i]
    intro x hx
    have hy' : u⁻¹ * x * u ∈ D.U i := by
      have h := Subgroup.mem_pointwise_smul_iff_inv_smul_mem.mp hx
      rw [← ConjAct.toConjAct_inv, ConjAct.toConjAct_smul] at h
      simpa [nu] using h
    have : x = u * (u⁻¹ * x * u) * u⁻¹ := by group
    rw [this]
    exact mul_mem (mul_mem hu (D.U_le_positiveSubgroup hi hy')) (inv_mem hu)
  have hu1 : u = 1 := by
    refine D.eq_one_of_mem_positiveSubgroup_forall_normalizer hu fun j ↦ ?_
    rw [← Subgroup.conjAct_pointwise_smul_iff]
    simpa [hw1] using D.weylHom_conj nu j
  simpa [hu1] using ht

/-- As subgroups of `N`, `B ∩ N` coincides with `T`. -/
theorem borelSubgroup_subgroupOf_weylNormalizer :
    D.borelSubgroup.subgroupOf D.weylNormalizer = D.T.subgroupOf D.weylNormalizer := by
  ext ⟨g, hg⟩
  constructor
  · intro hgB
    have : g ∈ D.borelSubgroup ⊓ D.weylNormalizer := ⟨hgB, hg⟩
    rwa [D.borelSubgroup_inf_weylNormalizer] at this
  · exact fun hgT ↦ D.T_le_borelSubgroup hgT

end Crystallographic

