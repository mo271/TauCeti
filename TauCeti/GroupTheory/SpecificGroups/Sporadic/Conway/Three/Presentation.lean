/-! ### Words relating the presentation images and the ATLAS generators -/

/-- `imageA` expressed as a word in the ATLAS generators `a` and `b`. -/
theorem imageA_eq :
    imageA =
      a⁻¹ * b * a⁻¹ * b⁻¹ * a * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * b ^ 2 * a * b⁻¹ * a * b * a * b *
        a⁻¹ * b * a * b⁻¹ * a := by
  decide +kernel

/-- `imageB` expressed as a word in the ATLAS generators `a` and `b`. -/
theorem imageB_eq :
    imageB =
      a⁻¹ * b * a * b⁻¹ * a * b * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * b ^ 2 * a * b⁻¹ * a * b * a * b⁻¹ *
        a⁻¹ * b * a⁻¹ * b⁻¹ * a := by
  decide +kernel

/-- `imageC` expressed as a word in the ATLAS generators `a` and `b`. -/
theorem imageC_eq :
    imageC =
      a * b ^ 2 * a * b * a * b ^ 2 * a * b * a⁻¹ * b ^ 2 * a⁻¹ * b ^ 2 * a⁻¹ * b⁻¹ * a⁻¹ * b ^ 2 *
        a * b * a * b⁻¹ * a⁻¹ * b ^ 2 * a * b⁻¹ * a * b * a⁻¹ * b⁻¹ := by
  decide +kernel

/-- `imageD` expressed as a word in the ATLAS generators `a` and `b`. -/
theorem imageD_eq :
    imageD =
      a * b * a * b * a⁻¹ * b * a * b⁻¹ * a * b ^ 2 * a * b⁻¹ * a * b⁻¹ * a * b ^ 2 * a⁻¹ * b⁻¹ *
        a * b⁻¹ * a * b⁻¹ * a * b ^ 2 * a * b ^ 2 * a := by
  decide +kernel

/-- `imageE` is the involution `b ^ 2`. -/
theorem imageE_eq : imageE = b ^ 2 := by
  decide +kernel

/-- `imageF` is `(imageA * imageG) ^ 3`, matching the relator `f(ag)³`. -/
theorem imageF_eq : imageF = (imageA * imageG) ^ 3 := by
  decide +kernel

/-- `imageG` expressed as a word in the ATLAS generators `a` and `b`. -/
theorem imageG_eq :
    imageG =
      a * b ^ 2 * a * b ^ 2 * a⁻¹ * b ^ 2 * a * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a * b ^ 2 * a⁻¹ *
        b ^ 2 * a⁻¹ * b * a⁻¹ * b * a * b⁻¹ * a * b ^ 2 * a⁻¹ * b ^ 2 * a * b ^ 2 * a⁻¹ *
        b ^ 2 := by
  decide +kernel

/-- The second ATLAS generator `b` expressed as a word in the presentation images. -/
theorem b_eq :
    b =
      imageG * imageC * imageF * imageC * imageB * imageF * imageA * imageB * imageC * imageG *
        imageC * imageG * imageF * imageB * imageC * imageB * imageF := by
  decide +kernel

/-- The first ATLAS generator `a` expressed in terms of `b` and the presentation images. -/
theorem a_eq :
    a =
      imageF * imageC * b * imageD * imageF * imageC * b * imageB * imageF * imageB * imageC *
        imageF * imageB * imageD * b * imageB * imageF * imageC * b * imageF * b := by
  decide +kernel

/-- The first presentation image belongs to `Co3`. -/
theorem imageA_mem : imageA ∈ Co3 := by
  have ha := a_mem
  have hb := b_mem
  simp only [imageA_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem ha),
    mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb),
    mul_mem_cancel_right (pow_mem hb 2), inv_mem ha]

/-- The second presentation image belongs to `Co3`. -/
theorem imageB_mem : imageB ∈ Co3 := by
  have ha := a_mem
  have hb := b_mem
  simp only [imageB_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem ha),
    mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb),
    mul_mem_cancel_right (pow_mem hb 2), inv_mem ha]

/-- The third presentation image belongs to `Co3`. -/
theorem imageC_mem : imageC ∈ Co3 := by
  have ha := a_mem
  have hb := b_mem
  simp only [imageC_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem ha),
    mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb),
    mul_mem_cancel_right (pow_mem hb 2), ha]

/-- The fourth presentation image belongs to `Co3`. -/
theorem imageD_mem : imageD ∈ Co3 := by
  have ha := a_mem
  have hb := b_mem
  simp only [imageD_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem ha),
    mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb),
    mul_mem_cancel_right (pow_mem hb 2), ha]

/-- The fifth presentation image belongs to `Co3`. -/
theorem imageE_mem : imageE ∈ Co3 :=
  imageE_eq ▸ pow_mem b_mem 2

/-- The seventh presentation image belongs to `Co3`. -/
theorem imageG_mem : imageG ∈ Co3 := by
  have ha := a_mem
  have hb := b_mem
  simp only [imageG_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem ha),
    mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb),
    mul_mem_cancel_right (pow_mem hb 2), ha]

/-- The sixth presentation image belongs to `Co3`. -/
theorem imageF_mem : imageF ∈ Co3 :=
  imageF_eq ▸ pow_mem (mul_mem imageA_mem imageG_mem) 3

/-! ### The generator assignment and relator verification -/

/-- The seven-generator assignment for Đoković's presentation of `Co₃`. -/
def presentationImage (i : Fin SporadicName.Co3.presentation.generatorCount) :
    Equiv.Perm (Fin 276) :=
  match (i : ℕ) with
  | 0 => imageA
  | 1 => imageB
  | 2 => imageC
  | 3 => imageD
  | 4 => imageE
  | 5 => imageF
  | _ => imageG

/-- Value of `presentationImage` at generator index `0`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `1`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `2`. -/
@[simp]
theorem presentationImage_two (h : 2 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨2, h⟩ = imageC := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `3`. -/
@[simp]
theorem presentationImage_three (h : 3 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨3, h⟩ = imageD := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `4`. -/
@[simp]
theorem presentationImage_four (h : 4 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨4, h⟩ = imageE := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `5`. -/
@[simp]
theorem presentationImage_five (h : 5 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨5, h⟩ = imageF := by
  simp [presentationImage]

/-- Value of `presentationImage` at generator index `6`. -/
@[simp]
theorem presentationImage_six (h : 6 < SporadicName.Co3.presentation.generatorCount) :
    presentationImage ⟨6, h⟩ = imageG := by
  simp [presentationImage]

/-- The range of `presentationImage` consists precisely of the seven chosen involutions. -/
theorem range_presentationImage :
    Set.range presentationImage = {imageA, imageB, imageC, imageD, imageE, imageF, imageG} := by
  have h : SporadicName.Co3.presentation.generatorCount = 7 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨i, hi⟩, rfl⟩
    rw [h] at hi
    match i with
    | 0 | 1 | 2 | 3 | 4 | 5 | 6 => simp [presentationImage]
    | n + 7 => omega
  · rintro (rfl | rfl | rfl | rfl | rfl | rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩
    · exact ⟨⟨2, by omega⟩, presentationImage_two _⟩
    · exact ⟨⟨3, by omega⟩, presentationImage_three _⟩
    · exact ⟨⟨4, by omega⟩, presentationImage_four _⟩
    · exact ⟨⟨5, by omega⟩, presentationImage_five _⟩
    · exact ⟨⟨6, by omega⟩, presentationImage_six _⟩

/- Separate closed checks keep each relator computation small and fast in the kernel. -/
private theorem relator0 : imageA ^ 2 = 1 := by decide +kernel
private theorem relator1 : imageB ^ 2 = 1 := by decide +kernel
private theorem relator2 : imageC ^ 2 = 1 := by decide +kernel
private theorem relator3 : imageD ^ 2 = 1 := by decide +kernel
private theorem relator4 : imageE ^ 2 = 1 := by decide +kernel
private theorem relator5 : imageF ^ 2 = 1 := by decide +kernel
private theorem relator6 : imageG ^ 2 = 1 := by decide +kernel
private theorem relator7 : (imageA * imageC) ^ 2 = 1 := by decide +kernel
private theorem relator8 : (imageA * imageD) ^ 2 = 1 := by decide +kernel
private theorem relator9 : (imageA * imageE) ^ 2 = 1 := by decide +kernel
private theorem relator10 : (imageB * imageD) ^ 2 = 1 := by decide +kernel
private theorem relator11 : (imageC * imageE) ^ 2 = 1 := by decide +kernel
private theorem relator12 : (imageD * imageG) ^ 2 = 1 := by decide +kernel
private theorem relator13 : (imageE * imageG) ^ 2 = 1 := by decide +kernel
private theorem relator14 : (imageA * imageB) ^ 3 = 1 := by decide +kernel
private theorem relator15 : (imageC * imageD) ^ 3 = 1 := by decide +kernel
private theorem relator16 : (imageD * imageE) ^ 3 = 1 := by decide +kernel
private theorem relator17 : imageF * (imageA * imageG) ^ 3 = 1 := by decide +kernel
private theorem relator18 : imageG * (imageB * imageF) ^ 3 = 1 := by decide +kernel
private theorem relator19 : (imageC * imageF * imageG) ^ 3 = 1 := by decide +kernel
private theorem relator20 : imageE * (imageA * imageB * imageC) ^ 3 = 1 := by decide +kernel
private theorem relator21 : imageE * (imageA * imageC * imageG) ^ 4 = 1 := by decide +kernel
private theorem relator22 : (imageB * imageC * imageF * imageC * imageF) ^ 3 = 1 := by
  decide +kernel
private theorem relator23 : imageE * (imageA * imageB * imageC * imageF) ^ 7 = 1 := by
  decide +kernel

/-- All twenty-four transcribed relators of Đoković's presentation of `Co₃` hold at
`presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.Co3.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  let img (n : ℕ) : Equiv.Perm (Fin 276) :=
    match n with
    | 0 => imageA
    | 1 => imageB
    | 2 => imageC
    | 3 => imageD
    | 4 => imageE
    | 5 => imageF
    | _ => imageG
  -- Abstract over the presentation first because it appears in the generator index type.
  suffices key : ∀ P : GroupPresentation, P = co3Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ img i) t.toFreeGroup = 1 from
    key _ SporadicName.presentation_Co3
  rintro P rfl
  simp only [co3Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_gen, img]
  exact ⟨relator0, relator1, relator2, relator3, relator4, relator5, relator6,
    relator7, relator8, relator9, relator10, relator11, relator12, relator13,
    relator14, relator15, relator16, relator17, relator18, relator19,
    relator20, relator21, relator22, relator23⟩

/-- The seven presentation images generate the ATLAS degree-276 permutation model `Co3`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = Co3 := by
  rw [range_presentationImage]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    rintro σ (rfl | rfl | rfl | rfl | rfl | rfl | rfl)
    · exact imageA_mem
    · exact imageB_mem
    · exact imageC_mem
    · exact imageD_mem
    · exact imageE_mem
    · exact imageF_mem
    · exact imageG_mem
  · rw [Co3_def]
    refine (Subgroup.closure_le _).mpr ?_
    let S : Set (Equiv.Perm (Fin 276)) :=
      {imageA, imageB, imageC, imageD, imageE, imageF, imageG}
    have hA : imageA ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hB : imageB ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hC : imageC ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hD : imageD ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hF : imageF ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hG : imageG ∈ Subgroup.closure S := Subgroup.subset_closure (by simp [S])
    have hb : b ∈ Subgroup.closure S := by
      simp only [b_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right hC, mul_mem_cancel_right hF, mul_mem_cancel_right hG, hG]
    have ha : a ∈ Subgroup.closure S := by
      simp only [a_eq, mul_mem_cancel_right hb, mul_mem_cancel_right hB,
        mul_mem_cancel_right hC, mul_mem_cancel_right hD, mul_mem_cancel_right hF, hF]
    rintro σ (rfl | rfl)
    · exact ha
    · exact hb

/-- The homomorphism from the presented group `SporadicName.Co3.Group` into `Equiv.Perm (Fin 276)`
sending each presentation generator to `presentationImage`. -/
def presentationHom : SporadicName.Co3.Group →* Equiv.Perm (Fin 276) :=
  SporadicName.Co3.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- `presentationHom` evaluates to `presentationImage` on each canonical generator. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.Co3.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the ATLAS permutation model `Co3`. -/
theorem range_presentationHom : presentationHom.range = Co3 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end Co3

/-- The presented third Conway group surjects onto its ATLAS degree-276 permutation model. -/
theorem exists_surjective_Co3 :
    ∃ f : SporadicName.Co3.Group →* Co3, Function.Surjective f :=
  SporadicName.Co3.presentation.exists_surjective_of_closure_range_eq
    ⟨Co3.presentationImage, Co3.lift_presentationImage_toFreeGroup_eq_one⟩
    Co3.closure_range_presentationImage

/-- The presented third Conway group is nontrivial because it surjects onto `Co3`. -/
instance : Nontrivial SporadicName.Co3.Group :=
  exists_surjective_Co3.choose_spec.nontrivial

end TauCeti.Sporadic
