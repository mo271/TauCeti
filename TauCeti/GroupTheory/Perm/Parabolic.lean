module

public import TauCeti.GroupTheory.Coxeter.Parabolic
public import TauCeti.GroupTheory.Perm.FiberSubgroup
public import TauCeti.GroupTheory.Perm.Poincare
import Mathlib.Data.Finset.Sort

/-!
# Standard parabolic subgroups of the symmetric group from monotone maps

Given a map `f : Fin n → ι`, let `TauCeti.fiberGenSet f` be the set of simple generator indices `i`
for which `f` identifies the two adjacent strands `strand i` and `strandSucc i`. Every simple
transposition indexed by `fiberGenSet f` preserves the fibers of `f`, so the standard parabolic
subgroup `(permCoxeterSystem n).parabolic (fiberGenSet f)` is always contained in
`TauCeti.fiberSubgroup f`.

When `ι` is partially ordered and `f` is monotone, the fibers of `f` are order-convex blocks of
`Fin n`, and equality holds (`TauCeti.parabolic_fiberGenSet`):

* `(permCoxeterSystem n).parabolic (fiberGenSet f) = fiberSubgroup f`;
* a permutation `σ` is a minimal left coset representative for `fiberGenSet f` precisely when `σ`
  is strictly monotone on each fiber of `f` (`TauCeti.isMinimalCosetRep_fiberGenSet_iff`), and has
  no left descent in `fiberGenSet f` precisely when `σ⁻¹` is strictly monotone on each fiber
  (`TauCeti.forall_not_isLeftDescent_fiberGenSet_iff`);
* every inversion of `σ ∈ fiberSubgroup f` lies inside a single fiber of `f`, so the Coxeter length
  of `σ` decomposes as the sum of the Coxeter lengths of its fiber restrictions along order
  isomorphisms (`TauCeti.permCoxeterSystem_length_fiberSubgroup_eq_sum`), and the length generating
  function over `fiberSubgroup f` factors into the product of the quantum factorials of the fiber
  cardinalities (`TauCeti.sum_pow_permCoxeterSystem_length_fiberSubgroup`).

Specializing `f` to `TauCeti.youngBlock μ` recovers the Young subgroups of `S_n` as standard
parabolic subgroups, and specializing `f` to the column-index map of the column-superstandard
tableau does the same for its column subgroup.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, Springer GTM 231 (2005),
  Section 2.4.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Section 3.1.
-/

public section

namespace TauCeti

open Finset TauCeti.BraidGroup

variable {n : ℕ} {ι : Type*}

/-- The set of adjacent-transposition indices `i : Fin (n - 1)` whose two crossed strands lie in
the same fiber of `f : Fin n → ι`. -/
def fiberGenSet (f : Fin n → ι) : Set (Fin (n - 1)) :=
  {i | f (strand i) = f (strandSucc i)}

@[simp]
theorem mem_fiberGenSet {f : Fin n → ι} {i : Fin (n - 1)} :
    i ∈ fiberGenSet f ↔ f (strand i) = f (strandSucc i) :=
  (Iff.rfl)

/-- Every adjacent transposition whose two strands lie in a common fiber of `f` preserves all
fibers of `f`, so the standard parabolic subgroup of `fiberGenSet f` is contained in
`fiberSubgroup f`. -/
theorem parabolic_fiberGenSet_le (f : Fin n → ι) :
    (permCoxeterSystem n).parabolic (fiberGenSet f) ≤ fiberSubgroup f := by
  rw [CoxeterSystem.parabolic_le_iff]
  intro i hi
  rw [permCoxeterSystem_simple, transposition_eq_swap]
  exact swap_mem_fiberSubgroup (mem_fiberGenSet.mp hi)

/-- For a monotone map `f : Fin n → ι` into a partial order, every inversion of a fiber-preserving
permutation occurs between two points in the same fiber of `f`. -/
theorem apply_eq_of_lt_of_mem_fiberSubgroup [PartialOrder ι] {f : Fin n → ι} (hf : Monotone f)
    {σ : Equiv.Perm (Fin n)} (hσ : σ ∈ fiberSubgroup f) {x y : Fin n}
    (hxy : x < y) (hinv : σ y < σ x) :
    f x = f y := by
  refine le_antisymm (hf hxy.le) ?_
  rw [← mem_fiberSubgroup.mp hσ y, ← mem_fiberSubgroup.mp hσ x]
  exact hf hinv.le

/-- **Standard parabolic subgroups from monotone maps.** When `f : Fin n → ι` is monotone into a
partial order, the subgroup `fiberSubgroup f` of permutations preserving every fiber of `f` equals
the standard parabolic subgroup generated by the adjacent transpositions within the fibers. -/
theorem parabolic_fiberGenSet [PartialOrder ι] {f : Fin n → ι} (hf : Monotone f) :
    (permCoxeterSystem n).parabolic (fiberGenSet f) = fiberSubgroup f := by
  refine le_antisymm (parabolic_fiberGenSet_le f) fun σ hσ ↦ ?_
  induction hk : (permCoxeterSystem n).length σ generalizing σ with
  | zero =>
    rw [(permCoxeterSystem n).length_eq_zero_iff] at hk
    exact hk ▸ one_mem _
  | succ k ih =>
    have hσ1 : σ ≠ 1 := fun h ↦ by simp [h] at hk
    obtain ⟨i, hi⟩ := (permCoxeterSystem n).exists_rightDescent_of_ne_one hσ1
    have hdesc : σ (strandSucc i) < σ (strand i) := isRightDescent_permCoxeterSystem_iff.mp hi
    have hi_mem : i ∈ fiberGenSet f :=
      mem_fiberGenSet.mpr (apply_eq_of_lt_of_mem_fiberSubgroup hf hσ
        (Fin.lt_def.mpr (by simp)) hdesc)
    have hs_par : (permCoxeterSystem n).simple i ∈
        (permCoxeterSystem n).parabolic (fiberGenSet f) :=
      (permCoxeterSystem n).simple_mem_parabolic hi_mem
    have hs_fib : (permCoxeterSystem n).simple i ∈ fiberSubgroup f :=
      parabolic_fiberGenSet_le f hs_par
    have hlen : (permCoxeterSystem n).length (σ * (permCoxeterSystem n).simple i) = k := by
      have := (permCoxeterSystem n).length_mul_simple σ i
      have := (permCoxeterSystem n).isRightDescent_iff.mp hi
      omega
    have hprev := ih (σ * (permCoxeterSystem n).simple i) (mul_mem hσ hs_fib) hlen
    simpa [(permCoxeterSystem n).simple_mul_simple_cancel_right] using mul_mem hprev hs_par

/-- **Minimal left coset representatives for a monotone map.** For monotone `f : Fin n → ι`, a
permutation `σ` is a minimal left coset representative of `(permCoxeterSystem n).parabolic
(fiberGenSet f)` if and only if `σ` is strictly increasing on each fiber of `f`. -/
theorem isMinimalCosetRep_fiberGenSet_iff [PartialOrder ι] {f : Fin n → ι} (hf : Monotone f)
    {σ : Equiv.Perm (Fin n)} :
    (permCoxeterSystem n).IsMinimalCosetRep (fiberGenSet f) σ ↔
      ∀ ⦃x y : Fin n⦄, x < y → f x = f y → σ x < σ y := by
  rw [CoxeterSystem.isMinimalCosetRep_iff]
  constructor
  · intro hmin x y hxy hfxy
    induction hk : (y : ℕ) generalizing y with
    | zero =>
      rw [Fin.lt_def, hk] at hxy
      omega
    | succ k ih =>
      have hk_lt : k + 1 < n := hk ▸ y.isLt
      let i : Fin (n - 1) := ⟨k, by omega⟩
      have hi_val : (i : ℕ) = k := rfl
      have hy : strandSucc i = y := Fin.ext (by simp [hi_val, hk])
      have hxle : x ≤ strand i := by
        rw [Fin.le_def, val_strand, hi_val]
        rw [Fin.lt_def, hk] at hxy
        omega
      have hyle : strand i ≤ y := by
        rw [Fin.le_def, val_strand, hi_val, hk]
        omega
      have hfi : f (strand i) = f y :=
        le_antisymm (hf hyle) (hfxy ▸ hf hxle)
      have hi_mem : i ∈ fiberGenSet f := mem_fiberGenSet.mpr (hy ▸ hfi)
      have hstep : σ (strand i) < σ y := by
        have hnd := hmin i hi_mem
        rw [isRightDescent_permCoxeterSystem_iff, hy] at hnd
        exact lt_of_le_of_ne (not_lt.mp hnd) (σ.injective.ne (hy ▸ strand_ne_strandSucc i))
      rcases hxle.eq_or_lt with hx_eq | hxlt
      · exact hx_eq ▸ hstep
      · exact (ih (y := strand i) hxlt (hfxy.trans hfi.symm) (by simp [hi_val])).trans hstep
  · intro hmono i hi
    rw [isRightDescent_permCoxeterSystem_iff]
    exact not_lt.mpr (hmono (Fin.lt_def.mpr (by simp)) (mem_fiberGenSet.mp hi)).le

/-- **Right-coset minimality for a monotone map.** For monotone `f : Fin n → ι`, a permutation `σ`
has no left descent in `fiberGenSet f` if and only if `σ⁻¹` is strictly increasing on each fiber of
`f`. -/
theorem forall_not_isLeftDescent_fiberGenSet_iff [PartialOrder ι] {f : Fin n → ι}
    (hf : Monotone f) {σ : Equiv.Perm (Fin n)} :
    (∀ i ∈ fiberGenSet f, ¬ (permCoxeterSystem n).IsLeftDescent σ i) ↔
      ∀ ⦃x y : Fin n⦄, x < y → f x = f y → σ⁻¹ x < σ⁻¹ y := by
  simp_rw [← CoxeterSystem.isRightDescent_inv_iff]
  rw [← CoxeterSystem.isMinimalCosetRep_iff, isMinimalCosetRep_fiberGenSet_iff hf]

/-- **Coxeter length decomposition on `fiberSubgroup f`.** When `f : Fin n → ι` is monotone and
each fiber `{a // f a = i}` is identified order-isomorphically with `Fin (d i)`, the Coxeter length
of `σ ∈ fiberSubgroup f` is the sum of the Coxeter lengths of its fiber components. -/
theorem permCoxeterSystem_length_fiberSubgroup_eq_sum [PartialOrder ι] [Fintype ι]
    {d : ι → ℕ} {f : Fin n → ι} (hf : Monotone f)
    (e : ∀ i, {a : Fin n // f a = i} ≃o Fin (d i)) (σ : fiberSubgroup f) :
    (permCoxeterSystem n).length (σ : Equiv.Perm (Fin n)) =
      ∑ i : ι, (permCoxeterSystem (d i)).length
        ((e i).toEquiv.permCongr (fiberSubgroupMulEquivPiPerm f σ i)) := by
  classical
  rw [permCoxeterSystem_length_eq_card_inversion]
  set I := univ.filter fun p : Fin n × Fin n ↦
    p.1 < p.2 ∧ (σ : Equiv.Perm (Fin n)) p.2 < (σ : Equiv.Perm (Fin n)) p.1
  rw [card_eq_sum_card_fiberwise (f := fun p : Fin n × Fin n ↦ f p.1)
    (fun _ _ ↦ mem_univ _)]
  refine sum_congr rfl fun i _ ↦ ?_
  rw [permCoxeterSystem_length_eq_card_inversion]
  set τ := (e i).toEquiv.permCongr (fiberSubgroupMulEquivPiPerm f σ i)
  refine (card_bij (fun (q : Fin (d i) × Fin (d i)) _ ↦
      (((e i).symm q.1 : Fin n), ((e i).symm q.2 : Fin n))) ?_ ?_ ?_).symm
  · intro q hq
    obtain ⟨-, hq12, hτ⟩ := mem_filter.mp hq
    let x := (e i).symm q.1
    let y := (e i).symm q.2
    have hxy : (x : Fin n) < (y : Fin n) := (e i).symm.lt_iff_lt.mpr hq12
    have hσxy : (σ : Equiv.Perm (Fin n)) y < (σ : Equiv.Perm (Fin n)) x := by
      simp only [τ, Equiv.permCongr_apply] at hτ
      have hlt : fiberSubgroupMulEquivPiPerm f σ i y < fiberSubgroupMulEquivPiPerm f σ i x :=
        (e i).lt_iff_lt.mp hτ
      simpa only [← Subtype.coe_lt_coe, fiberSubgroupMulEquivPiPerm_apply_coe] using hlt
    exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_univ _, hxy, hσxy⟩, x.2⟩
  · intro q₁ _ q₂ _ heq
    obtain ⟨h₁, h₂⟩ := Prod.mk.inj heq
    exact Prod.ext
      ((e i).symm.injective (Subtype.ext h₁)) ((e i).symm.injective (Subtype.ext h₂))
  · intro p hp
    obtain ⟨hpI, hpi⟩ := mem_filter.mp hp
    obtain ⟨-, hlt, hinv⟩ := mem_filter.mp hpI
    have hp2 : f p.2 = i :=
      (apply_eq_of_lt_of_mem_fiberSubgroup hf σ.2 hlt hinv).symm.trans hpi
    refine ⟨(e i ⟨p.1, hpi⟩, e i ⟨p.2, hp2⟩), ?_, ?_⟩
    · rw [mem_filter]
      refine ⟨mem_univ _, (e i).lt_iff_lt.mpr hlt, ?_⟩
      dsimp only [τ]
      rw [Equiv.permCongr_apply, Equiv.permCongr_apply]
      refine (e i).lt_iff_lt.mpr ?_
      have hsymm2 : (e i).toEquiv.symm (e i ⟨p.2, hp2⟩) = ⟨p.2, hp2⟩ :=
        (e i).toEquiv.symm_apply_apply _
      have hsymm1 : (e i).toEquiv.symm (e i ⟨p.1, hpi⟩) = ⟨p.1, hpi⟩ :=
        (e i).toEquiv.symm_apply_apply _
      rw [hsymm2, hsymm1, ← Subtype.coe_lt_coe, fiberSubgroupMulEquivPiPerm_apply_coe,
        fiberSubgroupMulEquivPiPerm_apply_coe]
      exact hinv
    · simp

/-- **Length generating function of `fiberSubgroup f` for a monotone map.** It is the product over
all fibers of the quantum factorials of the fiber sizes. -/
theorem sum_pow_permCoxeterSystem_length_fiberSubgroup [PartialOrder ι] [Fintype ι]
    [DecidableEq ι] {R : Type*} [CommSemiring R] {f : Fin n → ι} (hf : Monotone f)
    [Fintype (fiberSubgroup f)] (x : R) :
    (∑ σ : fiberSubgroup f, x ^ (permCoxeterSystem n).length (σ : Equiv.Perm (Fin n))) =
      ∏ i : ι, ∏ d ∈ Icc 1 #{a | f a = i}, ∑ j ∈ range d, x ^ j := by
  let e : ∀ i : ι, {a : Fin n // f a = i} ≃o Fin #{a | f a = i} := fun i ↦
    (Fintype.orderIsoFinOfCardEq {a : Fin n // f a = i} (Fintype.card_subtype _)).symm
  let E : fiberSubgroup f ≃ ∀ i : ι, Equiv.Perm (Fin #{a | f a = i}) :=
    ((fiberSubgroupMulEquivPiPerm f).trans
      (MulEquiv.piCongrRight fun i ↦ (e i).toEquiv.permCongrHom)).toEquiv
  have hlen (σ : fiberSubgroup f) :
      x ^ (permCoxeterSystem n).length (σ : Equiv.Perm (Fin n)) =
        ∏ i : ι, x ^ (permCoxeterSystem #{a | f a = i}).length (E σ i) := by
    rw [permCoxeterSystem_length_fiberSubgroup_eq_sum hf e σ, ← prod_pow_eq_pow_sum]
    rfl
  simp_rw [hlen]
  rw [← E.symm.sum_comp]
  simp only [Equiv.apply_symm_apply]
  rw [← Fintype.prod_sum (fun i τ ↦ x ^ (permCoxeterSystem #{a | f a = i}).length τ)]
  exact prod_congr rfl fun i _ ↦ sum_pow_permCoxeterSystem_length x #{a | f a = i}

/-- **Length generating function of the standard parabolic subgroup of a monotone map.** -/
theorem sum_pow_permCoxeterSystem_length_parabolic_fiberGenSet [PartialOrder ι] [Fintype ι]
    [DecidableEq ι] {R : Type*} [CommSemiring R] {f : Fin n → ι} (hf : Monotone f)
    [Fintype ((permCoxeterSystem n).parabolic (fiberGenSet f))] (x : R) :
    (∑ σ : (permCoxeterSystem n).parabolic (fiberGenSet f),
        x ^ (permCoxeterSystem n).length (σ : Equiv.Perm (Fin n))) =
      ∏ i : ι, ∏ d ∈ Icc 1 #{a | f a = i}, ∑ j ∈ range d, x ^ j := by
  let _ : Fintype (fiberSubgroup f) := Fintype.ofFinite (fiberSubgroup f)
  let eqv : (permCoxeterSystem n).parabolic (fiberGenSet f) ≃ fiberSubgroup f :=
    Equiv.subtypeEquivRight fun σ ↦ by rw [parabolic_fiberGenSet hf]
  rw [← sum_pow_permCoxeterSystem_length_fiberSubgroup hf x, ← eqv.sum_comp]
  rfl

end TauCeti
