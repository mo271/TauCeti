/-!
# The universal Mennicke group

For a commutative ring `A` and an ideal `I : Ideal A`, the **universal Mennicke group**
`TauCeti.MennickeGroup A I` (denoted `C_I` or `C(A, I)` in Bass–Milnor–Serre) is the presented
group generated by admissible pairs `p : MennickePair A I` subject to the Mennicke symbol
relations (`TauCeti.MennickeRel`):
* `[0 / 1] = 1`,
* `[b + t * a / a] = [b / a]` for `t ∈ I`,
* `[b / a + t * b] = [b / a]` for `t : A`,
* `[b₁ * b₂ / a] = [b₁ / a] * [b₂ / a]`.

Because every value of a Mennicke symbol in an arbitrary monoid `C` is automatically a two-sided
unit with explicit Bézout inverse (`TauCeti.MennickeSymbol.toUnits`), `MennickeGroup A I`
represents `MennickeSymbol A I C` not merely for groups `C`, but for arbitrary monoids `C`
(`TauCeti.MennickeGroup.liftEquiv`). Moreover, because generator inverses are themselves
generators, `MennickeGroup A I` is generated as a **submonoid** by `Set.range of`
(`submonoid_closure_range_of`), yielding a positive induction principle (`induction_on`) with no
inverse case.

## Main definitions

* `TauCeti.MennickeRel`: the defining relations of `MennickeGroup A I` inside
  `FreeGroup (MennickePair A I)`.
* `TauCeti.MennickeGroup`: the universal group `C(A, I)` presented by `MennickePair A I` and
  `MennickeRel A I`.
* `TauCeti.MennickeGroup.of`: the universal Mennicke symbol
  `MennickeSymbol A I (MennickeGroup A I)`.
* `TauCeti.MennickeGroup.lift`: universal extension of any `s : MennickeSymbol A I C` (for an
  arbitrary monoid `C`) to a monoid homomorphism `MennickeGroup A I →* C`.
* `TauCeti.MennickeGroup.liftEquiv`: the natural bijection
  `MennickeSymbol A I C ≃ (MennickeGroup A I →* C)`.
* `TauCeti.MennickeGroup.mapIdeal`: functorial transition `MennickeGroup A J →* MennickeGroup A I`
  for an ideal inclusion `J ≤ I`.
* `TauCeti.MennickeGroup.map`: functorial pushforward `MennickeGroup A I →* MennickeGroup B J`
  for a ring homomorphism `f : A →+* B` with `I.map f ≤ J`.

## Main results

* `TauCeti.MennickeGroup.closure_range_of` and `submonoid_closure_range_of`: `Set.range of`
  generates `MennickeGroup A I` both as a subgroup and as a submonoid.
* `TauCeti.MennickeGroup.induction_on`: positive generator induction on `MennickeGroup A I`.
* `TauCeti.MennickeGroup.exists_list_prod_of`: every element is a finite product of generators
  `of p` (with no inverses needed).
* `TauCeti.MennickeGroup.hom_ext`: two monoid homomorphisms out of `MennickeGroup A I` into any
  monoid `C` agree iff they agree on all generators `of p`.
* `TauCeti.MennickeGroup.subsingleton_bot`: `MennickeGroup A ⊥` is trivial.
* `TauCeti.MennickeGroup.subsingleton_top_of_euclideanDomain`: over a Euclidean domain `E`,
  `MennickeGroup E ⊤` is trivial.

## References

* H. Bass, J. Milnor, and J.-P. Serre, *Solution of the congruence subgroup problem for `SL_n`
  (`n ≥ 3`) and `Sp_{2n}` (`n ≥ 2`)*, Publ. Math. IHÉS 33 (1967), §2, Definition 2.5 and (2.6),
  pp. 65–67.
-/

public section

namespace TauCeti

/-- Defining relations for the universal Mennicke group `MennickeGroup A I` inside
`FreeGroup (MennickePair A I)`. -/
inductive MennickeRel (A : Type*) [CommRing A] (I : Ideal A) :
    FreeGroup (MennickePair A I) → Prop
  /-- Normalization relation `(1, 0) = 1`. -/
  | oneZero : MennickeRel A I (FreeGroup.of .oneZero)
  /-- Elementary move MS1a: `(a, b + t * a) = (a, b)` for `t ∈ I`. -/
  | shiftSnd (p : MennickePair A I) {t : A} (ht : t ∈ I) :
      MennickeRel A I (FreeGroup.of (p.shiftSnd ht) * (FreeGroup.of p)⁻¹)
  /-- Elementary move MS1b: `(a + t * b, b) = (a, b)` for `t : A`. -/
  | shiftFst (p : MennickePair A I) (t : A) :
      MennickeRel A I (FreeGroup.of (p.shiftFst t) * (FreeGroup.of p)⁻¹)
  /-- Multiplicativity MS2: `(a, b₁ * b₂) = (a, b₁) * (a, b₂)`. -/
  | mulSnd (p q : MennickePair A I) (h : p.fst = q.fst) :
      MennickeRel A I (FreeGroup.of (p.mulSnd q h) * (FreeGroup.of p * FreeGroup.of q)⁻¹)

/-- The universal Mennicke group `C(A, I)` presented by admissible pairs `MennickePair A I`
modulo the Mennicke symbol relations `MennickeRel A I`. -/
@[expose]
def MennickeGroup (A : Type*) [CommRing A] (I : Ideal A) : Type _ :=
  PresentedGroup {r | MennickeRel A I r}

namespace MennickeGroup

variable {A B : Type*} [CommRing A] [CommRing B] {I J K : Ideal A} {C D : Type*}
  [Monoid C] [Monoid D]

instance instGroup : Group (MennickeGroup A I) :=
  QuotientGroup.Quotient.group _

/-- The universal Mennicke symbol `MennickePair A I → MennickeGroup A I`. -/
def of : MennickeSymbol A I (MennickeGroup A I) where
  toFun p := PresentedGroup.of (rels := {r | MennickeRel A I r}) p
  map_oneZero' := PresentedGroup.one_of_mem (rels := {r | MennickeRel A I r}) MennickeRel.oneZero
  map_shiftSnd' p _ ht :=
    PresentedGroup.mk_eq_mk_of_mul_inv_mem (rels := {r | MennickeRel A I r})
      (MennickeRel.shiftSnd p ht)
  map_shiftFst' p t :=
    PresentedGroup.mk_eq_mk_of_mul_inv_mem (rels := {r | MennickeRel A I r})
      (MennickeRel.shiftFst p t)
  map_mulSnd' p q h := by
    have hrel := PresentedGroup.mk_eq_mk_of_mul_inv_mem (rels := {r | MennickeRel A I r})
      (x := FreeGroup.of (p.mulSnd q h)) (y := FreeGroup.of p * FreeGroup.of q)
      (MennickeRel.mulSnd p q h)
    rw [map_mul] at hrel
    exact hrel

/-- `Set.range of` generates `MennickeGroup A I` as a subgroup. -/
theorem closure_range_of :
    Subgroup.closure (Set.range (of (A := A) (I := I) : MennickePair A I → MennickeGroup A I)) =
      ⊤ := by
  have hof : (of (A := A) (I := I) : MennickePair A I → MennickeGroup A I) =
      PresentedGroup.of (rels := {r | MennickeRel A I r}) := rfl
  rw [hof]
  exact PresentedGroup.closure_range_of {r | MennickeRel A I r}

/-- Because every generator `of p` has an inverse that is itself a generator (its Bézout inverse
pair), `Set.range of` generates `MennickeGroup A I` already as a submonoid. -/
theorem submonoid_closure_range_of :
    Submonoid.closure (Set.range (of (A := A) (I := I) : MennickePair A I → MennickeGroup A I)) =
      ⊤ := by
  let S : Submonoid (MennickeGroup A I) :=
    Submonoid.closure (Set.range (of (A := A) (I := I) : MennickePair A I → MennickeGroup A I))
  have hinv : ∀ x ∈ S, x⁻¹ ∈ S := by
    intro x hx
    refine Submonoid.closure_induction ?_ ?_ ?_ hx
    · rintro _ ⟨p, rfl⟩
      obtain ⟨x, y, hxy⟩ := p.isCoprime
      rw [(of (A := A) (I := I)).map_inv_eq_bezoutInvPair p hxy]
      exact Submonoid.subset_closure ⟨p.bezoutInvPair hxy, rfl⟩
    · simp
    · intro a b _ _ ha hb
      rw [mul_inv_rev]
      exact S.mul_mem hb ha
  let H : Subgroup (MennickeGroup A I) :=
    { S with inv_mem' := fun hx ↦ hinv _ hx }
  have htop : (⊤ : Subgroup (MennickeGroup A I)) ≤ H := by
    rw [← closure_range_of, Subgroup.closure_le]
    exact Submonoid.subset_closure
  rw [eq_top_iff]
  intro x _
  exact htop (Subgroup.mem_top x)

/-- Positive induction principle on `MennickeGroup A I`: no inverse case is required because every
generator's inverse is also a generator. -/
@[elab_as_elim]
theorem induction_on {P : MennickeGroup A I → Prop} (x : MennickeGroup A I)
    (one : P 1) (of_case : ∀ p : MennickePair A I, P (of p))
    (mul : ∀ a b, P a → P b → P (a * b)) : P x := by
  have hx : x ∈ Submonoid.closure
      (Set.range (of (A := A) (I := I) : MennickePair A I → MennickeGroup A I)) := by
    rw [submonoid_closure_range_of]
    trivial
  refine Submonoid.closure_induction ?_ one (fun a b _ _ ha hb ↦ mul a b ha hb) hx
  rintro _ ⟨p, rfl⟩
  exact of_case p

/-- Every element of `MennickeGroup A I` is a finite product of generators `of p` (with no inverses
needed). -/
theorem exists_list_prod_of (x : MennickeGroup A I) :
    ∃ l : List (MennickePair A I), x = (l.map of).prod := by
  refine induction_on x ⟨[], by simp⟩ (fun p ↦ ⟨[p], by simp⟩) fun _ _ ⟨l₁, h₁⟩ ⟨l₂, h₂⟩ ↦
    ⟨l₁ ++ l₂, by simp [h₁, h₂]⟩

/-- Computable universal extension of a group-valued Mennicke symbol. -/
private def liftGroup {G : Type*} [Group G] (s : MennickeSymbol A I G) :
    MennickeGroup A I →* G :=
  PresentedGroup.toGroup (f := fun p ↦ s p) (rels := {r | MennickeRel A I r}) fun r hr ↦ by
    cases hr with
    | oneZero =>
      simp [FreeGroup.lift_apply_of]
    | shiftSnd p ht =>
      simp [FreeGroup.lift_apply_of]
    | shiftFst p t =>
      simp [FreeGroup.lift_apply_of]
    | mulSnd p q h =>
      simp [FreeGroup.lift_apply_of, s.map_mulSnd p q h]

private theorem liftGroup_of {G : Type*} [Group G] (s : MennickeSymbol A I G)
    (p : MennickePair A I) : liftGroup s (of p) = s p :=
  PresentedGroup.toGroup.of _

/-- Universal extension of any Mennicke symbol `s : MennickeSymbol A I C` (with values in an
arbitrary monoid `C`) to a monoid homomorphism `MennickeGroup A I →* C`. -/
noncomputable def lift (s : MennickeSymbol A I C) : MennickeGroup A I →* C :=
  (Units.coeHom C).comp (liftGroup s.toUnits)

@[simp]
theorem lift_of (s : MennickeSymbol A I C) (p : MennickePair A I) :
    lift s (of p) = s p := by
  simp [lift, liftGroup_of]

/-- Two monoid homomorphisms out of `MennickeGroup A I` into any monoid `C` are equal iff they
agree on every generator `of p`. -/
@[ext]
theorem hom_ext {φ ψ : MennickeGroup A I →* C} (h : ∀ p : MennickePair A I, φ (of p) = ψ (of p)) :
    φ = ψ := by
  ext x
  refine induction_on x ?_ h ?_
  · rw [map_one, map_one]
  · intro a b ha hb
    rw [map_mul, map_mul, ha, hb]

/-- Uniqueness of the universal extension `lift`. -/
theorem lift_unique (s : MennickeSymbol A I C) {φ : MennickeGroup A I →* C}
    (h : ∀ p : MennickePair A I, φ (of p) = s p) : φ = lift s :=
  hom_ext fun p ↦ by rw [h p, lift_of]

@[simp]
theorem lift_of_self : lift (of (A := A) (I := I)) = MonoidHom.id (MennickeGroup A I) :=
  hom_ext fun p ↦ by simp

theorem lift_comp (s : MennickeSymbol A I C) (φ : C →* D) :
    lift (s.comp φ) = φ.comp (lift s) :=
  hom_ext fun p ↦ by simp

@[simp]
theorem of_comp_lift (s : MennickeSymbol A I C) :
    (of (A := A) (I := I)).comp (lift s) = s :=
  MennickeSymbol.ext fun p ↦ by simp

/-- The universal property as an equivalence between Mennicke symbols on `(A, I)` into an arbitrary
monoid `C` and monoid homomorphisms `MennickeGroup A I →* C`. -/
noncomputable def liftEquiv : MennickeSymbol A I C ≃ (MennickeGroup A I →* C) where
  toFun := lift
  invFun φ := of.comp φ
  left_inv s := of_comp_lift s
  right_inv φ := hom_ext fun p ↦ by simp

@[simp]
theorem liftEquiv_apply (s : MennickeSymbol A I C) : liftEquiv s = lift s := (rfl)

@[simp]
theorem liftEquiv_symm_apply (φ : MennickeGroup A I →* C) : liftEquiv.symm φ = of.comp φ := (rfl)

/-! ### Functoriality in the ideal and the ring -/

/-- Canonical transition homomorphism `MennickeGroup A J →* MennickeGroup A I` induced by an ideal
inclusion `J ≤ I`. -/
def mapIdeal (hJI : J ≤ I) : MennickeGroup A J →* MennickeGroup A I :=
  liftGroup (of.comapIdeal hJI)

@[simp]
theorem mapIdeal_of (hJI : J ≤ I) (p : MennickePair A J) :
    mapIdeal hJI (of p) = of (p.mapIdeal hJI) := by
  rw [mapIdeal, liftGroup_of, MennickeSymbol.comapIdeal_apply]

@[simp]
theorem mapIdeal_id : mapIdeal (le_refl I) = MonoidHom.id (MennickeGroup A I) :=
  hom_ext fun p ↦ by simp

theorem mapIdeal_comp (hJK : J ≤ K) (hKI : K ≤ I) :
    (mapIdeal hKI).comp (mapIdeal hJK) = mapIdeal (hJK.trans hKI) :=
  hom_ext fun p ↦ by simp

@[simp]
theorem mapIdeal_mapIdeal (hJK : J ≤ K) (hKI : K ≤ I) (x : MennickeGroup A J) :
    mapIdeal hKI (mapIdeal hJK x) = mapIdeal (hJK.trans hKI) x :=
  congrArg (fun φ ↦ φ x) (mapIdeal_comp hJK hKI)

theorem lift_comapIdeal (hJI : J ≤ I) (s : MennickeSymbol A I C) :
    lift (s.comapIdeal hJI) = (lift s).comp (mapIdeal hJI) :=
  hom_ext fun p ↦ by simp

/-- Functorial pushforward `MennickeGroup A I →* MennickeGroup B J` induced by a ring
homomorphism `f : A →+* B` with `I.map f ≤ J`. -/
def map {J : Ideal B} (f : A →+* B) (hf : I.map f ≤ J) :
    MennickeGroup A I →* MennickeGroup B J :=
  liftGroup (of.comapRingHom f hf)

@[simp]
theorem map_of {J : Ideal B} (f : A →+* B) (hf : I.map f ≤ J) (p : MennickePair A I) :
    map f hf (of p) = of (p.map f hf) := by
  rw [map, liftGroup_of, MennickeSymbol.comapRingHom_apply]

@[simp]
theorem map_id : map (RingHom.id A) (by simp : I.map (RingHom.id A) ≤ I) =
    MonoidHom.id (MennickeGroup A I) :=
  hom_ext fun p ↦ by simp

theorem map_comp {E : Type*} [CommRing E] {J : Ideal B} {L : Ideal E}
    (f : A →+* B) (g : B →+* E) (hf : I.map f ≤ J) (hg : J.map g ≤ L) :
    (map g hg).comp (map f hf) =
      map (g.comp f) (by rw [← Ideal.map_map]; exact (Ideal.map_mono hf).trans hg) :=
  hom_ext fun p ↦ by simp

@[simp]
theorem map_map {E : Type*} [CommRing E] {J : Ideal B} {L : Ideal E}
    (f : A →+* B) (g : B →+* E) (hf : I.map f ≤ J) (hg : J.map g ≤ L)
    (x : MennickeGroup A I) :
    map g hg (map f hf x) =
      map (g.comp f) (by rw [← Ideal.map_map]; exact (Ideal.map_mono hf).trans hg) x :=
  congrArg (fun φ ↦ φ x) (map_comp f g hf hg)

theorem lift_comapRingHom {J : Ideal B} (f : A →+* B) (hf : I.map f ≤ J)
    (s : MennickeSymbol B J C) :
    lift (s.comapRingHom f hf) = (lift s).comp (map f hf) :=
  hom_ext fun p ↦ by simp

/-! ### Triviality cases -/

/-- At the zero ideal `I = ⊥`, the universal Mennicke group is trivial. -/
theorem eq_one_of_bot (x : MennickeGroup A ⊥) : x = 1 := by
  refine induction_on x rfl ?_ ?_
  · intro p
    rw [MennickePair.eq_oneZero_of_bot p, of.map_oneZero]
  · intro _ _ ha hb
    rw [ha, hb, mul_one]

instance subsingleton_bot : Subsingleton (MennickeGroup A ⊥) :=
  ⟨fun x y ↦ (eq_one_of_bot x).trans (eq_one_of_bot y).symm⟩

/-- Over a Euclidean domain `E`, the universal Mennicke group at `I = ⊤` is trivial. -/
theorem subsingleton_top_of_euclideanDomain {E : Type*} [EuclideanDomain E] :
    Subsingleton (MennickeGroup E ⊤) := by
  refine ⟨fun x y ↦ ?_⟩
  have h1 : ∀ z : MennickeGroup E ⊤, z = 1 := by
    intro z
    refine induction_on z rfl ?_ ?_
    · exact fun p ↦ of.map_eq_one_of_euclideanDomain p
    · intro _ _ ha hb
      rw [ha, hb, mul_one]
  exact (h1 x).trans (h1 y).symm

end MennickeGroup

end TauCeti
