/-!
# Finite generation of graded subalgebras with ideal contraction

Let `S` be a Noetherian `ℕ`-graded `k`-algebra whose degree-zero part consists of scalars, and let
`B` be a `k`-subalgebra of `S`. Suppose `B` contains the homogeneous components of its elements,
and that every ideal `J` of `B` is recovered from its extension: `J S ∩ B = J`. Then `B` is a
finitely generated `k`-algebra.

This is Hilbert's argument for the finite generation of rings of invariants. The ideal of `S`
generated by the positive-degree homogeneous elements of `B` is generated by finitely many of them,
`f₁, …, fᵣ`. A homogeneous element of `B` of positive degree `d` lies in this ideal, so by ideal
contraction it is a combination `∑ bᵢ fᵢ` with `bᵢ ∈ B`; keeping only the degree-`d` components,
the coefficients become homogeneous elements of `B` of degree smaller than `d`, and induction on
the degree shows that `B` is generated by `f₁, …, fᵣ`.

For the invariants of a linearly reductive group acting on a polynomial ring, ideal contraction is
supplied by exactness of invariants, in place of the Reynolds operator of the classical argument.

The file also compares finite generation over the coefficients `R` with finite generation over the
degree-zero part `𝒜 0`, the form in which finiteness hypotheses enter the projective spectrum.

## Main results

* `Subalgebra.fg_of_decompose_mem_of_comap_map_le`: a subalgebra closed under homogeneous
  components and with ideal contraction is finitely generated.
* `TauCeti.GradedAlgebra.exists_finset_adjoin_eq_top_and_mem_grade_ne_zero`: a finite-type
  semiring graded algebra is generated over its degree-zero part by finitely many homogeneous
  elements of nonzero degree.
* `TauCeti.GradedAlgebra.finite_grade`: every graded piece of an `ℕ`-graded algebra of finite type
  over `𝒜 0` is a finite `R`-module once `𝒜 0` is.
* `TauCeti.GradedAlgebra.finiteType_gradeZero_left`: a graded algebra of finite type over `R` is
  of finite type over its degree-zero part.
* `TauCeti.GradedAlgebra.finiteType_gradeZero`: the degree-zero part of a graded algebra of finite
  type over `R` is of finite type over `R`.
* `TauCeti.GradedAlgebra.finite_gradeZero_of_forall_mem_bot`: when `𝒜 0` consists of scalars from
  `R`, it is generated by `1` and hence finite over `R`.

## References

* D. Hilbert, *Über die Theorie der algebraischen Formen*, Math. Ann. **36** (1890).
* S. Mukai, *An Introduction to Invariants and Moduli*, Cambridge University Press (2003),
  Theorem 4.51.
* [The Stacks Project, Lemma 10.58.5 (00JV)](https://stacks.math.columbia.edu/tag/00JV)
-/

public section

open DirectSum

namespace Subalgebra

variable {k S : Type*} [CommSemiring k] [CommSemiring S] [Algebra k S] [IsNoetherianRing S]
  (𝒜 : ℕ → Submodule k S) [GradedAlgebra 𝒜]

/-- **Hilbert's finiteness argument.** In a Noetherian `ℕ`-graded algebra whose degree-zero part
consists of scalars, a subalgebra containing the homogeneous components of its elements, and
recovering each of its ideals from the ideal it generates, is finitely generated. -/
theorem fg_of_decompose_mem_of_comap_map_le (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k S))
    (B : Subalgebra k S) (hBdecompose : ∀ x ∈ B, ∀ n, (decompose 𝒜 x n : S) ∈ B)
    (hBideal : ∀ J : Ideal B, (J.map (algebraMap B S)).comap (algebraMap B S) ≤ J) :
    B.FG := by
  classical
  -- Finitely many positive-degree homogeneous elements of `B` generate the ideal of `S` generated
  -- by all of them.
  let G : Set S := {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}
  obtain ⟨t, htG, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset G).1
    (IsNoetherian.noetherian (Ideal.span G))
  have htB (g : S) (hg : g ∈ t) : g ∈ B := (htG hg).1
  choose! deg hdeg using fun g (hg : g ∈ t) ↦ (htG hg).2
  -- The contraction of the ideal generated by `t`.
  let J : Ideal B := Ideal.span ((↑) ⁻¹' (t : Set S))
  have hJ : J.map (algebraMap B S) = Ideal.span (t : Set S) := by
    rw [Ideal.map_span]
    congr 1
    ext x
    exact ⟨fun ⟨_, hy, hyx⟩ ↦ hyx ▸ hy, fun hx ↦ ⟨⟨x, htB x hx⟩, hx, rfl⟩⟩
  -- Every homogeneous element of `B` lies in the subalgebra generated by `t`.
  have key (d : ℕ) : ∀ x ∈ B, x ∈ 𝒜 d → x ∈ Algebra.adjoin k (t : Set S) := by
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro x hxB hxd
    rcases Nat.eq_zero_or_pos d with rfl | hd
    · exact (bot_le : (⊥ : Subalgebra k S) ≤ _) (h𝒜 x hxd)
    have hxJ : (⟨x, hxB⟩ : B) ∈ J := hBideal J (by
      rw [Ideal.mem_comap, hJ]
      exact (hspan ▸ Ideal.subset_span ⟨hxB, d, hd, hxd⟩ : x ∈ Submodule.span S (t : Set S)))
    obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.1 hxJ
    have hx : x = ∑ i, (c i : S) * ((g i : B) : S) := by
      simpa using (congrArg Subtype.val hcg).symm
    -- Keep only the degree-`d` component of `∑ cᵢ gᵢ`.
    rw [← decompose_of_mem_same 𝒜 hxd, ← GradedAlgebra.proj_apply, hx, map_sum]
    refine Subalgebra.sum_mem _ fun i _ ↦ ?_
    have hgt : ((g i : B) : S) ∈ t := (g i).2
    obtain ⟨hpos, hmem⟩ := hdeg _ hgt
    rw [GradedAlgebra.proj_apply, coe_decompose_mul_of_right_mem 𝒜 d hmem]
    split_ifs with hle
    · exact Subalgebra.mul_mem _
        (ih _ (by omega) _ (hBdecompose _ (c i).2 _) (SetLike.coe_mem _))
        (Algebra.subset_adjoin hgt)
    · exact Subalgebra.zero_mem _
  refine Subalgebra.fg_def.2 ⟨t, t.finite_toSet,
    le_antisymm (Algebra.adjoin_le fun g hg ↦ htB g hg) fun x hx ↦ ?_⟩
  rw [← sum_support_decompose 𝒜 x]
  exact Subalgebra.sum_mem _ fun n _ ↦ key n _ (hBdecompose x hx n) (SetLike.coe_mem _)

end Subalgebra

namespace TauCeti.GradedAlgebra

/-- A word in homogeneous elements `s` is either `1` or begins with an element of `s` multiplying a
homogeneous element. -/
private theorem eq_one_or_exists_mul_of_mem_closure {R A : Type*} [Semiring R] [Semiring A]
    [Module R A] (𝒜 : ℕ → Submodule R A) [SetLike.GradedMonoid 𝒜] {s : Finset A} (deg : s → ℕ)
    (hmem : ∀ g : s, (g : A) ∈ 𝒜 (deg g)) {m : A}
    (hm : m ∈ Submonoid.closure (s : Set A)) :
    m = 1 ∨ ∃ (g : s) (d : ℕ), ∃ y ∈ 𝒜 d, m = (g : A) * y := by
  induction hm using Submonoid.closure_induction with
  | mem x hx =>
    exact Or.inr ⟨⟨x, hx⟩, 0, 1, SetLike.GradedOne.one_mem, (mul_one x).symm⟩
  | one => exact Or.inl rfl
  | mul u v _ _ ihu ihv =>
    rcases ihu with rfl | ⟨g, d₁, y₁, hy₁, rfl⟩
    · simpa only [one_mul] using ihv
    · rcases ihv with rfl | ⟨g₂, d₂, y₂, hy₂, rfl⟩
      · exact Or.inr ⟨g, d₁, y₁, hy₁, mul_one _⟩
      · exact Or.inr ⟨g, d₁ + (deg g₂ + d₂), y₁ * ((g₂ : A) * y₂),
          SetLike.GradedMul.mul_mem hy₁ (SetLike.GradedMul.mul_mem (hmem g₂) hy₂),
          mul_assoc _ _ _⟩

section Nat

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- A graded algebra of finite type over `𝒜 0` is generated over `𝒜 0` by finitely many
homogeneous elements of positive degree. This is the semiring version of Mathlib's
`GradedAlgebra.exists_finset_adjoin_eq_top_and_homogeneous_ne_zero`, which is stated for rings. -/
theorem exists_finset_adjoin_eq_top_and_mem_grade_ne_zero [Algebra.FiniteType (𝒜 0) A] :
    ∃ s : Finset A, Algebra.adjoin (𝒜 0) (s : Set A) = ⊤ ∧ ∀ x ∈ s, ∃ n ≠ 0, x ∈ 𝒜 n := by
  classical
  -- As in the ring proof, take the nonzero-degree homogeneous components of finite generators.
  obtain ⟨F, hF⟩ := Algebra.FiniteType.out (R := 𝒜 0) (A := A)
  refine ⟨F.biUnion fun f ↦ ((decompose 𝒜 f).support.filter (· ≠ 0)).image
    fun n ↦ (decompose 𝒜 f n : A), ?_, ?_⟩
  · rw [← top_le_iff, ← hF, Algebra.adjoin_le_iff]
    intro f hf
    rw [← sum_support_decompose 𝒜 f]
    refine sum_mem fun n hn ↦ ?_
    by_cases hn0 : n = 0
    · subst hn0
      exact Subalgebra.algebraMap_mem _ (decompose 𝒜 f 0)
    · exact Algebra.subset_adjoin
        (by simpa using ⟨f, hf, n, ⟨DFinsupp.mem_support_iff.mp hn, hn0⟩, rfl⟩)
  · simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter]
    rintro _ ⟨f, -, n, ⟨-, hn0⟩, rfl⟩
    exact ⟨n, hn0, (decompose 𝒜 f n).2⟩

/-- Every graded piece of an `ℕ`-graded algebra of finite type over `𝒜 0` is a finite `R`-module
once `𝒜 0` is finite over `R`. Combined with `finiteType_gradeZero_left`, this applies whenever `A`
is of finite type over `R` and `𝒜 0` is finite over `R`, with no Noetherian assumption on `R`. -/
theorem finite_grade [Algebra.FiniteType (𝒜 0) A] [Module.Finite R (𝒜 0)] (n : ℕ) :
    Module.Finite R (𝒜 n) := by
  classical
  obtain ⟨s, htop, hdeg⟩ := exists_finset_adjoin_eq_top_and_mem_grade_ne_zero 𝒜
  choose deg hne hmem using fun g : s ↦ hdeg g.1 g.2
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · infer_instance
  let C : Submodule R A :=
    ⨆ g : {g : s // deg g ≤ n}, (𝒜 (n - deg g.1)).map (LinearMap.mulLeft R (g.1 : A))
  have hC_le : C ≤ 𝒜 n := iSup_le fun g ↦ Submodule.map_le_iff_le_comap.2 fun y hy ↦ by
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply]
    simpa only [Nat.add_sub_of_le g.2] using SetLike.GradedMul.mul_mem (hmem g.1) hy
  have hle_C : 𝒜 n ≤ C := fun x hx ↦ by
    have hx' : x ∈ Submodule.span (𝒜 0) (Submonoid.closure (s : Set A) : Set A) := by
      rw [← Algebra.adjoin_eq_span, htop]
      trivial
    rw [← decompose_of_mem_same 𝒜 hx]
    clear hx
    induction hx' using Submodule.span_induction with
    | mem m hm =>
      rcases eq_one_or_exists_mul_of_mem_closure 𝒜 deg hmem hm with rfl | ⟨g, d, y, hy, rfl⟩
      · rw [decompose_of_mem_ne 𝒜 SetLike.GradedOne.one_mem hn.ne]
        exact C.zero_mem
      · have hgy : (g : A) * y ∈ 𝒜 (deg g + d) := SetLike.GradedMul.mul_mem (hmem g) hy
        by_cases hdn : deg g + d = n
        · have hd : n - deg g = d := by omega
          rw [decompose_of_mem_same 𝒜 (hdn ▸ hgy)]
          exact Submodule.mem_iSup_of_mem ⟨g, by omega⟩
            (Submodule.mem_map.2 ⟨y, hd ▸ hy, rfl⟩)
        · rw [decompose_of_mem_ne 𝒜 hgy hdn]
          exact C.zero_mem
    | zero => simp
    | add u v _ _ hu hv =>
      rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
      exact C.add_mem hu hv
    | smul c u _ hu =>
      rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply,
        coe_decompose_mul_of_left_mem_zero 𝒜 c.2]
      refine Submodule.iSup_induction _ (motive := fun z ↦ (c : A) * z ∈ C) hu
        (fun g z hz ↦ ?_) (by simp) fun z₁ z₂ h₁ h₂ ↦ by simpa only [mul_add] using C.add_mem h₁ h₂
      obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.1 hz
      refine Submodule.mem_iSup_of_mem g
        (Submodule.mem_map.2 ⟨(c : A) * y, ?_, by simp [mul_left_comm]⟩)
      simpa only [zero_add] using SetLike.GradedMul.mul_mem c.2 hy
  rw [Module.Finite.iff_fg, le_antisymm hle_C hC_le]
  exact Submodule.fg_iSup _ fun g ↦
    (Module.Finite.iff_fg.1 <|
      ih (n - deg g.1) (Nat.sub_lt hn (Nat.pos_of_ne_zero (hne g.1)))).map _

end Nat

section GradeZero

variable {R A ι : Type*} [DecidableEq ι] [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ι → Submodule R A)

/-- A graded algebra of finite type over `R` is of finite type over its degree-zero part. -/
instance finiteType_gradeZero_left [AddMonoid ι] [GradedAlgebra 𝒜] [Algebra.FiniteType R A] :
    Algebra.FiniteType (𝒜 0) A :=
  .of_restrictScalars_finiteType R (𝒜 0) A

/-- The degree-zero part of a graded algebra of finite type over `R` is of finite type over `R`:
it is the image of the algebra under the projection `a ↦ a₀`, which is an `R`-algebra
homomorphism because the scalars have degree zero. -/
instance finiteType_gradeZero [AddCommMonoid ι] [PartialOrder ι] [CanonicallyOrderedAdd ι]
    [GradedAlgebra 𝒜] [Algebra.FiniteType R A] : Algebra.FiniteType R (𝒜 0) :=
  .of_surjective
    { GradedRing.projZeroRingHom' 𝒜 with
      commutes' r := Subtype.ext <| decompose_of_mem_same 𝒜 (SetLike.algebraMap_mem_graded 𝒜 r) }
    (GradedRing.projZeroRingHom'_surjective 𝒜)

omit [DecidableEq ι] [CommSemiring A] in
/-- When the degree-zero piece consists of scalars from `R`, it is spanned over `R` by `1` and is
therefore a finite `R`-module. Commutativity of `A` is not required. -/
theorem finite_gradeZero_of_forall_mem_bot {A : Type*} [Semiring A] [Algebra R A]
    (𝒜 : ι → Submodule R A) [Zero ι] [SetLike.GradedOne 𝒜]
    (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A)) : Module.Finite R (𝒜 0) := by
  have hspan : 𝒜 0 = Submodule.span R {(1 : A)} := by
    refine le_antisymm (fun x hx ↦ ?_)
      ((Submodule.span_singleton_le_iff_mem (1 : A) (𝒜 0)).2 SetLike.GradedOne.one_mem)
    obtain ⟨r, rfl⟩ := Algebra.mem_bot.1 (h𝒜 x hx)
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (Submodule.subset_span rfl)
  rw [Module.Finite.iff_fg, hspan]
  exact Submodule.fg_span_singleton 1

end GradeZero

end TauCeti.GradedAlgebra
