/-!
# Symbol presentation of algebraic differential forms

For a commutative `A`-algebra `B`, the module of algebraic `n`-forms `DeRham.Forms A B n` is the
`n`th exterior power `⋀[B]^n Ω[B⁄A]` of the Kähler differentials, viewed both as a `B`-module and,
by restriction of scalars along `A → B`, as an `A`-module. Because the exterior derivative `d`
differentiates `B`-coefficients and is only `A`-linear, constructing maps out of `Forms A B n`
directly over `A` requires an explicit presentation of `Forms A B n` as an `A`-module.

This file presents `Forms A B n` as the quotient of the free `A`-module `DeRham.Symbols A B n` on
formal differential symbols `[c; v₀, …, vₙ₋₁]` (`c ∈ B`, `v : Fin n → B`) by the `A`-submodule
`DeRham.symbolRelations A B n` generated by six relation families:

1. additivity in the coefficient `c`;
2. `A`-linearity in the coefficient `c`;
3. additivity in each differential slot `vᵢ`;
4. the Leibniz rule `[c; … x * y …] = [c * x; … y …] + [c * y; … x …]` in each slot `vᵢ`;
5. vanishing when any slot `vᵢ` lies in the image of `algebraMap A B`;
6. strict alternation `[c; v] = 0` whenever `vᵢ = vⱼ` for `i ≠ j`.

The evaluation map `DeRham.symbolMap A B n` sends `[c; v]` to the elementary form
`c • (D v₀ ∧ ⋯ ∧ D vₙ₋₁)`. We prove that `symbolMap A B n` is surjective in every degree `n ≥ 0`
(`DeRham.symbolMap_surjective`) and that its kernel is `symbolRelations A B n`
(`DeRham.symbolRelations_ker`), including in degree zero and in characteristic two.

## Main definitions

* `TauCeti.DeRham.Forms A B n`: algebraic `n`-forms `⋀[B]^n Ω[B⁄A]`.
* `TauCeti.DeRham.zeroForm A B`, `TauCeti.DeRham.oneForm A B`: canonical `B`-linear equivalences
  `B ≃ₗ[B] Forms A B 0` and `Ω[B⁄A] ≃ₗ[B] Forms A B 1`.
* `TauCeti.DeRham.wedge A B`: the exterior product `Forms A B m → Forms A B n → Forms A B (m + n)`.
* `TauCeti.DeRham.elementary A B n c v`: the elementary `n`-form `c • (D v₀ ∧ ⋯ ∧ D vₙ₋₁)`.
* `TauCeti.DeRham.Symbols A B n`, `TauCeti.DeRham.sym A B n c v`: free `A`-module of formal
  differential symbols and its basis generators.
* `TauCeti.DeRham.symbolRelations A B n`: the `A`-submodule of defining relations among formal
  differential symbols.
* `TauCeti.DeRham.symbolMap A B n`: the `A`-linear evaluation map `Symbols A B n →ₗ[A] Forms A B n`.
* `TauCeti.DeRham.quotSymbolRelationsEquiv A B n`: the induced `A`-linear equivalence
  `(Symbols A B n ⧸ symbolRelations A B n) ≃ₗ[A] Forms A B n`.

## Main results

* `TauCeti.DeRham.symbolRelations_le_iff`: characterization of submodules containing
  `symbolRelations A B n` by the six defining relation families.
* `TauCeti.DeRham.symbolMap_surjective`: differential symbols span all forms over `A`.
* `TauCeti.DeRham.symbolRelations_ker`: `LinearMap.ker (symbolMap A B n) = symbolRelations A B n`.

## References

* [The Stacks Project, *The de Rham complex*, Section 10.132 (Tag 0FKF)](https://stacks.math.columbia.edu/tag/0FKF).
* Mathlib's Kähler differential presentation (`Mathlib.RingTheory.Kaehler.Basic`, by Nicolò
  Cavalleri and Andrew Yang) and exterior-power universal property
  (`Mathlib.LinearAlgebra.ExteriorPower.Basic`, by Sophie Morel and Joël Riou).
-/

public section

noncomputable section

open KaehlerDifferential

namespace TauCeti.DeRham

universe u v

section Carriers

variable (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]

/-- Algebraic `n`-forms of `B` over `A`, defined as the `n`th exterior power `⋀[B]^n Ω[B⁄A]` of
the module of Kähler differentials. It carries both its native `B`-module structure and the
restricted `A`-module structure via `IsScalarTower A B (Forms A B n)`. -/
abbrev Forms (n : ℕ) : Type v :=
  ⋀[B]^n Ω[B⁄A]

variable {A B} in
/-- Canonical `B`-linear equivalence between forms in propositionally equal degrees. -/
def Forms.cast {m n : ℕ} (h : m = n) : Forms A B m ≃ₗ[B] Forms A B n :=
  LinearEquiv.ofEq _ _ (congrArg (fun k ↦ ⋀[B]^k Ω[B⁄A]) h)

@[simp]
theorem Forms.coe_cast {m n : ℕ} (h : m = n) (ω : Forms A B m) :
    (Forms.cast h ω : _root_.ExteriorAlgebra B Ω[B⁄A]) = ω.1 := by
  subst h
  rfl

@[simp]
theorem Forms.cast_rfl {n : ℕ} (ω : Forms A B n) : Forms.cast rfl ω = ω :=
  (rfl)

@[simp]
theorem Forms.cast_trans {k m n : ℕ} (h₁ : k = m) (h₂ : m = n) (ω : Forms A B k) :
    Forms.cast h₂ (Forms.cast h₁ ω) = Forms.cast (h₁.trans h₂) ω := by
  subst h₁ h₂
  rfl

/-- Canonical `B`-linear equivalence `B ≃ₗ[B] Forms A B 0` identifying elements of `B` with
degree-zero differential forms. -/
def zeroForm : B ≃ₗ[B] Forms A B 0 :=
  (exteriorPower.zeroEquiv B Ω[B⁄A]).symm

@[simp]
theorem zeroEquiv_zeroForm (b : B) :
    exteriorPower.zeroEquiv B Ω[B⁄A] (zeroForm A B b) = b :=
  (exteriorPower.zeroEquiv B Ω[B⁄A]).apply_symm_apply b

@[simp]
theorem zeroForm_zeroEquiv (ω : Forms A B 0) :
    zeroForm A B (exteriorPower.zeroEquiv B Ω[B⁄A] ω) = ω :=
  (exteriorPower.zeroEquiv B Ω[B⁄A]).symm_apply_apply ω

@[simp]
theorem coe_zeroForm (b : B) :
    (zeroForm A B b : _root_.ExteriorAlgebra B Ω[B⁄A]) =
      algebraMap B (_root_.ExteriorAlgebra B Ω[B⁄A]) b := by
  simp [zeroForm, exteriorPower.zeroEquiv_symm_apply, Algebra.algebraMap_eq_smul_one]

/-- Canonical `B`-linear equivalence `Ω[B⁄A] ≃ₗ[B] Forms A B 1` identifying Kähler differentials
with degree-one differential forms. -/
def oneForm : Ω[B⁄A] ≃ₗ[B] Forms A B 1 :=
  (exteriorPower.oneEquiv B Ω[B⁄A]).symm

@[simp]
theorem oneEquiv_oneForm (ω : Ω[B⁄A]) :
    exteriorPower.oneEquiv B Ω[B⁄A] (oneForm A B ω) = ω :=
  (exteriorPower.oneEquiv B Ω[B⁄A]).apply_symm_apply ω

@[simp]
theorem oneForm_oneEquiv (ω : Forms A B 1) :
    oneForm A B (exteriorPower.oneEquiv B Ω[B⁄A] ω) = ω :=
  (exteriorPower.oneEquiv B Ω[B⁄A]).symm_apply_apply ω

@[simp]
theorem coe_oneForm (ω : Ω[B⁄A]) :
    (oneForm A B ω : _root_.ExteriorAlgebra B Ω[B⁄A]) = _root_.ExteriorAlgebra.ι B ω := by
  simp [oneForm, exteriorPower.oneEquiv_symm_apply, _root_.ExteriorAlgebra.ιMulti_apply]

/-- The exterior wedge product `Forms A B m → Forms A B n → Forms A B (m + n)` induced by the
graded multiplication of the exterior algebra. -/
def wedge {m n : ℕ} (α : Forms A B m) (β : Forms A B n) : Forms A B (m + n) :=
  exteriorPower.wedge B Ω[B⁄A] m n α β

theorem wedge_def {m n : ℕ} (α : Forms A B m) (β : Forms A B n) :
    wedge A B α β = exteriorPower.wedge B Ω[B⁄A] m n α β :=
  (rfl)

@[simp]
theorem coe_wedge {m n : ℕ} (α : Forms A B m) (β : Forms A B n) :
    (wedge A B α β : _root_.ExteriorAlgebra B Ω[B⁄A]) = α.1 * β.1 :=
  (rfl)

@[simp]
theorem wedge_zero_left {m n : ℕ} (β : Forms A B n) :
    wedge A B (0 : Forms A B m) β = 0 :=
  Subtype.ext (by simp)

@[simp]
theorem wedge_zero_right {m n : ℕ} (α : Forms A B m) :
    wedge A B α (0 : Forms A B n) = 0 :=
  Subtype.ext (by simp)

theorem wedge_add_left {m n : ℕ} (α₁ α₂ : Forms A B m) (β : Forms A B n) :
    wedge A B (α₁ + α₂) β = wedge A B α₁ β + wedge A B α₂ β :=
  Subtype.ext (by simp [add_mul])

theorem wedge_add_right {m n : ℕ} (α : Forms A B m) (β₁ β₂ : Forms A B n) :
    wedge A B α (β₁ + β₂) = wedge A B α β₁ + wedge A B α β₂ :=
  Subtype.ext (by simp [mul_add])

theorem wedge_smul_left {m n : ℕ} (b : B) (α : Forms A B m) (β : Forms A B n) :
    wedge A B (b • α) β = b • wedge A B α β :=
  Subtype.ext (by simp)

theorem wedge_smul_right {m n : ℕ} (b : B) (α : Forms A B m) (β : Forms A B n) :
    wedge A B α (b • β) = b • wedge A B α β :=
  Subtype.ext (by simp)

theorem wedge_base_smul_left {m n : ℕ} (a : A) (α : Forms A B m) (β : Forms A B n) :
    wedge A B (a • α) β = a • wedge A B α β := by
  rw [← IsScalarTower.algebraMap_smul B a α, wedge_smul_left, IsScalarTower.algebraMap_smul]

theorem wedge_base_smul_right {m n : ℕ} (a : A) (α : Forms A B m) (β : Forms A B n) :
    wedge A B α (a • β) = a • wedge A B α β := by
  rw [← IsScalarTower.algebraMap_smul B a β, wedge_smul_right, IsScalarTower.algebraMap_smul]

/-- Wedging on the left with a degree-zero form scales by the corresponding element of `B`. -/
theorem coe_wedge_zeroForm_left {n : ℕ} (b : B) (ω : Forms A B n) :
    (wedge A B (zeroForm A B b) ω : _root_.ExteriorAlgebra B Ω[B⁄A]) = b • ω.1 := by
  rw [coe_wedge, coe_zeroForm, ← Algebra.smul_def]

@[simp]
theorem wedge_zeroForm_left {n : ℕ} (b : B) (ω : Forms A B n) :
    Forms.cast (Nat.zero_add n) (wedge A B (zeroForm A B b) ω) = b • ω :=
  Subtype.ext <| by rw [Forms.coe_cast, coe_wedge_zeroForm_left, SetLike.val_smul]

/-- Graded commutativity of the wedge product: an `m`-form and an `n`-form commute up to
`(-1) ^ (n * m)`. -/
theorem wedge_comm {m n : ℕ} (α : Forms A B m) (β : Forms A B n) :
    wedge A B α β = Forms.cast (Nat.add_comm n m) ((-1 : B) ^ (n * m) • wedge A B β α) :=
  Subtype.ext <| by
    rw [coe_wedge, Forms.coe_cast, SetLike.val_smul, coe_wedge]
    exact TauCeti.ExteriorAlgebra.mul_eq_neg_one_pow_smul_mul_of_mem α.2 β.2

/-- The elementary algebraic `n`-form `c • (D v₀ ∧ ⋯ ∧ D vₙ₋₁)` attached to a coefficient `c ∈ B`
and a tuple `v : Fin n → B`. -/
def elementary (n : ℕ) (c : B) (v : Fin n → B) : Forms A B n :=
  c • exteriorPower.ιMulti B n (D A B ∘ v)

theorem elementary_def (n : ℕ) (c : B) (v : Fin n → B) :
    elementary A B n c v = c • exteriorPower.ιMulti B n (D A B ∘ v) :=
  (rfl)

@[simp]
theorem elementary_zero_coeff (n : ℕ) (v : Fin n → B) :
    elementary A B n 0 v = 0 :=
  zero_smul B _

theorem elementary_add_coeff (n : ℕ) (c e : B) (v : Fin n → B) :
    elementary A B n (c + e) v = elementary A B n c v + elementary A B n e v :=
  add_smul c e _

theorem elementary_smul_coeff (n : ℕ) (b c : B) (v : Fin n → B) :
    elementary A B n (b * c) v = b • elementary A B n c v :=
  mul_smul b c _

theorem elementary_base_smul_coeff (n : ℕ) (a : A) (c : B) (v : Fin n → B) :
    elementary A B n (a • c) v = a • elementary A B n c v :=
  IsScalarTower.smul_assoc a c _

@[simp]
theorem elementary_zero_deg (c : B) (v : Fin 0 → B) :
    elementary A B 0 c v = zeroForm A B c := by
  apply (exteriorPower.zeroEquiv B Ω[B⁄A]).injective
  simp [elementary_def]

theorem elementary_one_deg (c : B) (v : Fin 1 → B) :
    elementary A B 1 c v = oneForm A B (c • D A B (v 0)) := by
  apply (exteriorPower.oneEquiv B Ω[B⁄A]).injective
  simp [elementary_def]

/-- An elementary form with a repeated entry in distinct slots vanishes in every characteristic. -/
theorem elementary_eq_zero_of_eq {n : ℕ} (c : B) {v : Fin n → B} {i j : Fin n}
    (hij : i ≠ j) (hv : v i = v j) : elementary A B n c v = 0 := by
  rw [elementary_def, (exteriorPower.ιMulti B n).map_eq_zero_of_eq _ (congrArg (D A B) hv) hij,
    smul_zero]

/-- The wedge product of two elementary forms concatenates their tuples and multiplies their
coefficients. -/
theorem wedge_elementary {m n : ℕ} (c e : B) (u : Fin m → B) (v : Fin n → B) :
    wedge A B (elementary A B m c u) (elementary A B n e v) =
      elementary A B (m + n) (c * e) (Fin.append u v) := by
  have happ : Fin.append (D A B ∘ u) (D A B ∘ v) = D A B ∘ Fin.append u v := by
    ext i
    exact Fin.addCases (fun _ ↦ by simp) (fun _ ↦ by simp) i
  rw [elementary_def, elementary_def, elementary_def, wedge_smul_left, wedge_smul_right,
    mul_smul, wedge_def, exteriorPower.wedge_ιMulti, happ]

end Carriers

/-! ### Differential symbols and their relations -/

section Presentation

variable (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]

/-- The free `A`-module on formal differential symbols `(c, v) ∈ B × (Fin n → B)`. -/
abbrev Symbols (n : ℕ) : Type (max u v) :=
  (B × (Fin n → B)) →₀ A

/-- The basis symbol `[c; v]` in `Symbols A B n` with unit coefficient in `A`. -/
def sym (n : ℕ) (c : B) (v : Fin n → B) : Symbols A B n :=
  Finsupp.single (c, v) 1

omit [CommRing B] [Algebra A B] in
theorem sym_def (n : ℕ) (c : B) (v : Fin n → B) :
    sym A B n c v = Finsupp.single (c, v) 1 :=
  (rfl)

omit [CommRing B] [Algebra A B] in
theorem smul_sym (n : ℕ) (a : A) (c : B) (v : Fin n → B) :
    a • sym A B n c v = Finsupp.single (c, v) a :=
  Finsupp.smul_single_one (c, v) a

/-- The six generating families of relations among formal differential symbols in degree `n`:
coefficient additivity, coefficient `A`-linearity, slot additivity, the slot Leibniz rule,
vanishing on `A`-scalars in any slot, and strict alternation when two distinct slots coincide. -/
private def relationSet (n : ℕ) : Set (Symbols A B n) :=
  (Set.range fun p : B × B × (Fin n → B) ↦
      sym A B n (p.1 + p.2.1) p.2.2 - sym A B n p.1 p.2.2 - sym A B n p.2.1 p.2.2) ∪
  (Set.range fun p : A × B × (Fin n → B) ↦
      sym A B n (p.1 • p.2.1) p.2.2 - p.1 • sym A B n p.2.1 p.2.2) ∪
  (Set.range fun p : B × (Fin n → B) × Fin n × B × B ↦
      sym A B n p.1 (Function.update p.2.1 p.2.2.1 (p.2.2.2.1 + p.2.2.2.2)) -
        sym A B n p.1 (Function.update p.2.1 p.2.2.1 p.2.2.2.1) -
        sym A B n p.1 (Function.update p.2.1 p.2.2.1 p.2.2.2.2)) ∪
  (Set.range fun p : B × (Fin n → B) × Fin n × B × B ↦
      sym A B n p.1 (Function.update p.2.1 p.2.2.1 (p.2.2.2.1 * p.2.2.2.2)) -
        sym A B n (p.1 * p.2.2.2.1) (Function.update p.2.1 p.2.2.1 p.2.2.2.2) -
        sym A B n (p.1 * p.2.2.2.2) (Function.update p.2.1 p.2.2.1 p.2.2.2.1)) ∪
  (Set.range fun p : B × (Fin n → B) × Fin n × A ↦
      sym A B n p.1 (Function.update p.2.1 p.2.2.1 (algebraMap A B p.2.2.2))) ∪
  { s | ∃ (c : B) (v : Fin n → B) (i j : Fin n), i ≠ j ∧ v i = v j ∧ s = sym A B n c v }

/-- The `A`-submodule of `Symbols A B n` spanned by the six defining relation families among formal
differential symbols. -/
def symbolRelations (n : ℕ) : Submodule A (Symbols A B n) :=
  Submodule.span A (relationSet A B n)

private theorem symbolRelations_eq_span (n : ℕ) :
    symbolRelations A B n = Submodule.span A (relationSet A B n) :=
  (rfl)

variable {A B}

/-- Coefficient additivity `[c + e; v] - [c; v] - [e; v]` belongs to `symbolRelations`. -/
theorem symbolRelations_coeff_add {n : ℕ} (c e : B) (v : Fin n → B) :
    sym A B n (c + e) v - sym A B n c v - sym A B n e v ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inl <| Or.inl <| Or.inl <| Or.inl <| Or.inl ⟨(c, e, v), rfl⟩

/-- Coefficient `A`-linearity `[a • c; v] - a • [c; v]` belongs to `symbolRelations`. -/
theorem symbolRelations_coeff_smul {n : ℕ} (a : A) (c : B) (v : Fin n → B) :
    sym A B n (a • c) v - a • sym A B n c v ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inl <| Or.inl <| Or.inl <| Or.inl <| Or.inr ⟨(a, c, v), rfl⟩

/-- A symbol with zero coefficient belongs to `symbolRelations`. -/
theorem symbolRelations_coeff_zero {n : ℕ} (v : Fin n → B) :
    sym A B n 0 v ∈ symbolRelations A B n := by
  simpa using symbolRelations_coeff_smul (A := A) (B := B) (0 : A) 0 v

/-- Slot additivity belongs to `symbolRelations` for every slot `i`. -/
theorem symbolRelations_slot_add {n : ℕ} (c : B) (v : Fin n → B) (i : Fin n) (x y : B) :
    sym A B n c (Function.update v i (x + y)) -
        sym A B n c (Function.update v i x) -
        sym A B n c (Function.update v i y) ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inl <| Or.inl <| Or.inl <| Or.inr ⟨(c, v, i, x, y), rfl⟩

/-- The slot Leibniz relation belongs to `symbolRelations` for every slot `i`. -/
theorem symbolRelations_slot_mul {n : ℕ} (c : B) (v : Fin n → B) (i : Fin n) (x y : B) :
    sym A B n c (Function.update v i (x * y)) -
        sym A B n (c * x) (Function.update v i y) -
        sym A B n (c * y) (Function.update v i x) ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inl <| Or.inl <| Or.inr ⟨(c, v, i, x, y), rfl⟩

/-- Filling any slot `i` with an element from the base ring `A` yields a symbol in
`symbolRelations`. -/
theorem symbolRelations_slot_algebraMap {n : ℕ} (c : B) (v : Fin n → B) (i : Fin n) (a : A) :
    sym A B n c (Function.update v i (algebraMap A B a)) ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inl <| Or.inr ⟨(c, v, i, a), rfl⟩

/-- Any symbol with a repeated entry in two distinct slots belongs to `symbolRelations`. -/
theorem symbolRelations_alt {n : ℕ} (c : B) {v : Fin n → B} {i j : Fin n}
    (hij : i ≠ j) (hv : v i = v j) : sym A B n c v ∈ symbolRelations A B n :=
  Submodule.subset_span <| Or.inr ⟨c, v, i, j, hij, hv, rfl⟩

/-- An `A`-submodule of `Symbols A B n` contains `symbolRelations A B n` if and only if it contains
all six families of defining relations. -/
theorem symbolRelations_le_iff {n : ℕ} {P : Submodule A (Symbols A B n)} :
    symbolRelations A B n ≤ P ↔
      (∀ (c e : B) (v : Fin n → B),
        sym A B n (c + e) v - sym A B n c v - sym A B n e v ∈ P) ∧
      (∀ (a : A) (c : B) (v : Fin n → B),
        sym A B n (a • c) v - a • sym A B n c v ∈ P) ∧
      (∀ (c : B) (v : Fin n → B) (i : Fin n) (x y : B),
        sym A B n c (Function.update v i (x + y)) -
          sym A B n c (Function.update v i x) -
          sym A B n c (Function.update v i y) ∈ P) ∧
      (∀ (c : B) (v : Fin n → B) (i : Fin n) (x y : B),
        sym A B n c (Function.update v i (x * y)) -
          sym A B n (c * x) (Function.update v i y) -
          sym A B n (c * y) (Function.update v i x) ∈ P) ∧
      (∀ (c : B) (v : Fin n → B) (i : Fin n) (a : A),
        sym A B n c (Function.update v i (algebraMap A B a)) ∈ P) ∧
      (∀ (c : B) {v : Fin n → B} {i j : Fin n},
        i ≠ j → v i = v j → sym A B n c v ∈ P) := by
  constructor
  · intro h
    exact ⟨fun c e v ↦ h (symbolRelations_coeff_add c e v),
      fun a c v ↦ h (symbolRelations_coeff_smul a c v),
      fun c v i x y ↦ h (symbolRelations_slot_add c v i x y),
      fun c v i x y ↦ h (symbolRelations_slot_mul c v i x y),
      fun c v i a ↦ h (symbolRelations_slot_algebraMap c v i a),
      fun c _ _ _ hij hv ↦ h (symbolRelations_alt c hij hv)⟩
  · rintro ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩
    rw [symbolRelations_eq_span, Submodule.span_le]
    rintro s (((((⟨⟨c, e, v⟩, rfl⟩ | ⟨⟨a, c, v⟩, rfl⟩) | ⟨⟨c, v, i, x, y⟩, rfl⟩) |
        ⟨⟨c, v, i, x, y⟩, rfl⟩) | ⟨⟨c, v, i, a⟩, rfl⟩) | ⟨c, v, i, j, hij, hv, rfl⟩)
    · exact h₁ c e v
    · exact h₂ a c v
    · exact h₃ c v i x y
    · exact h₄ c v i x y
    · exact h₅ c v i a
    · exact h₆ c hij hv

/-! ### Evaluation of differential symbols -/

variable (A B) in
/-- The `A`-linear evaluation map `Symbols A B n →ₗ[A] Forms A B n` sending `[c; v]` to the
elementary form `c • (D v₀ ∧ ⋯ ∧ D vₙ₋₁)`. -/
def symbolMap (n : ℕ) : Symbols A B n →ₗ[A] Forms A B n :=
  Finsupp.linearCombination A fun p : B × (Fin n → B) ↦ elementary A B n p.1 p.2

@[simp]
theorem symbolMap_single (n : ℕ) (c : B) (v : Fin n → B) (a : A) :
    symbolMap A B n (Finsupp.single (c, v) a) = a • elementary A B n c v := by
  simp [symbolMap]

@[simp]
theorem symbolMap_sym (n : ℕ) (c : B) (v : Fin n → B) :
    symbolMap A B n (sym A B n c v) = elementary A B n c v := by
  rw [sym_def, symbolMap_single, one_smul]

theorem symbolMap_add (n : ℕ) (s t : Symbols A B n) :
    symbolMap A B n (s + t) = symbolMap A B n s + symbolMap A B n t :=
  map_add (symbolMap A B n) s t

theorem symbolMap_smul (n : ℕ) (a : A) (s : Symbols A B n) :
    symbolMap A B n (a • s) = a • symbolMap A B n s :=
  map_smul (symbolMap A B n) a s

theorem zeroEquiv_symbolMap_sym (c : B) (v : Fin 0 → B) :
    exteriorPower.zeroEquiv B Ω[B⁄A] (symbolMap A B 0 (sym A B 0 c v)) = c := by
  simp

theorem oneEquiv_symbolMap_sym (c : B) (v : Fin 1 → B) :
    exteriorPower.oneEquiv B Ω[B⁄A] (symbolMap A B 1 (sym A B 1 c v)) = c • D A B (v 0) := by
  simp [elementary_one_deg]

/-- Left multiplication of symbol coefficients by `b : B`, `[c; v] ↦ [b * c; v]`. -/
private def mulCoeff (n : ℕ) (b : B) : Symbols A B n →ₗ[A] Symbols A B n :=
  Finsupp.lmapDomain A A fun p : B × (Fin n → B) ↦ (b * p.1, p.2)

omit [Algebra A B] in
@[simp]
private theorem mulCoeff_single (n : ℕ) (b c : B) (v : Fin n → B) (a : A) :
    mulCoeff n b (Finsupp.single (c, v) a) = Finsupp.single (b * c, v) a := by
  simp [mulCoeff]

omit [Algebra A B] in
@[simp]
private theorem mulCoeff_sym (n : ℕ) (b c : B) (v : Fin n → B) :
    mulCoeff n b (sym A B n c v) = sym A B n (b * c) v :=
  mulCoeff_single n b c v 1

private theorem symbolMap_mulCoeff (n : ℕ) (b : B) (s : Symbols A B n) :
    symbolMap A B n (mulCoeff n b s) = b • symbolMap A B n s := by
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy, smul_add]
  | single p a =>
    rw [mulCoeff_single, symbolMap_single, symbolMap_single, elementary_smul_coeff,
      smul_comm b a]

variable (A B) in
/-- **Differential symbols generate all forms.** The `A`-linear evaluation map `symbolMap A B n`
is surjective in every degree `n ≥ 0`. -/
theorem symbolMap_surjective (n : ℕ) : Function.Surjective (symbolMap A B n) := by
  intro ω
  have htop : ω ∈ Submodule.span B
      (exteriorPower.ιMulti B n '' { w : Fin n → Ω[B⁄A] | Set.range w ⊆ Set.range (D A B) }) := by
    rw [exteriorPower.ιMulti_span_of_span B n Ω[B⁄A] (span_range_derivation A B)]
    trivial
  induction htop using Submodule.span_induction with
  | mem _ h =>
    obtain ⟨w, hw, rfl⟩ := h
    choose v hv using fun i ↦ hw (Set.mem_range_self i)
    refine ⟨sym A B n 1 v, ?_⟩
    rw [symbolMap_sym, elementary_def, one_smul]
    congr 1
    exact funext hv
  | zero => exact ⟨0, map_zero _⟩
  | add _ _ _ _ hx hy =>
    obtain ⟨sx, rfl⟩ := hx
    obtain ⟨sy, rfl⟩ := hy
    exact ⟨sx + sy, map_add _ sx sy⟩
  | smul b _ _ hx =>
    obtain ⟨s, rfl⟩ := hx
    exact ⟨mulCoeff n b s, symbolMap_mulCoeff n b s⟩

variable (A B) in
/-- The `A`-span of all elementary forms `c • (D v₀ ∧ ⋯ ∧ D vₙ₋₁)` is the whole module
`Forms A B n`. -/
theorem span_elementary_eq_top (n : ℕ) :
    Submodule.span A (Set.range fun p : B × (Fin n → B) ↦ elementary A B n p.1 p.2) = ⊤ := by
  rw [← Finsupp.range_linearCombination, LinearMap.range_eq_top]
  exact symbolMap_surjective A B n

/-! ### Exactness of the symbol presentation -/

private theorem symbolRelations_le_ker_symbolMap (n : ℕ) :
    symbolRelations A B n ≤ LinearMap.ker (symbolMap A B n) := by
  rw [symbolRelations_eq_span, Submodule.span_le]
  rintro s (((((⟨⟨c, e, v⟩, rfl⟩ | ⟨⟨a, c, v⟩, rfl⟩) | ⟨⟨c, v, i, x, y⟩, rfl⟩) |
      ⟨⟨c, v, i, x, y⟩, rfl⟩) | ⟨⟨c, v, i, a⟩, rfl⟩) | ⟨c, v, i, j, hij, hv, rfl⟩)
  · simp [elementary_add_coeff]
  · simp [elementary_base_smul_coeff]
  · dsimp only
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, map_sub, symbolMap_sym, symbolMap_sym,
      symbolMap_sym, elementary_def, elementary_def, elementary_def]
    have hcomp (z : B) : D A B ∘ Function.update v i z = Function.update (D A B ∘ v) i (D A B z) :=
      Function.comp_update (D A B) v i z
    rw [hcomp, hcomp, hcomp, map_add, AlternatingMap.map_update_add, smul_add, sub_sub, sub_self]
  · dsimp only
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, map_sub, symbolMap_sym, symbolMap_sym,
      symbolMap_sym, elementary_def, elementary_def, elementary_def]
    have hcomp (z : B) : D A B ∘ Function.update v i z = Function.update (D A B ∘ v) i (D A B z) :=
      Function.comp_update (D A B) v i z
    rw [hcomp, hcomp, hcomp, Derivation.leibniz, AlternatingMap.map_update_add,
      AlternatingMap.map_update_smul, AlternatingMap.map_update_smul, smul_add,
      smul_smul, smul_smul, sub_sub, sub_self]
  · dsimp only
    rw [SetLike.mem_coe, LinearMap.mem_ker, symbolMap_sym, elementary_def]
    have hcomp : D A B ∘ Function.update v i (algebraMap A B a) =
        Function.update (D A B ∘ v) i 0 := by
      rw [Function.comp_update, Derivation.map_algebraMap]
    rw [hcomp, AlternatingMap.map_update_zero, smul_zero]
  · rw [SetLike.mem_coe, LinearMap.mem_ker, symbolMap_sym, elementary_eq_zero_of_eq A B c hij hv]

private theorem mulCoeff_mem_symbolRelations {n : ℕ} (b : B) {s : Symbols A B n}
    (hs : s ∈ symbolRelations A B n) : mulCoeff n b s ∈ symbolRelations A B n := by
  rw [symbolRelations_eq_span] at hs
  induction hs using Submodule.span_induction with
  | mem s hs =>
    rcases hs with ((((⟨⟨c, e, v⟩, rfl⟩ | ⟨⟨a, c, v⟩, rfl⟩) | ⟨⟨c, v, i, x, y⟩, rfl⟩) |
        ⟨⟨c, v, i, x, y⟩, rfl⟩) | ⟨⟨c, v, i, a⟩, rfl⟩) | ⟨c, v, i, j, hij, hv, rfl⟩
    · simpa [mul_add] using symbolRelations_coeff_add (A := A) (b * c) (b * e) v
    · simpa [mul_smul_comm] using symbolRelations_coeff_smul a (b * c) v
    · simpa using symbolRelations_slot_add (A := A) (b * c) v i x y
    · simpa [mul_assoc] using symbolRelations_slot_mul (A := A) (b * c) v i x y
    · simpa using symbolRelations_slot_algebraMap (b * c) v i a
    · simpa using symbolRelations_alt (A := A) (b * c) hij hv
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add _ _ _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul a _ _ hx => rw [map_smul]; exact Submodule.smul_mem _ a hx

private def quotMulCoeff (n : ℕ) (b : B) :
    (Symbols A B n ⧸ symbolRelations A B n) →ₗ[A] (Symbols A B n ⧸ symbolRelations A B n) :=
  Submodule.mapQ (symbolRelations A B n) (symbolRelations A B n) (mulCoeff n b)
    fun _ hs ↦ mulCoeff_mem_symbolRelations b hs

private theorem quotMulCoeff_mkQ_single (n : ℕ) (b c : B) (v : Fin n → B) (a : A) :
    quotMulCoeff n b ((symbolRelations A B n).mkQ (Finsupp.single (c, v) a)) =
      (symbolRelations A B n).mkQ (Finsupp.single (b * c, v) a) := by
  simp [quotMulCoeff]

private theorem quotMulCoeff_mkQ_sym (n : ℕ) (b c : B) (v : Fin n → B) :
    quotMulCoeff n b ((symbolRelations A B n).mkQ (sym A B n c v)) =
      (symbolRelations A B n).mkQ (sym A B n (b * c) v) :=
  quotMulCoeff_mkQ_single n b c v 1

private theorem quotSym_mkQ_coeff_add (n : ℕ) (c e : B) (v : Fin n → B) :
    (symbolRelations A B n).mkQ (sym A B n (c + e) v) =
      (symbolRelations A B n).mkQ (sym A B n c v) +
        (symbolRelations A B n).mkQ (sym A B n e v) := by
  rw [← map_add, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq, ← sub_sub]
  exact symbolRelations_coeff_add c e v

private theorem quotSym_mkQ_coeff_smul (n : ℕ) (a : A) (c : B) (v : Fin n → B) :
    (symbolRelations A B n).mkQ (sym A B n (a • c) v) =
      a • (symbolRelations A B n).mkQ (sym A B n c v) := by
  rw [← map_smul, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  exact symbolRelations_coeff_smul a c v

private theorem quotMulCoeff_one (n : ℕ) (q : Symbols A B n ⧸ symbolRelations A B n) :
    quotMulCoeff n 1 q = q := by
  obtain ⟨s, rfl⟩ := Submodule.mkQ_surjective _ q
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | single p a =>
    rcases p with ⟨c, v⟩
    rw [quotMulCoeff_mkQ_single, one_mul]

private theorem quotMulCoeff_mul (n : ℕ) (b₁ b₂ : B)
    (q : Symbols A B n ⧸ symbolRelations A B n) :
    quotMulCoeff n (b₁ * b₂) q = quotMulCoeff n b₁ (quotMulCoeff n b₂ q) := by
  obtain ⟨s, rfl⟩ := Submodule.mkQ_surjective _ q
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | single p a =>
    rcases p with ⟨c, v⟩
    rw [quotMulCoeff_mkQ_single, quotMulCoeff_mkQ_single, quotMulCoeff_mkQ_single, mul_assoc]

private theorem quotMulCoeff_add (n : ℕ) (b₁ b₂ : B)
    (q : Symbols A B n ⧸ symbolRelations A B n) :
    quotMulCoeff n (b₁ + b₂) q = quotMulCoeff n b₁ q + quotMulCoeff n b₂ q := by
  obtain ⟨s, rfl⟩ := Submodule.mkQ_surjective _ q
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy, add_add_add_comm]
  | single p a =>
    rw [← smul_sym, map_smul, map_smul, map_smul, map_smul, quotMulCoeff_mkQ_sym,
      quotMulCoeff_mkQ_sym, quotMulCoeff_mkQ_sym, add_mul, quotSym_mkQ_coeff_add, smul_add]

private theorem quotMulCoeff_zero (n : ℕ) (q : Symbols A B n ⧸ symbolRelations A B n) :
    quotMulCoeff n 0 q = 0 := by
  obtain ⟨s, rfl⟩ := Submodule.mkQ_surjective _ q
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, add_zero]
  | single p a =>
    rw [← smul_sym, map_smul, map_smul, quotMulCoeff_mkQ_sym, zero_mul, Submodule.mkQ_apply,
      (Submodule.Quotient.mk_eq_zero _).mpr (symbolRelations_coeff_zero p.2), smul_zero]

private theorem quotMulCoeff_algebraMap (n : ℕ) (a : A)
    (q : Symbols A B n ⧸ symbolRelations A B n) :
    quotMulCoeff n (algebraMap A B a) q = a • q := by
  obtain ⟨s, rfl⟩ := Submodule.mkQ_surjective _ q
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, smul_add, hx, hy]
  | single p r =>
    rw [← smul_sym, map_smul, map_smul, quotMulCoeff_mkQ_sym, ← Algebra.smul_def,
      quotSym_mkQ_coeff_smul, smul_comm]

/-- Wrapper around `Symbols A B n ⧸ symbolRelations A B n` carrying the induced `B`-module
structure `b • [c; v] = [b * c; v]`, used solely to build the inverse map from `Forms A B n`. -/
@[ext]
private structure QuotSym (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    (n : ℕ) : Type (max u v) where
  ofQuot ::
  toQuot : Symbols A B n ⧸ symbolRelations A B n

private instance (n : ℕ) : Zero (QuotSym A B n) := ⟨⟨0⟩⟩
private instance (n : ℕ) : Add (QuotSym A B n) := ⟨fun x y ↦ ⟨x.toQuot + y.toQuot⟩⟩
private instance (n : ℕ) : Neg (QuotSym A B n) := ⟨fun x ↦ ⟨-x.toQuot⟩⟩
private instance (n : ℕ) : Sub (QuotSym A B n) := ⟨fun x y ↦ ⟨x.toQuot - y.toQuot⟩⟩

private instance (n : ℕ) : AddCommGroup (QuotSym A B n) where
  add_assoc a b c := QuotSym.ext (add_assoc a.toQuot b.toQuot c.toQuot)
  zero_add a := QuotSym.ext (zero_add a.toQuot)
  add_zero a := QuotSym.ext (add_zero a.toQuot)
  neg_add_cancel a := QuotSym.ext (neg_add_cancel a.toQuot)
  add_comm a b := QuotSym.ext (add_comm a.toQuot b.toQuot)
  sub_eq_add_neg a b := QuotSym.ext (sub_eq_add_neg a.toQuot b.toQuot)
  nsmul := nsmulRec
  zsmul := zsmulRec

private instance (n : ℕ) : Module A (QuotSym A B n) where
  smul a x := ⟨a • x.toQuot⟩
  one_smul x := QuotSym.ext (one_smul A x.toQuot)
  mul_smul a₁ a₂ x := QuotSym.ext (mul_smul a₁ a₂ x.toQuot)
  smul_zero a := QuotSym.ext (smul_zero a)
  smul_add a x y := QuotSym.ext (smul_add a x.toQuot y.toQuot)
  add_smul a₁ a₂ x := QuotSym.ext (add_smul a₁ a₂ x.toQuot)
  zero_smul x := QuotSym.ext (zero_smul A x.toQuot)

private instance (n : ℕ) : Module B (QuotSym A B n) where
  smul b x := ⟨quotMulCoeff n b x.toQuot⟩
  one_smul x := QuotSym.ext (quotMulCoeff_one n x.toQuot)
  mul_smul b₁ b₂ x := QuotSym.ext (quotMulCoeff_mul n b₁ b₂ x.toQuot)
  smul_zero b := QuotSym.ext (map_zero (quotMulCoeff n b))
  smul_add b x y := QuotSym.ext (map_add (quotMulCoeff n b) x.toQuot y.toQuot)
  add_smul b₁ b₂ x := QuotSym.ext (quotMulCoeff_add n b₁ b₂ x.toQuot)
  zero_smul x := QuotSym.ext (quotMulCoeff_zero n x.toQuot)

private instance (n : ℕ) : IsScalarTower A B (QuotSym A B n) :=
  IsScalarTower.of_algebraMap_smul fun a x ↦ QuotSym.ext (quotMulCoeff_algebraMap n a x.toQuot)

private def QuotSym.mkQ (n : ℕ) : Symbols A B n →ₗ[A] QuotSym A B n where
  toFun s := ⟨(symbolRelations A B n).mkQ s⟩
  map_add' s t := QuotSym.ext (map_add _ s t)
  map_smul' a s := QuotSym.ext (map_smul _ a s)

private def QuotSym.toQuotLinearMap (n : ℕ) :
    QuotSym A B n →ₗ[A] Symbols A B n ⧸ symbolRelations A B n where
  toFun x := x.toQuot
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
private theorem QuotSym.smul_mkQ_sym (n : ℕ) (b c : B) (v : Fin n → B) :
    b • QuotSym.mkQ n (sym A B n c v) = QuotSym.mkQ n (sym A B n (b * c) v) :=
  QuotSym.ext (quotMulCoeff_mkQ_sym n b c v)

/-- Two `B`-multilinear maps on `Ω[B⁄A]` that agree on tuples of universal differentials `D A B ∘ v`
are equal. -/
private theorem multilinearMap_ext_D {k : ℕ} {M : Type*} [AddCommGroup M] [Module B M]
    {g₁ g₂ : (Fin k → Ω[B⁄A]) →ₘₗ[B] M}
    (h : ∀ v : Fin k → B, g₁ (D A B ∘ v) = g₂ (D A B ∘ v)) : g₁ = g₂ := by
  induction k with
  | zero =>
    ext ω
    rw [Subsingleton.elim ω (D A B ∘ Fin.elim0)]
    exact h Fin.elim0
  | succ k ih =>
    have hcurry : g₁.curryLeft = g₂.curryLeft := by
      refine LinearMap.ext_on (span_range_derivation A B) ?_
      rintro _ ⟨x, rfl⟩
      refine ih fun tail ↦ ?_
      have hcons : Fin.cons (D A B x) (D A B ∘ tail) = D A B ∘ Fin.cons x tail := by
        ext j; cases j using Fin.cases <;> rfl
      rw [MultilinearMap.curryLeft_apply, MultilinearMap.curryLeft_apply, hcons]
      exact h (Fin.cons x tail)
    rw [← MultilinearMap.uncurry_curryLeft g₁, ← MultilinearMap.uncurry_curryLeft g₂, hcurry]

/-- A map `(Fin k → B) → M` into a `B`-module `M` that is an `A`-derivation in each slot. -/
private structure IsMultiDerivation (A : Type u) {B : Type v} [CommRing A] [CommRing B]
    [Algebra A B] (k : ℕ) {M : Type*} [AddCommGroup M] [Module B M]
    (F : (Fin k → B) → M) : Prop where
  map_add : ∀ (v : Fin k → B) (i : Fin k) (x y : B),
    F (Function.update v i (x + y)) = F (Function.update v i x) + F (Function.update v i y)
  leibniz : ∀ (v : Fin k → B) (i : Fin k) (x y : B),
    F (Function.update v i (x * y)) = x • F (Function.update v i y) + y • F (Function.update v i x)
  map_algebraMap : ∀ (v : Fin k → B) (i : Fin k) (a : A),
    F (Function.update v i (algebraMap A B a)) = 0

private theorem IsMultiDerivation.cons {k : ℕ} {M : Type*} [AddCommGroup M] [Module B M]
    {F : (Fin (k + 1) → B) → M} (hF : IsMultiDerivation A (k + 1) F) (x : B) :
    IsMultiDerivation A k (fun tail ↦ F (Fin.cons x tail)) where
  map_add tail i y z := by
    simpa only [Fin.cons_update] using hF.map_add (Fin.cons x tail) i.succ y z
  leibniz tail i y z := by
    simpa only [Fin.cons_update] using hF.leibniz (Fin.cons x tail) i.succ y z
  map_algebraMap tail i a := by
    simpa only [Fin.cons_update] using hF.map_algebraMap (Fin.cons x tail) i.succ a

omit [Algebra A B] in
private theorem fin_cons_eq_update_zero {k : ℕ} (tail : Fin k → B) (z : B) :
    Fin.cons z tail = Function.update (Fin.cons 0 tail : Fin (k + 1) → B) 0 z := by
  ext j; cases j using Fin.cases <;> rfl

/-- Every multi-derivation `(Fin k → B) → M` lifts along `D A B` in each slot to a `B`-multilinear
map `(Fin k → Ω[B⁄A]) →ₘₗ[B] M`. -/
private def liftMultiDerivation :
    (k : ℕ) → {M : Type*} → [AddCommGroup M] → [Module A M] → [Module B M] →
      [IsScalarTower A B M] → (F : (Fin k → B) → M) → IsMultiDerivation A k F →
      { μ : (Fin k → Ω[B⁄A]) →ₘₗ[B] M // ∀ v : Fin k → B, μ (D A B ∘ v) = F v }
  | 0, _, _, _, _, _, F, _ =>
    ⟨MultilinearMap.constOfIsEmpty (RingHom.id B) (fun _ : Fin 0 ↦ Ω[B⁄A]) (F Fin.elim0),
      fun v ↦ by simp [Subsingleton.elim v Fin.elim0]⟩
  | k + 1, M, _, _, _, _, F, hF =>
    letI : IsScalarTower A B ((Fin k → Ω[B⁄A]) →ₘₗ[B] M) :=
      IsScalarTower.of_algebraMap_smul fun a μ ↦ MultilinearMap.ext fun ω ↦
        IsScalarTower.algebraMap_smul B a (μ ω)
    let step : ∀ x : B, { μ : (Fin k → Ω[B⁄A]) →ₘₗ[B] M //
        ∀ tail : Fin k → B, μ (D A B ∘ tail) = F (Fin.cons x tail) } :=
      fun x ↦ liftMultiDerivation k (fun tail ↦ F (Fin.cons x tail)) (hF.cons x)
    let gLin : B →ₗ[A] ((Fin k → Ω[B⁄A]) →ₘₗ[B] M) :=
      { toFun := fun x ↦ (step x).1
        map_add' := fun x y ↦ multilinearMap_ext_D fun tail ↦ by
          rw [add_apply, (step _).2, (step _).2, (step _).2, fin_cons_eq_update_zero tail (x + y),
            fin_cons_eq_update_zero tail x, fin_cons_eq_update_zero tail y]
          exact hF.map_add _ 0 x y
        map_smul' := fun a x ↦ multilinearMap_ext_D fun tail ↦ by
          rw [RingHom.id_apply, smul_apply, ← IsScalarTower.algebraMap_smul B a ((step x).1 _),
            (step _).2, (step _).2, Algebra.smul_def,
            fin_cons_eq_update_zero tail (algebraMap A B a * x), hF.leibniz, hF.map_algebraMap,
            smul_zero, add_zero, ← fin_cons_eq_update_zero tail x] }
    let gDer : Derivation A B ((Fin k → Ω[B⁄A]) →ₘₗ[B] M) :=
      Derivation.mk' gLin fun x y ↦ multilinearMap_ext_D fun tail ↦ by
        rw [add_apply, smul_apply, smul_apply]
        change (step (x * y)).1 (D A B ∘ tail) =
          x • (step y).1 (D A B ∘ tail) + y • (step x).1 (D A B ∘ tail)
        rw [(step _).2, (step _).2, (step _).2, fin_cons_eq_update_zero tail (x * y), hF.leibniz,
          ← fin_cons_eq_update_zero tail y, ← fin_cons_eq_update_zero tail x]
    ⟨LinearMap.uncurryLeft gDer.liftKaehlerDifferential, fun v ↦ by
      rw [LinearMap.uncurryLeft_apply, Function.comp_apply,
        Derivation.liftKaehlerDifferential_comp_D]
      have htail : Fin.tail (D A B ∘ v) = D A B ∘ Fin.tail v := rfl
      change (step (v 0)).1 (Fin.tail (D A B ∘ v)) = F v
      rw [htail, (step (v 0)).2 (Fin.tail v), Fin.cons_self_tail]⟩

/-- Swapping two distinct slots negates any `B`-multilinear map on `Ω[B⁄A]` that vanishes on tuples
`D A B ∘ v` with `v i = v j`. -/
private theorem multilinear_add_swap_eq_zero_of_D {n : ℕ} {M : Type*} [AddCommGroup M]
    [Module B M] (μ : (Fin n → Ω[B⁄A]) →ₘₗ[B] M)
    (hD : ∀ (v : Fin n → B) {i j : Fin n}, i ≠ j → v i = v j → μ (D A B ∘ v) = 0)
    {i j : Fin n} (hij : i ≠ j) :
    μ + μ.domDomCongr (Equiv.swap i j) = 0 := by
  refine multilinearMap_ext_D fun v ↦ ?_
  rw [add_apply, MultilinearMap.domDomCongr_apply, zero_apply]
  have hv1 : D A B ∘ v = Function.update (Function.update (D A B ∘ v) i (D A B (v i)))
      j (D A B (v j)) := by
    ext k
    by_cases hkj : k = j
    · subst hkj; simp
    · by_cases hki : k = i
      · subst hki; simp [hkj]
      · simp [hki, hkj]
  have hv2 : (D A B ∘ v) ∘ Equiv.swap i j =
      Function.update (Function.update (D A B ∘ v) i (D A B (v j))) j (D A B (v i)) := by
    ext k
    by_cases hki : k = i
    · subst hki; simp [hij]
    · by_cases hkj : k = j
      · subst hkj; simp
      · simp [hki, hkj, Equiv.swap_apply_of_ne_of_ne hki hkj]
  have hdiag (z : B) :
      μ (Function.update (Function.update (D A B ∘ v) i (D A B z)) j (D A B z)) = 0 := by
    have heq : Function.update (Function.update (D A B ∘ v) i (D A B z)) j (D A B z) =
        D A B ∘ Function.update (Function.update v i z) j z := by
      rw [Function.comp_update, Function.comp_update]
    rw [heq]
    exact hD _ hij (by simp [hij])
  have hsum := hdiag (v i + v j)
  rw [map_add (D A B), MultilinearMap.map_update_add] at hsum
  simp only [Function.update_comm hij, MultilinearMap.map_update_add] at hsum
  simp only [Function.update_comm hij.symm, hdiag, zero_add, add_zero] at hsum
  rw [← hv1, ← hv2, add_comm] at hsum
  exact hsum

/-- Auxiliary span-induction step: when the repeated value `u i = u j` lies in `Set.range (D A B)`,
`μ u = 0` for any `u : Fin n → Ω[B⁄A]`. -/
private theorem multilinear_eq_zero_of_eq_mem_range_D {n : ℕ} {M : Type*} [AddCommGroup M]
    [Module B M] (μ : (Fin n → Ω[B⁄A]) →ₘₗ[B] M)
    (hD : ∀ (v : Fin n → B) {i j : Fin n}, i ≠ j → v i = v j → μ (D A B ∘ v) = 0)
    {i j : Fin n} (hij : i ≠ j) :
    ∀ (s : Finset (Fin n)) (u : Fin n → Ω[B⁄A]),
      (∀ k ∉ s, u k ∈ Set.range (D A B)) → u i = u j → u i ∈ Set.range (D A B) → μ u = 0 := by
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro u hu huij ⟨x, hx⟩
    choose v hv using fun k ↦ hu k (Finset.notMem_empty k)
    let v' := Function.update (Function.update v i x) j x
    have hu' : u = D A B ∘ v' := by
      ext k
      by_cases hki : k = i
      · subst hki; simp [v', hij, hx.symm]
      · by_cases hkj : k = j
        · subst hkj; simp [v', huij.symm, hx.symm]
        · simp [v', hki, hkj, hv k]
    rw [hu']
    exact hD v' hij (by simp [v', hij])
  | insert k s _ ih =>
    intro u hu huij hui
    have hu_not_insert {l : Fin n} (hlk : l ≠ k) (hl : l ∉ s) : l ∉ insert k s :=
      fun h ↦ (Finset.mem_insert.mp h).elim hlk hl
    by_cases hki : k = i
    · subst hki
      refine ih u (fun l hl ↦ ?_) huij hui
      by_cases hlk : l = k
      · exact hlk ▸ hui
      · exact hu l (hu_not_insert hlk hl)
    · by_cases hkj : k = j
      · subst hkj
        refine ih u (fun l hl ↦ ?_) huij hui
        by_cases hlk : l = k
        · exact hlk ▸ huij ▸ hui
        · exact hu l (hu_not_insert hlk hl)
      · have huk : u k ∈ Submodule.span B (Set.range (D A B)) := by
          rw [span_range_derivation]; trivial
        have hlin : ∀ z ∈ Submodule.span B (Set.range (D A B)),
            μ (Function.update u k z) = 0 := by
          intro z hz
          induction hz using Submodule.span_induction with
          | mem z hz =>
            refine ih (Function.update u k z) (fun l hl ↦ ?_)
              (by simp [Ne.symm hki, Ne.symm hkj, huij]) (by simpa [Ne.symm hki] using hui)
            by_cases hlk : l = k
            · simpa [hlk] using hz
            · simpa [hlk] using hu l (hu_not_insert hlk hl)
          | zero => simp
          | add z₁ z₂ _ _ hz₁ hz₂ => rw [MultilinearMap.map_update_add, hz₁, hz₂, add_zero]
          | smul b z _ hz => rw [MultilinearMap.map_update_smul, hz, smul_zero]
        simpa using hlin (u k) huk

/-- A `B`-multilinear map on `Ω[B⁄A]` that vanishes on every tuple `D A B ∘ v` with `v i = v j`
(`i ≠ j`) is alternating on all tuples in `Ω[B⁄A]`, without any characteristic assumption. -/
private theorem multilinear_map_eq_zero_of_eq_of_D {n : ℕ} {M : Type*} [AddCommGroup M]
    [Module B M] (μ : (Fin n → Ω[B⁄A]) →ₘₗ[B] M)
    (hD : ∀ (v : Fin n → B) {i j : Fin n}, i ≠ j → v i = v j → μ (D A B ∘ v) = 0)
    (ω : Fin n → Ω[B⁄A]) {i j : Fin n} (hv : ω i = ω j) (hij : i ≠ j) :
    μ ω = 0 := by
  have hswap_sum := multilinear_add_swap_eq_zero_of_D μ hD hij
  have hωi : ω i ∈ Submodule.span B (Set.range (D A B)) := by
    rw [span_range_derivation]; trivial
  suffices ∀ z ∈ Submodule.span B (Set.range (D A B)),
      μ (Function.update (Function.update ω i z) j z) = 0 by
    have h := this (ω i) hωi
    have hupd : Function.update (Function.update ω i (ω i)) j (ω i) = ω := by
      rw [Function.update_eq_self, hv, Function.update_eq_self]
    rwa [hupd] at h
  intro z hz
  induction hz using Submodule.span_induction with
  | mem z hz =>
    exact multilinear_eq_zero_of_eq_mem_range_D μ hD hij Finset.univ _
      (fun _ h ↦ absurd (Finset.mem_univ _) h) (by simp [hij]) (by simpa [hij] using hz)
  | zero => simp
  | smul b z _ ih =>
    rw [MultilinearMap.map_update_smul, Function.update_comm hij,
      MultilinearMap.map_update_smul, Function.update_comm hij.symm, ih, smul_zero, smul_zero]
  | add z₁ z₂ _ _ ih₁ ih₂ =>
    rw [MultilinearMap.map_update_add]
    simp only [Function.update_comm hij, MultilinearMap.map_update_add]
    simp only [Function.update_comm hij.symm, ih₁, ih₂, zero_add, add_zero]
    let w := Function.update (Function.update ω i z₁) j z₂
    have hw_swap : (fun l ↦ w (Equiv.swap i j l)) =
        Function.update (Function.update ω i z₂) j z₁ := by
      ext k
      by_cases hki : k = i
      · subst hki; simp [w, hij]
      · by_cases hkj : k = j
        · subst hkj; simp [w, hij]
        · simp [w, hki, hkj, Equiv.swap_apply_of_ne_of_ne hki hkj]
    have h := DFunLike.congr_fun hswap_sum w
    rw [add_apply, MultilinearMap.domDomCongr_apply, zero_apply, hw_swap, add_comm] at h
    exact h

/-- The `B`-linear inverse `Forms A B n →ₗ[B] QuotSym A B n` sending `D v₀ ∧ ⋯ ∧ D vₙ₋₁` to
`[1; v]`. -/
private def symbolInvMapB (n : ℕ) : Forms A B n →ₗ[B] QuotSym A B n :=
  let F : (Fin n → B) → QuotSym A B n := fun v ↦ QuotSym.mkQ n (sym A B n 1 v)
  have hF : IsMultiDerivation A n F :=
    { map_add := fun v i x y ↦ by
        dsimp only [F]
        rw [← map_add]
        exact QuotSym.ext ((Submodule.Quotient.eq _).mpr
          (by rw [← sub_sub]; exact symbolRelations_slot_add 1 v i x y))
      leibniz := fun v i x y ↦ by
        dsimp only [F]
        rw [QuotSym.smul_mkQ_sym, QuotSym.smul_mkQ_sym, mul_comm x 1, mul_comm y 1, ← map_add]
        exact QuotSym.ext ((Submodule.Quotient.eq _).mpr
          (by rw [← sub_sub]; exact symbolRelations_slot_mul 1 v i x y))
      map_algebraMap := fun v i a ↦ by
        dsimp only [F]
        exact QuotSym.ext
          ((Submodule.Quotient.mk_eq_zero _).mpr (symbolRelations_slot_algebraMap 1 v i a)) }
  let lifted := liftMultiDerivation n F hF
  let alt : Ω[B⁄A] [⋀^Fin n]→ₗ[B] QuotSym A B n :=
    { lifted.1 with
      map_eq_zero_of_eq' := fun ω i j hv hij ↦
        multilinear_map_eq_zero_of_eq_of_D lifted.1
          (fun v {i' j'} hij' hv' ↦ by
            rw [lifted.2 v]
            exact QuotSym.ext ((Submodule.Quotient.mk_eq_zero _).mpr
              (symbolRelations_alt 1 hij' hv')))
          ω hv hij }
  exteriorPower.alternatingMapLinearEquiv alt

private theorem symbolInvMapB_elementary (n : ℕ) (c : B) (v : Fin n → B) :
    symbolInvMapB n (elementary A B n c v) = QuotSym.mkQ n (sym A B n c v) := by
  rw [elementary_def, map_smul]
  dsimp only [symbolInvMapB]
  rw [exteriorPower.alternatingMapLinearEquiv_apply_ιMulti, AlternatingMap.coe_mk,
    (liftMultiDerivation n _ _).2 v, QuotSym.smul_mkQ_sym, mul_one]

/-- The `A`-linear inverse `Forms A B n →ₗ[A] Symbols A B n ⧸ symbolRelations A B n`. -/
private def symbolInvMap (n : ℕ) :
    Forms A B n →ₗ[A] Symbols A B n ⧸ symbolRelations A B n :=
  (QuotSym.toQuotLinearMap n).comp ((symbolInvMapB (A := A) (B := B) n).restrictScalars A)

private theorem symbolInvMap_comp_symbolMap (n : ℕ) :
    (symbolInvMap (A := A) (B := B) n).comp (symbolMap A B n) = (symbolRelations A B n).mkQ := by
  refine Finsupp.lhom_ext' fun p ↦ LinearMap.ext_ring ?_
  rcases p with ⟨c, v⟩
  rw [LinearMap.comp_apply, LinearMap.comp_apply, Finsupp.lsingle_apply, symbolMap_single,
    one_smul]
  exact congrArg QuotSym.toQuot (symbolInvMapB_elementary n c v)

variable (A B) in
/-- **The differential-symbol presentation.** In every degree `n ≥ 0`, the kernel of the evaluation
map `symbolMap A B n : Symbols A B n →ₗ[A] Forms A B n` is `symbolRelations A B n`. -/
theorem symbolRelations_ker (n : ℕ) :
    LinearMap.ker (symbolMap A B n) = symbolRelations A B n := by
  refine le_antisymm ?_ (symbolRelations_le_ker_symbolMap n)
  rw [← Submodule.ker_mkQ (symbolRelations A B n), ← symbolInvMap_comp_symbolMap n]
  exact LinearMap.ker_le_ker_comp (symbolMap A B n) (symbolInvMap n)

variable (A B) in
/-- Canonical `A`-linear equivalence `(Symbols A B n ⧸ symbolRelations A B n) ≃ₗ[A] Forms A B n`
induced by `symbolMap A B n`. -/
def quotSymbolRelationsEquiv (n : ℕ) :
    (Symbols A B n ⧸ symbolRelations A B n) ≃ₗ[A] Forms A B n :=
  Submodule.quotEquivOfEq (symbolRelations A B n) (LinearMap.ker (symbolMap A B n))
      (symbolRelations_ker A B n).symm ≪≫ₗ
    (symbolMap A B n).quotKerEquivOfSurjective (symbolMap_surjective A B n)

@[simp]
theorem quotSymbolRelationsEquiv_mk (n : ℕ) (s : Symbols A B n) :
    quotSymbolRelationsEquiv A B n (Submodule.Quotient.mk s) = symbolMap A B n s :=
  (rfl)

theorem quotSymbolRelationsEquiv_mkQ (n : ℕ) (s : Symbols A B n) :
    quotSymbolRelationsEquiv A B n ((symbolRelations A B n).mkQ s) = symbolMap A B n s :=
  (rfl)

@[simp]
theorem quotSymbolRelationsEquiv_symm_elementary (n : ℕ) (c : B) (v : Fin n → B) :
    (quotSymbolRelationsEquiv A B n).symm (elementary A B n c v) =
      (symbolRelations A B n).mkQ (sym A B n c v) := by
  apply (quotSymbolRelationsEquiv A B n).injective
  simp

/-- A symbol `s` lies in `symbolRelations A B n` if and only if its evaluation vanishes in
`Forms A B n`. -/
theorem mem_symbolRelations_iff {n : ℕ} (s : Symbols A B n) :
    s ∈ symbolRelations A B n ↔ symbolMap A B n s = 0 := by
  rw [← symbolRelations_ker, LinearMap.mem_ker]

/-- Over any nontrivial `A`-algebra `B`, the unit degree-zero symbol `[1; ()]` does not belong to
`symbolRelations A B 0`. -/
theorem sym_one_not_mem_symbolRelations_zero [Nontrivial B] (v : Fin 0 → B) :
    sym A B 0 1 v ∉ symbolRelations A B 0 := by
  rw [mem_symbolRelations_iff, symbolMap_sym, elementary_zero_deg]
  intro h
  exact one_ne_zero (α := B) (by simpa using congrArg (exteriorPower.zeroEquiv B Ω[B⁄A]) h)

end Presentation

