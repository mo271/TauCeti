module

public import TauCeti.Analysis.Normed.Group.OpenMapping
public import TauCeti.Analysis.Normed.Group.Quotient
public import TauCeti.Analysis.Normed.Ring.Quotient.Basic
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Map
import Mathlib.RingTheory.MvPowerSeries.Ideal

/-!
# Quotient maps and isometric quotients of restricted power series

A bounded coefficient homomorphism `φ : R →+* S` with a uniform bound on coefficient lifts induces
an open quotient map of restricted-series rings `R{X/c} →+* S{X/c}` for their Gauss norm
topologies, identifying `R{X/c} ⧸ ker (restrictedMap φ hφ)` with `S{X/c}` as topological rings
(`TauCeti.MvPowerSeries.restrictedMapQuotientEquiv`). Neither completeness nor a finite variable set
is needed.

Topological quotient-ness alone does not make this identification an isometry for the quotient
Gauss norm, even when `φ` is contractive and algebraically bijective. When `φ` is contractive and
satisfies the sharp lifting condition that every `b : S` has preimages of norm arbitrarily close to
`‖b‖`, restricted series inherit sharp lifts
(`TauCeti.MvPowerSeries.exists_restrictedMap_eq_and_norm_lt`), and the induced isomorphism
`R{X/c} ⧸ ker (restrictedMap φ hφ) ≃+* S{X/c}` is an isometry
(`TauCeti.MvPowerSeries.isometry_restrictedMapSharpQuotientEquiv`). If every `b : S` admits a lift
with `‖a‖ ≤ ‖b‖`, every restricted series over `S` lifts with exact equality of Gauss norms and
every coset of the kernel has a least-norm representative.

Specialising `φ` to `Ideal.Quotient.mk I` for a closed two-sided ideal `I` of `R` identifies
`(R ⧸ I){X/c}` isometrically with the quotient of `R{X/c}` by the ideal of restricted series whose
coefficients lie in `I` (`Ideal.restrictedQuotientMkEquiv`). When `R` is commutative and `I` admits
a finite generating set with uniformly bounded coefficient expressions — for example a principal
ideal generated by an element scaling norms multiplicatively — that kernel equals the extended ideal
`I · R{X/c}`, giving the isometric isomorphism
`R{X/c} ⧸ (I · R{X/c}) ≃+* (R ⧸ I){X/c}` (`Ideal.isRestrictedQuotientEquivQuotientIsRestricted`).

## Main definitions

* `TauCeti.MvPowerSeries.restrictedMapQuotientEquiv`: the topological ring isomorphism
  `R{X/c} ⧸ ker (restrictedMap φ hφ) ≃+* S{X/c}` for uniformly bounded coefficient lifts.
* `TauCeti.MvPowerSeries.restrictedMapSharpQuotientEquiv`: the isometric ring isomorphism under
  sharp coefficient lifts.
* `Ideal.restrictedQuotientMk` and `Ideal.restrictedQuotientMkEquiv`: coefficient reduction modulo
  a closed two-sided ideal `I` and its isometric quotient isomorphism.
* `Ideal.isRestrictedQuotientEquivQuotientIsRestricted`: the isometric isomorphism
  `R{X/c} ⧸ (I · R{X/c}) ≃+* (R ⧸ I){X/c}` when `I` has uniformly bounded finite generators.

## References

* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §§5.1.1, 5.2.7.
-/

public section

namespace TauCeti.MvPowerSeries

open _root_.MvPowerSeries

section AlgebraicSharp

variable {σ R S : Type*} [NormedRing R] [IsUltrametricDist R]
  [NormedRing S] [IsUltrametricDist S] {c : σ → ℝ}
  (φ : R →+* S) {C : ℝ} (hφ : ∀ a, ‖φ a‖ ≤ C * ‖a‖)

/-- Sharp coefficient lifts yield a restricted lift with any multiplicative coefficient bound
`L > 1`, without positivity of the radii or completeness. -/
theorem exists_restrictedMap_eq_and_norm_coeff_le_of_forall_pos_lt_add
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) {L : ℝ} (hL : 1 < L)
    (g : IsRestricted.subring (R := S) c) :
    ∃ f, restrictedMap φ hφ f = g ∧ ∀ t,
      ‖coeff t (f : MvPowerSeries σ R)‖ ≤ L * ‖coeff t (g : MvPowerSeries σ S)‖ :=
  exists_restrictedMap_eq_and_norm_coeff_le φ hφ
    (exists_norm_le_of_forall_pos_lt_add φ hsharp hL) g

/-- Sharp coefficient lifts make `restrictedMap` surjective at arbitrary polyradii. -/
theorem restrictedMap_surjective_of_forall_pos_lt_add
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Function.Surjective (restrictedMap (c := c) φ hφ) :=
  restrictedMap_surjective φ hφ
    (exists_norm_le_of_forall_pos_lt_add φ hsharp one_lt_two)

/-- **Quotient ring isomorphism for bounded coefficient lifts.** When `φ : R →+* S` is bounded and
admits uniformly bounded lifts, `restrictedMap φ hφ` identifies the quotient of `R{X/c}` by its
coefficientwise kernel with `S{X/c}`. At positive polyradii it is a homeomorphism for the quotient
and Gauss norm topologies (`continuous_restrictedMapQuotientEquiv` and `_symm`). -/
noncomputable def restrictedMapQuotientEquiv {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) :
    (IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) ≃+*
      IsRestricted.subring (R := S) c :=
  (restrictedMap (c := c) φ hφ).quotientKerEquivOfSurjective
    (restrictedMap_surjective φ hφ hlift)

/-- `restrictedMapQuotientEquiv` acts as `restrictedMap` on residue classes. -/
@[simp]
theorem restrictedMapQuotientEquiv_mk {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (f : IsRestricted.subring (R := R) c) :
    restrictedMapQuotientEquiv φ hφ hlift (Ideal.Quotient.mk _ f) = restrictedMap φ hφ f :=
  (rfl)

/-- The inverse of `restrictedMapQuotientEquiv` sends `restrictedMap φ hφ f` to the class of `f`. -/
@[simp]
theorem restrictedMapQuotientEquiv_symm_restrictedMap {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (f : IsRestricted.subring (R := R) c) :
    (restrictedMapQuotientEquiv φ hφ hlift).symm (restrictedMap φ hφ f) =
      Ideal.Quotient.mk _ f :=
  RingHom.quotientKerEquivOfSurjective_symm_apply (restrictedMap_surjective φ hφ hlift) f

/-- `restrictedMapQuotientEquiv` agrees on elements with `RingHom.kerLift`. -/
theorem restrictedMapQuotientEquiv_apply_eq_kerLift {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    restrictedMapQuotientEquiv φ hφ hlift x = (restrictedMap (c := c) φ hφ).kerLift x :=
  (rfl)

/-- **Isometric quotient ring isomorphism from sharp coefficient lifts.** For a bounded coefficient
homomorphism `φ : R →+* S` with sharp preimage bounds, this is the ring isomorphism
`R{X/c} ⧸ ker (restrictedMap φ hφ) ≃+* S{X/c}`; at positive polyradii with contractive `φ` it is an
isometry in both directions (`isometry_restrictedMapSharpQuotientEquiv` and `_symm`). -/
noncomputable def restrictedMapSharpQuotientEquiv
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    (IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) ≃+*
      IsRestricted.subring (R := S) c :=
  restrictedMapQuotientEquiv φ hφ
    (exists_norm_le_of_forall_pos_lt_add φ hsharp one_lt_two)

/-- `restrictedMapSharpQuotientEquiv` acts as `restrictedMap` on residue classes. -/
@[simp]
theorem restrictedMapSharpQuotientEquiv_mk
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (f : IsRestricted.subring (R := R) c) :
    restrictedMapSharpQuotientEquiv φ hφ hsharp (Ideal.Quotient.mk _ f) = restrictedMap φ hφ f :=
  (rfl)

/-- The inverse of `restrictedMapSharpQuotientEquiv` sends `restrictedMap φ hφ f` to the class of
`f`. -/
@[simp]
theorem restrictedMapSharpQuotientEquiv_symm_restrictedMap
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (f : IsRestricted.subring (R := R) c) :
    (restrictedMapSharpQuotientEquiv φ hφ hsharp).symm (restrictedMap φ hφ f) =
      Ideal.Quotient.mk _ f :=
  restrictedMapQuotientEquiv_symm_restrictedMap φ hφ _ f

end AlgebraicSharp

section GaussNorm

variable {σ R S : Type*} [NormedRing R] [IsUltrametricDist R]
  [NormedRing S] [IsUltrametricDist S] {c : σ → ℝ}
  (φ : R →+* S) {C : ℝ} (hφ : ∀ a, ‖φ a‖ ≤ C * ‖a‖)

variable [∀ i, Fact (0 < c i)]

/-- A bound on coefficient lifts is also a bound on lifts for the Gauss norm. -/
theorem exists_restrictedMap_eq_and_norm_le {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (g : IsRestricted.subring (R := S) c) :
    ∃ f, restrictedMap φ hφ f = g ∧ ‖f‖ ≤ L * ‖g‖ := by
  obtain ⟨f, hf, hcoeff⟩ := exists_restrictedMap_eq_and_norm_coeff_le φ hφ hlift g
  exact ⟨f, hf, norm_le_mul_of_norm_coeff_le hcoeff⟩

/-- Uniformly bounded coefficient lifts make the induced map of restricted series open. -/
theorem isOpenMap_restrictedMap {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) :
    IsOpenMap (restrictedMap (c := c) φ hφ) :=
  isOpenMap_of_exists_norm_le _ (exists_restrictedMap_eq_and_norm_le φ hφ hlift)

/-- A bounded coefficient homomorphism with uniformly bounded lifts induces a quotient map
for the Gauss norm topologies at arbitrary positive polyradii. -/
theorem isQuotientMap_restrictedMap {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) :
    Topology.IsQuotientMap (restrictedMap (c := c) φ hφ) :=
  (isOpenMap_restrictedMap φ hφ hlift).isQuotientMap
    (continuous_restrictedMap φ hφ) (restrictedMap_surjective φ hφ hlift)

/-- The kernel of `restrictedMap` is closed for the Gauss norm topology, so the quotient ring
`R{X/c} ⧸ ker (restrictedMap φ hφ)` is a normed ring under `Ideal.Quotient.normedRing`. -/
instance isClosed_ker_restrictedMap :
    IsClosed (RingHom.ker (restrictedMap (c := c) φ hφ) :
      Set (IsRestricted.subring (R := R) c)) := by
  have hpre : (RingHom.ker (restrictedMap (c := c) φ hφ) :
      Set (IsRestricted.subring (R := R) c)) = restrictedMap φ hφ ⁻¹' {0} := by
    ext f
    simp
  rw [hpre]
  exact isClosed_singleton.preimage (continuous_restrictedMap φ hφ)

/-- Descending `restrictedMap` to the quotient by its kernel preserves the norm bound `C`. -/
theorem norm_kerLift_restrictedMap_le
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    ‖(restrictedMap (c := c) φ hφ).kerLift x‖ ≤ C * ‖x‖ := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.kerLift_mk]
  rcases le_or_gt C 0 with hC | hC
  · exact (norm_restrictedMap_le φ hφ f).trans
      (mul_le_mul_of_nonpos_left (Ideal.Quotient.norm_mk_le_norm _ f) hC)
  · refine (div_le_iff₀' hC).mp (QuotientAddGroup.le_norm_iff.mpr fun g hg ↦ ?_)
    have hgf : restrictedMap φ hφ g = restrictedMap φ hφ f := by
      have hmk : Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) g =
          Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) f := hg
      simpa only [RingHom.kerLift_mk] using
        congrArg (restrictedMap (c := c) φ hφ).kerLift hmk
    exact (div_le_iff₀' hC).mpr (hgf ▸ norm_restrictedMap_le φ hφ g)

/-- `restrictedMapQuotientEquiv` is bounded by `C` for the quotient Gauss norm. -/
theorem norm_restrictedMapQuotientEquiv_le {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    ‖restrictedMapQuotientEquiv φ hφ hlift x‖ ≤ C * ‖x‖ :=
  norm_kerLift_restrictedMap_le φ hφ x

/-- The inverse of `restrictedMapQuotientEquiv` is bounded by the coefficient-lift constant `L`. -/
theorem norm_restrictedMapQuotientEquiv_symm_le {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖)
    (g : IsRestricted.subring (R := S) c) :
    ‖(restrictedMapQuotientEquiv φ hφ hlift).symm g‖ ≤ L * ‖g‖ := by
  obtain ⟨f, rfl, hfn⟩ := exists_restrictedMap_eq_and_norm_le φ hφ hlift g
  rw [restrictedMapQuotientEquiv_symm_restrictedMap]
  exact (Ideal.Quotient.norm_mk_le_norm _ f).trans hfn

/-- `restrictedMapQuotientEquiv` is continuous for the quotient and Gauss norm topologies. -/
@[continuity]
theorem continuous_restrictedMapQuotientEquiv {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) :
    Continuous (restrictedMapQuotientEquiv (c := c) φ hφ hlift) :=
  (AddMonoidHomClass.lipschitz_of_bound (restrictedMapQuotientEquiv (c := c) φ hφ hlift) C
    (norm_restrictedMapQuotientEquiv_le φ hφ hlift)).continuous

/-- The inverse of `restrictedMapQuotientEquiv` is continuous for the Gauss and quotient norm
topologies. -/
@[continuity]
theorem continuous_restrictedMapQuotientEquiv_symm {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) :
    Continuous (restrictedMapQuotientEquiv (c := c) φ hφ hlift).symm :=
  (AddMonoidHomClass.lipschitz_of_bound (restrictedMapQuotientEquiv (c := c) φ hφ hlift).symm L
    (norm_restrictedMapQuotientEquiv_symm_le φ hφ hlift)).continuous

/-! ### Sharp lifts and isometric quotients -/

/-- Sharp coefficient lifts yield restricted lifts with any multiplicative Gauss-norm bound
`L > 1`. -/
theorem exists_restrictedMap_eq_and_norm_le_of_forall_pos_lt_add
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) {L : ℝ} (hL : 1 < L)
    (g : IsRestricted.subring (R := S) c) :
    ∃ f, restrictedMap φ hφ f = g ∧ ‖f‖ ≤ L * ‖g‖ :=
  exists_restrictedMap_eq_and_norm_le φ hφ
    (exists_norm_le_of_forall_pos_lt_add φ hsharp hL) g

/-- **Sharp coefficient lifts pass to restricted power series.** If every `b : S` lifts to `a : R`
with `‖a‖ < ‖b‖ + ε` for every `ε > 0`, then every restricted series `g` over `S` lifts to a
restricted series `f` over `R` with `‖f‖ < ‖g‖ + ε`. -/
theorem exists_restrictedMap_eq_and_norm_lt
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (g : IsRestricted.subring (R := S) c) {ε : ℝ} (hε : 0 < ε) :
    ∃ f, restrictedMap φ hφ f = g ∧ ‖f‖ < ‖g‖ + ε := by
  by_cases hg : g = 0
  · exact ⟨0, by simp [hg], by simpa [hg] using hε⟩
  · have hgpos : 0 < ‖g‖ := norm_pos_iff.mpr hg
    have hL : 1 < 1 + ε / (2 * ‖g‖) :=
      lt_add_of_pos_right 1 (div_pos hε (mul_pos two_pos hgpos))
    obtain ⟨f, hf, hfn⟩ :=
      exists_restrictedMap_eq_and_norm_le_of_forall_pos_lt_add φ hφ hsharp hL g
    refine ⟨f, hf, hfn.trans_lt ?_⟩
    have hmul : (1 + ε / (2 * ‖g‖)) * ‖g‖ = ‖g‖ + ε / 2 := by
      have hne : ‖g‖ ≠ 0 := hgpos.ne'
      field_simp
    rw [hmul]
    exact add_lt_add_right (half_lt_self hε) ‖g‖

/-- Sharp coefficient lifts make `restrictedMap` an open map for the Gauss norm topologies. -/
theorem isOpenMap_restrictedMap_of_forall_pos_lt_add
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    IsOpenMap (restrictedMap (c := c) φ hφ) :=
  isOpenMap_restrictedMap φ hφ (exists_norm_le_of_forall_pos_lt_add φ hsharp one_lt_two)

/-- Sharp coefficient lifts make `restrictedMap` a topological quotient map. -/
theorem isQuotientMap_restrictedMap_of_forall_pos_lt_add
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Topology.IsQuotientMap (restrictedMap (c := c) φ hφ) :=
  isQuotientMap_restrictedMap φ hφ (exists_norm_le_of_forall_pos_lt_add φ hsharp one_lt_two)

/-- **Quotient Gauss norm for a contractive coefficient map with sharp lifts.** If `φ` does not
increase norms and every element of `S` has preimages with norm arbitrarily close to its norm, then
the quotient Gauss norm of `f` modulo `ker (restrictedMap φ hφ)` equals
`‖restrictedMap φ hφ f‖`. -/
theorem norm_mk_ker_restrictedMap (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (f : IsRestricted.subring (R := R) c) :
    ‖Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) f‖ =
      ‖restrictedMap φ hφ f‖ := by
  have hle (g : IsRestricted.subring (R := R) c) : ‖restrictedMap φ hφ g‖ ≤ ‖g‖ := by
    simpa only [one_mul] using
      norm_le_mul_of_norm_coeff_le (K := 1) fun t ↦ by
        rw [coeff_restrictedMap, one_mul]
        exact hφ₁ _
  apply le_antisymm
  · refine le_of_forall_pos_lt_add fun ε hε ↦ ?_
    obtain ⟨f', hf', hlt⟩ :=
      exists_restrictedMap_eq_and_norm_lt φ hφ hsharp (restrictedMap φ hφ f) hε
    have hmk : Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) f =
        Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) f' :=
      Ideal.Quotient.eq.mpr (RingHom.mem_ker.mpr (by rw [map_sub, hf', sub_self]))
    exact (hmk ▸ Ideal.Quotient.norm_mk_le_norm _ f').trans_lt hlt
  · refine QuotientAddGroup.le_norm_iff.mpr fun g hg ↦ ?_
    have hgf : restrictedMap φ hφ g = restrictedMap φ hφ f := by
      have hmk : Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) g =
          Ideal.Quotient.mk (RingHom.ker (restrictedMap (c := c) φ hφ)) f := hg
      simpa only [RingHom.kerLift_mk] using
        congrArg (restrictedMap (c := c) φ hφ).kerLift hmk
    exact hgf ▸ hle g

/-- Under contractivity and sharp coefficient lifts, `kerLift` of `restrictedMap` preserves
norms. -/
theorem norm_kerLift_restrictedMap (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    ‖(restrictedMap (c := c) φ hφ).kerLift x‖ = ‖x‖ := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.kerLift_mk, norm_mk_ker_restrictedMap φ hφ hφ₁ hsharp]

/-- Under contractivity and sharp coefficient lifts, `kerLift` of `restrictedMap` is an isometry. -/
theorem isometry_kerLift_restrictedMap (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Isometry (restrictedMap (c := c) φ hφ).kerLift :=
  AddMonoidHomClass.isometry_of_norm _ (norm_kerLift_restrictedMap φ hφ hφ₁ hsharp)

/-- Under contractivity and sharp coefficient lifts, `restrictedMapQuotientEquiv` is norm-preserving
for any uniform-lift witness `hlift`. -/
theorem norm_restrictedMapQuotientEquiv {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    ‖restrictedMapQuotientEquiv φ hφ hlift x‖ = ‖x‖ :=
  norm_kerLift_restrictedMap φ hφ hφ₁ hsharp x

/-- Under contractivity and sharp coefficient lifts, `restrictedMapQuotientEquiv` is an isometry. -/
theorem isometry_restrictedMapQuotientEquiv {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Isometry (restrictedMapQuotientEquiv (c := c) φ hφ hlift) :=
  AddMonoidHomClass.isometry_of_norm _ (norm_restrictedMapQuotientEquiv φ hφ hlift hφ₁ hsharp)

/-- Under contractivity and sharp coefficient lifts, the inverse of `restrictedMapQuotientEquiv`
is an isometry. -/
theorem isometry_restrictedMapQuotientEquiv_symm {L : ℝ}
    (hlift : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ L * ‖b‖) (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Isometry (restrictedMapQuotientEquiv (c := c) φ hφ hlift).symm :=
  AddMonoidHomClass.isometry_of_norm _ fun g ↦ by
    obtain ⟨x, rfl⟩ := (restrictedMapQuotientEquiv (c := c) φ hφ hlift).surjective g
    rw [RingEquiv.symm_apply_apply, norm_restrictedMapQuotientEquiv φ hφ hlift hφ₁ hsharp]

/-- `restrictedMapSharpQuotientEquiv` preserves norms when `φ` is contractive. -/
theorem norm_restrictedMapSharpQuotientEquiv (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε)
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (restrictedMap (c := c) φ hφ)) :
    ‖restrictedMapSharpQuotientEquiv φ hφ hsharp x‖ = ‖x‖ :=
  norm_restrictedMapQuotientEquiv φ hφ _ hφ₁ hsharp x

/-- `restrictedMapSharpQuotientEquiv` is an isometry when `φ` is contractive. -/
theorem isometry_restrictedMapSharpQuotientEquiv (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Isometry (restrictedMapSharpQuotientEquiv (c := c) φ hφ hsharp) :=
  isometry_restrictedMapQuotientEquiv φ hφ _ hφ₁ hsharp

/-- The inverse of `restrictedMapSharpQuotientEquiv` is an isometry when `φ` is contractive. -/
theorem isometry_restrictedMapSharpQuotientEquiv_symm (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε) :
    Isometry (restrictedMapSharpQuotientEquiv (c := c) φ hφ hsharp).symm :=
  isometry_restrictedMapQuotientEquiv_symm φ hφ _ hφ₁ hsharp

/-! ### Exact norm-attaining lifts -/

/-- If `φ` is contractive and every `b : S` lifts to `a : R` with `‖a‖ ≤ ‖b‖`, then every
restricted series `g` over `S` lifts to `f` over `R` with exact equality `‖f‖ = ‖g‖`. -/
theorem exists_restrictedMap_eq_and_norm_eq (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hlift₁ : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ ‖b‖)
    (g : IsRestricted.subring (R := S) c) :
    ∃ f, restrictedMap φ hφ f = g ∧ ‖f‖ = ‖g‖ := by
  have hlift₁' : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ 1 * ‖b‖ := fun b ↦ by
    simpa only [one_mul] using hlift₁ b
  obtain ⟨f, rfl, hfn⟩ := exists_restrictedMap_eq_and_norm_le φ hφ hlift₁' g
  refine ⟨f, rfl, le_antisymm (by simpa only [one_mul] using hfn) ?_⟩
  simpa only [one_mul] using
    norm_le_mul_of_norm_coeff_le (K := 1) fun t ↦ by
      rw [coeff_restrictedMap, one_mul]
      exact hφ₁ _

/-- If `φ` is contractive and every `b : S` lifts with `‖a‖ ≤ ‖b‖`, then every coset of
`ker (restrictedMap φ hφ)` has an element of least Gauss norm. -/
theorem exists_norm_sub_le_ker_restrictedMap (hφ₁ : ∀ a, ‖φ a‖ ≤ ‖a‖)
    (hlift₁ : ∀ b, ∃ a, φ a = b ∧ ‖a‖ ≤ ‖b‖)
    (f : IsRestricted.subring (R := R) c) :
    ∃ k ∈ RingHom.ker (restrictedMap (c := c) φ hφ),
      ∀ k' ∈ RingHom.ker (restrictedMap (c := c) φ hφ), ‖f - k‖ ≤ ‖f - k'‖ := by
  have hsharp : ∀ b, ∀ ε > 0, ∃ a, φ a = b ∧ ‖a‖ < ‖b‖ + ε := fun b ε hε ↦ by
    obtain ⟨a, ha, han⟩ := hlift₁ b
    exact ⟨a, ha, lt_of_le_of_lt han (lt_add_of_pos_right ‖b‖ hε)⟩
  refine Ideal.Quotient.exists_mk_eq_and_norm_eq_iff.mp (fun x ↦ ?_) f
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨f', hf', hnorm⟩ :=
    exists_restrictedMap_eq_and_norm_eq φ hφ hφ₁ hlift₁ (restrictedMap φ hφ g)
  refine ⟨f', Ideal.Quotient.eq.mpr (RingHom.mem_ker.mpr (by rw [map_sub, hf', sub_self])), ?_⟩
  rw [hnorm, norm_mk_ker_restrictedMap φ hφ hφ₁ hsharp]

end GaussNorm

end TauCeti.MvPowerSeries

namespace Ideal

open _root_.MvPowerSeries TauCeti.MvPowerSeries

section TwoSided

variable {σ R : Type*} [NormedRing R] [IsUltrametricDist R] {c : σ → ℝ}
  (I : Ideal R) [I.IsTwoSided] [IsClosed (I : Set R)]

/-- **Coefficientwise reduction modulo a closed two-sided ideal `I`** on restricted power series,
`R{X/c} →+* (R ⧸ I){X/c}`. -/
noncomputable def restrictedQuotientMk :
    IsRestricted.subring (R := R) c →+* IsRestricted.subring (R := R ⧸ I) c :=
  restrictedMap (Ideal.Quotient.mk I) (C := 1)
    (fun a ↦ by simpa only [one_mul] using Ideal.Quotient.norm_mk_le_norm I a)

/-- `Ideal.restrictedQuotientMk` acts on underlying power series by `MvPowerSeries.map`. -/
theorem coe_restrictedQuotientMk (f : IsRestricted.subring (R := R) c) :
    (I.restrictedQuotientMk f : MvPowerSeries σ (R ⧸ I)) =
      MvPowerSeries.map (Ideal.Quotient.mk I) f :=
  coe_restrictedMap _ _ f

/-- Each coefficient of `I.restrictedQuotientMk f` is the residue class of the corresponding
coefficient of `f`. -/
@[simp]
theorem coeff_restrictedQuotientMk (f : IsRestricted.subring (R := R) c) (t : σ →₀ ℕ) :
    coeff t (I.restrictedQuotientMk f : MvPowerSeries σ (R ⧸ I)) =
      Ideal.Quotient.mk I (coeff t (f : MvPowerSeries σ R)) :=
  coeff_restrictedMap _ _ f t

/-- A restricted series lies in `ker I.restrictedQuotientMk` precisely when every coefficient lies
in `I`. -/
theorem mem_ker_restrictedQuotientMk (f : IsRestricted.subring (R := R) c) :
    f ∈ RingHom.ker (I.restrictedQuotientMk (c := c)) ↔
      ∀ t, coeff t (f : MvPowerSeries σ R) ∈ I := by
  simp only [restrictedQuotientMk, mem_ker_restrictedMap, Ideal.mk_ker]

/-- Coefficient reduction modulo a closed two-sided ideal is surjective on restricted series at
arbitrary polyradii. -/
theorem restrictedQuotientMk_surjective :
    Function.Surjective (I.restrictedQuotientMk (c := c)) :=
  restrictedMap_surjective_of_forall_pos_lt_add _ _
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

/-- **Ring isomorphism `R{X/c} ⧸ ker I.restrictedQuotientMk ≃+* (R ⧸ I){X/c}`** for a closed
two-sided ideal `I`; at positive polyradii it is an isometry in both directions
(`isometry_restrictedQuotientMkEquiv` and `_symm`). -/
noncomputable def restrictedQuotientMkEquiv :
    (IsRestricted.subring (R := R) c ⧸ RingHom.ker (I.restrictedQuotientMk (c := c))) ≃+*
      IsRestricted.subring (R := R ⧸ I) c :=
  restrictedMapSharpQuotientEquiv _ _
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

/-- `Ideal.restrictedQuotientMkEquiv` acts as `Ideal.restrictedQuotientMk` on residue classes. -/
@[simp]
theorem restrictedQuotientMkEquiv_mk (f : IsRestricted.subring (R := R) c) :
    I.restrictedQuotientMkEquiv (Ideal.Quotient.mk _ f) = I.restrictedQuotientMk f :=
  (rfl)

/-- The inverse of `Ideal.restrictedQuotientMkEquiv` sends `I.restrictedQuotientMk f` to the class
of `f`. -/
@[simp]
theorem restrictedQuotientMkEquiv_symm_restrictedQuotientMk
    (f : IsRestricted.subring (R := R) c) :
    I.restrictedQuotientMkEquiv.symm (I.restrictedQuotientMk f) = Ideal.Quotient.mk _ f :=
  restrictedMapSharpQuotientEquiv_symm_restrictedMap _ _ _ f

variable [∀ i, Fact (0 < c i)]

/-- `Ideal.restrictedQuotientMk` does not increase the Gauss norm. -/
theorem norm_restrictedQuotientMk_le (f : IsRestricted.subring (R := R) c) :
    ‖I.restrictedQuotientMk (c := c) f‖ ≤ ‖f‖ := by
  rw [restrictedQuotientMk]
  simpa only [one_mul] using norm_restrictedMap_le (Ideal.Quotient.mk I) (C := 1)
    (fun a ↦ by simpa only [one_mul] using Ideal.Quotient.norm_mk_le_norm I a) f

/-- Every restricted series over `R ⧸ I` lifts to a restricted series over `R` of Gauss norm within
`ε` of its Gauss norm. -/
theorem exists_restrictedQuotientMk_eq_and_norm_lt
    (g : IsRestricted.subring (R := R ⧸ I) c) {ε : ℝ} (hε : 0 < ε) :
    ∃ f, I.restrictedQuotientMk f = g ∧ ‖f‖ < ‖g‖ + ε :=
  exists_restrictedMap_eq_and_norm_lt _ _
    (fun x _ hδ ↦ Ideal.Quotient.exists_norm_mk_lt x hδ) g hε

/-- When every residue class in `R ⧸ I` admits an exact norm-attaining representative, every
restricted series over `R ⧸ I` lifts to a restricted series over `R` of the exact same Gauss
norm. -/
theorem exists_restrictedQuotientMk_eq_and_norm_eq
    (hexact : ∀ x : R ⧸ I, ∃ a : R, Ideal.Quotient.mk I a = x ∧ ‖a‖ ≤ ‖x‖)
    (g : IsRestricted.subring (R := R ⧸ I) c) :
    ∃ f, I.restrictedQuotientMk f = g ∧ ‖f‖ = ‖g‖ :=
  exists_restrictedMap_eq_and_norm_eq _ _ (Ideal.Quotient.norm_mk_le_norm I) hexact g

/-- `Ideal.restrictedQuotientMk` is an open map for the Gauss norm topologies. -/
theorem isOpenMap_restrictedQuotientMk :
    IsOpenMap (I.restrictedQuotientMk (c := c)) :=
  isOpenMap_restrictedMap_of_forall_pos_lt_add _ _
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

/-- `Ideal.restrictedQuotientMk` is a quotient map for the Gauss norm topologies. -/
theorem isQuotientMap_restrictedQuotientMk :
    Topology.IsQuotientMap (I.restrictedQuotientMk (c := c)) :=
  isQuotientMap_restrictedMap_of_forall_pos_lt_add _ _
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

/-- The Gauss norm of `I.restrictedQuotientMk f` equals the quotient norm of `f` modulo
`ker I.restrictedQuotientMk`. -/
theorem norm_mk_ker_restrictedQuotientMk (f : IsRestricted.subring (R := R) c) :
    ‖Ideal.Quotient.mk (RingHom.ker (I.restrictedQuotientMk (c := c))) f‖ =
      ‖I.restrictedQuotientMk f‖ :=
  norm_mk_ker_restrictedMap _ _ (Ideal.Quotient.norm_mk_le_norm I)
    (fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε) f

/-- `Ideal.restrictedQuotientMkEquiv` preserves norms at positive polyradii. -/
theorem norm_restrictedQuotientMkEquiv
    (x : IsRestricted.subring (R := R) c ⧸ RingHom.ker (I.restrictedQuotientMk (c := c))) :
    ‖I.restrictedQuotientMkEquiv x‖ = ‖x‖ :=
  norm_restrictedMapSharpQuotientEquiv _ _ (Ideal.Quotient.norm_mk_le_norm I)
    (fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε) x

/-- `Ideal.restrictedQuotientMkEquiv` is an isometry. -/
theorem isometry_restrictedQuotientMkEquiv :
    Isometry (I.restrictedQuotientMkEquiv (c := c)) :=
  isometry_restrictedMapSharpQuotientEquiv _ _ (Ideal.Quotient.norm_mk_le_norm I)
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

/-- The inverse of `Ideal.restrictedQuotientMkEquiv` is an isometry. -/
theorem isometry_restrictedQuotientMkEquiv_symm :
    Isometry (I.restrictedQuotientMkEquiv (c := c)).symm :=
  isometry_restrictedMapSharpQuotientEquiv_symm _ _ (Ideal.Quotient.norm_mk_le_norm I)
    fun x _ hε ↦ Ideal.Quotient.exists_norm_mk_lt x hε

end TwoSided

section ExtendedIdeal

variable {σ R : Type*} [NormedCommRing R] [IsUltrametricDist R] {c : σ → ℝ}

/-- Every series in the extended ideal `I · R{X/c}` has all of its coefficients in `I`. -/
theorem coeff_mem_of_mem_map_algebraMap_isRestricted_subring (I : Ideal R)
    {f : IsRestricted.subring (R := R) c}
    (hf : f ∈ I.map (algebraMap R (IsRestricted.subring (R := R) c))) (t : σ →₀ ℕ) :
    coeff t (f : MvPowerSeries σ R) ∈ I := by
  have hC : (IsRestricted.subring (R := R) c).subtype.comp
      (algebraMap R (IsRestricted.subring (R := R) c)) = MvPowerSeries.C :=
    RingHom.ext fun r ↦ coe_algebraMap_isRestrictedSubring (c := c) r
  have hf' := Ideal.mem_map_of_mem (IsRestricted.subring (R := R) c).subtype hf
  rw [Ideal.map_map, hC] at hf'
  exact MvPowerSeries.coeff_mem_of_mem_map_C hf' t

/-- **Extended ideal membership from uniformly bounded finite generators.** If `I : Ideal R` admits
a finite subset `F ⊆ I` and a constant `L` such that every `y ∈ I` is a combination
`∑ x ∈ F, a x * x` with `‖a x‖ ≤ L * ‖y‖`, then a restricted series lies in `I · R{X/c}` if and
only if all of its coefficients lie in `I`. Neither positive radii nor completeness is needed. -/
theorem mem_map_algebraMap_isRestricted_subring_iff_of_exists_finset_sum_mul (I : Ideal R)
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖)
    {f : IsRestricted.subring (R := R) c} :
    f ∈ I.map (algebraMap R (IsRestricted.subring (R := R) c)) ↔
      ∀ t, coeff t (f : MvPowerSeries σ R) ∈ I := by
  refine ⟨coeff_mem_of_mem_map_algebraMap_isRestricted_subring I, fun hf ↦ ?_⟩
  classical
  -- Choose nonlinear bounded generator-coefficient maps `y ↦ π y x` on all of `R` so each
  -- coordinate series `t ↦ π (coeff t f) x` is restricted by `MvPowerSeries.isRestricted_map`.
  let π : R → R → R := fun y ↦ if hy : y ∈ I then (hgen y hy).choose else 0
  have hπ_norm (x : F) (y : R) : ‖π y x.1‖ ≤ max L 0 * ‖y‖ := by
    dsimp only [π]
    split_ifs with hy
    · exact ((hgen y hy).choose_spec.2 x.1 x.2).trans
        (mul_le_mul_of_nonneg_right (le_max_left L 0) (norm_nonneg y))
    · simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg (le_max_right L 0) (norm_nonneg y)
  let G (x : F) : IsRestricted.subring (R := R) c :=
    ⟨fun t ↦ π (coeff t (f : MvPowerSeries σ R)) x.1,
      isRestricted_map c (fun y ↦ π y x.1) (hπ_norm x) f.2⟩
  have hcoeff_G (x : F) (t : σ →₀ ℕ) :
      coeff t (G x : MvPowerSeries σ R) = π (coeff t (f : MvPowerSeries σ R)) x.1 := (rfl)
  have hf_eq : f = ∑ x ∈ F.attach, G x * algebraMap R _ x.1 := by
    apply Subtype.ext
    ext t
    have hsum := map_sum (IsRestricted.subring (R := R) c).subtype
      (fun x : F ↦ G x * algebraMap R _ x.1) F.attach
    simp only [Subring.coe_subtype] at hsum
    rw [hsum, map_sum]
    have ht : π (coeff t (f : MvPowerSeries σ R)) = (hgen _ (hf t)).choose :=
      dite_eq_left (hf t)
    conv_lhs => rw [(hgen _ (hf t)).choose_spec.1, ← F.sum_attach]
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [MulMemClass.coe_mul, coe_algebraMap_isRestrictedSubring,
      mul_comm (G x : MvPowerSeries σ R), coeff_C_mul, hcoeff_G, ht, mul_comm]
  rw [hf_eq]
  exact Ideal.sum_mem _ fun x _ ↦
    Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hFI x.1 x.2))

/-- For `r : R` scaling norms multiplicatively (`‖a * r‖ = ‖a‖ * ‖r‖`), a restricted series lies in
`r · R{X/c}` if and only if every coefficient is divisible by `r`. -/
theorem mem_span_singleton_algebraMap_isRestricted_subring_iff (r : R)
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) {f : IsRestricted.subring (R := R) c} :
    f ∈ Ideal.span ({algebraMap R (IsRestricted.subring (R := R) c) r} :
        Set (IsRestricted.subring (R := R) c)) ↔
      ∀ t, coeff t (f : MvPowerSeries σ R) ∈ Ideal.span ({r} : Set R) := by
  rw [← Set.image_singleton (f := algebraMap R (IsRestricted.subring (R := R) c)),
    ← Ideal.map_span]
  refine mem_map_algebraMap_isRestricted_subring_iff_of_exists_finset_sum_mul
    (Ideal.span ({r} : Set R)) (F := {r}) (L := ‖r‖⁻¹)
    (fun x hx ↦ Ideal.subset_span (by simpa using hx)) fun y hy ↦ ?_
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  by_cases hr0 : r = 0
  · exact ⟨fun _ ↦ 0, by simp [hr0], fun _ _ ↦ by simp [hr0]⟩
  · have hpos : 0 < ‖r‖ := norm_pos_iff.mpr hr0
    refine ⟨fun _ ↦ b, by simp, fun _ _ ↦ ?_⟩
    rw [hr, mul_comm ‖b‖, inv_mul_cancel_left₀ hpos.ne']

/-- **Extended-ideal kernel formula.** For a closed ideal `I` with uniformly bounded finite
generators, the kernel of `I.restrictedQuotientMk : R{X/c} →+* (R ⧸ I){X/c}` is the extended ideal
`I · R{X/c}`. -/
theorem ker_restrictedQuotientMk_of_exists_finset_sum_mul (I : Ideal R) [IsClosed (I : Set R)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖) :
    RingHom.ker (I.restrictedQuotientMk (c := c)) =
      I.map (algebraMap R (IsRestricted.subring (R := R) c)) := by
  ext f
  rw [I.mem_ker_restrictedQuotientMk,
    mem_map_algebraMap_isRestricted_subring_iff_of_exists_finset_sum_mul I hFI hgen]

/-- For a closed ideal `I` with uniformly bounded finite generators, the extended ideal `I · R{X/c}`
is closed in `R{X/c}` at positive polyradii. -/
theorem isClosed_map_algebraMap_isRestricted_subring_of_exists_finset_sum_mul
    (I : Ideal R) [IsClosed (I : Set R)] [∀ i, Fact (0 < c i)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖) :
    IsClosed (I.map (algebraMap R (IsRestricted.subring (R := R) c)) :
      Set (IsRestricted.subring (R := R) c)) := by
  rw [← ker_restrictedQuotientMk_of_exists_finset_sum_mul I hFI hgen, restrictedQuotientMk]
  infer_instance

/-- **Ring isomorphism `R{X/c} ⧸ (I · R{X/c}) ≃+* (R ⧸ I){X/c}`** when `I` is closed and admits
uniformly bounded finite generators; at positive polyradii it is an isometry in both directions
(`isometry_isRestrictedQuotientEquivQuotientIsRestricted` and `_symm`). -/
noncomputable def isRestrictedQuotientEquivQuotientIsRestricted (I : Ideal R) [IsClosed (I : Set R)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖) :
    (IsRestricted.subring (R := R) c ⧸ I.map (algebraMap R (IsRestricted.subring (R := R) c))) ≃+*
      IsRestricted.subring (R := R ⧸ I) c :=
  (Ideal.quotEquivOfEq
    (ker_restrictedQuotientMk_of_exists_finset_sum_mul I hFI hgen).symm).trans
    I.restrictedQuotientMkEquiv

/-- `Ideal.isRestrictedQuotientEquivQuotientIsRestricted` acts as `I.restrictedQuotientMk` on
residue classes. -/
@[simp]
theorem isRestrictedQuotientEquivQuotientIsRestricted_mk (I : Ideal R) [IsClosed (I : Set R)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖)
    (f : IsRestricted.subring (R := R) c) :
    isRestrictedQuotientEquivQuotientIsRestricted I hFI hgen (Ideal.Quotient.mk _ f) =
      I.restrictedQuotientMk f :=
  (rfl)

/-- The inverse of `Ideal.isRestrictedQuotientEquivQuotientIsRestricted` sends
`I.restrictedQuotientMk f` to the class of `f` modulo `I · R{X/c}`. -/
@[simp]
theorem isRestrictedQuotientEquivQuotientIsRestricted_symm_restrictedQuotientMk
    (I : Ideal R) [IsClosed (I : Set R)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖)
    (f : IsRestricted.subring (R := R) c) :
    (isRestrictedQuotientEquivQuotientIsRestricted I hFI hgen).symm (I.restrictedQuotientMk f) =
      Ideal.Quotient.mk _ f := by
  simp [isRestrictedQuotientEquivQuotientIsRestricted]

/-- `Ideal.isRestrictedQuotientEquivQuotientIsRestricted` preserves norms at positive polyradii. -/
theorem norm_isRestrictedQuotientEquivQuotientIsRestricted
    (I : Ideal R) [IsClosed (I : Set R)] [∀ i, Fact (0 < c i)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖)
    (x : IsRestricted.subring (R := R) c ⧸
      I.map (algebraMap R (IsRestricted.subring (R := R) c))) :
    ‖isRestrictedQuotientEquivQuotientIsRestricted I hFI hgen x‖ = ‖x‖ := by
  dsimp only [isRestrictedQuotientEquivQuotientIsRestricted, RingEquiv.trans_apply]
  rw [I.norm_restrictedQuotientMkEquiv, Ideal.norm_quotEquivOfEq]

/-- `Ideal.isRestrictedQuotientEquivQuotientIsRestricted` is an isometry at positive polyradii. -/
theorem isometry_isRestrictedQuotientEquivQuotientIsRestricted
    (I : Ideal R) [IsClosed (I : Set R)] [∀ i, Fact (0 < c i)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖) :
    Isometry (isRestrictedQuotientEquivQuotientIsRestricted (c := c) I hFI hgen) :=
  AddMonoidHomClass.isometry_of_norm _
    (norm_isRestrictedQuotientEquivQuotientIsRestricted I hFI hgen)

/-- The inverse of `Ideal.isRestrictedQuotientEquivQuotientIsRestricted` is an isometry at positive
polyradii. -/
theorem isometry_isRestrictedQuotientEquivQuotientIsRestricted_symm
    (I : Ideal R) [IsClosed (I : Set R)] [∀ i, Fact (0 < c i)]
    {F : Finset R} (hFI : ∀ x ∈ F, x ∈ I) {L : ℝ}
    (hgen : ∀ y ∈ I, ∃ a : R → R, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ ≤ L * ‖y‖) :
    Isometry (isRestrictedQuotientEquivQuotientIsRestricted (c := c) I hFI hgen).symm :=
  AddMonoidHomClass.isometry_of_norm _ fun g ↦ by
    obtain ⟨x, rfl⟩ :=
      (isRestrictedQuotientEquivQuotientIsRestricted (c := c) I hFI hgen).surjective g
    rw [RingEquiv.symm_apply_apply, norm_isRestrictedQuotientEquivQuotientIsRestricted]

/-- For a closed principal ideal generated by `r : R` scaling norms multiplicatively, the kernel of
`(Ideal.span {r}).restrictedQuotientMk` is `Ideal.span {algebraMap R _ r}`. -/
theorem ker_restrictedQuotientMk_span_singleton_of_norm_mul (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) :
    RingHom.ker ((Ideal.span ({r} : Set R)).restrictedQuotientMk (c := c)) =
      Ideal.span ({algebraMap R (IsRestricted.subring (R := R) c) r} :
        Set (IsRestricted.subring (R := R) c)) := by
  ext f
  rw [(Ideal.span ({r} : Set R)).mem_ker_restrictedQuotientMk,
    mem_span_singleton_algebraMap_isRestricted_subring_iff r hr]

/-- **Isometric principal-ideal quotient isomorphism `R{X/c} ⧸ (r) ≃+* (R ⧸ (r)){X/c}`** for an
element `r : R` scaling norms multiplicatively whose principal ideal is closed (automatic when `R`
is complete by `Ideal.isClosed_span_singleton_of_norm_mul`). -/
noncomputable def spanSingletonIsRestrictedQuotientEquiv (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) :
    (IsRestricted.subring (R := R) c ⧸
        Ideal.span ({algebraMap R (IsRestricted.subring (R := R) c) r} :
          Set (IsRestricted.subring (R := R) c))) ≃+*
      IsRestricted.subring (R := R ⧸ Ideal.span ({r} : Set R)) c :=
  (Ideal.quotEquivOfEq (ker_restrictedQuotientMk_span_singleton_of_norm_mul r hr).symm).trans
    (Ideal.span ({r} : Set R)).restrictedQuotientMkEquiv

/-- `Ideal.spanSingletonIsRestrictedQuotientEquiv` acts as `restrictedQuotientMk` on residue
classes. -/
@[simp]
theorem spanSingletonIsRestrictedQuotientEquiv_mk (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) (f : IsRestricted.subring (R := R) c) :
    spanSingletonIsRestrictedQuotientEquiv r hr (Ideal.Quotient.mk _ f) =
      (Ideal.span ({r} : Set R)).restrictedQuotientMk f :=
  (rfl)

/-- `Ideal.spanSingletonIsRestrictedQuotientEquiv` preserves norms at positive polyradii. -/
theorem norm_spanSingletonIsRestrictedQuotientEquiv (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)] [∀ i, Fact (0 < c i)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖)
    (x : IsRestricted.subring (R := R) c ⧸
      Ideal.span ({algebraMap R (IsRestricted.subring (R := R) c) r} :
        Set (IsRestricted.subring (R := R) c))) :
    ‖spanSingletonIsRestrictedQuotientEquiv r hr x‖ = ‖x‖ := by
  dsimp only [spanSingletonIsRestrictedQuotientEquiv, RingEquiv.trans_apply]
  rw [(Ideal.span ({r} : Set R)).norm_restrictedQuotientMkEquiv, Ideal.norm_quotEquivOfEq]

/-- `Ideal.spanSingletonIsRestrictedQuotientEquiv` is an isometry at positive polyradii. -/
theorem isometry_spanSingletonIsRestrictedQuotientEquiv (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)] [∀ i, Fact (0 < c i)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) :
    Isometry (spanSingletonIsRestrictedQuotientEquiv (c := c) r hr) :=
  AddMonoidHomClass.isometry_of_norm _ (norm_spanSingletonIsRestrictedQuotientEquiv r hr)

/-- The inverse of `Ideal.spanSingletonIsRestrictedQuotientEquiv` is an isometry at positive
polyradii. -/
theorem isometry_spanSingletonIsRestrictedQuotientEquiv_symm (r : R)
    [IsClosed (Ideal.span ({r} : Set R) : Set R)] [∀ i, Fact (0 < c i)]
    (hr : ∀ a : R, ‖a * r‖ = ‖a‖ * ‖r‖) :
    Isometry (spanSingletonIsRestrictedQuotientEquiv (c := c) r hr).symm :=
  AddMonoidHomClass.isometry_of_norm _ fun g ↦ by
    obtain ⟨x, rfl⟩ := (spanSingletonIsRestrictedQuotientEquiv (c := c) r hr).surjective g
    rw [RingEquiv.symm_apply_apply, norm_spanSingletonIsRestrictedQuotientEquiv r hr]

end ExtendedIdeal

end Ideal
