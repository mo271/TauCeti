/-!
# Localization of the nonnegative Novikov subring

Let `H` be an additive commutative group with a period homomorphism `N : H →+ ℝ` and `R` a
commutative ring. The nonnegative Novikov subring `nonnegSubring R N` acts on `NovikovSeries R H N`
via Mathlib's subring algebra instance (`Algebra.ofSubsemiring`). Every series `z` in
`NovikovSeries R H N` vanishes below some period `C`; hence whenever a multiplicative submonoid
`S ≤ nonnegSubring R N` consists of units of `NovikovSeries R H N` and meets every filtration piece
`periodFiltration R N C`, multiplying `z` by a suitable element of `S` moves it into
`nonnegSubring R N`, making `NovikovSeries R H N` the localization `S⁻¹ (nonnegSubring R N)`
(`isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration`).

In particular, for any additive submonoid `M ≤ H`, the multiplicative submonoid
`monomialSubmonoid R N M` of `nonnegSubring R N` consisting of unit-coefficient monomials `e^g`
with `g ∈ M` realizes `NovikovSeries R H N` as a localization of `nonnegSubring R N` as soon as
`N` is unbounded above on `M` — for example whenever `M` contains a single strictly positive-period
element `g`. Taking `M` to be generated by a single `g` with `0 < N g` shows that
`NovikovSeries R H N` is the principal localization away from `e^g` (`isLocalization_away_single`),
regardless of whether the period group is discrete or dense. Taking all nonnegative-period
monomials gives `isLocalization_nonnegMonomials` whenever `N ≠ 0`, and in particular for the real
Novikov ring `NovikovSeries R ℝ (AddMonoidHom.id ℝ)`.

Over a field `K` with an injective period homomorphism `N`, every nonzero series is a unit of
`NovikovSeries K H N` (`isUnit_of_injective`), and `NovikovSeries K H N` is the field of fractions
of the local domain `nonnegSubring K N` (`isFractionRing_nonnegSubring_of_injective`), including
the degenerate case `N = 0` (where `H` is trivial). For `N = AddMonoidHom.id ℝ`, this identifies
the bounded-below real Novikov field `NovikovSeries K ℝ (AddMonoidHom.id ℝ)` as the fraction ring
of its nonnegative subring.

## Main definitions

* `TauCeti.NovikovSeries.nonnegPeriodSubmonoid`: the additive submonoid `{g : H | 0 ≤ N g}` of
  nonnegative-period exponents.
* `TauCeti.NovikovSeries.monomialSubmonoid`: the multiplicative submonoid of `nonnegSubring R N`
  consisting of monomials `e^g` with `g ∈ M` for any additive submonoid `M ≤ H`.
* `TauCeti.NovikovSeries.nonnegMonomials`: the submonoid of all nonnegative-period monomials
  `{e^g | 0 ≤ N g}` in `nonnegSubring R N`.

## Main results

* `TauCeti.NovikovSeries.nonnegMonomials_eq_monomialSubmonoid_top`: `nonnegMonomials R N` agrees
  with `monomialSubmonoid R N ⊤`.
* `TauCeti.NovikovSeries.isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration`: general
  criterion for `NovikovSeries R H N` to be the localization of `nonnegSubring R N` at a submonoid
  `S`.
* `TauCeti.NovikovSeries.isLocalization_monomialSubmonoid` and
  `TauCeti.NovikovSeries.isLocalization_monomialSubmonoid_of_exists_pos`: localizing
  `nonnegSubring R N` at monomials from a cofinal submonoid (or any submonoid containing a
  positive-period element) recovers `NovikovSeries R H N`.
* `TauCeti.NovikovSeries.isLocalization_away_single`: for any `g` with `0 < N g`,
  `NovikovSeries R H N` is the localization of `nonnegSubring R N` away from `e^g`.
* `TauCeti.NovikovSeries.isLocalization_nonnegMonomials`: whenever `N ≠ 0`, `NovikovSeries R H N`
  is the localization of `nonnegSubring R N` at `nonnegMonomials R N`.
* `TauCeti.NovikovSeries.nonnegMonomials_eq_closure_pos_of_injective`: when `N` is injective, the
  nonnegative monomials equal the submonoid generated by the strictly positive-period monomials.
* `TauCeti.NovikovSeries.isFractionRing_nonnegSubring_of_injective`: over a field with injective
  period homomorphism, `NovikovSeries K H N` is a fraction ring of `nonnegSubring K N`.

## References

* M. Hutchings, *Reidemeister torsion in generalized Morse theory*, Forum Math. 14 (2002),
  Section 2.
* K. Fukaya, Y.-G. Oh, H. Ohta, and K. Ono, *Lagrangian Intersection Floer Theory: Anomaly and
  Obstruction*, AMS/IP Studies in Advanced Mathematics 46 (2009), Chapter 3.
-/

public section

noncomputable section

open scoped nonZeroDivisors

namespace TauCeti

namespace NovikovSeries

variable {R H : Type*}

section MonomialSubmonoid

variable [AddMonoid H] {N : H →+ ℝ}

/-- The additive submonoid of exponents with nonnegative period `0 ≤ N g`. -/
def nonnegPeriodSubmonoid (N : H →+ ℝ) : AddSubmonoid H where
  carrier := {g | 0 ≤ N g}
  zero_mem' := by simp
  add_mem' ha hb := by simpa only [Set.mem_ofPred_eq, map_add] using add_nonneg ha hb

@[simp]
theorem mem_nonnegPeriodSubmonoid {g : H} : g ∈ nonnegPeriodSubmonoid N ↔ 0 ≤ N g :=
  Iff.rfl

variable [Ring R]

variable (R N) in
/-- The multiplicative submonoid of `nonnegSubring R N` consisting of unit-coefficient monomials
`e^g` with exponent `g` in an additive submonoid `M ≤ H`. -/
def monomialSubmonoid (M : AddSubmonoid H) : Submonoid (nonnegSubring R N) where
  carrier := {a | ∃ g ∈ M, (a : NovikovSeries R H N) = single g 1}
  one_mem' := ⟨0, M.zero_mem, by simp⟩
  mul_mem' := by
    rintro a b ⟨g₁, hg₁, ha⟩ ⟨g₂, hg₂, hb⟩
    refine ⟨g₁ + g₂, M.add_mem hg₁ hg₂, ?_⟩
    rw [MulMemClass.coe_mul, ha, hb, single_mul_single, mul_one]

@[simp]
theorem mem_monomialSubmonoid {M : AddSubmonoid H} {a : nonnegSubring R N} :
    a ∈ monomialSubmonoid R N M ↔ ∃ g ∈ M, (a : NovikovSeries R H N) = single g 1 :=
  Iff.rfl

/-- Every nonnegative-period exponent `g ∈ M` yields a monomial in `monomialSubmonoid R N M`. -/
theorem single_mem_monomialSubmonoid {M : AddSubmonoid H} {g : H} (hg : g ∈ M)
    (hNg : 0 ≤ N g) :
    (⟨single g 1, single_mem_nonnegSubring hNg 1⟩ : nonnegSubring R N) ∈
      monomialSubmonoid R N M :=
  ⟨g, hg, rfl⟩

/-- `monomialSubmonoid` is monotone in the exponent submonoid `M`. -/
theorem monomialSubmonoid_mono {M₁ M₂ : AddSubmonoid H} (hle : M₁ ≤ M₂) :
    monomialSubmonoid R N M₁ ≤ monomialSubmonoid R N M₂ :=
  fun _ ⟨g, hg, ha⟩ => ⟨g, hle hg, ha⟩

variable (R N) in
/-- The submonoid of all nonnegative-period monomials `{e^g | 0 ≤ N g}` in `nonnegSubring R N`. -/
def nonnegMonomials : Submonoid (nonnegSubring R N) :=
  monomialSubmonoid R N (nonnegPeriodSubmonoid N)

@[simp]
theorem mem_nonnegMonomials {a : nonnegSubring R N} :
    a ∈ nonnegMonomials R N ↔ ∃ g : H, 0 ≤ N g ∧ (a : NovikovSeries R H N) = single g 1 :=
  Iff.rfl

/-- A monomial `e^g` with `0 ≤ N g` belongs to `nonnegMonomials R N`. -/
theorem single_mem_nonnegMonomials {g : H} (hg : 0 ≤ N g) :
    (⟨single g 1, single_mem_nonnegSubring hg 1⟩ : nonnegSubring R N) ∈ nonnegMonomials R N :=
  ⟨g, hg, rfl⟩

variable (R N) in
/-- Every monomial lying in `nonnegSubring R N` already belongs to `nonnegMonomials R N`, even
when `R` is trivial. -/
theorem nonnegMonomials_eq_monomialSubmonoid_top :
    nonnegMonomials R N = monomialSubmonoid R N ⊤ := by
  refine le_antisymm (monomialSubmonoid_mono le_top) ?_
  rintro a ⟨g, -, ha⟩
  rcases subsingleton_or_nontrivial R with hsub | hnt
  · exact ⟨0, by simp, NovikovSeries.ext fun _ => Subsingleton.elim _ _⟩
  · refine ⟨g, mem_nonnegPeriodSubmonoid.2 (not_lt.1 fun hlt => ?_), ha⟩
    have h0 := mem_nonnegSubring.1 a.2 g hlt
    rw [ha, coeff_single_same] at h0
    exact one_ne_zero h0

/-- When `N` is injective, the nonnegative monomial submonoid is generated by the strictly
positive-period monomials `e^g` (`0 < N g`). -/
theorem nonnegMonomials_eq_closure_pos_of_injective (hN : Function.Injective N) :
    nonnegMonomials R N =
      Submonoid.closure {a : nonnegSubring R N |
        ∃ g : H, 0 < N g ∧ (a : NovikovSeries R H N) = single g 1} := by
  refine le_antisymm ?_ (Submonoid.closure_le.2 ?_)
  · rintro a ⟨g, hg, ha⟩
    have hg' : 0 ≤ N g := hg
    rcases hg'.eq_or_lt with h0 | hpos
    · have hg0 : g = 0 := hN (h0.symm.trans (map_zero N).symm)
      have ha1 : a = 1 := Subtype.ext (by simpa [hg0] using ha)
      rw [ha1]
      exact Submonoid.one_mem _
    · exact Submonoid.subset_closure ⟨g, hpos, ha⟩
  · rintro a ⟨g, hpos, ha⟩
    exact ⟨g, hpos.le, ha⟩

end MonomialSubmonoid

section ScalarTower

variable {S : Type*} [CommSemiring S] [CommRing R] [Algebra S R] [AddCommMonoid H] {N : H →+ ℝ}

/-- The base coefficient scalars act compatibly across `nonnegSubring R N` and
`NovikovSeries R H N`. -/
instance instIsScalarTowerNonnegSubring :
    IsScalarTower S (nonnegSubring R N) (NovikovSeries R H N) :=
  .of_algebraMap_eq' <| RingHom.ext fun _ => rfl

end ScalarTower

section GeneralLocalization

variable [AddCommMonoid H] {N : H →+ ℝ} [CommRing R]

/-- **General localization criterion for Novikov rings**: a submonoid `S ≤ nonnegSubring R N`
consisting of units of `NovikovSeries R H N` whose elements meet every filtration piece
`periodFiltration R N C` realizes `NovikovSeries R H N` as the localization of `nonnegSubring R N`
at `S`. -/
theorem isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration
    (S : Submonoid (nonnegSubring R N))
    (hunit : ∀ s ∈ S, IsUnit (s : NovikovSeries R H N))
    (hcofinal : ∀ C : ℝ, ∃ s ∈ S, (s : NovikovSeries R H N) ∈ periodFiltration R N C) :
    IsLocalization S (NovikovSeries R H N) where
  map_units y := hunit y y.2
  surj z := by
    obtain ⟨C, hC⟩ := exists_mem_periodFiltration z
    obtain ⟨s, hsS, hsC⟩ := hcofinal (-C)
    have hmul : z * (s : NovikovSeries R H N) ∈ nonnegSubring R N :=
      mem_nonnegSubring.2 <| mem_periodFiltration.1 <| by
        simpa only [add_neg_cancel] using mul_mem_periodFiltration hC hsC
    exact ⟨(⟨z * s, hmul⟩, ⟨s, hsS⟩), rfl⟩
  exists_of_eq hxy := ⟨1, by simp [Subtype.ext hxy]⟩

end GeneralLocalization

section GroupLocalization

variable [AddCommGroup H] {N : H →+ ℝ} [CommRing R]

/-- Localizing `nonnegSubring R N` at the monomials of an additive submonoid `M ≤ H` on which
`N` is unbounded above recovers `NovikovSeries R H N`. -/
theorem isLocalization_monomialSubmonoid (M : AddSubmonoid H)
    (hcofinal : ∀ C : ℝ, ∃ g ∈ M, C ≤ N g) :
    IsLocalization (monomialSubmonoid R N M) (NovikovSeries R H N) := by
  refine isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration _ ?_ ?_
  · rintro _ ⟨g, _, h⟩
    rw [h]
    exact isUnit_single g isUnit_one
  · intro C
    obtain ⟨g, hgM, hgC⟩ := hcofinal (max C 0)
    have h0 : 0 ≤ N g := (le_max_right C 0).trans hgC
    have hC : C ≤ N g := (le_max_left C 0).trans hgC
    exact ⟨⟨single g 1, single_mem_nonnegSubring h0 1⟩, ⟨g, hgM, rfl⟩,
      antitone_periodFiltration hC (single_mem_periodFiltration g 1)⟩

/-- Localizing `nonnegSubring R N` at the monomials of an additive submonoid `M ≤ H` containing a
strictly positive-period exponent recovers `NovikovSeries R H N`. -/
theorem isLocalization_monomialSubmonoid_of_exists_pos (M : AddSubmonoid H)
    {g : H} (hgM : g ∈ M) (hg : 0 < N g) :
    IsLocalization (monomialSubmonoid R N M) (NovikovSeries R H N) :=
  isLocalization_monomialSubmonoid M fun C => by
    obtain ⟨n, hn⟩ := exists_lt_nsmul hg C
    exact ⟨n • g, M.nsmul_mem hgM n, by simpa only [map_nsmul] using hn.le⟩

/-- For any exponent `g` of strictly positive period, `NovikovSeries R H N` is the principal
localization of `nonnegSubring R N` away from the monomial `e^g`. -/
theorem isLocalization_away_single {g : H} (hg : 0 < N g) :
    IsLocalization.Away
      (⟨single g 1, single_mem_nonnegSubring hg.le 1⟩ : nonnegSubring R N)
      (NovikovSeries R H N) := by
  refine isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration _ ?_ ?_
  · rintro s ⟨n, rfl⟩
    rw [SubmonoidClass.coe_pow]
    exact (isUnit_single g isUnit_one).pow n
  · intro C
    obtain ⟨n, hn⟩ := exists_lt_nsmul hg C
    refine ⟨⟨single g 1, single_mem_nonnegSubring hg.le 1⟩ ^ n, ⟨n, rfl⟩, ?_⟩
    rw [SubmonoidClass.coe_pow, single_pow, one_pow]
    exact antitone_periodFiltration (by simpa only [map_nsmul] using hn.le)
      (single_mem_periodFiltration (n • g) 1)

/-- Whenever `N ≠ 0`, `NovikovSeries R H N` is the localization of `nonnegSubring R N` at the
submonoid of all nonnegative-period monomials. -/
theorem isLocalization_nonnegMonomials (hN : N ≠ 0) :
    IsLocalization (nonnegMonomials R N) (NovikovSeries R H N) := by
  obtain ⟨g, hg⟩ := N.exists_pos_of_ne_zero hN
  exact isLocalization_monomialSubmonoid_of_exists_pos (nonnegPeriodSubmonoid N) hg.le hg

/-- For real periods `N = id : ℝ →+ ℝ`, `NovikovSeries R ℝ id` is the localization of its
nonnegative subring at the submonoid of nonnegative monomials `{e^r | 0 ≤ r}`. -/
instance isLocalization_nonnegMonomials_real :
    IsLocalization (nonnegMonomials R (AddMonoidHom.id ℝ))
      (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isLocalization_nonnegMonomials fun h => by
    have h1 := congrArg (fun f : ℝ →+ ℝ => f 1) h
    simp at h1

/-- For real periods `N = id : ℝ →+ ℝ`, `NovikovSeries R ℝ id` is the localization of its
nonnegative subring away from the single monomial `e^1`. -/
instance isLocalization_away_single_one_real :
    IsLocalization.Away
      (⟨single (1 : ℝ) 1, single_mem_nonnegSubring (by norm_num) 1⟩ :
        nonnegSubring R (AddMonoidHom.id ℝ))
      (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isLocalization_away_single (by norm_num)

end GroupLocalization

section FractionRing

variable {K : Type*} [Field K] [AddCommGroup H] {N : H →+ ℝ}

/-- Over a field with injective period homomorphism, `NovikovSeries K H N` is the field of
fractions of `nonnegSubring K N`. This includes the degenerate case `N = 0` (where `H` is
trivial). -/
theorem isFractionRing_nonnegSubring_of_injective (hN : Function.Injective N) :
    IsFractionRing (nonnegSubring K N) (NovikovSeries K H N) := by
  by_cases hN0 : N = 0
  · refine ⟨fun y => isUnit_of_injective hN fun h0 =>
        nonZeroDivisors.ne_zero y.2 (Subtype.ext h0),
      fun z => ?_, fun hxy => ⟨1, by simp [Subtype.ext hxy]⟩⟩
    have hz : z ∈ nonnegSubring K N := mem_nonnegSubring.2 fun h hh => by simp [hN0] at hh
    exact ⟨(⟨z, hz⟩, 1), by rw [OneMemClass.coe_one, _root_.map_one, mul_one]; rfl⟩
  · refine isLocalization_of_isUnit_of_forall_exists_mem_periodFiltration (nonnegSubring K N)⁰
      (fun s hs => isUnit_of_injective hN fun h0 => nonZeroDivisors.ne_zero hs (Subtype.ext h0))
      fun C => ?_
    obtain ⟨g, hg⟩ := N.exists_pos_of_ne_zero hN0
    obtain ⟨n, hn⟩ := exists_lt_nsmul hg C
    have hng : 0 ≤ N (n • g) := by simpa only [map_nsmul] using nsmul_nonneg hg.le n
    refine ⟨⟨single (n • g) 1, single_mem_nonnegSubring hng 1⟩, ?_,
      antitone_periodFiltration (by simpa only [map_nsmul] using hn.le)
        (single_mem_periodFiltration (n • g) 1)⟩
    refine mem_nonZeroDivisors_iff_left.2 fun x hx => Subtype.ext ?_
    exact (isUnit_single (n • g) isUnit_one).mul_right_eq_zero.1 (congrArg Subtype.val hx)

/-- Over a field `K`, the bounded-below real Novikov field `NovikovSeries K ℝ id` is the fraction
ring of its nonnegative subring `nonnegSubring K id`. -/
instance isFractionRing_nonnegSubring_real :
    IsFractionRing (nonnegSubring K (AddMonoidHom.id ℝ))
      (NovikovSeries K ℝ (AddMonoidHom.id ℝ)) :=
  isFractionRing_nonnegSubring_of_injective Function.injective_id

end FractionRing

end NovikovSeries

