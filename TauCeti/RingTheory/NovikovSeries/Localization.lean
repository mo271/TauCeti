/-!
# Localization of nonnegative Novikov series at nonnegative monomials

Every monomial `e^g` of nonnegative period `N g ≥ 0` defines an element `nonnegMonomial R hg` of
the nonnegative subring `Nov≥0(R, H, N)`. In the ambient Novikov ring `Nov(R, H, N)` every such
monomial is a unit with inverse `e^(-g)`, whereas over a nontrivial ring `nonnegMonomial R hg` is a
unit of `Nov≥0(R, H, N)` if and only if `N g = 0`: when `N g > 0` it belongs to `posIdeal R N`, a
proper two-sided ideal.

Because every Novikov series has only finitely many nonzero coefficients of negative period, a
single nonnegative monomial of sufficiently large period shifts any series into `Nov≥0(R, H, N)`.
Consequently:

* For any single exponent `g` with `N g > 0`, `Nov(R, H, N)` is the localization of
  `Nov≥0(R, H, N)` away from `e^g` (`TauCeti.NovikovSeries.isLocalization_away_nonnegMonomial`).
* For an additive submonoid `P ≤ H` of nonnegative-period exponents, `Nov(R, H, N)` is the
  localization of `Nov≥0(R, H, N)` at the monomial submonoid `{e^g : g ∈ P}` if and only if (over a
  nontrivial coefficient ring) for every `h : H` there exists `g ∈ P` with `N (h + g) ≥ 0`
  (`TauCeti.NovikovSeries.isLocalization_monomialSubmonoid_iff`); in particular, any `P` containing
  at least one element of strictly positive period suffices.
* Specializing to the real exponent group `(ℝ, +)` with `N = id`, the multiplicative submonoid
  generated by `{T^r : r > 0}` coincides with `{T^r : r ≥ 0}` and localizes `Nov≥0(R, ℝ, id)` onto
  `Nov(R, ℝ, id)` (`TauCeti.NovikovSeries.isLocalization_realMonomialSubmonoid`).

## Main definitions

* `TauCeti.NovikovSeries.nonnegMonomial`: the monomial `e^g` inside `Nov≥0(R, H, N)` for `N g ≥ 0`.
* `TauCeti.NovikovSeries.monomialSubmonoid`: the multiplicative submonoid `{e^g : g ∈ P}` of
  `Nov≥0(R, H, N)` associated with a nonnegative-period additive submonoid `P ≤ H`.
* `TauCeti.NovikovSeries.localizationAwayNonnegMonomialAlgEquiv` and
  `TauCeti.NovikovSeries.localizationMonomialAlgEquiv`: the induced `Nov≥0(R, H, N)`-algebra
  isomorphisms from `Localization.Away (e^g)` and `Localization (monomialSubmonoid R hP)` onto
  `Nov(R, H, N)`.
* `TauCeti.NovikovSeries.realMonomialSubmonoid` and
  `TauCeti.NovikovSeries.localizationRealMonomialAlgEquiv`: specialization to `Nov(R, ℝ, id)`.

## Main results

* `TauCeti.NovikovSeries.isUnit_nonnegMonomial_iff` and
  `TauCeti.NovikovSeries.not_isUnit_nonnegMonomial_of_pos`: over a nontrivial ring, `e^g` is a unit
  in `Nov≥0(R, H, N)` if and only if `N g = 0`.
* `TauCeti.NovikovSeries.isLocalization_away_nonnegMonomial`: `Nov(R, H, N)` is the localization of
  `Nov≥0(R, H, N)` away from any `e^g` with `N g > 0`.
* `TauCeti.NovikovSeries.isLocalization_monomialSubmonoid_iff`: exact characterization of when
  `Nov(R, H, N)` is the localization of `Nov≥0(R, H, N)` at `monomialSubmonoid R hP`.
* `TauCeti.NovikovSeries.closure_posRealMonomial_eq_realMonomialSubmonoid` and
  `TauCeti.NovikovSeries.isLocalization_realMonomialSubmonoid`: localization of `Nov≥0(R, ℝ, id)` at
  positive real monomials yields `Nov(R, ℝ, id)`.

## References

* K. Fukaya, Y.-G. Oh, H. Ohta, K. Ono, *Lagrangian Intersection Floer Theory: Anomaly and
  Obstruction*, AMS/IP Studies in Advanced Mathematics 46, 2009, Chapter 2.
* H. Hofer, D. Salamon, *Floer homology and Novikov rings*, The Floer Memorial Volume,
  Birkhäuser 1995, Section 4.
-/

public section

noncomputable section

open Function Set

namespace TauCeti.NovikovSeries

variable {R A H ι : Type*}

section Monomial

section Ring

variable [Ring R] [AddMonoid H] {N : H →+ ℝ}

/-- The unit monomial `e^g` in the nonnegative Novikov subring, for an exponent `g` with
`N g ≥ 0`. -/
def nonnegMonomial (R : Type*) [Ring R] {g : H} (hg : 0 ≤ N g) : nonnegSubring R N :=
  ⟨single g 1, single_mem_nonnegSubring hg 1⟩

@[simp, norm_cast]
theorem coe_nonnegMonomial {g : H} (hg : 0 ≤ N g) :
    (nonnegMonomial R hg : NovikovSeries R H N) = single g 1 :=
  (rfl)

@[simp]
theorem nonnegMonomial_zero : nonnegMonomial R (map_zero N).ge = 1 :=
  Subtype.ext single_zero_one

@[simp]
theorem nonnegMonomial_add {g₁ g₂ : H} (h₁ : 0 ≤ N g₁) (h₂ : 0 ≤ N g₂) :
    nonnegMonomial R h₁ * nonnegMonomial R h₂ =
      nonnegMonomial R (N := N) ((map_add N g₁ g₂).symm ▸ add_nonneg h₁ h₂) :=
  Subtype.ext <| by simp [single_mul_single]

@[simp]
theorem nonnegMonomial_pow {g : H} (hg : 0 ≤ N g) (n : ℕ) :
    nonnegMonomial R hg ^ n =
      nonnegMonomial R (N := N) ((map_nsmul N n g).symm ▸ nsmul_nonneg hg n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ih, nonnegMonomial_add]
    exact Subtype.ext (by simp [succ_nsmul])

/-- Over a nontrivial coefficient ring, a nonnegative monomial lies in the positive ideal if and
only if its period is strictly positive. -/
theorem nonnegMonomial_mem_posIdeal_iff [Nontrivial R] {g : H} (hg : 0 ≤ N g) :
    nonnegMonomial R hg ∈ posIdeal R N ↔ 0 < N g := by
  refine ⟨fun hmem => lt_of_le_of_ne hg fun h0 => ?_, fun hpos => single_mem_posIdeal hpos 1⟩
  have hzero := mem_posIdeal.1 hmem g h0.symm.le
  rw [coe_nonnegMonomial, coeff_single_same] at hzero
  exact one_ne_zero hzero

end Ring

section Group

variable [Ring R] [AddGroup H] {N : H →+ ℝ}

/-- Every nonnegative monomial becomes a unit in the ambient Novikov ring `Nov(R, H, N)`, with
inverse `e^(-g)`. -/
theorem isUnit_coe_nonnegMonomial {g : H} (hg : 0 ≤ N g) :
    IsUnit (nonnegMonomial R hg : NovikovSeries R H N) :=
  isUnit_single g isUnit_one

/-- Over a nontrivial ring, a nonnegative monomial `e^g` is a unit of the nonnegative subring
`Nov≥0(R, H, N)` if and only if `N g = 0`. -/
@[simp]
theorem isUnit_nonnegMonomial_iff [Nontrivial R] {g : H} (hg : 0 ≤ N g) :
    IsUnit (nonnegMonomial R hg) ↔ N g = 0 := by
  constructor
  · rintro ⟨u, hu⟩
    by_contra hne
    have hpos : 0 < N g := lt_of_le_of_ne hg (Ne.symm hne)
    have hmem : (u : nonnegSubring R N) ∈ posIdeal R N := by
      rw [hu]
      exact single_mem_posIdeal hpos 1
    have hone : (1 : nonnegSubring R N) ∈ posIdeal R N := by
      rw [← u.mul_inv]
      exact Ideal.mul_mem_right _ _ hmem
    have hzero := mem_posIdeal.1 hone 0 (map_zero N).le
    rw [Subring.coe_one, one_def, coeff_single_same] at hzero
    exact one_ne_zero hzero
  · intro h0
    have hneg : 0 ≤ N (-g) := by rw [map_neg, h0, neg_zero]
    exact ⟨⟨nonnegMonomial R hg, nonnegMonomial R hneg,
      Subtype.ext (by simp), Subtype.ext (by simp)⟩, rfl⟩

/-- A monomial `e^g` of strictly positive period is never a unit in `Nov≥0(R, H, N)` over a
nontrivial coefficient ring. -/
theorem not_isUnit_nonnegMonomial_of_pos [Nontrivial R] {g : H} (hg : 0 < N g) :
    ¬IsUnit (nonnegMonomial R hg.le) := by
  rw [isUnit_nonnegMonomial_iff]
  exact hg.ne'

end Group

section Grading

variable [CommRing R] [AddMonoid H] {N : H →+ ℝ}

theorem nonnegMonomial_mem_nonnegGradeBy {g : H} (hg : 0 ≤ N g) (f : H → ι) :
    nonnegMonomial R hg ∈ nonnegGradeBy R N f (f g) :=
  single_mem_nonnegGradeBy hg f 1

end Grading

end Monomial

section Localization

variable [CommRing R] [AddCommGroup H] {N : H →+ ℝ}

/-- Every nonnegative monomial is a non-zero-divisor in `Nov≥0(R, H, N)`, since it is a unit in the
ambient ring `Nov(R, H, N)`. -/
theorem nonnegMonomial_mem_nonZeroDivisors {g : H} (hg : 0 ≤ N g) :
    nonnegMonomial R hg ∈ nonZeroDivisors (nonnegSubring R N) := by
  rw [mem_nonZeroDivisors_iff]
  refine ⟨fun x hx => Subtype.ext ?_, fun x hx => Subtype.ext ?_⟩
  · have hmul : single g (1 : R) * (x : NovikovSeries R H N) = 0 := by
      simpa using congrArg Subtype.val hx
    have hcancel := congrArg (fun y : NovikovSeries R H N => single (-g) (1 : R) * y) hmul
    simpa [← mul_assoc, single_mul_single] using hcancel
  · have hmul : (x : NovikovSeries R H N) * single g (1 : R) = 0 := by
      simpa using congrArg Subtype.val hx
    have hcancel := congrArg (fun y : NovikovSeries R H N => y * single (-g) (1 : R)) hmul
    simpa [mul_assoc, single_mul_single] using hcancel

/-- **Localization away from a positive-period monomial.** For any exponent `g` with `N g > 0`, the
ambient Novikov ring `Nov(R, H, N)` is the localization of `Nov≥0(R, H, N)` away from `e^g`. -/
theorem isLocalization_away_nonnegMonomial {g : H} (hg : 0 < N g) :
    IsLocalization.Away (nonnegMonomial R hg.le) (NovikovSeries R H N) := by
  rw [IsLocalization.Away, isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, n, rfl⟩
    rw [Algebra.algebraMap_ofSubsemiring_apply, SubmonoidClass.coe_pow]
    exact (isUnit_coe_nonnegMonomial hg.le).pow n
  · intro z
    obtain ⟨D, hD⟩ := exists_mem_periodFiltration z
    obtain ⟨n, hn⟩ := Archimedean.arch (-D) hg
    have hmem : z * (single g (1 : R)) ^ n ∈ nonnegSubring R N := by
      have hpow : (single g (1 : R) : NovikovSeries R H N) ^ n ∈
          periodFiltration R N (n • N g) :=
        pow_mem_periodFiltration (single_mem_periodFiltration g 1) n
      have hprod : z * (single g (1 : R)) ^ n ∈ periodFiltration R N (D + n • N g) :=
        mul_mem_periodFiltration hD hpow
      exact mem_nonnegSubring.2 <| mem_periodFiltration.1 <|
        antitone_periodFiltration (by linarith) hprod
    refine ⟨(⟨z * (single g (1 : R)) ^ n, hmem⟩, ⟨nonnegMonomial R hg.le ^ n, n, rfl⟩), ?_⟩
    simp [Algebra.algebraMap_ofSubsemiring_apply]
  · intro x y hxy
    exact ⟨1, by rw [Subtype.ext hxy]⟩

/-- The canonical `Nov≥0(R, H, N)`-algebra isomorphism from `Localization.Away (e^g)` onto
`Nov(R, H, N)` for `N g > 0`. -/
def localizationAwayNonnegMonomialAlgEquiv (R : Type*) [CommRing R] {g : H} (hg : 0 < N g) :
    Localization.Away (nonnegMonomial R hg.le) ≃ₐ[nonnegSubring R N] NovikovSeries R H N :=
  have := isLocalization_away_nonnegMonomial (R := R) hg
  Localization.algEquiv (Submonoid.powers (nonnegMonomial R hg.le)) (NovikovSeries R H N)

/-- The multiplicative submonoid `{e^g : g ∈ P}` of `Nov≥0(R, H, N)` attached to an additive
submonoid `P ≤ H` of nonnegative-period exponents. -/
def monomialSubmonoid (R : Type*) [CommRing R] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g) :
    Submonoid (nonnegSubring R N) where
  carrier := {x | ∃ (g : H) (hg : g ∈ P), nonnegMonomial R (hP g hg) = x}
  one_mem' := ⟨0, P.zero_mem, nonnegMonomial_zero⟩
  mul_mem' := by
    rintro _ _ ⟨g₁, hg₁, rfl⟩ ⟨g₂, hg₂, rfl⟩
    exact ⟨g₁ + g₂, P.add_mem hg₁ hg₂, (nonnegMonomial_add _ _).symm⟩

@[simp]
theorem mem_monomialSubmonoid_iff {P : AddSubmonoid H} {hP : ∀ g ∈ P, 0 ≤ N g}
    {x : nonnegSubring R N} :
    x ∈ monomialSubmonoid R hP ↔ ∃ (g : H) (hg : g ∈ P), nonnegMonomial R (hP g hg) = x :=
  Iff.rfl

theorem nonnegMonomial_mem_monomialSubmonoid {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    {g : H} (hg : g ∈ P) : nonnegMonomial R (hP g hg) ∈ monomialSubmonoid R hP :=
  ⟨g, hg, rfl⟩

theorem monomialSubmonoid_le_nonZeroDivisors {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g) :
    monomialSubmonoid R hP ≤ nonZeroDivisors (nonnegSubring R N) := by
  rintro _ ⟨g, hg, rfl⟩
  exact nonnegMonomial_mem_nonZeroDivisors (hP g hg)

/-- If every exponent can be shifted into nonnegative period by an element of `P`, then
`Nov(R, H, N)` is the localization of `Nov≥0(R, H, N)` at `monomialSubmonoid R hP`. -/
theorem isLocalization_monomialSubmonoid_of_forall_exists {P : AddSubmonoid H}
    (hP : ∀ g ∈ P, 0 ≤ N g) (hcof : ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g)) :
    IsLocalization (monomialSubmonoid R hP) (NovikovSeries R H N) := by
  classical
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, g, hg, rfl⟩
    exact isUnit_coe_nonnegMonomial (hP g hg)
  · intro z
    choose γ hγP hγN using hcof
    let S := (z.finite_lt 0).toFinset
    let g := ∑ h ∈ S, γ h
    have hgP : g ∈ P := P.sum_mem fun h _ => hγP h
    have hmem : z * single g 1 ∈ nonnegSubring R N := mem_nonnegSubring.2 fun k hk => by
      rw [coeff_mul_single]
      by_contra hne
      have hz : z.coeff (k - g) ≠ 0 := left_ne_zero_of_mul hne
      by_cases hlt : N (k - g) < 0
      · have hkS : k - g ∈ S := (z.finite_lt 0).mem_toFinset.2 ⟨hz, hlt⟩
        have hle : N (γ (k - g)) ≤ N g := by
          rw [map_sum]
          exact Finset.single_le_sum (fun h _ => hP (γ h) (hγP h)) hkS
        have hnonneg := hγN (k - g)
        rw [map_add] at hnonneg
        have hk0 : 0 ≤ N k := by
          have hkg : k - g + g = k := sub_add_cancel k g
          rw [← hkg, map_add]
          linarith
        exact hk.not_ge hk0
      · have hkg : k - g + g = k := sub_add_cancel k g
        have hk0 : 0 ≤ N k := by
          rw [← hkg, map_add]
          exact add_nonneg (le_of_not_gt hlt) (hP g hgP)
        exact hk.not_ge hk0
    refine ⟨(⟨z * single g 1, hmem⟩,
      ⟨nonnegMonomial R (hP g hgP), g, hgP, rfl⟩), ?_⟩
    rfl
  · intro x y hxy
    exact ⟨1, by rw [Subtype.ext hxy]⟩

/-- **Exact localization criterion.** Over a nontrivial coefficient ring, `Nov(R, H, N)` is the
localization of `Nov≥0(R, H, N)` at `monomialSubmonoid R hP` if and only if every exponent in `H`
can be shifted into nonnegative period by some element of `P`. -/
theorem isLocalization_monomialSubmonoid_iff [Nontrivial R] {P : AddSubmonoid H}
    (hP : ∀ g ∈ P, 0 ≤ N g) :
    IsLocalization (monomialSubmonoid R hP) (NovikovSeries R H N) ↔
      ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g) := by
  refine ⟨fun hloc h => ?_, isLocalization_monomialSubmonoid_of_forall_exists hP⟩
  obtain ⟨⟨x, _, g, hgP, rfl⟩, hmul⟩ :=
    IsLocalization.surj (monomialSubmonoid R hP) (single h (1 : R) : NovikovSeries R H N)
  refine ⟨g, hgP, ?_⟩
  by_contra hlt
  have hzero := mem_nonnegSubring.1 x.2 (h + g) (lt_of_not_ge hlt)
  have hone : (x : NovikovSeries R H N).coeff (h + g) = 1 := by
    have heq : (single (h + g) (1 : R) : NovikovSeries R H N) = x := by
      simpa [Algebra.algebraMap_ofSubsemiring_apply, single_mul_single] using hmul
    rw [← heq, coeff_single_same]
  exact one_ne_zero (hone.symm.trans hzero)

/-- Whenever `P` contains at least one element of strictly positive period, `Nov(R, H, N)` is the
localization of `Nov≥0(R, H, N)` at `monomialSubmonoid R hP`. -/
theorem isLocalization_monomialSubmonoid_of_exists_pos {P : AddSubmonoid H}
    (hP : ∀ g ∈ P, 0 ≤ N g) (hpos : ∃ g ∈ P, 0 < N g) :
    IsLocalization (monomialSubmonoid R hP) (NovikovSeries R H N) := by
  obtain ⟨g₀, hg₀P, hg₀⟩ := hpos
  refine isLocalization_monomialSubmonoid_of_forall_exists hP fun h => ?_
  obtain ⟨n, hn⟩ := Archimedean.arch (-N h) hg₀
  exact ⟨n • g₀, P.nsmul_mem hg₀P n, by rw [map_add, map_nsmul]; linarith⟩

/-- The canonical `Nov≥0(R, H, N)`-algebra isomorphism from `Localization (monomialSubmonoid R hP)`
onto `Nov(R, H, N)`. -/
def localizationMonomialAlgEquiv (R : Type*) [CommRing R] {P : AddSubmonoid H}
    (hP : ∀ g ∈ P, 0 ≤ N g) (hcof : ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g)) :
    Localization (monomialSubmonoid R hP) ≃ₐ[nonnegSubring R N] NovikovSeries R H N :=
  have := isLocalization_monomialSubmonoid_of_forall_exists (R := R) hP hcof
  Localization.algEquiv (monomialSubmonoid R hP) (NovikovSeries R H N)

/-- **Universal property of `Nov(R, H, N)` over `Nov≥0(R, H, N)`.** Any ring homomorphism out of
`Nov≥0(R, H, N)` into a commutative ring `A` sending the monomials in `P` to units extends uniquely
to `Nov(R, H, N)`. -/
def liftOfMonomialIsUnit [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hcof : ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g)) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (hg : g ∈ P), IsUnit (φ (nonnegMonomial R (hP g hg)))) :
    NovikovSeries R H N →+* A :=
  have := isLocalization_monomialSubmonoid_of_forall_exists (R := R) hP hcof
  IsLocalization.lift (M := monomialSubmonoid R hP) (S := NovikovSeries R H N) (g := φ) <| by
    rintro ⟨_, g, hg, rfl⟩
    exact hunit g hg

@[simp]
theorem liftOfMonomialIsUnit_coe [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hcof : ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g)) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (hg : g ∈ P), IsUnit (φ (nonnegMonomial R (hP g hg))))
    (a : nonnegSubring R N) :
    liftOfMonomialIsUnit hP hcof φ hunit (a : NovikovSeries R H N) = φ a := by
  have := isLocalization_monomialSubmonoid_of_forall_exists (R := R) hP hcof
  exact IsLocalization.lift_eq (M := monomialSubmonoid R hP) (S := NovikovSeries R H N) _ a

theorem liftOfMonomialIsUnit_unique [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hcof : ∀ h : H, ∃ g ∈ P, 0 ≤ N (h + g)) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (hg : g ∈ P), IsUnit (φ (nonnegMonomial R (hP g hg))))
    {ψ : NovikovSeries R H N →+* A} (hψ : ∀ a : nonnegSubring R N, ψ a = φ a) :
    ψ = liftOfMonomialIsUnit hP hcof φ hunit := by
  have := isLocalization_monomialSubmonoid_of_forall_exists (R := R) hP hcof
  exact (IsLocalization.lift_unique (M := monomialSubmonoid R hP) (S := NovikovSeries R H N)
    (g := φ) _ hψ).symm

/-- When `0` is the only period-zero element of `P`, the multiplicative submonoid generated by the
strictly positive-period monomials `{e^g : g ∈ P, N g > 0}` coincides with
`monomialSubmonoid R hP`. -/
theorem closure_posMonomial_eq_monomialSubmonoid {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hP0 : ∀ g ∈ P, N g = 0 → g = 0) :
    Submonoid.closure
      {x : nonnegSubring R N |
        ∃ (g : H) (_ : g ∈ P) (hg : 0 < N g), nonnegMonomial R hg.le = x} =
      monomialSubmonoid R hP := by
  apply le_antisymm
  · rw [Submonoid.closure_le]
    rintro _ ⟨g, hgP, _, rfl⟩
    exact ⟨g, hgP, rfl⟩
  · rintro _ ⟨g, hgP, rfl⟩
    rcases (hP g hgP).eq_or_lt with h0 | hpos
    · have hg0 : g = 0 := hP0 g hgP h0.symm
      subst hg0
      rw [nonnegMonomial_zero]
      exact one_mem _
    · exact Submonoid.subset_closure ⟨g, hgP, hpos, rfl⟩

/-- When `0` is the only period-zero element of `P` and `P` contains an element of strictly
positive period, any ring homomorphism out of `Nov≥0(R, H, N)` into a commutative ring `A` sending
every strictly positive-period monomial in `P` to a unit extends uniquely to `Nov(R, H, N)`. -/
def liftOfPosMonomialIsUnit [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hP0 : ∀ g ∈ P, N g = 0 → g = 0) (hpos : ∃ g ∈ P, 0 < N g) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (_ : g ∈ P) (hg : 0 < N g), IsUnit (φ (nonnegMonomial R hg.le))) :
    NovikovSeries R H N →+* A :=
  liftOfMonomialIsUnit hP
    (fun h => by
      obtain ⟨g₀, hg₀P, hg₀⟩ := hpos
      obtain ⟨n, hn⟩ := Archimedean.arch (-N h) hg₀
      exact ⟨n • g₀, P.nsmul_mem hg₀P n, by rw [map_add, map_nsmul]; linarith⟩)
    φ fun g hgP => by
      rcases (hP g hgP).eq_or_lt with h0 | hgpos
      · have hg0 : g = 0 := hP0 g hgP h0.symm
        subst hg0
        rw [nonnegMonomial_zero, _root_.map_one]
        exact isUnit_one
      · exact hunit g hgP hgpos

@[simp]
theorem liftOfPosMonomialIsUnit_coe [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hP0 : ∀ g ∈ P, N g = 0 → g = 0) (hpos : ∃ g ∈ P, 0 < N g) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (_ : g ∈ P) (hg : 0 < N g), IsUnit (φ (nonnegMonomial R hg.le)))
    (a : nonnegSubring R N) :
    liftOfPosMonomialIsUnit hP hP0 hpos φ hunit (a : NovikovSeries R H N) = φ a :=
  liftOfMonomialIsUnit_coe hP _ φ _ a

theorem liftOfPosMonomialIsUnit_unique [CommRing A] {P : AddSubmonoid H} (hP : ∀ g ∈ P, 0 ≤ N g)
    (hP0 : ∀ g ∈ P, N g = 0 → g = 0) (hpos : ∃ g ∈ P, 0 < N g) (φ : nonnegSubring R N →+* A)
    (hunit : ∀ (g : H) (_ : g ∈ P) (hg : 0 < N g), IsUnit (φ (nonnegMonomial R hg.le)))
    {ψ : NovikovSeries R H N →+* A} (hψ : ∀ a : nonnegSubring R N, ψ a = φ a) :
    ψ = liftOfPosMonomialIsUnit hP hP0 hpos φ hunit :=
  liftOfMonomialIsUnit_unique hP _ φ _ hψ

end Localization

section Real

variable [CommRing R]

/-- The multiplicative submonoid `{T^r : r ≥ 0}` of the universal nonnegative Novikov ring
`Nov≥0(R, ℝ, id)`. -/
def realMonomialSubmonoid (R : Type*) [CommRing R] :
    Submonoid (nonnegSubring R (AddMonoidHom.id ℝ)) :=
  monomialSubmonoid R (P := AddSubmonoid.nonneg ℝ) fun _ hr => hr

@[simp]
theorem mem_realMonomialSubmonoid_iff {x : nonnegSubring R (AddMonoidHom.id ℝ)} :
    x ∈ realMonomialSubmonoid R ↔
      ∃ (r : ℝ) (hr : 0 ≤ r), nonnegMonomial R (N := AddMonoidHom.id ℝ) hr = x :=
  Iff.rfl

/-- The multiplicative submonoid of `Nov≥0(R, ℝ, id)` generated by strictly positive real monomials
`{T^r : r > 0}` coincides with `realMonomialSubmonoid R = {T^r : r ≥ 0}`. -/
theorem closure_posRealMonomial_eq_realMonomialSubmonoid (R : Type*) [CommRing R] :
    Submonoid.closure
      {x : nonnegSubring R (AddMonoidHom.id ℝ) |
        ∃ (r : ℝ) (hr : 0 < r), nonnegMonomial R (N := AddMonoidHom.id ℝ) hr.le = x} =
      realMonomialSubmonoid R := by
  rw [realMonomialSubmonoid, ← closure_posMonomial_eq_monomialSubmonoid (R := R)
    (N := AddMonoidHom.id ℝ) (P := AddSubmonoid.nonneg ℝ) (fun _ hr => hr) (fun _ _ h0 => h0)]
  congr 1
  ext x
  exact ⟨fun ⟨r, hr, hrx⟩ => ⟨r, hr.le, hr, hrx⟩, fun ⟨r, _, hr, hrx⟩ => ⟨r, hr, hrx⟩⟩

/-- **Localization of the universal nonnegative Novikov ring.** Inverting all nonnegative (or
strictly positive) real monomials `T^r` in `Nov≥0(R, ℝ, id)` yields `Nov(R, ℝ, id)`. -/
instance isLocalization_realMonomialSubmonoid (R : Type*) [CommRing R] :
    IsLocalization (realMonomialSubmonoid R) (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isLocalization_monomialSubmonoid_of_exists_pos (P := AddSubmonoid.nonneg ℝ)
    (fun _ hr => hr) ⟨1, zero_le_one, one_pos⟩

/-- The canonical `Nov≥0(R, ℝ, id)`-algebra isomorphism from
`Localization (realMonomialSubmonoid R)` onto `Nov(R, ℝ, id)`. -/
def localizationRealMonomialAlgEquiv (R : Type*) [CommRing R] :
    Localization (realMonomialSubmonoid R) ≃ₐ[nonnegSubring R (AddMonoidHom.id ℝ)]
      NovikovSeries R ℝ (AddMonoidHom.id ℝ) :=
  Localization.algEquiv (realMonomialSubmonoid R) (NovikovSeries R ℝ (AddMonoidHom.id ℝ))

/-- Any ring homomorphism out of `Nov≥0(R, ℝ, id)` into a commutative ring `A` sending `T^r` to a
unit for every `r > 0` extends uniquely to `Nov(R, ℝ, id)`. -/
def liftOfPosRealMonomialIsUnit [CommRing A] (φ : nonnegSubring R (AddMonoidHom.id ℝ) →+* A)
    (hunit : ∀ (r : ℝ) (hr : 0 < r),
      IsUnit (φ (nonnegMonomial R (N := AddMonoidHom.id ℝ) hr.le))) :
    NovikovSeries R ℝ (AddMonoidHom.id ℝ) →+* A :=
  liftOfPosMonomialIsUnit (P := AddSubmonoid.nonneg ℝ) (fun _ hr => hr) (fun _ _ h0 => h0)
    ⟨1, zero_le_one, one_pos⟩ φ fun r _ hr => hunit r hr

@[simp]
theorem liftOfPosRealMonomialIsUnit_coe [CommRing A]
    (φ : nonnegSubring R (AddMonoidHom.id ℝ) →+* A)
    (hunit : ∀ (r : ℝ) (hr : 0 < r),
      IsUnit (φ (nonnegMonomial R (N := AddMonoidHom.id ℝ) hr.le)))
    (a : nonnegSubring R (AddMonoidHom.id ℝ)) :
    liftOfPosRealMonomialIsUnit φ hunit (a : NovikovSeries R ℝ (AddMonoidHom.id ℝ)) = φ a :=
  liftOfPosMonomialIsUnit_coe (P := AddSubmonoid.nonneg ℝ) (fun _ hr => hr) (fun _ _ h0 => h0)
    ⟨1, zero_le_one, one_pos⟩ φ (fun r _ hr => hunit r hr) a

theorem liftOfPosRealMonomialIsUnit_unique [CommRing A]
    (φ : nonnegSubring R (AddMonoidHom.id ℝ) →+* A)
    (hunit : ∀ (r : ℝ) (hr : 0 < r),
      IsUnit (φ (nonnegMonomial R (N := AddMonoidHom.id ℝ) hr.le)))
    {ψ : NovikovSeries R ℝ (AddMonoidHom.id ℝ) →+* A}
    (hψ : ∀ a : nonnegSubring R (AddMonoidHom.id ℝ), ψ a = φ a) :
    ψ = liftOfPosRealMonomialIsUnit φ hunit :=
  liftOfPosMonomialIsUnit_unique (P := AddSubmonoid.nonneg ℝ) (fun _ hr => hr) (fun _ _ h0 => h0)
    ⟨1, zero_le_one, one_pos⟩ φ (fun r _ hr => hunit r hr) hψ

end Real

end TauCeti.NovikovSeries
