/-!
# The pole-order filtration on the affine coordinate ring of a Weierstrass curve

Let `W` be a Weierstrass curve over a commutative ring `R`, with affine coordinate ring
`R[W] = R[X, Y] ⧸ (W(X, Y))` and monomial basis `xⁱyʲ` (`i : ℕ`, `j : Fin 2`) given by
`WeierstrassCurve.Affine.CoordinateRing.basisMonomials`. Assigning weight `2` to `x` and weight `3`
to `y` — their pole orders at the point at infinity `[0 : 1 : 0]` — defines the increasing,
exhaustive, multiplicative filtration `poleFiltration W n`, the `R`-span of the basis monomials
`xⁱyʲ` with `2 * i + 3 * j ≤ n`.

Each filtered piece `poleFiltration W n` is free of finite rank over `R` (`poleFiltrationBasis`),
and the successive quotients in degrees `2` and `3` are free of rank one generated by `x` and `y`
(`poleFiltrationTwoQuotEquiv`, `poleFiltrationThreeQuotEquiv`), while `poleFiltration W 6` has the
six-element basis `(1, x, y, x², xy, x³)` (`poleFiltrationSixBasis`). Every admissible change of
variables preserves the filtration (`variableChangeEquiv_mem_poleFiltration`), and scalar extension
along `R → S` identifies `S ⊗[R] R[W]` with `S[W.map (algebraMap R S)]`
(`baseChangeAlgEquiv`), carrying `(poleFiltration W n).baseChange S` onto
`poleFiltration (W.map (algebraMap R S)) n` (`baseChangeAlgEquiv_mem_poleFiltration_iff`).

## Main definitions

* `WeierstrassCurve.Affine.CoordinateRing.poleFiltration`: the `R`-submodule of functions of pole
  order at most `n` at infinity.
* `WeierstrassCurve.Affine.CoordinateRing.poleFiltrationBasis`: the monomial basis of
  `poleFiltration W n`.
* `WeierstrassCurve.Affine.CoordinateRing.poleFiltrationTwoQuotEquiv` and
  `WeierstrassCurve.Affine.CoordinateRing.poleFiltrationThreeQuotEquiv`: the rank-one quotients
  `F₂ / F₁ ≃ₗ[R] R` and `F₃ / F₂ ≃ₗ[R] R`.
* `WeierstrassCurve.Affine.CoordinateRing.poleFiltrationSixBasis`: the explicit six-element basis
  `![1, x, y, x², xy, x³]` of `poleFiltration W 6`.
* `WeierstrassCurve.Affine.CoordinateRing.baseChangeAlgEquiv`: the `S`-algebra isomorphism
  `S ⊗[R] R[W] ≃ₐ[S] S[W.map (algebraMap R S)]`.

## Main results

* `WeierstrassCurve.Affine.CoordinateRing.mem_poleFiltration_iff`: characterization of membership in
  `poleFiltration W n` by vanishing of higher-weight monomial coordinates.
* `WeierstrassCurve.Affine.CoordinateRing.gradedMonoid_poleFiltration`: the filtration is
  multiplicative (`SetLike.GradedMonoid`).
* `WeierstrassCurve.Affine.CoordinateRing.variableChangeEquiv_mem_poleFiltration`: admissible
  changes of variables preserve `poleFiltration`.
* `WeierstrassCurve.Affine.CoordinateRing.baseChangeAlgEquiv_mem_poleFiltration_iff`: the pole
  filtration commutes with base change.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, 2.2.
* [J. H. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.1 and III.3.
-/

public section

open Polynomial
open scoped TensorProduct

namespace WeierstrassCurve.Affine.CoordinateRing

variable {R : Type*} [CommRing R] (W : Affine R)

/-- The **pole-order filtration** on the affine coordinate ring `R[W]`: the `R`-span of the basis
monomials `xⁱyʲ` of weight `2 * i + 3 * j ≤ n`. -/
noncomputable def poleFiltration (n : ℕ) : Submodule R W.CoordinateRing :=
  Submodule.span R
    (Set.range fun p : {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ n} ↦
      CoordinateRing.basisMonomials W p.1)

/-- The monomial basis of `poleFiltration W n`, indexed by pairs `(i, j) : ℕ × Fin 2` with
`2 * i + 3 * j ≤ n`. -/
noncomputable def poleFiltrationBasis (n : ℕ) :
    Module.Basis {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ n} R (poleFiltration W n) :=
  Module.Basis.span
    ((CoordinateRing.basisMonomials W).linearIndependent.comp _ Subtype.val_injective)

@[simp]
theorem poleFiltrationBasis_apply (n : ℕ) (p : {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ n}) :
    (poleFiltrationBasis W n p : W.CoordinateRing) = CoordinateRing.basisMonomials W p.1 := by
  change ((Module.Basis.span
    ((CoordinateRing.basisMonomials W).linearIndependent.comp _ Subtype.val_injective) p :
      Submodule.span R _) : W.CoordinateRing) = _
  rw [Module.Basis.span_apply]
  rfl

instance finite_poleFiltrationIndex (n : ℕ) :
    Finite {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ n} :=
  Finite.of_injective
    (f := fun p : {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ n} ↦
      ((⟨p.1.1, by omega⟩ : Fin (n + 1)), p.1.2))
    fun _ _ h ↦ Subtype.ext (Prod.ext (congrArg (fun x : Fin (n + 1) × Fin 2 ↦ x.1.1) h)
      (congrArg (fun x : Fin (n + 1) × Fin 2 ↦ x.2) h))

instance free_poleFiltration (n : ℕ) : Module.Free R (poleFiltration W n) :=
  Module.Free.of_basis (poleFiltrationBasis W n)

instance finite_poleFiltration (n : ℕ) : Module.Finite R (poleFiltration W n) :=
  Module.Finite.of_basis (poleFiltrationBasis W n)

/-- A basis monomial `xⁱyʲ` belongs to `poleFiltration W n` whenever `2 * i + 3 * j ≤ n`. -/
theorem basisMonomials_mem_poleFiltration {n : ℕ} {p : ℕ × Fin 2}
    (hp : 2 * p.1 + 3 * p.2.1 ≤ n) :
    CoordinateRing.basisMonomials W p ∈ poleFiltration W n :=
  Submodule.subset_span ⟨⟨p, hp⟩, rfl⟩

/-- An element of `R[W]` lies in `poleFiltration W n` exactly when all of its monomial coordinates
of weight greater than `n` vanish. -/
theorem mem_poleFiltration_iff {n : ℕ} {b : W.CoordinateRing} :
    b ∈ poleFiltration W n ↔
      ∀ p : ℕ × Fin 2, n < 2 * p.1 + 3 * p.2.1 →
        (CoordinateRing.basisMonomials W).repr b p = 0 := by
  constructor
  · intro hb
    refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx hy p hp ↦ by
        simp [hx p hp, hy p hp]) (fun r x _ hx p hp ↦ by simp [hx p hp]) hb
    rintro _ ⟨⟨q, hq⟩, rfl⟩ p hp
    rw [Module.Basis.repr_self, Finsupp.single_apply_eq_zero]
    rintro rfl
    omega
  · intro hb
    rw [← (CoordinateRing.basisMonomials W).linearCombination_repr b,
      Finsupp.linearCombination_apply, Finsupp.sum]
    refine Submodule.sum_mem _ fun p hp ↦ Submodule.smul_mem _ _ ?_
    refine basisMonomials_mem_poleFiltration W ?_
    by_contra hlt
    exact (Finsupp.mem_support_iff.mp hp) (hb p (Nat.lt_of_not_ge hlt))

/-- The pole filtration is increasing. -/
theorem poleFiltration_mono : Monotone (poleFiltration W) := fun _ _ hmn _ hb ↦
  (mem_poleFiltration_iff W).mpr fun p hp ↦
    (mem_poleFiltration_iff W).mp hb p (lt_of_le_of_lt hmn hp)

/-- The pole filtration is exhaustive. -/
@[simp]
theorem iSup_poleFiltration : (⨆ n, poleFiltration W n) = ⊤ := by
  rw [eq_top_iff]
  intro b _
  rw [← (CoordinateRing.basisMonomials W).linearCombination_repr b,
    Finsupp.linearCombination_apply, Finsupp.sum]
  refine Submodule.sum_mem _ fun p _ ↦ Submodule.smul_mem _ _ ?_
  exact Submodule.mem_iSup_of_mem (2 * p.1 + 3 * p.2.1)
    (basisMonomials_mem_poleFiltration W le_rfl)

/-- The scaled filtration `k ↦ poleFiltration W (3 * k)` is exhaustive. -/
@[simp]
theorem iSup_poleFiltration_three_mul : (⨆ k, poleFiltration W (3 * k)) = ⊤ := by
  rw [eq_top_iff]
  intro b _
  have hb : b ∈ ⨆ n, poleFiltration W n := iSup_poleFiltration W ▸ Submodule.mem_top
  obtain ⟨n, hn⟩ := (Submodule.mem_iSup_of_directed _ (poleFiltration_mono W).directed_le).mp hb
  exact Submodule.mem_iSup_of_mem n (poleFiltration_mono W (by omega) hn)

theorem one_mem_poleFiltration (n : ℕ) : (1 : W.CoordinateRing) ∈ poleFiltration W n := by
  have h := basisMonomials_mem_poleFiltration W (n := n) (p := (0, 0)) (by simp)
  simpa using h

theorem of_X_mem_poleFiltration {n : ℕ} (hn : 2 ≤ n) :
    AdjoinRoot.of W.polynomial X ∈ poleFiltration W n := by
  have h := basisMonomials_mem_poleFiltration W (n := n) (p := (1, 0)) (by simpa)
  simpa using h

theorem root_mem_poleFiltration {n : ℕ} (hn : 3 ≤ n) :
    AdjoinRoot.root W.polynomial ∈ poleFiltration W n := by
  have h := basisMonomials_mem_poleFiltration W (n := n) (p := (0, 1)) (by simpa)
  simpa using h

/-- The product of two basis monomials of weights at most `m` and `n` lies in
`poleFiltration W (m + n)`. -/
private theorem basisMonomials_mul_mem_poleFiltration {m n : ℕ} (p q : ℕ × Fin 2)
    (hp : 2 * p.1 + 3 * p.2.1 ≤ m) (hq : 2 * q.1 + 3 * q.2.1 ≤ n) :
    CoordinateRing.basisMonomials W p * CoordinateRing.basisMonomials W q ∈
      poleFiltration W (m + n) := by
  rcases p with ⟨i₁, j₁⟩
  rcases q with ⟨i₂, j₂⟩
  have hEq := equation_X_root W
  rw [equation_iff'] at hEq
  simp only [baseChange_a₁, baseChange_a₂, baseChange_a₃, baseChange_a₄,
    baseChange_a₆] at hEq
  obtain rfl | rfl : j₁ = 0 ∨ j₁ = 1 := by omega
  all_goals obtain rfl | rfl : j₂ = 0 ∨ j₂ = 1 := by omega
  all_goals dsimp only [Fin.isValue, Fin.val_zero, Fin.val_one] at hp hq
  · have hmem := basisMonomials_mem_poleFiltration W (n := m + n) (p := (i₁ + i₂, 0))
      (by dsimp; omega)
    simpa [pow_add, mul_assoc] using hmem
  · have hmem := basisMonomials_mem_poleFiltration W (n := m + n) (p := (i₁ + i₂, 1))
      (by dsimp; omega)
    simpa [pow_add, mul_assoc] using hmem
  · have hmem := basisMonomials_mem_poleFiltration W (n := m + n) (p := (i₁ + i₂, 1))
      (by dsimp; omega)
    simpa [pow_add, mul_assoc, mul_left_comm, mul_comm] using hmem
  · -- Eliminate `y²` via the Weierstrass equation of `W`; every resulting term has weight
    -- at most `2 * (i₁ + i₂) + 6 ≤ m + n`.
    have hy2 : AdjoinRoot.root W.polynomial ^ 2 =
        AdjoinRoot.of W.polynomial X ^ 3 +
          W.a₂ • AdjoinRoot.of W.polynomial X ^ 2 +
          W.a₄ • AdjoinRoot.of W.polynomial X +
          W.a₆ • (1 : W.CoordinateRing) -
          W.a₁ • (AdjoinRoot.of W.polynomial X * AdjoinRoot.root W.polynomial) -
          W.a₃ • AdjoinRoot.root W.polynomial := by
      simp only [Algebra.smul_def, mul_one]
      linear_combination hEq
    have hprod : CoordinateRing.basisMonomials W (i₁, 1) *
        CoordinateRing.basisMonomials W (i₂, 1) =
        CoordinateRing.basisMonomials W (i₁ + i₂ + 3, 0) +
          W.a₂ • CoordinateRing.basisMonomials W (i₁ + i₂ + 2, 0) +
          W.a₄ • CoordinateRing.basisMonomials W (i₁ + i₂ + 1, 0) +
          W.a₆ • CoordinateRing.basisMonomials W (i₁ + i₂, 0) -
          W.a₁ • CoordinateRing.basisMonomials W (i₁ + i₂ + 1, 1) -
          W.a₃ • CoordinateRing.basisMonomials W (i₁ + i₂, 1) := by
      simp only [basisMonomials_apply, Fin.val_zero, Fin.val_one, pow_zero, pow_one, mul_one,
        Algebra.smul_def]
      calc
        AdjoinRoot.of W.polynomial X ^ i₁ * AdjoinRoot.root W.polynomial *
            (AdjoinRoot.of W.polynomial X ^ i₂ * AdjoinRoot.root W.polynomial)
            = AdjoinRoot.of W.polynomial X ^ (i₁ + i₂) * AdjoinRoot.root W.polynomial ^ 2 := by
              rw [pow_add]; ring
        _ = _ := by
              rw [hy2]
              simp only [Algebra.smul_def, pow_add]
              ring
    rw [hprod]
    refine sub_mem (sub_mem (add_mem (add_mem (add_mem ?_ ?_) ?_) ?_) ?_) ?_
    · exact basisMonomials_mem_poleFiltration W (by dsimp; omega)
    · exact Submodule.smul_mem _ _ (basisMonomials_mem_poleFiltration W (by dsimp; omega))
    · exact Submodule.smul_mem _ _ (basisMonomials_mem_poleFiltration W (by dsimp; omega))
    · exact Submodule.smul_mem _ _ (basisMonomials_mem_poleFiltration W (by dsimp; omega))
    · exact Submodule.smul_mem _ _ (basisMonomials_mem_poleFiltration W (by dsimp; omega))
    · exact Submodule.smul_mem _ _ (basisMonomials_mem_poleFiltration W (by dsimp; omega))

/-- The pole-order filtration is multiplicative: `(poleFiltration W m) * (poleFiltration W n) ⊆
poleFiltration W (m + n)`. -/
instance gradedMonoid_poleFiltration : SetLike.GradedMonoid (poleFiltration W) where
  one_mem := one_mem_poleFiltration W 0
  mul_mem m n a b ha hb := by
    refine Submodule.span_induction ?_ (by simp)
      (fun x y _ _ hx hy ↦ by rw [add_mul]; exact add_mem hx hy)
      (fun r x _ hx ↦ by rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hx) ha
    rintro _ ⟨⟨p, hp⟩, rfl⟩
    refine Submodule.span_induction ?_ (by simp)
      (fun x y _ _ hx hy ↦ by rw [mul_add]; exact add_mem hx hy)
      (fun r x _ hx ↦ by rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx) hb
    rintro _ ⟨⟨q, hq⟩, rfl⟩
    exact basisMonomials_mul_mem_poleFiltration W p q hp hq

/-- The scaled pole filtration `k ↦ poleFiltration W (3 * k)` is multiplicative. -/
instance gradedMonoid_poleFiltration_three_mul :
    SetLike.GradedMonoid (fun k ↦ poleFiltration W (3 * k)) where
  one_mem := one_mem_poleFiltration W 0
  mul_mem k l _ _ ha hb := by
    rw [mul_add]
    exact SetLike.mul_mem_graded ha hb

/-! ### Small-weight quotients and the six-element basis of `F₆` -/

/-- The quotient `F₂ / F₁` is free of rank one over `R`, via the coefficient of `x`. -/
noncomputable def poleFiltrationTwoQuotEquiv :
    (poleFiltration W 2 ⧸
      (poleFiltration W 1).comap (poleFiltration W 2).subtype) ≃ₗ[R] R := by
  let φ : poleFiltration W 2 →ₗ[R] R :=
    (Finsupp.lapply (1, 0)).comp
      ((CoordinateRing.basisMonomials W).repr.toLinearMap.comp (poleFiltration W 2).subtype)
  have hker : LinearMap.ker φ = (poleFiltration W 1).comap (poleFiltration W 2).subtype := by
    ext ⟨b, hb⟩
    rw [LinearMap.mem_ker, Submodule.mem_comap, Submodule.coe_subtype, mem_poleFiltration_iff]
    refine ⟨fun h p hp ↦ ?_, fun h ↦ h (1, 0) (by decide)⟩
    by_cases hp2 : 2 < 2 * p.1 + 3 * p.2.1
    · exact (mem_poleFiltration_iff W).mp hb p hp2
    · have hp10 : p = (1, 0) := by
        rcases p with ⟨i, j⟩
        fin_cases j <;> simp_all
        omega
      exact hp10 ▸ h
  have hsurj : Function.Surjective φ := fun r ↦
    ⟨r • ⟨AdjoinRoot.of W.polynomial X, of_X_mem_poleFiltration W le_rfl⟩, by
      have hx : AdjoinRoot.of W.polynomial X = CoordinateRing.basisMonomials W (1, 0) := by simp
      simp only [φ, LinearMap.comp_apply, LinearEquiv.coe_coe, Submodule.coe_subtype,
        Finsupp.lapply_apply, map_smul, smul_eq_mul, hx, Module.Basis.repr_self,
        Finsupp.single_eq_same, mul_one]⟩
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans (φ.quotKerEquivOfSurjective hsurj)

@[simp]
theorem poleFiltrationTwoQuotEquiv_mk (b : poleFiltration W 2) :
    poleFiltrationTwoQuotEquiv W (Submodule.Quotient.mk b) =
      (CoordinateRing.basisMonomials W).repr b.1 (1, 0) := by
  dsimp only [poleFiltrationTwoQuotEquiv, LinearEquiv.trans_apply]
  rw [Submodule.quotEquivOfEq_mk]
  rfl

/-- The quotient `F₃ / F₂` is free of rank one over `R`, via the coefficient of `y`. -/
noncomputable def poleFiltrationThreeQuotEquiv :
    (poleFiltration W 3 ⧸
      (poleFiltration W 2).comap (poleFiltration W 3).subtype) ≃ₗ[R] R := by
  let φ : poleFiltration W 3 →ₗ[R] R :=
    (Finsupp.lapply (0, 1)).comp
      ((CoordinateRing.basisMonomials W).repr.toLinearMap.comp (poleFiltration W 3).subtype)
  have hker : LinearMap.ker φ = (poleFiltration W 2).comap (poleFiltration W 3).subtype := by
    ext ⟨b, hb⟩
    rw [LinearMap.mem_ker, Submodule.mem_comap, Submodule.coe_subtype, mem_poleFiltration_iff]
    refine ⟨fun h p hp ↦ ?_, fun h ↦ h (0, 1) (by decide)⟩
    by_cases hp3 : 3 < 2 * p.1 + 3 * p.2.1
    · exact (mem_poleFiltration_iff W).mp hb p hp3
    · have hp01 : p = (0, 1) := by
        rcases p with ⟨i, j⟩
        fin_cases j <;> simp_all
        omega
      exact hp01 ▸ h
  have hsurj : Function.Surjective φ := fun r ↦
    ⟨r • ⟨AdjoinRoot.root W.polynomial, root_mem_poleFiltration W le_rfl⟩, by
      have hy : AdjoinRoot.root W.polynomial = CoordinateRing.basisMonomials W (0, 1) := by simp
      simp only [φ, LinearMap.comp_apply, LinearEquiv.coe_coe, Submodule.coe_subtype,
        Finsupp.lapply_apply, map_smul, smul_eq_mul, hy, Module.Basis.repr_self,
        Finsupp.single_eq_same, mul_one]⟩
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans (φ.quotKerEquivOfSurjective hsurj)

@[simp]
theorem poleFiltrationThreeQuotEquiv_mk (b : poleFiltration W 3) :
    poleFiltrationThreeQuotEquiv W (Submodule.Quotient.mk b) =
      (CoordinateRing.basisMonomials W).repr b.1 (0, 1) := by
  dsimp only [poleFiltrationThreeQuotEquiv, LinearEquiv.trans_apply]
  rw [Submodule.quotEquivOfEq_mk]
  rfl

/-- An explicit enumeration of the six basis monomials of weight at most `6`:
`1`, `x`, `y`, `x²`, `xy`, `x³`. -/
private def poleFiltrationSixIndexEquiv :
    {p : ℕ × Fin 2 // 2 * p.1 + 3 * p.2.1 ≤ 6} ≃ Fin 6 where
  toFun := fun ⟨⟨i, j⟩, _⟩ ↦
    match i, j with
    | 0, ⟨0, _⟩ => 0
    | 1, ⟨0, _⟩ => 1
    | 0, ⟨1, _⟩ => 2
    | 2, ⟨0, _⟩ => 3
    | 1, ⟨1, _⟩ => 4
    | _, _ => 5
  invFun :=
    ![⟨(0, 0), by decide⟩, ⟨(1, 0), by decide⟩, ⟨(0, 1), by decide⟩,
      ⟨(2, 0), by decide⟩, ⟨(1, 1), by decide⟩, ⟨(3, 0), by decide⟩]
  left_inv := fun ⟨⟨i, j⟩, hij⟩ ↦ by
    obtain rfl | rfl : j = 0 ∨ j = 1 := by omega
    · dsimp only [Fin.isValue, Fin.val_zero] at hij
      have : i ≤ 3 := by omega
      interval_cases i <;> rfl
    · dsimp only [Fin.isValue, Fin.val_one] at hij
      have : i ≤ 1 := by omega
      interval_cases i <;> rfl
  right_inv := fun k ↦ by fin_cases k <;> rfl

/-- The explicit six-element basis `![1, x, y, x², xy, x³]` of `poleFiltration W 6`. -/
noncomputable def poleFiltrationSixBasis : Module.Basis (Fin 6) R (poleFiltration W 6) :=
  (poleFiltrationBasis W 6).reindex poleFiltrationSixIndexEquiv

@[simp]
theorem poleFiltrationSixBasis_zero : (poleFiltrationSixBasis W 0 : W.CoordinateRing) = 1 := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

@[simp]
theorem poleFiltrationSixBasis_one :
    (poleFiltrationSixBasis W 1 : W.CoordinateRing) = AdjoinRoot.of W.polynomial X := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

@[simp]
theorem poleFiltrationSixBasis_two :
    (poleFiltrationSixBasis W 2 : W.CoordinateRing) = AdjoinRoot.root W.polynomial := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

@[simp]
theorem poleFiltrationSixBasis_three :
    (poleFiltrationSixBasis W 3 : W.CoordinateRing) = AdjoinRoot.of W.polynomial X ^ 2 := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

@[simp]
theorem poleFiltrationSixBasis_four :
    (poleFiltrationSixBasis W 4 : W.CoordinateRing) =
      AdjoinRoot.of W.polynomial X * AdjoinRoot.root W.polynomial := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

@[simp]
theorem poleFiltrationSixBasis_five :
    (poleFiltrationSixBasis W 5 : W.CoordinateRing) = AdjoinRoot.of W.polynomial X ^ 3 := by
  simp [poleFiltrationSixBasis, poleFiltrationSixIndexEquiv]

/-! ### Invariance under variable changes -/

/-- Every admissible change of variables preserves the pole-order filtration. -/
theorem variableChangeEquiv_mem_poleFiltration {W W' : WeierstrassCurve R}
    (C : VariableChange R) (h : C • W' = W) {n : ℕ} {b : W'.toAffine.CoordinateRing}
    (hb : b ∈ poleFiltration W'.toAffine n) :
    variableChangeEquiv C h b ∈ poleFiltration W.toAffine n := by
  refine Submodule.span_induction ?_ (by simp)
    (fun x y _ _ hx hy ↦ by rw [map_add]; exact add_mem hx hy)
    (fun r x _ hx ↦ by rw [map_smul]; exact Submodule.smul_mem _ _ hx) hb
  rintro _ ⟨⟨⟨i, j⟩, hij⟩, rfl⟩
  dsimp only
  rw [basisMonomials_apply, map_mul, map_pow, map_pow, variableChangeEquiv_of_X,
    variableChangeEquiv_root]
  have hx : algebraMap R W.toAffine.CoordinateRing (C.u : R) ^ 2 *
      AdjoinRoot.of W.toAffine.polynomial X + algebraMap R _ C.r ∈
      poleFiltration W.toAffine 2 := by
    rw [← map_pow, ← Algebra.smul_def, Algebra.algebraMap_eq_smul_one]
    exact add_mem (Submodule.smul_mem _ _ (of_X_mem_poleFiltration W.toAffine le_rfl))
      (Submodule.smul_mem _ _ (one_mem_poleFiltration W.toAffine 2))
  have hy : algebraMap R W.toAffine.CoordinateRing (C.u : R) ^ 3 *
      AdjoinRoot.root W.toAffine.polynomial +
      algebraMap R _ (C.u : R) ^ 2 * algebraMap R _ C.s * AdjoinRoot.of W.toAffine.polynomial X +
      algebraMap R _ C.t ∈ poleFiltration W.toAffine 3 := by
    rw [← map_pow, ← map_pow, ← map_mul, ← Algebra.smul_def, ← Algebra.smul_def,
      Algebra.algebraMap_eq_smul_one]
    exact add_mem (add_mem
      (Submodule.smul_mem _ _ (root_mem_poleFiltration W.toAffine le_rfl))
      (Submodule.smul_mem _ _ (of_X_mem_poleFiltration W.toAffine (by decide))))
      (Submodule.smul_mem _ _ (one_mem_poleFiltration W.toAffine 3))
  have hpow : ∀ {d : ℕ} {a : W.toAffine.CoordinateRing}, a ∈ poleFiltration W.toAffine d →
      ∀ k : ℕ, a ^ k ∈ poleFiltration W.toAffine (d * k) := by
    intro d a ha k
    induction k with
    | zero => simpa using one_mem_poleFiltration W.toAffine 0
    | succ k ih =>
      rw [pow_succ, Nat.mul_succ]
      exact SetLike.mul_mem_graded ih ha
  exact poleFiltration_mono W.toAffine hij
    (SetLike.mul_mem_graded (hpow hx i) (hpow hy j.1))

/-! ### Base change of the coordinate ring and pole filtration -/

section BaseChange

variable {S : Type*} [CommRing S] [Algebra R S]

/-- `CoordinateRing.map W (algebraMap R S)` as an `R`-algebra homomorphism. -/
noncomputable def mapAlgHom :
    W.CoordinateRing →ₐ[R] (W.map (algebraMap R S)).CoordinateRing where
  __ := CoordinateRing.map W (algebraMap R S)
  commutes' r := CoordinateRing.map_algebraMap W (algebraMap R S) r

@[simp]
theorem mapAlgHom_apply (b : W.CoordinateRing) :
    mapAlgHom (S := S) W b = CoordinateRing.map W (algebraMap R S) b := by
  rfl

/-- **Base change of the affine coordinate ring.** `S ⊗[R] R[W]` is canonically isomorphic as an
`S`-algebra to `S[W.map (algebraMap R S)]`, sending `s ⊗ b` to `s • map b`. -/
noncomputable def baseChangeAlgEquiv :
    S ⊗[R] W.CoordinateRing ≃ₐ[S] (W.map (algebraMap R S)).CoordinateRing :=
  AlgEquiv.ofBijective
    (AlgHom.liftEquiv R S W.CoordinateRing (W.map (algebraMap R S)).CoordinateRing
      (mapAlgHom (S := S) W))
    (by
      -- Compare with the basis-induced `S`-linear equivalence sending `1 ⊗ basisMonomials i` to
      -- `basisMonomials i`.
      let e : S ⊗[R] W.CoordinateRing ≃ₗ[S] (W.map (algebraMap R S)).CoordinateRing :=
        (Algebra.TensorProduct.basis S (CoordinateRing.basisMonomials W)).equiv
          (CoordinateRing.basisMonomials (W.map (algebraMap R S))) (Equiv.refl _)
      have heq : (AlgHom.liftEquiv R S W.CoordinateRing (W.map (algebraMap R S)).CoordinateRing
          (mapAlgHom (S := S) W)).toLinearMap = e.toLinearMap := by
        apply (Algebra.TensorProduct.basis S (CoordinateRing.basisMonomials W)).ext
        intro i
        change (AlgHom.liftEquiv R S W.CoordinateRing (W.map (algebraMap R S)).CoordinateRing
            (mapAlgHom (S := S) W))
            (Algebra.TensorProduct.basis S (CoordinateRing.basisMonomials W) i) =
          e (Algebra.TensorProduct.basis S (CoordinateRing.basisMonomials W) i)
        rw [Module.Basis.equiv_apply, Equiv.refl_apply, Algebra.TensorProduct.basis_apply,
          AlgHom.liftEquiv_tmul, one_smul, mapAlgHom_apply, map_basisMonomials]
      rw [show ⇑(AlgHom.liftEquiv R S W.CoordinateRing (W.map (algebraMap R S)).CoordinateRing
          (mapAlgHom (S := S) W)) = ⇑e from congrArg DFunLike.coe heq]
      exact e.bijective)

@[simp]
theorem baseChangeAlgEquiv_tmul (s : S) (b : W.CoordinateRing) :
    baseChangeAlgEquiv (S := S) W (s ⊗ₜ b) = s • CoordinateRing.map W (algebraMap R S) b :=
  AlgHom.liftEquiv_tmul (mapAlgHom (S := S) W) s b

/-- `baseChangeAlgEquiv` carries `(poleFiltration W n).baseChange S` onto
`poleFiltration (W.map (algebraMap R S)) n`. -/
theorem baseChangeAlgEquiv_mem_poleFiltration_iff (n : ℕ) (x : S ⊗[R] W.CoordinateRing) :
    baseChangeAlgEquiv (S := S) W x ∈ poleFiltration (W.map (algebraMap R S)) n ↔
      x ∈ (poleFiltration W n).baseChange S := by
  let bS := Algebra.TensorProduct.basis S (CoordinateRing.basisMonomials W)
  have hrepr_map :
      (CoordinateRing.basisMonomials (W.map (algebraMap R S))).repr.toLinearMap.comp
          (baseChangeAlgEquiv (S := S) W).toLinearMap = bS.repr.toLinearMap := by
    apply bS.ext
    intro i
    simp [bS, Algebra.TensorProduct.basis_apply, map_basisMonomials]
  have hrepr (y : S ⊗[R] W.CoordinateRing) (p : ℕ × Fin 2) :
      (CoordinateRing.basisMonomials (W.map (algebraMap R S))).repr
          (baseChangeAlgEquiv (S := S) W y) p = bS.repr y p :=
    congrFun (congrArg DFunLike.coe (LinearMap.congr_fun hrepr_map y)) p
  rw [mem_poleFiltration_iff]
  constructor
  · intro hx
    rw [← bS.linearCombination_repr x, Finsupp.linearCombination_apply, Finsupp.sum]
    refine Submodule.sum_mem _ fun p hp ↦ Submodule.smul_mem _ _ ?_
    have hp_le : 2 * p.1 + 3 * p.2.1 ≤ n := by
      by_contra hlt
      exact (Finsupp.mem_support_iff.mp hp) ((hrepr x p).symm.trans (hx p (Nat.lt_of_not_ge hlt)))
    simpa [bS] using Submodule.tmul_mem_baseChange_of_mem (R := R) (1 : S)
      (basisMonomials_mem_poleFiltration W hp_le)
  · intro hx p hp
    rw [hrepr]
    obtain ⟨t, rfl⟩ := Submodule.toBaseChange_surjective' S (poleFiltration W n) hx
    clear hx hrepr hrepr_map
    induction t using TensorProduct.inductionOn with
    | add t₁ t₂ h₁ h₂ =>
      simp only [map_add, Submodule.coe_add, Finsupp.add_apply, h₁, h₂, add_zero]
    | tmul s a =>
      have ha : (CoordinateRing.basisMonomials W).repr a.1 p = 0 :=
        (mem_poleFiltration_iff W).mp a.2 p hp
      rw [Submodule.coe_toBaseChange_tmul,
        ← (CoordinateRing.basisMonomials W).linearCombination_repr a.1,
        Finsupp.linearCombination_apply, Finsupp.sum, TensorProduct.tmul_sum, map_sum,
        ← Finsupp.lapply_apply (R := S) p, map_sum]
      refine Finset.sum_eq_zero fun q hq ↦ ?_
      rw [Finsupp.lapply_apply (R := S)]
      have hqp : q ≠ p := by
        rintro rfl
        exact (Finsupp.mem_support_iff.mp hq) ha
      rw [TensorProduct.tmul_smul, ← algebraMap_smul S,
        show s ⊗ₜ[R] CoordinateRing.basisMonomials W q = s • bS q by
          rw [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one],
        map_smul, map_smul]
      simp [hqp]

end BaseChange

/-- Scalar extension along any ring homomorphism `f : R →+* S` preserves the pole filtration. -/
theorem map_mem_poleFiltration {S : Type*} [CommRing S] (f : R →+* S) {n : ℕ}
    {b : W.CoordinateRing} (hb : b ∈ poleFiltration W n) :
    CoordinateRing.map W f b ∈ poleFiltration (W.map f) n := by
  refine Submodule.span_induction ?_ (by simp) (fun _ _ _ _ hx hy ↦ by simpa using add_mem hx hy)
    (fun r _ _ hx ↦ by
      rw [Algebra.smul_def, map_mul, CoordinateRing.map_algebraMap, ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ hx) hb
  rintro _ ⟨⟨p, hp⟩, rfl⟩
  rw [map_basisMonomials]
  exact basisMonomials_mem_poleFiltration (W.map f) hp

end WeierstrassCurve.Affine.CoordinateRing
