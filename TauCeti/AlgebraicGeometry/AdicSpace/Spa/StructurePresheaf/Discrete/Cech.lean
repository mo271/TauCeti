namespace TauCeti.ValuationSpectrum

/-! ### Denominators of discrete rational covers and module Čech exactness -/

section DiscreteCover

variable {A : Type*} [CommRing A] [TopologicalSpace A] [DiscreteTopology A] {Aplus : Subring A}

/-- **Denominators of a discrete rational cover generate the unit ideal.** Over a discrete ring `A`,
if a family of rational subsets `R(Tⱼ/σⱼ)` covers `R(T/s)`, then the images of the denominators
`σⱼ` generate the unit ideal in any localisation `S` of `A` away from `s`. Every prime ideal of a
discrete ring is open, so `span_eq_top_of_rationalSubset_subset_iUnion` applies regardless of `A⁺`
or the cardinality of the index type. -/
theorem span_eq_top_of_discrete_rational_cover {T : Finset A} {s : A} (S : Type*) [CommRing S]
    [Algebra A S] [IsLocalization.Away s S] {ι : Type*} {T' : ι → Finset A} {σ : ι → A}
    (hcov : rationalSubset Aplus T s ⊆ ⋃ j, rationalSubset Aplus (T' j) (σ j)) :
    Ideal.span (Set.range fun j ↦ algebraMap A S (σ j)) = ⊤ :=
  span_eq_top_of_rationalSubset_subset_iUnion S (fun _ _ ↦ isOpen_discrete _) hcov

/-- `spaBasicOpen` form of `span_eq_top_of_discrete_rational_cover`. -/
theorem span_eq_top_of_spaBasicOpen_le_iSup_of_discreteTopology {T : Finset A} {s : A} (S : Type*)
    [CommRing S] [Algebra A S] [IsLocalization.Away s S] {ι : Type*} {T' : ι → Finset A}
    {σ : ι → A} (hcov : spaBasicOpen Aplus T s ≤ ⨆ j, spaBasicOpen Aplus (T' j) (σ j)) :
    Ideal.span (Set.range fun j ↦ algebraMap A S (σ j)) = ⊤ := by
  refine span_eq_top_of_discrete_rational_cover (Aplus := Aplus) (T := T) (s := s) (T' := T') S
    fun v hv ↦ ?_
  have hv' : (⟨v, rationalSubset_subset_spa Aplus T s hv⟩ : ↥(spa Aplus)) ∈
      ⨆ j, spaBasicOpen Aplus (T' j) (σ j) := hcov (mem_spaBasicOpen.mpr hv)
  obtain ⟨j, hj⟩ := Opens.mem_iSup.mp hv'
  exact Set.mem_iUnion.mpr ⟨j, mem_spaBasicOpen.mp hj⟩

/-- For a discrete rational cover of `R(T/s)`, the augmentation of the Čech complex of
localisations of any `Aₛ`-module `N` is injective. -/
theorem injective_cechLocalizationAugmentation_of_discrete_rational_cover {T : Finset A} {s : A}
    (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away s S] (N : Type*) [AddCommGroup N]
    [Module S N] {ι : Type*} {T' : ι → Finset A} {σ : ι → A}
    (hcov : rationalSubset Aplus T s ⊆ ⋃ j, rationalSubset Aplus (T' j) (σ j)) :
    Function.Injective (cechLocalizationAugmentation N fun j ↦ algebraMap A S (σ j)) :=
  injective_cechLocalizationAugmentation N _ (span_eq_top_of_discrete_rational_cover S hcov)

/-- For a finite discrete rational cover of `R(T/s)`, the augmented Čech complex of localisations
of any `Aₛ`-module `N` is exact in degree `0`. -/
theorem exact_cechLocalizationAugmentation_differential_of_discrete_rational_cover {T : Finset A}
    {s : A} (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away s S] (N : Type*)
    [AddCommGroup N] [Module S N] {ι : Type*} [LinearOrder ι] [Finite ι] {T' : ι → Finset A}
    {σ : ι → A} (hcov : rationalSubset Aplus T s ⊆ ⋃ j, rationalSubset Aplus (T' j) (σ j)) :
    Function.Exact (cechLocalizationAugmentation N fun j ↦ algebraMap A S (σ j))
      (cechLocalizationDifferential N (fun j ↦ algebraMap A S (σ j)) 0) :=
  exact_cechLocalizationAugmentation_differential N _
    (span_eq_top_of_discrete_rational_cover S hcov)

/-- **Exactness of the module Čech complex for a finite discrete rational cover.** Over a discrete
ring `A`, if finitely many rational subsets `R(Tⱼ/σⱼ)` cover `R(T/s)`, then for every module `N`
over a localisation `S` of `A` away from `s` (in particular `N = S ⊗[A] M`), the Čech complex of
localisations of `N` with respect to `σⱼ` is exact in every positive degree. -/
theorem cechComplexLocalization_exact_of_discrete_rational_cover {T : Finset A} {s : A}
    (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away s S] (N : Type*) [AddCommGroup N]
    [Module S N] {ι : Type*} [LinearOrder ι] [Finite ι] {T' : ι → Finset A} {σ : ι → A}
    (hcov : rationalSubset Aplus T s ⊆ ⋃ j, rationalSubset Aplus (T' j) (σ j)) (p : ℕ) :
    Function.Exact (cechLocalizationDifferential N (fun j ↦ algebraMap A S (σ j)) p)
      (cechLocalizationDifferential N (fun j ↦ algebraMap A S (σ j)) (p + 1)) :=
  cechComplexLocalization_exact N _ (span_eq_top_of_discrete_rational_cover S hcov) p

end DiscreteCover

/-! ### Non-covering obstruction on a discrete polynomial ring -/

section Obstruction

open Polynomial

/-- **The covering hypothesis in `span_eq_top_of_discrete_rational_cover` cannot be dropped.** For
a discrete polynomial ring `k[X]` over an integral domain `k` and any subring `A⁺ ⊆ k[X]` (for
instance `k` via `Polynomial.C`), the single rational subset `R({X}/X)` fails to cover
`R({1}/1) = Spa(k[X], A⁺)`:
1. the trivial valuation at the prime ideal `ker(eval 0) = (X)` lies in `R({1}/1)` and outside
   `R({X}/X)`;
2. the image of `X` in any localisation `S` of `k[X]` away from `1` does not generate the unit
   ideal;
3. the canonical localisation map `k[X] → k[X, X⁻¹]` is not surjective, so the sequence
   `0 → k[X] → k[X, X⁻¹] → 0` is not exact. -/
theorem exists_mem_rationalSubset_notMem_and_span_ne_top_and_not_surjective_polynomial
    {k : Type*} [CommRing k] [IsDomain k] [TopologicalSpace k[X]] [DiscreteTopology k[X]]
    (Aplus : Subring k[X]) (S : Type*) [CommRing S] [Algebra k[X] S]
    [IsLocalization.Away (1 : k[X]) S] :
    (∃ v ∈ rationalSubset Aplus {1} 1, v ∉ rationalSubset Aplus {X} X) ∧
      Ideal.span ({algebraMap k[X] S X} : Set S) ≠ ⊤ ∧
      ¬ Function.Surjective (algebraMap k[X] (Localization.Away (X : k[X]))) := by
  let ev0 : k[X] →+* k := evalRingHom 0
  let p : PrimeSpectrum k[X] := ⟨RingHom.ker ev0, RingHom.ker_isPrime ev0⟩
  have hp1 : (1 : k[X]) ∉ p.asIdeal := by
    simp [p, ev0, RingHom.mem_ker]
  have hpX : (X : k[X]) ∈ p.asIdeal := by
    simp [p, ev0, RingHom.mem_ker]
  refine ⟨⟨trivialSection p,
      (trivialSection_mem_rationalSubset_iff Aplus {1} 1 p).mpr ⟨isOpen_discrete _, hp1⟩,
      fun hmem ↦ ((trivialSection_mem_rationalSubset_iff Aplus {X} X p).mp hmem).2 hpX⟩,
    ?_, ?_⟩
  · intro htop
    have hunit : IsUnit (algebraMap k[X] S X) := Ideal.span_singleton_eq_top.mp htop
    let lift0 : S →+* k := IsLocalization.Away.lift (1 : k[X]) (g := ev0) (by simp)
    have hzero : IsUnit (0 : k) := by
      have hmap := hunit.map lift0
      rwa [IsLocalization.Away.lift_eq, show ev0 X = 0 by simp [ev0]] at hmap
    exact not_isUnit_zero hzero
  · intro hsurj
    obtain ⟨u, hu⟩ :=
      IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (X : k[X])) (X : k[X])
    obtain ⟨q, hq⟩ := hsurj (↑u⁻¹ : Localization.Away (X : k[X]))
    have hinj : Function.Injective (algebraMap k[X] (Localization.Away (X : k[X]))) :=
      IsLocalization.injective _
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero X_ne_zero))
    have hqX : q * X = 1 := hinj (by rw [map_mul, map_one, hq, ← hu, Units.inv_mul])
    have h01 : (0 : k) = 1 := by
      simpa [ev0] using (congrArg ev0 hqX).symm
    exact zero_ne_one h01

end Obstruction

/-! ### The module-tensored structure presheaf on opens contained in `W` -/

section TensorPresheaf

variable {A : Type v} [CommRing A] [TopologicalSpace A] [DiscreteTopology A]
  (P : PairOfDefinition A) (Aplus : Subring A)

private theorem rTensor_presentationLimitMapAlgHom_id (V : Opens ↥(spa Aplus))
    (M : Type u) [AddCommGroup M] [Module A M]
    (x : presentationLimit (P := P) Aplus V ⊗[A] M) :
    LinearMap.rTensor M (presentationLimitMapAlgHom P (le_refl V)).toLinearMap x = x := by
  have hid : (presentationLimitMapAlgHom P (le_refl V)).toLinearMap = LinearMap.id :=
    congrArg AlgHom.toLinearMap (presentationLimitMapAlgHom_id P Aplus V)
  rw [hid, LinearMap.rTensor_id]
  rfl

private theorem rTensor_presentationLimitMapAlgHom_comp {U V W : Opens ↥(spa Aplus)}
    (hUV : U ≤ V) (hVW : V ≤ W) (M : Type u) [AddCommGroup M] [Module A M]
    (x : presentationLimit (P := P) Aplus W ⊗[A] M) :
    LinearMap.rTensor M (presentationLimitMapAlgHom P (hUV.trans hVW)).toLinearMap x =
      LinearMap.rTensor M (presentationLimitMapAlgHom P hUV).toLinearMap
        (LinearMap.rTensor M (presentationLimitMapAlgHom P hVW).toLinearMap x) := by
  have hcomp : (presentationLimitMapAlgHom P (hUV.trans hVW)).toLinearMap =
      (presentationLimitMapAlgHom P hUV).toLinearMap ∘ₗ
        (presentationLimitMapAlgHom P hVW).toLinearMap :=
    congrArg AlgHom.toLinearMap (presentationLimitMapAlgHom_comp P hUV hVW).symm
  rw [hcomp, LinearMap.rTensor_comp]
  rfl

/-- **The module-tensored structure presheaf on `Set.Iic W`.** Over a discrete ring `A`, for an
open `W ⊆ Spa(A, A⁺)` and an `A`-module `M`, this presheaf sends `V ≤ W` to the abelian group
`presentationLimit Aplus V ⊗[A] M` and restricts along `V' ≤ V` via
`LinearMap.rTensor M (presentationLimitMapAlgHom P _)`. -/
noncomputable def presentationLimitTensorAddCommGrpPresheaf (W : Opens ↥(spa Aplus))
    (M : Type u) [AddCommGroup M] [Module A M] :
    (Set.Iic W)ᵒᵖ ⥤ AddCommGrpCat.{max v u} where
  obj V := AddCommGrpCat.of (presentationLimit (P := P) Aplus V.unop.1 ⊗[A] M)
  map h := AddCommGrpCat.ofHom
    (LinearMap.rTensor M
      (presentationLimitMapAlgHom P (Subtype.coe_le_coe.mpr (leOfHom h.unop))).toLinearMap
        ).toAddMonoidHom
  map_id V := by
    ext x
    exact rTensor_presentationLimitMapAlgHom_id P Aplus V.unop.1 M x
  map_comp h₁ h₂ := by
    ext x
    exact rTensor_presentationLimitMapAlgHom_comp P Aplus
      (Subtype.coe_le_coe.mpr (leOfHom h₂.unop))
      (Subtype.coe_le_coe.mpr (leOfHom h₁.unop)) M x

-- Deliberately not `@[simp]`, matching `presentationLimitAddCommGrpPresheaf_obj`.
theorem presentationLimitTensorAddCommGrpPresheaf_obj (W : Opens ↥(spa Aplus))
    (M : Type u) [AddCommGroup M] [Module A M] (V : (Set.Iic W)ᵒᵖ) :
    (presentationLimitTensorAddCommGrpPresheaf P Aplus W M).obj V =
      AddCommGrpCat.of (presentationLimit (P := P) Aplus V.unop.1 ⊗[A] M) :=
  (rfl)

/-- Identification of sections of `presentationLimitTensorAddCommGrpPresheaf` over `V` with
`presentationLimit Aplus V ⊗[A] M`. -/
noncomputable def presentationLimitTensorAddCommGrpPresheafObjEquiv {W : Opens ↥(spa Aplus)}
    (M : Type u) [AddCommGroup M] [Module A M] (V : Set.Iic W) :
    (presentationLimitTensorAddCommGrpPresheaf P Aplus W M).obj (op V) ≃+
      (presentationLimit (P := P) Aplus V.1 ⊗[A] M) :=
  AddEquiv.refl _

@[simp]
theorem presentationLimitTensorAddCommGrpPresheafObjEquiv_map_apply {W : Opens ↥(spa Aplus)}
    (M : Type u) [AddCommGroup M] [Module A M] {V V' : Set.Iic W} (h : V' ⟶ V)
    (x : (presentationLimitTensorAddCommGrpPresheaf P Aplus W M).obj (op V)) :
    presentationLimitTensorAddCommGrpPresheafObjEquiv P Aplus M V'
        ((presentationLimitTensorAddCommGrpPresheaf P Aplus W M).map h.op x) =
      LinearMap.rTensor M
        (presentationLimitMapAlgHom P (Subtype.coe_le_coe.mpr (leOfHom h))).toLinearMap
        (presentationLimitTensorAddCommGrpPresheafObjEquiv P Aplus M V x) :=
  (rfl)

/-- **Right-unit isomorphism `(𝒪 ⊗_A A) ≅ 𝒪` on `Set.Iic W`.** Tensoring `presentationLimit` with
`A` over `A` recovers `presentationLimitAddCommGrpPresheaf P Aplus W`. -/
noncomputable def presentationLimitTensorAddCommGrpPresheafUnitIso (W : Opens ↥(spa Aplus)) :
    presentationLimitTensorAddCommGrpPresheaf P Aplus W A ≅
      presentationLimitAddCommGrpPresheaf P Aplus W :=
  NatIso.ofComponents
    (fun V ↦
      let e := (TensorProduct.rid A (presentationLimit (P := P) Aplus V.unop.1)).toAddEquiv.trans
        (presentationLimitAddCommGrpPresheafObjEquiv P Aplus V.unop).symm
      { hom := AddCommGrpCat.ofHom e.toAddMonoidHom
        inv := AddCommGrpCat.ofHom e.symm.toAddMonoidHom
        hom_inv_id := by ext x; exact e.symm_apply_apply x
        inv_hom_id := by ext x; exact e.apply_symm_apply x })
    fun {V₁ V₂} h ↦ by
      ext x
      apply (presentationLimitAddCommGrpPresheafObjEquiv P Aplus V₂.unop).injective
      have hrhs := presentationLimitAddCommGrpPresheafObjEquiv_map_apply P Aplus h.unop
        ((presentationLimitAddCommGrpPresheafObjEquiv P Aplus V₁.unop).symm
          (TensorProduct.rid A (presentationLimit (P := P) Aplus V₁.unop.1) x))
      rw [AddEquiv.apply_symm_apply] at hrhs
      -- Compare both sides in `presentationLimit Aplus V₂.unop.1` via `ObjEquiv`.
      refine (AddEquiv.apply_symm_apply
        (presentationLimitAddCommGrpPresheafObjEquiv P Aplus V₂.unop) _).trans ?_
      refine Eq.trans ?_ hrhs.symm
      let φ := presentationLimitMapAlgHom P (Subtype.coe_le_coe.mpr (leOfHom h.unop))
      rw [← presentationLimitMapAlgHom_apply P]
      -- In this module, `map h` acts by `LinearMap.rTensor A φ.toLinearMap`.
      change TensorProduct.rid A _ (LinearMap.rTensor A φ.toLinearMap x) =
        φ (TensorProduct.rid A _ x)
      clear hrhs
      induction x using TensorProduct.inductionOn with
      | tmul r a =>
        simp only [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, TensorProduct.rid_tmul,
          map_smul]
      | add x y hx hy =>
        rw [map_add, map_add, hx, hy, ← map_add, ← map_add]

section Restrict

variable {Aplus} {W : Opens ↥(spa Aplus)}

/-- Intersection with `Y ≤ W` as a monotone functor `Set.Iic W ⥤ Set.Iic Y.1`. -/
private noncomputable def tensorInterFunctor (Y : Set.Iic W) : Set.Iic W ⥤ Set.Iic Y.1 :=
  Monotone.functor (f := fun V ↦ ⟨Y.1 ⊓ V.1, Set.mem_Iic.2 inf_le_left⟩)
    fun _ _ h ↦ inf_le_inf_left _ h

/-- Restricting `presentationLimitTensorAddCommGrpPresheaf` to `Y ≤ W` agrees with pulling back
the presheaf on `Set.Iic Y.1` along `tensorInterFunctor Y`. -/
private noncomputable def tensorRestrIso (Y : Set.Iic W) (M : Type u) [AddCommGroup M]
    [Module A M] :
    (prod.functor.obj Y).op ⋙ presentationLimitTensorAddCommGrpPresheaf P Aplus W M ≅
      (tensorInterFunctor Y).op ⋙ presentationLimitTensorAddCommGrpPresheaf P Aplus Y.1 M :=
  NatIso.ofComponents
    (fun V ↦
      have e : ((prod.functor.obj Y).obj V.unop).1 = ((tensorInterFunctor Y).obj V.unop).1 :=
        congrArg Subtype.val (CompleteLattice.prod_eq_inf Y V.unop)
      { hom := AddCommGrpCat.ofHom
          (LinearMap.rTensor M (presentationLimitMapAlgHom P e.ge).toLinearMap).toAddMonoidHom
        inv := AddCommGrpCat.ofHom
          (LinearMap.rTensor M (presentationLimitMapAlgHom P e.le).toLinearMap).toAddMonoidHom
        hom_inv_id := by
          ext x
          exact (rTensor_presentationLimitMapAlgHom_comp P Aplus _ _ M x).symm.trans
            (rTensor_presentationLimitMapAlgHom_id P Aplus _ M x)
        inv_hom_id := by
          ext x
          exact (rTensor_presentationLimitMapAlgHom_comp P Aplus _ _ M x).symm.trans
            (rTensor_presentationLimitMapAlgHom_id P Aplus _ M x) })
    fun _ ↦ by
      ext x
      exact (rTensor_presentationLimitMapAlgHom_comp P Aplus _ _ M x).symm.trans
        (rTensor_presentationLimitMapAlgHom_comp P Aplus _ _ M x)

/-- **Restricting a cover to a smaller open for `presentationLimitTensorAddCommGrpPresheaf`.** -/
theorem quasiIso_cechAugmentation_tensor_prod_iff [HasProducts.{w} AddCommGrpCat.{max v u}]
    (Y : Set.Iic W) (M : Type u) [AddCommGroup M] [Module A M] {ι : Type w} (U : ι → Set.Iic W) :
    QuasiIso (cechAugmentation U isTerminalTop
        ((prod.functor.obj Y).op ⋙ presentationLimitTensorAddCommGrpPresheaf P Aplus W M)) ↔
      QuasiIso (cechAugmentation
        (fun i ↦ (⟨Y.1 ⊓ (U i).1, Set.mem_Iic.2 inf_le_left⟩ : Set.Iic Y.1)) isTerminalTop
        (presentationLimitTensorAddCommGrpPresheaf P Aplus Y.1 M)) := by
  rw [quasiIso_cechAugmentation_iff_of_iso _ _ _ (tensorRestrIso P Y M)]
  have hG (m : ℕ) (a : Fin (m + 1) → ι) :
      Nonempty ((∏ᶜ fun j ↦ (tensorInterFunctor Y).obj (U (a j))) ⟶
        (tensorInterFunctor Y).obj (∏ᶜ fun j ↦ U (a j))) := by
    refine ⟨homOfLE (Subtype.mk_le_mk.2 (le_inf
      (∏ᶜ fun j ↦ (tensorInterFunctor Y).obj (U (a j))).2 ?_))⟩
    let Z : Set.Iic W :=
      ⟨_, Set.mem_Iic.2 ((∏ᶜ fun j ↦ (tensorInterFunctor Y).obj (U (a j))).2.trans Y.2)⟩
    have hπ (j : Fin (m + 1)) : (∏ᶜ fun j ↦ (tensorInterFunctor Y).obj (U (a j))).1 ≤
        ((tensorInterFunctor Y).obj (U (a j))).1 :=
      Subtype.coe_le_coe.2 (leOfHom (Pi.π _ j))
    have hZ : Z ⟶ ∏ᶜ fun j ↦ U (a j) := Pi.lift fun j ↦ homOfLE (Subtype.coe_le_coe.1
      ((hπ j).trans (show Y.1 ⊓ (U (a j)).1 ≤ _ from inf_le_right)))
    exact leOfHom hZ
  have hGT : IsTerminal ((tensorInterFunctor Y).obj ⊤) :=
    isTerminalTop.ofIso (eqToIso (Subtype.ext (inf_eq_left.2 Y.2)).symm)
  rw [quasiIso_cechAugmentation_op_comp_iff (tensorInterFunctor Y) _ _ (fun n a ↦
    (iso_of_both_ways _ (hG n a).some).isIso_hom) isTerminalTop hGT]
  suffices h : ∀ {T : Set.Iic Y.1} (hT : IsTerminal T), T = ⊤ →
      (QuasiIso (cechAugmentation (fun i ↦ (tensorInterFunctor Y).obj (U i)) hT
        (presentationLimitTensorAddCommGrpPresheaf P Aplus Y.1 M)) ↔
      QuasiIso (cechAugmentation (fun i ↦ (tensorInterFunctor Y).obj (U i)) isTerminalTop
        (presentationLimitTensorAddCommGrpPresheaf P Aplus Y.1 M))) from
    h hGT (Subtype.ext (inf_eq_left.2 Y.2))
  rintro T hT rfl
  rw [Subsingleton.elim hT isTerminalTop]

end Restrict

end TensorPresheaf

/-! ### Homological bridge from `cechLocalizationTerm` to `orderedCechComplex` -/

section LocalizationBridge

variable {R : Type v} [CommRing R] (N : Type (max v u)) [AddCommGroup N] [Module R N]
  {κ : Type (max v u)} [LinearOrder κ] (f : κ → R)

/-- The Čech complex of localisations of `N` at `f`, packaged in
`CochainComplex AddCommGrpCat ℕ`. -/
private noncomputable abbrev locCochainComplex : CochainComplex AddCommGrpCat.{max v u} ℕ :=
  CochainComplex.of
    (fun p ↦ AddCommGrpCat.of (cechLocalizationTerm N f p))
    (fun p ↦ AddCommGrpCat.ofHom (cechLocalizationDifferential N f p).toAddMonoidHom)
    fun p ↦ by
      ext x s
      exact congrFun
        (LinearMap.congr_fun (cechLocalizationDifferential_comp_differential N f p) x) s

private theorem locCochainComplex_d (p : ℕ) :
    (locCochainComplex N f).d p (p + 1) =
      AddCommGrpCat.ofHom (cechLocalizationDifferential N f p).toAddMonoidHom := by
  unfold locCochainComplex
  exact CochainComplex.of_d
    (fun p ↦ AddCommGrpCat.of (cechLocalizationTerm N f p))
    (fun p ↦ AddCommGrpCat.ofHom (cechLocalizationDifferential N f p).toAddMonoidHom) p

/-- The coaugmentation `N[0] ⟶ locCochainComplex N f` induced by `cechLocalizationAugmentation`. -/
private noncomputable def locCoaugmentation :
    (CochainComplex.single₀ AddCommGrpCat.{max v u}).obj (AddCommGrpCat.of N) ⟶
      locCochainComplex N f :=
  (CochainComplex.fromSingle₀Equiv (locCochainComplex N f) (AddCommGrpCat.of N)).symm
    ⟨AddCommGrpCat.ofHom (cechLocalizationAugmentation N f).toAddMonoidHom, by
      rw [locCochainComplex_d]
      ext m s
      exact congrFun
        (LinearMap.congr_fun (cechLocalizationDifferential_comp_augmentation N f) m) s⟩

@[simp]
private theorem locCoaugmentation_f_zero :
    (locCoaugmentation N f).f 0 =
      AddCommGrpCat.ofHom (cechLocalizationAugmentation N f).toAddMonoidHom :=
  CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _

/-- If `κ` is finite and `f` spans the unit ideal, `locCoaugmentation N f` is a
quasi-isomorphism. -/
private theorem quasiIso_locCoaugmentation [Finite κ] (hf : Ideal.span (Set.range f) = ⊤) :
    QuasiIso (locCoaugmentation N f) := by
  rw [quasiIso_iff]
  intro n
  cases n with
  | zero =>
    rw [CochainComplex.quasiIsoAt₀_iff]
    refine (ShortComplex.quasiIso_iff_of_zeros
      ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat.{max v u} (ComplexShape.up ℕ) 0 0
          1).map (locCoaugmentation N f))
      (HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 (AddCommGrpCat.of N) 0 0)
      (HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 (AddCommGrpCat.of N) 0 1)
      ((locCochainComplex N f).shape 0 0 (by simp))).mpr ⟨?_, ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro y hy
      have hy' : cechLocalizationDifferential N f 0 y = 0 :=
        (ConcreteCategory.congr_hom (locCochainComplex_d N f 0) y).symm.trans hy
      obtain ⟨m, rfl⟩ := (exact_cechLocalizationAugmentation_differential N f hf y).mp hy'
      exact ⟨m, ConcreteCategory.congr_hom (locCoaugmentation_f_zero N f) m⟩
    · -- In degree `0`, `τ₁` of the mapped short complex is `(locCoaugmentation N f).f 0`.
      change Mono ((locCoaugmentation N f).f 0)
      refine (AddCommGrpCat.mono_iff_injective _).mpr fun x y hxy ↦
        injective_cechLocalizationAugmentation N f hf ?_
      exact ((ConcreteCategory.congr_hom (locCoaugmentation_f_zero N f) x).symm.trans hxy).trans
        (ConcreteCategory.congr_hom (locCoaugmentation_f_zero N f) y)
  | succ n =>
    rw [quasiIsoAt_iff_exactAt _ (n + 1) (CochainComplex.exactAt_succ_single_obj _ _),
      HomologicalComplex.exactAt_iff' _ n (n + 1) (n + 2) (by simp)
        (by simp only [CochainComplex.next]; rfl),
      ShortComplex.ab_exact_iff]
    intro y hy
    have hy' : cechLocalizationDifferential N f (n + 1) y = 0 :=
      (ConcreteCategory.congr_hom (locCochainComplex_d N f (n + 1)) y).symm.trans hy
    obtain ⟨x, rfl⟩ := (cechComplexLocalization_exact N f hf n y).mp hy'
    exact ⟨x, ConcreteCategory.congr_hom (locCochainComplex_d N f n) x⟩

/-- The `(Finset κ)ᵒᵖ`-diagram of localisations `s ↦ op (N_{∏_{i ∈ s} f i})` in
`AddCommGrpCatᵒᵖ`. Reducible so that its values are seen to be `op (AddCommGrpCat.of _)`, matching
`presheafCechFunctor`. -/
@[simps]
private noncomputable abbrev locFinsetFunctor :
    (Finset κ)ᵒᵖ ⥤ (AddCommGrpCat.{max v u})ᵒᵖ where
  obj s := op (AddCommGrpCat.of (LocalizedModule (.powers (∏ i ∈ s.unop, f i)) N))
  map h := (AddCommGrpCat.ofHom
    (cechLocalizationRestriction N f (leOfHom h.unop)).toAddMonoidHom).op
  map_id s := Quiver.Hom.unop_inj <| by
    ext x
    exact cechLocalizationRestriction_self N f (subset_rfl) x
  map_comp h₁ h₂ := Quiver.Hom.unop_inj <| by
    ext x
    exact (cechLocalizationRestriction_restriction N f (leOfHom h₂.unop) (leOfHom h₁.unop) x).symm

/-- Concrete product fan for `(locCochainComplex N f).X p`. -/
private noncomputable def isLimitLocFan (p : ℕ) :
    IsLimit (Fan.mk ((locCochainComplex N f).X p) fun s : {s : Finset κ // s.card = p + 1} ↦
      AddCommGrpCat.ofHom
        (Pi.evalAddMonoidHom (fun s : {s : Finset κ // s.card = p + 1} ↦
          LocalizedModule (.powers (∏ i ∈ s.1, f i)) N) s)) where
  lift c :=
    let πs (s : {s : Finset κ // s.card = p + 1}) :
        c.pt ⟶ AddCommGrpCat.of (LocalizedModule (.powers (∏ i ∈ s.1, f i)) N) :=
      c.π.app ⟨s⟩
    AddCommGrpCat.ofHom (AddMonoidHom.mk' (fun x s ↦ (πs s).hom x)
      fun x y ↦ funext fun s ↦ map_add (πs s).hom x y)
  fac _ := fun ⟨_⟩ ↦ rfl
  uniq _ _ hm := by
    ext x
    exact funext fun s ↦ ConcreteCategory.congr_hom (hm ⟨s⟩) x

/-- Degree-`p` isomorphism between the unop'd ordered Čech complex of `locFinsetFunctor N f` and
`locCochainComplex N f`. -/
private noncomputable def locXIso (p : ℕ) :
    unop ((locFinsetFunctor N f).orderedCechComplex.X p) ≅
      (locCochainComplex N f).X p :=
  (((locFinsetFunctor N f).isColimitOrderedCechComplexCofan p).coconePointUniqueUpToIso
    (Fan.IsLimit.op (isLimitLocFan N f p))).unop.symm

@[reassoc]
private theorem locXIso_hom_comp_eval (p : ℕ) (s : {s : Finset κ // s.card = p + 1}) :
    (locXIso N f p).hom ≫
        AddCommGrpCat.ofHom
          (Pi.evalAddMonoidHom (fun s : {s : Finset κ // s.card = p + 1} ↦
            LocalizedModule (.powers (∏ i ∈ s.1, f i)) N) s) =
      ((locFinsetFunctor N f).orderedCechComplexι s).unop := by
  have h : (locXIso N f p).inv ≫ ((locFinsetFunctor N f).orderedCechComplexι s).unop =
      AddCommGrpCat.ofHom
        (Pi.evalAddMonoidHom (fun s : {s : Finset κ // s.card = p + 1} ↦
          LocalizedModule (.powers (∏ i ∈ s.1, f i)) N) s) :=
    congrArg Quiver.Hom.unop <|
      ((locFinsetFunctor N f).isColimitOrderedCechComplexCofan p).comp_coconePointUniqueUpToIso_hom
        (Fan.IsLimit.op (isLimitLocFan N f p)) ⟨s⟩
  rw [← h, Iso.hom_inv_id_assoc]

/-- Isomorphism of cochain complexes `(locFinsetFunctor N f).orderedCechComplex.unop ≅
locCochainComplex N f`. -/
private noncomputable def orderedCechLocIso :
    ((locFinsetFunctor N f).orderedCechComplex.unop : CochainComplex AddCommGrpCat.{max v u} ℕ) ≅
      locCochainComplex N f :=
  HomologicalComplex.Hom.isoOfComponents (locXIso N f) fun p q h ↦ by
    obtain rfl : p + 1 = q := h
    ext y s
    have hrhs := ConcreteCategory.congr_hom
      (((locFinsetFunctor N f).orderedCechComplex.d (p + 1) p).unop ≫=
        locXIso_hom_comp_eval N f (p + 1) s) y
    let evalY :
        (unop ((locFinsetFunctor N f).orderedCechComplex.X p) ⟶
          AddCommGrpCat.of (LocalizedModule (.powers (∏ i ∈ s.1, f i)) N)) →+
        LocalizedModule (.powers (∏ i ∈ s.1, f i)) N :=
      { toFun := fun g ↦ g y
        map_zero' := rfl
        map_add' := fun _ _ ↦ rfl }
    have hι :
        evalY (((locFinsetFunctor N f).orderedCechComplex.d (p + 1) p).unop ≫
            ((locFinsetFunctor N f).orderedCechComplexι s).unop) =
          ∑ a : s.1, (-1 : ℤ) ^ (s.1.filter (· < a.1)).card •
            (((locFinsetFunctor N f).orderedCechComplexι
              ⟨s.1.erase a.1,
                Nat.add_right_cancel ((Finset.card_erase_add_one a.2).trans s.2)⟩).unop ≫
              AddCommGrpCat.ofHom (cechLocalizationRestriction N f
                (Finset.erase_subset a.1 s.1)).toAddMonoidHom) y := by
      have hmor := congrArg Quiver.Hom.unop ((locFinsetFunctor N f).ι_orderedCechComplex_d s)
      simp only [unop_comp, unop_sum, unop_zsmul] at hmor
      exact (congrArg evalY hmor).trans (by simp [evalY, map_sum, map_zsmul])
    have hlhs : ((locXIso N f p).hom ≫ (locCochainComplex N f).d p (p + 1)) y s =
        cechLocalizationDifferential N f p ((locXIso N f p).hom y) s := by
      rw [locCochainComplex_d]
      rfl
    refine hlhs.trans (Eq.trans ?_ (hι.symm.trans hrhs.symm))
    rw [cechLocalizationDifferential_apply, Finset.univ_eq_attach]
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [← Int.cast_smul_eq_zsmul R, Int.cast_pow, Int.cast_neg, Int.cast_one]
    congr 1

end LocalizationBridge

/-! ### All-degree Čech acyclicity of rational covers -/

section Acyclicity

variable {A : Type v} [CommRing A] [TopologicalSpace A] [DiscreteTopology A]
  (P : PairOfDefinition A) {Aplus : Subring A}

omit [DiscreteTopology A] in
/-- In `Set.Iic W`, the underlying open of a finite subset-indexed product is `W ⊓ s.inf _`. -/
private theorem coe_pi_finset_eq {W : Opens ↥(spa Aplus)} {κ : Type*} (V : κ → Set.Iic W)
    (s : Finset κ) :
    (∏ᶜ fun i : s ↦ V i).1 = W ⊓ s.inf fun i ↦ (V i).1 := by
  let Y : Set.Iic W := ⟨W ⊓ s.inf fun i ↦ (V i).1, Set.mem_Iic.2 inf_le_left⟩
  have hY : Y ⟶ ∏ᶜ fun i : s ↦ V i := Pi.lift fun i ↦ homOfLE <| Subtype.mk_le_mk.2 <|
    inf_le_right.trans (Finset.inf_le i.2)
  exact le_antisymm
    (le_inf (∏ᶜ fun i : s ↦ V i).2
      (Finset.le_inf fun i hi ↦ Subtype.coe_le_coe.2 (leOfHom (Pi.π (fun j : s ↦ V j) ⟨i, hi⟩))))
    (Subtype.coe_le_coe.2 (leOfHom hY) : Y.1 ≤ (∏ᶜ fun i : s ↦ V i).1)

omit [DiscreteTopology A] in
/-- Every finite intersection `W ⊓ s.inf (spaBasicOpen Aplus (T' i) (σ i))` with
`W = spaBasicOpen Aplus T r` is a basic open with denominator `r * ∏ i ∈ s, σ i`. -/
private theorem exists_spaBasicOpen_inf_finset (T : Finset A) (r : A) {κ : Type*}
    (T' : κ → Finset A) (σ : κ → A) (s : Finset κ) :
    ∃ Ts : Finset A,
      (spaBasicOpen Aplus T r ⊓ s.inf fun i ↦ spaBasicOpen Aplus (T' i) (σ i)) =
        spaBasicOpen Aplus Ts (r * ∏ i ∈ s, σ i) := by
  classical
  open scoped Pointwise in
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨T, ?_⟩
    rw [Finset.inf_empty, inf_top_eq, Finset.prod_empty, mul_one]
  | insert a s ha ih =>
    obtain ⟨Ts, hTs⟩ := ih
    refine ⟨insert (r * ∏ i ∈ s, σ i) Ts * insert (σ a) (T' a), ?_⟩
    have hden : r * ∏ i ∈ insert a s, σ i = (r * ∏ i ∈ s, σ i) * σ a := by
      rw [Finset.prod_insert ha]
      ring
    rw [Finset.inf_insert, inf_comm (spaBasicOpen Aplus (T' a) (σ a)), ← inf_assoc, hTs, hden]
    apply Opens.ext
    ext x
    simp only [Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe, mem_spaBasicOpen]
    exact Set.ext_iff.mp (rationalSubset_inter Aplus Ts (T' a) (r * ∏ i ∈ s, σ i) (σ a)) x

/-- Relative module-localisation additive equivalence `(R_V ⊗[A] M) ≃+ (R_W ⊗[A] M)_{g}` when `R_V`
is localised away from `g` over `R_W`. -/
private noncomputable def tensorLocalizedAddEquiv {W V : Opens ↥(spa Aplus)} (hVW : V ≤ W)
    (M : Type u) [AddCommGroup M] [Module A M] (g : presentationLimit (P := P) Aplus W)
    (hloc :
      letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V) :=
        (presentationLimitMapAlgHom P hVW).toRingHom.toAlgebra
      IsLocalization.Away g (presentationLimit (P := P) Aplus V)) :
    (presentationLimit (P := P) Aplus V ⊗[A] M) ≃+
      LocalizedModule (.powers g) (presentationLimit (P := P) Aplus W ⊗[A] M) :=
  let R_W := presentationLimit (P := P) Aplus W
  let R_V := presentationLimit (P := P) Aplus V
  letI : Algebra R_W R_V := (presentationLimitMapAlgHom P hVW).toRingHom.toAlgebra
  haveI : IsScalarTower A R_W R_V :=
    IsScalarTower.of_algebraMap_eq' (presentationLimitMapAlgHom P hVW).comp_algebraMap.symm
  haveI : IsLocalization.Away g R_V := hloc
  ((IsLocalizedModule.iso (.powers g) (TensorProduct.mk R_W R_V (R_W ⊗[A] M) 1)).trans
    (AlgebraTensorModule.cancelBaseChange A R_W R_W R_V M)).symm.toAddEquiv

private theorem tensorLocalizedAddEquiv_rTensor_apply {W V : Opens ↥(spa Aplus)} (hVW : V ≤ W)
    (M : Type u) [AddCommGroup M] [Module A M] (g : presentationLimit (P := P) Aplus W)
    (hloc :
      letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V) :=
        (presentationLimitMapAlgHom P hVW).toRingHom.toAlgebra
      IsLocalization.Away g (presentationLimit (P := P) Aplus V))
    (x : presentationLimit (P := P) Aplus W ⊗[A] M) :
    tensorLocalizedAddEquiv P hVW M g hloc
        (LinearMap.rTensor M (presentationLimitMapAlgHom P hVW).toLinearMap x) =
      LocalizedModule.mk x 1 := by
  let R_W := presentationLimit (P := P) Aplus W
  let R_V := presentationLimit (P := P) Aplus V
  let _ : Algebra R_W R_V := (presentationLimitMapAlgHom P hVW).toRingHom.toAlgebra
  have _ : IsScalarTower A R_W R_V :=
    IsScalarTower.of_algebraMap_eq' (presentationLimitMapAlgHom P hVW).comp_algebraMap.symm
  have _ : IsLocalization.Away g R_V := hloc
  let e : (R_V ⊗[A] M) ≃ₗ[R_W] LocalizedModule (.powers g) (R_W ⊗[A] M) :=
    ((IsLocalizedModule.iso (.powers g) (TensorProduct.mk R_W R_V (R_W ⊗[A] M) 1)).trans
      (AlgebraTensorModule.cancelBaseChange A R_W R_W R_V M)).symm
  suffices h : e.symm (LocalizedModule.mk x 1) =
      LinearMap.rTensor M (presentationLimitMapAlgHom P hVW).toLinearMap x from
    e.symm.injective ((e.symm_apply_apply _).trans h.symm)
  dsimp only [e, LinearEquiv.symm_symm, LinearEquiv.trans_apply]
  rw [IsLocalizedModule.iso_mk_one (.powers g) (TensorProduct.mk R_W R_V (R_W ⊗[A] M) 1) x]
  induction x using TensorProduct.inductionOn with
  | tmul r m =>
    rw [TensorProduct.mk_apply, AlgebraTensorModule.cancelBaseChange_tmul, LinearMap.rTensor_tmul,
      AlgHom.toLinearMap_apply, Algebra.smul_def, mul_one]
    rfl
  | add y z hy hz =>
    rw [map_add, map_add, hy, hz, ← map_add]

/-- `LinearMap.rTensor M (presentationLimitMapAlgHom P h₁₂)` promoted to an `R_W`-linear map along
`V₁ ≤ V₂ ≤ W`. -/
private noncomputable def rTensorBaseLinearMap {W V₁ V₂ : Opens ↥(spa Aplus)}
    (h₁₂ : V₁ ≤ V₂) (h₂W : V₂ ≤ W) (M : Type u) [AddCommGroup M] [Module A M] :
    letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V₁) :=
      (presentationLimitMapAlgHom P (h₁₂.trans h₂W)).toRingHom.toAlgebra
    letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V₂) :=
      (presentationLimitMapAlgHom P h₂W).toRingHom.toAlgebra
    (presentationLimit (P := P) Aplus V₂ ⊗[A] M) →ₗ[presentationLimit (P := P) Aplus W]
      (presentationLimit (P := P) Aplus V₁ ⊗[A] M) := by
  let R_W := presentationLimit (P := P) Aplus W
  let R_V₁ := presentationLimit (P := P) Aplus V₁
  let R_V₂ := presentationLimit (P := P) Aplus V₂
  let _ : Algebra R_W R_V₁ := (presentationLimitMapAlgHom P (h₁₂.trans h₂W)).toRingHom.toAlgebra
  let _ : Algebra R_W R_V₂ := (presentationLimitMapAlgHom P h₂W).toRingHom.toAlgebra
  let rMap := LinearMap.rTensor M (presentationLimitMapAlgHom P h₁₂).toLinearMap
  exact
    { toFun := rMap
      map_add' := map_add rMap
      map_smul' := fun r w ↦ by
        induction w using TensorProduct.inductionOn with
        | tmul v m =>
          have hcomp := AlgHom.congr_fun (presentationLimitMapAlgHom_comp P h₁₂ h₂W) r
          -- `TensorProduct.leftModule` acts on `v ⊗ₜ m` via left multiplication on the ring factor.
          change rMap ((presentationLimitMapAlgHom P h₂W r * v) ⊗ₜ[A] m) =
            (presentationLimitMapAlgHom P (h₁₂.trans h₂W) r *
              presentationLimitMapAlgHom P h₁₂ v) ⊗ₜ[A] m
          simp only [rMap, LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, map_mul]
          rw [← hcomp]
          rfl
        | add x y hx hy =>
          simp only [RingHom.id_apply] at hx hy ⊢
          rw [smul_add, map_add, hx, hy, ← smul_add, ← map_add] }

/-- Compatibility of `tensorLocalizedAddEquiv` with restriction `V₁ ≤ V₂ ≤ W` and
`cechLocalizationRestriction`. -/
private theorem tensorLocalizedAddEquiv_comp_rTensor {W V₁ V₂ : Opens ↥(spa Aplus)}
    (h₁₂ : V₁ ≤ V₂) (h₂W : V₂ ≤ W) (M : Type u) [AddCommGroup M] [Module A M] {κ : Type*}
    (f : κ → presentationLimit (P := P) Aplus W) {t s : Finset κ} (hts : t ⊆ s)
    (hloc₁ :
      letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V₁) :=
        (presentationLimitMapAlgHom P (h₁₂.trans h₂W)).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i) (presentationLimit (P := P) Aplus V₁))
    (hloc₂ :
      letI : Algebra (presentationLimit (P := P) Aplus W) (presentationLimit (P := P) Aplus V₂) :=
        (presentationLimitMapAlgHom P h₂W).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ t, f i) (presentationLimit (P := P) Aplus V₂))
    (z : presentationLimit (P := P) Aplus V₂ ⊗[A] M) :
    tensorLocalizedAddEquiv P (h₁₂.trans h₂W) M (∏ i ∈ s, f i) hloc₁
        (LinearMap.rTensor M (presentationLimitMapAlgHom P h₁₂).toLinearMap z) =
      cechLocalizationRestriction (presentationLimit (P := P) Aplus W ⊗[A] M) f hts
        (tensorLocalizedAddEquiv P h₂W M (∏ i ∈ t, f i) hloc₂ z) := by
  let R_W := presentationLimit (P := P) Aplus W
  let R_V₁ := presentationLimit (P := P) Aplus V₁
  let R_V₂ := presentationLimit (P := P) Aplus V₂
  let M_W := R_W ⊗[A] M
  have h₁W : V₁ ≤ W := h₁₂.trans h₂W
  let _ : Algebra R_W R_V₁ := (presentationLimitMapAlgHom P h₁W).toRingHom.toAlgebra
  have _ : IsScalarTower A R_W R_V₁ :=
    IsScalarTower.of_algebraMap_eq' (presentationLimitMapAlgHom P h₁W).comp_algebraMap.symm
  have _ : IsLocalization.Away (∏ i ∈ s, f i) R_V₁ := hloc₁
  let _ : Algebra R_W R_V₂ := (presentationLimitMapAlgHom P h₂W).toRingHom.toAlgebra
  have _ : IsScalarTower A R_W R_V₂ :=
    IsScalarTower.of_algebraMap_eq' (presentationLimitMapAlgHom P h₂W).comp_algebraMap.symm
  have _ : IsLocalization.Away (∏ i ∈ t, f i) R_V₂ := hloc₂
  let e₁ : (R_V₁ ⊗[A] M) ≃ₗ[R_W] LocalizedModule (.powers (∏ i ∈ s, f i)) M_W :=
    ((IsLocalizedModule.iso (.powers (∏ i ∈ s, f i))
      (TensorProduct.mk R_W R_V₁ M_W 1)).trans
        (AlgebraTensorModule.cancelBaseChange A R_W R_W R_V₁ M)).symm
  let e₂ : (R_V₂ ⊗[A] M) ≃ₗ[R_W] LocalizedModule (.powers (∏ i ∈ t, f i)) M_W :=
    ((IsLocalizedModule.iso (.powers (∏ i ∈ t, f i))
      (TensorProduct.mk R_W R_V₂ M_W 1)).trans
        (AlgebraTensorModule.cancelBaseChange A R_W R_W R_V₂ M)).symm
  let L : (R_V₂ ⊗[A] M) →ₗ[R_W] (R_V₁ ⊗[A] M) := rTensorBaseLinearMap P h₁₂ h₂W M
  have hg : e₁.toLinearMap ∘ₗ L ∘ₗ e₂.symm.toLinearMap =
      cechLocalizationRestriction M_W f hts := by
    refine eq_cechLocalizationRestriction M_W f hts (LinearMap.ext fun x ↦ ?_)
    have hx₂ : e₂ (LinearMap.rTensor M (presentationLimitMapAlgHom P h₂W).toLinearMap x) =
        LocalizedModule.mk x 1 :=
      tensorLocalizedAddEquiv_rTensor_apply P h₂W M (∏ i ∈ t, f i) hloc₂ x
    have he₂ : e₂.symm (LocalizedModule.mk x 1) =
        LinearMap.rTensor M (presentationLimitMapAlgHom P h₂W).toLinearMap x :=
      e₂.injective ((e₂.apply_symm_apply _).trans hx₂.symm)
    -- Evaluate the composite `(e₁ ∘ L ∘ e₂⁻¹) (mk x 1)` step by step.
    change e₁ (L (e₂.symm (LocalizedModule.mk x 1))) = LocalizedModule.mk x 1
    rw [he₂]
    have hL : L (LinearMap.rTensor M (presentationLimitMapAlgHom P h₂W).toLinearMap x) =
        LinearMap.rTensor M (presentationLimitMapAlgHom P h₁W).toLinearMap x :=
      (rTensor_presentationLimitMapAlgHom_comp P Aplus h₁₂ h₂W M x).symm
    rw [hL]
    exact tensorLocalizedAddEquiv_rTensor_apply P h₁W M (∏ i ∈ s, f i) hloc₁ x
  have hval := LinearMap.congr_fun hg (e₂ z)
  rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.coe_coe,
    e₂.symm_apply_apply] at hval
  exact hval

/-- Transport `isLocalization_away_presentationLimit_spaBasicOpen_of_mul` along an equality of
opens `U = spaBasicOpen Aplus Ts (r * g)`. -/
private theorem isLocalization_away_presentationLimit_of_eq_spaBasicOpen_mul
    {T : Finset A} {r : A} {U : Opens ↥(spa Aplus)} (hUW : U ≤ spaBasicOpen Aplus T r)
    {Ts : Finset A} {g : A} (heq : U = spaBasicOpen Aplus Ts (r * g)) :
    letI : Algebra (presentationLimit (P := P) Aplus (spaBasicOpen Aplus T r))
        (presentationLimit (P := P) Aplus U) :=
      (presentationLimitMapAlgHom P hUW).toRingHom.toAlgebra
    IsLocalization.Away
      (algebraMap A (presentationLimit (P := P) Aplus (spaBasicOpen Aplus T r)) g)
      (presentationLimit (P := P) Aplus U) := by
  let R_W := presentationLimit (P := P) Aplus (spaBasicOpen Aplus T r)
  let R_B := presentationLimit (P := P) Aplus (spaBasicOpen Aplus Ts (r * g))
  let R_U := presentationLimit (P := P) Aplus U
  have hBW : spaBasicOpen Aplus Ts (r * g) ≤ spaBasicOpen Aplus T r := heq ▸ hUW
  let _ : Algebra R_W R_B := (presentationLimitMapAlgHom P hBW).toRingHom.toAlgebra
  let _ : Algebra R_W R_U := (presentationLimitMapAlgHom P hUW).toRingHom.toAlgebra
  have _ : IsLocalization.Away (algebraMap A R_W g) R_B :=
    isLocalization_away_presentationLimit_spaBasicOpen_of_mul P hBW
  let e : R_B ≃+* R_U :=
    { toFun := presentationLimitMapAlgHom P heq.le
      invFun := presentationLimitMapAlgHom P heq.ge
      left_inv := fun x ↦ by
        have h := AlgHom.congr_fun (presentationLimitMapAlgHom_comp P heq.ge heq.le) x
        rwa [presentationLimitMapAlgHom_id] at h
      right_inv := fun x ↦ by
        have h := AlgHom.congr_fun (presentationLimitMapAlgHom_comp P heq.le heq.ge) x
        rwa [presentationLimitMapAlgHom_id] at h
      map_mul' := map_mul _
      map_add' := map_add _ }
  let eAlg : R_B ≃ₐ[R_W] R_U :=
    AlgEquiv.ofRingEquiv (f := e) fun x ↦
      AlgHom.congr_fun (presentationLimitMapAlgHom_comp P heq.le hBW) x
  exact IsLocalization.isLocalization_of_algEquiv (.powers (algebraMap A R_W g)) eAlg

/-- Natural isomorphism between `locFinsetFunctor` and `presheafCechFunctor` when each finite
intersection `∏_{i ∈ s} V i` has coordinate ring localised away from `∏_{i ∈ s} f i`. -/
private noncomputable def locFinsetPresheafNatIso {W : Opens ↥(spa Aplus)} (M : Type u)
    [AddCommGroup M] [Module A M] {κ : Type (max v u)} [LinearOrder κ] (V : κ → Set.Iic W)
    (f : κ → presentationLimit (P := P) Aplus W)
    (hloc : ∀ s : Finset κ,
      letI : Algebra (presentationLimit (P := P) Aplus W)
          (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) :=
        (presentationLimitMapAlgHom P (∏ᶜ fun i : s ↦ V i).2).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i)
        (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1)) :
    locFinsetFunctor (presentationLimit (P := P) Aplus W ⊗[A] M) f ≅
      presheafCechFunctor V (presentationLimitTensorAddCommGrpPresheaf P Aplus W M) :=
  let e (s : Finset κ) :=
    tensorLocalizedAddEquiv P (∏ᶜ fun i : s ↦ V i).2 M (∏ i ∈ s, f i) (hloc s)
  NatIso.ofComponents
    (fun S ↦
      { hom := (AddCommGrpCat.ofHom (e S.unop).toAddMonoidHom).op
        inv := (AddCommGrpCat.ofHom (e S.unop).symm.toAddMonoidHom).op
        hom_inv_id := Quiver.Hom.unop_inj <| by ext x; exact (e S.unop).apply_symm_apply x
        inv_hom_id := Quiver.Hom.unop_inj <| by ext x; exact (e S.unop).symm_apply_apply x })
    fun {S₁ S₂} φ ↦ Quiver.Hom.unop_inj <| by
      ext z
      exact (tensorLocalizedAddEquiv_comp_rTensor P
        (Subtype.coe_le_coe.mpr (leOfHom (Pi.lift fun i : S₂.unop ↦
          Pi.π (fun j : S₁.unop ↦ V j) ⟨i.1, leOfHom φ.unop i.2⟩)))
        (∏ᶜ fun i : S₂.unop ↦ V i).2 M f (leOfHom φ.unop) (hloc S₁.unop) (hloc S₂.unop) z).symm

/-- Quasi-isomorphism from the Čech complex of `presentationLimitTensorAddCommGrpPresheaf` to
`locCochainComplex` via `toStrictMonoCechComplex`. -/
private noncomputable def toLocCochainComplexHom {W : Opens ↥(spa Aplus)} (M : Type u)
    [AddCommGroup M] [Module A M] {κ : Type (max v u)} [LinearOrder κ] (V : κ → Set.Iic W)
    (f : κ → presentationLimit (P := P) Aplus W)
    (hloc : ∀ s : Finset κ,
      letI : Algebra (presentationLimit (P := P) Aplus W)
          (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) :=
        (presentationLimitMapAlgHom P (∏ᶜ fun i : s ↦ V i).2).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i)
        (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1)) :
    (cechComplexFunctor V).obj (presentationLimitTensorAddCommGrpPresheaf P Aplus W M) ⟶
      locCochainComplex (presentationLimit (P := P) Aplus W ⊗[A] M) f :=
  let P_M := presentationLimitTensorAddCommGrpPresheaf P Aplus W M
  let natIso := locFinsetPresheafNatIso P M V f hloc
  let unopNatIso :
      ((presheafCechFunctor V P_M).orderedCechComplex.unop :
        CochainComplex AddCommGrpCat.{max v u} ℕ) ≅
      (locFinsetFunctor (presentationLimit (P := P) Aplus W ⊗[A] M) f).orderedCechComplex.unop :=
    (HomologicalComplex.unopFunctor AddCommGrpCat.{max v u} (ComplexShape.down ℕ)).mapIso
      ((orderedCechComplexFunctor (AddCommGrpCat.{max v u})ᵒᵖ κ).mapIso natIso).op
  (toStrictMonoCechComplex V).app P_M ≫ (strictMonoCechComplexIso V P_M).hom ≫
    unopNatIso.hom ≫ (orderedCechLocIso (presentationLimit (P := P) Aplus W ⊗[A] M) f).hom

private instance quasiIso_toLocCochainComplexHom {W : Opens ↥(spa Aplus)} (M : Type u)
    [AddCommGroup M] [Module A M] {κ : Type (max v u)} [LinearOrder κ] (V : κ → Set.Iic W)
    (f : κ → presentationLimit (P := P) Aplus W)
    (hloc : ∀ s : Finset κ,
      letI : Algebra (presentationLimit (P := P) Aplus W)
          (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) :=
        (presentationLimitMapAlgHom P (∏ᶜ fun i : s ↦ V i).2).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i)
        (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1)) :
    QuasiIso (toLocCochainComplexHom P M V f hloc) := by
  let P_M := presentationLimitTensorAddCommGrpPresheaf P Aplus W M
  let isoRight := (strictMonoCechComplexIso V P_M).trans
    (((HomologicalComplex.unopFunctor AddCommGrpCat.{max v u} (ComplexShape.down ℕ)).mapIso
      ((orderedCechComplexFunctor (AddCommGrpCat.{max v u})ᵒᵖ κ).mapIso
        (locFinsetPresheafNatIso P M V f hloc)).op).trans
      (orderedCechLocIso (presentationLimit (P := P) Aplus W ⊗[A] M) f))
  have hEq : toLocCochainComplexHom P M V f hloc =
      (toStrictMonoCechComplex V).app P_M ≫ isoRight.hom :=
    rfl
  rw [hEq]
  exact quasiIso_comp ((toStrictMonoCechComplex V).app P_M) isoRight.hom

/-- `toLocCochainComplexHom` intertwines `cechAugmentation` with `locCoaugmentation`. -/
private theorem cechAugmentation_comp_toLocCochainComplexHom {W : Opens ↥(spa Aplus)} (M : Type u)
    [AddCommGroup M] [Module A M] {κ : Type (max v u)} [LinearOrder κ] (V : κ → Set.Iic W)
    (f : κ → presentationLimit (P := P) Aplus W)
    (hloc : ∀ s : Finset κ,
      letI : Algebra (presentationLimit (P := P) Aplus W)
          (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) :=
        (presentationLimitMapAlgHom P (∏ᶜ fun i : s ↦ V i).2).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i)
        (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1)) :
    cechAugmentation V isTerminalTop (presentationLimitTensorAddCommGrpPresheaf P Aplus W M) ≫
        toLocCochainComplexHom P M V f hloc =
      locCoaugmentation (presentationLimit (P := P) Aplus W ⊗[A] M) f := by
  let M_W := presentationLimit (P := P) Aplus W ⊗[A] M
  let P_M := presentationLimitTensorAddCommGrpPresheaf P Aplus W M
  let natIso := locFinsetPresheafNatIso P M V f hloc
  let unopNatIso :
      ((presheafCechFunctor V P_M).orderedCechComplex.unop :
        CochainComplex AddCommGrpCat.{max v u} ℕ) ≅
      (locFinsetFunctor M_W f).orderedCechComplex.unop :=
    (HomologicalComplex.unopFunctor AddCommGrpCat.{max v u} (ComplexShape.down ℕ)).mapIso
      ((orderedCechComplexFunctor (AddCommGrpCat.{max v u})ᵒᵖ κ).mapIso natIso).op
  refine HomologicalComplex.from_single_hom_ext ?_
  ext x S
  let x' : M_W := x
  have heval := ConcreteCategory.congr_hom
    ((cechAugmentation V isTerminalTop P_M).f 0 ≫=
      ((toStrictMonoCechComplex V).app P_M).f 0 ≫=
        (strictMonoCechComplexIso V P_M).hom.f 0 ≫=
          unopNatIso.hom.f 0 ≫= locXIso_hom_comp_eval M_W f 0 S) x
  have hunop := congrArg Quiver.Hom.unop (NatTrans.ι_orderedCechComplexMap_f natIso.hom S)
  simp only [unop_comp] at hunop
  have hmid :
      ((cechAugmentation V isTerminalTop P_M).f 0 ≫
          ((toStrictMonoCechComplex V).app P_M).f 0 ≫
            (strictMonoCechComplexIso V P_M).hom.f 0 ≫
              unopNatIso.hom.f 0 ≫
                ((locFinsetFunctor M_W f).orderedCechComplexι S).unop) =
        P_M.map (isTerminalTop.from (∏ᶜ fun i : S.1 ↦ V i)).op ≫
          (natIso.hom.app (op S.1)).unop := by
    -- Unfold `unopNatIso.hom.f 0` to `((orderedCechComplexMap natIso.hom).f 0).unop`.
    change (cechAugmentation V isTerminalTop P_M).f 0 ≫
        ((toStrictMonoCechComplex V).app P_M).f 0 ≫
          (strictMonoCechComplexIso V P_M).hom.f 0 ≫
            (((NatTrans.orderedCechComplexMap natIso.hom).f 0).unop ≫
              ((locFinsetFunctor M_W f).orderedCechComplexι S).unop) = _
    rw [hunop, strictMonoCechComplexIso_hom_f_comp_unop_orderedCechComplexι_assoc,
      toStrictMonoCechComplex_app_f_π_assoc]
    refine (Category.assoc _ _ _).symm.trans
      ((cechAugmentation_f_zero_comp_π V isTerminalTop P_M _ =≫ _).trans ?_)
    exact (Category.assoc _ _ _).symm.trans <|
      ((P_M.map_comp _ _).symm.trans <| congrArg P_M.map <| congrArg Quiver.Hom.op <|
        isTerminalTop.hom_ext _ _) =≫ _
  have hrhs : (locCoaugmentation M_W f).f 0 x S = LocalizedModule.mk x' 1 :=
    (congrFun (ConcreteCategory.congr_hom (locCoaugmentation_f_zero M_W f) x') S).trans
      (cechLocalizationAugmentation_apply M_W f x' S)
  exact ((heval.trans (ConcreteCategory.congr_hom hmid x)).trans
    (tensorLocalizedAddEquiv_rTensor_apply P (∏ᶜ fun i : S.1 ↦ V i).2 M (∏ i ∈ S.1, f i)
      (hloc S.1) x')).trans hrhs.symm

/-- Finite-cover Čech acyclicity for `presentationLimitTensorAddCommGrpPresheaf` when the index type
carries a linear order. -/
private theorem quasiIso_cechAugmentation_spaRationalOpens_tensor_of_finite
    (M : Type u) [AddCommGroup M] [Module A M] {W : Opens ↥(spa Aplus)}
    (hW : W ∈ spaRationalOpens Aplus) {κ : Type (max v u)} [LinearOrder κ] [Finite κ]
    (V : κ → Set.Iic W) (hV : ∀ j, (V j).1 ∈ spaRationalOpens Aplus)
    (hcov : ⨆ j, (V j).1 = W) :
    QuasiIso (cechAugmentation V isTerminalTop
      (presentationLimitTensorAddCommGrpPresheaf P Aplus W M)) := by
  obtain ⟨T, r, -, hWT⟩ := mem_spaRationalFamily_iff.mp (mem_spaRationalOpens.mp hW)
  obtain rfl : W = spaBasicOpen Aplus T r :=
    Opens.ext (hWT.trans (Set.ext fun _ ↦ mem_spaBasicOpen.symm))
  have hVbasic (j : κ) : ∃ (Tj : Finset A) (σj : A), (V j).1 = spaBasicOpen Aplus Tj σj := by
    obtain ⟨Tj, σj, -, hVj⟩ := mem_spaRationalFamily_iff.mp (mem_spaRationalOpens.mp (hV j))
    exact ⟨Tj, σj, Opens.ext (hVj.trans (Set.ext fun _ ↦ mem_spaBasicOpen.symm))⟩
  choose T' σ hVeq using hVbasic
  let R_W := presentationLimit (P := P) Aplus (spaBasicOpen Aplus T r)
  let f : κ → R_W := fun j ↦ algebraMap A R_W (σ j)
  have _ : IsLocalization.Away r R_W :=
    isLocalization_away_presentationLimit_spaBasicOpen P Aplus T r
  have hspan : Ideal.span (Set.range f) = ⊤ :=
    span_eq_top_of_spaBasicOpen_le_iSup_of_discreteTopology R_W
      (hcov.symm.trans_le (iSup_mono fun j ↦ (hVeq j).le))
  have hloc (s : Finset κ) :
      letI : Algebra R_W (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) :=
        (presentationLimitMapAlgHom P (∏ᶜ fun i : s ↦ V i).2).toRingHom.toAlgebra
      IsLocalization.Away (∏ i ∈ s, f i)
        (presentationLimit (P := P) Aplus (∏ᶜ fun i : s ↦ V i).1) := by
    obtain ⟨Ts, hTs⟩ := exists_spaBasicOpen_inf_finset (Aplus := Aplus) T r T' σ s
    have heq : (∏ᶜ fun i : s ↦ V i).1 = spaBasicOpen Aplus Ts (r * ∏ i ∈ s, σ i) := by
      rw [coe_pi_finset_eq V s, ← hTs]
      exact congrArg (spaBasicOpen Aplus T r ⊓ ·) (Finset.inf_congr rfl fun i _ ↦ hVeq i)
    rw [← map_prod (algebraMap A R_W) σ s]
    exact isLocalization_away_presentationLimit_of_eq_spaBasicOpen_mul P
      (∏ᶜ fun i : s ↦ V i).2 heq
  have _ :
      QuasiIso
        (cechAugmentation V isTerminalTop
          (presentationLimitTensorAddCommGrpPresheaf P Aplus (spaBasicOpen Aplus T r) M) ≫
            toLocCochainComplexHom P M V f hloc) := by
    rw [cechAugmentation_comp_toLocCochainComplexHom P M V f hloc]
    exact quasiIso_locCoaugmentation (R_W ⊗[A] M) f hspan
  exact quasiIso_of_comp_right _ (toLocCochainComplexHom P M V f hloc)

/-- Finite intersections of rational opens in `Set.Iic W` are rational opens. -/
private theorem prod_mem_spaRationalOpens_of_discrete {W : Opens ↥(spa Aplus)} {n : ℕ}
    (U : Fin (n + 1) → Set.Iic W) (hU : ∀ i, (U i).1 ∈ spaRationalOpens Aplus) :
    (∏ᶜ U).1 ∈ spaRationalOpens Aplus := by
  let Z : Set.Iic W := ⟨Finset.univ.inf fun i ↦ (U i).1, Set.mem_Iic.2
    ((Finset.inf_le (Finset.mem_univ (0 : Fin (n + 1)))).trans (Set.mem_Iic.1 (U 0).2))⟩
  have hZ : Z ⟶ ∏ᶜ U := Pi.lift fun i ↦ homOfLE (Subtype.mk_le_mk.2
    (Finset.inf_le (Finset.mem_univ i)))
  have e : (∏ᶜ U).1 = Finset.univ.inf fun i ↦ (U i).1 :=
    le_antisymm (Finset.le_inf fun i _ ↦ Subtype.coe_le_coe.2 (leOfHom (Pi.π U i)))
      (Subtype.coe_le_coe.2 (leOfHom hZ) : Z.1 ≤ (∏ᶜ U).1)
  rw [e]
  exact finsetInf_mem_spaRationalOpens _ fun i _ ↦ hU i

/-- **All-degree Čech acyclicity of rational covers for `𝒪 ⊗_A M` over a discrete pair.**
Let `A` be a discrete commutative ring, `P` any pair of definition of `A`, `A⁺` any subring of
`A`, `M` any `A`-module, and `W ⊆ Spa(A, A⁺)` a rational open. For every nonempty cover `U` of `W`
by rational opens (finite or infinite), the augmented Čech complex of
`presentationLimitTensorAddCommGrpPresheaf P Aplus W M` (`V ↦ 𝒪(V) ⊗_A M`) for `U` is exact in
every degree. -/
theorem quasiIso_cechAugmentation_spaRationalOpens_tensor_of_iSup_eq_of_discreteTopology
    (M : Type u) [AddCommGroup M] [Module A M] {W : Opens ↥(spa Aplus)}
    (hW : W ∈ spaRationalOpens Aplus) {ι : Type (max v u)} [Nonempty ι] (U : ι → Set.Iic W)
    (hU : ∀ i, (U i).1 ∈ spaRationalOpens Aplus) (hcov : ⨆ i, (U i).1 = W) :
    QuasiIso (cechAugmentation U isTerminalTop
      (presentationLimitTensorAddCommGrpPresheaf P Aplus W M)) := by
  classical
  have hWcomp : IsCompact (W : Set ↥(spa Aplus)) :=
    isCompact_of_mem_spaRationalFamily (mem_spaRationalOpens.mp hW)
  obtain ⟨J, hJ⟩ := hWcomp.elim_finite_subcover (fun i ↦ ((U i).1 : Set ↥(spa Aplus)))
    (fun i ↦ (U i).1.isOpen) (by rw [← Opens.coe_iSup, hcov])
  rcases J.eq_empty_or_nonempty with rfl | _
  · have hWbot : W = ⊥ := by
      simp only [Finset.notMem_empty, Set.iUnion_of_empty, Set.iUnion_empty,
        Set.subset_empty_iff] at hJ
      exact SetLike.coe_injective hJ
    obtain ⟨i₀⟩ := ‹Nonempty ι›
    exact quasiIso_cechAugmentation_of_hom U isTerminalTop _ (i₀ := i₀)
      (homOfLE (Subtype.mk_le_mk.2 (by simp [hWbot])))
  let _ : LinearOrder ↥J := LinearOrder.lift' (Fintype.equivFin ↥J) (Fintype.equivFin ↥J).injective
  let V : ↥J → Set.Iic W := fun j ↦ U j.1
  have hcovJ : ⨆ j : ↥J, (V j).1 = W := by
    refine le_antisymm (iSup_le fun j ↦ (V j).2) ?_
    intro x hx
    obtain ⟨i, hiJ, hxi⟩ := Set.mem_iUnion₂.mp (hJ hx)
    exact Opens.mem_iSup.mpr ⟨⟨i, hiJ⟩, hxi⟩
  refine quasiIso_cechAugmentation_of_quasiIso_prod_of_hom (U := U) (V := V) isTerminalTop
    (presentationLimitTensorAddCommGrpPresheaf P Aplus W M)
    (quasiIso_cechAugmentation_spaRationalOpens_tensor_of_finite P M hW V (fun j ↦ hU j.1) hcovJ)
    (fun n a ↦ ?_) (fun j ↦ ⟨j.1, ⟨𝟙 _⟩⟩)
  let Y : Set.Iic W := ∏ᶜ fun k ↦ U (a k)
  have hY : Y.1 ∈ spaRationalOpens Aplus :=
    prod_mem_spaRationalOpens_of_discrete (fun k ↦ U (a k)) (fun k ↦ hU (a k))
  rw [quasiIso_cechAugmentation_tensor_prod_iff P Y M V]
  refine quasiIso_cechAugmentation_spaRationalOpens_tensor_of_finite P M hY _
    (fun j ↦ inf_mem_spaRationalOpens hY (hU j.1)) ?_
  apply le_antisymm (iSup_le fun _ ↦ inf_le_left)
  intro x hx
  obtain ⟨j, hj⟩ := Opens.mem_iSup.mp (hcovJ.ge (Y.2 hx))
  exact Opens.mem_iSup.mpr ⟨j, hx, hj⟩

/-- **Wedhorn's Corollary 8.35 (discrete case): all-degree Čech acyclicity of rational covers.**
Let `A` be a discrete commutative ring, `P` any pair of definition of `A`, `A⁺` any subring of
`A`, and `W ⊆ Spa(A, A⁺)` a rational open. For every nonempty cover `U` of `W` by rational opens
(finite or infinite), the augmented Čech complex of `presentationLimitAddCommGrpPresheaf P Aplus W`
for `U` is exact in every degree. -/
theorem quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq_of_discreteTopology
