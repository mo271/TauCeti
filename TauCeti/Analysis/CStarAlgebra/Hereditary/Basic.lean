namespace NonUnitalStarSubalgebra

section Basic

variable {R A : Type*} [CommSemiring R] [NonUnitalNonAssocSemiring A] [Module R A] [Star A] [LE A]

/-- A nonunital `⋆`-subalgebra `B` is *hereditary* if every nonnegative element dominated by an
element of `B` belongs to `B`. -/
def IsHereditary (B : NonUnitalStarSubalgebra R A) : Prop :=
  ∀ ⦃a b : A⦄, 0 ≤ a → a ≤ b → b ∈ B → a ∈ B

theorem isHereditary_iff {B : NonUnitalStarSubalgebra R A} :
    B.IsHereditary ↔ ∀ ⦃a b : A⦄, 0 ≤ a → a ≤ b → b ∈ B → a ∈ B :=
  Iff.rfl

/-- Elimination rule for heredity: if `B` is hereditary and `0 ≤ a ≤ b ∈ B`, then `a ∈ B`. -/
theorem IsHereditary.mem_of_nonneg_of_le {B : NonUnitalStarSubalgebra R A} (hB : B.IsHereditary)
    {a b : A} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ∈ B) : a ∈ B :=
  hB ha hab hb

end Basic

section Lattice

variable {R A : Type*} [CommSemiring R] [StarRing R] [NonUnitalSemiring A] [StarRing A]
  [Module R A] [IsScalarTower R A A] [SMulCommClass R A A] [StarModule R A]

@[simp]
theorem isHereditary_top [LE A] : (⊤ : NonUnitalStarSubalgebra R A).IsHereditary :=
  fun _ _ _ _ _ => trivial

theorem IsHereditary.inf [LE A] {B₁ B₂ : NonUnitalStarSubalgebra R A}
    (h₁ : B₁.IsHereditary) (h₂ : B₂.IsHereditary) : (B₁ ⊓ B₂).IsHereditary :=
  fun _ _ ha hab hb => ⟨h₁ ha hab hb.1, h₂ ha hab hb.2⟩

theorem isHereditary_sInf [LE A] {S : Set (NonUnitalStarSubalgebra R A)}
    (hS : ∀ B ∈ S, B.IsHereditary) : (sInf S).IsHereditary := by
  intro a b ha hab hb
  rw [NonUnitalStarAlgebra.mem_sInf] at hb ⊢
  exact fun B hB => hS B hB ha hab (hb B hB)

theorem isHereditary_iInf [LE A] {ι : Sort*} {f : ι → NonUnitalStarSubalgebra R A}
    (hf : ∀ i, (f i).IsHereditary) : (⨅ i, f i).IsHereditary :=
  isHereditary_sInf (Set.forall_mem_range.mpr hf)

@[simp]
theorem isHereditary_bot [PartialOrder A] : (⊥ : NonUnitalStarSubalgebra R A).IsHereditary := by
  intro a b ha hab hb
  rw [NonUnitalStarAlgebra.mem_bot] at hb ⊢
  exact le_antisymm (hb ▸ hab) ha

end Lattice

section Comap

variable {R A B : Type*} [CommSemiring R] [NonUnitalNonAssocSemiring A] [Module R A] [Star A]
  [NonUnitalNonAssocSemiring B] [Module R B] [Star B]

theorem IsHereditary.comap [Preorder A] [Preorder B]
    {S : NonUnitalStarSubalgebra R B} (hS : S.IsHereditary) {f : A →⋆ₙₐ[R] B} (hf : Monotone f) :
    (S.comap f).IsHereditary := by
  intro a b ha hab hb
  exact hS (map_zero f ▸ hf ha) (hf hab) hb

end Comap

section CStarAlgebra

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- If `B` is a hereditary nonunital `⋆`-subalgebra of a C⋆-algebra (not necessarily closed), then
`b₁ * x * b₂ ∈ B` for all `b₁, b₂ ∈ B` and `x ∈ A`. -/
theorem IsHereditary.mul_mul_mem {B : NonUnitalStarSubalgebra ℂ A} (hB : B.IsHereditary)
    {b₁ b₂ : A} (hb₁ : b₁ ∈ B) (hb₂ : b₂ ∈ B) (x : A) : b₁ * x * b₂ ∈ B := by
  -- Step 1: For every `w ∈ B` and `y : A`, show `star w * y * w ∈ B` using `span_nonneg`.
  have hdiag : ∀ w ∈ B, ∀ y : A, star w * y * w ∈ B := by
    intro w hw y
    let S : Submodule ℂ A :=
      { carrier := {z : A | star w * z * w ∈ B}
        add_mem' := fun {z₁ z₂} hz₁ hz₂ => by
          simpa [mul_add, add_mul] using B.add_mem hz₁ hz₂
        zero_mem' := by simp
        smul_mem' := fun c z hz => by
          simpa [mul_smul_comm, smul_mul_assoc] using B.smul_mem c hz }
    have hnonneg : {z : A | 0 ≤ z} ⊆ (S : Set A) := by
      intro z hz
      have hle : star w * z * w ≤ ‖z‖ • (star w * w) :=
        CStarAlgebra.star_left_conjugate_le_norm_smul w z
      have hmem : ‖z‖ • (star w * w) ∈ B := by
        rw [← Complex.coe_smul]
        exact SMulMemClass.smul_mem (‖z‖ : ℂ) (mul_mem (star_mem hw) hw)
      exact hB (star_left_conjugate_nonneg hz w) hle hmem
    have htop : S = ⊤ := by
      rw [eq_top_iff, ← CStarAlgebra.span_nonneg, Submodule.span_le]
      exact hnonneg
    have hy : y ∈ S := htop.symm ▸ Submodule.mem_top
    exact hy
  -- Step 2: Polarize `star u * x * v` with `u = star b₁` and `v = b₂`.
  set u : A := star b₁
  have hpol : (4 : ℂ) • (star u * x * b₂) =
      star (u + b₂) * x * (u + b₂) - star (u - b₂) * x * (u - b₂) -
        Complex.I • (star (u + Complex.I • b₂) * x * (u + Complex.I • b₂)) +
        Complex.I • (star (u - Complex.I • b₂) * x * (u - Complex.I • b₂)) := by
    simp only [star_add, star_sub, star_smul, Complex.star_def, Complex.conj_I, add_mul, sub_mul,
      mul_add, mul_sub, smul_mul_assoc, mul_smul_comm, smul_add, smul_sub, smul_smul,
      Complex.I_mul_I, mul_neg]
    module
  have hu : u ∈ B := star_mem hb₁
  have hfour : (4 : ℂ) • (star u * x * b₂) ∈ B := by
    rw [hpol]
    refine B.add_mem (B.sub_mem (B.sub_mem ?_ ?_) (B.smul_mem Complex.I ?_))
      (B.smul_mem Complex.I ?_)
    · exact hdiag _ (B.add_mem hu hb₂) x
    · exact hdiag _ (B.sub_mem hu hb₂) x
    · exact hdiag _ (B.add_mem hu (B.smul_mem Complex.I hb₂)) x
    · exact hdiag _ (B.sub_mem hu (B.smul_mem Complex.I hb₂)) x
  simpa [u, smul_smul, star_star] using B.smul_mem (4 : ℂ)⁻¹ hfour

/-- A closed nonunital `⋆`-subalgebra `B` of a C⋆-algebra is hereditary if `b * x * b ∈ B` for
every nonnegative `b ∈ B` and every `x ∈ A`. -/
theorem isHereditary_of_nonneg_mul_mul_mem {B : NonUnitalStarSubalgebra ℂ A}
    [hB_closed : IsClosed (B : Set A)]
    (h : ∀ ⦃b : A⦄, b ∈ B → 0 ≤ b → ∀ x : A, b * x * b ∈ B) : B.IsHereditary := by
  intro a b ha hab hb
  have _ : StarOrderedRing B := Subtype.starOrderedRing B
  have hl := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  let s : A := CFC.sqrt a
  have hs_nonneg : 0 ≤ s := CFC.sqrt_nonneg a
  have hs_sq : star s * s = a := by
    rw [hs_nonneg.star_eq]
    exact CFC.sqrt_mul_sqrt_self a ha
  -- Along the approximate unit `e` of `B`, `√a * e → √a`, hence `e * √a → √a` and `e * a * e → a`.
  have hse_lim : Tendsto (fun e : B => s * (e : A)) (CStarAlgebra.approximateUnit B) (𝓝 s) :=
    B.tendsto_mul_approximateUnit_of_star_mul_self_le hb (hs_sq.symm ▸ hab)
  have hes_lim : Tendsto (fun e : B => (e : A) * s) (CStarAlgebra.approximateUnit B) (𝓝 s) := by
    have hstar : Tendsto (fun e : B => star (s * (e : A)))
        (CStarAlgebra.approximateUnit B) (𝓝 (star s)) :=
      (continuous_star.tendsto s).comp hse_lim
    rw [hs_nonneg.star_eq] at hstar
    refine hstar.congr' ?_
    filter_upwards [hl.eventually_nonneg] with e (he : 0 ≤ (e : A))
    rw [star_mul, he.star_eq, hs_nonneg.star_eq]
  have heae_lim : Tendsto (fun e : B => (e : A) * a * (e : A))
      (CStarAlgebra.approximateUnit B) (𝓝 a) := by
    have hmul := hes_lim.mul hse_lim
    rw [CFC.sqrt_mul_sqrt_self a ha] at hmul
    have hmul_eq : ∀ e : B, ((e : A) * s) * (s * (e : A)) = (e : A) * a * (e : A) := fun e => by
      rw [mul_assoc, ← mul_assoc s s, CFC.sqrt_mul_sqrt_self a ha, ← mul_assoc]
    simpa only [hmul_eq] using hmul
  exact hB_closed.mem_of_tendsto heae_lim <|
    hl.eventually_nonneg.mono fun e (he : 0 ≤ (e : A)) => h e.2 he a

/-- **Blackadar II.5.3.1**: characterizations of closed hereditary C⋆-subalgebras. -/
theorem isHereditary_tfae (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    List.TFAE
      [ B.IsHereditary,
        ∀ ⦃b : A⦄, b ∈ B → 0 ≤ b → ∀ x : A, b * x * b ∈ B,
        ∀ ⦃b₁ b₂ : A⦄, b₁ ∈ B → b₂ ∈ B → ∀ x : A, b₁ * x * b₂ ∈ B ] := by
  tfae_have 1 → 3 := fun hB _ _ hb₁ hb₂ x => hB.mul_mul_mem hb₁ hb₂ x
  tfae_have 3 → 2 := fun h _ hb _ x => h hb hb x
  tfae_have 2 → 1 := isHereditary_of_nonneg_mul_mul_mem
  tfae_finish

/-- A closed nonunital `⋆`-subalgebra `B` of a C⋆-algebra is hereditary if and only if
`b₁ * x * b₂ ∈ B` for all `b₁, b₂ ∈ B` and `x ∈ A`. -/
theorem isHereditary_iff_mul_mul_mem (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    B.IsHereditary ↔ ∀ ⦃b₁ b₂ : A⦄, b₁ ∈ B → b₂ ∈ B → ∀ x : A, b₁ * x * b₂ ∈ B :=
  (B.isHereditary_tfae).out 1 3

/-- A closed nonunital `⋆`-subalgebra `B` of a C⋆-algebra is hereditary if and only if
`b * x * b ∈ B` for all nonnegative `b ∈ B` and `x ∈ A`. -/
theorem isHereditary_iff_nonneg_mul_mul_mem (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] :
    B.IsHereditary ↔ ∀ ⦃b : A⦄, b ∈ B → 0 ≤ b → ∀ x : A, b * x * b ∈ B :=
  (B.isHereditary_tfae).out 1 2

end CStarAlgebra

end NonUnitalStarSubalgebra

namespace TwoSidedIdeal

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- Every closed two-sided ideal of a C⋆-algebra is hereditary: if `0 ≤ a ≤ b` and `b ∈ I`, then
`a ∈ I` (Blackadar II.5.1.1(ii)). -/
theorem mem_of_nonneg_of_le (I : TwoSidedIdeal A) [IsClosed (I : Set A)] {a b : A}
    (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ∈ I) : a ∈ I := by
  let _ : PartialOrder (A ⧸ I) := CStarAlgebra.spectralOrder (A ⧸ I)
  have _ : StarOrderedRing (A ⧸ I) := CStarAlgebra.spectralOrderedRing (A ⧸ I)
  set q : A →⋆ₙₐ[ℂ] A ⧸ I := TwoSidedIdeal.Quotient.mkStarAlgHom I
  have hqa_nonneg : 0 ≤ q a := map_nonneg q ha
  have hqa_le : q a ≤ q b :=
    sub_nonneg.mp (by rw [← map_sub]; exact map_nonneg q (sub_nonneg.mpr hab))
  have hqb : q b = 0 := by
    rw [TwoSidedIdeal.Quotient.mkStarAlgHom_apply]
    exact TwoSidedIdeal.Quotient.eq_zero_iff_mem.mpr hb
  have hqa_zero : q a = 0 := le_antisymm (hqb ▸ hqa_le) hqa_nonneg
  rw [TwoSidedIdeal.Quotient.mkStarAlgHom_apply] at hqa_zero
  exact TwoSidedIdeal.Quotient.eq_zero_iff_mem.mp hqa_zero

/-- Every closed two-sided ideal of a C⋆-algebra is a hereditary C⋆-subalgebra. -/
@[simp]
theorem isHereditary_toNonUnitalStarSubalgebra (I : TwoSidedIdeal A) [IsClosed (I : Set A)] :
    I.toNonUnitalStarSubalgebra.IsHereditary :=
  fun _ _ ha hab hb =>
    I.mem_toNonUnitalStarSubalgebra.mpr
      (I.mem_of_nonneg_of_le ha hab (I.mem_toNonUnitalStarSubalgebra.mp hb))

end TwoSidedIdeal

namespace Ideal

variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- Every closed two-sided `Ideal` of a unital C⋆-algebra is hereditary. -/
theorem mem_of_nonneg_of_le (I : Ideal A) [I.IsTwoSided] [hI : IsClosed (I : Set A)] {a b : A}
    (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ∈ I) : a ∈ I := by
  have : IsClosed (I.toTwoSided : Set A) := by simpa only [Ideal.coe_toTwoSided] using hI
  rw [← Ideal.mem_toTwoSided] at hb ⊢
  exact I.toTwoSided.mem_of_nonneg_of_le ha hab hb

/-- Every closed two-sided `Ideal` of a unital C⋆-algebra is a hereditary C⋆-subalgebra. -/
@[simp]
theorem isHereditary_toNonUnitalStarSubalgebra (I : Ideal A) [I.IsTwoSided] [IsClosed (I : Set A)] :
    I.toNonUnitalStarSubalgebra.IsHereditary :=
  fun _ _ ha hab hb =>
    I.mem_toNonUnitalStarSubalgebra.mpr
      (I.mem_of_nonneg_of_le ha hab (I.mem_toNonUnitalStarSubalgebra.mp hb))

end Ideal

namespace TauCeti

section CornerSubalgebra

variable (R : Type*) {A : Type*} [CommSemiring R] [NonUnitalSemiring A] [StarRing A] [Module R A]
  [IsScalarTower R A A] [SMulCommClass R A A]

/-- The algebraic corner `a * A * a` associated with a self-adjoint element `a`, bundled as a
nonunital `⋆`-subalgebra. -/
def cornerSubalgebra {a : A} (ha : IsSelfAdjoint a) : NonUnitalStarSubalgebra R A where
  carrier := Set.range fun x : A => a * x * a
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * a * a * y, by simp [mul_assoc]⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, by simp [mul_add, add_mul]⟩
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := by
    rintro r _ ⟨x, rfl⟩
    exact ⟨r • x, by simp [smul_mul_assoc, mul_smul_comm]⟩
  star_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨star x, by simp [star_mul, ha.star_eq, mul_assoc]⟩

@[simp]
theorem coe_cornerSubalgebra {a : A} (ha : IsSelfAdjoint a) :
    (cornerSubalgebra R ha : Set A) = Set.range fun x : A => a * x * a :=
  (rfl)

@[simp]
theorem mem_cornerSubalgebra_iff {a : A} (ha : IsSelfAdjoint a) {x : A} :
    x ∈ cornerSubalgebra R ha ↔ ∃ y : A, a * y * a = x :=
  Iff.rfl

theorem mul_mul_mem_cornerSubalgebra {a : A} (ha : IsSelfAdjoint a) (x : A) :
    a * x * a ∈ cornerSubalgebra R ha :=
  ⟨x, rfl⟩

/-- For a star projection `p`, the algebraic corner `p * A * p` consists precisely of the elements
fixed by `x ↦ p * x * p`. -/
theorem mem_cornerSubalgebra_iff_of_isStarProjection {p : A} (hp : IsStarProjection p) {x : A} :
    x ∈ cornerSubalgebra R hp.isSelfAdjoint ↔ p * x * p = x := by
  constructor
  · rintro ⟨y, rfl⟩
    calc
      p * (p * y * p) * p = (p * p) * y * (p * p) := by simp [mul_assoc]
      _ = p * y * p := by rw [hp.isIdempotentElem.eq]
  · intro h
    exact ⟨x, h⟩

end CornerSubalgebra

namespace CStarAlgebra

section HereditarySubalgebra

section NonOrder

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The closed hereditary C⋆-subalgebra `closure (a * A * a)` generated by a self-adjoint (in
particular, nonnegative) element `a`. -/
def hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) : NonUnitalStarSubalgebra ℂ A :=
  (cornerSubalgebra ℂ ha).topologicalClosure

@[simp]
theorem coe_hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) :
    (hereditarySubalgebra ha : Set A) = closure (Set.range fun x : A => a * x * a) :=
  (rfl)

instance isClosed_hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) :
    IsClosed (hereditarySubalgebra ha : Set A) :=
  (cornerSubalgebra ℂ ha).isClosed_topologicalClosure

@[simp]
theorem hereditarySubalgebra_zero :
    hereditarySubalgebra (IsSelfAdjoint.zero A) = ⊥ := by
  ext x
  rw [← SetLike.mem_coe, coe_hereditarySubalgebra, NonUnitalStarAlgebra.mem_bot]
  have hrange : (Set.range fun y : A => (0 : A) * y * 0) = {0} := by
    ext y
    simp
  rw [hrange, closure_singleton, Set.mem_singleton_iff]

theorem mul_mul_mem_hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) (x : A) :
    a * x * a ∈ hereditarySubalgebra ha :=
  NonUnitalStarSubalgebra.le_topologicalClosure _ (mul_mul_mem_cornerSubalgebra ℂ ha x)

/-- Any self-adjoint element `a` belongs to its generated hereditary C⋆-subalgebra
`closure (a * A * a)`. -/
theorem self_mem_hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) :
    a ∈ hereditarySubalgebra ha := by
  -- Approximate `a` by `a * cfcₙ (t ↦ t / (δ + t²)) a * a` as `δ = (n + 1)⁻¹ → 0`.
  let δ : ℕ → ℝ := fun n => ((n + 1 : ℕ) : ℝ)⁻¹
  let f : ℕ → ℝ → ℝ := fun n t => t / (δ n + t ^ 2)
  have hδ_pos : ∀ n, 0 < δ n := fun n => by positivity
  have hlim : Tendsto (fun n => a * cfcₙ (f n) a * a) atTop (𝓝 a) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have hδ_lim : Tendsto δ atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp (tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1))
    have hbound_lim : Tendsto (fun n => Real.sqrt (δ n) / 2) atTop (𝓝 0) := by
      simpa only [Real.sqrt_zero, zero_div, Function.comp_def] using
        ((Real.continuous_sqrt.tendsto 0).comp hδ_lim).div_const 2
    refine squeeze_zero_norm (fun n => ?_) hbound_lim
    rw [Real.norm_of_nonneg (norm_nonneg _), norm_sub_rev]
    have hf_cont : Continuous (f n) := by
      fun_prop (disch := intro t; have := hδ_pos n; positivity)
    have hdiff_eq : a - a * cfcₙ (f n) a * a = cfcₙ (fun t : ℝ => t - t * f n t * t) a := by
      have h1 : a * cfcₙ (f n) a = cfcₙ (fun t : ℝ => t * f n t) a := by
        simpa only [cfcₙ_id' ℝ a] using (cfcₙ_mul (fun t : ℝ => t) (f n) a continuousOn_id rfl
          hf_cont.continuousOn (by simp [f])).symm
      have h2 : a * cfcₙ (f n) a * a = cfcₙ (fun t : ℝ => t * f n t * t) a := by
        rw [h1]
        simpa only [cfcₙ_id' ℝ a] using (cfcₙ_mul (fun t : ℝ => t * f n t) (fun t : ℝ => t) a
          (continuousOn_id.mul hf_cont.continuousOn) (by simp) continuousOn_id rfl).symm
      rw [h2]
      simpa only [cfcₙ_id' ℝ a] using (cfcₙ_sub (fun t : ℝ => t) (fun t : ℝ => t * f n t * t) a
        continuousOn_id rfl ((continuousOn_id.mul hf_cont.continuousOn).mul continuousOn_id)
        (by simp)).symm
    rw [hdiff_eq]
    refine norm_cfcₙ_le fun t _ => ?_
    have hpos : 0 < δ n + t ^ 2 := by have := hδ_pos n; positivity
    have hrew : t - t * f n t * t = δ n * t / (δ n + t ^ 2) := by
      simp only [f]; field_simp [hpos.ne']; ring
    rw [hrew, Real.norm_eq_abs, abs_div, abs_mul, abs_of_pos (hδ_pos n), abs_of_pos hpos,
      div_le_iff₀ hpos]
    have hamgm : 2 * Real.sqrt (δ n) * |t| ≤ δ n + t ^ 2 := by
      nlinarith [sq_nonneg (Real.sqrt (δ n) - |t|), Real.sq_sqrt (hδ_pos n).le, sq_abs t]
    have hsq : Real.sqrt (δ n) * Real.sqrt (δ n) = δ n := Real.mul_self_sqrt (hδ_pos n).le
    nlinarith [mul_le_mul_of_nonneg_left hamgm (by positivity : 0 ≤ Real.sqrt (δ n) / 2),
      congrArg (· * |t|) hsq]
  exact (isClosed_hereditarySubalgebra ha).mem_of_tendsto hlim
    (Eventually.of_forall fun n => mul_mul_mem_hereditarySubalgebra ha _)

/-- For a star projection `p`, the hereditary C⋆-subalgebra `closure (p * A * p)` equals the
already-closed corner `{x : A | p * x * p = x}`. -/
@[simp]
theorem mem_hereditarySubalgebra_iff_of_isStarProjection {p : A} (hp : IsStarProjection p) {x : A} :
    x ∈ hereditarySubalgebra hp.isSelfAdjoint ↔ p * x * p = x := by
  have hset : (cornerSubalgebra ℂ hp.isSelfAdjoint : Set A) = {y : A | p * y * p = y} :=
    Set.ext fun _ => mem_cornerSubalgebra_iff_of_isStarProjection ℂ hp
  have hclosed : IsClosed (cornerSubalgebra ℂ hp.isSelfAdjoint : Set A) := by
    rw [hset]
    exact isClosed_eq ((continuous_const.mul continuous_id).mul continuous_const) continuous_id
  rw [← SetLike.mem_coe, coe_hereditarySubalgebra, ← coe_cornerSubalgebra ℂ hp.isSelfAdjoint,
    hclosed.closure_eq, hset, Set.mem_ofPred_eq]

end NonOrder

section Order

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The closed subalgebra `closure (a * A * a)` is hereditary. -/
@[simp]
theorem isHereditary_hereditarySubalgebra {a : A} (ha : IsSelfAdjoint a) :
    (hereditarySubalgebra ha).IsHereditary := by
  rw [NonUnitalStarSubalgebra.isHereditary_iff_mul_mul_mem]
  intro b₁ b₂ hb₁ hb₂ x
  have hcont : Continuous (Function.uncurry fun u v : A => u * x * v) :=
    (continuous_fst.mul continuous_const).mul continuous_snd
  refine map_mem_closure₂ (f := fun u v : A => u * x * v) hcont hb₁ hb₂ ?_
  rintro _ ⟨y₁, rfl⟩ _ ⟨y₂, rfl⟩
  exact ⟨y₁ * a * x * a * y₂, by simp [mul_assoc]⟩

/-- Universal property of `hereditarySubalgebra`: it is the least closed hereditary C⋆-subalgebra
containing `a`. -/
theorem hereditarySubalgebra_le_iff {a : A} (ha : IsSelfAdjoint a)
    {B : NonUnitalStarSubalgebra ℂ A} [hB_closed : IsClosed (B : Set A)] (hB : B.IsHereditary) :
    hereditarySubalgebra ha ≤ B ↔ a ∈ B := by
  constructor
  · intro h
    exact h (self_mem_hereditarySubalgebra ha)
  · intro haB
    refine NonUnitalStarSubalgebra.topologicalClosure_minimal _ ?_ hB_closed
    rintro _ ⟨x, rfl⟩
    exact hB.mul_mul_mem haB haB x

/-- Monotonicity of generated hereditary C⋆-subalgebras on nonnegative elements. -/
theorem hereditarySubalgebra_mono {a b : A} (ha : 0 ≤ a) (hab : a ≤ b) :
    hereditarySubalgebra ha.isSelfAdjoint ≤ hereditarySubalgebra (ha.trans hab).isSelfAdjoint := by
  rw [hereditarySubalgebra_le_iff _ (isHereditary_hereditarySubalgebra _)]
  exact (isHereditary_hereditarySubalgebra _) ha hab (self_mem_hereditarySubalgebra _)

end Order

end HereditarySubalgebra

section FullAndStrictlyPositive

/-- An element `a` of a topological ring is *full* if it generates the whole ring as a closed
two-sided ideal. -/
def IsFull {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A] (a : A) :
    Prop :=
  (TwoSidedIdeal.span {a}).topologicalClosure = ⊤

theorem isFull_iff {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    {a : A} : IsFull a ↔ (TwoSidedIdeal.span {a}).topologicalClosure = ⊤ :=
  Iff.rfl

theorem isFull_iff_forall_ideal_eq_top {A : Type*} [NonUnitalRing A] [TopologicalSpace A]
    [IsTopologicalRing A] {a : A} :
    IsFull a ↔ ∀ I : TwoSidedIdeal A, IsClosed (I : Set A) → a ∈ I → I = ⊤ := by
  constructor
  · intro h I hI haI
    rw [eq_top_iff, ← h, TwoSidedIdeal.topologicalClosure_le_iff _ _ hI, TwoSidedIdeal.span_le,
      Set.singleton_subset_iff]
    exact haI
  · intro h
    exact h _ (TwoSidedIdeal.isClosed_topologicalClosure _)
      (TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span rfl))

/-- `0` is full in a `T1Space` topological ring if and only if the ring is trivial. -/
@[simp]
theorem isFull_zero_iff {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [T1Space A] : IsFull (0 : A) ↔ Subsingleton A := by
  rw [isFull_iff_forall_ideal_eq_top]
  constructor
  · intro h
    have hbot : (⊥ : TwoSidedIdeal A) = ⊤ := by
      refine h ⊥ ?_ (TwoSidedIdeal.zero_mem ⊥)
      have hcoe : ((⊥ : TwoSidedIdeal A) : Set A) = {0} := by
        ext x
        simp
      rw [hcoe]
      exact isClosed_singleton
    refine ⟨fun x y => ?_⟩
    have hx : x ∈ (⊥ : TwoSidedIdeal A) := hbot.symm ▸ trivial
    have hy : y ∈ (⊥ : TwoSidedIdeal A) := hbot.symm ▸ trivial
    rw [TwoSidedIdeal.mem_bot] at hx hy
    exact hx.trans hy.symm
  · intro _ I _ _
    rw [eq_top_iff]
    intro x _
    simp [Subsingleton.elim x 0]

/-- The unit of a unital topological ring is full. -/
@[simp]
theorem isFull_one {D : Type*} [Ring D] [TopologicalSpace D] [IsTopologicalRing D] :
    IsFull (1 : D) := by
  rw [isFull_iff, eq_top_iff]
  intro x _
  exact TwoSidedIdeal.le_topologicalClosure _ <| by
    simpa using (TwoSidedIdeal.span {(1 : D)}).mul_mem_left x 1 (TwoSidedIdeal.subset_span rfl)

section StrictlyPositiveDef

variable {A : Type*} [NonUnitalSemiring A] [LE A] [TopologicalSpace A]

/-- In a possibly nonunital ordered topological algebra (in particular a C⋆-algebra `A`), an
element `a : A` is *strictly positive* (Blackadar II.4.2.1) when `0 ≤ a` and `a * A * a` is dense
in `A` (equivalently, `a` generates `A` as a hereditary C⋆-subalgebra). For unital C⋆-algebras,
this coincides with Mathlib's `_root_.IsStrictlyPositive a` (`isStrictlyPositive_iff_unital`). -/
def IsStrictlyPositive (a : A) : Prop :=
  0 ≤ a ∧ Dense (Set.range fun x : A => a * x * a)

theorem isStrictlyPositive_iff {a : A} :
    IsStrictlyPositive a ↔ 0 ≤ a ∧ Dense (Set.range fun x : A => a * x * a) :=
  Iff.rfl

theorem IsStrictlyPositive.nonneg {a : A} (ha : IsStrictlyPositive a) : 0 ≤ a :=
  ha.1

theorem IsStrictlyPositive.dense_range_mul_mul {a : A} (ha : IsStrictlyPositive a) :
    Dense (Set.range fun x : A => a * x * a) :=
  ha.2

/-- `0` is strictly positive if and only if the algebra is trivial. -/
@[simp]
theorem isStrictlyPositive_zero_iff {A : Type*} [NonUnitalSemiring A] [Preorder A]
    [TopologicalSpace A] [T1Space A] : IsStrictlyPositive (0 : A) ↔ Subsingleton A := by
  constructor
  · intro h
    refine ⟨fun x y => ?_⟩
    have hrange : (Set.range fun z : A => (0 : A) * z * 0) ⊆ {0} := by
      rintro _ ⟨z, rfl⟩
      simp
    have hcl : closure (Set.range fun z : A => (0 : A) * z * 0) ⊆ {0} :=
      closure_minimal hrange isClosed_singleton
    have hx : x = 0 := Set.mem_singleton_iff.mp (hcl (h.dense_range_mul_mul x))
    have hy : y = 0 := Set.mem_singleton_iff.mp (hcl (h.dense_range_mul_mul y))
    exact hx.trans hy.symm
  · intro _
    refine ⟨le_rfl, fun x => ?_⟩
    exact subset_closure ⟨0, Subsingleton.elim _ _⟩

end StrictlyPositiveDef

section StrictlyPositiveCStar

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- A nonnegative element is strictly positive in the C⋆-algebra sense if and only if its generated
hereditary C⋆-subalgebra is `⊤`. -/
theorem isStrictlyPositive_iff_hereditarySubalgebra_eq_top {a : A} (ha : 0 ≤ a) :
    IsStrictlyPositive a ↔ hereditarySubalgebra ha.isSelfAdjoint = ⊤ := by
  rw [isStrictlyPositive_iff, and_iff_right ha, eq_top_iff]
  constructor
  · intro h x _
    rw [← SetLike.mem_coe, coe_hereditarySubalgebra]
    exact h x
  · intro h x
    rw [← coe_hereditarySubalgebra ha.isSelfAdjoint, SetLike.mem_coe]
    exact h trivial

/-- A nonnegative element `a` is strictly positive if and only if `a * A` is dense in `A`. -/
theorem isStrictlyPositive_iff_dense_range_mul {a : A} (ha : 0 ≤ a) :
    IsStrictlyPositive a ↔ Dense (Set.range fun x : A => a * x) := by
  constructor
  · intro h
    refine h.dense_range_mul_mul.mono ?_
    rintro _ ⟨x, rfl⟩
    exact ⟨x * a, (mul_assoc a x a).symm⟩
  · intro hdense
    rw [isStrictlyPositive_iff_hereditarySubalgebra_eq_top ha, eq_top_iff]
    -- Every `z * star z` lies in `closure (a * A * a)` by continuity of `y ↦ y * star y`.
    have hmul_star : ∀ z : A, z * star z ∈ hereditarySubalgebra ha.isSelfAdjoint := by
      intro z
      have hz : z ∈ closure (Set.range fun x : A => a * x) := hdense z
      have hcont : Continuous fun y : A => y * star y := continuous_id.mul continuous_star
      rw [← SetLike.mem_coe, ← (isClosed_hereditarySubalgebra ha.isSelfAdjoint).closure_eq]
      refine map_mem_closure (f := fun y : A => y * star y) hcont hz ?_
      rintro _ ⟨x, rfl⟩
      dsimp only
      have heq : (a * x) * star (a * x) = a * (x * star x) * a := by
        simp only [star_mul, ha.star_eq, mul_assoc]
      rw [heq]
      exact mul_mul_mem_hereditarySubalgebra ha.isSelfAdjoint (x * star x)
    -- Every nonnegative element is `√y * star (√y) ∈ hereditarySubalgebra`, and these span `A`.
    have hnonneg : {y : A | 0 ≤ y} ⊆ (hereditarySubalgebra ha.isSelfAdjoint : Set A) := by
      intro y hy
      have hsq : CFC.sqrt y * star (CFC.sqrt y) = y := by
        rw [(CFC.sqrt_nonneg y).star_eq]
        exact CFC.sqrt_mul_sqrt_self y hy
      exact hsq ▸ hmul_star (CFC.sqrt y)
    have hsub : (⊤ : Submodule ℂ A) ≤ (hereditarySubalgebra ha.isSelfAdjoint).toSubmodule := by
      rw [← CStarAlgebra.span_nonneg, Submodule.span_le]
      exact hnonneg
    intro x _
    exact hsub Submodule.mem_top

/-- Every strictly positive element of a C⋆-algebra is full. -/
theorem IsStrictlyPositive.isFull {a : A} (ha : IsStrictlyPositive a) : IsFull a := by
  rw [isFull_iff_forall_ideal_eq_top]
  intro I hI haI
  have hle : hereditarySubalgebra ha.nonneg.isSelfAdjoint ≤ I.toNonUnitalStarSubalgebra :=
    (hereditarySubalgebra_le_iff ha.nonneg.isSelfAdjoint
      I.isHereditary_toNonUnitalStarSubalgebra).mpr (I.mem_toNonUnitalStarSubalgebra.mpr haI)
  rw [(isStrictlyPositive_iff_hereditarySubalgebra_eq_top ha.nonneg).mp ha] at hle
  rw [eq_top_iff]
  intro x _
  exact I.mem_toNonUnitalStarSubalgebra.mp (hle trivial)

/-- Strict positivity in the C⋆-algebra sense is upward closed. -/
theorem IsStrictlyPositive.of_le {a b : A} (ha : IsStrictlyPositive a) (hab : a ≤ b) :
    IsStrictlyPositive b := by
  have hb : 0 ≤ b := ha.nonneg.trans hab
  rw [isStrictlyPositive_iff_hereditarySubalgebra_eq_top hb, eq_top_iff]
  rw [← (isStrictlyPositive_iff_hereditarySubalgebra_eq_top ha.nonneg).mp ha]
  exact hereditarySubalgebra_mono ha.nonneg hab

/-- In a unital C⋆-algebra, strict positivity in the nonunital C⋆-algebra sense
(`0 ≤ a` and `closure (a * A * a) = A`) coincides with Mathlib's `_root_.IsStrictlyPositive a`
(`0 ≤ a ∧ IsUnit a`). -/
theorem isStrictlyPositive_iff_unital {D : Type*} [CStarAlgebra D] [PartialOrder D] {a : D} :
    IsStrictlyPositive a ↔ _root_.IsStrictlyPositive a := by
  constructor
  · rintro ⟨ha, hdense⟩
    refine ⟨ha, ?_⟩
    obtain ⟨y, hy⟩ := Metric.denseRange_iff.mp hdense 1 1 one_pos
    rw [dist_eq_norm] at hy
    have hunit : IsUnit (a * y * a) := by
      simpa only [sub_sub_cancel] using isUnit_one_sub_of_norm_lt_one hy
    obtain ⟨u, hu⟩ := hunit
    -- From `a * y * a = u`, `y * a * u⁻¹` is a right inverse and `u⁻¹ * a * y` is a left inverse.
    have hr : a * (y * a * (u⁻¹ : Dˣ)) = 1 := by
      calc
        a * (y * a * (u⁻¹ : Dˣ)) = (a * y * a) * (u⁻¹ : Dˣ) := by simp [mul_assoc]
        _ = (u : D) * (u⁻¹ : Dˣ) := by rw [hu]
        _ = 1 := u.mul_inv
    have hl : ((u⁻¹ : Dˣ) * a * y) * a = 1 := by
      calc
        ((u⁻¹ : Dˣ) * a * y) * a = (u⁻¹ : Dˣ) * (a * y * a) := by simp [mul_assoc]
        _ = (u⁻¹ : Dˣ) * (u : D) := by rw [hu]
        _ = 1 := u.inv_mul
    have heq : (u⁻¹ : Dˣ) * a * y = y * a * (u⁻¹ : Dˣ) := by
      calc
        (u⁻¹ : Dˣ) * a * y = ((u⁻¹ : Dˣ) * a * y) * (a * (y * a * (u⁻¹ : Dˣ))) := by
          rw [hr, mul_one]
        _ = (((u⁻¹ : Dˣ) * a * y) * a) * (y * a * (u⁻¹ : Dˣ)) := by simp [mul_assoc]
        _ = y * a * (u⁻¹ : Dˣ) := by rw [hl, one_mul]
    exact ⟨⟨a, y * a * (u⁻¹ : Dˣ), hr, heq ▸ hl⟩, rfl⟩
  · intro ha
    refine ⟨ha.nonneg, ?_⟩
    obtain ⟨u, rfl⟩ := ha.isUnit
    have hsurj : Function.Surjective (fun x : D => (u : D) * x * (u : D)) := fun x =>
      ⟨(u⁻¹ : Dˣ) * x * (u⁻¹ : Dˣ), by simp [mul_assoc]⟩
    exact hsurj.denseRange

/-- The unit of a unital C⋆-algebra is strictly positive. -/
@[simp]
theorem isStrictlyPositive_one {D : Type*} [CStarAlgebra D] [PartialOrder D] [StarOrderedRing D] :
    IsStrictlyPositive (1 : D) :=
  isStrictlyPositive_iff_unital.mpr ⟨zero_le_one, isUnit_one⟩

end StrictlyPositiveCStar

end FullAndStrictlyPositive

