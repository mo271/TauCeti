public import TauCeti.Analysis.CStarAlgebra.Hereditary.Basic
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range

/-!
# Closed two-sided ideal correspondence for hereditary C⋆-subalgebras

For any closed hereditary C⋆-subalgebra `B` of a (possibly nonunital) C⋆-algebra `A`, restriction
`J ↦ J.comap subtype` and closed ideal generation `K ↦ (K.map subtype).topologicalClosure` give an
order isomorphism between the closed two-sided ideals `J` of `A` contained in the closed two-sided
ideal generated by `B` and the closed two-sided ideals `K` of `B` (Blackadar II.5.3.5). When `B` is
full in `A`, this is an order isomorphism between all closed two-sided ideals of `A` and all closed
two-sided ideals of `B`.

Moreover, for any closed nonunital `⋆`-subalgebra `B` of `A` and any closed two-sided ideal `K`
of `B`, the closed two-sided ideal of `A` generated by `K` coincides with the closed complex linear
span of `{a * k * c | a, c ∈ A, k ∈ K}`.

## Main declarations

* `NonUnitalStarSubalgebra.coe_topologicalClosure_map_subtype`: explicit closed linear span
  characterization `closure (span {a * k * c})`.
* `NonUnitalStarSubalgebra.comap_topologicalClosure_map_subtype` and
  `NonUnitalStarSubalgebra.topologicalClosure_map_comap_subtype`: the two round-trip identities of
  Blackadar II.5.3.5.
* `NonUnitalStarSubalgebra.closedTwoSidedIdealOrderIso` and
  `NonUnitalStarSubalgebra.closedTwoSidedIdealOrderIsoOfFull`: the bundled order isomorphisms on
  lattices of closed two-sided ideals.

## References

* Bruce Blackadar, *Operator Algebras: Theory of C*-Algebras and von Neumann Algebras*, II.5.3.5.
* Gerard J. Murphy, *C*-Algebras and Operator Theory*, Section 3.2.
-/

public section

open Filter Topology
open scoped CStarAlgebra

namespace NonUnitalStarSubalgebra

section GeneratedIdeal

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- For any closed nonunital `⋆`-subalgebra `B` of a C⋆-algebra `A` and any closed two-sided ideal
`K` of `B`, the closed two-sided ideal of `A` generated by `K` equals the closed complex linear span
of `{a * k * c | a, c ∈ A, k ∈ K}`. -/
theorem coe_topologicalClosure_map_subtype {B : NonUnitalStarSubalgebra ℂ A}
    [IsClosed (B : Set A)] (K : TwoSidedIdeal B) [hK_closed : IsClosed (K : Set B)] :
    ((K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure : Set A) =
      closure (Submodule.span ℂ {x : A | ∃ (a c : A) (k : B), k ∈ K ∧ a * (k : A) * c = x} :
        Set A) := by
  set S : Set A := {x : A | ∃ (a c : A) (k : B), k ∈ K ∧ a * (k : A) * c = x}
  set M : Submodule ℂ A := (Submodule.span ℂ S).topologicalClosure
  have hM_coe : (M : Set A) = closure (Submodule.span ℂ S : Set A) := rfl
  -- Step 1: `M` absorbs left and right multiplication in `A`, forming a closed two-sided ideal.
  have hM_left : ∀ a : A, ∀ x ∈ M, a * x ∈ M := fun a x hx =>
    map_mem_closure (f := fun z : A => a * z) (continuous_const_mul a) hx fun y hy => by
      refine Submodule.span_induction (p := fun y _ => a * y ∈ Submodule.span ℂ S) ?_ (by simp)
        (fun _ _ _ _ hu hv => by rw [mul_add]; exact add_mem hu hv)
        (fun c _ _ hu => by rw [mul_smul_comm]; exact SMulMemClass.smul_mem c hu) hy
      rintro _ ⟨a₀, c₀, k, hk, rfl⟩
      exact Submodule.subset_span ⟨a * a₀, c₀, k, hk, by simp [mul_assoc]⟩
  have hM_right : ∀ x ∈ M, ∀ c : A, x * c ∈ M := fun x hx c =>
    map_mem_closure (f := fun z : A => z * c) (continuous_mul_const c) hx fun y hy => by
      refine Submodule.span_induction (p := fun y _ => y * c ∈ Submodule.span ℂ S) ?_ (by simp)
        (fun _ _ _ _ hu hv => by rw [add_mul]; exact add_mem hu hv)
        (fun r _ _ hu => by rw [smul_mul_assoc]; exact SMulMemClass.smul_mem r hu) hy
      rintro _ ⟨a₀, c₀, k, hk, rfl⟩
      exact Submodule.subset_span ⟨a₀, c₀ * c, k, hk, by simp [mul_assoc]⟩
  let IM : TwoSidedIdeal A :=
    TwoSidedIdeal.mk' (M : Set A) M.zero_mem M.add_mem M.neg_mem
      (fun {a x} hx => hM_left a x hx) (fun {x c} hx => hM_right x hx c)
  have hIM_coe : (IM : Set A) = (M : Set A) := TwoSidedIdeal.coe_mk' ..
  have hIM_closed : IsClosed (IM : Set A) := hIM_coe ▸ Submodule.isClosed_topologicalClosure _
  rw [← hM_coe, ← hIM_coe]
  apply Set.Subset.antisymm
  · -- Step 2: Every `k ∈ K` is a limit `e * k * e → k` along the approximate unit of `K`.
    rw [SetLike.coe_subset_coe, TwoSidedIdeal.topologicalClosure_le_iff _ _ hIM_closed,
      TwoSidedIdeal.map, TwoSidedIdeal.span_le]
    rintro _ ⟨k, hk, rfl⟩
    let _ := CStarAlgebra.spectralOrder K
    have _ := CStarAlgebra.spectralOrderedRing K
    have hl := CStarAlgebra.increasingApproximateUnit K
    have := hl.neBot
    have hlim : Tendsto (fun e : K => ((e : B) : A) * (k : A) * ((e : B) : A))
        (CStarAlgebra.approximateUnit K) (𝓝 (k : A)) :=
      ((continuous_subtype_val.comp continuous_subtype_val).tendsto ⟨k, hk⟩).comp
        (hl.tendsto_mul_mul ⟨k, hk⟩)
    rw [SetLike.mem_coe, TwoSidedIdeal.mem_mk', hM_coe,
      NonUnitalStarSubalgebraClass.coe_subtype]
    exact isClosed_closure.mem_of_tendsto hlim <| Eventually.of_forall fun e =>
      subset_closure (Submodule.subset_span ⟨((e : B) : A), ((e : B) : A), k, hk, rfl⟩)
  · -- Step 3: Conversely, every `a * k * c` lies in the closed ideal generated by `K`.
    set J := (K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure
    have hJ_closed : IsClosed (J : Set A) := TwoSidedIdeal.isClosed_topologicalClosure _
    rw [hIM_coe, hM_coe]
    refine closure_minimal ?_ hJ_closed
    have hsub : Submodule.span ℂ S ≤ J.toSubmodule := by
      rw [Submodule.span_le]
      rintro _ ⟨a, c, k, hk, rfl⟩
      have hkJ : (k : A) ∈ J :=
        TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨k, hk, rfl⟩)
      exact J.mul_mem_right _ c (J.mul_mem_left a _ hkJ)
    exact hsub

end GeneratedIdeal

section ClosedIdealCorrespondence

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- Base step for `comap_topologicalClosure_map_subtype`: for a closed ideal `K` of a closed
hereditary C⋆-subalgebra `B`, sandwiching any `k ∈ K` by elements of `B` (with optional ambient
factors from `A`) stays in the image of `K`. -/
private theorem mul_mem_image_of_mem_ideal {B : NonUnitalStarSubalgebra ℂ A}
    [hB_closed : IsClosed (B : Set A)] (hB : B.IsHereditary) {K : TwoSidedIdeal B}
    [hK_closed : IsClosed (K : Set B)] {k : B} (hk : k ∈ K) :
    (∀ u v : B, (u : A) * (k : A) * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ a : A, (u : A) * a * (k : A) * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ c : A, (u : A) * (k : A) * c * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ a c : A, (u : A) * a * (k : A) * c * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) := by
  have hSK_closed : IsClosed (((↑) : B → A) '' (K : Set B)) :=
    (Topology.IsInducing.subtypeVal.isClosedMap (by simpa using hB_closed)) _ hK_closed
  let _ := CStarAlgebra.spectralOrder K
  have _ := CStarAlgebra.spectralOrderedRing K
  have hl := CStarAlgebra.increasingApproximateUnit K
  have := hl.neBot
  have hcont : Continuous (fun z : K => ((z : B) : A)) :=
    continuous_subtype_val.comp continuous_subtype_val
  have hlimL : Tendsto (fun f : K => ((f : B) : A) * (k : A))
      (CStarAlgebra.approximateUnit K) (𝓝 (k : A)) :=
    (hcont.tendsto ⟨k, hk⟩).comp (hl.tendsto_mul_right ⟨k, hk⟩)
  have hlimR : Tendsto (fun f : K => (k : A) * ((f : B) : A))
      (CStarAlgebra.approximateUnit K) (𝓝 (k : A)) :=
    (hcont.tendsto ⟨k, hk⟩).comp (hl.tendsto_mul_left ⟨k, hk⟩)
  have hlimB : Tendsto (fun f : K => ((f : B) : A) * (k : A) * ((f : B) : A))
      (CStarAlgebra.approximateUnit K) (𝓝 (k : A)) :=
    (hcont.tendsto ⟨k, hk⟩).comp (hl.tendsto_mul_mul ⟨k, hk⟩)
  refine ⟨fun u v => ⟨u * k * v, K.mul_mem_right _ v (K.mul_mem_left u _ hk), rfl⟩,
    fun u v a => ?_, fun u v c => ?_, fun u v a c => ?_⟩
  · have hlim : Tendsto (fun f : K => (u : A) * a * (((f : B) : A) * (k : A)) * (v : A))
        (CStarAlgebra.approximateUnit K) (𝓝 ((u : A) * a * (k : A) * (v : A))) :=
      (((continuous_mul_const (v : A)).comp (continuous_const_mul ((u : A) * a))).tendsto
        (k : A)).comp hlimL
    refine hSK_closed.mem_of_tendsto hlim (Eventually.of_forall fun f => ?_)
    let w : B := ⟨(u : A) * a * ((f : B) : A), hB.mul_mul_mem u.2 (f : B).2 a⟩
    exact ⟨w * k * v, K.mul_mem_right _ v (K.mul_mem_left w _ hk), by simp [w, mul_assoc]⟩
  · have hlim : Tendsto (fun f : K => (u : A) * ((k : A) * ((f : B) : A)) * c * (v : A))
        (CStarAlgebra.approximateUnit K) (𝓝 ((u : A) * (k : A) * c * (v : A))) :=
      ((((continuous_mul_const (v : A)).comp (continuous_mul_const c)).comp
        (continuous_const_mul (u : A))).tendsto (k : A)).comp hlimR
    refine hSK_closed.mem_of_tendsto hlim (Eventually.of_forall fun f => ?_)
    let w : B := ⟨((f : B) : A) * c * (v : A), hB.mul_mul_mem (f : B).2 v.2 c⟩
    exact ⟨u * k * w, K.mul_mem_right _ w (K.mul_mem_left u _ hk), by simp [w, mul_assoc]⟩
  · have hlim : Tendsto
        (fun f : K => (u : A) * a * (((f : B) : A) * (k : A) * ((f : B) : A)) * c * (v : A))
        (CStarAlgebra.approximateUnit K) (𝓝 ((u : A) * a * (k : A) * c * (v : A))) :=
      ((((continuous_mul_const (v : A)).comp (continuous_mul_const c)).comp
        (continuous_const_mul ((u : A) * a))).tendsto (k : A)).comp hlimB
    refine hSK_closed.mem_of_tendsto hlim (Eventually.of_forall fun f => ?_)
    let w₁ : B := ⟨(u : A) * a * ((f : B) : A), hB.mul_mul_mem u.2 (f : B).2 a⟩
    let w₂ : B := ⟨((f : B) : A) * c * (v : A), hB.mul_mul_mem (f : B).2 v.2 c⟩
    exact ⟨w₁ * k * w₂, K.mul_mem_right _ w₂ (K.mul_mem_left w₁ _ hk),
      by simp [w₁, w₂, mul_assoc]⟩

/-- Induction step for `comap_topologicalClosure_map_subtype`: lifting the four-part sandwich
invariant from generators `k ∈ K` to every element of `K.map subtype`. -/
private theorem mul_mem_image_of_mem_map {B : NonUnitalStarSubalgebra ℂ A}
    [IsClosed (B : Set A)] (hB : B.IsHereditary) {K : TwoSidedIdeal B} [IsClosed (K : Set B)]
    {x : A} (hx : x ∈ K.map (NonUnitalStarSubalgebraClass.subtype B)) :
    (∀ u v : B, (u : A) * x * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ a : A, (u : A) * a * x * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ c : A, (u : A) * x * c * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) ∧
    (∀ u v : B, ∀ a c : A, (u : A) * a * x * c * (v : A) ∈ ((↑) : B → A) '' (K : Set B)) := by
  have hadd : ∀ {y z : A}, y ∈ ((↑) : B → A) '' (K : Set B) → z ∈ ((↑) : B → A) '' (K : Set B) →
      y + z ∈ ((↑) : B → A) '' (K : Set B) := by
    rintro _ _ ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩; exact ⟨u + v, K.add_mem hu hv, rfl⟩
  have hneg : ∀ {y : A}, y ∈ ((↑) : B → A) '' (K : Set B) →
      -y ∈ ((↑) : B → A) '' (K : Set B) := by
    rintro _ ⟨u, hu, rfl⟩; exact ⟨-u, K.neg_mem hu, rfl⟩
  refine TwoSidedIdeal.span_induction ?_ ?_ ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨k, hk, rfl⟩
    exact mul_mem_image_of_mem_ideal hB hk
  · exact ⟨fun _ _ => by simp, fun _ _ _ => by simp, fun _ _ _ => by simp, fun _ _ _ _ => by simp⟩
  · intro y z _ _ hy hz
    exact ⟨fun u v => by simpa [mul_add, add_mul] using hadd (hy.1 u v) (hz.1 u v),
      fun u v a => by simpa [mul_add, add_mul] using hadd (hy.2.1 u v a) (hz.2.1 u v a),
      fun u v c => by simpa [mul_add, add_mul] using hadd (hy.2.2.1 u v c) (hz.2.2.1 u v c),
      fun u v a c => by simpa [mul_add, add_mul] using hadd (hy.2.2.2 u v a c) (hz.2.2.2 u v a c)⟩
  · intro y _ hy
    exact ⟨fun u v => by simpa [mul_neg, neg_mul] using hneg (hy.1 u v),
      fun u v a => by simpa [mul_neg, neg_mul] using hneg (hy.2.1 u v a),
      fun u v c => by simpa [mul_neg, neg_mul] using hneg (hy.2.2.1 u v c),
      fun u v a c => by simpa [mul_neg, neg_mul] using hneg (hy.2.2.2 u v a c)⟩
  · intro a₀ y _ hy
    exact ⟨fun u v => by simpa only [mul_assoc] using hy.2.1 u v a₀,
      fun u v a => by simpa only [mul_assoc] using hy.2.1 u v (a * a₀),
      fun u v c => by simpa only [mul_assoc] using hy.2.2.2 u v a₀ c,
      fun u v a c => by simpa only [mul_assoc] using hy.2.2.2 u v (a * a₀) c⟩
  · intro c₀ y _ hy
    exact ⟨fun u v => by simpa only [mul_assoc] using hy.2.2.1 u v c₀,
      fun u v a => by simpa only [mul_assoc] using hy.2.2.2 u v a c₀,
      fun u v c => by simpa only [mul_assoc] using hy.2.2.1 u v (c₀ * c),
      fun u v a c => by simpa only [mul_assoc] using hy.2.2.2 u v a (c₀ * c)⟩

/-- First round-trip of Blackadar II.5.3.5: for a closed hereditary C⋆-subalgebra `B` and a closed
two-sided ideal `K` of `B`, intersecting the closed ideal of `A` generated by `K` back with `B`
recovers `K`. -/
theorem comap_topologicalClosure_map_subtype {B : NonUnitalStarSubalgebra ℂ A}
    [hB_closed : IsClosed (B : Set A)] (hB : B.IsHereditary) (K : TwoSidedIdeal B)
    [hK_closed : IsClosed (K : Set B)] :
    (K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure.comap
        (NonUnitalStarSubalgebraClass.subtype B) = K := by
  apply le_antisymm
  · intro b hb
    rw [TwoSidedIdeal.mem_comap, TwoSidedIdeal.mem_topologicalClosure] at hb
    have hSK_closed : IsClosed (((↑) : B → A) '' (K : Set B)) :=
      (Topology.IsInducing.subtypeVal.isClosedMap (by simpa using hB_closed)) _ hK_closed
    have hmul_mem : ∀ u v : B, u * b * v ∈ K := by
      intro u v
      have hmem_SK : (u : A) * (b : A) * (v : A) ∈ ((↑) : B → A) '' (K : Set B) := by
        rw [← hSK_closed.closure_eq]
        exact map_mem_closure (f := fun z : A => (u : A) * z * (v : A))
          ((continuous_const_mul (u : A)).mul continuous_const) hb
          (fun z hz => (mul_mem_image_of_mem_map hB hz).1 u v)
      obtain ⟨k, hk, hkeq⟩ := hmem_SK
      have : k = u * b * v := Subtype.ext hkeq
      exact this ▸ hk
    have : StarOrderedRing B := Subtype.starOrderedRing B
    have hlB := CStarAlgebra.increasingApproximateUnit B
    have := hlB.neBot
    exact hK_closed.mem_of_tendsto (hlB.tendsto_mul_mul b)
      (Eventually.of_forall fun e => hmul_mem e e)
  · intro k hk
    rw [TwoSidedIdeal.mem_comap]
    exact TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨k, hk, rfl⟩)

/-- Second round-trip of Blackadar II.5.3.5: for a hereditary nonunital `⋆`-subalgebra `B` and a
closed two-sided ideal `J` of `A` contained in
`(TwoSidedIdeal.span (B : Set A)).topologicalClosure`, extending `J ∩ B` back to `A` recovers `J`.
-/
theorem topologicalClosure_map_comap_subtype {B : NonUnitalStarSubalgebra ℂ A}
    (hB : B.IsHereditary) {J : TwoSidedIdeal A}
    [hJ_closed : IsClosed (J : Set A)]
    (hJ_le : J ≤ (TwoSidedIdeal.span (B : Set A)).topologicalClosure) :
    ((J.comap (NonUnitalStarSubalgebraClass.subtype B)).map
        (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure = J := by
  let ι := NonUnitalStarSubalgebraClass.subtype B
  set I' : TwoSidedIdeal A := ((J.comap ι).map ι).topologicalClosure
  have hI'_closed : IsClosed (I' : Set A) := TwoSidedIdeal.isClosed_topologicalClosure _
  apply le_antisymm
  · rw [TwoSidedIdeal.topologicalClosure_le_iff _ _ hJ_closed, TwoSidedIdeal.map,
      TwoSidedIdeal.span_le]
    rintro _ ⟨b, hb, rfl⟩
    exact (TwoSidedIdeal.mem_comap ι).mp hb
  · have hbx : ∀ b ∈ B, ∀ x ∈ J, b * x ∈ I' := by
      intro b hb x hx
      rw [← TwoSidedIdeal.mul_star_self_mem_iff I']
      have hmemB : (b * x) * star (b * x) ∈ B := by
        have heq : (b * x) * star (b * x) = b * (x * star x) * star b := by
          simp only [star_mul, mul_assoc]
        rw [heq]
        exact hB.mul_mul_mem hb (star_mem hb) (x * star x)
      have hmemJ : (b * x) * star (b * x) ∈ J :=
        J.mul_mem_right _ (star (b * x)) (J.mul_mem_left b x hx)
      exact TwoSidedIdeal.le_topologicalClosure _
        (TwoSidedIdeal.subset_span ⟨⟨(b * x) * star (b * x), hmemB⟩, hmemJ, rfl⟩)
    let T : TwoSidedIdeal A :=
      TwoSidedIdeal.mk' {y : A | ∀ x ∈ J, y * x ∈ I'}
        (fun x _ => by simp)
        (fun hy₁ hy₂ x hx => by rw [add_mul]; exact I'.add_mem (hy₁ x hx) (hy₂ x hx))
        (fun hy x hx => by rw [neg_mul]; exact I'.neg_mem (hy x hx))
        (fun {a y} hy x hx => by rw [mul_assoc]; exact I'.mul_mem_left a _ (hy x hx))
        (fun {y a} hy x hx => by rw [mul_assoc]; exact hy (a * x) (J.mul_mem_left a x hx))
    have hT_mem : ∀ y : A, y ∈ T ↔ ∀ x ∈ J, y * x ∈ I' := fun y =>
      TwoSidedIdeal.mem_mk' ..
    have hT_coe : (T : Set A) = ⋂ x ∈ (J : Set A), (fun y : A => y * x) ⁻¹' (I' : Set A) := by
      ext y
      simp [hT_mem]
    have hT_closed : IsClosed (T : Set A) := by
      rw [hT_coe]
      exact isClosed_biInter fun x _ => hI'_closed.preimage (continuous_mul_const x)
    have hBT : (TwoSidedIdeal.span (B : Set A)).topologicalClosure ≤ T := by
      rw [TwoSidedIdeal.topologicalClosure_le_iff _ _ hT_closed, TwoSidedIdeal.span_le]
      intro b hb
      rw [SetLike.mem_coe, hT_mem]
      exact hbx b hb
    intro x hx
    have hstar : star x ∈ T := hBT (hJ_le (J.star_mem_of_isClosed hx))
    exact (TwoSidedIdeal.star_mul_self_mem_iff I').mp ((hT_mem (star x)).mp hstar x hx)

/-- Order isomorphism between closed two-sided ideals of `A` contained in the closed two-sided
ideal generated by a closed hereditary C⋆-subalgebra `B` and closed two-sided ideals of `B`
(Blackadar II.5.3.5). -/
def closedTwoSidedIdealOrderIso (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary) :
    {J : TwoSidedIdeal A //
        IsClosed (J : Set A) ∧ J ≤ (TwoSidedIdeal.span (B : Set A)).topologicalClosure} ≃o
      {K : TwoSidedIdeal B // IsClosed (K : Set B)} where
  toFun J :=
    ⟨J.1.comap (NonUnitalStarSubalgebraClass.subtype B), by
      have hset : (J.1.comap (NonUnitalStarSubalgebraClass.subtype B) : Set B) =
          ((↑) : B → A) ⁻¹' (J.1 : Set A) :=
        Set.ext fun _ => TwoSidedIdeal.mem_comap (NonUnitalStarSubalgebraClass.subtype B)
      rw [hset]
      exact J.2.1.preimage continuous_subtype_val⟩
  invFun K :=
    ⟨(K.1.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure,
      TwoSidedIdeal.isClosed_topologicalClosure _,
      TwoSidedIdeal.topologicalClosure_mono <|
        TwoSidedIdeal.span_mono (by rintro _ ⟨k, _, rfl⟩; exact k.2)⟩
  left_inv J := Subtype.ext <| by
    have := J.2.1
    exact topologicalClosure_map_comap_subtype hB J.2.2
  right_inv K := Subtype.ext <| by
    have := K.2
    exact comap_topologicalClosure_map_subtype hB K.1
  map_rel_iff' := by
    intro J₁ J₂
    have := J₁.2.1
    have := J₂.2.1
    constructor
    · intro h
      have hle : J₁.1.comap (NonUnitalStarSubalgebraClass.subtype B) ≤
          J₂.1.comap (NonUnitalStarSubalgebraClass.subtype B) := h
      have hmap := TwoSidedIdeal.topologicalClosure_mono
        (TwoSidedIdeal.map_mono (f := NonUnitalStarSubalgebraClass.subtype B) hle)
      rwa [topologicalClosure_map_comap_subtype hB J₁.2.2,
        topologicalClosure_map_comap_subtype hB J₂.2.2] at hmap
    · intro h
      exact (TwoSidedIdeal.comap (NonUnitalStarSubalgebraClass.subtype B)).monotone h

@[simp]
theorem closedTwoSidedIdealOrderIso_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary)
    (J : {J : TwoSidedIdeal A //
      IsClosed (J : Set A) ∧ J ≤ (TwoSidedIdeal.span (B : Set A)).topologicalClosure}) :
    (B.closedTwoSidedIdealOrderIso hB J : TwoSidedIdeal B) =
      J.1.comap (NonUnitalStarSubalgebraClass.subtype B) := by
  rfl

@[simp]
theorem closedTwoSidedIdealOrderIso_symm_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary)
    (K : {K : TwoSidedIdeal B // IsClosed (K : Set B)}) :
    ((B.closedTwoSidedIdealOrderIso hB).symm K : TwoSidedIdeal A) =
      (K.1.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure := by
  rfl

/-- When a closed hereditary C⋆-subalgebra `B` is full (its closed two-sided ideal span is `⊤`),
its closed two-sided ideals are order-isomorphic to all closed two-sided ideals of `A`. -/
def closedTwoSidedIdealOrderIsoOfFull (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary)
    (hfull : (TwoSidedIdeal.span (B : Set A)).topologicalClosure = ⊤) :
    {J : TwoSidedIdeal A // IsClosed (J : Set A)} ≃o
      {K : TwoSidedIdeal B // IsClosed (K : Set B)} :=
  OrderIso.trans
    { toFun := fun J => ⟨J.1, J.2, hfull.symm ▸ le_top⟩
      invFun := fun J => ⟨J.1, J.2.1⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_rel_iff' := Iff.rfl }
    (B.closedTwoSidedIdealOrderIso hB)

@[simp]
theorem closedTwoSidedIdealOrderIsoOfFull_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary)
    (hfull : (TwoSidedIdeal.span (B : Set A)).topologicalClosure = ⊤)
    (J : {J : TwoSidedIdeal A // IsClosed (J : Set A)}) :
    (B.closedTwoSidedIdealOrderIsoOfFull hB hfull J : TwoSidedIdeal B) =
      J.1.comap (NonUnitalStarSubalgebraClass.subtype B) := by
  rfl

@[simp]
theorem closedTwoSidedIdealOrderIsoOfFull_symm_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : B.IsHereditary)
    (hfull : (TwoSidedIdeal.span (B : Set A)).topologicalClosure = ⊤)
    (K : {K : TwoSidedIdeal B // IsClosed (K : Set B)}) :
    ((B.closedTwoSidedIdealOrderIsoOfFull hB hfull).symm K : TwoSidedIdeal A) =
      (K.1.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure := by
  rfl

end ClosedIdealCorrespondence

end NonUnitalStarSubalgebra
